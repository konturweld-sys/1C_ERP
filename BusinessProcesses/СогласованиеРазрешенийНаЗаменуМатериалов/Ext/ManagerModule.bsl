#Область ОбновлениеИнформационнойБазы

// Установка значений реквизитов предопределенных элементов справочника РолиИсполнителей,
// относящихся к согласованию разрешений на замену.
//
Процедура ИнициализироватьРолиИсполнителей() Экспорт
	
	МетаданныеОбъекта = Метаданные.Справочники.РолиИсполнителей;
	
	НачатьТранзакцию();
		
	Попытка
	
		СсылкаНаЭлемент = Справочники.РолиИсполнителей.СогласующийРазрешенияНаЗаменуМатериалов;
		
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить(Метаданные.Справочники.РолиИсполнителей.ПолноеИмя());
		ЭлементБлокировки.УстановитьЗначение("Ссылка", СсылкаНаЭлемент);
		Блокировка.Заблокировать();
		
		РольОбъект = СсылкаНаЭлемент.ПолучитьОбъект();
		РольОбъект.ИспользуетсяБезОбъектовАдресации = Истина;
		РольОбъект.Записать();
	
		ЗафиксироватьТранзакцию();
			
	Исключение
		ОтменитьТранзакцию();
		ТекстСообщения = НСтр("ru = 'Не удалось обработать элемент: %Ссылка% по причине: %Причина%';
								|en = 'Cannot process the item: %Ссылка%. Reason: %Причина%'");
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Ссылка%", СсылкаНаЭлемент);
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Причина%", ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ЗаписьЖурналаРегистрации(ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
			УровеньЖурналаРегистрации.Предупреждение,
			МетаданныеОбъекта,
			СсылкаНаЭлемент,
			ТекстСообщения);
	КонецПопытки;
	
КонецПроцедуры

