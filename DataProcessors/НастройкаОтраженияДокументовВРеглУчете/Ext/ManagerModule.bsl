	Разделитель = "
	|
	|УПОРЯДОЧИТЬ ПО
	|	Код" + ОбщегоНазначения.РазделительПакетаЗапросов();
	Возврат Разделитель
КонецФункции

#КонецОбласти

#Область Нумерация

Функция ДанныеНумерации()

	ДанныеНумерации = СтруктураДанныхНумерации();
	ОшибкиНумерации = ДанныеНумерации.ОшибкиНумерации;
	
	НомераОбщихФрагментовПроводок = НомераОбщихФрагментовПроводок(ОшибкиНумерации);
	НомераФрагментовПроводокДляНесколькихДокументов = НомераФрагментовПроводокДляНесколькихДокументов(ОшибкиНумерации);
	
	УникальныеНомера = Новый Соответствие;;
	УникальныеПорядковыеНомера = Новый Соответствие;
		
	Для Каждого Номер Из НомераОбщихФрагментовПроводок Цикл
		НомерФрагмента = Номер.Ключ;
		Содержание = Номер.Значение;
			
		Если НомераФрагментовПроводокДляНесколькихДокументов.Получить(НомерФрагмента) <> Неопределено Тогда
	 		ТекстОшибки = НСтр("ru = 'Повторяются номера фрагментов в общих фрагментов и в текстах фрагментов для нескольких документов';
								|en = 'The fragment numbers are repeated in common fragments and in the fragment texts for several documents'");
			ДобавитьОшибкуНумерации(ОшибкиНумерации, "", ТекстОшибки, НомерФрагмента, Содержание);		
		КонецЕсли;	
		
		ДобавитьНомерФрагментаВСписок(ОшибкиНумерации, УникальныеНомера, УникальныеПорядковыеНомера,
			НомерФрагмента, Содержание);	
	КонецЦикла;

	Для Каждого Номер Из НомераФрагментовПроводокДляНесколькихДокументов Цикл
		НомерФрагмента = Номер.Ключ;
		Содержание = Номер.Значение.Содержание;
		ДобавитьНомерФрагментаВСписок(ОшибкиНумерации, УникальныеНомера, УникальныеПорядковыеНомера,
			НомерФрагмента, Содержание);	
	КонецЦикла;
	
	Для Каждого ТипДокумента Из Метаданные.РегистрыСведений.ОтражениеДокументовВРеглУчете.СтандартныеРеквизиты.Регистратор.Тип.Типы() Цикл
		МетаданныеДокумента = Метаданные.НайтиПоТипу(ТипДокумента);
		
		Если МетаданныеДокумента = Неопределено 
			ИЛИ МетаданныеДокумента = Метаданные.Документы.КорректировкаРегистров Тогда
			Продолжить;	
		КонецЕсли;
		
		ИмяДокумента = МетаданныеДокумента.Имя;
		
		Попытка
			ЭтоОбъектРасчетов = РеглУчетВыборкиСерверПовтИсп.ЭтоОбъектРасчетов(ИмяДокумента);
			ЗапросДанных = РеглУчетВыборкиСерверПовтИсп.ЗапросДанных(ИмяДокумента, ЭтоОбъектРасчетов);
		Исключение
			ТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			ТекстОшибки = СтрШаблон(НСтр("ru = 'Ошибка при получении запроса данных:%1';
										|en = 'Error when receiving the data query:%1'"), ТекстОшибки);
			ДобавитьОшибкуНумерации(ОшибкиНумерации, ИмяДокумента, ТекстОшибки);
			Продолжить;
		КонецПопытки;
		
		НомераФрагментовДокумента = НомераФрагментовПоТекстуЗапроса(ОшибкиНумерации, 
			ЗапросДанных.Текст, ИмяДокумента);
			
		Для Каждого ФрагментДокумента Из НомераФрагментовДокумента Цикл
			НомерФрагмента = ФрагментДокумента.Ключ;
			Содержание = ФрагментДокумента.Значение;
			
			Если НомераОбщихФрагментовПроводок.Получить(НомерФрагмента) <> Неопределено Тогда
				Продолжить;	
			КонецЕсли;
			
			ДанныеФрагментаДляНесколькихДокументов = НомераФрагментовПроводокДляНесколькихДокументов.Получить(НомерФрагмента);
			
			Если ДанныеФрагментаДляНесколькихДокументов = Неопределено Тогда
				ДобавитьНомерФрагментаВСписок(ОшибкиНумерации, УникальныеНомера, УникальныеПорядковыеНомера,
					НомерФрагмента, Содержание, ИмяДокумента);	
			ИначеЕсли ДанныеФрагментаДляНесколькихДокументов.Документы.Найти(ИмяДокумента) = Неопределено Тогда
		 		ТекстОшибки = НСтр("ru = 'Документ не поддерживается фрагментом для нескольких документов';
									|en = 'The document is not supported by a fragment for multiple documents'");
				ДобавитьОшибкуНумерации(ОшибкиНумерации, ИмяДокумента, ТекстОшибки, НомерФрагмента, Содержание);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
		
	ДанныеНумерации.ПоследнийНомерФрагмента = ПоследнийНомерФрагмента(УникальныеПорядковыеНомера);
	
	Возврат ДанныеНумерации;
		
КонецФункции

Функция ПоследнийНомерФрагмента(УникальныеПорядковыеНомера)
	
	ПоследнийНомерФрагмента = 0;
	
	Для Каждого Номер Из УникальныеПорядковыеНомера Цикл
		ПоследнийНомерФрагмента = Макс(ПоследнийНомерФрагмента, Номер.Ключ);	
	КонецЦикла;
	
	Возврат ПоследнийНомерФрагмента;
	
КонецФункции

Функция СтруктураДанныхНумерации()
	
	СтруктураДанныхНумерации = Новый Структура;
	СтруктураДанныхНумерации.Вставить("ОшибкиНумерации", ТаблицаОшибокНумерации());
	СтруктураДанныхНумерации.Вставить("ПоследнийНомерФрагмента", 0);
	
	Возврат СтруктураДанныхНумерации;
	
КонецФункции

Процедура ДобавитьНомерФрагментаВСписок(ОшибкиНумерации, УникальныеНомера, УникальныеПорядковыеНомера,
		Знач НомерФрагмента, Знач Содержание, Знач ИмяДокумента = "")
		
	Если НЕ ЗначениеЗаполнено(НомерФрагмента) Тогда
		Возврат;
	КонецЕсли;
	
	Если УникальныеНомера.Получить(НомерФрагмента) = Неопределено Тогда
		УникальныеНомера.Вставить(НомерФрагмента, Содержание);
	ИначеЕсли НомерФрагмента = РеглУчетСервер.НомерФрагментаИнициализации() Тогда
	Иначе
 		ТекстОшибки = НСтр("ru = 'Не уникальный номер фрагмента';
							|en = 'The fragment number is not unique'");
		ДобавитьОшибкуНумерации(ОшибкиНумерации, ИмяДокумента, ТекстОшибки, НомерФрагмента, Содержание); 
		Возврат;
	КонецЕсли;
	
	ПорядковыйНомерФрагмента = ПорядковыйНомерФрагмента(НомерФрагмента, Содержание, ОшибкиНумерации);
	ДобавитьПорядковыйНомерФрагмента(ОшибкиНумерации, УникальныеПорядковыеНомера, 
		ПорядковыйНомерФрагмента, НомерФрагмента, Содержание, ИмяДокумента);
	
КонецПроцедуры

Процедура ДобавитьПорядковыйНомерФрагмента(ОшибкиНумерации, УникальныеПорядковыеНомера, Знач ПорядковыйНомерФрагмента, 
		Знач НомерФрагмента, Знач Содержание, Знач ИмяДокумента)

	Если НЕ ЗначениеЗаполнено(ПорядковыйНомерФрагмента) Тогда
		Возврат;
	КонецЕсли;
	
	Если УникальныеПорядковыеНомера.Получить(ПорядковыйНомерФрагмента) = Неопределено Тогда
		УникальныеПорядковыеНомера.Вставить(ПорядковыйНомерФрагмента, НомерФрагмента);
	ИначеЕсли НомерФрагмента = РеглУчетСервер.НомерФрагментаИнициализации() Тогда
	Иначе
 		ТекстОшибки = НСтр("ru = 'Не уникальный порядковый номера фрагмента';
							|en = 'The fragment''s sequence number is not unique'");
		ДобавитьОшибкуНумерации(ОшибкиНумерации, ИмяДокумента, ТекстОшибки, НомерФрагмента, Содержание);
	КонецЕсли;

КонецПроцедуры

Функция ПорядковыйНомерФрагмента(Знач НомерФрагмента, Знач Содержание, ОшибкиНумерации)
	
	ПорядковыйНомерФрагмента = 0;
	
	ЧастиНомера = СтрРазделить(НомерФрагмента, "_");
	
	Если ЧастиНомера.Количество() <> 2 Тогда		
 		ТекстОшибки = НСтр("ru = 'Не правильный формат номера фрагмента';
							|en = 'The fragment number format is incorrect'");
		ДобавитьОшибкуНумерации(ОшибкиНумерации, "", ТекстОшибки, НомерФрагмента, Содержание);
		Возврат ПорядковыйНомерФрагмента;	
	КонецЕсли;
	
	ПорядковыйНомерФрагмента = СтроковыеФункцииКлиентСервер.СтрокаВЧисло(ЧастиНомера[1]);
	
	Если ПорядковыйНомерФрагмента = Неопределено Тогда
 		ТекстОшибки = НСтр("ru = 'Не правильный формат номера фрагмента';
							|en = 'The fragment number format is incorrect'");
		ДобавитьОшибкуНумерации(ОшибкиНумерации, "", ТекстОшибки, НомерФрагмента, Содержание);
		Возврат ПорядковыйНомерФрагмента;
	КонецЕсли;
	
	Возврат ПорядковыйНомерФрагмента;
	
КонецФункции

Функция НомераФрагментовПроводокДляНесколькихДокументов(ОшибкиНумерации)
	
	ФрагментыПроводок = РеглУчетСервер.ФрагментыПроводокДляНесколькихДокументов();
	
	НомераФрагментов = Новый Соответствие;
	
	Для Каждого ОписаниеФрагмента Из ФрагментыПроводок Цикл
		НомераФрагмента = НомераФрагментовПоТекстуЗапроса(ОшибкиНумерации, 
			ОписаниеФрагмента.ТестЗапроса);
		
		Для Каждого Номер Из НомераФрагмента Цикл
			ДанныеФрагмента = НомераФрагментов.Получить(Номер.Ключ);
			
			Если ДанныеФрагмента = Неопределено Тогда
	    		ДанныеФрагмента = ДанныеФрагментаПроводкиДляНесколькихДокументов();
	    		ДанныеФрагмента.Документы = ОписаниеФрагмента.Документы;
	    		ДанныеФрагмента.Содержание = Номер.Значение;
	    		
	 			НомераФрагментов.Вставить(Номер.Ключ, ДанныеФрагмента);
	    	ИначеЕсли Номер.Ключ = "РеглУчетВыборкиСерверПовтИсп_1218" Тогда
				ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ДанныеФрагмента.Документы, 
					ОписаниеФрагмента.Документы, Истина);
	    	Иначе
		 		ТекстОшибки = НСтр("ru = 'Повторяются номера фрагментов в текстах фрагментов для нескольких документов';
									|en = 'The fragment numbers are repeated in the fragment texts for several documents'");
				ДобавитьОшибкуНумерации(ОшибкиНумерации, "", ТекстОшибки, Номер.Ключ);
	    	КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат НомераФрагментов;
	
КонецФункции

Функция ДанныеФрагментаПроводкиДляНесколькихДокументов()
	
	ДанныеФрагмента = Новый Структура;
	ДанныеФрагмента.Вставить("Документы", Новый Массив);
	ДанныеФрагмента.Вставить("Содержание", "");
	
	Возврат ДанныеФрагмента;
	
КонецФункции

Функция НомераОбщихФрагментовПроводок(ОшибкиНумерации)
	
	ОбщиеФрагментыПроводок = РеглУчетСервер.ОбщиеФрагментыПроводок();
	ТекстЗапросаОбщихФрагментовПроводок = СтрСоединить(ОбщиеФрагментыПроводок, ОбщегоНазначенияУТ.РазделительЗапросовВОбъединении());
	НомераОбщихФрагментовПроводок = НомераФрагментовПоТекстуЗапроса(ОшибкиНумерации, 
		ТекстЗапросаОбщихФрагментовПроводок);
	
	Возврат НомераОбщихФрагментовПроводок;
	
КонецФункции

Процедура ДобавитьОшибкуНумерации(ОшибкиНумерации, ИмяДокумента, ТекстОшибки, НомерФрагмента = "", Содержание = "")
	
	НоваяСтрока = ОшибкиНумерации.Добавить();
	НоваяСтрока.ИмяДокумента = ИмяДокумента;
	НоваяСтрока.ТекстОшибки = ТекстОшибки;
	НоваяСтрока.НомерФрагмента = НомерФрагмента;
	НоваяСтрока.Содержание = Содержание;
	
КонецПроцедуры

Функция ТаблицаОшибокНумерации()
	
	ТаблицаОшибокНумерации = Новый ТаблицаЗначений;
	ТаблицаОшибокНумерации.Колонки.Добавить("ИмяДокумента", Новый ОписаниеТипов("Строка"));
	ТаблицаОшибокНумерации.Колонки.Добавить("НомерФрагмента", Новый ОписаниеТипов("Строка"));
	ТаблицаОшибокНумерации.Колонки.Добавить("ТекстОшибки", Новый ОписаниеТипов("Строка"));
	ТаблицаОшибокНумерации.Колонки.Добавить("Содержание", Новый ОписаниеТипов("Строка"));
	
	Возврат ТаблицаОшибокНумерации;
	
КонецФункции

Функция НомераФрагментовПоТекстуЗапроса(ОшибкиНумерации, ТекстЗапроса, ИмяДокумента = "")
	
	НомераФрагментов = Новый Соответствие;
	
	Попытка
		Схема = Новый СхемаЗапроса;
		Схема.УстановитьТекстЗапроса(ТекстЗапроса);
	Исключение
		ТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ТекстОшибки = СтрШаблон(НСтр("ru = 'Ошибка при компиляции запроса данных:%1';
									|en = 'Error when compiling the data query:%1'"), ТекстОшибки);
		ДобавитьОшибкуНумерации(ОшибкиНумерации, ИмяДокумента, ТекстОшибки);
	    Возврат НомераФрагментов;
	КонецПопытки;		
	
	ИдентификаторПакетаЗапросов = Схема.ПакетЗапросов.Количество() - 1;
	Запрос = Схема.ПакетЗапросов[ИдентификаторПакетаЗапросов]; 
	
	ИндексОператораЗапросаДокумента = Запрос.Операторы.Количество() - 1;
	ОператорЗапросаДокумента = Запрос.Операторы[ИндексОператораЗапросаДокумента]; 
	
	ИндексПоляВложенногоЗапроса = -1;
	
	Для каждого ОписаниеИсточника Из ОператорЗапросаДокумента.Источники Цикл
		Если ТипЗнч(ОписаниеИсточника.Источник) = Тип("ВложенныйЗапросСхемыЗапроса") Тогда
			ЗаполнитьНомераФрагментовПоЗапросуВыбораСхемыЗапроса(ОписаниеИсточника.Источник.Запрос, 
				ОшибкиНумерации, НомераФрагментов, ИмяДокумента);
			ИндексПоляВложенногоЗапроса = ИндексОператораЗапросаДокумента;
		КонецЕсли;	
	КонецЦикла;
	
	ЗаполнитьНомераФрагментовПоЗапросуВыбораСхемыЗапроса(Запрос, 
		ОшибкиНумерации, НомераФрагментов, ИмяДокумента, ИндексПоляВложенногоЗапроса);
	
	Возврат НомераФрагментов;
	
КонецФункции

Процедура ЗаполнитьНомераФрагментовПоЗапросуВыбораСхемыЗапроса(Запрос, 
	ОшибкиНумерации, НомераФрагментов, Знач ИмяДокумента, ИндексОператораЗапросаДокумента = -1)
	
	КолонкаНомера = Запрос.Колонки.Найти("НомерФрагмента");
	КолонкаСодержание = Запрос.Колонки.Найти("Содержание");
	
	Если КолонкаНомера = Неопределено Тогда
		ТекстОшибки = НСтр("ru = 'Отсутствует поле с номером фрагмента';
							|en = 'The field with a fragment number is missing'");
		ДобавитьОшибкуНумерации(ОшибкиНумерации, ИмяДокумента, ТекстОшибки);
	    Возврат;
	КонецЕсли;
	
	Если КолонкаСодержание = Неопределено Тогда
		ТекстОшибки = НСтр("ru = 'Отсутствует поле с содержанием';
							|en = 'The field with content is missing'");
		ДобавитьОшибкуНумерации(ОшибкиНумерации, ИмяДокумента, ТекстОшибки);
	    Возврат;
	КонецЕсли;
	
    Для каждого Поле Из КолонкаНомера.Поля Цикл		
		НомерФрагмента = СокрЛП(Поле);
    	НомерФрагмента = СтрЗаменить(НомерФрагмента, """", "");
    	ИндексПоля = КолонкаНомера.Поля.Индекс(Поле);
 	 	Содержание = КолонкаСодержание.Поля.Получить(ИндексПоля);
		
		Если ИндексОператораЗапросаДокумента = ИндексПоля Тогда
			Продолжить;
		КонецЕсли;

		Если НЕ ЗначениеЗаполнено(НомерФрагмента) Тогда
	 		ТекстОшибки = НСтр("ru = 'Не заполнен номер фрагмента';
								|en = 'The fragment number is required'");
			ДобавитьОшибкуНумерации(ОшибкиНумерации, ИмяДокумента, ТекстОшибки, , Содержание);
			Продолжить;
    	КонецЕсли;
    	
    	Если НомераФрагментов.Получить(НомерФрагмента) = Неопределено Тогда
 			НомераФрагментов.Вставить(НомерФрагмента, Содержание);
    	Иначе
	 		ТекстОшибки = НСтр("ru = 'Повторяются номера фрагментов в тексте запроса';
								|en = 'The fragment numbers in the query text are repeated'");
			ДобавитьОшибкуНумерации(ОшибкиНумерации, ИмяДокумента, ТекстОшибки, НомерФрагмента, Содержание);
    	КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

