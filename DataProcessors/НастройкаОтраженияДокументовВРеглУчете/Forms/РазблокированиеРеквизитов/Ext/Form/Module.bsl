#Область ОписаниеПеременных

&НаКлиенте
Перем ПараметрыОбработчикаОжидания;

&НаКлиенте
Перем ФормаДлительнойОперации;

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Параметры.Свойство("АвтоТест") Тогда // Возврат при получении формы для анализа.
		Возврат;
	КонецЕсли;

	СобытияФорм.ПриСозданииНаСервере(ЭтотОбъект, Отказ, СтандартнаяОбработка);
	Элементы.РазрешитьРедактирование.Пометка = Параметры.РедактированиеРазрешено;
	
	ДанныеБлокировки = НастройкаСчетовУчетаСервер.Блокировка_ДатыЗапрета(Параметры.Организация);
	
	ДатаЗапрета = Формат(Макс(ДанныеБлокировки.ДатаЗапрета, ДанныеБлокировки.ДатаБлокировкиМесяца), "ДЛФ=D");
	ТекстИнформацияБлокировка = НСтр("ru = 'Запрещено изменять данные с датой ранее %1 (включительно), изменение настроек на более раннюю дату будет не возможно.';
									|en = 'Cannot change data with a date earlier than %1 (inclusive). Changing the settings to an earlier date will not be possible.'");
	ИнформацияБлокировка = Новый ФорматированнаяСтрока(СтрШаблон(ТекстИнформацияБлокировка, ДатаЗапрета));
	Элементы.ГруппаИнформацияОБлокировании.Видимость = Макс(ДанныеБлокировки.ДатаЗапрета, ДанныеБлокировки.ДатаБлокировкиМесяца) <> '00010101';
	
	ИнформацияБлокировкаМесяца = СтроковыеФункции.ФорматированнаяСтрока(
		НСтр("ru = 'Установлена блокировка закрытия месяца на дату: <a href=""Открыть_БлокировкаМесяца"">%1</a>';
			|en = 'The month-end closing lock date is set to: <a href=""Открыть_БлокировкаМесяца"">%1</a>'"),
		Формат(ДанныеБлокировки.ДатаБлокировкиМесяца, НСтр("ru = 'ДФ=''ММММ гггг''';
															|en = 'DF=''MMMM yyyy'''")));
	Элементы.ИнформацияБлокировкаМесяца.Видимость = ДанныеБлокировки.ДатаБлокировкиМесяца <> '00010101';
	
	ИнформацияДатаЗапрета = СтроковыеФункции.ФорматированнаяСтрока(
		НСтр("ru = 'Установлена дата запрета редактирования на: <a href=""Открыть_ДатаЗапрета"">%1</a>';
			|en = 'The period-end closing date is set to: <a href=""Открыть_ДатаЗапрета"">%1</a>'"),
		Формат(ДанныеБлокировки.ДатаЗапрета, НСтр("ru = 'ДФ=''ММММ гггг''';
													|en = 'DF=''MMMM yyyy'''")));
	Элементы.ИнформацияДатаЗапрета.Видимость = ДанныеБлокировки.ДатаЗапрета <> '00010101';
	
	ПоследняяДатаОтражения = Формат(ДанныеБлокировки.ПоследняяДатаОтражения, "ДЛФ=D");
	ИнформацияЗапретИзменения = Новый ФорматированнаяСтрока(СтрШаблон(Элементы.ИнформацияЗапретИзменения.Заголовок, ПоследняяДатаОтражения));

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаНавигационнойСсылки(НавигационнаяСсылкаФорматированнойСтроки, СтандартнаяОбработка)
	
	Если НавигационнаяСсылкаФорматированнойСтроки = "Открыть_БлокировкаМесяца" Тогда
		СтандартнаяОбработка = Ложь;
		ОткрытьФорму("РегистрСведений.НастройкаБлокировкиОтИзменений.Форма.ФормаНастройки",, ЭтотОбъект);
	КонецЕсли;
	
	Если НавигационнаяСсылкаФорматированнойСтроки = "Открыть_ДатаЗапрета" Тогда
		СтандартнаяОбработка = Ложь;
		ОткрытьФорму("РегистрСведений.ДатыЗапретаИзменения.Форма.ДатыЗапретаИзменения",, ЭтотОбъект);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура РазрешитьРедактирование(Команда)

	Закрыть(Не Элементы.РазрешитьРедактирование.Пометка);

КонецПроцедуры

&НаКлиенте
Процедура ПроверитьИспользованиеОбъекта(Команда)
	
	ЗапретРедактированияРеквизитовОбъектовУТКлиент.ПроверитьИспользованиеОбъекта(ЭтаФорма, ПараметрыОбработчикаОжидания);
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ВыполнитьПереопределяемуюКоманду(Команда)
	
	СобытияФормКлиент.ВыполнитьПереопределяемуюКоманду(ЭтаФорма, Команда);
	
КонецПроцедуры

#КонецОбласти
