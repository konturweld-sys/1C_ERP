Процедура ЗаполнитьДанныеПервичныхДеклараций(ДанныеПодготовкиПервичнойДекларации,
	Знач Организация, Знач НачалоПериодаОтчета, Знач КонецПериодаОтчета)
	
	МенеджерВТ = Новый МенеджерВременныхТаблиц;
	
	НалогНаПрибыльКорректировки.СоздатьВТ_ДекларацииОрганизации(МенеджерВТ, Организация, НачалоПериодаОтчета, КонецПериодаОтчета);
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;

	Запрос.Текст = "
	|ВЫБРАТЬ
	|	ВТ_ДекларацииОрганизации.РегистрацияВНалоговомОргане КАК РегистрацияВНалоговомОргане,
	|	ВТ_ДекларацииОрганизации.РегистрацияВНалоговомОргане.КПП КАК КПП,
	|	ВТ_ДекларацииОрганизации.ЭтоРегистрацияГоловнойОрганизации КАК ЭтоРегистрацияГоловнойОрганизации,
	|	СУММА(ВТ_ДекларацииОрганизации.НалоговаяБаза) КАК НалоговаяБаза,
	|	ВТ_ДекларацииОрганизации.КодМестаПредставления КАК КодМестаПредставления   
	|ИЗ
	|	ВТ_ДекларацииОрганизации КАК ВТ_ДекларацииОрганизации
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ДекларацииОрганизации.РегистрацияВНалоговомОргане,
	|	ВТ_ДекларацииОрганизации.РегистрацияВНалоговомОргане.КПП,
	|	ВТ_ДекларацииОрганизации.ЭтоРегистрацияГоловнойОрганизации,
	|	ВТ_ДекларацииОрганизации.КодМестаПредставления
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВТ_ДекларацииОрганизации.ВариантНалогообложенияПрибыли,
	|	ВТ_ДекларацииОрганизации.КодМестаПредставления
	|ИЗ
	|	ВТ_ДекларацииОрганизации КАК ВТ_ДекларацииОрганизации
	|ГДЕ
	|	ВТ_ДекларацииОрганизации.ВариантНалогообложенияПрибыли <> ЗНАЧЕНИЕ(Справочник.ВариантыНалогообложенияПрибыли.ПустаяСсылка)";
	
	Результат = Запрос.ВыполнитьПакет();
	
	ДекларацииОрганизации = Результат[0].Выгрузить();

	ЗаполнитьДекларации(ДанныеПодготовкиПервичнойДекларации.Декларации,
		ДекларацииОрганизации, Организация, КонецПериодаОтчета);
	
	ВариантыНалогообложения = Результат[1].Выгрузить();
	ОбщегоНазначенияКлиентСервер.ДополнитьТаблицу(ВариантыНалогообложения, ДанныеПодготовкиПервичнойДекларации.ВариантыНалогообложенияПрибыли);
	
КонецПроцедуры

// Заполнить декларации.
// 
// Параметры:
//  Декларации - ТаблицаЗначений - Декларации
//  ДекларацииОрганизации - ТаблицаЗначений - Декларации организации
//  Организация - СправочникСсылка.Организации - Организация
//  КонецПериодаОтчета - Дата - Конец периода отчета
Процедура ЗаполнитьДекларации(Декларации, ДекларацииОрганизации, 
	Знач Организация, Знач КонецПериодаОтчета)
		
	ПараметрыРеглОтчетов = Новый ТаблицаЗначений;
	ПараметрыРеглОтчетов.Колонки.Добавить("ИсточникОтчета", ОбщегоНазначения.ОписаниеТипаСтрока(100));
	ПараметрыРеглОтчетов.Колонки.Добавить("Организация", Новый ОписаниеТипов("СправочникСсылка.Организации"));
	ПараметрыРеглОтчетов.Колонки.Добавить("ДатаОкончания", ОбщегоНазначения.ОписаниеТипаДата(ЧастиДаты.Дата));
	ПараметрыРеглОтчетов.Колонки.Добавить("РегистрацияВНалоговомОргане", Новый ОписаниеТипов("СправочникСсылка.РегистрацииВНалоговомОргане"));
	ПараметрыРеглОтчетов.Колонки.Добавить("Правило", ОбщегоНазначения.ОписаниеТипаСтрока(100));
	
	Для Каждого Строка Из ДекларацииОрганизации Цикл
		НоваяСтрока = ПараметрыРеглОтчетов.Добавить();
		НоваяСтрока.ИсточникОтчета = "РегламентированныйОтчетПрибыль";
		НоваяСтрока.Организация = Организация;
		НоваяСтрока.ДатаОкончания = КонецПериодаОтчета;
		НоваяСтрока.РегистрацияВНалоговомОргане = Строка.РегистрацияВНалоговомОргане;
	КонецЦикла;

	ИнтерфейсыВзаимодействияБРО.ЗаполнитьСсылкиНаРеглОтчеты(ПараметрыРеглОтчетов, , Ложь);
	
	Отбор = Новый Структура("РегистрацияВНалоговомОргане");
	ОтборПоКодуМестаПредставления = Новый Структура("КодМестаПредставления");
	
	ИспользуетсяРаздельныйУчет = РаздельныйУчетПоНалогуНаПрибыль.ИспользуетсяРаздельныйУчет(
		Организация,
		КонецПериодаОтчета);
	
	НесколькоДеклараций = НесколькоДекларацийСРазнымиКодамиМестПредставления(ДекларацииОрганизации);
	
	УдалитьКорректировочныеДекларацииИзРезультатовПоиска(ПараметрыРеглОтчетов);

	НайденныеДекларации = НайденныеДекларации(ПараметрыРеглОтчетов);
	КППДеклараций = ОбщегоНазначения.ЗначениеРеквизитаОбъектов(НайденныеДекларации, "КПП");
		
	Для Каждого Строка Из ДекларацииОрганизации Цикл
		НоваяСтрока = Декларации.Добавить();	
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
		ЗаполнитьЗначенияСвойств(Отбор, Строка);
		
		РезультатПоиска = ПараметрыРеглОтчетов.НайтиСтроки(Отбор);
		
		Если РезультатПоиска.Количество() = 0 Тогда
			Продолжить;
		Иначе
			СтрокаПоискаРеглОтчета = РезультатПоиска[0];
		КонецЕсли;
		
		Если СтрокаПоискаРеглОтчета.Документы.Количество() = 0 Тогда
			Продолжить;
		ИначеЕсли Строка.ЭтоРегистрацияГоловнойОрганизации
		 	И ИспользуетсяРаздельныйУчет 
		 	И НесколькоДеклараций Тогда

			ЗаполнитьКодМестаПредставления(СтрокаПоискаРеглОтчета.Документы);
			
			ЗаполнитьЗначенияСвойств(ОтборПоКодуМестаПредставления, Строка);
			
			РезультатПоискаПоКоду = СтрокаПоискаРеглОтчета.Документы.НайтиСтроки(ОтборПоКодуМестаПредставления);
			
			Если РезультатПоискаПоКоду.Количество() <> 0 Тогда
				СтрокаДекларации = РезультатПоискаПоКоду[0];
			Иначе
				Продолжить;
			КонецЕсли;
		ИначеЕсли НЕ Строка.ЭтоРегистрацияГоловнойОрганизации 
			И СтрокаПоискаРеглОтчета.Документы.Количество() > 1 Тогда
			Для каждого СтрокаДокументы Из СтрокаПоискаРеглОтчета.Документы Цикл
				Если ЗначениеЗаполнено(Строка.КПП) 
					И Строка.КПП = КППДеклараций.Получить(СтрокаДокументы.Ссылка) Тогда
					СтрокаДекларации = СтрокаДокументы;
				    Прервать;
				КонецЕсли;
			КонецЦикла;
		Иначе
			СтрокаДекларации = СтрокаПоискаРеглОтчета.Документы[0];
		КонецЕсли;
		
		НоваяСтрока.Декларация = СтрокаДекларации.Ссылка;
		НоваяСтрока.Состояние = СтрокаДекларации.Статус;
	КонецЦикла;
	
КонецПроцедуры

Функция НайденныеДекларации(ПараметрыРеглОтчетов)

	НайденныеДекларации = Новый Массив;
	
	Для каждого Строка Из ПараметрыРеглОтчетов Цикл
		Для каждого СтрокаДокументы Из Строка.Документы Цикл
			НайденныеДекларации.Добавить(СтрокаДокументы.Ссылка);	
		КонецЦикла;
	КонецЦикла;

	НайденныеДекларации = ОбщегоНазначенияКлиентСервер.СвернутьМассив(НайденныеДекларации);  
	
	Возврат НайденныеДекларации;
	
КонецФункции

Процедура УдалитьКорректировочныеДекларацииИзРезультатовПоиска(ПараметрыРеглОтчетов)
	
	Для Каждого Строка Из ПараметрыРеглОтчетов Цикл
		Если Строка.Документы.Количество() <= 1 Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокиКУдалению = Новый Массив;
		
		Для Каждого СтрокаДокумента Из Строка.Документы Цикл
			Если НЕ ЗначениеЗаполнено(СтрокаДокумента.Ссылка) Тогда
				Продолжить;	
			КонецЕсли;
			
			Вид = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаДокумента.Ссылка, "Вид");
			
			Если Вид <> 0 Тогда
				СтрокиКУдалению.Добавить(СтрокаДокумента);	
			КонецЕсли;
		КонецЦикла;
		
		Для Каждого СтрокаДокумента Из СтрокиКУдалению Цикл
			Строка.Документы.Удалить(СтрокаДокумента);
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

Функция НесколькоДекларацийСРазнымиКодамиМестПредставления(ДекларацииОрганизации)
	
	НесколькоДеклараций = Ложь;
	
	Отбор = Новый Структура();
	Отбор.Вставить("ЭтоРегистрацияГоловнойОрганизации", Истина);
	
	Результат = ДекларацииОрганизации.НайтиСтроки(Отбор);
	
	Если Результат.Количество() > 1 Тогда
		НесколькоДеклараций = Истина;
	КонецЕсли;
	
	Возврат НесколькоДеклараций;
	
КонецФункции

Процедура ЗаполнитьКодМестаПредставления(ТаблицаДокументов)
		
	Если ТаблицаДокументов.Колонки.Найти("КодМестаПредставления") <> Неопределено Тогда
		Возврат;	
	КонецЕсли;
	
	ТаблицаДокументов.Колонки.Добавить("КодМестаПредставления", ОбщегоНазначения.ОписаниеТипаСтрока(3));
	
	Для Каждого Строка Из ТаблицаДокументов Цикл
		Строка.КодМестаПредставления = КодМестаПредставленияДекларации(Строка.Ссылка);
	КонецЦикла;
	
КонецПроцедуры

Функция КодМестаПредставленияДекларации(Знач Декларация)
	
	КодМестаПредставленияДекларации = "";
	
	ДанныеОтчета = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Декларация, "ДанныеОтчета");
	
	ДанныеОтчета = ДанныеОтчета.Получить();
	
	Если ТипЗнч(ДанныеОтчета) = Тип("Структура") И ДанныеОтчета.Свойство("ПоказателиОтчета") Тогда
		КодМестаПредставленияДекларации = ДанныеОтчета.ПоказателиОтчета.ПолеТабличногоДокументаТитульный.ПоМесту;
	КонецЕсли;
	
	Возврат КодМестаПредставленияДекларации;
	
КонецФункции

Функция ВыполненыРегламентныеОперации(Знач Организация, Знач МесяцРегламентныхОпераций)
	
	ПараметрыПолученияДанныхВыполненияРегламентныхОпераций = ПараметрыПолученияДанныхВыполненияРегламентныхОпераций();
		
	Если ЗначениеЗаполнено(Организация) Тогда
		ОрганизацииРегламентныхОпераций = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Организация);
	Иначе
		ОрганизацииРегламентныхОпераций = Новый Массив;
	КонецЕсли;
	
	ПараметрыПолученияДанныхВыполненияРегламентныхОпераций.ОрганизацииРегламентныхОпераций = ОрганизацииРегламентныхОпераций;
	ПараметрыПолученияДанныхВыполненияРегламентныхОпераций.МесяцРегламентныхОпераций = МесяцРегламентныхОпераций;
		
	ДанныеВыполненияРегламентныхОпераций = ДанныеВыполненияРегламентныхОпераций(ПараметрыПолученияДанныхВыполненияРегламентныхОпераций);
	
	ВыполненыРегламентныеОперации = НЕ ДанныеВыполненияРегламентныхОпераций.ЕстьДанныеДляКорректировкиСтоимостиОС
		И НЕ ЗначениеЗаполнено(ДанныеВыполненияРегламентныхОпераций.ПервыйМесяцРасчетаСебестоимостиНУ)
		И ДанныеВыполненияРегламентныхОпераций.ВыполненоОтражениеДокументовВРеглУчете
		И ДанныеВыполненияРегламентныхОпераций.ВыполненПерерасчетАмортизацииОС;
	
	Возврат ВыполненыРегламентныеОперации;
	
КонецФункции

Функция ТекстЗапроса_ДанныеОрганизацийПерерасчетаНалога()
	
	Текст ="
	|ВЫБРАТЬ
	|	КорректировкиНалоговойБазы.Организация КАК Организация,
	|	0 КАК Доходы,
	|	КорректировкиНалоговойБазы.СуммаНУДт КАК Расходы
	|ПОМЕСТИТЬ ВТ_ДоходыРасходы
	|ИЗ
	|	РегистрБухгалтерии.КорректировкиНалоговойБазы КАК КорректировкиНалоговойБазы
	|ГДЕ
	|	КорректировкиНалоговойБазы.НаборКорректировок В (&НаборыКорректировок)
	|	И КорректировкиНалоговойБазы.СчетДт В (&СчетаРасходов)
	|	И КорректировкиНалоговойБазы.Активность
	|	И НЕ КорректировкиНалоговойБазы.АннулирующаяЗапись
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	КорректировкиНалоговойБазы.Организация КАК Организация,
	|	КорректировкиНалоговойБазы.СуммаНУКт КАК Доходы,
	|	0 КАК Расходы
	|ИЗ
	|	РегистрБухгалтерии.КорректировкиНалоговойБазы КАК КорректировкиНалоговойБазы
	|ГДЕ
	|	КорректировкиНалоговойБазы.НаборКорректировок В (&НаборыКорректировок)
	|	И КорректировкиНалоговойБазы.СчетКт В (&СчетаДоходов)
	|	И КорректировкиНалоговойБазы.Активность
	|	И НЕ КорректировкиНалоговойБазы.АннулирующаяЗапись
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ДоходыРасходы.Организация КАК Организация,
	|	СУММА(ВТ_ДоходыРасходы.Доходы) КАК Доходы,
	|	СУММА(ВТ_ДоходыРасходы.Расходы) КАК Расходы,
	|	СУММА(ВТ_ДоходыРасходы.Доходы) + СУММА(ВТ_ДоходыРасходы.Расходы) КАК СуммаКорректировок
	|ИЗ
	|	ВТ_ДоходыРасходы КАК ВТ_ДоходыРасходы
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ДоходыРасходы.Организация
	|
	|УПОРЯДОЧИТЬ ПО
	|	СуммаКорректировок УБЫВ";
	
	Возврат Текст;
	
КонецФункции

// Выполнено отражение документов в регл учете.
// 
// Параметры:
//  ОрганизацииРегламентныхОпераций - Массив из СправочникСсылка.Организации - Организации регламентных операций
// 
// Возвращаемое значение:
//  Булево - Выполнено отражение всех документов в регл учете
Функция ВыполненоОтражениеДокументовВРеглУчете(ОрганизацииРегламентныхОпераций)
	ВсеДокументыОтраженыВУчете = Истина;
	
	Параметры = Новый Структура;
	Параметры.Вставить("ВидЗадания", "");
	Параметры.Вставить("МассивОрганизаций", ОрганизацииРегламентныхОпераций);
	Параметры.Вставить("ДатаОкончанияПериода", Дата(1, 1, 1));
	
	КонтролируемыеВидыЗаданий = Новый Массив;
	КонтролируемыеВидыЗаданий.Добавить("НеОтраженные");
	КонтролируемыеВидыЗаданий.Добавить("НеОтраженныеВручную");
	КонтролируемыеВидыЗаданий.Добавить("НеОтраженныеОперациейБух");
	
	КоличествоНеотраженныхДокументов = 0;
	
	Для Каждого ВидЗадания Из КонтролируемыеВидыЗаданий Цикл

		АдресРезультата = ПоместитьВоВременноеХранилище(Неопределено);

		Параметры.Вставить("ВидЗадания", ВидЗадания);

		Обработки.НастройкаОтраженияДокументовВРеглУчете.СостояниеОтраженияДокументов(Параметры, АдресРезультата);

		Результат = ПолучитьИзВременногоХранилища(АдресРезультата);

		Если Результат.Пустой() Тогда
			Продолжить;
		КонецЕсли;

		ВыборкаРезультата = Результат.Выбрать();
		ВыборкаРезультата.Следующий();

		КоличествоНеотраженныхДокументов = КоличествоНеотраженныхДокументов + ВыборкаРезультата.Количество;
	КонецЦикла;
	
	Если КоличествоНеотраженныхДокументов <> 0 Тогда
		ВсеДокументыОтраженыВУчете = Ложь;
	КонецЕсли;

	Возврат ВсеДокументыОтраженыВУчете;
	
КонецФункции

Процедура ЗаполнитьНомераКорректировкиДеклараций(Знач Организация, Знач НаборКорректировок, Знач Декларации)
	
	УточненныеДекларацииПоСтрокам = Новый Соответствие;
	ВсеДекларации = Новый Массив;
	
	ДатаПодписиДекларации = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(НаборКорректировок, "ДатаНачалаПодготовкиДекларации");
	ВсеНаборыКорректировок = НалогНаПрибыльКорректировки.НаборыКорректировокПоДатеПодписиДекларации(ДатаПодписиДекларации, Организация);
	
	ДанныеДекларацийНаборов = НалогНаПрибыльКорректировки.ДанныеДекларацийНаборовКорректировокПоОтбору(ВсеНаборыКорректировок, Декларации);
	ВсеДекларацииНаборов = ДанныеДекларацийНаборов.ВыгрузитьКолонку("Декларация");
	
	Отбор = Новый Структура("РегистрацияВНалоговомОргане, КодМестаПредставления, ОтчетныйПериод");
	
	Для Каждого Строка Из ДанныеДекларацийНаборов Цикл
		ЗаполнитьЗначенияСвойств(Отбор, Строка);
		
		ДанныеДекларацийПоОтбору = Декларации.НайтиСтроки(Отбор);
		
		Для Каждого СтрокаДеклараций Из ДанныеДекларацийПоОтбору Цикл
			ДобавитьДекларациюВСписок(УточненныеДекларацииПоСтрокам, ВсеДекларации, СтрокаДеклараций, Строка.Декларация);
		КонецЦикла;
	КонецЦикла;
	
	ДанныеДекларацийВведенныхВручную = ДанныеДекларацийВведенныхВручную(Организация, Декларации, ВсеДекларацииНаборов);

	ОтборБезКодаМестаПредставления = Новый Структура("РегистрацияВНалоговомОргане, ОтчетныйПериод");
	
	ИспользуетсяРаздельныйУчет = РаздельныйУчетПоНалогуНаПрибыль.ИспользуетсяРаздельныйУчет(Организация);
	
	ОтчетныеПериодыСНесколькимиКодамиМестПредставления = Новый Соответствие;
	
	Если ИспользуетсяРаздельныйУчет Тогда
		ПериодыРасчета = ДанныеДекларацийВведенныхВручную.ВыгрузитьКолонку("ОтчетныйПериод");
		ОтчетныеПериодыСНесколькимиКодамиМестПредставления = ОтчетныеПериодыСНесколькимиКодамиМестПредставления(Организация, ПериодыРасчета);
	КонецЕсли;
	
	Для Каждого Строка Из ДанныеДекларацийВведенныхВручную Цикл
		ПоискПоКодуМестаПредставления = ИспользуетсяРаздельныйУчет 
			И ОтчетныеПериодыСНесколькимиКодамиМестПредставления.Получить(Строка.ОтчетныйПериод) <> Неопределено;
		
		Если ПоискПоКодуМестаПредставления Тогда
			Строка.КодМестаПредставления = КодМестаПредставленияДекларации(Строка.Декларация);
			ОтборДляПоиска = Отбор;
		Иначе
			ОтборДляПоиска = ОтборБезКодаМестаПредставления;
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(ОтборДляПоиска, Строка);
		
		Результат = Декларации.НайтиСтроки(ОтборДляПоиска);
		
		Для Каждого СтрокаРезультата Из Результат Цикл
			ДобавитьДекларациюВСписок(УточненныеДекларацииПоСтрокам, ВсеДекларации, СтрокаРезультата, Строка.Декларация);
		КонецЦикла;
	КонецЦикла;
	
	НомераКорректировкиДеклараций = ОбщегоНазначения.ЗначениеРеквизитаОбъектов(ВсеДекларации, "Вид");
	
	Для Каждого Строка Из Декларации Цикл
		Строка.НомерКорректировки = НомерСледующейКорректировки(НомераКорректировкиДеклараций, 
			УточненныеДекларацииПоСтрокам, Строка);
	КонецЦикла;
	
КонецПроцедуры

Функция НомерСледующейКорректировки(НомераКорректировкиДеклараций, УточненныеДекларацииПоСтрокам, Строка)
	
	НомерСледующейКорректировки = 0;
	
	ДекларацииСтроки = УточненныеДекларацииПоСтрокам.Получить(Строка);
	
	Если ДекларацииСтроки <> Неопределено Тогда
		Для Каждого Декларация Из ДекларацииСтроки Цикл
			НомерСледующейКорректировки = Макс(НомерСледующейКорректировки, НомераКорректировкиДеклараций.Получить(Декларация));
		КонецЦикла;
	КонецЕсли;
	
	Возврат НомерСледующейКорректировки + 1;
	
КонецФункции

Функция ОтчетныеПериодыСНесколькимиКодамиМестПредставления(Знач Организация, ПериодыРасчета)
	
	ОтчетныеПериоды = Новый Соответствие;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ПериодыРасчета", ПериодыРасчета);
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	РасчетНалогаНаПрибыль.ПериодРасчета КАК ПериодРасчета
	|ИЗ
	|	РегистрСведений.РасчетНалогаНаПрибыль КАК РасчетНалогаНаПрибыль
	|ГДЕ
	|	РасчетНалогаНаПрибыль.Активность
	|	И РасчетНалогаНаПрибыль.Организация = &Организация
	|	И РасчетНалогаНаПрибыль.ВариантНалогообложенияПрибыли <> ЗНАЧЕНИЕ(Справочник.ВариантыНалогообложенияПрибыли.ПустаяСсылка)
	|	И РасчетНалогаНаПрибыль.ПериодРасчета В(&ПериодыРасчета)
	|
	|СГРУППИРОВАТЬ ПО
	|	РасчетНалогаНаПрибыль.ПериодРасчета
	|
	|ИМЕЮЩИЕ
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ РасчетНалогаНаПрибыль.ВариантНалогообложенияПрибыли.КодМестаПредставления) > 1";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ОтчетныеПериоды.Вставить(Выборка.ПериодРасчета, Истина);
	КонецЦикла;
	
	Возврат ОтчетныеПериоды;
	
КонецФункции

Процедура ДобавитьДекларациюВСписок(УточненныеДекларацииПоСтрокам, ВсеДекларации, СтрокаДекларации, Знач Декларация)
		
	УточненныеДекларации = УточненныеДекларацииПоСтрокам.Получить(СтрокаДекларации);
	
	Если УточненныеДекларации = Неопределено Тогда
		УточненныеДекларации = Новый Массив;
		УточненныеДекларацииПоСтрокам.Вставить(СтрокаДекларации, УточненныеДекларации);
	КонецЕсли;
	
	УточненныеДекларации.Добавить(Декларация);
	ВсеДекларации.Добавить(Декларация);
	
КонецПроцедуры

Функция ДанныеДекларацийВведенныхВручную(Знач Организация, Отбор, ИсключаемыеДекларации)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Отбор", Отбор);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ИсключаемыеДекларации", ИсключаемыеДекларации);
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	Отбор.РегистрацияВНалоговомОргане КАК РегистрацияВНалоговомОргане,
	|	Отбор.ОтчетныйПериод КАК ОтчетныйПериод
	|ПОМЕСТИТЬ ВТ_Отбор
	|ИЗ
	|	&Отбор КАК Отбор
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Отбор.ОтчетныйПериод КАК ОтчетныйПериод,
	|	ЕСТЬNULL(РегистрацииВНалоговомОргане.Код, """") КАК КодНО,
	|	ЕСТЬNULL(РегистрацииВНалоговомОргане.КПП, """") КАК КПП,
	|	ВТ_Отбор.РегистрацияВНалоговомОргане КАК РегистрацияВНалоговомОргане
	|ПОМЕСТИТЬ ВТ_ОтборСДаннымиРегистрации
	|ИЗ
	|	ВТ_Отбор КАК ВТ_Отбор
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.РегистрацииВНалоговомОргане КАК РегистрацииВНалоговомОргане
	|		ПО ВТ_Отбор.РегистрацияВНалоговомОргане = РегистрацииВНалоговомОргане.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ОтборСДаннымиРегистрации.ОтчетныйПериод КАК ОтчетныйПериод,
	|	ВТ_ОтборСДаннымиРегистрации.РегистрацияВНалоговомОргане КАК РегистрацияВНалоговомОргане,
	|	РегламентированныйОтчет.Ссылка КАК Декларация
	|ИЗ
	|	Документ.РегламентированныйОтчет КАК РегламентированныйОтчет
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ОтборСДаннымиРегистрации КАК ВТ_ОтборСДаннымиРегистрации
	|		ПО ВТ_ОтборСДаннымиРегистрации.ОтчетныйПериод = РегламентированныйОтчет.ДатаОкончания
	|		И ВТ_ОтборСДаннымиРегистрации.КодНО = РегламентированныйОтчет.КодНалоговогоОргана
	|		И ВТ_ОтборСДаннымиРегистрации.КПП = РегламентированныйОтчет.КПП
	|ГДЕ
	|	РегламентированныйОтчет.Организация = &Организация
	|	И НЕ РегламентированныйОтчет.Ссылка В (&ИсключаемыеДекларации)
	|	И РегламентированныйОтчет.ИсточникОтчета = ""РегламентированныйОтчетПрибыль""
	|	И НЕ РегламентированныйОтчет.ПометкаУдаления
	|	И РегламентированныйОтчет.Вид <> 0";
	
	ДанныеДеклараций = Запрос.Выполнить().Выгрузить();
	ДанныеДеклараций.Колонки.Добавить("КодМестаПредставления", ОбщегоНазначения.ОписаниеТипаСтрока(3));
	
	Возврат ДанныеДеклараций;
	
КонецФункции

Процедура ВыполнитьПерерасчетНалогаНаПрибыльПрошлыхПериодов(Параметры, АдресХранилища) Экспорт
	
	РеглУчетСервер.РасчетРегламентнойОперацииПерерасчетНалогаНаПрибыль(Параметры.ПараметрыОбработчика, Параметры.НаборКорректировок);
	
КонецПроцедуры

Процедура ВыполнитьПерерасчетАмортизацииОС(Знач МассивОрганизаций, Знач Период) Экспорт
	
	ПараметрыРасчета = Новый Структура();
	ПараметрыРасчета.Вставить("МассивОрганизаций", МассивОрганизаций);
	ПараметрыРасчета.Вставить("Период", НачалоМесяца(Период));
	
	ПараметрыОбработчика = Новый Структура;
	ПараметрыОбработчика.Вставить("ПараметрыРасчета", ПараметрыРасчета);
	ПараметрыОбработчика.Вставить("ИдентификаторРасчета", Новый УникальныйИдентификатор());
	
	РасчетАмортизацииОС.ВыполнитьОперациюЗакрытияМесяца(ПараметрыОбработчика);
	
КонецПроцедуры

Функция ЕстьДанныеДляКорректировкиСтоимости(Организации, Период, НастройкиБлокировок)
	
	КонецПериода  = КонецМесяца(Период);
	
	ЕстьДанные = 0;
	
	ФильтрБлокировок = Новый Структура("Организация", Неопределено);
	
	Для Каждого Организация Из Организации Цикл
		ФильтрБлокировок.Организация = Организация;
		БлокировкиПоОрганизации = НастройкиБлокировок.ТаблицаБлокировок.НайтиСтроки(ФильтрБлокировок);
		Если БлокировкиПоОрганизации.Количество() = 0 Тогда
			НачалоПериода = Дата(1, 1, 1);
		Иначе 
