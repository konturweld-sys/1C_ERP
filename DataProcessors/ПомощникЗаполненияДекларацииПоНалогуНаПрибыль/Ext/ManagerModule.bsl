#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область СлужебныйПрограммныйИнтерфейс

// Параметры формирования деклараций.
// 
// Возвращаемое значение:
//  Структура - Параметры формирования деклараций:
//   * Организация - СправочникСсылка.Организации - 
//   * Декларации - ТаблицаЗначений - :
//    ** РегистрацияВНалоговомОргане - СправочникСсылка.РегистрацииВНалоговомОргане - 
//    ** КодМестаПредставления - Строка
//    ** НачалоПериодаОтчета - Дата - 
//    ** КонецПериодаОтчета - Дата -
//    ** Периодичность - ПеречислениеСсылка.Периодичность -
//    ** ИмяФормы - Строка - 
//    ** НомерКорректировки - Число - 
//   * ВариантыНалогообложенияПрибыли - ТаблицаЗначений - :
//    ** КодМестаПредставления - Строка
//    ** ВариантНалогообложенияПрибыли - СправочникСсылка.ВариантыНалогообложенияПрибыли - 
Функция ПараметрыФормированияДеклараций() Экспорт

	ПараметрыФормированияДеклараций = Новый Структура;
	ПараметрыФормированияДеклараций.Вставить("Организация", Справочники.Организации.ПустаяСсылка());
	ПараметрыФормированияДеклараций.Вставить("НаборКорректировок", Справочники.КорректировкиПрошлыхПериодовНУ.ПустаяСсылка());
	
	Декларации = Новый ТаблицаЗначений;
	Декларации.Колонки.Добавить("РегистрацияВНалоговомОргане", Новый ОписаниеТипов("СправочникСсылка.РегистрацииВНалоговомОргане"));
	Декларации.Колонки.Добавить("КодМестаПредставления", ОбщегоНазначения.ОписаниеТипаСтрока(3));
	Декларации.Колонки.Добавить("НачалоПериодаОтчета", ОбщегоНазначения.ОписаниеТипаДата(ЧастиДаты.Дата));
	Декларации.Колонки.Добавить("КонецПериодаОтчета",  ОбщегоНазначения.ОписаниеТипаДата(ЧастиДаты.Дата));
	Декларации.Колонки.Добавить("ОтчетныйПериод",  ОбщегоНазначения.ОписаниеТипаДата(ЧастиДаты.Дата));
	Декларации.Колонки.Добавить("Периодичность",  Новый ОписаниеТипов("ПеречислениеСсылка.Периодичность"));
	Декларации.Колонки.Добавить("ИмяФормы", ОбщегоНазначения.ОписаниеТипаСтрока(100));
	Декларации.Колонки.Добавить("НомерКорректировки", ОбщегоНазначения.ОписаниеТипаЧисло(3));

	ПараметрыФормированияДеклараций.Вставить("Декларации", Декларации);

	ВариантыНалогообложенияПрибыли = ПустаяТаблицаВариантыНалогообложенияПрибыли();
	
	ПараметрыФормированияДеклараций.Вставить("ВариантыНалогообложенияПрибыли", ВариантыНалогообложенияПрибыли);

	Возврат ПараметрыФормированияДеклараций;

КонецФункции

// Сформировать декларации.
// 
// Параметры:
//  ПараметрыФормированияДеклараций - Структура - См. ПараметрыФормированияДеклараций()
Процедура СформироватьДекларации(ПараметрыФормированияДеклараций) Экспорт
	
	Отбор = Новый Структура("КодМестаПредставления, КонецПериодаОтчета");
	
	Регистрации = ПараметрыФормированияДеклараций.Декларации.ВыгрузитьКолонку("РегистрацияВНалоговомОргане");
	ДанныеРегистраций = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(Регистрации, "КПП, Код, КодПоОКТМО");
	
	ЭтоУточненнаяДекларация = ЗначениеЗаполнено(ПараметрыФормированияДеклараций.НаборКорректировок);
	
	Если ЭтоУточненнаяДекларация Тогда
		ЗаполнитьНомераКорректировкиДеклараций(ПараметрыФормированияДеклараций.Организация,
			ПараметрыФормированияДеклараций.НаборКорректировок, 
			ПараметрыФормированияДеклараций.Декларации);
	КонецЕсли;
	
	Для Каждого Строка Из ПараметрыФормированияДеклараций.Декларации Цикл
		ДанныеРегистрации = ДанныеРегистраций.Получить(Строка.РегистрацияВНалоговомОргане);
		
		ПараметрыДекларации = ИнтерфейсыВзаимодействияБРО.НовыйПараметрыАвтоформированияОтчета();
		ПараметрыДекларации.ИсточникОтчета = "РегламентированныйОтчетПрибыль";
		ПараметрыДекларации.ИмяФормыОтчета = Строка.ИмяФормы;
		ПараметрыДекларации.ДатаНачала = Строка.НачалоПериодаОтчета;
		ПараметрыДекларации.ДатаОкончания = Строка.КонецПериодаОтчета;
		ПараметрыДекларации.Организация = ПараметрыФормированияДеклараций.Организация;
		ПараметрыДекларации.Вставить("Периодичность", Строка.Периодичность);
		ПараметрыДекларации.Вставить("КПП", ДанныеРегистрации.КПП);
		ПараметрыДекларации.Вставить("ПоМесту", Строка.КодМестаПредставления);
		ПараметрыДекларации.Вставить("УточненнаяДекларация", Истина);
		ПараметрыДекларации.Вставить("НомерКорректировки", Строка.НомерКорректировки);
		ПараметрыДекларации.Вставить("КодКонтролирующегоОргана", ДанныеРегистрации.Код);
		ПараметрыДекларации.Вставить("КодПоОКТМО", ДанныеРегистрации.КодПоОКТМО);

		СтраницыЛистов = Новый Соответствие;
		
		ЗаполнитьЗначенияСвойств(Отбор, Строка);
		
		Результат = ПараметрыФормированияДеклараций.ВариантыНалогообложенияПрибыли.НайтиСтроки(Отбор);
						
		Для Каждого СтрокаВариантНО Из Результат Цикл
			ВариантНО = СтрокаВариантНО.ВариантНалогообложенияПрибыли;
			
			Если ЗначениеЗаполнено(ВариантНО) Тогда
				ДанныеВариантаНО = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ВариантНО, 
					"ЛистДекларации, ПризнакНалогоплательщика, НомерДокумента, КодВидаДохода, КодВидаОперации");
					
				ДанныеЛиста = Новый Структура;
				
				Если ДанныеВариантаНО.ЛистДекларации = "02" Тогда
					ДанныеЛиста.Вставить("ПризнакНалогоплательщика", ДанныеВариантаНО.ПризнакНалогоплательщика);	
					ДанныеЛиста.Вставить("НомерДокумента", ДанныеВариантаНО.НомерДокумента);	
					СтавкаФБ = НалоговыйУчет.НалоговаяСтавкаФедеральныйБюджет(
						Строка.КонецПериодаОтчета, ПараметрыФормированияДеклараций.Организация, "%", ВариантНО);
					СтавкаСубъектРФ = НалоговыйУчет.НалоговаяСтавкаРегиональныйБюджет(Строка.КонецПериодаОтчета,
						ПараметрыФормированияДеклараций.Организация, "%", ВариантНО, Строка.РегистрацияВНалоговомОргане);
					ДанныеЛиста.Вставить("СтавкаФБ", СтавкаФБ);	
					ДанныеЛиста.Вставить("СтавкаСубъектРФ", СтавкаСубъектРФ);	
				ИначеЕсли ДанныеВариантаНО.ЛистДекларации = "04" Тогда
					ДанныеЛиста.Вставить("КодВидаДохода", ДанныеВариантаНО.КодВидаДохода);	
				ИначеЕсли ДанныеВариантаНО.ЛистДекларации = "05" Тогда
					ДанныеЛиста.Вставить("КодВидаОперации", ДанныеВариантаНО.КодВидаОперации);	
				Иначе
					Продолжить;
				КонецЕсли;
				
				ЛистыРаздела = СтраницыЛистов.Получить(ДанныеВариантаНО.ЛистДекларации);
				
				Если ЛистыРаздела = Неопределено Тогда
					ЛистыРаздела = Новый Массив;
					СтраницыЛистов.Вставить(ДанныеВариантаНО.ЛистДекларации, ЛистыРаздела);
				КонецЕсли;
				
				ЛистыРаздела.Добавить(ДанныеЛиста);
				
			КонецЕсли;	
		КонецЦикла;
		
		ПараметрыДекларации.Вставить("СтраницыЛистов", СтраницыЛистов);
			
		НачатьТранзакцию();
		
		Попытка
			
			Если ЭтоУточненнаяДекларация Тогда
				
				ПараметрыЗаписиДекларации = НалогНаПрибыльКорректировки.ПараметрыЗаписиДекларации();
				ПараметрыЗаписиДекларации.РегистрацияВНалоговомОргане = Строка.РегистрацияВНалоговомОргане;
				ПараметрыЗаписиДекларации.НаборКорректировок = ПараметрыФормированияДеклараций.НаборКорректировок;
				ПараметрыЗаписиДекларации.КодМестаПредставления = Строка.КодМестаПредставления;
				ПараметрыЗаписиДекларации.ОтчетныйПериод = Строка.ОтчетныйПериод;
				
				Декларация = НалогНаПрибыльКорректировки.УточненнаяДекларация(ПараметрыЗаписиДекларации);
					
				Если НЕ ЗначениеЗаполнено(Декларация) Тогда
					Декларация = ИнтерфейсыВзаимодействияБРО.СформироватьАвтоматическиРеглОтчет(ПараметрыДекларации.ИсточникОтчета, 
						ПараметрыДекларации.Организация, ПараметрыДекларации.ДатаНачала, ПараметрыДекларации.ДатаОкончания,
						, ПараметрыДекларации.ИмяФормыОтчета, ПараметрыДекларации);
						
					ПараметрыЗаписиДекларации.Декларация = Декларация;
					НалогНаПрибыльКорректировки.ЗаписатьДекларацию(ПараметрыЗаписиДекларации);
				КонецЕсли;
			Иначе
		
				ИнтерфейсыВзаимодействияБРО.СформироватьАвтоматическиРеглОтчет(ПараметрыДекларации.ИсточникОтчета, 
					ПараметрыДекларации.Организация, ПараметрыДекларации.ДатаНачала, ПараметрыДекларации.ДатаОкончания,
					, ПараметрыДекларации.ИмяФормыОтчета, ПараметрыДекларации);
				
			КонецЕсли;
			
			ЗафиксироватьТранзакцию();
			
		Исключение
			ОтменитьТранзакцию();
						
			КраткоеПредставлениеОшибки = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
			
			ТекстОшибки = СтрШаблон(
				НСтр("ru = 'Не удалось сформировать декларацию по причине:
					|%1';
					|en = 'Cannot generate a declaration. Reason:
					|%1'"),
				КраткоеПредставлениеОшибки);
			
			ВызватьИсключение ТекстОшибки;
		КонецПопытки;
		
	КонецЦикла;

КонецПроцедуры

// Данные подготовки первичной декларации.
// 
// Параметры:
//  ПараметрыПолученияДанныхПодготовкиПервичнойДекларации - Структура - См. ПараметрыПолученияДанныхПодготовкиПервичнойДекларации()
// 
// Возвращаемое значение:
//  Структура - Данные подготовки первичной декларации:
//   * ВыполненоЗакрытиеМесяца - Булево - 
//   * Декларации - ТаблицаЗначений - :
//    ** РегистрацияВНалоговомОргане - СправочникСсылка.РегистрацииВНалоговомОргане - 
//    ** КодМестаПредставления - Строка
//    ** НалоговаяБаза - Число
//    ** Декларация - ДокументСсылка.РегламентированныйОтчет - 
//    ** Состояние - Строка
//   * ВариантыНалогообложенияПрибыли - ТаблицаЗначений - :
//    ** ВариантНалогообложенияПрибыли - СправочникСсылка.ВариантыНалогообложенияПрибыли - 
//    ** КодМестаПредставления - Строка
Функция ДанныеПодготовкиПервичнойДекларации(ПараметрыПолученияДанныхПодготовкиПервичнойДекларации) Экспорт
	
	НачалоПериодаОтчета = ПараметрыПолученияДанныхПодготовкиПервичнойДекларации.НачалоПериодаОтчета;
	Организация = ПараметрыПолученияДанныхПодготовкиПервичнойДекларации.Организация;
	КонецПериодаОтчета = ПараметрыПолученияДанныхПодготовкиПервичнойДекларации.КонецПериодаОтчета;
	
	ДанныеПодготовкиПервичнойДекларации = ПустыеДанныеПодготовкиПервичнойДекларации();
	
	ЭтапыЗакрытияМесяца = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Справочники.ОперацииЗакрытияМесяца.ФормированиеФинансовогоРезультата);
	МассивОрганизаций = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Организация);
	СостояниеЭтапов = ЗакрытиеМесяцаСервер.ОпределитьСостояниеЭтаповРасчета(ЭтапыЗакрытияМесяца, КонецПериодаОтчета, МассивОрганизаций);
		
	ДанныеПодготовкиПервичнойДекларации.ВыполненоЗакрытиеМесяца = НЕ (СостояниеЭтапов = Перечисления.СостоянияОперацийЗакрытияМесяца.ВыполненоСОшибками
		ИЛИ СостояниеЭтапов = Перечисления.СостоянияОперацийЗакрытияМесяца.НеВыполнено); 
	
	НачалоНалоговогоПериода = НалоговыйУчет.НачалоНалоговогоПериода(КонецПериодаОтчета, Организация);
	
	Если НачалоНалоговогоПериода <> Неопределено Тогда
		НачалоПериодаОтчета = НачалоНалоговогоПериода;
	КонецЕсли;
	
	ЗаполнитьДанныеПервичныхДеклараций(ДанныеПодготовкиПервичнойДекларации, Организация, НачалоПериодаОтчета, КонецПериодаОтчета);
	
	Возврат ДанныеПодготовкиПервичнойДекларации;
	
КонецФункции

// Параметры получения данных подготовки первичной декларации.
// 
// Возвращаемое значение:
//  Структура - Параметры получения данных подготовки первичной декларации:
//   * Организация - СправочникСсылка.Организации - 
//   * НачалоПериодаОтчета - Дата - 
//   * КонецПериодаОтчета - Дата - 
Функция ПараметрыПолученияДанныхПодготовкиПервичнойДекларации() Экспорт
	
	ПараметрыПолученияДанныхПодготовкиПервичнойДекларации = Новый Структура;
	ПараметрыПолученияДанныхПодготовкиПервичнойДекларации.Вставить("Организация", Справочники.Организации.ПустаяСсылка());
	ПараметрыПолученияДанныхПодготовкиПервичнойДекларации.Вставить("НачалоПериодаОтчета", Дата(1, 1, 1));
	ПараметрыПолученияДанныхПодготовкиПервичнойДекларации.Вставить("КонецПериодаОтчета", Дата(1, 1, 1));
	
	Возврат ПараметрыПолученияДанныхПодготовкиПервичнойДекларации;
	
КонецФункции

// Данные подготовки уточненной декларации.
// 
// Параметры:
//  ПараметрыПолученияДанныхПодготовкиУточненнойДекларации - Структура - См. ПараметрыПолученияДанныхПодготовкиУточненнойДекларации()
// 
// Возвращаемое значение:
//  Структура - Данные подготовки уточненной декларации:
//   * ВыполненПерерасчетНалога - Булево - 
//   * ВыполненыРегламентныеОперации - Булево - 
//   * ПервыйМесяцПерерасчетаНалога - Дата - 
//   * ДокументПерерасчетаНалога - ДокументСсылка.РегламентнаяОперация - 
//   * КорректировкаРасчетовПоНалогам - ДокументСсылка.КорректировкаРасчетовПоНалогам - 
//   * СуммаКорректировкиРасчетовПоНалогам - Число - 
//   * СуммаПерерасчетаНалога - Число - 
//   * СальдоСчетаЕНС - Число - 
//   * ОткрытыйНаборКорректировок - СправочникСсылка.КорректировкиПрошлыхПериодовНУ - 
//   * ЗакрытыйНаборКорректировок - СправочникСсылка.КорректировкиПрошлыхПериодовНУ - 
//   * СтатусыДеклараций - Соответствие из КлючИЗначение:
//    ** Ключ - Строка - Статус
//    ** Значение - Число - Количество деклараций
Функция ДанныеПодготовкиУточненнойДекларации(ПараметрыПолученияДанныхПодготовкиУточненнойДекларации) Экспорт
	
	ОрганизацияПерерасчетаНалога = ПараметрыПолученияДанныхПодготовкиУточненнойДекларации.ОрганизацияПерерасчетаНалога;
	МесяцРегламентныхОпераций = ПараметрыПолученияДанныхПодготовкиУточненнойДекларации.МесяцРегламентныхОпераций;
	
	ДанныеПодготовкиУточненнойДекларации = ПустыеДанныеПодготовкиУточненнойДекларации();
		
	Если ЗначениеЗаполнено(ОрганизацияПерерасчетаНалога) Тогда
		ДанныеПодготовкиУточненнойДекларации.ОткрытыйНаборКорректировок = НалогНаПрибыльКорректировки.ОткрытыйНаборКорректировок(ОрганизацияПерерасчетаНалога);
		ЗакрытыйНаборКорректировок = НалогНаПрибыльКорректировки.АктуальныйЗакрытыйНаборКорректировок(ОрганизацияПерерасчетаНалога);
		
		Если НалогНаПрибыльКорректировки.ВсеДекларацииПоНаборуСданы(ЗакрытыйНаборКорректировок) Тогда
			ЗакрытыйНаборКорректировок = Справочники.КорректировкиПрошлыхПериодовНУ.ПустаяСсылка();
		КонецЕсли;
		
		ДанныеПодготовкиУточненнойДекларации.ЗакрытыйНаборКорректировок = ЗакрытыйНаборКорректировок;
	
		Если ЗначениеЗаполнено(ЗакрытыйНаборКорректировок) Тогда
			
			ДанныеПодготовкиУточненнойДекларации.ВыполненПерерасчетНалога = ВыполненПерерасчетНалога(ЗакрытыйНаборКорректировок);	
			ДанныеПодготовкиУточненнойДекларации.ПервыйМесяцПерерасчетаНалога = НалогНаПрибыльКорректировки.ПервыйМесяцПерерасчетаНалога(ОрганизацияПерерасчетаНалога, ЗакрытыйНаборКорректировок);
			ДанныеПодготовкиУточненнойДекларации.ДокументПерерасчетаНалога = НалогНаПрибыльКорректировки.ДокументПерерасчетаНалога(ЗакрытыйНаборКорректировок);
						
			ДанныеКорректировкиРасчетовПоНалогам = НалогНаПрибыльКорректировки.ДанныеКорректировкиРасчетовПоНалогам(ЗакрытыйНаборКорректировок);
			ДанныеПодготовкиУточненнойДекларации.КорректировкаРасчетовПоНалогам = ДанныеКорректировкиРасчетовПоНалогам.Документ;
			ДанныеПодготовкиУточненнойДекларации.СуммаКорректировкиРасчетовПоНалогам = ДанныеКорректировкиРасчетовПоНалогам.СуммаКорректировки;
			
			ДанныеПодготовкиУточненнойДекларации.СуммаПерерасчетаНалога = НалогНаПрибыльКорректировки.СуммаПерерасчетаНалога(ЗакрытыйНаборКорректировок);
			ДанныеПодготовкиУточненнойДекларации.СальдоСчетаЕНС = НалогНаПрибыльКорректировки.СальдоСчетаЕНС(ОрганизацияПерерасчетаНалога);
			
			ДанныеТребуетсяПерерасчетНалога = РеглУчетСервер.ТребуетсяПерерасчетНалога(ОрганизацияПерерасчетаНалога, ЗакрытыйНаборКорректировок);
			ДанныеПодготовкиУточненнойДекларации.ТребуетсяПерерасчетПредыдущихПериодов = ДанныеТребуетсяПерерасчетНалога.ТребуетсяПерерасчетПредыдущихПериодов;
			ДанныеПодготовкиУточненнойДекларации.ТребуетсяПерерасчетПредыдущихНаборовКорректировТекущегоПериода = ДанныеТребуетсяПерерасчетНалога.ТребуетсяПерерасчетПредыдущихНаборовКорректировокТекущегоПериода;
			
			ЗаполнитьСтатусыУточненныхДеклараций(ДанныеПодготовкиУточненнойДекларации);
			
		КонецЕсли;
		
	КонецЕсли;
	
	ДанныеПодготовкиУточненнойДекларации.ВыполненыРегламентныеОперации = ВыполненыРегламентныеОперации(ОрганизацияПерерасчетаНалога, МесяцРегламентныхОпераций);
	
	Возврат ДанныеПодготовкиУточненнойДекларации;
		
КонецФункции

// Данные выполнения регламентных операций.
// 
// Параметры:
//  ПараметрыПолученияДанныхВыполненияРегламентныхОпераций - Структура - См. ПараметрыПолученияДанныхВыполненияРегламентныхОпераций()
// 
// Возвращаемое значение:
//  Структура - Данные подготовки уточненной декларации:
//   * ДоступныеОрганизацииРегламентныхОпераций - Массив из СправочникСсылка.Организации - 
//   * ЗаблокированныеОрганизации - Массив из СправочникСсылка.Организации - 
//   * ЕстьДанныеДляКорректировкиСтоимостиОС - Булево - 
//   * ПервыйМесяцРасчетаСебестоимостиНУ - Дата - 
//   * ВыполненоОтражениеДокументовВРеглУчете - Булево - 
//   * ВыполненПерерасчетАмортизацииОС - Булево - 
Функция ДанныеВыполненияРегламентныхОпераций(ПараметрыПолученияДанныхВыполненияРегламентныхОпераций) Экспорт
	
	МесяцРегламентныхОпераций = ПараметрыПолученияДанныхВыполненияРегламентныхОпераций.МесяцРегламентныхОпераций;
	ОрганизацииРегламентныхОпераций = ПараметрыПолученияДанныхВыполненияРегламентныхОпераций.ОрганизацииРегламентныхОпераций;
	
	ДанныеВыполненияРегламентныхОпераций = ПустыеДанныеВыполненияРегламентныхОпераций();
	
	ДанныеВыполненияРегламентныхОпераций.ДоступныеОрганизацииРегламентныхОпераций = ДоступныеОрганизацииРегламентныхОпераций(МесяцРегламентныхОпераций);
	
	Если ОрганизацииРегламентныхОпераций.Количество() = 0 Тогда
		ОрганизацииРегламентныхОпераций = ДанныеВыполненияРегламентныхОпераций.ДоступныеОрганизацииРегламентныхОпераций;	
	КонецЕсли;
	
	НастройкиБлокировок = РегистрыСведений.НастройкаБлокировкиОтИзменений.СведенияОБлокировкеОтИзменений(
		ДанныеВыполненияРегламентныхОпераций.ДоступныеОрганизацииРегламентныхОпераций,
		МесяцРегламентныхОпераций);
	
	ДанныеВыполненияРегламентныхОпераций.ЗаблокированныеОрганизации = НастройкиБлокировок.ЗаблокированныеОрганизации;
	
	ДанныеВыполненияРегламентныхОпераций.ЕстьДанныеДляКорректировкиСтоимостиОС = ЕстьДанныеДляКорректировкиСтоимости(ОрганизацииРегламентныхОпераций,
																														МесяцРегламентныхОпераций,
																														НастройкиБлокировок);

	ДанныеВыполненияРегламентныхОпераций.ПервыйМесяцРасчетаСебестоимостиНУ = РасчетСебестоимости.ТребуетсяПересчетСебестоимостиЗаПрошлыеПериоды(ОрганизацииРегламентныхОпераций);
			
	ДанныеВыполненияРегламентныхОпераций.ВыполненоОтражениеДокументовВРеглУчете = ВыполненоОтражениеДокументовВРеглУчете(ОрганизацииРегламентныхОпераций);
	
	ДанныеВыполненияРегламентныхОпераций.ВыполненПерерасчетАмортизацииОС = ВыполненПерерасчетАмортизацииОС(ОрганизацииРегламентныхОпераций, МесяцРегламентныхОпераций);
	
	Возврат ДанныеВыполненияРегламентныхОпераций;
		
КонецФункции

// Параметры получения данных выполнения регламентных операций.
// 
// Возвращаемое значение:
//  Структура - Параметры получения выполнения регламентных операций:
//   * ОрганизацииРегламентныхОпераций - Массив из СправочникСсылка.Организации - 
//   * МесяцРегламентныхОпераций - Дата - 
Функция ПараметрыПолученияДанныхВыполненияРегламентныхОпераций() Экспорт
	
	ПараметрыПолученияДанныхПодготовкиУточненнойДекларации = Новый Структура;
	ПараметрыПолученияДанныхПодготовкиУточненнойДекларации.Вставить("ОрганизацииРегламентныхОпераций", Новый Массив);
	ПараметрыПолученияДанныхПодготовкиУточненнойДекларации.Вставить("МесяцРегламентныхОпераций", Дата(1, 1, 1));
	
	Возврат ПараметрыПолученияДанныхПодготовкиУточненнойДекларации;
	
КонецФункции

// Параметры получения данных подготовки уточненной декларации.
// 
// Возвращаемое значение:
//  Структура - Параметры получения данных подготовки уточненной декларации:
//   * ОрганизацияПерерасчетаНалога - СправочникСсылка.Организации - 
//   * МесяцРегламентныхОпераций - Дата - 
Функция ПараметрыПолученияДанныхПодготовкиУточненнойДекларации() Экспорт
	
	ПараметрыПолученияДанныхПодготовкиУточненнойДекларации = Новый Структура;
	ПараметрыПолученияДанныхПодготовкиУточненнойДекларации.Вставить("ОрганизацияПерерасчетаНалога", Справочники.Организации.ПустаяСсылка());
	ПараметрыПолученияДанныхПодготовкиУточненнойДекларации.Вставить("МесяцРегламентныхОпераций", Дата(1, 1, 1));
	
	Возврат ПараметрыПолученияДанныхПодготовкиУточненнойДекларации;
	
КонецФункции

// Данные организаций перерасчета налога.
// 
// Возвращаемое значение:
//  ТаблицаЗначений - Данные организаций перерасчета налога:
//   * Организация - СправочникСсылка.Организации - 
//   * Доходы - Число -
//   * Расходы - Число -
Функция ДанныеОрганизацийПерерасчетаНалога() Экспорт
	
	ДанныеОрганизацийПерерасчетаНалога = ПустыеДанныеОрганизацийПерерасчетаНалога();
	
	ОткрытыеНаборыКорректировок = НалогНаПрибыльКорректировки.ОткрытыеНаборыКорректировок();
	АктуальныеЗакрытыеНаборыКорректировок = НалогНаПрибыльКорректировки.АктуальныеЗакрытыеНаборыКорректировок();
	СостояниеСдачиДеклараций = НалогНаПрибыльКорректировки.СостояниеСдачиДекларацийНаборов(АктуальныеЗакрытыеНаборыКорректировок);
	
	НаборыКорректировок = Новый Массив;
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(НаборыКорректировок, ОткрытыеНаборыКорректировок);
	
	Для Каждого ЗакрытыйНабор Из АктуальныеЗакрытыеНаборыКорректировок Цикл
		ВсеДекларацииСданы = СостояниеСдачиДеклараций.Получить(ЗакрытыйНабор);
		Если ВсеДекларацииСданы <> Неопределено
			И ВсеДекларацииСданы Тогда
			Продолжить;
		КонецЕсли;
		
		НаборыКорректировок.Добавить(ЗакрытыйНабор);
	КонецЦикла;
	
	СчетаДоходов = Новый Массив;
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(СчетаДоходов,
		БухгалтерскийУчетПовтИсп.СчетаВИерархии(ПланыСчетов.Хозрасчетный.Выручка));
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(СчетаДоходов,
		БухгалтерскийУчетПовтИсп.СчетаВИерархии(ПланыСчетов.Хозрасчетный.ПрочиеДоходы));

	СчетаРасходов = Новый Массив;
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(СчетаРасходов,
		БухгалтерскийУчетПовтИсп.СчетаВИерархии(ПланыСчетов.Хозрасчетный.СебестоимостьПродаж));
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(СчетаРасходов,
		БухгалтерскийУчетПовтИсп.СчетаВИерархии(ПланыСчетов.Хозрасчетный.Продажи_РасходыНаПродажу));
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(СчетаРасходов,
		БухгалтерскийУчетПовтИсп.СчетаВИерархии(ПланыСчетов.Хозрасчетный.Продажи_УправленческиеРасходы));
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(СчетаРасходов,
		БухгалтерскийУчетПовтИсп.СчетаВИерархии(ПланыСчетов.Хозрасчетный.ПрочиеРасходы));
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса_ДанныеОрганизацийПерерасчетаНалога();
	Запрос.УстановитьПараметр("НаборыКорректировок", НаборыКорректировок);
	Запрос.УстановитьПараметр("СчетаРасходов", СчетаРасходов);
	Запрос.УстановитьПараметр("СчетаДоходов", СчетаДоходов);
	
	Результат = Запрос.Выполнить();
	
	Если Результат.Пустой() Тогда
		Возврат ДанныеОрганизацийПерерасчетаНалога;
	КонецЕсли;
	
	Выборка = Результат.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(ДанныеОрганизацийПерерасчетаНалога.Добавить(), Выборка);
	КонецЦикла;
	
	Возврат ДанныеОрганизацийПерерасчетаНалога;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПустыеДанныеОрганизацийПерерасчетаНалога()
	
	ДанныеОрганизаций = Новый ТаблицаЗначений;
	ДанныеОрганизаций.Колонки.Добавить("Организация", Новый ОписаниеТипов("СправочникСсылка.Организации"));
	ДанныеОрганизаций.Колонки.Добавить("Доходы", ОбщегоНазначения.ОписаниеТипаЧисло(15,2));
	ДанныеОрганизаций.Колонки.Добавить("Расходы", ОбщегоНазначения.ОписаниеТипаЧисло(15,2));
	
	Возврат ДанныеОрганизаций;
	
КонецФункции

Процедура ЗаполнитьСтатусыУточненныхДеклараций(ДанныеПодготовкиУточненнойДекларации)
	
	НаборКорректировок = ДанныеПодготовкиУточненнойДекларации.ЗакрытыйНаборКорректировок;
	ДекларацииНабора = НалогНаПрибыльКорректировки.ДекларацииНабора(НаборКорректировок);
	СтатусыДеклараций = ИнтерфейсыВзаимодействияБРО.СтатусыРегламентированныхОтчетов(ДекларацииНабора);
	
	ВсеСтатусы = Новый Соответствие;
	
	Для Каждого ДанныеСтатуса Из СтатусыДеклараций Цикл
		Статус = ДанныеСтатуса.Значение;
		Количество = ВсеСтатусы.Получить(Статус);
		
		Если Количество = Неопределено Тогда
			ВсеСтатусы.Вставить(Статус, 1);	
		Иначе
			ВсеСтатусы.Вставить(Статус, Количество + 1);
		КонецЕсли;
	КонецЦикла;
	
	КоличествоДекларацийКФормированию = НалогНаПрибыльКорректировки.КоличествоДекларацийКФормированию(НаборКорректировок);
	
	СформированоДеклараций = 0;
	
	Для Каждого Декларация Из ДекларацииНабора Цикл
		Если ЗначениеЗаполнено(Декларация) Тогда
			СформированоДеклараций = СформированоДеклараций + 1;
		КонецЕсли;
	КонецЦикла;
	
	НеСформированоДеклараций = КоличествоДекларацийКФормированию - СформированоДеклараций;
	
	Если НеСформированоДеклараций > 0 Тогда
		ДанныеПодготовкиУточненнойДекларации.СтатусыДеклараций.Вставить(НСтр("ru = 'Не сформировано';
																			|en = 'Not created'"), НеСформированоДеклараций);
	КонецЕсли;
	
	Для Каждого ДанныеСтатусов Из ВсеСтатусы Цикл
		ДанныеПодготовкиУточненнойДекларации.СтатусыДеклараций.Вставить(ДанныеСтатусов.Ключ, ДанныеСтатусов.Значение);
	КонецЦикла;
	
КонецПроцедуры

Функция ВыполненПерерасчетАмортизацииОС(ОрганизацииРегламентныхОпераций, Период)

	ПараметрыОбработчика = Новый Структура;
	ПараметрыРасчета = Новый Структура;
	ПараметрыРасчета.Вставить("КонецПериода", Период);
	ПараметрыРасчета.Вставить("МассивОрганизаций", ОрганизацииРегламентныхОпераций);
	
	ДанныеЭтапа = Новый Структура;
	ДанныеЭтапа.Вставить("ДатаНачалаРасчета", Дата(1, 1, 1));
	ДанныеЭтапа.Вставить("Состояние", Неопределено);
	ДанныеЭтапа.Вставить("Код", Неопределено);
	
	ПараметрыОбработчика.Вставить("ПараметрыРасчета", ПараметрыРасчета);
	ПараметрыОбработчика.Вставить("ДанныеЭтапа", ДанныеЭтапа);
	ПараметрыОбработчика.Вставить("ТаблицаПояснения",Обработки.ОперацииЗакрытияМесяца.ИнициализироватьТаблицуПоясненийКЭтапам());
	
	ИмяРегистраЗаданий = Метаданные.РегистрыСведений.ЗаданияКРасчетуАмортизацииОС.Имя;
	
	Возврат Не ВнеоборотныеАктивы.ПроверитьНаличиеЗаданийКЗакрытиюМесяца(ПараметрыОбработчика, ИмяРегистраЗаданий);
	
КонецФункции

Функция ВыполненПерерасчетНалога(Знач НаборКорректировок)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЗаданияКЗакрытиюМесяца.НомерЗадания КАК НомерЗадания
	|ИЗ
	|	РегистрСведений.ЗаданияКЗакрытиюМесяца КАК ЗаданияКЗакрытиюМесяца
	|ГДЕ
	|	ЗаданияКЗакрытиюМесяца.Документ = &НаборКорректировок
	|	И ЗаданияКЗакрытиюМесяца.Операция = ЗНАЧЕНИЕ(Справочник.ОперацииЗакрытияМесяца.ПерерасчетНалогаНаПрибыльПрошлыхПериодов)";
	
	Запрос.УстановитьПараметр("НаборКорректировок", НаборКорректировок);
	
	Результат = Запрос.Выполнить();
	
	Возврат Результат.Пустой();

КонецФункции

Функция ДоступныеОрганизацииРегламентныхОпераций(Знач МесяцРегламентныхОпераций)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	Организации.Ссылка КАК Организация
	|ИЗ
	|	Справочник.Организации КАК Организации
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.НастройкиСистемыНалогообложения.СрезПоследних(&Дата, Организация <> &УправленческаяОрганизация) КАК НастройкиСистемыНалогообложенияСрезПоследних
	|		ПО Организации.ГоловнаяОрганизация = НастройкиСистемыНалогообложенияСрезПоследних.Организация
	|		И НастройкиСистемыНалогообложенияСрезПоследних.СистемаНалогообложения = ЗНАЧЕНИЕ(Перечисление.СистемыНалогообложения.Общая)
	|	
	|";
	Запрос.УстановитьПараметр("Дата", МесяцРегламентныхОпераций);
	Запрос.УстановитьПараметр("УправленческаяОрганизация", Справочники.Организации.УправленческаяОрганизация);

	Организации = Новый Массив;

	Результат = Запрос.Выполнить();

	Если Результат.Пустой() Тогда
		Возврат Организации;
	КонецЕсли;

	Выборка = Результат.Выбрать();

	Пока Выборка.Следующий() Цикл
		Организации.Добавить(Выборка.Организация);
	КонецЦикла;

	Возврат Организации;

КонецФункции

