#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	УстановитьЗначенияРеквизитовФормыПоУмолчанию(Параметры.Организация);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	НачатьОбновлениеФормы();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ПредставлениеОрганизацийОчистка(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если ВсеОрганизацииРегламентныхОпераций Тогда
		Возврат;
	КонецЕсли;
	
	ВсеОрганизацииРегламентныхОпераций 	 = Истина;
	ОрганизацииРегламентныхОпераций = Новый ФиксированныйМассив(Новый Массив);
	
	СформироватьПредставлениеОрганизаций();
	
	НачатьОбновлениеФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура ПредставлениеОрганизацийОткрытие(Элемент, СтандартнаяОбработка)
	
	Если ОрганизацииРегламентныхОпераций.Количество() <> 1 Тогда
		Возврат;
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	ПоказатьЗначение(, ОрганизацииРегламентныхОпераций[0]);
	
КонецПроцедуры

&НаКлиенте
Процедура ПредставлениеОрганизацийНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	ОбработчикЗакрытия = Новый ОписаниеОповещения("ПредставлениеОрганизацийНачалоВыбораЗавершение", ЭтотОбъект);
	
	ОписаниеОрганизаций = Новый Структура;
	
	ОписаниеОрганизаций.Вставить("ОдиночныеОрганизации",    ДоступныеОрганизацииРегламентныхОпераций.ВыгрузитьЗначения());
	ОписаниеОрганизаций.Вставить("ГруппыОрганизаций",       Новый Массив);
	ОписаниеОрганизаций.Вставить("ОрганизацииИнтеркампани", Новый Массив);
	ОписаниеОрганизаций.Вставить("ОрганизацииОСиНМА",       Новый Массив);
	ОписаниеОрганизаций.Вставить("ДоступныеОрганизации",    ДоступныеОрганизацииРегламентныхОпераций.ВыгрузитьЗначения());
	ОписаниеОрганизаций.Вставить("ЕстьОграниченияДоступа",  Ложь);
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ПериодРегистрации",    МесяцРегламентныхОпераций());
	ПараметрыФормы.Вставить("МассивОрганизаций",    ОрганизацииРегламентныхОпераций);
	ПараметрыФормы.Вставить("ВсеОрганизации",       ВсеОрганизацииРегламентныхОпераций);
	ПараметрыФормы.Вставить("ОписаниеОрганизаций",  ОписаниеОрганизаций);
	
	ОткрытьФорму("Обработка.ОперацииЗакрытияМесяца.Форма.ВыборОрганизаций",
		ПараметрыФормы,
		ЭтотОбъект, 
		УникальныйИдентификатор,
		,
		,
		ОбработчикЗакрытия,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ВыполнитьОтражениеДокументовВРеглУчете(Команда)
	
	ДлительнаяОперация = ВыполнитьОтражениеДокументовВРеглУчетеНаСервере();
	
	ОповещениеОЗавершении = Новый ОписаниеОповещения("ВыполнитьОтражениеДокументовВРеглУчетеНУЗавершение", ЭтотОбъект);
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, ОповещениеОЗавершении, ПараметрыОжидания);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьРасчетСебестоимостиНУ(Команда)
	
	ДлительнаяОперация = ВыполнитьРасчетСебестоимостиНУНаСервере();	
	
	ОповещениеОЗавершении = Новый ОписаниеОповещения("ВыполнитьРасчетСебестоимостиНУЗавершение", ЭтотОбъект);
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, ОповещениеОЗавершении, ПараметрыОжидания);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСостояние(Команда)
	
	НачатьОбновлениеФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьВводКорректировокСтоимостиОС(Команда)
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Месяц", МесяцРегламентныхОпераций());
	ПараметрыФормы.Вставить("Организации", ОрганизацииРегламентныхОпераций);
	
	ОткрытьФорму("Обработка.ПринятиеКУчетуИВключениеЗатратВСтоимостьОС.Форма.Форма",
					ПараметрыФормы,
					ЭтотОбъект, 
					УникальныйИдентификатор);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьОтражениеДокументовВРеглУчете(Команда)
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ДатаОкончанияПериода", КонецМесяца(МесяцРегламентныхОпераций()));
	
	Если НЕ ВсеОрганизацииРегламентныхОпераций И ОрганизацииРегламентныхОпераций.Количество() = 1 Тогда
		ПараметрыФормы.Вставить("Организация", ОрганизацииРегламентныхОпераций[0]);
	КонецЕсли;
	
	ОткрытьФорму("Обработка.НастройкаОтраженияДокументовВРеглУчете.Форма.ФормаНастройкиОтраженияДокументовВРеглУчете",
		ПараметрыФормы,
		ЭтотОбъект, 
		УникальныйИдентификатор);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьПерерасчетАмортизацииОС(Команда)
	
	ДлительнаяОперация = ВыполнитьПерерасчетАмортизацииОСНаСервере();
	
	ОповещениеОЗавершении = Новый ОписаниеОповещения("ВыполнитьПерерасчетАмортизацииОСЗавершение", ЭтотОбъект);
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, ОповещениеОЗавершении, ПараметрыОжидания);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура УстановитьЗначенияРеквизитовФормыПоУмолчанию(Знач Организация)
	
	Если ЗначениеЗаполнено(Организация) Тогда
		Запрос = Новый Запрос();
		Запрос.Текст = "ВЫБРАТЬ
		|	Организации.Ссылка КАК Организация
		|
		|ИЗ
		|	Справочник.Организации КАК Организации
		|ГДЕ
		|	Организации.ГоловнаяОрганизация = &Организация
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	&Организация
		|";
		Запрос.УстановитьПараметр("Организация", Организация);
		Результат = Запрос.Выполнить().Выгрузить();
		МассивОрганизаций = Результат.ВыгрузитьКолонку("Организация");
		ОрганизацииРегламентныхОпераций = Новый ФиксированныйМассив(МассивОрганизаций);
		ВсеОрганизацииРегламентныхОпераций = Ложь;
	Иначе
		ОрганизацииРегламентныхОпераций = Новый ФиксированныйМассив(Новый Массив);
		ВсеОрганизацииРегламентныхОпераций = Истина;
	КонецЕсли;
	
	СформироватьПредставлениеОрганизаций();
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция МесяцРегламентныхОпераций()
	
	Возврат НачалоМесяца(ТекущаяДатаСеанса());
	
КонецФункции

&НаСервере
Процедура СформироватьПредставлениеОрганизаций()
	
	Если ВсеОрганизацииРегламентныхОпераций Тогда
		ПредставлениеОрганизаций = НСтр("ru = 'По всем организациям';
										|en = 'By all companies'");
		
		Элементы.ПредставлениеОрганизаций.КнопкаОчистки = Ложь;
		
	Иначе
		
		ПредставлениеОрганизаций = РасчетСебестоимостиПрикладныеАлгоритмы.ПредставлениеОрганизаций(ОрганизацииРегламентныхОпераций, ", ");
		
		Элементы.ПредставлениеОрганизаций.КнопкаОчистки = Истина;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ЗаблокированныеОрганизации) И НЕ ВсеОрганизацииЗаблокированы() Тогда
		
		Элементы.ПредставлениеОрганизаций.ОтображениеПодсказки = ОтображениеПодсказки.Кнопка;
		Элементы.ПредставлениеОрганизаций.Подсказка = НСтр("ru = 'Расчет не будет выполнен по заблокированным организациям:';
															|en = 'Calculation will not be performed for locked companies:'");
		
		Для Каждого ТекОрганизация Из ЗаблокированныеОрганизации Цикл
			Элементы.ПредставлениеОрганизаций.Подсказка = Элементы.ПредставлениеОрганизаций.Подсказка
				+ Символы.ПС + СокрЛП(ТекОрганизация);
		КонецЦикла;
		
	Иначе
		
		Элементы.ПредставлениеОрганизаций.ОтображениеПодсказки = ОтображениеПодсказки.Нет;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ВсеОрганизацииЗаблокированы()
			
	ВсеОрганизацииЗаблокированы = Ложь;
	
	Если ЗначениеЗаполнено(ЗаблокированныеОрганизации) Тогда
		Если ВсеОрганизацииРегламентныхОпераций Тогда
			ВсеОрганизацииЗаблокированы = ОбщегоНазначенияКлиентСервер.РазностьМассивов(ДоступныеОрганизацииРегламентныхОпераций.ВыгрузитьЗначения(),
				ЗаблокированныеОрганизации).Количество() = 0;
		Иначе
			ВсеОрганизацииЗаблокированы = ОбщегоНазначенияКлиентСервер.РазностьМассивов(ОрганизацииРегламентныхОпераций,
				ЗаблокированныеОрганизации).Количество() = 0;
		КонецЕсли;
	КонецЕсли;

	Возврат ВсеОрганизацииЗаблокированы;
	
КонецФункции

&НаКлиенте
Процедура НачатьОбновлениеФормы()
	
	ДлительнаяОперация = НачатьОбновлениеФормыНаСервере();
	
	ОповещениеОЗавершении = Новый ОписаниеОповещения("ОбновлениеФормыЗавершение", ЭтотОбъект);
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, ОповещениеОЗавершении, ПараметрыОжидания);
	
КонецПроцедуры

&НаСервере
Функция НачатьОбновлениеФормыНаСервере()
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияФункции(УникальныйИдентификатор);
	
	ПараметрыПолученияДанныхПодготовкиДекларации = ПараметрыПолученияДанныхПодготовкиДекларации();
	
	ИмяФункции = "Обработки.ПомощникЗаполненияДекларацииПоНалогуНаПрибыль.ДанныеВыполненияРегламентныхОпераций";
	
	Возврат ДлительныеОперации.ВыполнитьФункцию(ПараметрыВыполнения, 
		ИмяФункции, ПараметрыПолученияДанныхПодготовкиДекларации);
	
КонецФункции

&НаСервере
Функция ПараметрыПолученияДанныхПодготовкиДекларации()
	
	ПараметрыПолученияДанных = Обработки.ПомощникЗаполненияДекларацииПоНалогуНаПрибыль.ПараметрыПолученияДанныхВыполненияРегламентныхОпераций();
	ПараметрыПолученияДанных.МесяцРегламентныхОпераций = МесяцРегламентныхОпераций();
	
	Если ВсеОрганизацииРегламентныхОпераций Тогда
		ПараметрыПолученияДанных.ОрганизацииРегламентныхОпераций = ДоступныеОрганизацииРегламентныхОпераций.ВыгрузитьЗначения();
	Иначе
		ПараметрыПолученияДанных.ОрганизацииРегламентныхОпераций = ОрганизацииРегламентныхОпераций;
	КонецЕсли;
	
	Возврат ПараметрыПолученияДанных;

КонецФункции

&НаКлиенте
Процедура ОбновлениеФормыЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;	
	КонецЕсли;
	
	Если Результат.Статус = "Ошибка" Тогда
		СтандартныеПодсистемыКлиент.ВывестиИнформациюОбОшибке(Результат.ИнформацияОбОшибке);
		Возврат;
	КонецЕсли;
	
	ОбновитьФормуПоДаннымЗаполнения(Результат);
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьФормуПоДаннымЗаполнения(Результат)
	
	ДанныеПодготовкаДекларации = ПолучитьИзВременногоХранилища(Результат.АдресРезультата);
	УдалитьИзВременногоХранилища(Результат.АдресРезультата);
	
	ОбновитьФормуПоДаннымЗаполненияУточненнойДекларации(ДанныеПодготовкаДекларации);
	НастроитьЭлементыФормыУточненнойДекларации(ДанныеПодготовкаДекларации);
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьФормуПоДаннымЗаполненияУточненнойДекларации(ДанныеПодготовкаДекларации)
	
	ДоступныеОрганизацииРегламентныхОпераций.ЗагрузитьЗначения(ДанныеПодготовкаДекларации.ДоступныеОрганизацииРегламентныхОпераций);
	
	Если Не ВсеОрганизацииРегламентныхОпераций Тогда
		НедостунныеОрганизации = ОбщегоНазначенияКлиентСервер.РазностьМассивов(ОрганизацииРегламентныхОпераций, 
			ДанныеПодготовкаДекларации.ДоступныеОрганизацииРегламентныхОпераций);
			
		ОрганизацииРегламентныхОпераций = Новый ФиксированныйМассив(ОбщегоНазначенияКлиентСервер.РазностьМассивов(ОрганизацииРегламентныхОпераций,
			НедостунныеОрганизации));
	КонецЕсли;
	
	Если ДоступныеОрганизацииРегламентныхОпераций.Количество() = 0 Тогда
		ВсеОрганизацииРегламентныхОпераций = Ложь;
	КонецЕсли;
	
	ЗаблокированныеОрганизации  = Новый ФиксированныйМассив(ДанныеПодготовкаДекларации.ЗаблокированныеОрганизации);
	
	СформироватьПредставлениеОрганизаций();
	
КонецПроцедуры

&НаСервере
Процедура НастроитьЭлементыФормыУточненнойДекларации(ДанныеПодготовкаДекларации)

	ВсеОрганизацииЗаблокированы = ВсеОрганизацииЗаблокированы();
	
	Элементы.НадписьПериодЗаблокирован.Видимость = ВсеОрганизацииЗаблокированы;
	Элементы.ГруппаРегламентныеОперации.Видимость = НЕ ВсеОрганизацииЗаблокированы
		И (НЕ ОрганизацииРегламентныхОпераций.Количество() = 0 ИЛИ ВсеОрганизацииРегламентныхОпераций);
		
	Если НЕ ДанныеПодготовкаДекларации.ЕстьДанныеДляКорректировкиСтоимостиОС Тогда
		Элементы.КартинкиВводКорректировокСтоимостиОС.ТекущаяСтраница = Элементы.ВводКорректировокСтоимостиОСВыполненоУспешно;
		Элементы.ОткрытьВводКорректировокСтоимостиОС.Заголовок = НСтр("ru = 'Подробнее';
																		|en = 'Details'");
	Иначе
		Элементы.КартинкиВводКорректировокСтоимостиОС.ТекущаяСтраница = Элементы.ВводКорректировокСтоимостиОСНеВыполнено;
		Элементы.ОткрытьВводКорректировокСтоимостиОС.Заголовок = НСтр("ru = 'Ввести';
																		|en = 'Enter'");
	КонецЕсли;
		
	Если ЗначениеЗаполнено(ДанныеПодготовкаДекларации.ПервыйМесяцРасчетаСебестоимостиНУ) Тогда
		Элементы.КартинкиРасчетСебестоимостиНУ.ТекущаяСтраница = Элементы.РасчетСебестоимостиНУНеВыполнено;
		МесяцРасчетаСебестоимости = ЗакрытиеМесяцаКлиентСервер.ПредставлениеПериодаМесяцГод(ДанныеПодготовкаДекларации.ПервыйМесяцРасчетаСебестоимостиНУ);
		МесяцРасчетаСебестоимости = ПолучитьСклоненияСтроки(МесяцРасчетаСебестоимости, , "ПД=Родительный")[0];
		
		Элементы.ДекорацияРасчетСебестоимостиНУ.Заголовок = СтрШаблон(НСтр("ru = 'Расчет себестоимости НУ с %1 г.';
																			|en = 'TA cost calculation since %1'"),
			МесяцРасчетаСебестоимости); 
	Иначе
		Элементы.КартинкиРасчетСебестоимостиНУ.ТекущаяСтраница = Элементы.РасчетСебестоимостиНУВыполненоУспешно;
		Элементы.ДекорацияРасчетСебестоимостиНУ.Заголовок = НСтр("ru = 'Расчет себестоимости НУ';
																|en = 'TA cost calculation'");
	КонецЕсли;
		
	Если ДанныеПодготовкаДекларации.ВыполненоОтражениеДокументовВРеглУчете Тогда
		Элементы.КартинкиОтражениеДокументовВРеглУчете.ТекущаяСтраница = Элементы.ОтражениеДокументовВРеглУчетеВыполненоУспешно;
	Иначе
		Элементы.КартинкиОтражениеДокументовВРеглУчете.ТекущаяСтраница = Элементы.ОтражениеДокументовВРеглУчетеНеВыполнено;
	КонецЕсли;
	
	Если ДанныеПодготовкаДекларации.ВыполненПерерасчетАмортизацииОС Тогда
		Элементы.КартинкиПерерасчетАмортизацииОС.ТекущаяСтраница = Элементы.ПерерасчетАмортизацииОСВыполненоУспешно;
	Иначе
		Элементы.КартинкиПерерасчетАмортизацииОС.ТекущаяСтраница = Элементы.ПерерасчетАмортизацииОСНеВыполнено;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ВыполнитьОтражениеДокументовВРеглУчетеНаСервере()
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияПроцедуры();
	
	ПараметрыОтражения = РеглУчетПроведениеСервер.ПараметрыОтраженияВРеглУчете();
	
	Если ВсеОрганизацииРегламентныхОпераций Тогда
		ПараметрыОтражения.Организации = ДоступныеОрганизацииРегламентныхОпераций.ВыгрузитьЗначения();
	Иначе
		ПараметрыОтражения.Организации = ОрганизацииРегламентныхОпераций;
	КонецЕсли;
	
	ИмяПроцедуры = "РеглУчетПроведениеСервер.ОтразитьВсе";
	
	Возврат ДлительныеОперации.ВыполнитьПроцедуру(ПараметрыВыполнения, 
		ИмяПроцедуры, ПараметрыОтражения);
	
КонецФункции

&НаКлиенте
Процедура ВыполнитьОтражениеДокументовВРеглУчетеНУЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;	
	КонецЕсли;
	
	Если Результат.Статус = "Ошибка" Тогда
		СтандартныеПодсистемыКлиент.ВывестиИнформациюОбОшибке(Результат.ИнформацияОбОшибке);
		Возврат;
	КонецЕсли;
	
	НачатьОбновлениеФормы();
		
КонецПроцедуры

