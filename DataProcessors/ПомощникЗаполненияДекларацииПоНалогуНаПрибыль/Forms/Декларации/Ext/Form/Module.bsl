#Область ОписаниеПеременных

&НаКлиенте
Перем КонтекстЭДОКлиент;

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗаполнитьРеквизитыФормы(Параметры);
	ОбновитьФорму();
	УстановитьУсловноеОформление();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
		
	ОписаниеОповещения = Новый ОписаниеОповещения("ПриОткрытииЗавершение", ЭтотОбъект);
	ДокументооборотСКОКлиент.ПолучитьКонтекстЭДО(ОписаниеОповещения);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыДекларации

&НаКлиенте
Процедура ДекларацииВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.Декларации.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Поле = Элементы.ДекларацииДекларация Тогда
		СтандартнаяОбработка = Ложь;
		
		Если ЗначениеЗаполнено(ТекущиеДанные.Декларация) Тогда
			ПоказатьЗначение(, ТекущиеДанные.Декларация);
		Иначе
			ИсточникОтчета = "РегламентированныйОтчетПрибыль";
			ОтчетныйПериод = ТекущиеДанные.ОтчетныйПериод;
			РегистрацияВНалоговомОргане = ТекущиеДанные.РегистрацияВНалоговомОргане;
			
			ПараметрыФормы = Новый Структура;
			ПараметрыФормы.Вставить("ИсточникОтчета", ИсточникОтчета);
			ПараметрыФормы.Вставить("Периодичность", "Произвольный");
			ПараметрыФормы.Вставить("ДатаНачалаПериодаОтчета", НачалоГода(ОтчетныйПериод));
			ПараметрыФормы.Вставить("ДатаКонцаПериодаОтчета", КонецМесяца(ОтчетныйПериод));
			ПараметрыФормы.Вставить("Организация", ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Организация));
			ПараметрыФормы.Вставить("КодИФНС", КодНалоговогоОргана(РегистрацияВНалоговомОргане));
			ПараметрыФормы.Вставить("ОтборКодИФНС", Истина);
			ПараметрыФормы.Вставить("ОтборПериод", Истина);
			
			ФормаВыбораОтчета = РегламентированнаяОтчетностьКлиент.ПолучитьОбщуюФормуПоИмени("ФормаВыбораОтчета", ПараметрыФормы, ЭтотОБъект);
						
			ОписаниеОповещения = Новый ОписаниеОповещения("ДекларацииВыборЗавершение", ЭтотОбъект);
			ФормаВыбораОтчета.ОписаниеОповещенияОЗакрытии = ОписаниеОповещения;
			ФормаВыбораОтчета.РежимОткрытияОкна = РежимОткрытияОкнаФормы.БлокироватьОкноВладельца;
			ФормаВыбораОтчета.Открыть();  
			
		КонецЕсли;
	ИначеЕсли Поле = Элементы.ДекларацииОчиститьДекларацию Тогда
		СтандартнаяОбработка = Ложь;

		Если ЗначениеЗаполнено(ТекущиеДанные.Декларация) Тогда
			ОчиститьДекларацию(ТекущиеДанные.РегистрацияВНалоговомОргане, ТекущиеДанные.КодМестаПредставления, 
				ТекущиеДанные.ОтчетныйПериод);
		КонецЕсли;

	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ДекларацииУстановитьФлажки(Команда)
	
	Для Каждого Строка Из Декларации Цикл
		Строка.СформироватьДекларацию = Истина;	
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ДекларацииСнятьФлажки(Команда)

	Для Каждого Строка Из Декларации Цикл
		Строка.СформироватьДекларацию = Ложь;	
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьДекларации(Команда)
	
	Если НетДекларацийКФормированию() Тогда
		Возврат;	
	КонецЕсли;
	
	ДлительнаяОперация = СформироватьДекларацииНаСервере();	
    
    ОповещениеОЗавершении = Новый ОписаниеОповещения("СформироватьДекларацииЗавершение", ЭтотОбъект);
    ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
    ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, ОповещениеОЗавершении, ПараметрыОжидания);
    
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьГрупповуюОтправкуОтчетов(Команда)
	
	Если КонтекстЭДОКлиент = Неопределено Тогда
		Возврат;
	КонецЕсли;
		
	Ссылки = Новый Массив;
	Для каждого Строка Из Декларации Цикл
		Если Строка.СформироватьДекларацию 
			И ЗначениеЗаполнено(Строка.Декларация) Тогда
			
			Ссылки.Добавить(Строка.Декларация);
			
		КонецЕсли;
	КонецЦикла;
	
	Если Ссылки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;	
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("Организация", Организация);
	ДополнительныеПараметры.Вставить("ВидОтчета", ВидОтчетаПрибыль());
	ДополнительныеПараметры.Вставить("Ссылки", Ссылки);
	
	ОткрытьФорму(КонтекстЭДОКлиент.ПутьКОбъекту + ".Форма.ГрупповаяОтправка", ДополнительныеПараметры, ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ВсеДекларации(Команда)
	
	ПараметрыФормы = Новый Структура();
	ПараметрыФормы.Вставить("Раздел", ПредопределенноеЗначение("Перечисление.СтраницыЖурналаОтчетность.Отчеты"));
	ПараметрыФормы.Вставить("Организация", Организация);
	ПараметрыФормы.Вставить("ВидОтчета", ВидОтчетаПрибыль());
	
	ОткрытьФорму("ОбщаяФорма.РегламентированнаяОтчетность", ПараметрыФормы, , "1С-Отчетность");
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСостояние(Команда)
	
	ОбновитьФорму();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Условное оформление формы
//
&НаСервере
Процедура УстановитьУсловноеОформление()
	
	УсловноеОформление.Элементы.Очистить();
	
	Элемент = УсловноеОформление.Элементы.Добавить();
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных("ДекларацииДекларация");
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Декларации.Декларация");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено;
	Элемент.Оформление.УстановитьЗначениеПараметра("Текст", "Выбрать");
	ОтборЭлемента.Использование = Истина;
	
	Элемент = УсловноеОформление.Элементы.Добавить();
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных("ДекларацииДекларация");
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Декларации.Декларация");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Заполнено;
	Элемент.Оформление.УстановитьЗначениеПараметра("Текст", "Открыть");
	ОтборЭлемента.Использование = Истина;
	
	Элемент = УсловноеОформление.Элементы.Добавить();
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных("ДекларацииОчиститьДекларацию");
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Декларации.Декларация");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Заполнено;
	Элемент.Оформление.УстановитьЗначениеПараметра("Текст", "х");
	ОтборЭлемента.Использование = Истина;
	
	Элемент = УсловноеОформление.Элементы.Добавить();
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных("Декларации");
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Декларации.ДекларацияНеАктуальна");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Истина;
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветФона", ЦветаСтиля.СобытиеОтказ);
	ОтборЭлемента.Использование = Истина;
	
КонецПроцедуры
	
&НаСервере
Процедура ОбновитьФорму()
	
	ДанныеДеклараций = НалогНаПрибыльКорректировки.ДанныеДекларацийНабораКорректировок(НаборКорректировок);
	
	Декларации.Загрузить(ДанныеДеклараций);
		
	ЗаполнитьОтчетныйПериодСтрокой();

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьОтчетныйПериодСтрокой()
	
	ПериодичностьДекларцииПоГодам = Новый Соответствие;
	
	ПериодичностьМесяц = Перечисления.Периодичность.Месяц;
	ФорматДаты = НСтр("ru = 'ДФ=''ММММ гггг"" г.""''';
						|en = 'DF=''MMMM yyyy'''");
	
	ДекларацииНабора = ОбщегоНазначения.ВыгрузитьКолонку(Декларации, "Декларация");
	СтатусыДеклараций = ИнтерфейсыВзаимодействияБРО.СтатусыРегламентированныхОтчетов(ДекларацииНабора);
	НомераКорректировок = ОбщегоНазначения.ЗначениеРеквизитаОбъектов(ДекларацииНабора, "Вид");
	
	Для Каждого Строка Из Декларации Цикл
		НачалоГодаОтчета = Год(Строка.ОтчетныйПериод);
		
		Периодичность = ПериодичностьДекларцииПоГодам.Получить(НачалоГодаОтчета);
		
		Если Периодичность = Неопределено Тогда
			Периодичность = НалоговыйУчет.ПериодичностьОтчетногоПериода(Строка.ОтчетныйПериод, Организация);
			ПериодичностьДекларцииПоГодам.Вставить(НачалоГодаОтчета, Периодичность);
		КонецЕсли;
		
		Если Периодичность = ПериодичностьМесяц Тогда
			Если Месяц(Строка.ОтчетныйПериод) = 1 Тогда 
				Строка.ОтчетныйПериодСтрокой = Формат(Строка.ОтчетныйПериод, ФорматДаты);
			Иначе
				Строка.ОтчетныйПериодСтрокой = Формат(НачалоГода(Строка.ОтчетныйПериод), ФорматДаты) + " - " + Формат(Строка.ОтчетныйПериод, ФорматДаты);
			КонецЕсли;
		Иначе
			Строка.ОтчетныйПериодСтрокой = ПредставлениеПериода(НачалоГода(Строка.ОтчетныйПериод), КонецКвартала(Строка.ОтчетныйПериод), "ФП = Истина");
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Строка.Декларация) Тогда
			Строка.НомерКорректировки = НомераКорректировок.Получить(Строка.Декларация);
			Строка.Состояние = СтатусыДеклараций.Получить(Строка.Декларация);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ДекларацииВыборЗавершение(РезультатВыбора, ДополнительныеПараметры) Экспорт
		
	Если РезультатВыбора = Истина ИЛИ НЕ ЗначениеЗаполнено(РезультатВыбора) Тогда
		Возврат;
	КонецЕсли;

	ТекущиеДанные = Элементы.Декларации.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;	
	КонецЕсли;
	
	ЗаписатьВыборДекларации(РезультатВыбора, ТекущиеДанные.РегистрацияВНалоговомОргане,
		ТекущиеДанные.КодМестаПредставления, ТекущиеДанные.ОтчетныйПериод);

КонецПроцедуры

&НаСервере
Процедура ЗаписатьВыборДекларации(Знач Декларация, Знач РегистрацияВНалоговомОргане, 
	Знач КодМестаПредставления, Знач ОтчетныйПериод)
	
	ПараметрыЗаписи = НалогНаПрибыльКорректировки.ПараметрыЗаписиДекларации();
	ПараметрыЗаписи.НаборКорректировок = НаборКорректировок;
	ПараметрыЗаписи.РегистрацияВНалоговомОргане = РегистрацияВНалоговомОргане;
	ПараметрыЗаписи.КодМестаПредставления = КодМестаПредставления;
	ПараметрыЗаписи.ОтчетныйПериод = ОтчетныйПериод;
	ПараметрыЗаписи.Декларация = Декларация;
	
	НалогНаПрибыльКорректировки.ЗаписатьДанныеДекларацииПоНабору(ПараметрыЗаписи);
	
	ОбновитьФорму();
		
КонецПроцедуры

&НаСервере
Процедура ОчиститьДекларацию(Знач РегистрацияВНалоговомОргане, Знач КодМестаПредставления, Знач ОтчетныйПериод)
		
	ПараметрыЗаписи = НалогНаПрибыльКорректировки.ПараметрыЗаписиДекларации();
	ПараметрыЗаписи.НаборКорректировок = НаборКорректировок;
	ПараметрыЗаписи.РегистрацияВНалоговомОргане = РегистрацияВНалоговомОргане;
	ПараметрыЗаписи.КодМестаПредставления = КодМестаПредставления;
	ПараметрыЗаписи.ОтчетныйПериод = ОтчетныйПериод;
	
	НалогНаПрибыльКорректировки.ОчиститьДекларациюПоНабору(ПараметрыЗаписи);
	
	ОбновитьФорму();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьРеквизитыФормы(Параметры)
		
	Организация = Параметры.Организация;
	НаборКорректировок = Параметры.НаборКорректировок;
		
КонецПроцедуры

&НаСервереБезКонтекста
Функция КодНалоговогоОргана(Знач РегистрацияВНО)
	
	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(РегистрацияВНО, "Код");
	
КонецФункции

&НаКлиенте
Функция ВидОтчетаПрибыль()
	
	Возврат НСтр("ru = 'Декларация по налогу на прибыль';
				|en = 'Profit tax declaration'");
	
КонецФункции

&НаКлиенте
Процедура ПриОткрытииЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	КонтекстЭДОКлиент = Результат.КонтекстЭДО;
	
	Элементы.ДекларацииОткрытьГрупповуюОтправкуОтчетов.Видимость = КонтекстЭДОКлиент <> Неопределено;
	
КонецПроцедуры

&НаКлиенте
Функция НетДекларацийКФормированию()
	
	НетДекларацийКФормированию = Истина;
	
	Для Каждого Строка Из Декларации Цикл
		Если Строка.СформироватьДекларацию 
			И НЕ ЗначениеЗаполнено(Строка.Декларация) Тогда
			
			НетДекларацийКФормированию = Ложь;	
		КонецЕсли;	
	КонецЦикла;
	
	Возврат НетДекларацийКФормированию;
	
КонецФункции

&НаКлиенте
Процедура СформироватьДекларацииЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;	
	КонецЕсли;
	
	Если Результат.Статус = "Ошибка" Тогда
		СтандартныеПодсистемыКлиент.ВывестиИнформациюОбОшибке(Результат.ИнформацияОбОшибке);
		Возврат;
	КонецЕсли;
	
	ОбновитьФорму();
		
КонецПроцедуры

&НаСервере
Функция СформироватьДекларацииНаСервере()
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияПроцедуры();
	
	ПараметрыФормированияДеклараций = ПараметрыФормированияДеклараций();
	
	ИмяПроцедуры = "Обработки.ПомощникЗаполненияДекларацииПоНалогуНаПрибыль.СформироватьДекларации";
	
	Возврат ДлительныеОперации.ВыполнитьПроцедуру(ПараметрыВыполнения, 
		ИмяПроцедуры, ПараметрыФормированияДеклараций);
	
КонецФункции

&НаСервере
Функция ПараметрыФормированияДеклараций()
	
	ПараметрыФормированияДеклараций = Обработки.ПомощникЗаполненияДекларацииПоНалогуНаПрибыль.ПараметрыФормированияДеклараций();
	ПараметрыФормированияДеклараций.Организация = Организация;
	ПараметрыФормированияДеклараций.НаборКорректировок = НаборКорректировок;

	ПериодичностьДекларцииПоГодам = Новый Соответствие;
	ФормыОтчетовПоПериодам = Новый Соответствие;
	
	Для Каждого Строка Из Декларации Цикл
		Если Строка.СформироватьДекларацию 
			И НЕ ЗначениеЗаполнено(Строка.Декларация) Тогда
				
			Если Строка.КодМестаПредставления = "223" Тогда
				Продолжить;
			КонецЕсли;
			
			НачалоГодаОтчета = Год(Строка.ОтчетныйПериод);
			Периодичность = ПериодичностьДекларцииПоГодам.Получить(НачалоГодаОтчета);
			
			Если Периодичность = Неопределено Тогда
				Периодичность = НалоговыйУчет.ПериодичностьОтчетногоПериода(Строка.ОтчетныйПериод, Организация);
				ПериодичностьДекларцииПоГодам.Вставить(НачалоГодаОтчета, Периодичность);
			КонецЕсли;
			
			НоваяСтрока = ПараметрыФормированияДеклараций.Декларации.Добавить();
			НоваяСтрока.РегистрацияВНалоговомОргане = Строка.РегистрацияВНалоговомОргане;
			НоваяСтрока.КодМестаПредставления = Строка.КодМестаПредставления;
			НоваяСтрока.НачалоПериодаОтчета = НачалоГода(Строка.ОтчетныйПериод);
			НоваяСтрока.КонецПериодаОтчета = НачалоДня(КонецМесяца(Строка.ОтчетныйПериод));
			НоваяСтрока.ОтчетныйПериод = Строка.ОтчетныйПериод;
			НоваяСтрока.Периодичность = Периодичность;
			
			ИмяФормыОтчета = ФормыОтчетовПоПериодам.Получить(Строка.ОтчетныйПериод);
			
			Если ИмяФормыОтчета = Неопределено Тогда
				ИмяФормыОтчета = РегламентированнаяОтчетностьВызовСервера.ИмяФормыРеглОтчетаДействующейВОтчетномПериоде("РегламентированныйОтчетПрибыль", 
					Строка.ОтчетныйПериод);
				ФормыОтчетовПоПериодам.Вставить(Строка.ОтчетныйПериод, ИмяФормыОтчета);
			КонецЕсли;
			
			НоваяСтрока.ИмяФормы = ИмяФормыОтчета;

		КонецЕсли;
	КонецЦикла;
	
	ЗаполнитьВариантыНалогообложенияПрибыли(ПараметрыФормированияДеклараций);

	Возврат ПараметрыФормированияДеклараций;

КонецФункции

&НаСервере
Процедура ЗаполнитьВариантыНалогообложенияПрибыли(ПараметрыФормированияДеклараций)
	
	Организация = ПараметрыФормированияДеклараций.Организация;
	ВариантыНалогообложенияПрибыли = ПараметрыФормированияДеклараций.ВариантыНалогообложенияПрибыли;
	ДекларацииНабора = ПараметрыФормированияДеклараций.Декларации;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Декларации", ДекларацииНабора);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("НаборКорректировок", НаборКорректировок);
	
	Запрос.Текст = ТекстЗапроса_ЗаполнитьВариантыНалогообложенияПрибыли();
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(ВариантыНалогообложенияПрибыли.Добавить(), Выборка);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ТекстЗапроса_ЗаполнитьВариантыНалогообложенияПрибыли()
	
	Текст = "
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВТ_Декларации.КонецПериодаОтчета КАК КонецПериодаОтчета,
	|	ВТ_Декларации.КодМестаПредставления КАК КодМестаПредставления
	|ПОМЕСТИТЬ ВТ_Декларации
	|ИЗ
	|	&Декларации КАК ВТ_Декларации
	|ГДЕ
	|	НЕ ВТ_Декларации.КодМестаПредставления В (""220"", ""223"")
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	КонецПериодаОтчета
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	РасчетНалогаНаПрибыль.ВариантНалогообложенияПрибыли КАК ВариантНалогообложенияПрибыли,
	|	ЕСТЬNULL(РасчетНалогаНаПрибыль.ВариантНалогообложенияПрибыли.КодМестаПредставления, """") КАК КодМестаПредставления,
	|	РасчетНалогаНаПрибыль.ПериодРасчета КАК ПериодРасчета
	|ПОМЕСТИТЬ ВТ_РасчетНалогаНаПрибыль
	|ИЗ
	|	РегистрСведений.РасчетНалогаНаПрибыль КАК РасчетНалогаНаПрибыль
	|ГДЕ
	|	РасчетНалогаНаПрибыль.Активность
	|	И РасчетНалогаНаПрибыль.Организация = &Организация
	|	И РасчетНалогаНаПрибыль.ВариантНалогообложенияПрибыли <> ЗНАЧЕНИЕ(Справочник.ВариантыНалогообложенияПрибыли.ПустаяСсылка)
	|	И РасчетНалогаНаПрибыль.НаборКорректировок = &НаборКорректировок
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	КодМестаПредставления,
	|	ПериодРасчета
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Декларации.КонецПериодаОтчета КАК КонецПериодаОтчета,
	|	ВТ_Декларации.КодМестаПредставления КАК КодМестаПредставления,
	|	ВТ_РасчетНалогаНаПрибыль.ВариантНалогообложенияПрибыли КАК ВариантНалогообложенияПрибыли
	|ИЗ
	|	ВТ_Декларации КАК ВТ_Декларации
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_РасчетНалогаНаПрибыль КАК ВТ_РасчетНалогаНаПрибыль
	|		ПО ВТ_Декларации.КонецПериодаОтчета = ВТ_РасчетНалогаНаПрибыль.ПериодРасчета
	|		И ВТ_Декларации.КодМестаПредставления = ВТ_РасчетНалогаНаПрибыль.КодМестаПредставления
	|		";
	
	Возврат Текст;
	
КонецФункции

#КонецОбласти

