	|							ДокументыУчетаЗатрат.АналитикаКапитализацииРасходов = ПрочиеРасходы.ОсновноеСредство
	|							И ДокументыУчетаЗатрат.Период >= ПрочиеРасходы.Период
	|							И (ПрочиеРасходы.СуммаБУ = 0 ИЛИ ДокументыУчетаЗатрат.ОтражатьВБУ))
	|					ТОГДА ИСТИНА
	|				ИНАЧЕ ЛОЖЬ
	|			КОНЕЦ КАК УчтеноБУ,
	|
	|			ВЫБОР
	|				КОГДА ИСТИНА В
	|						(ВЫБРАТЬ ПЕРВЫЕ 1
	|							ИСТИНА
	|						ИЗ
	|							ДокументыУчетаЗатрат КАК ДокументыУчетаЗатрат
	|						ГДЕ
	|							ДокументыУчетаЗатрат.АналитикаКапитализацииРасходов = ПрочиеРасходы.ОсновноеСредство
	|							И ДокументыУчетаЗатрат.Период >= ПрочиеРасходы.Период
	|							И (ПрочиеРасходы.СуммаНУ = 0 ИЛИ ДокументыУчетаЗатрат.ОтражатьВНУ))
	|					ТОГДА ИСТИНА
	|				ИНАЧЕ ЛОЖЬ
	|			КОНЕЦ КАК УчтеноНУ,
	|
	|			ВЫБОР
	|				КОГДА ИСТИНА В
	|						(ВЫБРАТЬ ПЕРВЫЕ 1
	|							ИСТИНА
	|						ИЗ
	|							ДокументыУчетаЗатрат КАК ДокументыУчетаЗатрат
	|						ГДЕ
	|							ДокументыУчетаЗатрат.АналитикаКапитализацииРасходов = ПрочиеРасходы.ОсновноеСредство
	|							И ДокументыУчетаЗатрат.Период >= ПрочиеРасходы.Период
	|							И (ПрочиеРасходы.СуммаУУ = 0 ИЛИ ДокументыУчетаЗатрат.ОтражатьВУпрУчете))
	|					ТОГДА ИСТИНА
	|				ИНАЧЕ ЛОЖЬ
	|			КОНЕЦ КАК УчтеноУУ
	|
	|		ИЗ
	|			ПрочиеРасходы КАК ПрочиеРасходы
	|
	|		) КАК ПрочиеРасходы
	|
	|	СГРУППИРОВАТЬ ПО
	|		ПрочиеРасходы.ОсновноеСредство,
	|		ПрочиеРасходы.Организация
	|
	|	) КАК ПрочиеРасходы
	|
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ОбъектыЭксплуатации КАК ОбъектыЭксплуатации
	|		ПО ОбъектыЭксплуатации.Ссылка = ПрочиеРасходы.ОсновноеСредство
	|
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ОбъектыСтроительства КАК ОбъектыСтроительства
	|		ПО ОбъектыСтроительства.Ссылка = ПрочиеРасходы.ОсновноеСредство
	|
	|		ЛЕВОЕ СОЕДИНЕНИЕ СостояниеОС КАК СостояниеОС
	|		ПО СостояниеОС.Организация = ПрочиеРасходы.Организация
	|			И СостояниеОС.ОсновноеСредство = ПрочиеРасходы.ОсновноеСредство
	|
	|УПОРЯДОЧИТЬ ПО
	|	СсылкаПредставление,
	|	ИнвентарныйНомер
	|";
	
	СписокЗапросов.Добавить(ТекстЗапроса);
	
	#КонецОбласти
	
	НачалоПериода = ?(Параметры.НачалоПериода <> '000101010000', Параметры.НачалоПериода, НачалоМесяца(ТекущаяДатаСеанса()));
	КонецПериода = ?(Параметры.КонецПериода <> '000101010000', Параметры.КонецПериода, ТекущаяДатаСеанса());
	
	ТекстЗапроса = СтрСоединить(СписокЗапросов, ОбщегоНазначения.РазделительПакетаЗапросов());
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц();
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода);
	Запрос.УстановитьПараметр("Организация", Параметры.Организация);
	Запрос.УстановитьПараметр("Подразделение", Параметры.Подразделение);
	Запрос.УстановитьПараметр("ОсновноеСредство", Параметры.ОсновноеСредство);
	Запрос.УстановитьПараметр("ПредставлениеОбъектыСтроительства", НСтр("ru = 'Объект строительства';
																		|en = 'Assets under construction'"));
	Запрос.УстановитьПараметр("ПредставлениеГрупповоеОС", Строка(Перечисления.ТипыОС.ГрупповоеОС));
	Запрос.УстановитьПараметр("ПредставлениеКомпонентАмортизации", Строка(Перечисления.ТипыОС.КомпонентАмортизации));
	Запрос.УстановитьПараметр("ПредставлениеУзел", Строка(Перечисления.ТипыОС.Узел));
	Запрос.УстановитьПараметр("ПредставлениеКапитальноеВложение", Строка(Перечисления.ТипыОС.КапитальноеВложение));
	Запрос.УстановитьПараметр("ПредставлениеОбъектЭксплуатации", НСтр("ru = 'Основное средство';
																		|en = 'Fixed asset'"));
	Запрос.УстановитьПараметр("ТипыДокументовПоКоторымРассчитываетсяСтоимость", РасчетСтоимостиВНА.ТипыДокументовПоКоторымРассчитываетсяСтоимость());
	
	Результат = Запрос.ВыполнитьПакет();
	
	ДанныеРабочегоМеста = Новый Структура();
	ДанныеРабочегоМеста.Вставить("Список", Результат[Результат.ВГраница()].Выгрузить());
	ДанныеРабочегоМеста.Вставить("СписокЗатрат", Результат[Результат.ВГраница()-1].Выгрузить());
	ДанныеРабочегоМеста.Вставить("СписокВалютРегл", Результат[Результат.ВГраница()-2].Выгрузить());
	
	ОценкаПроизводительности.ЗакончитьЗамерДлительнойОперации(ОписаниеЗамера, ДанныеРабочегоМеста.Список.Количество());

	Возврат ДанныеРабочегоМеста;
	
КонецФункции

// 
// Параметры:
//	НачалоПериода - Дата - Начало периода
//	КонецПериода - Дата - Конец периода
//  Организация - СправочникСсылка.Организации - Организация
//  ТолькоОтклонения - Булево - Только отклонения
// 
// Возвращаемое значение:
//  Булево - Есть данные
Функция ЕстьДанные(НачалоПериода, КонецПериода, Организация, ТолькоОтклонения = Ложь) Экспорт

	ОписаниеЗамера = ОценкаПроизводительности.НачатьЗамерДлительнойОперации("Обработка.ПринятиеКУчетуИВключениеЗатратВСтоимостьОС.ЕстьДанные");

	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ДоступныеСтатьи.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ ДоступныеСтатьи
	|
	|ИЗ
	|	ПланВидовХарактеристик.СтатьиРасходов КАК ДоступныеСтатьи
	|
	|ГДЕ
	|	ДоступныеСтатьи.ТипРасходов = ЗНАЧЕНИЕ(Перечисление.ТипыРасходов.ФормированиеСтоимостиВНА)
	|
	|	И (ДоступныеСтатьи.ВариантРаспределенияРасходовУпр = ЗНАЧЕНИЕ(Перечисление.ВариантыРаспределенияРасходов.НаВнеоборотныеАктивы)
	|		ИЛИ ДоступныеСтатьи.ВариантРаспределенияРасходовРегл = ЗНАЧЕНИЕ(Перечисление.ВариантыРаспределенияРасходов.НаВнеоборотныеАктивы)
	|		ИЛИ ДоступныеСтатьи.ВариантРаспределенияРасходовНУ = ЗНАЧЕНИЕ(Перечисление.ВариантыРаспределенияРасходов.НаВнеоборотныеАктивы))
	|
	|	И (ДоступныеСтатьи.РасходыНаОбъектыЭксплуатации
	|		ИЛИ ДоступныеСтатьи.РасходыНаОбъектыСтроительства)
	|	
	|ИНДЕКСИРОВАТЬ ПО
	|	Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПрочиеРасходы.Регистратор КАК Регистратор,
	|	ПрочиеРасходы.Период КАК Период,
	|	ПрочиеРасходы.АналитикаРасходов КАК ОсновноеСредство,
	|	ПрочиеРасходы.Организация КАК Организация,
	|	ПрочиеРасходы.ПериодОтклонения КАК ПериодОтклонения,
	|	
	|	ВЫБОР
	|		КОГДА ПрочиеРасходы.СтатьяРасходов.ТипРасходов = ЗНАЧЕНИЕ(Перечисление.ТипыРасходов.ФормированиеСтоимостиВНА)
	|			И ПрочиеРасходы.СтатьяРасходов.ВариантРаспределенияРасходовУпр = ЗНАЧЕНИЕ(Перечисление.ВариантыРаспределенияРасходов.НаВнеоборотныеАктивы)
	|			ТОГДА ВЫБОР 
	|					КОГДА ПрочиеРасходы.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|						ТОГДА ПрочиеРасходы.СуммаУпр
	|					ИНАЧЕ -ПрочиеРасходы.СуммаУпр
	|				КОНЕЦ
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК СуммаУУ,
	|	
	|	ВЫБОР
	|		КОГДА ПрочиеРасходы.СтатьяРасходов.ТипРасходов = ЗНАЧЕНИЕ(Перечисление.ТипыРасходов.ФормированиеСтоимостиВНА)
	|			И ПрочиеРасходы.СтатьяРасходов.ВариантРаспределенияРасходовРегл = ЗНАЧЕНИЕ(Перечисление.ВариантыРаспределенияРасходов.НаВнеоборотныеАктивы)
	|		ТОГДА ВЫБОР 
	|				КОГДА ПрочиеРасходы.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|						ТОГДА ПрочиеРасходы.СуммаРегл
	|					ИНАЧЕ -ПрочиеРасходы.СуммаРегл
	|				КОНЕЦ
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК СуммаБУ,
	|	
	|	ВЫБОР
	|		КОГДА ПрочиеРасходы.СтатьяРасходов.ТипРасходов = ЗНАЧЕНИЕ(Перечисление.ТипыРасходов.ФормированиеСтоимостиВНА)
	|			И ПрочиеРасходы.СтатьяРасходов.ВариантРаспределенияРасходовНУ = ЗНАЧЕНИЕ(Перечисление.ВариантыРаспределенияРасходов.НаВнеоборотныеАктивы)
	|			ТОГДА ВЫБОР 
	|					КОГДА ПрочиеРасходы.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|						ТОГДА ПрочиеРасходы.СуммаРегл
	|					ИНАЧЕ -ПрочиеРасходы.СуммаРегл
	|				КОНЕЦ
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК СуммаНУ
	|
	|ПОМЕСТИТЬ ПрочиеРасходы_Движения
	|
	|ИЗ
	|	РегистрНакопления.ПрочиеРасходы КАК ПрочиеРасходы
	|
	|ГДЕ
	|	ПрочиеРасходы.Период МЕЖДУ &НачалоПериода И &КонецПериода
	|	И НЕ ТИПЗНАЧЕНИЯ(ПрочиеРасходы.Регистратор) В (&ТипыДокументовПоКоторымРассчитываетсяСтоимость)
	|	И ПрочиеРасходы.Активность
	|
	|	И (ПрочиеРасходы.Организация = &Организация
	|			ИЛИ &Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка))
	|
	|	И (НЕ &ТолькоОтклонения
	|			ИЛИ ПрочиеРасходы.ПериодОтклонения <> ДАТАВРЕМЯ(1,1,1))
	|
	|	И ПрочиеРасходы.СтатьяРасходов В (
	|				ВЫБРАТЬ
	|					ДоступныеСтатьи.Ссылка
	|				ИЗ
	|			 		ДоступныеСтатьи)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПрочиеРасходы.Период КАК Период,
	|	ПрочиеРасходы.ОсновноеСредство КАК ОсновноеСредство,
	|	ПрочиеРасходы.Организация КАК Организация,
	|	ПрочиеРасходы.ПериодОтклонения КАК ПериодОтклонения,
	|	
	|	ПрочиеРасходы.СуммаУУ КАК СуммаУУ,
	|	ПрочиеРасходы.СуммаБУ КАК СуммаБУ,
	|	ПрочиеРасходы.СуммаНУ КАК СуммаНУ
	|
	|ПОМЕСТИТЬ ПрочиеРасходы
	|
	|ИЗ
	|	(ВЫБРАТЬ
	|		&НачалоПериода КАК Период,
	|		ПрочиеРасходы.АналитикаРасходов КАК ОсновноеСредство,
	|		ПрочиеРасходы.Организация КАК Организация,
	|		ДАТАВРЕМЯ(1,1,1) КАК ПериодОтклонения,
	|	
	|		ВЫБОР
	|			КОГДА ПрочиеРасходы.СтатьяРасходов.ТипРасходов = ЗНАЧЕНИЕ(Перечисление.ТипыРасходов.ФормированиеСтоимостиВНА)
	|				И ПрочиеРасходы.СтатьяРасходов.ВариантРаспределенияРасходовУпр = ЗНАЧЕНИЕ(Перечисление.ВариантыРаспределенияРасходов.НаВнеоборотныеАктивы)
	|				ТОГДА ПрочиеРасходы.СуммаУпрОстаток
	|			ИНАЧЕ 0
	|		КОНЕЦ КАК СуммаУУ,
	|	
	|		ВЫБОР
	|			КОГДА ПрочиеРасходы.СтатьяРасходов.ТипРасходов = ЗНАЧЕНИЕ(Перечисление.ТипыРасходов.ФормированиеСтоимостиВНА)
	|				И ПрочиеРасходы.СтатьяРасходов.ВариантРаспределенияРасходовРегл = ЗНАЧЕНИЕ(Перечисление.ВариантыРаспределенияРасходов.НаВнеоборотныеАктивы)
	|				ТОГДА ПрочиеРасходы.СуммаРеглОстаток
	|			ИНАЧЕ 0
	|		КОНЕЦ КАК СуммаБУ,
	|	
	|		ВЫБОР
	|			КОГДА ПрочиеРасходы.СтатьяРасходов.ТипРасходов = ЗНАЧЕНИЕ(Перечисление.ТипыРасходов.ФормированиеСтоимостиВНА)
	|				И ПрочиеРасходы.СтатьяРасходов.ВариантРаспределенияРасходовНУ = ЗНАЧЕНИЕ(Перечисление.ВариантыРаспределенияРасходов.НаВнеоборотныеАктивы)
	|				ТОГДА ПрочиеРасходы.СуммаРеглОстаток - ПрочиеРасходы.ПостояннаяРазницаОстаток - ПрочиеРасходы.ВременнаяРазницаОстаток
	|			ИНАЧЕ 0
	|		КОНЕЦ КАК СуммаНУ
	|
	|	ИЗ
	|		РегистрНакопления.ПрочиеРасходы.Остатки(
	|			&НачалоПериода,
	|			НЕ &ТолькоОтклонения
	|			И (Организация = &Организация
	|					ИЛИ &Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка))
	|				И СтатьяРасходов В (
	|					ВЫБРАТЬ
	|						ДоступныеСтатьи.Ссылка
	|					ИЗ
	|				 		ДоступныеСтатьи)
	|			) КАК ПрочиеРасходы
	|
	|	ОБЪЕДИНИТЬ ВСЕ
	|
	|	ВЫБРАТЬ
	|		ПрочиеРасходы.Период КАК Период,
	|		ПрочиеРасходы.ОсновноеСредство КАК ОсновноеСредство,
	|		ПрочиеРасходы.Организация КАК Организация,
	|		ПрочиеРасходы.ПериодОтклонения КАК ПериодОтклонения,
	|	
	|		ПрочиеРасходы.СуммаУУ КАК СуммаУУ,
	|		ПрочиеРасходы.СуммаБУ КАК СуммаБУ,
	|		ПрочиеРасходы.СуммаНУ КАК СуммаНУ
	|
	|	ИЗ
	|		ПрочиеРасходы_Движения КАК ПрочиеРасходы
	|
	|	ОБЪЕДИНИТЬ ВСЕ
	|
	|	ВЫБРАТЬ 
	|		ДанныеДокумента.Дата КАК Период,
	|		ТаблицаТовары.АналитикаРасходов КАК ОсновноеСредство,
	|		ДанныеДокумента.Организация КАК Организация,
	|		ДАТАВРЕМЯ(1,1,1) КАК ПериодОтклонения,
	|	
	|		0 КАК СуммаУУ,
	|		0 КАК СуммаБУ,
	|		0 КАК СуммаНУ
	|
	|	ИЗ
	|		Документ.ВнутреннееПотребление КАК ДанныеДокумента
	|
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ВнутреннееПотребление.Товары ТаблицаТовары
	|			ПО ТаблицаТовары.Ссылка = ДанныеДокумента.Ссылка
	|
	|	ГДЕ
	|		ДанныеДокумента.Дата МЕЖДУ &НачалоПериода И &КонецПериода
	|		И ДанныеДокумента.Проведен
	|
	|		И (ДанныеДокумента.Организация = &Организация
	|				ИЛИ &Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка))
	|
	|		И НЕ &ТолькоОтклонения
	|
	|		И ТаблицаТовары.СтатьяРасходов В (
	|					ВЫБРАТЬ
	|						ДоступныеСтатьи.Ссылка
	|					ИЗ
	|				 		ДоступныеСтатьи)
	|
	|	) КАК ПрочиеРасходы
	|
	|ГДЕ
	|	ТИПЗНАЧЕНИЯ(ПрочиеРасходы.ОсновноеСредство) В (
	|		ТИП(Справочник.ОбъектыЭксплуатации),
	|		ТИП(Справочник.ОбъектыСтроительства))
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ОсновноеСредство
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
