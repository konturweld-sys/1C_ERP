
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	УстановитьУсловноеОформление();

	Если Параметры.Свойство("АвтоТест") Тогда // Возврат при получении формы для анализа.
		Возврат;
	КонецЕсли;

	УстановитьТекстЗапросовДинамическихСписков();

	НастроитьСписокДокументов();

	ВосстановитьНастройки();

	НовыеСлужебныеПараметрыФормы = Новый Структура();
	НовыеСлужебныеПараметрыФормы.Вставить("ВедетсяРегламентированныйУчетВНА", ВнеоборотныеАктивыСлужебный.ВедетсяРегламентированныйУчетВНА());
	СлужебныеПараметрыФормы = Новый ФиксированнаяСтруктура(НовыеСлужебныеПараметрыФормы);
	
	Если НЕ ПравоДоступа("ИнтерактивноеДобавление", Метаданные.Документы.ПринятиеКУчетуОС2_4)
		И НЕ ПравоДоступа("ИнтерактивноеДобавление", Метаданные.Документы.ПринятиеКУчетуУзловКомпонентовАмортизации) Тогда
		
		Элементы.СписокОформитьПринятиеКУчету.Видимость = Ложь;
		Элементы.СписокКонтекстноеМенюОформитьПринятиеКУчету.Видимость = Ложь;
		Элементы.СписокЗатратОформитьПринятиеКУчетуНаОснованииОтклонений.Видимость = Ложь;
	КонецЕсли;

	Если НЕ ПравоДоступа("ИнтерактивноеДобавление", Метаданные.Документы.МодернизацияОС2_4) Тогда
		Элементы.СписокОформитьМодернизацию.Видимость = Ложь;
		Элементы.СписокОформитьВключениеРасходовВСтоимость.Видимость = Ложь;
		Элементы.СписокКонтекстноеМенюОформитьМодернизацию.Видимость = Ложь;
		Элементы.СписокКонтекстноеМенюОформитьВключениеРасходовВСтоимость.Видимость = Ложь;
		Элементы.СписокЗатратОформитьМодернизациюНаОснованииОтклонений.Видимость = Ложь;
	КонецЕсли;

	Если НЕ ПравоДоступа("ИнтерактивноеДобавление", Метаданные.Документы.ОтнесениеОтклоненийВСтоимостьОС) Тогда
		Элементы.СписокОформитьОтнесениеОтклоненийВСтоимостьОС.Видимость = Ложь;
		Элементы.СписокКонтекстноеМенюОформитьОтнесениеОтклоненийВСтоимостьОС.Видимость = Ложь;
		Элементы.СписокЗатратОформитьОтнесениеОтклоненийВСтоимостьОСНаОснованииОтклонений.Видимость = Ложь;
	КонецЕсли;
	
	Если НЕ НастройкиНалоговУчетныхПолитикПовтИсп.РеглУчетВНАВедетсяНезависимо() Тогда
		Элементы.СписокДатаПринятияКУчетуБУ.Видимость = Ложь;
		Элементы.СписокДатаПринятияКУчетуУУ.Заголовок = НСтр("ru = 'Дата принятия к учету';
															|en = 'Date of recognition'");
		Элементы.СписокГруппаСостояние.ОтображатьВШапке = Ложь;
		Элементы.СписокДокументыОтраженВУУКартинка.Видимость = Ложь;
		Элементы.СписокДокументыОтраженВБУКартинка.Видимость = Ложь;
	КонецЕсли;
	
	Если НЕ ПолучитьФункциональнуюОпцию("ИспользоватьОбъектыСтроительства") Тогда
		Элементы.СписокОсновноеСредство.Заголовок = НСтр("ru = 'Основное средство';
														|en = 'Fixed asset'");
		Элементы.СписокЗатратОсновноеСредство.Заголовок = НСтр("ru = 'Основное средство';
																|en = 'Fixed asset'");
	КонецЕсли;
	
	Если НЕ СлужебныеПараметрыФормы.ВедетсяРегламентированныйУчетВНА Тогда
		Элементы.СписокДокументыОтраженВНУКартинка.Видимость = Ложь;
	КонецЕсли;
	
	#Область СтандартныеМеханизмы
	
	ДополнительныеПараметры = Новый Структура("МестоРазмещенияДанныхПроверкиРегл", Элементы.СписокДокументыГруппаРеглПроверка);
	СобытияФорм.ПриСозданииНаСервере(ЭтотОбъект, Отказ, СтандартнаяОбработка, ДополнительныеПараметры);
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ИспользуемыеТипыДокументов = Новый Массив;
	Для каждого ОписаниеОперации Из ХозяйственныеОперацииИДокументы Цикл
		ИспользуемыеТипыДокументов.Добавить(Тип("ДокументСсылка." + СтрРазделить(ОписаниеОперации.ПолноеИмяДокумента, ".")[1]));
	КонецЦикла;

	ПараметрыРазмещения = ПодключаемыеКоманды.ПараметрыРазмещения();
	ПараметрыРазмещения.Источники = Новый ОписаниеТипов(ИспользуемыеТипыДокументов);
	ПараметрыРазмещения.КоманднаяПанель = Элементы.СписокДокументыКоманднаяПанель;
	ПараметрыРазмещения.ПрефиксГрупп = "СписокДокументы";
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект, ПараметрыРазмещения);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	#КонецОбласти
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	НачатьОбновлениеСписка(0);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "ЗаписьДокументаВЖурналОС" Тогда
		ОбновитьДанныеКогдаФормаСтанетАктивной();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ОтборПериодПриИзменении(Элемент)

	Если ОтборПериод.ДатаНачала = '00010101' Тогда
		Если ОтборПериод.ДатаОкончания = '00010101' Тогда
			ОтборПериод.Вариант = ВариантСтандартногоПериода.ЭтотМесяц;
		Иначе
			ОтборПериод.ДатаНачала = НачалоМесяца(ОтборПериод.ДатаОкончания);
		КонецЕсли;
	КонецЕсли;

	НачатьОбновлениеСписка();
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборПодразделениеПриИзменении(Элемент)

	НачатьОбновлениеСписка();
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборОрганизацияПриИзменении(Элемент)
	
	НачатьОбновлениеСписка();
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборОсновноеСредствоПриИзменении(Элемент)
	
	НачатьОбновлениеСписка();
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборСкрытьУчтенныеЗатратыПриИзменении(Элемент)
	
	УстановитьОтборыСтрок(ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура ОтборТолькоОтклоненияПриИзменении(Элемент)
	
	УстановитьОтборыСтрок(ЭтотОбъект);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСписок

&НаКлиенте
Процедура СписокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.Список.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Поле = Элементы.СписокОсновноеСредство
		ИЛИ Поле = Элементы.СписокИнвентарныйНомер
		ИЛИ Поле = Элементы.СписокКод Тогда
		
		СтандартнаяОбработка = Ложь;
		ПоказатьЗначение(, ТекущиеДанные.ОсновноеСредство);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СписокПриАктивизацииСтроки(Элемент)

	СписокОС = Новый Соответствие();
	
	Для Каждого Элемент Из Элементы.Список.ВыделенныеСтроки Цикл
		
		ДанныеСтроки = Список.НайтиПоИдентификатору(Элемент);
		
		СписокОрганизаций = СписокОС.Получить(ДанныеСтроки.ОсновноеСредство);
		Если СписокОрганизаций = Неопределено Тогда
			СписокОрганизаций = Новый Соответствие();
		КонецЕсли;
		
		СписокОрганизаций.Вставить(ДанныеСтроки.Организация, ДанныеСтроки.Организация);
		СписокОС.Вставить(ДанныеСтроки.ОсновноеСредство, СписокОрганизаций);
		
	КонецЦикла;
	
	Для Каждого ДанныеСтроки Из СписокЗатрат Цикл
		
		СписокОрганизаций = СписокОС.Получить(ДанныеСтроки.ОсновноеСредство);
		Если СписокОрганизаций <> Неопределено
			И СписокОрганизаций.Получить(ДанныеСтроки.Организация) <> Неопределено Тогда
			
			ДанныеСтроки.ПоказатьВСписке = Истина;
		Иначе
			ДанныеСтроки.ПоказатьВСписке = Ложь;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСписокЗатрат

&НаКлиенте
Процедура СписокЗатратВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекущиеДанные = Элементы.СписокЗатрат.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПоказатьЗначение(, ТекущиеДанные.Документ);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСписокДокументы

&НаКлиенте
Процедура СписокДокументыПриАктивизацииСтроки(Элемент)
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
КонецПроцедуры

&НаКлиенте
Процедура СписокДокументыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ОбщегоНазначенияУТКлиент.ИзменитьЭлемент(Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура СписокДокументыПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	Отказ = Истина;
	Если Элементы.СписокДокументыГруппаСоздатьГенерируемая.ПодчиненныеЭлементы.Количество() <> 0 Тогда 
		Если Копирование Тогда
			ОбщегоНазначенияУТКлиент.СкопироватьЭлемент(Элемент);
		ИначеЕсли ОтборТипыДокументов.Количество() = 1 И ОтборХозяйственныеОперации.Количество() = 1 Тогда 
			СтруктураКоманды = Новый Структура("Имя", Элементы.СписокДокументыГруппаСоздатьГенерируемая.ПодчиненныеЭлементы[0].Имя);
			Подключаемый_СоздатьДокумент(СтруктураКоманды);
		Иначе
			Подключаемый_СоздатьДокументЧерезФормуВыбора(Неопределено);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СписокДокументыПередНачаломИзменения(Элемент, Отказ)
	
	Отказ = Истина;
	ОбщегоНазначенияУТКлиент.ИзменитьЭлемент(Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура СписокДокументыПередУдалением(Элемент, Отказ)
	
	Отказ = Истина;
	
	ОбработчикЗавершения = Новый ОписаниеОповещения("УстановитьСнятьПометкуУдаленияЗавершение", ЭтотОбъект);

	ОбщегоНазначенияУТКлиент.УстановитьПометкуУдаления(Элемент, Заголовок, ОбработчикЗавершения);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОформитьПринятиеКУчету(Команда)
	
	ПараметрыВыбранныхСтрок = ПараметрыВыбранныхСтрокСписка(Список, Элементы.Список.ВыделенныеСтроки);

	Если НЕ ПроверитьПараметрыВыбранныхСтрокСписка(ПараметрыВыбранныхСтрок)Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеОснования = Новый Структура;
	ДанныеОснования.Вставить("Дата", ОбщегоНазначенияКлиент.ДатаСеанса());
	ДанныеОснования.Вставить("Организация", ПараметрыВыбранныхСтрок.ТекущаяОрганизация);
	
	ДобавитьОтражениеВУчетеДляОформленияДокумента(ПараметрыВыбранныхСтрок, ДанныеОснования);
	
	Если ПараметрыВыбранныхСтрок.ЕстьОбъектыСтроительства Тогда
		
		ДанныеОснования.Вставить("ОбъектСтроительства", ПараметрыВыбранныхСтрок.СписокОС[0]);
		
	Иначе
		
		Если ПараметрыВыбранныхСтрок.СписокОС.Количество() = 1 Тогда
			ДанныеОснования.Вставить("ОсновноеСредство", ПараметрыВыбранныхСтрок.СписокОС[0]);
		Иначе
			ДанныеОснования.Вставить("ОсновноеСредство", ПараметрыВыбранныхСтрок.СписокОС);
		КонецЕсли;
		
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура("Основание", ДанныеОснования);
	
	Если ПараметрыВыбранныхСтрок.ЕстьУзлыКомпоненты Тогда
		ОткрытьФорму("Документ.ПринятиеКУчетуУзловКомпонентовАмортизации.ФормаОбъекта", ПараметрыФормы);
	Иначе
		ОткрытьФорму("Документ.ПринятиеКУчетуОС2_4.ФормаОбъекта", ПараметрыФормы);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОформитьМодернизацию(Команда)
	
	ПараметрыВыбранныхСтрок = ПараметрыВыбранныхСтрокСписка(Список, Элементы.Список.ВыделенныеСтроки);
	
	Если НЕ ПроверитьПараметрыВыбранныхСтрокСписка(ПараметрыВыбранныхСтрок)Тогда
		Возврат;
	КонецЕсли;
	
	Если ПараметрыВыбранныхСтрок.ЕстьУзлыКомпоненты Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Не поддерживается оформление модернизации для узлов (компонент амортизации).
									  |Необходимо выбрать основные средства.';
									  |en = 'Cannot register appreciation for sub-assets (depreciation component).
									  |Select fixed assets.'"));
		Возврат;
	КонецЕсли;
	
	ДанныеОснования = Новый Структура;
	ДанныеОснования.Вставить("Дата", ОбщегоНазначенияКлиент.ДатаСеанса());
	ДанныеОснования.Вставить("Организация", ПараметрыВыбранныхСтрок.ТекущаяОрганизация);
	ДанныеОснования.Вставить("ХозяйственнаяОперация", ПредопределенноеЗначение("Перечисление.ХозяйственныеОперации.МодернизацияОС"));

	ДобавитьОтражениеВУчетеДляОформленияДокумента(ПараметрыВыбранныхСтрок, ДанныеОснования);

	Если ПараметрыВыбранныхСтрок.ЕстьОбъектыСтроительства Тогда
		
		ДанныеОснования.Вставить("ОбъектСтроительства", ПараметрыВыбранныхСтрок.СписокОС[0]);
		
	Иначе
		
		Если ПараметрыВыбранныхСтрок.СписокОС.Количество() = 1 Тогда
			ДанныеОснования.Вставить("ОсновноеСредство", ПараметрыВыбранныхСтрок.СписокОС[0]);
		Иначе
			ДанныеОснования.Вставить("ОсновноеСредство", ПараметрыВыбранныхСтрок.СписокОС);
		КонецЕсли;
		
	КонецЕсли;

	ПараметрыФормы = Новый Структура("Основание", ДанныеОснования);
	
	ОткрытьФорму("Документ.МодернизацияОС2_4.ФормаОбъекта", ПараметрыФормы);
	
КонецПроцедуры

&НаКлиенте
Процедура ОформитьВключениеРасходовВСтоимость(Команда)
	
	ПараметрыВыбранныхСтрок = ПараметрыВыбранныхСтрокСписка(Список, Элементы.Список.ВыделенныеСтроки);
	
	Если НЕ ПроверитьПараметрыВыбранныхСтрокСписка(ПараметрыВыбранныхСтрок)Тогда
		Возврат;
	КонецЕсли;

	ДанныеОснования = Новый Структура;
	ДанныеОснования.Вставить("Дата", ОбщегоНазначенияКлиент.ДатаСеанса());
	ДанныеОснования.Вставить("Организация", ПараметрыВыбранныхСтрок.ТекущаяОрганизация);
	ДанныеОснования.Вставить("ХозяйственнаяОперация", ПредопределенноеЗначение("Перечисление.ХозяйственныеОперации.ВключениеРасходовВСтоимостьОС"));

	ДобавитьОтражениеВУчетеДляОформленияДокумента(ПараметрыВыбранныхСтрок, ДанныеОснования);

	Если ПараметрыВыбранныхСтрок.ЕстьОбъектыСтроительства Тогда
		
		ДанныеОснования.Вставить("ОбъектСтроительства", ПараметрыВыбранныхСтрок.СписокОС[0]);
		
	Иначе
		
		Если ПараметрыВыбранныхСтрок.СписокОС.Количество() = 1 Тогда
			ДанныеОснования.Вставить("ОсновноеСредство", ПараметрыВыбранныхСтрок.СписокОС[0]);
		Иначе
			ДанныеОснования.Вставить("ОсновноеСредство", ПараметрыВыбранныхСтрок.СписокОС);
		КонецЕсли;
		
	КонецЕсли;

