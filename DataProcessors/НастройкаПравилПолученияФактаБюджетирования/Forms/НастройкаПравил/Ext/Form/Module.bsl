Процедура СкрытьПравилаОтключеннойНастройки(Команда)
	
	СкрытьПравилаОтключеннойНастройкиНаСервере();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура СкрытьПравилаОтключеннойНастройкиНаСервере()
	
	ПравилаОтключеннойНастройкиСкрыты = НЕ ПравилаОтключеннойНастройкиСкрыты;
	
	Если ТипЗнч(ОбъектНастройки) = Тип("СправочникСсылка.СтатьиБюджетов") Тогда
		ОбщегоНазначения.ХранилищеНастроекДанныхФормСохранить(
			"Справочник.ПравилаПолученияФактаПоСтатьямБюджетов.ФормаСписка",
			"ПравилаОтключеннойНастройкиСкрыты",
			ПравилаОтключеннойНастройкиСкрыты);
	ИначеЕсли ТипЗнч(ОбъектНастройки) = Тип("СправочникСсылка.ПоказателиБюджетов") Тогда
		ОбщегоНазначения.ХранилищеНастроекДанныхФормСохранить(
			"Справочник.ПравилаПолученияФактаПоПоказателямБюджетов.ФормаСписка",
			"ПравилаОтключеннойНастройкиСкрыты",
			ПравилаОтключеннойНастройкиСкрыты);
	КонецЕсли;
	
	УправлениеФормой(ЭтотОбъект);
	
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(
		ПравилаПолученияФактаПоСтатьямБюджетов,
		"ПравилаОтключеннойНастройкиСкрыты",
		ПравилаОтключеннойНастройкиСкрыты);
	
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(
		ПравилаПолученияФактаПоПоказателямБюджетов,
		"ПравилаОтключеннойНастройкиСкрыты",
		ПравилаОтключеннойНастройкиСкрыты);
	
КонецПроцедуры

