#Область НастройкаСписков

&НаСервере
Процедура УправлениеПараметрамиСписков()
	
	ПараметрыЗапроса = ПараметрыЗапроса();
	НаборОбновить(ПараметрыЗапроса);
	
КонецПроцедуры

&НаСервере
Функция ПараметрыЗапроса()
	
	ОтборСостояний = Новый Массив();
	
	Ожидается = Ложь;
	ОжидаетсяНеВСрок = Ложь;
	ОбеспеченКДатеДобавлен = Ложь;
	Для Каждого Элемент Из ОтобранныеСостояния Цикл
		
		Если Не Элемент.Пометка Тогда
			Продолжить;
		КонецЕсли;
		
		Если Элемент.Значение = Перечисления.РаспределениеЗапасовСостояния.ОбеспеченКДате Тогда
			
			Ожидается = Ожидается Или Элемент.Представление = НСтр("ru = 'Ожидается';
																	|en = 'Expected'");
			ОжидаетсяНеВСрок = ОжидаетсяНеВСрок Или Элемент.Представление = НСтр("ru = 'Ожидается не в срок';
																				|en = 'Expected out-of-time'");
			
			Если ОбеспеченКДатеДобавлен Тогда
				Продолжить;
			КонецЕсли;
			ОбеспеченКДатеДобавлен = Истина;
			ОтборСостояний.Добавить(Перечисления.РаспределениеЗапасовСостояния.ОжидаетсяПоНеподтвержденномуЗаказу);
			
		КонецЕсли;
		ОтборСостояний.Добавить(Элемент.Значение);
		
	КонецЦикла;
	
	ПараметрыЗапроса = Новый Структура();
	ПараметрыЗапроса.Вставить("ОтборСостояний", ОтборСостояний);
	ПараметрыЗапроса.Вставить("Ожидается", Ожидается);
	ПараметрыЗапроса.Вставить("ОжидаетсяНеВСрок", ОжидаетсяНеВСрок);
	ПараметрыЗапроса.Вставить("НадписьЗаказ", НСтр("ru = 'Заказ';
													|en = 'Order'"));
	ПараметрыЗапроса.Вставить("НачалоЭтогоДня", НачалоДня(ТекущаяДатаСеанса()));
	ПараметрыЗапроса.Вставить("НадписьТекущийЗаказ", НСтр("ru = 'Текущий заказ';
															|en = 'Current order'"));
	ПараметрыЗапроса.Вставить("ЗаказыНаОтгрузку", Параметры.Заказы);
	
	Возврат ПараметрыЗапроса;
	
КонецФункции

&НаКлиенте
Процедура Подключаемый_СписокПриАктивизацииСтроки()
	
	ТекущиеДанные = Элементы.Набор.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда
		
		Результат = СписокПриАктивизацииСтрокиНаСервере(
			ТекущиеДанные.Номенклатура,
			ТекущиеДанные.Характеристика,
			ТекущиеДанные.Склад,
			ТекущиеДанные.Назначение,
			ТекущиеДанные.ЕдиницаИзмерения);
			
		ЗаполнитьЗначенияСвойств(ЭтаФорма, Результат);
		Элементы.НадписьТовар.Заголовок = Результат.НадписьТовар;
		ЭтоРабота = ТекущиеДанные.ТипНоменклатуры = ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Работа");
		Элементы.ИтогВНаличии.Заголовок = ?(ЭтоРабота, НСтр("ru = 'В подразделении';
															|en = 'In busIness unit'"), НСтр("ru = 'На складе';
																							|en = 'In warehouse'"));
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция СписокПриАктивизацииСтрокиНаСервере(Номенклатура, Характеристика, Склад, Назначение, ЕдиницаИзмерения)
	
	ТекстыЗапросов = Новый Массив();
	ТекстыЗапросов.Добавить(
		"ВЫБРАТЬ
		|	Таблица.Наименование КАК Наименование
		|ИЗ
		|	Справочник.Номенклатура КАК Таблица
		|ГДЕ
		|	Таблица.Ссылка = &Номенклатура");
	ТекстыЗапросов.Добавить(
		"ВЫБРАТЬ
		|	Таблица.Наименование КАК Наименование
		|ИЗ
		|	Справочник.ХарактеристикиНоменклатуры КАК Таблица
		|ГДЕ
		|	Таблица.Ссылка = &Характеристика");
	ТекстыЗапросов.Добавить(
		"ВЫБРАТЬ
		|	Таблица.Наименование КАК Наименование
		|ИЗ
		|	Справочник.Склады КАК Таблица
		|ГДЕ
		|	Таблица.Ссылка = &Склад");
	ТекстыЗапросов.Добавить(
		"ВЫБРАТЬ
		|	Таблица.Наименование КАК Наименование
		|ИЗ
		|	Справочник.УпаковкиЕдиницыИзмерения КАК Таблица
		|ГДЕ
		|	Таблица.Ссылка = &ЕдиницаИзмерения");
	ТекстЗапроса =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Запасы.Номенклатура КАК Номенклатура,
		|	Запасы.Характеристика КАК Характеристика,
		|	Запасы.Склад КАК Склад,
		|	Запасы.Назначение КАК Назначение,
		|	Запасы.Заказ КАК Заказ,
		|	Запасы.ЗаблокированоВНаличииОстаток КАК ЗаблокированоВНаличииОстаток,
		|	Запасы.ЗаблокированоПоступитОстаток КАК ЗаблокированоПоступитОстаток,
		|	Запасы.КРазблокировкеОстаток КАК КРазблокировкеОстаток,
		|	Запасы.РезервироватьНаСкладеИзЗаблокированныхОстаток КАК РезервироватьНаСкладеИзЗаблокированныхОстаток,
		|	Запасы.РезервироватьПоМереПоступленияИзЗаблокированныхОстаток КАК РезервироватьПоМереПоступленияИзЗаблокированныхОстаток
		|ПОМЕСТИТЬ ЗапасыИПотребностиОстаткиКонтролируемыхПартий
		|ИЗ
		|	РегистрНакопления.ЗапасыИПотребности.Остатки(,
		|		Номенклатура = &Номенклатура
		|		И Характеристика = &Характеристика
		|		И Склад = &Склад) КАК Запасы
		|ИНДЕКСИРОВАТЬ ПО
		|	Номенклатура, Характеристика, Склад, Назначение
		|;
		|
		|/////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Запасы.Номенклатура КАК Номенклатура,
		|	Запасы.Характеристика КАК Характеристика,
		|	Запасы.Склад КАК Склад,
		|	Запасы.Назначение КАК Назначение,
		|	Запасы.ВНаличииОстаток КАК ВНаличииОстаток,
		|	Запасы.ЗаблокированоВНаличииОстаток КАК ЗаблокированоВНаличииОстаток,
		|	Запасы.ЗаказаноОстаток КАК ЗаказаноОстаток,
		|	Запасы.ПоступитОстаток КАК ПоступитОстаток,
		|	Запасы.ЗаблокированоПоступитОстаток КАК ЗаблокированоПоступитОстаток,
		|	Запасы.РезервироватьНаСкладеОстаток КАК РезервироватьНаСкладеОстаток,
		|	Запасы.РезервироватьПоМереПоступленияОстаток КАК РезервироватьПоМереПоступленияОстаток,
		|	Запасы.ОтложитьРезервированиеОстаток КАК ОтложитьРезервированиеОстаток,
		|	Запасы.КОбеспечениюОстаток КАК КОбеспечениюОстаток,
		|	Запасы.НеОбеспечиватьОстаток КАК НеОбеспечиватьОстаток
		|ПОМЕСТИТЬ ЗапасыИПотребностиОстатки
		|ИЗ
		|	РегистрНакопления.ЗапасыИПотребности.Остатки(,
		|		Номенклатура = &Номенклатура
		|		И Характеристика = &Характеристика
		|		И Склад = &Склад) КАК Запасы
		|ИНДЕКСИРОВАТЬ ПО
		|	Номенклатура, Характеристика, Склад, Назначение
		|;
		|
		|/////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Расчет.Номенклатура КАК Номенклатура,
		|	Расчет.Характеристика КАК Характеристика,
		|	Расчет.Склад КАК Склад,
		|	СУММА(
		|		ВЫБОР
		|			КОГДА Расчет.Назначение В (ЗНАЧЕНИЕ(Справочник.Назначения.ПустаяСсылка), &Назначение)
		|				ТОГДА Расчет.КоличествоДляДействияОтгрузить
		|			ИНАЧЕ 0
		|		КОНЕЦ) КАК ДоступноСейчас,
		|	СУММА(
		|		ВЫБОР
		|			КОГДА Расчет.Назначение В (ЗНАЧЕНИЕ(Справочник.Назначения.ПустаяСсылка), &Назначение)
		|				ТОГДА Расчет.КоличествоДляДействияРезервироватьПоМереПоступления
		|			ИНАЧЕ 0
		|		КОНЕЦ) КАК ДоступноВсего,
		|	СУММА(Расчет.КоличествоВНаличии) КАК ВНаличии,
		|	СУММА(Расчет.КоличествоВНаличииИОжидается) КАК Поступит
		|ИЗ
		|	РасчетОстатковДляУстановкиДействий КАК Расчет
		|СГРУППИРОВАТЬ ПО
		|	Расчет.Номенклатура,
		|	Расчет.Характеристика,
		|	Расчет.Склад";
	
	ИменаТаблиц = ОбеспечениеВДокументахСервер.НовыеИменаТаблицДляРасчетаОстатковДляУстановкиДействий();
	ИменаТаблиц.Остатки = "ЗапасыИПотребностиОстатки"; // @query-part-1
	ИменаТаблиц.ОстаткиКонтролируемыхПартий = "ЗапасыИПотребностиОстаткиКонтролируемыхПартий"; // @query-part-1
	ИменаТаблиц.Результат = "РасчетОстатковДляУстановкиДействий"; // @query-part-1
	ОбеспечениеВДокументахСервер.РасчетОстатковДляУстановкиДействий(ТекстЗапроса, ИменаТаблиц, Истина, Ложь);
	
	ТекстыЗапросов.Добавить(ТекстЗапроса);
	
	Запрос = Новый Запрос();
	Запрос.Текст = СтрСоединить(ТекстыЗапросов, ОбщегоНазначения.РазделительПакетаЗапросов());
	Запрос.УстановитьПараметр("Номенклатура",     Номенклатура);
	Запрос.УстановитьПараметр("Характеристика",   Характеристика);
	Запрос.УстановитьПараметр("Склад",            Склад);
	Запрос.УстановитьПараметр("Назначение",       Назначение);
	Запрос.УстановитьПараметр("ЕдиницаИзмерения", ЕдиницаИзмерения);
	
	РезультатВыполнения = Запрос.ВыполнитьПакет();
	
	ЭлементыНадписи = Новый Массив();
	Выборка = РезультатВыполнения[0].Выбрать();
	Если Выборка.Следующий() Тогда
		ЭлементыНадписи.Добавить(Выборка.Наименование);
	КонецЕсли;
	Выборка = РезультатВыполнения[1].Выбрать();
	Если Выборка.Следующий() Тогда
		ЭлементыНадписи.Добавить(Выборка.Наименование);
	КонецЕсли;
	Выборка = РезультатВыполнения[2].Выбрать();
	Если Выборка.Следующий() Тогда
		ЭлементыНадписи.Добавить(Выборка.Наименование);
	КонецЕсли;
	
	Результат = Новый Структура();
	Результат.Вставить("НадписьТовар", СтрСоединить(ЭлементыНадписи, ", "));
	Результат.Вставить("ИтогВНаличии",         0);
	Результат.Вставить("ИтогПоступит",         0);
	Результат.Вставить("ИтогДоступноСейчас",   0);
	Результат.Вставить("ИтогДоступноВсего",    0);
	Результат.Вставить("ИтогВРезервеНаСкладе", 0);
	Результат.Вставить("ИтогВРезервеВсего",    0);
	Результат.Вставить("ЕдиницаИзмерения",     "");
	
	Выборка = РезультатВыполнения[3].Выбрать();
	Если Выборка.Следующий() Тогда
		Результат.Вставить("ЕдиницаИзмерения", Выборка.Наименование);
	КонецЕсли;
	
	Выборка = РезультатВыполнения[РезультатВыполнения.ВГраница()].Выбрать();
	Если Выборка.Следующий() Тогда
		
		Результат.ИтогВНаличии         = Выборка.ВНаличии;
		Результат.ИтогПоступит         = Выборка.Поступит;
		Результат.ИтогДоступноСейчас   = Выборка.ДоступноСейчас;
		Результат.ИтогДоступноВсего    = Выборка.ДоступноВсего;
		Результат.ИтогДоступноСейчас   = Макс(Результат.ИтогДоступноСейчас, 0);
		Результат.ИтогДоступноВсего    = Макс(Результат.ИтогДоступноВсего, 0);
		Результат.ИтогВРезервеНаСкладе = Выборка.ВНаличии - Выборка.ДоступноСейчас;
		Результат.ИтогВРезервеВсего    = Выборка.Поступит - Выборка.ДоступноВсего;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура СписокВыборНаКлиенте(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	Данные = Неопределено;
	
	Если СтрНайти(Поле.Имя, "ЗаказНаОтгрузку") > 0 Тогда
		
		Данные = Элемент.ТекущиеДанные.ЗаказНаОтгрузку;
		
	ИначеЕсли СтрНайти(Поле.Имя, "ЗаказНаПоступление") > 0 Тогда
		
		Данные = Элемент.ТекущиеДанные.ЗаказНаПоступление;
		Если Не ЗначениеЗаполнено(Данные) Тогда
			Данные = Элемент.ТекущиеДанные.СпособОбеспечения;
		ИначеЕсли ЗначениеЗаполнено(Данные) И ТипЗнч(Данные) = Тип("СправочникСсылка.КонтролируемыеПартии") Тогда
			Данные = РеквизитПартия(Данные);
		КонецЕсли;
		
	ИначеЕсли СтрНайти(Поле.Имя, "СпособОбеспеченияНаименование") > 0 Тогда
		
		Данные = Элемент.ТекущиеДанные.СпособОбеспечения;
		Если Не ЗначениеЗаполнено(Данные) Тогда
			Данные = Элемент.ТекущиеДанные.ЗаказНаПоступление;
		КонецЕсли;
		
	ИначеЕсли СтрНайти(Поле.Имя, "Номенклатура") > 0 Тогда
		
		Данные = Элемент.ТекущиеДанные.Номенклатура;
		
	ИначеЕсли СтрНайти(Поле.Имя, "Характеристика") > 0 Тогда
		
		Данные = Элемент.ТекущиеДанные.Характеристика;
		
	ИначеЕсли СтрНайти(Поле.Имя, "Склад") > 0 Тогда
		
		Данные = Элемент.ТекущиеДанные.Склад;
		
	ИначеЕсли СтрНайти(Поле.Имя, "Назначение") > 0 Тогда
		
		Данные = Элемент.ТекущиеДанные.ЗаказНазначения;
		Если Не ЗначениеЗаполнено(Данные) Тогда
			Данные = Элемент.ТекущиеДанные.Назначение;
		КонецЕсли;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Данные) Тогда
		ПоказатьЗначение(, Данные);
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция РеквизитПартия(Данные)
	
	УстановитьПривилегированныйРежим(Истина);
	Партия = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Данные, "Партия");
	УстановитьПривилегированныйРежим(Ложь);
	Возврат Партия;
	
КонецФункции

&НаСервере
Функция ТекстЗапроса()
	
	Тексты = Новый Массив();
	ТекстЗапроса = ТекстВременнойТаблицыОтборСостояний();
	Тексты.Добавить(ТекстЗапроса);
	ТекстЗапроса = ОбеспечениеВДокументахСервер.ВременнаяТаблицаГодыГрафикаПредприятия();
	Тексты.Добавить(ТекстЗапроса);
	ТекстЗапроса =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ОтборСостояний.Состояние КАК Состояние,
		|	СостояниеЗаказа.Номенклатура КАК Номенклатура,
		|	СостояниеЗаказа.Характеристика КАК Характеристика,
		|	СостояниеЗаказа.Склад КАК Склад,
		|	СостояниеЗаказа.Назначение КАК Назначение,
		|	СостояниеЗаказа.ХарактеристикаПотребности КАК ХарактеристикаПотребности,
		|	СостояниеЗаказа.СостояниеЗапаса КАК СостояниеЗапаса,
		|	СостояниеЗаказа.ЖелаемаяДатаОтгрузки КАК ЖелаемаяДатаОтгрузки,
		|	СостояниеЗаказа.ЗаказНаПоступление КАК ЗаказНаПоступление,
		|	СостояниеЗаказа.Количество КАК Количество,
		|	СостояниеЗаказа.ЗаказНаОтгрузку КАК ЗаказНаОтгрузку,
		|	РеестрДокументов.Партнер КАК Клиент,
		|	РеестрДокументов.Ответственный КАК Менеджер,
		|	
		|	ВЫБОР КОГДА ОтборСостояний.Состояние = ЗНАЧЕНИЕ(Перечисление.РаспределениеЗапасовСостояния.ВРезерве) ТОГДА
		|				1
		|			КОГДА ОтборСостояний.Состояние = ЗНАЧЕНИЕ(Перечисление.РаспределениеЗапасовСостояния.ОбеспеченНаСкладе) ТОГДА
		|				2
		|			КОГДА ОтборСостояний.Состояние = ЗНАЧЕНИЕ(Перечисление.РаспределениеЗапасовСостояния.ОбеспеченКДате) ТОГДА
		|				3
		|			КОГДА ОтборСостояний.Состояние = ЗНАЧЕНИЕ(Перечисление.РаспределениеЗапасовСостояния.ОжидаетсяПоНеподтвержденномуЗаказу) ТОГДА
		|				4
		|			КОГДА ОтборСостояний.Состояние = ЗНАЧЕНИЕ(Перечисление.РаспределениеЗапасовСостояния.Обеспечить) ТОГДА
		|				5
		|			КОГДА ОтборСостояний.Состояние = ЗНАЧЕНИЕ(Перечисление.РаспределениеЗапасовСостояния.НеОбеспечивать) ТОГДА
		|				6
		|		КОНЕЦ КАК Порядок,
		|		
		// Производные поля.
		|	СостояниеЗаказа.Номенклатура.КонтролироватьКачествоПоступившегоТовара
		|		И ВЫРАЗИТЬ(СостояниеЗаказа.Склад КАК Справочник.Склады).КонтролироватьКачествоПоступившегоТовара КАК КонтролироватьКачествоПоступившегоТовара,
		|	СостояниеЗаказа.Номенклатура.ТипНоменклатуры КАК ТипНоменклатуры,
		|	СостояниеЗаказа.Номенклатура.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
		|	СостояниеЗаказа.Назначение.Заказ КАК ЗаказНазначения,
		|	СостояниеЗаказа.Назначение <> ЗНАЧЕНИЕ(Справочник.Назначения.ПустаяСсылка) КАК Обособленно,
		|	
		// Поле Действие.
		|	ВЫБОР
		|		КОГДА СостояниеЗаказа.ХарактеристикаПотребности В(
		|				ЗНАЧЕНИЕ(Перечисление.ХарактеристикиПотребности.РезервироватьНаСкладе),
		|				ЗНАЧЕНИЕ(Перечисление.ХарактеристикиПотребности.РезервироватьНаСкладеИзЗаблокированных))
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВариантыОбеспечения.СоСклада)
		|		КОГДА СостояниеЗаказа.ХарактеристикаПотребности В(
		|				ЗНАЧЕНИЕ(Перечисление.ХарактеристикиПотребности.РезервироватьПоМереПоступления),
		|				ЗНАЧЕНИЕ(Перечисление.ХарактеристикиПотребности.ОтложитьРезервирование),
		|				ЗНАЧЕНИЕ(Перечисление.ХарактеристикиПотребности.РезервироватьПоМереПоступленияИзЗаблокированных))
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВариантыОбеспечения.РезервироватьПоМереПоступления)
		|		КОГДА СостояниеЗаказа.ХарактеристикаПотребности = ЗНАЧЕНИЕ(Перечисление.ХарактеристикиПотребности.КОбеспечению)
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВариантыОбеспечения.КОбеспечению)
		|		КОГДА СостояниеЗаказа.ХарактеристикаПотребности = ЗНАЧЕНИЕ(Перечисление.ХарактеристикиПотребности.НеОбеспечивать)
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВариантыОбеспечения.НеТребуется)
		|	КОНЕЦ КАК Действие,
		|	
		// Поле ДатаПоступления.
		|	ВЫБОР
		|		КОГДА СостояниеЗаказа.СостояниеЗапаса В(
		|				ЗНАЧЕНИЕ(Перечисление.СостоянияЗапаса.НеОбеспечен),
		|				ЗНАЧЕНИЕ(Перечисление.СостоянияЗапаса.НаСогласованииПоставки))
		|				И НЕ СостояниеЗаказа.ХарактеристикаПотребности = ЗНАЧЕНИЕ(Перечисление.ХарактеристикиПотребности.НеОбеспечивать)
		|			ТОГДА
		|				ВЫБОР
		|					КОГДА РасчетСпособаОбеспеченияПереопределяемый.Ссылка = ЗНАЧЕНИЕ(Справочник.СпособыОбеспеченияПотребностей.ПустаяСсылка)
		|						ТОГДА ДАТАВРЕМЯ(1,1,1)
		|					ИНАЧЕ РасчетДатыПоставкиПереопределяемый.ПлановаяДатаПоставки
		|				КОНЕЦ
		|		ИНАЧЕ СостояниеЗаказа.ДатаПоступления
		|	КОНЕЦ КАК ДатаПоступления,
		|	
		// Поле КонтрольКачества.
		|	ВЫБОР
		|		КОГДА СостояниеЗаказа.СостояниеЗапаса В(
		|				ЗНАЧЕНИЕ(Перечисление.СостоянияЗапаса.НеОбеспечен),
		|				ЗНАЧЕНИЕ(Перечисление.СостоянияЗапаса.НаСогласованииПоставки))
		|				И НЕ СостояниеЗаказа.ХарактеристикаПотребности = ЗНАЧЕНИЕ(Перечисление.ХарактеристикиПотребности.НеОбеспечивать)
		|			ТОГДА
		|				ВЫБОР
		|					КОГДА РасчетСпособаОбеспеченияПереопределяемый.Ссылка = ЗНАЧЕНИЕ(Справочник.СпособыОбеспеченияПотребностей.ПустаяСсылка)
		|						ТОГДА ДАТАВРЕМЯ(1,1,1)
		|					ИНАЧЕ РасчетДатыПоставкиПереопределяемый.ПлановаяДатаПоставки
		|				КОНЕЦ
		|		ИНАЧЕ СостояниеЗаказа.ДатаДоступности
		|	КОНЕЦ КАК КонтрольКачества,
		|	
		// Поля Способа обеспечения.
		|	ЕСТЬNULL(ВЫРАЗИТЬ(&НадписьЗаказ КАК СТРОКА(5))
		|			+ "" / ""
		|			+ ВЫРАЗИТЬ(РасчетСпособаОбеспеченияПереопределяемый.Ссылка КАК Справочник.СпособыОбеспеченияПотребностей).Наименование,
		|		 """") КАК СпособОбеспеченияНаименование,
		|	ЕСТЬNULL(ВЫРАЗИТЬ(РасчетСпособаОбеспеченияПереопределяемый.Ссылка КАК Справочник.СпособыОбеспеченияПотребностей),
		|		ЗНАЧЕНИЕ(Справочник.СпособыОбеспеченияПотребностей.ПустаяСсылка)) КАК СпособОбеспечения,
		|	
		// Поле ДатаОтгрузкиИсполнима.
		|	СостояниеЗаказа.ЖелаемаяДатаОтгрузки = ДАТАВРЕМЯ(1,1,1)
		|		ИЛИ ВЫБОР
		|				КОГДА СостояниеЗаказа.ЖелаемаяДатаОтгрузки < &НачалоТекущегоДня
		|					ТОГДА &НачалоТекущегоДня
		|				ИНАЧЕ СостояниеЗаказа.ЖелаемаяДатаОтгрузки
		|			КОНЕЦ
		|				>= ВЫБОР
		|						КОГДА СостояниеЗаказа.СостояниеЗапаса В(
		|								ЗНАЧЕНИЕ(Перечисление.СостоянияЗапаса.ОжидаетсяКПоступлению),
		|								ЗНАЧЕНИЕ(Перечисление.СостоянияЗапаса.ОжидаетсяКПоступлениюСБлокировкой),
		|								ЗНАЧЕНИЕ(Перечисление.СостоянияЗапаса.ОжидаетсяКПоступлениюНеПодлежитРазблокировке))
		|							ТОГДА
		|								ВЫБОР
		|									КОГДА ТИПЗНАЧЕНИЯ(СостояниеЗаказа.ЗаказНаОтгрузку) = ТИП(Справочник.КонтролируемыеПартии)
		|										ТОГДА
		|											ВЫБОР
		|												КОГДА СостояниеЗаказа.ДатаПоступления < &НачалоТекущегоДня
		|													ТОГДА &НачалоТекущегоДня
		|												ИНАЧЕ СостояниеЗаказа.ДатаПоступления
		|											КОНЕЦ
		|									ИНАЧЕ
		|										ВЫБОР
		|											КОГДА СостояниеЗаказа.ДатаДоступности < &НачалоТекущегоДня
		|												ТОГДА &НачалоТекущегоДня
		|											ИНАЧЕ СостояниеЗаказа.ДатаДоступности
		|										КОНЕЦ
		|								КОНЕЦ
		|						КОГДА СостояниеЗаказа.СостояниеЗапаса В(
		|								ЗНАЧЕНИЕ(Перечисление.СостоянияЗапаса.НеОбеспечен),
		|								ЗНАЧЕНИЕ(Перечисление.СостоянияЗапаса.НаСогласованииПоставки))
		|								И НЕ СостояниеЗаказа.ХарактеристикаПотребности = ЗНАЧЕНИЕ(Перечисление.ХарактеристикиПотребности.НеОбеспечивать)
		|							ТОГДА РасчетДатыПоставкиПереопределяемый.ПлановаяДатаПоставки
		|						ИНАЧЕ
		|							ДАТАВРЕМЯ(1,1,1)
		|					КОНЕЦ КАК ДатаОтгрузкиИсполнима,
		|	
		|	ОтборСостояний.Состояние В(&ОтборСостояний)
		|		И (НЕ СостояниеЗаказа.СостояниеЗапаса В(
		|			ЗНАЧЕНИЕ(Перечисление.СостоянияЗапаса.ОжидаетсяКПоступлению),
		|			ЗНАЧЕНИЕ(Перечисление.СостоянияЗапаса.ОжидаетсяКПоступлениюСБлокировкой),
		|			ЗНАЧЕНИЕ(Перечисление.СостоянияЗапаса.ОжидаетсяКПоступлениюНеПодлежитРазблокировке))
		|		ИЛИ &Ожидается
		|		ИЛИ &ОжидаетсяНеВСрок
		|			И СостояниеЗаказа.ЖелаемаяДатаОтгрузки <> ДАТАВРЕМЯ(1, 1, 1)
		|			И СостояниеЗаказа.ДатаПоступления <> ДАТАВРЕМЯ(1, 1, 1)
		|			И ВЫБОР
		|					КОГДА СостояниеЗаказа.ЖелаемаяДатаОтгрузки < &НачалоТекущегоДня
		|						ТОГДА &НачалоТекущегоДня
		|					ИНАЧЕ СостояниеЗаказа.ЖелаемаяДатаОтгрузки
		|				КОНЕЦ < СостояниеЗаказа.ДатаПоступления) КАК УдовлетворяетОтбору
		|ИЗ
		|	РегистрСведений.РаспределениеЗапасов КАК СостояниеЗаказа
		|		
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеестрДокументов КАК РеестрДокументов
		|		ПО РеестрДокументов.Ссылка = СостояниеЗаказа.ЗаказНаОтгрузку
		|		 И НЕ РеестрДокументов.ДополнительнаяЗапись
		|		
		|		ЛЕВОЕ СОЕДИНЕНИЕ РасчетСпособаОбеспеченияПереопределяемый ПО ИСТИНА
		|		
		|		ЛЕВОЕ СОЕДИНЕНИЕ РасчетДатыПоставкиПереопределяемый ПО ИСТИНА
		|		
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ОтборСостояний КАК ОтборСостояний
		|		ПО ОтборСостояний.СостояниеЗапаса = СостояниеЗаказа.СостояниеЗапаса
		|		 И ОтборСостояний.ХарактеристикаПотребности = СостояниеЗаказа.ХарактеристикаПотребности
		|		
		|	И (НЕ СостояниеЗаказа.СостояниеЗапаса В(
		|			ЗНАЧЕНИЕ(Перечисление.СостоянияЗапаса.ОжидаетсяКПоступлению),
		|			ЗНАЧЕНИЕ(Перечисление.СостоянияЗапаса.ОжидаетсяКПоступлениюСБлокировкой),
		|			ЗНАЧЕНИЕ(Перечисление.СостоянияЗапаса.ОжидаетсяКПоступлениюНеПодлежитРазблокировке))
		|		ИЛИ &Ожидается
		|		ИЛИ &ОжидаетсяНеВСрок
		|			И СостояниеЗаказа.ЖелаемаяДатаОтгрузки <> ДАТАВРЕМЯ(1, 1, 1)
		|			И СостояниеЗаказа.ДатаПоступления <> ДАТАВРЕМЯ(1, 1, 1)
		|			И ВЫБОР
		|					КОГДА СостояниеЗаказа.ЖелаемаяДатаОтгрузки < &НачалоТекущегоДня
		|						ТОГДА &НачалоТекущегоДня
		|					ИНАЧЕ СостояниеЗаказа.ЖелаемаяДатаОтгрузки
		|				КОНЕЦ < СостояниеЗаказа.ДатаПоступления)
		|ГДЕ
		|	СостояниеЗаказа.ЗаказНаОтгрузку В (&ЗаказыНаОТгрузку)";
	
	Подстановки = ОбеспечениеВДокументахСервер.ПодстановкиОсновногоСпособаОбеспечения(
		"СостояниеЗаказа.Номенклатура",
		"СостояниеЗаказа.Характеристика",
		"СостояниеЗаказа.Склад",
		"(СостояниеЗаказа.СостояниеЗапаса В(
		|	ЗНАЧЕНИЕ(Перечисление.СостоянияЗапаса.НеОбеспечен),
		|	ЗНАЧЕНИЕ(Перечисление.СостоянияЗапаса.НаСогласованииПоставки))
		|	И НЕ СостояниеЗаказа.ХарактеристикаПотребности = ЗНАЧЕНИЕ(Перечисление.ХарактеристикиПотребности.НеОбеспечивать))");
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "РасчетСпособаОбеспеченияПереопределяемый.Ссылка", Подстановки.Поле);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ЛЕВОЕ СОЕДИНЕНИЕ РасчетСпособаОбеспеченияПереопределяемый ПО ИСТИНА",
		Подстановки.Соединения);
	
	Подстановки = ОбеспечениеВДокументахСервер.ПодстановкиПлановойДатыПоставки(
		Подстановки.Поле,
		"&НачалоЭтогоДня",
		"СостояниеЗаказа.Номенклатура",
		"СостояниеЗаказа.Склад");
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "РасчетДатыПоставкиПереопределяемый.ПлановаяДатаПоставки", Подстановки.Поле);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ЛЕВОЕ СОЕДИНЕНИЕ РасчетДатыПоставкиПереопределяемый ПО ИСТИНА",
		Подстановки.Соединения);
	
	Тексты.Добавить(ТекстЗапроса);
	ТекстЗапроса = СтрСоединить(Тексты, ОбщегоНазначения.РазделительПакетаЗапросов());
	
	Возврат ТекстЗапроса;
	
КонецФункции

