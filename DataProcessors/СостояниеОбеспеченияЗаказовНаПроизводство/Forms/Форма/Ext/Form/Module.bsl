&НаСервере
Процедура УстановитьУсловноеОформлениеСписка(СписокУсловноеОформление, Префикс = "")
	
	ЗначенияНаСогласованииИлиНеОбеспечен = Новый СписокЗначений();
	ЗначенияНаСогласованииИлиНеОбеспечен.Добавить(Перечисления.СостоянияЗапаса.НаСогласованииПоставки);
	ЗначенияНаСогласованииИлиНеОбеспечен.Добавить(Перечисления.СостоянияЗапаса.НеОбеспечен);
	
	ЗначенияВНаличии = Новый СписокЗначений();
	ЗначенияВНаличии.Добавить(Перечисления.СостоянияЗапаса.ВНаличии);
	ЗначенияВНаличии.Добавить(Перечисления.СостоянияЗапаса.ВНаличииОжидаетсяРазблокировка);
	ЗначенияВНаличии.Добавить(Перечисления.СостоянияЗапаса.ВНаличииНеПодлежитРазблокировке);
	
	ЗначенияНеНаКонтроле = Новый СписокЗначений();
	ЗначенияНеНаКонтроле.Добавить(Перечисления.СостоянияЗапаса.ВНаличии);
	ЗначенияНеНаКонтроле.Добавить(Перечисления.СостоянияЗапаса.ОжидаетсяКПоступлению);
	ЗначенияНеНаКонтроле.Добавить(Перечисления.СостоянияЗапаса.НаСогласованииПоставки);
	ЗначенияНеНаКонтроле.Добавить(Перечисления.СостоянияЗапаса.НеОбеспечен);
	
	ПрефиксСТочкой = ?(Префикс = "", "", Префикс + ".");
	
	СписокУсловноеОформление.Элементы.Очистить();
	
	// Надпись "Не требуется" в поле "Контроль качества".
	#Область ЭлементОформления
	Элемент = СписокУсловноеОформление.Элементы.Добавить();
	Элемент.Представление = НСтр("ru = 'Надпись ""<не требуется>"" в поле ""Контроль качества""';
								|en = 'The ""<not defined>"" label in the ""Quality control"" field'");
	
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Префикс + "КонтрольКачества");
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ПрефиксСТочкой + "КонтролироватьКачествоПоступившегоТовара");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Ложь;
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ПрефиксСТочкой + "СостояниеЗапаса");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;
	ОтборЭлемента.ПравоеЗначение = ЗначенияНеНаКонтроле;
	
	Элемент.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru = '<не требуется>';
																|en = '<not required>'"));
	
	#КонецОбласти
	
	// Надпись "Пройден" в поле "Контроль качества".
	#Область ЭлементОформления
	Элемент = СписокУсловноеОформление.Элементы.Добавить();
	Элемент.Представление = НСтр("ru = 'Надпись ""Пройден"" в поле ""Контроль качества""';
								|en = 'The ""Passed"" label in the ""Quality control"" field'");
	
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Префикс + "КонтрольКачества");
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ПрефиксСТочкой + "КонтролироватьКачествоПоступившегоТовара");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Истина;
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ПрефиксСТочкой + "СостояниеЗапаса");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Перечисления.СостоянияЗапаса.ВНаличии;
	
	Элемент.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru = 'Пройден';
																|en = 'Passed'"));
	#КонецОбласти
	
	// Надпись "<не определена>" в поле "Дата поступления", если не установлен основной способ обеспечения, не заполнен календарь или не установлена дата следующей поставки по графику
	#Область ЭлементОформления
	Элемент = СписокУсловноеОформление.Элементы.Добавить();
	Элемент.Представление = НСтр("ru = 'Надпись ""<не определена>"" в поле ""Дата поступления"", если не установлен основной способ обеспечения, не заполнен календарь или не установлена дата следующей поставки по графику';
								|en = 'The ""<not defined>"" label in the ""Date of receipt"" field, if the main procurement strategy is not set, the calendar is not filled in or the date of the next scheduled delivery is not set'");
	
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Префикс + "ДатаПоступления");
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ПрефиксСТочкой + "СостояниеЗапаса");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;
	ОтборЭлемента.ПравоеЗначение = ЗначенияНаСогласованииИлиНеОбеспечен;
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ПрефиксСТочкой + "ХарактеристикаПотребности");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.НеРавно;
	ОтборЭлемента.ПравоеЗначение = Перечисления.ХарактеристикиПотребности.НеОбеспечивать;
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ПрефиксСТочкой + "ДатаПоступления");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено;
	
	ТекстНеОпределена = НСтр("ru = '<не определена>';
							|en = '<not defined>'");
