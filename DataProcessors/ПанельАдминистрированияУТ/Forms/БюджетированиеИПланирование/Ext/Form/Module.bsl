&НаКлиенте
Процедура РекомендуемаяНастройкаПравилПолученияФактаПриИзменении(Элемент)
	
	//++ НЕ УТ
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ОбработкаИзмененияВариантаНастройкиПравилПолученияФакта",
		ЭтотОбъект,
		Новый Структура("ЭлементФормы,ПутьКДанным",
			Элемент,
			"НастройкаПравилПолученияФактаПоСтатьямАктивовПассивов"));
	
	ТекстВопроса = НСтр("ru = 'Будет включено получение фактических данных оперативного учета по статьям активов и пассивов.
		|Продолжить?';
		|en = 'The acquisition of actual operational accounting data by asset and liability items will be enabled.
		|Continue?'");
	
	ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса,
		РежимДиалогаВопрос.ДаНет,,
		КодВозвратаДиалога.Да,
		НСтр("ru = 'Обработка правил получения фактических данных оперативного учета';
			|en = 'Process rules for obtaining actual operational accounting data'"));
	
	//-- НЕ УТ
	
	Возврат;
	
КонецПроцедуры

