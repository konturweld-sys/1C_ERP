#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	УстановитьУсловноеОформление();
	
	Если Не ЗначениеЗаполнено(Организация) Тогда
		Организация = ЗначениеНастроекПовтИсп.ПолучитьОрганизациюПоУмолчанию(Организация);
	КонецЕсли;
	
	ИнициализироватьРеквизиты();
	УстановитьОтборДинамическихСписков();
	НастроитьСсылкуСмТакже();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ИзменилисьПараметрыФормы = Истина;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура СтраницыОбработкиПриСменеСтраницы(Элемент, ТекущаяСтраница)
	
	Если ТекущаяСтраница = Элементы.СтраницаДокументыКОформлению Тогда 
		ОценкаПроизводительностиКлиент.ЗамерВремени("Обработка.ОформлениеДокументовПоМетодуНачисления.Форма.ОформлениеДокументов.СтраницаДокументыКОформлению");
	ИначеЕсли ТекущаяСтраница = Элементы.СтраницаДокументыКСторнированию Тогда 
		ОценкаПроизводительностиКлиент.ЗамерВремени("Обработка.ОформлениеДокументовПоМетодуНачисления.Форма.ОформлениеДокументов.СтраницаДокументыКСторнированию");
	КонецЕсли;
	
	Если ИзменилисьПараметрыФормы Тогда
		УстановитьОтборДинамическихСписков();
		
		ИзменилисьПараметрыФормы = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	
	ИзменилисьПараметрыФормы = Истина;
	
	УстановитьОтборДинамическихСписков();
	
КонецПроцедуры

&НаКлиенте
Процедура КонтрагентПриИзменении(Элемент)
	
	ИзменилисьПараметрыФормы = Истина;
	
	УстановитьОтборДинамическихСписков();
	
КонецПроцедуры

&НаКлиенте
Процедура ДоговорПриИзменении(Элемент)
	
	ИзменилисьПараметрыФормы = Истина;
	
	УстановитьОтборДинамическихСписков();
	
КонецПроцедуры

&НаКлиенте
Процедура ПодразделениеПриИзменении(Элемент)
	
	ИзменилисьПараметрыФормы = Истина;
	
	УстановитьОтборДинамическихСписков();
	
КонецПроцедуры

&НаКлиенте
Процедура ПредставлениеПериодаРегистрацииНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	
	ОбработчикЗакрытия = Новый ОписаниеОповещения("ПредставлениеПериодаРегистрацииНачалоВыбораЗавершение", ЭтотОбъект);
	ПараметрыФормы = Новый Структура("Значение, РежимВыбораПериода", ПериодРегистрации, "МЕСЯЦ");
	
	ОткрытьФорму("ОбщаяФорма.ВыборПериода",
		ПараметрыФормы,
		ЭтотОбъект,
		УникальныйИдентификатор,
		,
		,
		ОбработчикЗакрытия,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

&НаКлиенте
Процедура ПредставлениеПериодаРегистрацииРегулирование(Элемент, Направление, СтандартнаяОбработка)
	
	ОбщегоНазначенияУТКлиент.РегулированиеПредставленияПериодаРегистрации(
		Направление,
		СтандартнаяОбработка,
		ПериодРегистрации,
		ПредставлениеПериодаРегистрации);
	
	ПредставлениеПериодаРегистрации = ЗакрытиеМесяцаКлиентСервер.ПредставлениеПериодаМесяцГод(ПериодРегистрации);
	
	УстановитьОтборДинамическихСписков();
	
КонецПроцедуры

&НаКлиенте
Процедура ПредставлениеПериодаРегистрацииОчистка(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура ПериодСторноПриИзменении(Элемент)
	
	УстановитьОтборДинамическихСписков();
	
КонецПроцедуры

&НаКлиенте
Процедура СостояниеПриИзменении(Элемент)
	
	УстановитьОтборДинамическихСписков();
	
КонецПроцедуры

&НаКлиенте
Процедура СмТакжеВРаботеОбработкаНавигационнойСсылки(Элемент, НавигационнаяСсылкаФорматированнойСтроки, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	СтруктураБыстрогоОтбора = Новый Структура;
	СтруктураБыстрогоОтбора.Вставить("Организация", Организация);
	
	ПараметрыЖурнала = Новый Структура;
	ПараметрыЖурнала.Вставить("СтруктураБыстрогоОтбора", СтруктураБыстрогоОтбора);
	
	ОткрытьФорму(НавигационнаяСсылкаФорматированнойСтроки, ПараметрыЖурнала);
	
КонецПроцедуры

&НаКлиенте
Процедура ДоговорНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	СтруктураОтбора = Новый Структура;
	СтруктураОтбора.Вставить("ПометкаУдаления", Ложь);
	СтруктураОтбора.Вставить("ВариантОформленияДокументовПоступленияПоУслугам", 
		ПредопределенноеЗначение("Перечисление.ВариантыОформленияДокументовПоУслугам.ПоступлениеУслугСторнируется"));
		
	Если Элементы.СтраницыОбработки.ТекущаяСтраница = Элементы.СтраницыОбработки.ПодчиненныеЭлементы.СтраницаДокументыКОформлению Тогда
		СтруктураОтбора.Вставить("ЕжемесячноеПоступлениеУслуг", Истина);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Организация) Тогда
		СтруктураОтбора.Вставить("Организация", Организация);
	КонецЕсли;
	Если ЗначениеЗаполнено(Контрагент) Тогда
		СтруктураОтбора.Вставить(?(ДоступностьКонтрагентов, "Контрагент", "Партнер"), Контрагент);
	КонецЕсли;
	
	СтруктураПараметровВыбора = Новый Структура;
	СтруктураПараметровВыбора.Вставить("РежимВыбора", Истина);
	СтруктураПараметровВыбора.Вставить("Отбор", СтруктураОтбора);
	
	ОткрытьФорму("Справочник.ДоговорыКонтрагентов.Форма.ФормаВыбора",
			СтруктураПараметровВыбора,
			Элемент,
			Элемент);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСписокДоговоровПоступленияУслуг

&НаКлиенте
Процедура СписокДоговоровПоступленияУслугПриАктивизацииСтроки(Элемент)
	ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
КонецПроцедуры

&НаКлиенте
Процедура СписокДоговоровПоступленияУслугВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ТекущиеДанные = Элемент.ТекущиеДанные;
	
	Если Не ТекущиеДанные = Неопределено Тогда
		СоответствиеПолейДоговоров = Новый Соответствие;
		СоответствиеПолейДоговоров.Вставить(Элементы.СписокДоговоровПоступленияУслугКонтрагент.Имя, "Контрагент");
		СоответствиеПолейДоговоров.Вставить(Элементы.СписокДоговоровПоступленияУслугДоговор.Имя, "Договор");
		СоответствиеПолейДоговоров.Вставить(Элементы.СписокДоговоровПоступленияУслугНомерЗаказа.Имя, "ЗаказПоставщику");
		СоответствиеПолейДоговоров.Вставить(Элементы.СписокДоговоровПоступленияУслугДатаЗаказа.Имя, "ЗаказПоставщику");
		СоответствиеПолейДоговоров.Вставить(Элементы.СписокДоговоровПоступленияУслугСуммаЗаказа.Имя, "ЗаказПоставщику");
		СоответствиеПолейДоговоров.Вставить(Элементы.СписокДоговоровПоступленияУслугВалютаЗаказа.Имя, "ЗаказПоставщику");
		СоответствиеПолейДоговоров.Вставить(Элементы.СписокДоговоровПоступленияУслугПодразделение.Имя, "Подразделение");
		
		ПолеСписка = СоответствиеПолейДоговоров.Получить(Поле.Имя);
		
		Если Не ПолеСписка = Неопределено И ЗначениеЗаполнено(ТекущиеДанные[ПолеСписка]) Тогда
			ПоказатьЗначение(Неопределено, ТекущиеДанные[ПолеСписка]);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСписокДокументовКСторнированию

&НаКлиенте
Процедура СписокДокументовКСторнированиюВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ТекущиеДанные = Элемент.ТекущиеДанные;
	
	Если Не ТекущиеДанные = Неопределено Тогда
		СоответствиеПолейДокументов = Новый Соответствие;
		СоответствиеПолейДокументов.Вставить(Элементы.СписокДокументовКСторнированиюКонтрагент.Имя, "Контрагент");
		СоответствиеПолейДокументов.Вставить(Элементы.СписокДокументовКСторнированиюДоговор.Имя, "Договор");
		СоответствиеПолейДокументов.Вставить(Элементы.СписокДокументовКСторнированиюНомерПоступления.Имя, "Поступление");
		СоответствиеПолейДокументов.Вставить(Элементы.СписокДокументовКСторнированиюДатаПоступления.Имя, "Поступление");
		СоответствиеПолейДокументов.Вставить(Элементы.СписокДокументовКСторнированиюСуммаПоступления.Имя, "Поступление");
		СоответствиеПолейДокументов.Вставить(Элементы.СписокДокументовКСторнированиюВалютаПоступления.Имя, "Поступление");
		СоответствиеПолейДокументов.Вставить(Элементы.СписокДокументовКСторнированиюНомерПриобретения.Имя, "Приобретение");
		СоответствиеПолейДокументов.Вставить(Элементы.СписокДокументовКСторнированиюДатаПриобретения.Имя, "Приобретение");
		СоответствиеПолейДокументов.Вставить(Элементы.СписокДокументовКСторнированиюСуммаПриобретения.Имя, "Приобретение");
		СоответствиеПолейДокументов.Вставить(Элементы.СписокДокументовКСторнированиюВалютаПриобретения.Имя, "Приобретение");
		СоответствиеПолейДокументов.Вставить(Элементы.СписокДокументовКСторнированиюНомерСторно.Имя, "Сторно");
		СоответствиеПолейДокументов.Вставить(Элементы.СписокДокументовКСторнированиюДатаСторно.Имя, "Сторно");
		
		ПолеСписка = СоответствиеПолейДокументов.Получить(Поле.Имя);
		
		Если Не ПолеСписка = Неопределено И ЗначениеЗаполнено(ТекущиеДанные[ПолеСписка]) Тогда
			ПоказатьЗначение(Неопределено, ТекущиеДанные[ПолеСписка]);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура СоздатьПоступлениеУслуг(Команда)
	
	ТекущаяСтрока = Элементы.СписокДоговоровПоступленияУслуг.ТекущиеДанные;
	
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура("ЗначенияЗаполнения", Новый Структура);
	
	Если ЗаполнятьНаОснованииДоговора(ТекущаяСтрока.Договор) Или Не ЗначениеЗаполнено(ТекущаяСтрока.ЗаказПоставщику) Тогда
		ПараметрыФормы.ЗначенияЗаполнения.Вставить("ДокументОснование", ТекущаяСтрока.Договор);
	Иначе
		ПараметрыФормы.ЗначенияЗаполнения.Вставить("ДокументОснование", ТекущаяСтрока.ЗаказПоставщику);
	КонецЕсли;
	
	ПараметрыФормы.ЗначенияЗаполнения.Вставить("ДатаДокумента", ДатаПоступления());
	
	ОписаниеОповещенияФормы = Новый ОписаниеОповещения("ПриЗакрытииПоступления", ЭтотОбъект);
	
	ОткрытьФорму("Документ.ПоступлениеУслугВПодразделение.Форма.ФормаДокумента", 
		ПараметрыФормы, 
		ЭтотОбъект,,,,
		ОписаниеОповещенияФормы);
	
КонецПроцедуры

&НаКлиенте
Процедура СторнироватьИСопоставитьПоступление(Команда)
	
	ОценкаПроизводительностиКлиент.ЗамерВремени("Обработка.ОформлениеДокументовПоМетодуНачисления.Форма.ФормаСопоставления.Открытие");
	
	ТекущаяСтрока = Элементы.СписокДокументовКСторнированию.ТекущиеДанные;
	
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ПериодСторно", ПериодСторно);
	ПараметрыФормы.Вставить("Договор", ТекущаяСтрока.Договор);
	ПараметрыФормы.Вставить("ДокументПоступление", ТекущаяСтрока.Поступление);
	ПараметрыФормы.Вставить("ЗаказПоставщику", ТекущаяСтрока.ЗаказПоставщикуПриобретения);
	
	Оповещение = Новый ОписаниеОповещения("ОбновитьСписокДокументов", ЭтотОбъект);
	
	ОткрытьФорму("Обработка.ОформлениеДокументовПоМетодуНачисления.Форма.ФормаСопоставления", ПараметрыФормы, ЭтотОбъект,,,, Оповещение);
	
КонецПроцедуры

&НаКлиенте
Процедура СторнироватьВыбраннойДатой(Команда)
	
	Если Элементы.СписокДокументовКСторнированию.ВыделенныеСтроки.Количество() = 0 Тогда
		ОчиститьСообщения();
		
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Необходимо выделить документы в списке';
														|en = 'Select documents in the list'"));
		
		Возврат;
	КонецЕсли;
	
	ЗаголовокФормыВвода	= НСтр("ru = 'Сторнировать датой:';
									|en = 'Reverse with date:'");
	ОписаниеОповещения	= Новый ОписаниеОповещения("УстановитьДатуСторноЗавершение", ЭтотОбъект);
	
	ПоказатьВводДаты(ОписаниеОповещения, НачалоМесяца(ТекущаяДатаСеансаСервер()), ЗаголовокФормыВвода, ЧастиДаты.Дата);
	
КонецПроцедуры

&НаКлиенте
Процедура СторнироватьДатойПриобретения(Команда)
	
	Если Элементы.СписокДокументовКСторнированию.ВыделенныеСтроки.Количество() = 0 Тогда
		ОчиститьСообщения();
		
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Необходимо выделить документы в списке';
														|en = 'Select documents in the list'"));
		
		Возврат;
	КонецЕсли;
	
	ОписаниеОповещения = Новый ОписаниеОповещения("СторнироватьДатойПриобретенияПродолжение", ЭтотОбъект);
	
	ПоказатьВопрос(ОписаниеОповещения, НСтр("ru = 'Сторнировать датой приобретения?';
											|en = 'Reverse with purchase date?'"), 
		РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Да);
	
КонецПроцедуры

// СтандартныеПодсистемы.ПодключаемыеКоманды
&НаКлиенте
Процедура Подключаемый_ВыполнитьКоманду(Команда)
	
	Если Элементы.СписокДоговоровПоступленияУслуг.ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПодключаемыеКомандыКлиент.ВыполнитьКоманду(ЭтотОбъект, Команда, Элементы.СписокДоговоровПоступленияУслуг);
	
КонецПроцедуры
// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

&НаКлиенте
Процедура Подключаемый_ОбновитьКоманды()
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Элементы.СписокДоговоровПоступленияУслуг);
КонецПроцедуры

#КонецОбласти 

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ТекущаяДатаСеансаСервер()

	Возврат ТекущаяДатаСеанса();

КонецФункции

&НаКлиенте
Процедура УстановитьДатуСторноЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ДатаСторно		  = КонецДня(Результат);
	СписокПоступлений = Новый Массив;
	СостояниеСторно	  = Элементы.Состояние.СписокВыбора.НайтиПоЗначению(1);
	
	Для каждого ИдентификаторСтроки Из Элементы.СписокДокументовКСторнированию.ВыделенныеСтроки Цикл
		СтрокаСписка = Элементы.СписокДокументовКСторнированию.ДанныеСтроки(ИдентификаторСтроки);
		
		Если Не СтрокаСписка.Состояние = СостояниеСторно.Значение Тогда
			ТекстСообщения = СтрШаблон(НСтр("ru = 'Для создания сторно статус поступления ""%1"" должен быть ""%2"".';
											|en = 'To create storno, set the ""%1"" receipt status to ""%2"".'"),
				СтрокаСписка.Поступление, СостояниеСторно.Представление);
				
			ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
			
			Продолжить;
		КонецЕсли;
		
		Отказ = Ложь;
		
		Если СтрокаСписка.ДатаПоступления > ДатаСторно Тогда  
			ТекстСообщения = СтрШаблон(НСтр("ru = 'Для документа ""%1"" Дата сторно не должна быть меньше даты поступления.';
											|en = 'For the ""%1"" document, the storno date must not be earlier than the date of receipt.'"),
				СтрокаСписка.Поступление);
				
			ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения,,,, Отказ);
		КонецЕсли;

		Если Отказ Тогда
			Продолжить;
		КонецЕсли;
		
		СписокПоступлений.Добавить(СтрокаСписка.Поступление);
	КонецЦикла;
	
	СписокДанныхСторно = ПроверитьСопоставленныеПриобретения(ДатаСторно, СписокПоступлений);
	
	Если Не СписокДанныхСторно.Количество() = 0 Тогда
		СформироватьСторноСервер(СписокДанныхСторно);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПроверитьСопоставленныеПриобретения(ДатаСторно, СписокПоступлений)

	СписокДанныхСторно = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПоступлениеУслугВПодразделение.Ссылка КАК Ссылка,
	|	ПоступлениеУслугВПодразделение.Договор КАК Договор,
	|	ПоступлениеУслугВПодразделение.Распоряжение КАК Распоряжение
	|ПОМЕСТИТЬ втСписокПоступлений
	|ИЗ
	|	Документ.ПоступлениеУслугВПодразделение КАК ПоступлениеУслугВПодразделение
	|ГДЕ
	|	ПоступлениеУслугВПодразделение.Ссылка В(&СписокПоступлений)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Сторно.ЗаменяющийДокумент КАК ЗаменяющийДокумент
	|ПОМЕСТИТЬ втСторно
	|ИЗ
	|	Документ.Сторно КАК Сторно
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втСписокПоступлений КАК втСписокПоступлений
	|		ПО (ВЫРАЗИТЬ(Сторно.СторнируемыйДокумент КАК Документ.ПоступлениеУслугВПодразделение).Договор = втСписокПоступлений.Договор)
	|ГДЕ
	|	Сторно.Проведен
	|	И НЕ Сторно.СторнируемыйДокумент В (&СписокПоступлений)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	втСписокПоступлений.Ссылка КАК Поступление,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ПриобретениеТоваровУслуг.Ссылка) КАК Приобретения
	|ИЗ
	|	втСписокПоступлений КАК втСписокПоступлений
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПриобретениеТоваровУслуг КАК ПриобретениеТоваровУслуг
	|			ЛЕВОЕ СОЕДИНЕНИЕ втСторно КАК втСторно
	|			ПО ПриобретениеТоваровУслуг.Ссылка = втСторно.ЗаменяющийДокумент
	|		ПО (ПриобретениеТоваровУслуг.Договор = втСписокПоступлений.Договор)
	|			И (втСписокПоступлений.Распоряжение ССЫЛКА Справочник.ДоговорыКонтрагентов
	|					И ПриобретениеТоваровУслуг.ЗаказПоставщику = ЗНАЧЕНИЕ(Документ.ЗаказПоставщику.ПустаяСсылка)
	|				ИЛИ ПриобретениеТоваровУслуг.ЗаказПоставщику = втСписокПоступлений.Распоряжение)
	|			И (ПриобретениеТоваровУслуг.Дата >= &НачалоПериода)
	|			И (ПриобретениеТоваровУслуг.Проведен)
	|			И (ПриобретениеТоваровУслуг.ХозяйственнаяОперация В (ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ЗакупкаУПоставщика), ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ЗакупкаВСтранахЕАЭС)))
	|ГДЕ
	|	втСторно.ЗаменяющийДокумент ЕСТЬ NULL
	|
	|СГРУППИРОВАТЬ ПО
	|	втСписокПоступлений.Ссылка";
	
	Запрос.УстановитьПараметр("СписокПоступлений", СписокПоступлений);
	Запрос.УстановитьПараметр("НачалоПериода", ПериодСторно.ДатаНачала);

	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Если Выборка.Приобретения > 0 Тогда
			ТекстСообщения = СтрШаблон(НСтр("ru = 'Для документа ""%1"" есть документ Приобретение товаров и услуг. 
				|Необходимо сопоставить и сторнировать такие документы вручную с помощью операции  ""Сопоставить с приобретением и сторнировать"".';
				|en = 'For the ""%1"" document, there is a ""Vendor invoice"" document. 
				|Map and reverse such documents manually using the ""Map with purchase and reverse"" transaction.'"),
				Выборка.Поступление);
				
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		Иначе
			ДанныеСторно = Новый Структура("ДатаСторно, Поступление, Приобретение", 
				ДатаСторно, Выборка.Поступление, Неопределено);
			
			СписокДанныхСторно.Добавить(ДанныеСторно);
		КонецЕсли;
	КонецЦикла;
	
	Возврат СписокДанныхСторно;

КонецФункции

&НаКлиенте
Процедура СторнироватьДатойПриобретенияПродолжение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли; 
	
	СписокДанныхСторно = Новый Массив;
	СостояниеСторно	   = Элементы.Состояние.СписокВыбора.НайтиПоЗначению(2);
	
	Для каждого ИдентификаторСтроки Из Элементы.СписокДокументовКСторнированию.ВыделенныеСтроки Цикл
		СтрокаСписка = Элементы.СписокДокументовКСторнированию.ДанныеСтроки(ИдентификаторСтроки);
		
		Если Не СтрокаСписка.Состояние = СостояниеСторно.Значение Тогда
			ТекстСообщения = СтрШаблон(НСтр("ru = 'Для создания сторно статус поступления ""%1"" должен быть ""%2"".';
											|en = 'To create storno, set the ""%1"" receipt status to ""%2"".'"),
				СтрокаСписка.Поступление, СостояниеСторно.Представление);
				
			ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
			
			Продолжить;
		КонецЕсли;
		
		Отказ = Ложь;
		
		ДатаСторно = КонецДня(СтрокаСписка.ДатаПриобретения);
		
		Если СтрокаСписка.ДатаПоступления > ДатаСторно Тогда  
			ТекстСообщения = СтрШаблон(НСтр("ru = 'Для документа ""%1"" Дата сторно не должна быть меньше даты поступления.';
											|en = 'For the ""%1"" document, the storno date must not be earlier than the date of receipt.'"),
				СтрокаСписка.Поступление);
				
			ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения,,,, Отказ);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаСписка.Приобретение) Тогда
			Если СтрокаСписка.ДатаПриобретения > ДатаСторно Тогда
				ТекстСообщения = СтрШаблон(НСтр("ru = 'Для документа ""%1"" Дата сторно не должна быть меньше даты приобретения.';
												|en = 'For the ""%1"" document, the storno date must not be earlier than the date of purchase.'"),
					СтрокаСписка.Поступление);
					
				ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения,,,, Отказ);
			КонецЕсли;		
		КонецЕсли;

		Если Отказ Тогда
			Продолжить;
		КонецЕсли;
		
		ДанныеСторно = Новый Структура("ДатаСторно, Поступление, Приобретение", 
			ДатаСторно, СтрокаСписка.Поступление, СтрокаСписка.Приобретение);
		
		СписокДанныхСторно.Добавить(ДанныеСторно);
	КонецЦикла;
	
	Если Не СписокДанныхСторно.Количество() = 0 Тогда
		СформироватьСторноСервер(СписокДанныхСторно);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура СформироватьСторноСервер(СписокДанныхСторно)
	
	СписокПоступлений = Новый Массив;
	
	Для каждого ДанныеСторно Из СписокДанныхСторно Цикл
		СписокПоступлений.Добавить(ДанныеСторно.Поступление);
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Сторно.Ссылка КАК Сторно,
	|	Сторно.СторнируемыйДокумент КАК Поступление
	|ИЗ
	|	Документ.Сторно КАК Сторно
	|ГДЕ
	|	НЕ Сторно.ПометкаУдаления
	|	И Сторно.СторнируемыйДокумент В(&СписокПоступлений)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Сторно.Дата УБЫВ";
	
	Запрос.УстановитьПараметр("СписокПоступлений", СписокПоступлений);
	
	ТаблицаСторно = Запрос.Выполнить().Выгрузить();

	Для каждого ДанныеСторно Из СписокДанныхСторно Цикл
		СтрокаТаблицыСторно = ТаблицаСторно.Найти(ДанныеСторно.Поступление, "Поступление");
		
		Если СтрокаТаблицыСторно = Неопределено Тогда
			СторноОбъект = Документы.Сторно.СоздатьДокумент();
		Иначе
			СторноОбъект = СтрокаТаблицыСторно.Сторно.ПолучитьОбъект();
		КонецЕсли;
		
		Попытка
			СторноОбъект.Заполнить(ДанныеСторно.Поступление);
		Исключение
			ТекстСообщения = СтрШаблон(НСтр("ru = 'Не удалось сторнировать документ ""%1"" по причине: %2';
											|en = 'Cannot reverse the ""%1"" document due to: %2'"),
				ДанныеСторно.Поступление, 
				ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
					
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
			
			Продолжить;
		КонецПопытки;
		
		СторноОбъект.Дата = ДанныеСторно.ДатаСторно;
		СторноОбъект.ЗаменяющийДокумент = ДанныеСторно.Приобретение;
		
		Попытка
			СторноОбъект.Записать(РежимЗаписиДокумента.Проведение);
			
			ТекстСообщения = СтрШаблон(НСтр("ru = 'Для поступления ""%1"" сформирован документ ""%2""';
											|en = 'The ""%2"" document is generated for the ""%1"" receipt'"),
				ДанныеСторно.Поступление, СторноОбъект.Ссылка);
			
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		Исключение
			ТекстСообщения = СтрШаблон(НСтр("ru = 'Не удалось сторнировать документ ""%1"" по причине: %2';
											|en = 'Cannot reverse the ""%1"" document due to: %2'"),
				ДанныеСторно.Поступление, ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		КонецПопытки;
	КонецЦикла;
	
	Элементы.СписокДокументовКСторнированию.Обновить();

КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	// Условное оформление динамического списка "СписокДоговоровПоступленияУслуг"
	СписокУсловноеОформление = СписокДоговоровПоступленияУслуг.КомпоновщикНастроек.Настройки.УсловноеОформление;
	СписокУсловноеОформление.Элементы.Очистить();
	//
	
	СтандартныеПодсистемыСервер.УстановитьУсловноеОформлениеПоляДата(ЭтотОбъект,
																	"СписокДоговоровПоступленияУслуг.Дата",
																	"СписокДоговоровПоступленияУслугДатаЗаказа");
	
	// Условное оформление динамического списка "СписокДокументовКСторнированию"
	СписокУсловноеОформление = СписокДокументовКСторнированию.КомпоновщикНастроек.Настройки.УсловноеОформление;
	СписокУсловноеОформление.Элементы.Очистить();
	//
	
	СтандартныеПодсистемыСервер.УстановитьУсловноеОформлениеПоляДата(ЭтотОбъект,
																	"СписокДокументовКСторнированию.ДатаПоступления",
																	"СписокДоговоровПоступленияУслугДатаПоступления");
	
	СтандартныеПодсистемыСервер.УстановитьУсловноеОформлениеПоляДата(ЭтотОбъект,
																	"СписокДокументовКСторнированию.ДатаПриобретения",
																	"СписокДоговоровПоступленияУслугДатаПриобретения");
	
	СтандартныеПодсистемыСервер.УстановитьУсловноеОформлениеПоляДата(ЭтотОбъект,
																	"СписокДокументовКСторнированию.ДатаСторно",
																	"СписокДоговоровПоступленияУслугДатаСторно");

КонецПроцедуры

&НаКлиенте
Процедура СторнироватьЗавершение(Результат, ДополнительныеПараметры) Экспорт

	ОбновитьТаблицуФормы(Элементы.СтраницаДокументыКСторнированию, Элементы.СписокДокументовКСторнированию);

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСписокДокументов(РезультатЗакрытия, ДополнительныеПараметры) Экспорт
	
	ОбновитьТаблицуФормы(Элементы.СтраницаДокументыКСторнированию, Элементы.СписокДокументовКСторнированию);
	
КонецПроцедуры

&НаКлиенте
Процедура ПредставлениеПериодаРегистрацииНачалоВыбораЗавершение(ВыбранныйПериод, ДополнительныеПараметры) Экспорт
	
	Если ВыбранныйПериод <> Неопределено Тогда
		
		ПериодРегистрации = ВыбранныйПериод;
		ПредставлениеПериодаРегистрации = ЗакрытиеМесяцаКлиентСервер.ПредставлениеПериодаМесяцГод(ПериодРегистрации);
		
		УстановитьОтборДинамическихСписков();
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ИнициализироватьРеквизиты()
	
	ДоступностьКонтрагентов = ПолучитьФункциональнуюОпцию("ИспользоватьПартнеровИКонтрагентов");
	ИспользоватьСтатусыЗаказовПоставщикам = ПолучитьФункциональнуюОпцию("ИспользоватьСтатусыЗаказовПоставщикам");
	
	Если ДоступностьКонтрагентов Тогда
		Контрагент = Справочники.Контрагенты.ПустаяСсылка();
	Иначе
		Контрагент = Справочники.Партнеры.ПустаяСсылка();
	КонецЕсли;
	
	Элементы.СписокДоговоровПоступленияУслугКонтрагент.Видимость = ДоступностьКонтрагентов;
	Элементы.СписокДоговоровПоступленияУслугПартнер.Видимость = Не ДоступностьКонтрагентов;
	Элементы.СписокДокументовКСторнированиюКонтрагент.Видимость  = ДоступностьКонтрагентов;
	
	ПравоДобавлятьПоступление = ПравоДоступа("Добавление", Метаданные.Документы.ПоступлениеУслугВПодразделение);
	Элементы.СписокДоговоровПоступленияУслугСоздатьПоступлениеУслуг.Видимость = ПравоДобавлятьПоступление;
	
	ПериодРегистрации = ОпределитьПериодРегистрации();
	ПредставлениеПериодаРегистрации = ЗакрытиеМесяцаКлиентСервер.ПредставлениеПериодаМесяцГод(ПериодРегистрации);
	ПериодСторно.ДатаНачала = ПериодРегистрации;
	ПериодСторно.ДатаОкончания = КонецМесяца(ПериодРегистрации);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьОтборДинамическихСписков()
	
	Партнер = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Контрагент, "Партнер");
	НовыйМассив = Новый Массив();
	
	Если Не Контрагент.Пустая() Тогда
		НоваяСвязь = Новый СвязьПараметраВыбора("Партнер", "Партнер");
		НовыйМассив.Добавить(НоваяСвязь);	 
	КонецЕсли; 
	
	НовыеСвязи = Новый ФиксированныйМассив(НовыйМассив);
	Элементы.Договор.СвязиПараметровВыбора = НовыеСвязи;
	
	Если Элементы.СтраницыОбработки.ТекущаяСтраница = Элементы.СтраницыОбработки.ПодчиненныеЭлементы.СтраницаДокументыКОформлению Тогда
		СписокДоговоровПоступленияУслуг.Параметры.УстановитьЗначениеПараметра("НачалоПериода", НачалоМесяца(ПериодРегистрации));
		СписокДоговоровПоступленияУслуг.Параметры.УстановитьЗначениеПараметра("КонецПериода",  КонецМесяца(ПериодРегистрации));
		СписокДоговоровПоступленияУслуг.Параметры.УстановитьЗначениеПараметра("ИспользоватьСтатусыЗаказовПоставщикам", ИспользоватьСтатусыЗаказовПоставщикам);
		
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
			СписокДоговоровПоступленияУслуг,
			"Организация",
			Организация,
			ВидСравненияКомпоновкиДанных.Равно,
			,
			ЗначениеЗаполнено(Организация));
			
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
			СписокДоговоровПоступленияУслуг,
			"Подразделение",
			Подразделение,
			ВидСравненияКомпоновкиДанных.Равно,
			,
			ЗначениеЗаполнено(Подразделение));
			
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
			СписокДоговоровПоступленияУслуг,
			?(ДоступностьКонтрагентов, "Контрагент", "Партнер"),
			Контрагент,
			ВидСравненияКомпоновкиДанных.Равно,
			,
			ЗначениеЗаполнено(Контрагент));
			
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
			СписокДоговоровПоступленияУслуг,
			"Договор",
			Договор,
			ВидСравненияКомпоновкиДанных.Равно,
			,
			ЗначениеЗаполнено(Договор));
			
		Элементы.СписокДоговоровПоступленияУслуг.ВыделенныеСтроки.Очистить();
	ИначеЕсли Элементы.СтраницыОбработки.ТекущаяСтраница = Элементы.СтраницыОбработки.ПодчиненныеЭлементы.СтраницаДокументыКСторнированию Тогда
		СписокДокументовКСторнированию.Параметры.УстановитьЗначениеПараметра("НачалоПериода", ПериодСторно.ДатаНачала);
		СписокДокументовКСторнированию.Параметры.УстановитьЗначениеПараметра("КонецПериода", КонецДня(ПериодСторно.ДатаОкончания));
		СписокДокументовКСторнированию.Параметры.УстановитьЗначениеПараметра("НачалоПериодаПТУ", ДобавитьМесяц(ПериодСторно.ДатаНачала, -3));
		СписокДокументовКСторнированию.Параметры.УстановитьЗначениеПараметра("КонецПериодаПТУ", ДобавитьМесяц(КонецДня(ПериодСторно.ДатаОкончания), 3));
		
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
			СписокДокументовКСторнированию,
			"Организация",
			Организация,
			ВидСравненияКомпоновкиДанных.Равно,
			,
			ЗначениеЗаполнено(Организация));
			
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
			СписокДокументовКСторнированию,
			"Подразделение",
			Подразделение,
			ВидСравненияКомпоновкиДанных.Равно,
			,
			ЗначениеЗаполнено(Подразделение));
			
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
			СписокДокументовКСторнированию,
			?(ДоступностьКонтрагентов, "Контрагент", "Партнер"),
			Контрагент,
			ВидСравненияКомпоновкиДанных.Равно,
			,
			ЗначениеЗаполнено(Контрагент));
			
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
			СписокДокументовКСторнированию,
			"Договор",
			Договор,
			ВидСравненияКомпоновкиДанных.Равно,
			,
			ЗначениеЗаполнено(Договор));
			
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
			СписокДокументовКСторнированию,
			"Состояние",
			Состояние,
			ВидСравненияКомпоновкиДанных.Равно,
			,
			Не Состояние = 0);
			
		Элементы.СписокДокументовКСторнированию.ВыделенныеСтроки.Очистить();
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура НастроитьСсылкуСмТакже()
	
	ПараметрыФормирования = Новый Структура;
	ПараметрыФормирования.Вставить("КлючНазначенияИспользования", "Накладные");
	
	МассивМенеджеровРасчетаСмТакжеВРаботе = Новый Массив();
	МассивМенеджеровРасчетаСмТакжеВРаботе.Добавить("Обработка.ЖурналДокументовЗакупки");
	
	СмТакжеВРаботе = ОбщегоНазначенияУТ.СформироватьГиперссылкуСмТакжеВРаботе(МассивМенеджеровРасчетаСмТакжеВРаботе, ПараметрыФормирования);
	Элементы.СмТакжеВРаботе.Видимость = ЗначениеЗаполнено(СмТакжеВРаботе);
	
КонецПроцедуры

