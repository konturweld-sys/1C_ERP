#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ДокументПоступление = Параметры.ДокументПоступление;
	Договор = Параметры.Договор;
	ПериодСторно = Параметры.ПериодСторно;
	ЗаказПоставщику = Параметры.ЗаказПоставщику;
	
	ПравоДобавлятьПриобретение = ПравоДоступа("Добавление", Метаданные.Документы.ПриобретениеТоваровУслуг);
	Элементы.ФормаСоздатьНовый.Видимость = ПравоДобавлятьПриобретение;
	ПравоДобавлятьСторно = ПравоДоступа("Добавление", Метаданные.Документы.Сторно);
	Элементы.ФормаСопоставить.Видимость = ПравоДобавлятьСторно;
	
	ЗаполнитьСписокДокументов();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыТаблицаДокументов

&НаКлиенте
Процедура ТаблицаДокументовВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ПоказатьЗначение(Неопределено, Элемент.ТекущиеДанные.Приобретение);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОткрытьСуществующий(Команда)
	
	Если Элементы.ТаблицаДокументов.ТекущиеДанные = Неопределено Тогда
		Возврат;
	ИначеЕсли ЗначениеЗаполнено(Элементы.ТаблицаДокументов.ТекущиеДанные.Приобретение) Тогда
		ПоказатьЗначение(, Элементы.ТаблицаДокументов.ТекущиеДанные.Приобретение);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьНовый(Команда)
	
	ОписаниеОповещенияФормы = Новый ОписаниеОповещения("ПриЗакрытииДокумента", ЭтотОбъект);
	
	ПараметрыФормы = Новый Структура("ЗначенияЗаполнения", Новый Структура);
	ПараметрыФормы.ЗначенияЗаполнения.Вставить("ДокументОснование", ДокументПоступление);
	
	ОткрытьФорму("Документ.ПриобретениеТоваровУслуг.Форма.ФормаДокумента",
		ПараметрыФормы,
		ЭтотОбъект,,,,
		ОписаниеОповещенияФормы);
	
КонецПроцедуры

&НаКлиенте
Процедура Сопоставить(Команда)
	
	ТекущиеДанные = Элементы.ТаблицаДокументов.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыФормыСторно = ПараметрыСторно(ТекущиеДанные.Приобретение);
	
	ОткрытьФорму("Документ.Сторно.Форма.ФормаДокумента", ПараметрыФормыСторно, ЭтотОбъект);
	
	Закрыть();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ПараметрыСторно(СторнируемыйДокумент)
	
	ПараметрыСторно = Новый Структура("ЗначенияЗаполнения", Новый Структура);
	ПараметрыСторно.ЗначенияЗаполнения.Вставить("Дата", ТекущаяДатаСеанса());
	ПараметрыСторно.ЗначенияЗаполнения.Вставить("СторнируемыйДокумент", ДокументПоступление);
	ПараметрыСторно.ЗначенияЗаполнения.Вставить("ЗаменяющийДокумент", СторнируемыйДокумент);
	
	Возврат ПараметрыСторно;
	
КонецФункции

&НаКлиенте
Процедура ПриЗакрытииДокумента(РезультатЗакрытия, ДополнительныеПараметры) Экспорт
	ЗаполнитьСписокДокументов();
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокДокументов()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Сторно.ЗаменяющийДокумент КАК ЗаменяющийДокумент
	|ПОМЕСТИТЬ втСторно
	|ИЗ
	|	Документ.Сторно КАК Сторно
	|ГДЕ
	|	Сторно.Проведен
	|	И ВЫРАЗИТЬ(Сторно.СторнируемыйДокумент КАК Документ.ПоступлениеУслугВПодразделение).Договор = &Договор
	|	И НЕ Сторно.СторнируемыйДокумент = &ДокументПоступление
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВЫБОР
	|		КОГДА ПриобретениеТоваровУслуг.Проведен
	|			ТОГДА 0
	|		КОГДА ПриобретениеТоваровУслуг.ПометкаУдаления
	|			ТОГДА 1
	|		ИНАЧЕ 2
	|	КОНЕЦ КАК НестандартнаяКартинка,
	|	ПриобретениеТоваровУслуг.Ссылка КАК Приобретение,
	|	ПриобретениеТоваровУслуг.СуммаДокумента КАК СуммаДокумента,
	|	ПриобретениеТоваровУслуг.ДатаВходящегоДокумента КАК ДатаВходящегоДокумента,
	|	ПриобретениеТоваровУслуг.НомерВходящегоДокумента КАК НомерВходящегоДокумента,
	|	ПриобретениеТоваровУслуг.Представление КАК Представление,
	|	ПриобретениеТоваровУслуг.Валюта КАК Валюта
	|ИЗ
	|	Документ.ПриобретениеТоваровУслуг КАК ПриобретениеТоваровУслуг
	|		ЛЕВОЕ СОЕДИНЕНИЕ втСторно КАК втСторно
	|		ПО ПриобретениеТоваровУслуг.Ссылка = втСторно.ЗаменяющийДокумент
	|ГДЕ
	|	&УсловиеЗаказПоставщику
	|	И ПриобретениеТоваровУслуг.Дата >= &НачалоПериода
	|	И ПриобретениеТоваровУслуг.Проведен
	|	И ПриобретениеТоваровУслуг.Договор = &Договор
	|	И ПриобретениеТоваровУслуг.ХозяйственнаяОперация В (ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ЗакупкаУПоставщика), ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ЗакупкаВСтранахЕАЭС))
	|	И втСторно.ЗаменяющийДокумент ЕСТЬ NULL";
	
	Если Не ЗаказПоставщику.Пустая() Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеЗаказПоставщику", "ПриобретениеТоваровУслуг.ЗаказПоставщику = &ЗаказПоставщику");
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеЗаказПоставщику", "ИСТИНА");
	КонецЕсли;
	
	Если Параметры.Свойство("ДокументПоступление") 
		И Параметры.ДокументПоступление <> Документы.ПоступлениеУслугВПодразделение.ПустаяСсылка() Тогда
		ДатаПоступления = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Параметры.ДокументПоступление, "Дата");
		НачалоПериода = Макс(ПериодСторно.ДатаНачала, ДатаПоступления);
	Иначе
		НачалоПериода = ПериодСторно.ДатаНачала
	КонецЕсли;
	
	Запрос.УстановитьПараметр("ЗаказПоставщику", ЗаказПоставщику);
	Запрос.УстановитьПараметр("ДокументПоступление", ДокументПоступление);
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("Договор", Договор);
	
	ТаблицаДокументов.Загрузить(Запрос.Выполнить().Выгрузить());
	
КонецПроцедуры

#КонецОбласти