#Область ОписаниеПеременных

&НаКлиенте
Перем КэшированныеЗначения; //используется механизмом обработки изменения реквизитов ТЧ

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	УстановитьУсловноеОформление();

	Если Параметры.Свойство("АвтоТест") Тогда // Возврат при получении формы для анализа.
		Возврат;
	КонецЕсли;
	
	Объект.ПартияПроизводства = Параметры.ПартияПроизводства;
	Этап = Параметры.Этап;
	
	СтрокаЭтап = Объект.Этапы.Добавить();
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	*
		|ИЗ
		|	Документ.ЭтапПроизводства2_2 КАК Этапы
		|ГДЕ
		|	Этапы.Ссылка = &Этап");
	Запрос.УстановитьПараметр("Этап", Этап);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(СтрокаЭтап, Выборка);
	КонецЕсли;
	
	СтруктураРеквизитов = Новый Структура;
	СтруктураРеквизитов.Вставить("Распоряжение",                 "Документ");
	СтруктураРеквизитов.Вставить("НаправлениеДеятельности",      "Документ.НаправлениеДеятельности");
	СтруктураРеквизитов.Вставить("Подразделение",                "Документ.Подразделение");
	СтруктураРеквизитов.Вставить("НачатьНеРанее",                "Документ.НачатьНеРанее");
	СтруктураРеквизитов.Вставить("ТипПроизводственногоПроцесса", "Документ.ТипПроизводственногоПроцесса");
	ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.ПартияПроизводства, СтруктураРеквизитов);
	
	ЗаполнитьЗначенияСвойств(Объект, ЗначенияРеквизитов);
	
	ПараметрыВыбораСпецификаций = УправлениеДаннымиОбИзделиях.ПараметрыВыбораСпецификаций(
		Объект, Обработки.РедактированиеПоследовательностиЭтаповПроизводства);
	
	МассивЭлементов = Новый Массив;
	МассивЭлементов.Добавить(Элементы.ОбеспечениеМатериаламиИРаботамиСпецификация);
	МассивЭлементов.Добавить(Элементы.Спецификация);
	УправлениеДаннымиОбИзделиях.УстановитьПараметрыВыбораСпецификаций(
		МассивЭлементов, ПараметрыВыбораСпецификаций.ОбеспечениеМатериаламиИРаботами_ПланированиеРабот);
	
	ПараметрыУказанияСерий = Новый ФиксированнаяСтруктура(
		НоменклатураСервер.ПараметрыУказанияСерий(Объект, Обработки.РедактированиеПоследовательностиЭтаповПроизводства));
	
	ПараметрыЗаполненияНазначений = ОбеспечениеПроизводства.ПараметрыДействияЗаполнитьНазначениеОбеспеченияВЭтапеПроизводства(
		Объект.Этапы[0], Неопределено);
	
	ПараметрыРедактированияЭтапа = Новый ФиксированнаяСтруктура(
		Обработки.РедактированиеПоследовательностиЭтаповПроизводства.ПараметрыРедактированияЭтапа());
	
	ПараметрыВстраивания = Обработки.РедактированиеПоследовательностиЭтаповПроизводства.ДоступныеОстаткиПараметрыВстраивания();
	ОбеспечениеВДокументахСервер.ДоступныеОстаткиПриЧтенииНаСервере(ЭтотОбъект, ПараметрыВстраивания);
	
	СкладПоУмолчанию = ОбщегоНазначенияУТ.ПолучитьПроверитьСкладПоУмолчанию();
	
	НастроитьЭлементыФормы();
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	МассивНепроверяемыхРеквизитов = Новый Массив;
	ИмяТЧ = "ОбеспечениеМатериаламиИРаботами";
	ПутьТЧ = "Объект.ОбеспечениеМатериаламиИРаботами";
	ИмяСписка = НСтр("ru = 'Выполняемые работы';
					|en = 'Works to perform'");
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	
	Если Режим = РежимНесколькоРабот()
		И Объект.ОбеспечениеМатериаламиИРаботами.Количество() = 0 Тогда
		
		Шаблон = НСтр("ru = 'Не введено ни одной строки в список ""%1""';
						|en = 'No line is entered into the ""%1"" list'");
		ТекстСообщения = СтрШаблон(Шаблон, ИмяСписка);
		
		ОбщегоНазначения.СообщитьПользователю(
			ТекстСообщения,,
			"Объект.ОбеспечениеМатериаламиИРаботами",,
			Отказ);
			
	Иначе
		
		ПараметрыПроверки = НоменклатураСервер.ПараметрыПроверкиЗаполненияХарактеристик();
		ПараметрыПроверки.ИмяТЧ = ИмяТЧ;
		ПараметрыПроверки.ПредставлениеТЧ = ИмяСписка;
		ПараметрыПроверки.ИменаПолейССуффиксом.Вставить("Номенклатура", "РемонтируемоеИзделиеНоменклатура");
		ПараметрыПроверки.ИменаПолейССуффиксом.Вставить("Характеристика", "РемонтируемоеИзделиеХарактеристика");
		НоменклатураСервер.ПроверитьЗаполнениеХарактеристик(ОбработкаОбъект, МассивНепроверяемыхРеквизитов, Отказ, ПараметрыПроверки);
		
		НоменклатураСервер.ПроверитьЗаполнениеСерий(Объект, ПараметрыУказанияСерий.ОбеспечениеМатериаламиИРаботами, Отказ, МассивНепроверяемыхРеквизитов);
		
		ПараметрыОкругления = Документы.ЭтапПроизводства2_2.ПараметрыТЧДляОкругления();
		НоменклатураСервер.ПроверитьОкруглениеКоличества(Объект, Отказ, ПараметрыОкругления.ОбеспечениеМатериаламиИРаботами);
		
		Если Объект.ОбеспечениеМатериаламиИРаботами.Количество() > 1 Тогда
			ПроверятьРазныеСпецификацииОдинаковойНоменклатуры = Истина;
			ПоляПоиска = "Производится,Номенклатура,Характеристика,Склад,Назначение";
			СтруктураПоиска = Новый Структура(ПоляПоиска);
		Иначе
			ПроверятьРазныеСпецификацииОдинаковойНоменклатуры = Ложь;
		КонецЕсли;
		
		Для каждого Строка Из Объект.ОбеспечениеМатериаламиИРаботами Цикл
			
			Если НЕ ЗначениеЗаполнено(Строка.Номенклатура) Тогда
				
				СообщитьОбОшибкеЗаполнения(ПутьТЧ, Строка, "Номенклатура", Отказ, ИмяСписка, НСтр("ru = 'Номенклатура';
																									|en = 'Products'"));
				
			КонецЕсли;
			
			Если Строка.КоличествоУпаковок = 0 Тогда
				
				СообщитьОбОшибкеЗаполнения(ПутьТЧ, Строка, "КоличествоУпаковок", Отказ, ИмяСписка, НСтр("ru = 'Количество';
																										|en = 'Quantity'"));
			
			КонецЕсли;
			
			Если Строка.Производится
				И НЕ ЗначениеЗаполнено(Строка.Спецификация) Тогда
				
				СообщитьОбОшибкеЗаполнения(ПутьТЧ, Строка, "Спецификация", Отказ, ИмяСписка, НСтр("ru = 'Спецификация';
																									|en = 'Bill of materials'"));
				
			КонецЕсли;
			
			Если Строка.Производится
				И ЗначениеЗаполнено(Строка.Спецификация)
				И ПроверятьРазныеСпецификацииОдинаковойНоменклатуры Тогда
				ЗаполнитьЗначенияСвойств(СтруктураПоиска, Строка);
				Для каждого НайденнаяСтрока Из Объект.ОбеспечениеМатериаламиИРаботами.НайтиСтроки(СтруктураПоиска) Цикл
					Если НЕ НайденнаяСтрока.НомерСтроки = Строка.НомерСтроки
						И ЗначениеЗаполнено(НайденнаяСтрока.Спецификация)
						И НЕ НайденнаяСтрока.Спецификация = Строка.Спецификация Тогда
					ТекстСобщения = СтрШаблон(
						НСтр("ru = 'Не допускается указание различных спецификаций для одной аналитики учета номенклатуры (строка %1 списка ""%2"").';
							|en = 'You cannot specify different bills of materials for the same inventory location attributes (line %1 of the ""%2"" list).'"),
						Строка.НомерСтроки,
						ИмяСписка);
					СообщитьОбОшибкеЗаполнения(ПутьТЧ, Строка, "Спецификация",Отказ,,, ТекстСобщения);
					Прервать;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(Строка.СтатьяКалькуляции) Тогда
				
				СообщитьОбОшибкеЗаполнения(ПутьТЧ, Строка, "СтатьяКалькуляции", Отказ, ИмяСписка, НСтр("ru = 'Статья калькуляции';
																										|en = 'Product cost element'"));
				
			КонецЕсли;
			
			Если Строка.РемонтируемоеИзделиеДобавитьВЭтапы
				И НЕ ЗначениеЗаполнено(Строка.РемонтируемоеИзделиеСклад) Тогда
				
				СообщитьОбОшибкеЗаполнения(ПутьТЧ, Строка, "РемонтируемоеИзделиеСклад", Отказ, ИмяСписка, НСтр("ru = 'Склад';
																												|en = 'Warehouse'"));
				
			КонецЕсли;
			
			Если Строка.РемонтируемоеИзделиеДобавитьВЭтапы
				И Строка.РемонтируемоеИзделиеКоличествоУпаковок = 0 Тогда
				
				СообщитьОбОшибкеЗаполнения(ПутьТЧ, Строка, "РемонтируемоеИзделиеКоличествоУпаковок", Отказ, ИмяСписка, НСтр("ru = 'Количество';
																															|en = 'Quantity'"));
				
			КонецЕсли;
			
			Если Строка.РемонтируемоеИзделиеДобавитьВЭтапы
				И НЕ ЗначениеЗаполнено(Строка.РемонтируемоеИзделиеЭтапРазборки) Тогда
				
				СообщитьОбОшибкеЗаполнения(ПутьТЧ, Строка, "РемонтируемоеИзделиеЭтапРазборки", Отказ, ИмяСписка, НСтр("ru = 'Выпуск';
																														|en = 'Release'"));
				
			КонецЕсли;
			
			Если Строка.РемонтируемоеИзделиеДобавитьВЭтапы
				И НЕ ЗначениеЗаполнено(Строка.РемонтируемоеИзделиеЭтапСборки) Тогда
				
				СообщитьОбОшибкеЗаполнения(ПутьТЧ, Строка, "РемонтируемоеИзделиеЭтапРазборки", Отказ, ИмяСписка,НСтр("ru = 'Потребление';
																													|en = 'Consumption'"));
				
			КонецЕсли;
			
			Если Строка.РемонтируемоеИзделиеДобавитьВЭтапы
				И ЗначениеЗаполнено(Строка.РемонтируемоеИзделиеЭтапРазборки)
				И Строка.РемонтируемоеИзделиеЭтапРазборки = Строка.РемонтируемоеИзделиеЭтапСборки Тогда
				
				ТекстСобщения = НСтр("ru = 'Значения полей ""Выпуск"" и ""Потребление"" не должны совпадать.';
									|en = 'The values of the ""Release"" and ""Consumption"" fields must not match.'");
				СообщитьОбОшибкеЗаполнения(ПутьТЧ, Строка, "РемонтируемоеИзделиеЭтапРазборки",Отказ,,, ТекстСобщения);
				
			КонецЕсли;
			
			Если Строка.РемонтируемоеИзделиеДобавитьВЭтапы
				И НЕ ЗначениеЗаполнено(Строка.РемонтируемоеИзделиеСтатьяКалькуляции) Тогда
				
				СообщитьОбОшибкеЗаполнения(ПутьТЧ, Строка, "РемонтируемоеИзделиеСтатьяКалькуляции", Отказ, ИмяСписка, НСтр("ru = 'Статья калькуляции';
																															|en = 'Product cost element'"));
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Если Режим = РежимОднаРабота() Тогда
		Сообщения = ПолучитьСообщенияПользователю(Истина);
		Для каждого Сообщение Из Сообщения Цикл
			Если НЕ ПустаяСтрока(Сообщение.Поле) Тогда
				ЧастиПоля = СтрРазделить(Сообщение.Поле, ".");
				Сообщение.Поле = СтрШаблон("Элементы.ОбеспечениеМатериаламиИРаботами.ТекущиеДанные.%1", ЧастиПоля[ЧастиПоля.ВГраница()]);
				Сообщение.ПутьКДанным = "";
				Маркер = НСтр("ru = 'колонка ""';
								|en = 'column ""'");
				Позиция1 = СтрНайти(Сообщение.Текст, Маркер);
				Если Позиция1 > 0 Тогда
					Позиция2 = СтрНайти(Сообщение.Текст, """",, Позиция1+СтрДлина(Маркер));
					Если Позиция2 > 0 Тогда
						Сообщение.Текст = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
							"Поле",
							"Заполнение",
							Сред(Сообщение.Текст, Позиция1+СтрДлина(Маркер), Позиция2-Позиция1-СтрДлина(Маркер)));
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			Сообщение.Сообщить();
		КонецЦикла;
	КонецЕсли;
	
	ОбщегоНазначения.УдалитьНепроверяемыеРеквизитыИзМассива(ПроверяемыеРеквизиты, МассивНепроверяемыхРеквизитов);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура РежимПриИзменении(Элемент)
	
	НастроитьФормуПоРежимуРаботы(ЭтотОбъект);
	
	НастроитьЗависимыеЭлементыФормы(ЭтотОбъект);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыОбеспечениеМатериаламиИРаботами

&НаКлиенте
Процедура ОбеспечениеМатериаламиИРаботамиПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НоваяСтрока Тогда
		
		ТекущиеДанные = Элементы.ОбеспечениеМатериаламиИРаботами.ТекущиеДанные;
		
		ЗаполнитьРеквизитыСтрокиОбеспеченияМатериаламиИРаботамиПоУмолчанию(ЭтотОбъект, ТекущиеДанные);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбеспечениеМатериаламиИРаботамиНоменклатураПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ОбеспечениеМатериаламиИРаботами.ТекущиеДанные;
	
	СтруктураДействий = Новый Структура;
	
	СтруктураДействий.Вставить("ЗаполнитьНазначениеОбеспеченияВЭтапеПроизводства", ПараметрыЗаполненияНазначений);
	
	ДобавитьДействиеПроверитьЗаполнитьСпецификацию(ЭтотОбъект, СтруктураДействий, ТекущиеДанные);
	
	УправлениеПроизводствомКлиентСервер.ДобавитьВСтруктуруДействияПриИзмененииНоменклатуры(
		"ОбеспечениеМатериаламиИРаботами",
		ЭтотОбъект,
		Объект.Этапы[0],
		СтруктураДействий);
	
	ПакетнаяОбработкаТабличнойЧастиКлиент.ОбработатьСтрокуТЧ(ТекущиеДанные, СтруктураДействий, КэшированныеЗначения);
	
	НастроитьЗависимыеЭлементыФормы(ЭтотОбъект, "ВыполняемаяРабота");
	
КонецПроцедуры

&НаКлиенте
Процедура ОбеспечениеМатериаламиИРаботамиХарактеристикаПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ОбеспечениеМатериаламиИРаботами.ТекущиеДанные;
	
	СтруктураДействий = Новый Структура;
	
	ДобавитьДействиеПроверитьЗаполнитьСпецификацию(ЭтотОбъект, СтруктураДействий, ТекущиеДанные);
	
	ПакетнаяОбработкаТабличнойЧастиКлиент.ОбработатьСтрокуТЧ(ТекущиеДанные, СтруктураДействий, КэшированныеЗначения);
	
	НастроитьЗависимыеЭлементыФормы(ЭтотОбъект, "ВыполняемаяРабота");
	
КонецПроцедуры

&НаКлиенте
Процедура ОбеспечениеМатериаламиИРаботамиКоличествоУпаковокПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ОбеспечениеМатериаламиИРаботами.ТекущиеДанные;
	
	ВыполнитьДействияПересчетаКоличестваЕдиниц(ТекущиеДанные);
	
	НастроитьЗависимыеЭлементыФормы(ЭтотОбъект, "ВыполняемаяРабота");
	
КонецПроцедуры

&НаКлиенте
Процедура ОбеспечениеМатериаламиИРаботамиПроизвестиПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ОбеспечениеМатериаламиИРаботами.ТекущиеДанные;
	
	СтруктураДействий = Новый Структура();
	
	Если НЕ ТекущиеДанные.Производится Тогда
		ТекущиеДанные.Спецификация = Неопределено;
	КонецЕсли;
	
	ДобавитьДействиеПроверитьЗаполнитьСпецификацию(ЭтотОбъект, СтруктураДействий, ТекущиеДанные);
	ДобавитьДействиеПроверитьЗаполнитьОбеспечение(ЭтотОбъект, СтруктураДействий);
	
	ПакетнаяОбработкаТабличнойЧастиКлиент.ОбработатьСтрокуТЧ(ТекущиеДанные, СтруктураДействий, КэшированныеЗначения);
	
	НастроитьЗависимыеЭлементыФормы(ЭтотОбъект, "ВыполняемаяРабота");
	
КонецПроцедуры

&НаКлиенте
Процедура ОбеспечениеМатериаламиИРаботамиСпецификацияПриИзменении(Элемент)
	
	НастроитьЗависимыеЭлементыФормы(ЭтотОбъект, "ВыполняемаяРабота");
	
КонецПроцедуры

&НаКлиенте
Процедура ОбеспечениеМатериаламиИРаботамиРемонтируемоеИзделиеНоменклатураПриИзменении(Элемент)
	
	РемонтируемоеИзделиеНоменклатураПриИзмененииНаСервере(КэшированныеЗначения);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбеспечениеМатериаламиИРаботамиРемонтируемоеИзделиеХарактеристикаПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ОбеспечениеМатериаламиИРаботами.ТекущиеДанные;
	
	СтруктураДействий = Новый Структура;
	
	ДобавитьДействиеПроверитьЗаполнитьСпецификацию(ЭтотОбъект, СтруктураДействий, ТекущиеДанные);
	ДобавитьДействиеПроверитьЗаполнитьОбеспечение(ЭтотОбъект, СтруктураДействий);
	
	ПакетнаяОбработкаТабличнойЧастиКлиент.ОбработатьСтрокуТЧ(ТекущиеДанные, СтруктураДействий, КэшированныеЗначения);
	
	НастроитьЗависимыеЭлементыФормы(ЭтотОбъект, "РемонтируемоеИзделие");
	
КонецПроцедуры

&НаКлиенте
Процедура ОбеспечениеМатериаламиИРаботамиРемонтируемоеИзделиеСерияПриИзменении(Элемент)
	
	ВыбранноеЗначение = НоменклатураКлиентСервер.ВыбраннаяСерия();
	ТекущиеДанные = Элементы.ОбеспечениеМатериаламиИРаботами.ТекущиеДанные;
	
	ВыбранноеЗначение.Значение                   = ТекущиеДанные.РемонтируемоеИзделиеСерия;
	ВыбранноеЗначение.ИдентификаторТекущейСтроки = ТекущиеДанные.ПолучитьИдентификатор();
	
	ТекущаяСтрока = Новый Структура;
	ТекущаяСтрока.Вставить("ВариантОбеспечения", ПредопределенноеЗначение("Перечисление.ВариантыОбеспечения.НеТребуется"));
	ТекущаяСтрока.Вставить("Отменено", Ложь);
	ТекущаяСтрока.Вставить("Серия", ТекущиеДанные.РемонтируемоеИзделиеСерия);
	ТекущаяСтрока.Вставить("СтатусУказанияСерий", ТекущиеДанные.РемонтируемоеИзделиеСтатусУказанияСерий);
	
	НоменклатураКлиент.ОбработатьУказаниеСерии(
		ЭтотОбъект, ПараметрыУказанияСерий.ОбеспечениеМатериаламиИРаботами, ВыбранноеЗначение, ТекущаяСтрока);
	
	ТекущиеДанные.РемонтируемоеИзделиеСерия               = ТекущаяСтрока.Серия;
	ТекущиеДанные.РемонтируемоеИзделиеСтатусУказанияСерий = ТекущаяСтрока.СтатусУказанияСерий;
	
	НастроитьЗависимыеЭлементыФормы(ЭтотОбъект, "РемонтируемоеИзделие");
	
КонецПроцедуры

&НаКлиенте
Процедура ОбеспечениеМатериаламиИРаботамиРемонтируемоеИзделиеКоличествоУпаковокПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ОбеспечениеМатериаламиИРаботами.ТекущиеДанные;
	ТекущиеДанныеСтруктурой = ДанныеСтрокиСтруктурой(ЭтотОбъект, ТекущиеДанные, Истина);
	
	ВыполнитьДействияПересчетаКоличестваЕдиниц(ТекущиеДанныеСтруктурой);
	
	ТекущиеДанные.РемонтируемоеИзделиеКоличество = ТекущиеДанныеСтруктурой.Количество;
	
	НастроитьЗависимыеЭлементыФормы(ЭтотОбъект, "РемонтируемоеИзделие");
	
КонецПроцедуры

&НаКлиенте
Процедура ОбеспечениеМатериаламиИРаботамиРемонтируемоеИзделиеУпаковкаПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ОбеспечениеМатериаламиИРаботами.ТекущиеДанные;
	ТекущиеДанныеСтруктурой = ДанныеСтрокиСтруктурой(ЭтотОбъект, ТекущиеДанные, Истина);
	
	ВыполнитьДействияПересчетаКоличестваЕдиниц(ТекущиеДанныеСтруктурой);
	
	ТекущиеДанные.РемонтируемоеИзделиеКоличество = ТекущиеДанныеСтруктурой.Количество;
	
	НастроитьЗависимыеЭлементыФормы(ЭтотОбъект, "РемонтируемоеИзделие");
	
КонецПроцедуры

&НаКлиенте
Процедура ОбеспечениеМатериаламиИРаботамиРемонтируемоеИзделиеДобавитьВЭтапыПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ОбеспечениеМатериаламиИРаботами.ТекущиеДанные;
	
	ПроверитьОчиститьРеквизитыПринятияКУчету(ТекущиеДанные);
	
	НастроитьЗависимыеЭлементыФормы(ЭтотОбъект, "РемонтируемоеИзделие");
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПеренестиВДокумент(Команда)
	
	ОчиститьСообщения();
	
	Если НЕ ПроверитьЗаполнение() Тогда
		Возврат;
	КонецЕсли;
	
	Результат = СтруктураРезультатаНаСервере(
		?(ВладелецФормы <> Неопределено, ВладелецФормы.УникальныйИдентификатор, Неопределено));
	Закрыть(Результат);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСклад(Команда)
	
	Отбор = Новый Структура;
	Отбор.Вставить("ЭтоГруппа", Ложь);
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Отбор", Отбор);
	ПараметрыФормы.Вставить("ВыборГруппИЭлементов", ИспользованиеГруппИЭлементов.Элементы);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ЗаполнитьСкладЗавершение", ЭтотОбъект);
	
	ОткрытьФорму(
		"Справочник.Склады.ФормаВыбора",
		ПараметрыФормы,
		ЭтотОбъект,,,,
		ОписаниеОповещения,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

