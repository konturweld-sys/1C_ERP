&НаСервере
Процедура УстановитьУсловноеОформление()
	
	//
	ПараметрыУсловногоОформления = НоменклатураСервер.НовыеПараметрыУсловногоОформленияЕдиницИзмерения();
	ПараметрыУсловногоОформления.ИмяПоляЕдиницаИзмерения = "ОбеспечениеМатериаламиИРаботамиРемонтируемоеИзделиеНоменклатураЕдиницаИзмерения";
	ПараметрыУсловногоОформления.ПутьКПолюУпаковка = "Объект.ОбеспечениеМатериаламиИРаботами.Упаковка";
	НоменклатураСервер.УстановитьУсловноеОформлениеЕдиницИзмерения(ЭтотОбъект, ПараметрыУсловногоОформления);
	
	//
	НоменклатураСервер.УстановитьУсловноеОформлениеХарактеристикНоменклатуры(
		ЭтотОбъект,
		"ОбеспечениеМатериаламиИРаботамиХарактеристика",
		"Объект.ОбеспечениеМатериаламиИРаботами.ХарактеристикиИспользуются");
	
	НоменклатураСервер.УстановитьУсловноеОформлениеХарактеристикНоменклатуры(
		ЭтотОбъект,
		"ОбеспечениеМатериаламиИРаботамиРемонтируемоеИзделиеХарактеристика",
		"Объект.ОбеспечениеМатериаламиИРаботами.РемонтируемоеИзделиеХарактеристикиИспользуются");
	
	//
	Элемент = УсловноеОформление.Элементы.Добавить();
	
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.ОбеспечениеМатериаламиИРаботамиПроизвести.Имя);
	
	Отбор = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.ОбеспечениеМатериаламиИРаботами.Номенклатура");
	Отбор.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено;
	
	Элемент.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	
	//
	Элемент = УсловноеОформление.Элементы.Добавить();
	
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.ОбеспечениеМатериаламиИРаботамиРемонтируемоеИзделиеНоменклатура.Имя);
	
	Отбор = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.ОбеспечениеМатериаламиИРаботами.РемонтируемоеИзделиеНоменклатура");
	Отбор.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено;
	
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ТекстЗапрещеннойЯчейкиЦвет);
	Элемент.Оформление.УстановитьЗначениеПараметра("ОтметкаНезаполненного", Ложь);
	Элемент.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru = '<указывается справочно>';
																|en = '<specified for reference>'"));
	
	//
	Элемент = УсловноеОформление.Элементы.Добавить();
	
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.ОбеспечениеМатериаламиИРаботамиРемонтируемоеИзделиеДобавитьВЭтапы.Имя);
	
	Отбор = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.ОбеспечениеМатериаламиИРаботами.РемонтируемоеИзделиеНоменклатура");
	Отбор.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено;
	
	Элемент.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	
	//
	Элемент = УсловноеОформление.Элементы.Добавить();
	
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.ОбеспечениеМатериаламиИРаботамиРемонтируемоеИзделиеКоличествоУпаковок.Имя);
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.ОбеспечениеМатериаламиИРаботамиРемонтируемоеИзделиеУпаковка.Имя);
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.ОбеспечениеМатериаламиИРаботамиРемонтируемоеИзделиеЭтапРазборки.Имя);
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.ОбеспечениеМатериаламиИРаботамиРемонтируемоеИзделиеЭтапСборки.Имя);
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.ОбеспечениеМатериаламиИРаботамиРемонтируемоеИзделиеСтатьяКалькуляции.Имя);
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.ОбеспечениеМатериаламиИРаботамиРемонтируемоеИзделиеСклад.Имя);
	
	Отбор = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.ОбеспечениеМатериаламиИРаботами.РемонтируемоеИзделиеДобавитьВЭтапы");
	Отбор.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Отбор.ПравоеЗначение = Ложь;
	
	Элемент.Оформление.УстановитьЗначениеПараметра("ОтметкаНезаполненного", Ложь);
	Элемент.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	
	//
	Элемент = УсловноеОформление.Элементы.Добавить();
	
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.ОбеспечениеМатериаламиИРаботамиСпецификация.Имя);
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.Спецификация.Имя);
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.ОбеспечениеМатериаламиИРаботами.Производится");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Ложь;
	
	Элемент.Оформление.УстановитьЗначениеПараметра("ОтметкаНезаполненного", Ложь);
	
	//
	НоменклатураСервер.УстановитьУсловноеОформлениеСерийНоменклатуры(
		ЭтотОбъект,
		"СерииВсегдаВТЧТовары",
		Элементы.ОбеспечениеМатериаламиИРаботамиРемонтируемоеИзделиеСерия.Имя,
		"Объект.ОбеспечениеМатериаламиИРаботами.РемонтируемоеИзделиеСтатусУказанияСерий",
		"Объект.ОбеспечениеМатериаламиИРаботами.РемонтируемоеИзделиеТипНоменклатуры");
	
КонецПроцедуры

&НаСервере
Процедура НастроитьЭлементыФормы()
	
	Элементы.ОбеспечениеМатериаламиИРаботамиГруппаРемонтируемоеИзделие.Видимость =
		Объект.ТипПроизводственногоПроцесса = Перечисления.ТипыПроизводственныхПроцессов.ВыполнениеРемонтныхРабот;
	Элементы.ОбеспечениеМатериаламиИРаботамиГруппаРемонтируемоеИзделиеСерия.Видимость =
		ПараметрыУказанияСерий.ОбеспечениеМатериаламиИРаботами.ИспользоватьСерииНоменклатуры;
	
	Если ЗначениеЗаполнено(Параметры.Этап) Тогда
		Заголовок = СтрШаблон(НСтр("ru = '%1 в этап %2';
									|en = '%1 in the %2 stage'"),
			Заголовок,
			Документы.ЭтапПроизводства2_2.ПредставлениеЭтапа(Параметры.Этап));
	КонецЕсли;
	
	НастроитьФормуПоРежимуРаботы(ЭтотОбъект);
	
	НастроитьЗависимыеЭлементыФормы(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура НастроитьЗависимыеЭлементыФормы(Форма, СписокРеквизитов = "")
	
	Элементы = Форма.Элементы;
	Объект = Форма.Объект;
	
	Инициализация = ПустаяСтрока(СписокРеквизитов);
	СтруктураРеквизитов = Новый Структура(СписокРеквизитов);
	
	ТекущаяСтрока = Элементы.ОбеспечениеМатериаламиИРаботами.ТекущаяСтрока;
	ТекущиеДанные = Объект.ОбеспечениеМатериаламиИРаботами.НайтиПоИдентификатору(ТекущаяСтрока);
	
	Если СтруктураРеквизитов.Свойство("ВыполняемаяРабота")
		ИЛИ Инициализация Тогда
		
		Если Форма.Режим = РежимОднаРабота()
			И ТекущиеДанные <> Неопределено Тогда
			
			ПроизводствоКлиентСервер.НастроитьЭлементХарактеристикаНоменклатуры(
				Элементы.Характеристика, ТекущиеДанные.ХарактеристикиИспользуются); 
				
			Элементы.Произвести.ТолькоПросмотр = НЕ ЗначениеЗаполнено(ТекущиеДанные.Номенклатура);
			Элементы.Спецификация.ТолькоПросмотр = НЕ ЗначениеЗаполнено(ТекущиеДанные.Номенклатура);
			Элементы.Спецификация.Доступность = ТекущиеДанные.Производится;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если СтруктураРеквизитов.Свойство("РемонтируемоеИзделие")
		ИЛИ Инициализация Тогда
		
		Если Форма.Режим = РежимОднаРабота()
			И ТекущиеДанные <> Неопределено Тогда
			
			ПроизводствоКлиентСервер.НастроитьЭлементХарактеристикаНоменклатуры(
				Элементы.РемонтируемоеИзделиеХарактеристика, ТекущиеДанные.РемонтируемоеИзделиеХарактеристикиИспользуются);
				
			Элементы.РемонтируемоеИзделиеДобавитьВЭтапы.ТолькоПросмотр = НЕ ЗначениеЗаполнено(ТекущиеДанные.РемонтируемоеИзделиеНоменклатура);
			Элементы.ГруппаРемонтируемоеИзделиеДобавитьВЭтапы.Доступность = ТекущиеДанные.РемонтируемоеИзделиеДобавитьВЭтапы;
			
			ПроизводствоКлиентСервер.УстановитьДоступностьСерийРемонтируемогоИзделия(
				Форма, Объект.ТипПроизводственногоПроцесса, ТекущиеДанные.РемонтируемоеИзделиеСтатусУказанияСерий);
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если СтруктураРеквизитов.Свойство("Режим")
		ИЛИ Инициализация Тогда
		
		Если Форма.Режим = РежимОднаРабота() Тогда
			Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаСтраницаОднаРабота;
		Иначе
			Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаСтраницаНесколькоРабот;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция РежимОднаРабота()
	
	Возврат 0;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция РежимНесколькоРабот()
	
	Возврат 1;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура НастроитьФормуПоРежимуРаботы(Форма)
	
	Если Форма.Режим = РежимОднаРабота()
		И Форма.Объект.ОбеспечениеМатериаламиИРаботами.Количество() = 0 Тогда
		НоваяСтрока = Форма.Объект.ОбеспечениеМатериаламиИРаботами.Добавить();
		ЗаполнитьРеквизитыСтрокиОбеспеченияМатериаламиИРаботамиПоУмолчанию(Форма, НоваяСтрока);
		Форма.Элементы.ОбеспечениеМатериаламиИРаботами.ТекущаяСтрока = НоваяСтрока.ПолучитьИдентификатор();
	КонецЕсли;
	
	Если Форма.Режим = РежимОднаРабота() Тогда
		Форма.Элементы.Номенклатура.Видимость = Истина;
		Форма.Элементы.ОбеспечениеМатериаламиИРаботамиНоменклатура.Видимость = Ложь;
	Иначе
		Форма.Элементы.ОбеспечениеМатериаламиИРаботамиНоменклатура.Видимость = Истина;
		Форма.Элементы.Номенклатура.Видимость = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьРеквизитыСтрокиОбеспеченияМатериаламиИРаботамиПоУмолчанию(Форма, ДанныеСтроки)
	
	ОбъектЭтап = Форма.Объект.Этапы[0];
	
	ДанныеСтроки.Ссылка = ОбъектЭтап.Ссылка;
	ДанныеСтроки.Статус = ОбъектЭтап.Статус;
	ДанныеСтроки.ПланированиеРабот = Истина;
	ДанныеСтроки.СтатьяКалькуляции = ПредопределенноеЗначение("Справочник.СтатьиКалькуляции.ПолуфабрикатыПроизводимыеВПроцессе");
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ПроверитьЗаполнитьСкладПоУмолчанию(Форма, ТекущиеДанные)
	
	Если ЗначениеЗаполнено(ТекущиеДанные.РемонтируемоеИзделиеНоменклатура)
		И НЕ ЗначениеЗаполнено(ТекущиеДанные.РемонтируемоеИзделиеСклад) Тогда
		ТекущиеДанные.РемонтируемоеИзделиеСклад = Форма.СкладПоУмолчанию;
	ИначеЕсли НЕ ЗначениеЗаполнено(ТекущиеДанные.РемонтируемоеИзделиеНоменклатура) Тогда
		ТекущиеДанные.РемонтируемоеИзделиеСклад = Неопределено;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ПроверитьОчиститьРеквизитыПринятияКУчету(ДанныеСтроки)
	
	Если НЕ ДанныеСтроки.РемонтируемоеИзделиеДобавитьВЭтапы Тогда
		
		ДанныеСтроки.РемонтируемоеИзделиеКоличествоУпаковок = Неопределено;
		ДанныеСтроки.РемонтируемоеИзделиеКоличество = Неопределено;
		ДанныеСтроки.РемонтируемоеИзделиеСклад = Неопределено;
		ДанныеСтроки.РемонтируемоеИзделиеЭтапРазборки = Неопределено;
		ДанныеСтроки.РемонтируемоеИзделиеЭтапСборки = Неопределено;
		ДанныеСтроки.РемонтируемоеИзделиеСтатьяКалькуляции = Неопределено;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьДействияПересчетаКоличестваЕдиниц(ДанныеСтроки)
	
	СтруктураДействий = Новый Структура;
	
	СтруктураДействий.Вставить("ПересчитатьКоличествоЕдиниц", ПроизводствоКлиентСервер.ПараметрыПересчетаКоличестваЕдиниц());
	
	ПакетнаяОбработкаТабличнойЧастиКлиент.ОбработатьСтрокуТЧ(ДанныеСтроки, СтруктураДействий, КэшированныеЗначения);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ДобавитьДействиеПроверитьЗаполнитьСпецификацию(Форма, СтруктураДействий, ТекущиеДанные)
	
	Если НЕ ТекущиеДанные.Производится Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыЗаполнения = УправлениеДаннымиОбИзделияхКлиентСервер.ПараметрыДействияПроверитьЗаполнитьСпецификацию(
		Форма.Объект,
		ТекущиеДанные,
		Форма.ПараметрыВыбораСпецификаций.ОбеспечениеМатериаламиИРаботами_ПланированиеРабот);
	СтруктураДействий.Вставить("ПроверитьЗаполнитьСпецификацию", ПараметрыЗаполнения);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ДобавитьДействиеПроверитьЗаполнитьОбеспечение(Форма, СтруктураДействий)
	
	ОбъектЭтап = Форма.Объект.Этапы[0];
	
	СтруктураДействий.Вставить("ЗаполнитьНазначениеОбеспеченияВЭтапеПроизводства", Форма.ПараметрыЗаполненияНазначений);
	
	ПараметрыМетода = Новый Структура();
	ПараметрыМетода.Вставить("ЗаказНаПроизводство",    ОбъектЭтап.Распоряжение);
	ПараметрыМетода.Вставить("Подразделение",          ОбъектЭтап.Подразделение);
	ПараметрыМетода.Вставить("Ссылка",                 ОбъектЭтап.Ссылка);
	ПараметрыМетода.Вставить("Статус",                 ОбъектЭтап.Статус);
	ПараметрыМетода.Вставить("ЗаказПереработчику",     ОбъектЭтап.ЗаказПереработчику);
	ПараметрыМетода.Вставить("ПланированиеРабот",      ОбъектЭтап.ПланированиеРабот);
	ПараметрыМетода.Вставить("ПараметрыУказанияСерий", Форма.ПараметрыУказанияСерий.ОбеспечениеМатериаламиИРаботами);
	ПараметрыМетода.Вставить("Форма",                  Форма);
	
	УправлениеПроизводствомКлиентСервер.ДобавитьВСтруктуруДействияПроверитьЗаполнитьОбеспечениеВЭтапеПроизводства(
		СтруктураДействий,
		ПараметрыМетода);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ДанныеСтрокиСтруктурой(Форма, ДанныеСтроки, ПереопределитьДляРасчетаРемонтируемогоИзделия = Ложь)
	
	Результат = УправлениеПроизводствомКлиентСервер.ДанныеСтрокиОбеспечениеМатериаламиИРаботамиСтруктурой(ДанныеСтроки);
	
	Если ПереопределитьДляРасчетаРемонтируемогоИзделия Тогда
		
		Результат.Вставить("ТипНоменклатуры", ДанныеСтроки.РемонтируемоеИзделиеТипНоменклатуры);
		Результат.Вставить("Номенклатура", ДанныеСтроки.РемонтируемоеИзделиеНоменклатура);
		Результат.Вставить("Характеристика", ДанныеСтроки.РемонтируемоеИзделиеХарактеристика);
		Результат.Вставить("ХарактеристикиИспользуются", ДанныеСтроки.РемонтируемоеИзделиеХарактеристикиИспользуются);
		Результат.Вставить("КоличествоУпаковок", ДанныеСтроки.РемонтируемоеИзделиеКоличествоУпаковок);
		Результат.Вставить("Упаковка", ДанныеСтроки.РемонтируемоеИзделиеУпаковка);
		Результат.Вставить("Статус", ДанныеСтроки.Статус);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ЗаполнитьСкладЗавершение(Результат, ДополнительныеПараметры) Экспорт

	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ВыделенныеСтроки = Элементы.ОбеспечениеМатериаламиИРаботами.ВыделенныеСтроки;
	
	Для каждого ИдентификаторСтроки Из ВыделенныеСтроки Цикл
		
		ТекущиеДанные = Объект.ОбеспечениеМатериаламиИРаботами.НайтиПоИдентификатору(ИдентификаторСтроки);
		
		Если НЕ ТекущиеДанные.РемонтируемоеИзделиеДобавитьВЭтапы Тогда
			Продолжить;
		КонецЕсли;
		
		ТекущиеДанные.РемонтируемоеИзделиеСклад = Результат;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьСтатьюКалькуляции(ИмяРеквизита)
	
	Отбор = Новый Структура;
	Отбор.Вставить("ТипЗатрат", ПроизводствоКлиент.ТипыЗатратДляВыбораСтатьиКалькуляции("ОбеспечениеМатериаламиИРаботами"));
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Отбор", Отбор);
	ПараметрыФормы.Вставить("МножественныйВыбор", Ложь);
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ИмяРеквизита", ИмяРеквизита);
	ОписаниеОповещения = Новый ОписаниеОповещения("ЗаполнитьСтатьюКалькуляцииВСтрокахЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	
	ОткрытьФорму(
		"Справочник.СтатьиКалькуляции.ФормаВыбора",
		ПараметрыФормы,
		ЭтотОбъект,,,,
		ОписаниеОповещения,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСтатьюКалькуляцииВСтрокахЗавершение(Результат, ДополнительныеПараметры) Экспорт

	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ВыделенныеСтроки = Элементы.ОбеспечениеМатериаламиИРаботами.ВыделенныеСтроки;
	
	Для каждого ИдентификаторСтроки Из ВыделенныеСтроки Цикл
		
		ТекущиеДанные = Объект.ОбеспечениеМатериаламиИРаботами.НайтиПоИдентификатору(ИдентификаторСтроки);
		
		ИмяРеквизита = ДополнительныеПараметры.ИмяРеквизита;
		Если ИмяРеквизита = "РемонтируемоеИзделиеСтатьяКалькуляции"
			И НЕ ТекущиеДанные.РемонтируемоеИзделиеДобавитьВЭтапы Тогда
			Продолжить;
		КонецЕсли;
		
		ТекущиеДанные[ИмяРеквизита] = Результат;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьЭтап(ИмяРеквизита)
	
	Отбор = Новый Структура;
	Отбор.Вставить("ПартияПроизводства", Объект.ПартияПроизводства);
	Отбор.Вставить("ПланированиеРабот", Ложь);
	
	ПараметрыФормы = Новый Структура;
