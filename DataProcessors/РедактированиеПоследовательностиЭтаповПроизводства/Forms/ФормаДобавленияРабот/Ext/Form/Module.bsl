&НаСервере
Процедура СообщитьОбОшибкеЗаполнения(ПутьТЧ, ДанныеСтроки, ИмяПоля, Отказ, ИмяСписка = "", ПредставлениеПоля = "", ТекстСообщения = Неопределено)
	
	Если ТекстСообщения = Неопределено Тогда
		ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
			"Колонка", "Заполнение", ПредставлениеПоля, ДанныеСтроки.НомерСтроки, ИмяСписка);
	КонецЕсли;
	Поле = ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти(ПутьТЧ, ДанныеСтроки.НомерСтроки, ИмяПоля);
	
	ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,, Поле,, Отказ);
	
КонецПроцедуры

&НаСервере
Функция СтруктураРезультатаНаСервере(УИД = Неопределено)
	
	Результат = Новый Структура;
	
	ИменаКолонок = "Номенклатура,Характеристика,КоличествоУпаковок,Упаковка,Количество,Спецификация,
		|СтатьяКалькуляции,ВариантОбеспечения,Производится,Обособленно,Назначение,НазначениеОбеспечения,
		|РемонтируемоеИзделиеНоменклатура,РемонтируемоеИзделиеХарактеристика,РемонтируемоеИзделиеСерия,РемонтируемоеИзделиеСтатусУказанияСерий,
		|РемонтируемоеИзделиеДобавитьВЭтапы,РемонтируемоеИзделиеЭтапРазборки,РемонтируемоеИзделиеЭтапСборки,РемонтируемоеИзделиеСклад,
		|РемонтируемоеИзделиеКоличествоУпаковок,РемонтируемоеИзделиеУпаковка,РемонтируемоеИзделиеКоличество,РемонтируемоеИзделиеСтатьяКалькуляции";
	
	Отбор = Новый Структура;
	Если Режим = РежимОднаРабота() Тогда
		Отбор.Вставить("НомерСтроки", 1);
	КонецЕсли;
	
	Работы = Объект.ОбеспечениеМатериаламиИРаботами.Выгрузить(Отбор, ИменаКолонок);
	
	ЭтапыРазборкиСборки = Новый Массив;
	Для каждого Строка Из Работы Цикл
		Если НЕ Строка.РемонтируемоеИзделиеДобавитьВЭтапы Тогда
			Продолжить;
		КонецЕсли;
		Если ЗначениеЗаполнено(Строка.РемонтируемоеИзделиеЭтапРазборки) Тогда
			ЭтапыРазборкиСборки.Добавить(Строка.РемонтируемоеИзделиеЭтапРазборки);
		КонецЕсли;
		Если ЗначениеЗаполнено(Строка.РемонтируемоеИзделиеЭтапСборки) Тогда
			ЭтапыРазборкиСборки.Добавить(Строка.РемонтируемоеИзделиеЭтапСборки);
		КонецЕсли;
	КонецЦикла;
	ОбщегоНазначенияУТ.УдалитьПовторяющиесяЭлементыМассива(ЭтапыРазборкиСборки);
	
	Результат.Вставить("АдресТаблицыРаботы", ПоместитьВоВременноеХранилище(Работы, УИД));
	Результат.Вставить("ЭтапыРазборкиСборки", ЭтапыРазборкиСборки);
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура РемонтируемоеИзделиеНоменклатураПриИзмененииНаСервере(КэшированныеЗначения)
	
	ТекущаяСтрока = Элементы.ОбеспечениеМатериаламиИРаботами.ТекущаяСтрока;
	ТекущиеДанные = Объект.ОбеспечениеМатериаламиИРаботами.НайтиПоИдентификатору(ТекущаяСтрока);
	ТекущиеДанныеСтруктурой = ДанныеСтрокиСтруктурой(ЭтотОбъект, ТекущиеДанные, Истина);
	
	СтруктураДействий = Новый Структура;
	
	СтруктураДействий.Вставить("ПроверитьХарактеристикуПоВладельцу", ТекущиеДанныеСтруктурой.Характеристика);
