#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

// Вызывается при выполнении отчета с помощью метода СкомпоноватьРезультат.
// 
// Параметры:
//  НастройкиОтчета - НастройкиКомпоновкиДанных - Настройки отчета
//  ВнешниеНаборыДанных - Неопределено - Внешние наборы данных  
//  СтандартнаяОбработка - Булево - Стандартная обработка
// 
Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;

	ПредопределенныеНастройки = КомпоновщикНастроек.ПолучитьНастройки();
	КлючВарианта = ПредопределенныеНастройки.ДополнительныеСвойства.КлючПредопределенногоВарианта;
	ВариантНаименование = Сред(ПредопределенныеНастройки.ДополнительныеСвойства.ПредставлениеТекущегоВарианта, 7);

	ВариантНалогообложенияПрибыли = Справочники.ВариантыНалогообложенияПрибыли.ПустаяСсылка();

	МакетОтчета = Неопределено;
	НастройкиРегистровНалоговогоУчета = Отчеты.РегистрыНалоговогоУчета.НастройкиРегистровНалоговогоУчета();
	Если НастройкиРегистровНалоговогоУчета.Свойство(КлючВарианта) Тогда
		МакетОтчета = НастройкиРегистровНалоговогоУчета[КлючВарианта];
	КонецЕсли;
	
	ПараметрВариантНалогообложенияПрибыли  = КомпоновкаДанныхКлиентСервер.ПолучитьПараметр(КомпоновщикНастроек, "ВариантНалогообложенияПрибыли");
	Если ПараметрВариантНалогообложенияПрибыли <> Неопределено Тогда
		ВариантНалогообложенияПрибыли = ПараметрВариантНалогообложенияПрибыли.Значение;
	КонецЕсли;
	
	ПериодОтчета = КомпоновкаДанныхКлиентСервер.ПолучитьПараметр(КомпоновщикНастроек, "ПериодОтчета").Значение;
	ПараметрОрганизация = КомпоновкаДанныхКлиентСервер.ПолучитьПараметр(КомпоновщикНастроек, "Организация").Значение;
	
	Если НЕ ЗначениеЗаполнено(ПараметрОрганизация) Тогда
		ВызватьИсключение НСтр("ru = 'Поле ""Организация"" не заполнено';
								|en = '""Company"" is required'");
	КонецЕсли;

	Если Год(ПериодОтчета.ДатаНачала) <> Год(ПериодОтчета.ДатаОкончания) Тогда
		ВызватьИсключение НСтр("ru = 'Регистры налогового учета можно формировать только в рамках налогового периода (год)';
								|en = 'Tax accounting registers can only be generated within the tax period (year)'");
	КонецЕсли;
	
	СоответствиеОрганизацийДляВыбора = СоответствиеОрганизацийДляВыбора();
	Организация = СоответствиеОрганизацийДляВыбора[ПараметрОрганизация].Организация;

	ОсновнойВариантНалогообложения = РаздельныйУчетПоНалогуНаПрибыль.ОсновнойВариантНалогообложенияПрибыли(Организация, ПериодОтчета.ДатаОкончания);
	КомпоновкаДанныхКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "ОсновнойВариантНалогообложения", ОсновнойВариантНалогообложения);

	ВключатьОбособленныеПодразделения = СоответствиеОрганизацийДляВыбора[ПараметрОрганизация].ВключатьОбособленныеПодразделения;

	ПредставлениеОрганизации = БухгалтерскиеОтчетыВызовСервера.ПолучитьТекстОрганизация(
		Организация,
		ВключатьОбособленныеПодразделения);

	ИнформацияНалоговыйПериод     = Неопределено;
	ПредставлениеПериодаЗаголовок = "";

	СправкиРасчетыКлиентСервер.ОпределитьИнтервалОтчета(
		ПредставлениеПериодаЗаголовок,
		ИнформацияНалоговыйПериод,
		ПериодОтчета.ДатаНачала,
		ПериодОтчета.ДатаОкончания,
		Истина,
		Организация,
		Дата('00010101'));

	ПараметрыОтчета = Новый Структура;
	ПараметрыОтчета.Вставить("Организация"                      , Организация);
	ПараметрыОтчета.Вставить("НачалоПериода"                    , ПериодОтчета.ДатаНачала);
	ПараметрыОтчета.Вставить("КонецПериода"                     , ПериодОтчета.ДатаОкончания);
	ПараметрыОтчета.Вставить("ИдентификаторОтчета"              , "РегистрыНалоговогоУчета");
	ПараметрыОтчета.Вставить("ВключатьОбособленныеПодразделения", ВключатьОбособленныеПодразделения);
	ПараметрыОтчета.Вставить("ВыводитьЗаголовок"                , Истина);
	ПараметрыОтчета.Вставить("ВыводитьОтбор"                    , Ложь);
	ПараметрыОтчета.Вставить("ВыводитьПодвал"                   , Истина);
	ПараметрыОтчета.Вставить("КлючВарианта"                     , КлючВарианта);
	ПараметрыОтчета.Вставить("МакетОтчета"                      , МакетОтчета);
	ПараметрыОтчета.Вставить("НазваниеРегистра"             	, ВариантНаименование);
	ПараметрыОтчета.Вставить("ЭтоПредопределенныйВариант"       , Ложь);
	ПараметрыОтчета.Вставить("ИмяНастроекОтчета"             	, "");
	ПараметрыОтчета.Вставить("ВариантНалогообложенияПрибыли"    , ВариантНалогообложенияПрибыли);
	ПараметрыОтчета.Вставить("ПредставлениеОрганизации"         , ПредставлениеОрганизации);
	ПараметрыОтчета.Вставить("ПредставлениеПериода"             , ПредставлениеПериодаЗаголовок);
	ПараметрыОтчета.Вставить("ИнформацияНалоговыйПериод"        , ИнформацияНалоговыйПериод);

	КомпоновкаДанныхКлиентСервер.УдалитьОтбор(КомпоновщикНастроек, "Организация");
	БухгалтерскиеОтчетыВызовСервера.ДобавитьОтборПоОрганизации(ПараметрыОтчета, КомпоновщикНастроек);

	КомпоновкаДанныхКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "НачалоПериода" , ПараметрыОтчета.НачалоПериода);
	КомпоновкаДанныхКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "КонецПериода"  , ПараметрыОтчета.КонецПериода);

	КомпоновкаДанныхКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "НачалоПериодаГраница" , Новый Граница(НачалоДня(ПараметрыОтчета.НачалоПериода), ВидГраницы.Исключая));
	КомпоновкаДанныхКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "КонецПериодаГраница"  , Новый Граница(КонецДня(ПараметрыОтчета.КонецПериода), ВидГраницы.Включая));
		
	ВидыДетализацииУчета = РеглУчетСервер.ВидыДетализацииУчета();
	ПериодыДетализацииУчета = РеглУчетСервер.ПериодыДетализацииУчета(ПараметрыОтчета.НачалоПериода,
		ПараметрыОтчета.КонецПериода, ВидыДетализацииУчета.РеглУчетПродажПоПартиямРеализованнойНоменклатуры); 
		
	КомпоновкаДанныхКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "ДанныеБезДетализации", ПериодыДетализацииУчета.ДанныеБезДетализации);
	КомпоновкаДанныхКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "ДанныеСДетализацией", ПериодыДетализацииУчета.ДанныеСДетализацией);
	КомпоновкаДанныхКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "НачалоПериодаБезДетализации", ПериодыДетализацииУчета.НачалоПериодаБезДетализации);
	КомпоновкаДанныхКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "КонецПериодаБезДетализации", ПериодыДетализацииУчета.КонецПериодаБезДетализации);
	КомпоновкаДанныхКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "НачалоПериодаДанныеСДетализацией", ПериодыДетализацииУчета.НачалоПериодаДанныеСДетализацией);
	КомпоновкаДанныхКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "КонецПериодаДанныеСДетализацией", ПериодыДетализацииУчета.КонецПериодаДанныеСДетализацией);

	ДатаНачалаПодготовкиДекларации = Дата(1,1,1);
	ПараметрДатаНачалаПодготовкиДекларации = КомпоновкаДанныхКлиентСервер.ПолучитьПараметр(КомпоновщикНастроек,
		"ДатаНачалаПодготовкиДекларации");
	Если НЕ ПараметрДатаНачалаПодготовкиДекларации = Неопределено Тогда
		ДатаНачалаПодготовкиДекларации = ПараметрДатаНачалаПодготовкиДекларации.Значение;
	КонецЕсли;
		
	НаборКорректировок = НалогНаПрибыльКорректировки.НаборыКорректировокПоДатеПодписиДекларации(ДатаНачалаПодготовкиДекларации,
		Организация);
	
	КомпоновкаДанныхКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "ВсеНаборыКорректировок", НЕ ЗначениеЗаполнено(ДатаНачалаПодготовкиДекларации));
	КомпоновкаДанныхКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "НаборыКорректировок", НаборКорректировок);
	
	ИспользуетсяРаздельныйУчет = РаздельныйУчетПоНалогуНаПрибыль.ИспользуетсяРаздельныйУчет(
		Организация,
		ПараметрыОтчета.НачалоПериода);
		
	КомпоновкаДанныхКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "РаздельныйУчетНО", ИспользуетсяРаздельныйУчет);

	КомпоновкаДанныхКлиентСервер.УдалитьОтбор(КомпоновщикНастроек, "ВариантНалогообложенияОтбор");

	Если ИспользуетсяРаздельныйУчет И ЗначениеЗаполнено(ПараметрыОтчета.ВариантНалогообложенияПрибыли) Тогда

		//Отбор по варианту налогообложения
		БухгалтерскиеОтчетыКлиентСервер.ДобавитьОтбор(КомпоновщикНастроек,
			"ВариантНалогообложенияОтбор",
			ПараметрыОтчета.ВариантНалогообложенияПрибыли,
			ВидСравненияКомпоновкиДанных.Равно);
			
		БухгалтерскиеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек,
			"СубконтоВариантНалогообложения",
			ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.ВариантыНалогообложенияПрибыли);
			
		БухгалтерскиеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек,
			"ВариантНалогообложенияДляКосвенных",
			ПараметрыОтчета.ВариантНалогообложенияПрибыли);

	КонецЕсли;

	Если МакетОтчета = "РегистрыУчетаСостоянияЕдиницНУ"  и КлючВарианта = "Материалы" Тогда
		ГруппаОтборИЛИ = КомпоновщикНастроек.Настройки.Отбор.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
		ГруппаОтборИЛИ.Использование = Истина;
		ГруппаОтборИЛИ.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИли;
		
		БухгалтерскиеОтчетыКлиентСервер.ДобавитьОтбор(ГруппаОтборИЛИ,
			"Субконто1",
			Новый ПолеКомпоновкиДанных("КорСубконто1"),
			ВидСравненияКомпоновкиДанных.НеРавно);

		БухгалтерскиеОтчетыКлиентСервер.ДобавитьОтбор(ГруппаОтборИЛИ,
			"КорСчет",
			ПланыСчетов.Хозрасчетный.СпецоснасткаИСпецодеждаВЭксплуатации,
			ВидСравненияКомпоновкиДанных.ВИерархии);
			
		БухгалтерскиеОтчетыКлиентСервер.ДобавитьОтбор(ГруппаОтборИЛИ,
			"КорСчет",
			,
			ВидСравненияКомпоновкиДанных.НеЗаполнено);
		
	КонецЕсли;

	// заполнение параметров отчета
	ПередКомпоновкойМакета(ПараметрыОтчета, КомпоновщикНастроек);

	ВнешниеНаборыДанных = ПолучитьВнешниеНаборыДанных(ПараметрыОтчета); 

	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, КомпоновщикНастроек.ПолучитьНастройки(), ДанныеРасшифровки);

	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, ВнешниеНаборыДанных, ДанныеРасшифровки, Истина);

	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	ПроцессорВывода.УстановитьДокумент(ДокументРезультат);

	Если ПараметрыОтчета.ВыводитьЗаголовок Тогда
		Отчеты.РегистрыНалоговогоУчета.ВывестиЗаголовокОтчета(ПараметрыОтчета, КомпоновщикНастроек, ДокументРезультат);
	КонецЕсли;

	ПроцессорВывода.Вывести(ПроцессорКомпоновки);  

	Если ПараметрыОтчета.ВыводитьПодвал Тогда
		Отчеты.РегистрыНалоговогоУчета.ВывестиПодвалОтчета(ПараметрыОтчета, КомпоновщикНастроек, ДокументРезультат);
	КонецЕсли;

	ПослеВыводаРезультата(ПараметрыОтчета, ДокументРезультат);

	ДополнительныеСвойства = КомпоновщикНастроек.ПользовательскиеНастройки.ДополнительныеСвойства;
	ДополнительныеСвойства.Вставить("ВариантМодифицирован", Ложь);

КонецПроцедуры

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Настройки общей формы отчета подсистемы "Варианты отчетов".
//
// Параметры:
//   Форма - ФормаКлиентскогоПриложения - Форма отчета.
//   КлючВарианта - Строка - Имя предопределенного варианта отчета или уникальный идентификатор пользовательского.
//   Настройки - См. ОтчетыКлиентСервер.ПолучитьНастройкиОтчетаПоУмолчанию
//
Процедура ОпределитьНастройкиФормы(Форма, КлючВарианта, Настройки) Экспорт

	Настройки.События.ПриОпределенииПараметровВыбора = Истина;
	Настройки.События.ПередЗагрузкойВариантаНаСервере = Истина;
	Настройки.События.ПриЗагрузкеВариантаНаСервере = Истина;
	Настройки.События.ПередЗагрузкойНастроекВКомпоновщик = Истина; 
	Настройки.События.ПриЗагрузкеПользовательскихНастроекНаСервере = Истина; 

	Настройки.ЗагрузитьНастройкиПриИзмененииПараметров = ПолучитьНастройкиПриИзмененииПараметров();

КонецПроцедуры

// Вызывается в форме отчета перед выводом настройки.
//
// Параметры:
//   Форма - ФормаКлиентскогоПриложения - Форма отчета.
//   СвойстваНастройки - Структура - Описание настройки отчета, которая будет выведена в форме отчета:
//       * ОписаниеТипов - ОписаниеТипов -
//           Тип настройки.
//       * ЗначенияДляВыбора - СписокЗначений -
//           Объекты, которые будут предложены пользователю в списке выбора.
//           Дополняет список объектов, уже выбранных пользователем ранее.
//       * ЗапросЗначенийВыбора - Запрос -
//           Возвращает объекты, которыми необходимо дополнить ЗначенияДляВыбора.
//           Первой колонкой (с 0м индексом) должен выбираться объект,
//           который следует добавить в ЗначенияДляВыбора.Значение.
//           Для отключения автозаполнения
//           в свойство ЗапросЗначенийВыбора.Текст следует записать пустую строку.
//       * ОграничиватьВыборУказаннымиЗначениями - Булево -
//           Когда Истина, то выбор пользователя будет ограничен значениями,
//           указанными в ЗначенияДляВыбора (его конечным состоянием).
//
Процедура ПриОпределенииПараметровВыбора(Форма, СвойстваНастройки) Экспорт
	Если СвойстваНастройки.Тип = "ЗначениеПараметраНастроек"
		И СвойстваНастройки.ПолеКД = Новый ПолеКомпоновкиДанных("ПараметрыДанных.Организация") Тогда

		ЗаполнитьСписокВыбораОрганизаций(СвойстваНастройки);

	КонецЕсли;
КонецПроцедуры

// Вызывается в обработчике одноименного события формы отчета и формы настройки отчета.
// См. "Расширение управляемой формы для отчета.ПередЗагрузкойВариантаНаСервере" в синтакс-помощнике.
//
// Параметры:
//   ЭтаФорма - ФормаКлиентскогоПриложения - форма отчета или настроек отчета.
//   НовыеНастройкиКД - НастройкиКомпоновкиДанных - настройки для загрузки в компоновщик настроек.
//
Процедура ПередЗагрузкойВариантаНаСервере(ЭтаФорма, НовыеНастройкиКД) Экспорт

	НовыеНастройкиКД.ДополнительныеСвойства.Вставить("КлючТекущегоВарианта", ЭтаФорма.КлючТекущегоВарианта);

КонецПроцедуры

// Вызывается в обработчике одноименного события формы отчета после выполнения кода формы.
// См. "Расширение управляемой формы для отчета.ПриЗагрузкеВариантаНаСервере" в синтакс-помощнике.
//
// Параметры:
//   ЭтаФорма - ФормаКлиентскогоПриложения
//         - РасширениеУправляемойФормыДляОтчета - форма отчета, где:
//     * Отчет - ДанныеФормыСтруктура
//             - ОтчетОбъект
//   НовыеНастройкиКД - НастройкиКомпоновкиДанных - настройки для загрузки в компоновщик настроек.
//
Процедура ПриЗагрузкеВариантаНаСервере(ЭтаФорма, НовыеНастройкиКД) Экспорт

	Отчет = ЭтаФорма.Отчет;
	Параметры = ЭтаФорма.НастройкиОтчета;
	КомпоновщикНастроекФормы = Отчет.КомпоновщикНастроек;

	СхемаКомпоновкиДанных = Отчеты.РегистрыНалоговогоУчета.ТекущаяСхемаКомпоновкиДанных(Параметры.КлючПредопределенногоВарианта); 

 	ВыбранныйВариант = СхемаКомпоновкиДанных.ВариантыНастроек.Найти(Параметры.КлючПредопределенногоВарианта);
	КомпоновщикНастроекФормы.ЗагрузитьНастройки(ВыбранныйВариант.Настройки);
	КомпоновщикНастроекФормы.Восстановить();

	НовыеНастройкиКД = КомпоновщикНастроекФормы.Настройки;
	Параметры.КлючСхемы = Параметры.КлючПредопределенногоВарианта;

	Если Параметры.Свойство("Расшифровка") И Параметры.Расшифровка <> Неопределено
		И Параметры.Расшифровка.ПрименяемыеНастройки.ДополнительныеСвойства.Свойство("ФиксированныеНастройки") Тогда
		КомпоновщикНастроекФормы.ЗагрузитьНастройки(Параметры.Расшифровка.ПрименяемыеНастройки);
		НовыеНастройкиКД = КомпоновщикНастроекФормы.Настройки;
	КонецЕсли;

	ЭтаФорма.ОтчетНаименованиеТекущегоВарианта = Сред(ВыбранныйВариант.Представление, 7)

КонецПроцедуры

// Вызывается в обработчике одноименного события формы отчета после выполнения кода формы.
//
// Параметры:
//   Форма - ФормаКлиентскогоПриложения - форма отчета, состоит из:
//   *Параметры - ДанныеФормыСтруктура - состоит из:
//    **ДатаОкончания - Дата -
//   НовыеПользовательскиеНастройкиКД - ПользовательскиеНастройкиКомпоновкиДанных -
//       Пользовательские настройки для загрузки в компоновщик настроек.
//
// См. синтакс-помощник "Расширение управляемой формы для отчета.ПриЗагрузкеПользовательскихНастроекНаСервере"
//    в синтакс-помощнике.
//
Процедура ПриЗагрузкеПользовательскихНастроекНаСервере(Форма, НовыеПользовательскиеНастройкиКД) Экспорт
	
	Если Форма.Параметры.Свойство("Организация") Тогда
		СписокОП = ОбщегоНазначенияБПВызовСервераПовтИсп.ПолучитьСписокОбособленныхПодразделенийОрганизации(Форма.Параметры.Организация);
		ЕстьОбособленныеПодразделения = СписокОП.Количество() > 0;
		Ключ  = СтрЗаменить(Строка(ЕстьОбособленныеПодразделения) + Форма.Параметры.Организация.УникальныйИдентификатор(), "-", "");
		
		КомпоновкаДанныхКлиентСервер.УстановитьПараметр(
			КомпоновщикНастроек.Настройки,
			"Организация",
			Ключ);
		КомпоновкаДанныхКлиентСервер.УстановитьПараметр(
			КомпоновщикНастроек.ПользовательскиеНастройки,
			"Организация",
			Ключ);
	КонецЕсли;

	Если Форма.Параметры.Свойство("ПериодОтчета") Тогда
		КомпоновкаДанныхКлиентСервер.УстановитьПараметр(
			КомпоновщикНастроек.Настройки,
			"ПериодОтчета",
			Форма.Параметры.ПериодОтчета);
		КомпоновкаДанныхКлиентСервер.УстановитьПараметр(
			КомпоновщикНастроек.ПользовательскиеНастройки,
			"ПериодОтчета",
			Форма.Параметры.ПериодОтчета);
	КонецЕсли;

	Если Форма.Параметры.Свойство("ВариантНалогообложенияПрибыли") Тогда
		КомпоновкаДанныхКлиентСервер.УстановитьПараметр(
			КомпоновщикНастроек.Настройки,
			"ВариантНалогообложенияПрибыли",
			Форма.Параметры.ВариантНалогообложенияПрибыли);
		КомпоновкаДанныхКлиентСервер.УстановитьПараметр(
			КомпоновщикНастроек.ПользовательскиеНастройки,
			"ВариантНалогообложенияПрибыли",
			Форма.Параметры.ВариантНалогообложенияПрибыли);
	КонецЕсли;
	
	Если Форма.Параметры.Свойство("ВидДоходов") Тогда
		КомпоновкаДанныхКлиентСервер.ДобавитьОтбор(
			КомпоновщикНастроек.Настройки,
			"ВидДоходов",
			Форма.Параметры.ВидДоходов);
	КонецЕсли;

	Если Форма.Параметры.Свойство("ДатаНачалаПодготовкиДекларации") Тогда
		КомпоновкаДанныхКлиентСервер.УстановитьПараметр(
			КомпоновщикНастроек.Настройки,
			"ДатаНачалаПодготовкиДекларации",
			Форма.Параметры.ДатаНачалаПодготовкиДекларации);
		КомпоновкаДанныхКлиентСервер.УстановитьПараметр(
			КомпоновщикНастроек.ПользовательскиеНастройки,
			"ДатаНачалаПодготовкиДекларации",
			Форма.Параметры.ДатаНачалаПодготовкиДекларации);
	КонецЕсли;
	
КонецПроцедуры

// Вызывается перед загрузкой новых настроек. Используется для изменения схемы компоновки.
//
Процедура ПередЗагрузкойНастроекВКомпоновщик(Контекст, КлючСхемы, КлючВарианта, НовыеНастройкиКД, НовыеПользовательскиеНастройкиКД) Экспорт

	Если ТипЗнч(Контекст) = Тип("ФормаКлиентскогоПриложения") Тогда
		
		ПериодОтчета = КомпоновкаДанныхКлиентСервер.ПолучитьПараметр(
			КомпоновщикНастроек.ПользовательскиеНастройки, "ПериодОтчета").Значение; // СтандартныйПериод -

		ПараметрОрганизация = КомпоновкаДанныхКлиентСервер.ПолучитьПараметр(
			КомпоновщикНастроек.ПользовательскиеНастройки, "Организация").Значение; // Строка - Ключ - СоответствиеОрганизаций
			
		СоответствиеОрганизацийДляВыбора = СоответствиеОрганизацийДляВыбора();
		
		ДоступныеЗначения = Новый Структура;
		ДоступныеЗначения.Вставить("Организация", СписокПредставленийОрганизаций());
		
		Контекст.Отчет.КомпоновщикНастроек.Настройки.ДополнительныеСвойства.Вставить("ДоступныеЗначения", ДоступныеЗначения);
		
		ВключатьОбособленныеПодразделения = Ложь;
		Если ЗначениеЗаполнено(ПараметрОрганизация) Тогда
			Если НЕ ТипЗнч(ПараметрОрганизация) = Тип("СправочникСсылка.Организации") 
				И СоответствиеОрганизацийДляВыбора.Свойство(ПараметрОрганизация) Тогда
				СоответствиеОрганизаций = СоответствиеОрганизацийДляВыбора[ПараметрОрганизация];
				Организация = СоответствиеОрганизаций.Организация;  
				ВключатьОбособленныеПодразделения = СоответствиеОрганизаций.ВключатьОбособленныеПодразделения;
			Иначе
				Организация = Справочники.Организации.ПустаяСсылка();
			КонецЕсли;
		Иначе
			Организация = Справочники.Организации.ПустаяСсылка();
		КонецЕсли;
		
		// Организация 
		ТекстОрганизация = "";
		Если ЗначениеЗаполнено(Организация) Тогда
			ТекстОрганизация = БухгалтерскиеОтчетыВызовСервера.ПолучитьТекстОрганизация(Организация, ВключатьОбособленныеПодразделения);
		КонецЕсли;

		ИнформацияНалоговыйПериод     = Неопределено;
		ПредставлениеПериодаЗаголовок = "";

		СправкиРасчетыКлиентСервер.ОпределитьИнтервалОтчета(
			ПредставлениеПериодаЗаголовок,
			ИнформацияНалоговыйПериод,
			ПериодОтчета.ДатаНачала,
			ПериодОтчета.ДатаОкончания,
			Истина,
			Организация,
			Дата('00010101')); 

		Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Контекст, "ОтчетНаименованиеТекущегоВарианта") Тогда
			Контекст.ОтчетНаименованиеТекущегоВарианта = Сред(Контекст.ПредставлениеТекущегоВарианта, 7) + " за " + ПредставлениеПериодаЗаголовок + " " + ТекстОрганизация;
		КонецЕсли;

		Контекст.Отчет.КомпоновщикНастроек.Настройки.ДополнительныеСвойства.Вставить("ПредставлениеТекущегоВарианта", Контекст.ПредставлениеТекущегоВарианта);

		ИспользуетсяРаздельныйУчет = Ложь;
		Если ЗначениеЗаполнено(Организация) Тогда
			ИспользуетсяРаздельныйУчет = РаздельныйУчетПоНалогуНаПрибыль.ИспользуетсяРаздельныйУчет(Организация, ПериодОтчета.ДатаОкончания);
		КонецЕсли; 

		СхемаКомпоновкиДанных = Отчеты.РегистрыНалоговогоУчета.ТекущаяСхемаКомпоновкиДанных(Контекст.НастройкиОтчета.КлючПредопределенногоВарианта);

		ПараметрПоОбслуживающимПроизводствамИХозяйствам = СхемаКомпоновкиДанных.Параметры.Найти("ПоОбслуживающимПроизводствамИХозяйствам");
		Если ПараметрПоОбслуживающимПроизводствамИХозяйствам <> Неопределено Тогда
			ВариантыОтчетаСОтборомПоОбслуживающимПроизводствамИХозяйствам = Отчеты.РегистрыНалоговогоУчета.ВариантыОтчетаСОтборомПоОбслуживающимПроизводствамИХозяйствам();
			Если ВариантыОтчетаСОтборомПоОбслуживающимПроизводствамИХозяйствам.Найти(Контекст.НастройкиОтчета.КлючПредопределенногоВарианта) = Неопределено Тогда
				ПараметрПоОбслуживающимПроизводствамИХозяйствам.ОграничениеИспользования = Истина;
			КонецЕсли;
		КонецЕсли;
		
		ОтчетыСервер.ПодключитьСхему(ЭтотОбъект, Контекст, СхемаКомпоновкиДанных, КлючСхемы); 
		Если НовыеНастройкиКД.Выбор.Элементы.Количество() = 0 Тогда
			НовыеНастройкиКД = КомпоновщикНастроек.Настройки;
		КонецЕсли; 

		ЗначениеПараметраВариантНалогообложенияПрибыли = НовыеНастройкиКД.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("ВариантНалогообложенияПрибыли"));
		Если ЗначениеПараметраВариантНалогообложенияПрибыли <> Неопределено Тогда  
			Если ИспользуетсяРаздельныйУчет Тогда
				ЗначениеПараметраВариантНалогообложенияПрибыли.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.БыстрыйДоступ;
			Иначе
				ЗначениеПараметраВариантНалогообложенияПрибыли.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;
				ЗначениеПараметраВариантНалогообложенияПрибыли.Значение = Справочники.ВариантыНалогообложенияПрибыли.ПустаяСсылка();
			КонецЕсли;
        КонецЕсли;

	Иначе

		КомпоновщикНастроек.ЗагрузитьНастройки(НовыеНастройкиКД);

	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// В процедуре можно доработать компоновщик перед выводом в отчет
// 
Процедура ПередКомпоновкойМакета(ПараметрыОтчета, КомпоновщикНастроек)

	МакетОтчета  = ПараметрыОтчета.МакетОтчета;
	КлючВарианта = ПараметрыОтчета.КлючВарианта;

	НастройкиВариантаОтчета = Отчеты.РегистрыНалоговогоУчета.НастройкиВариантаОтчета(КлючВарианта, МакетОтчета, КомпоновщикНастроек);

	Для каждого Параметр Из НастройкиВариантаОтчета.Параметры Цикл
		КомпоновкаДанныхКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, Параметр.Ключ , Параметр.Значение);
	КонецЦикла;

КонецПроцедуры

Процедура ПослеВыводаРезультата(ПараметрыОтчета, Результат)
	
	Результат.ФиксацияСлева = 0;
	
КонецПроцедуры

Функция ПолучитьНастройкиПриИзмененииПараметров()

	Массив = Новый Массив;
	Массив.Добавить(Новый ПараметрКомпоновкиДанных("Организация"));
	Массив.Добавить(Новый ПараметрКомпоновкиДанных("ПериодОтчета")); 

	Возврат Массив;

КонецФункции

// Возвращает настройки налогообложения прибыли
//
// Параметры:
//  ПараметрыОтчета - Структура - содержат параметры исполнения отчета.
//
// Возвращаемое значение:
//  СтруктураВнешнихНаборовДанных - Структура - настройки налогообложения прибыли
//
Функция ПолучитьВнешниеНаборыДанных(ПараметрыОтчета)

	СтруктураВнешнихНаборовДанных = Новый Структура();

	Результат = НастройкиНалогообложенияПрибыли(ПараметрыОтчета);

	СтруктураВнешнихНаборовДанных.Вставить("Приоритет1_НастройкиНалогообложенияПрибыли", Результат[0].Выгрузить());
	СтруктураВнешнихНаборовДанных.Вставить("Приоритет2_НастройкиНалогообложенияПрибыли", Результат[1].Выгрузить());
	СтруктураВнешнихНаборовДанных.Вставить("Приоритет3_НастройкиНалогообложенияПрибыли", Результат[2].Выгрузить());

	Возврат СтруктураВнешнихНаборовДанных;

КонецФункции

// Возвращает набор настроек налогообложения
//
// Параметры:
//  ПараметрыОтчета - Структура - содержат параметры исполнения отчета.
//
// Возвращаемое значение:
//  РезультатЗапроса - Массив - Результат выполнения запроса 
//
Функция НастройкиНалогообложенияПрибыли(ПараметрыОтчета)

	ТекстыЗапросов = Новый Массив();

	Если ПараметрыОтчета.Свойство("ВариантНалогообложенияПрибыли") И ЗначениеЗаполнено(ПараметрыОтчета.ВариантНалогообложенияПрибыли) Тогда
		
		ТекстЗапроса = 
		"ВЫБРАТЬ
		|	НалогообложениеПрибылиОрганизацийСрезПоследних.Организация КАК Организация,
		|	НалогообложениеПрибылиОрганизацийСрезПоследних.Подразделение КАК Подразделение,
		|	НалогообложениеПрибылиОрганизацийСрезПоследних.ОбъектУчета КАК ОбъектУчета,
		|	НалогообложениеПрибылиОрганизацийСрезПоследних.НаправлениеДеятельности КАК НаправлениеДеятельности
		|ПОМЕСТИТЬ втОтборов
		|ИЗ
		|	РегистрСведений.НалогообложениеПрибылиОрганизаций.СрезПоследних(&Период, Организация = &Организация) КАК НалогообложениеПрибылиОрганизацийСрезПоследних
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Организация,
		|	Подразделение,
		|	НаправлениеДеятельности,
		|	ОбъектУчета";
		ТекстыЗапросов.Добавить(ТекстЗапроса);

		ПараметрыПолученияНалогообложенияПрибыли = РаздельныйУчетПоНалогуНаПрибыль.НовыйПараметрыПолученияТаблицыНастроекНалогообложенияПрибыли();
		ПараметрыПолученияНалогообложенияПрибыли.Период = КонецДня(ПараметрыОтчета.КонецПериода);
		ПараметрыПолученияНалогообложенияПрибыли.ИмяТаблицы = "втОтборов";
		ПараметрыПолученияНалогообложенияПрибыли.ИмяПоля_Организация = "Организация";
		ПараметрыПолученияНалогообложенияПрибыли.ИмяПоля_Подразделение = "Подразделение";
		ПараметрыПолученияНалогообложенияПрибыли.ИмяПоля_ОбъектУчета = "ОбъектУчета";
		ПараметрыПолученияНалогообложенияПрибыли.ИмяПоля_НаправлениеДеятельности = "НаправлениеДеятельности";

		ТекстЗапроса = РаздельныйУчетПоНалогуНаПрибыль.ТекстЗапроса_НастройкиНалогообложенияПрибыли(ПараметрыПолученияНалогообложенияПрибыли);
	Иначе
		ТекстЗапроса =
		"ВЫБРАТЬ
		|	NULL КАК ВариантНалогообложенияПрибыли,
		|	NULL КАК Организация,
		|	NULL КАК Подразделение,
		|	NULL КАК НаправлениеДеятельности,
		|	NULL КАК ОбъектУчета
		|ПОМЕСТИТЬ РаздельныйУчет_НастройкиНалогообложенияПрибыли";
	КонецЕсли;
	ТекстыЗапросов.Добавить(ТекстЗапроса); 

	ТекстЗапроса = СтрСоединить(ТекстыЗапросов, ОбщегоНазначения.РазделительПакетаЗапросов());

	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("Период", КонецДня(ПараметрыОтчета.КонецПериода));
	Запрос.УстановитьПараметр("Организация", ПараметрыОтчета.Организация);
	Запрос.Выполнить();

	ТекстЗапроса =
		"ВЫБРАТЬ
		|	Настройки.ВариантНалогообложенияПрибыли КАК ВариантНалогообложенияПрибыли,
		|	Настройки.Организация КАК Организация,
		|	Настройки.Подразделение КАК Подразделение,
		|	Настройки.НаправлениеДеятельности КАК НаправлениеДеятельности,
		|	Настройки.ОбъектУчета КАК ОбъектУчета
		|ИЗ
		|	РаздельныйУчет_НастройкиНалогообложенияПрибыли КАК Настройки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	МАКСИМУМ(Настройки.ВариантНалогообложенияПрибыли) КАК ВариантНалогообложенияПрибыли,
		|	Настройки.Организация КАК Организация,
		|	Настройки.НаправлениеДеятельности КАК НаправлениеДеятельности
		|ИЗ
		|	РаздельныйУчет_НастройкиНалогообложенияПрибыли КАК Настройки
		|ГДЕ
		|	Настройки.ОбъектУчета = НЕОПРЕДЕЛЕНО
		|	И Настройки.НаправлениеДеятельности <> ЗНАЧЕНИЕ(Справочник.НаправленияДеятельности.ПустаяСсылка)
		|
		|СГРУППИРОВАТЬ ПО
		|	Настройки.Организация,
		|	Настройки.НаправлениеДеятельности
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	МАКСИМУМ(Настройки.ВариантНалогообложенияПрибыли) КАК ВариантНалогообложенияПрибыли,
		|	Настройки.Организация КАК Организация,
		|	Настройки.Подразделение КАК Подразделение
		|ИЗ
		|	РаздельныйУчет_НастройкиНалогообложенияПрибыли КАК Настройки
		|ГДЕ
		|	Настройки.ОбъектУчета = НЕОПРЕДЕЛЕНО
		|	И Настройки.Подразделение <> ЗНАЧЕНИЕ(Справочник.СтруктураПредприятия.ПустаяСсылка)
		|	И Настройки.НаправлениеДеятельности = ЗНАЧЕНИЕ(Справочник.НаправленияДеятельности.ПустаяСсылка)
		|
		|СГРУППИРОВАТЬ ПО
		|	Настройки.Организация,
		|	Настройки.Подразделение";

	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("Период", КонецДня(ПараметрыОтчета.КонецПериода));
	Запрос.УстановитьПараметр("Организация", ПараметрыОтчета.Организация);
	Запрос.Выполнить();

	РезультатВыполнения = Запрос.ВыполнитьПакет();

	Возврат РезультатВыполнения;

КонецФункции

Функция СоответствиеОрганизацийДляВыбора()

	СоответствиеОрганизацийДляВыбора = Новый Структура;
	
	ИспользоватьУправленческуюОрганизацию = БухгалтерскийУчетПереопределяемый.ИспользоватьУправленческуюОрганизацию();

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ИспользоватьУправленческуюОрганизацию", ИспользоватьУправленческуюОрганизацию);

	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	НаборОрганизаций.Организация КАК Организация,
	|	НаборОрганизаций.ОрганизацияПредставление КАК ОрганизацияПредставление,
	|	НаборОрганизаций.ВключатьОбособленныеПодразделения
	|ИЗ
	|	(ВЫБРАТЬ
	|		Организации.Ссылка КАК Организация,
	|		Организации.Наименование КАК ОрганизацияПредставление,
	|		ЛОЖЬ КАК ВключатьОбособленныеПодразделения
	|	ИЗ
	|		Справочник.Организации КАК Организации
	|	ГДЕ
	|		НЕ Организации.Предопределенный ИЛИ &ИспользоватьУправленческуюОрганизацию
	|
	|	ОБЪЕДИНИТЬ ВСЕ
	|
	|	ВЫБРАТЬ РАЗЛИЧНЫЕ
	|		Организации.ГоловнаяОрганизация,
	|		Организации.ГоловнаяОрганизация.Наименование,
	|		ИСТИНА
	|	ИЗ
	|		Справочник.Организации КАК Организации
	|	ГДЕ
	|		Организации.ОбособленноеПодразделение) КАК НаборОрганизаций
	|УПОРЯДОЧИТЬ ПО
	|	ОрганизацияПредставление";

	Выборка = Запрос.Выполнить().Выбрать();

	МаксКоличествоСимволов = 40;
	Пока Выборка.Следующий() Цикл
		Ключ     = СтрЗаменить(Строка(Выборка.ВключатьОбособленныеПодразделения) + Выборка.Организация.УникальныйИдентификатор(), "-", "");
		Значение = Новый Структура("Организация, ВключатьОбособленныеПодразделения", Выборка.Организация, Выборка.ВключатьОбособленныеПодразделения);
		СоответствиеОрганизацийДляВыбора.Вставить(Ключ, Значение);
	КонецЦикла;

	Возврат СоответствиеОрганизацийДляВыбора;
	
КонецФункции

// Процедура заполняет список выбора организациями с обособленными подразделениями.
//
// Параметры: 
//  СвойстваНастройки - Строка - Поле для выбора организации.
//  СоответствиеОрганизаций - Структура - содержит список организаций с обособленными подразделениями.
//
Процедура ЗаполнитьСписокВыбораОрганизаций(СвойстваНастройки)
		
	СвойстваНастройки.ЗначенияДляВыбора.Очистить();

	СписокПредставленийОрганизаций = СписокПредставленийОрганизаций();
	
	Для Каждого Элемент Из СписокПредставленийОрганизаций Цикл
		СвойстваНастройки.ЗначенияДляВыбора.Добавить(Элемент.Значение, Элемент.Представление);
	КонецЦикла;
	
КонецПроцедуры

Функция СписокПредставленийОрганизаций()
	
	СписокПредставленийОрганизаций = Новый СписокЗначений;
	
	СоответствиеОрганизацийДляВыбора = СоответствиеОрганизацийДляВыбора();

	Для каждого ТекущаяОрганизация Из СоответствиеОрганизацийДляВыбора Цикл

		ОрганизацияПредставление = Строка(ТекущаяОрганизация.Значение.Организация);

		Если ТекущаяОрганизация.Значение.ВключатьОбособленныеПодразделения Тогда
			ОрганизацияПредставление = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = '%1 с обособленными подразделениями';
					|en = '%1 with branch offices'"),
				ОрганизацияПредставление);
		Иначе
			ОрганизацияПредставление = Строка(ТекущаяОрганизация.Значение.Организация);
		КонецЕсли;

		СписокПредставленийОрганизаций.Добавить(ТекущаяОрганизация.Ключ, ОрганизацияПредставление);
		
	КонецЦикла;
		
	Возврат СписокПредставленийОрганизаций;
	
КонецФункции

