// Возвращает схему компоновки данных от Варианта отчета.
//
// Параметры:
//  КлючВарианта - Строка
//  
// Возвращаемое значение:
// 	Неопределено, СхемаКомпоновкиДанных - Макет компоновки данных
//
Функция ТекущаяСхемаКомпоновкиДанных(КлючВарианта) Экспорт

	НастройкаОтчета = НастройкиРегистровНалоговогоУчета();

	Если НастройкаОтчета.Свойство(КлючВарианта) Тогда  
		КлючСхемы = НастройкаОтчета[КлючВарианта];
		Схема = Отчеты.РегистрыНалоговогоУчета.ПолучитьМакет(КлючСхемы);
	Иначе
		Схема = Неопределено;
	КонецЕсли;

	Возврат Схема;

КонецФункции

// Возвращает значения параметров компоновки данных  варианта отчета.
// 
// Параметры:
//  КлючВарианта - Строка - имя варианта отчета,
//  МакетОтчета - Строка - имя схемы компоновки данных.
//  КомпоновщикНастроек - КомпоновщикНастроекКомпоновкиДанных
// 
// Возвращаемое значение:
//   Структура:
//    * КлючСхемы - Строка - имя варианта отчета
//    * Параметры - Структура - состав параметров отчета
//
Функция НастройкиВариантаОтчета(КлючВарианта, МакетОтчета, КомпоновщикНастроек) Экспорт

	НастройкиВариантаОтчета = Новый Структура("КлючСхемы, Параметры", МакетОтчета, Новый Структура);

#Область РегистрДоходыОтРеализацииТоваровИУслуг

	Если МакетОтчета = "РегистрДоходыОтРеализацииТоваровИУслуг" Тогда

		ИспользуетсяРаздельныйУчет = КомпоновкаДанныхКлиентСервер.ПолучитьПараметр(КомпоновщикНастроек, "РаздельныйУчетНО").Значение;
		
		СчетаУчетаПродукции = Новый Массив;
		СчетаУчетаПродукции.Добавить(ПланыСчетов.Хозрасчетный.ГотоваяПродукция); //43
		СчетаУчетаПродукции.Добавить(ПланыСчетов.Хозрасчетный.Полуфабрикаты);    //21
		СчетаУчетаПродукции.Добавить(ПланыСчетов.Хозрасчетный.ГотоваяПродукцияОтгруженная); //45.02
		НастройкиВариантаОтчета.Параметры.Вставить("СчетаУчетаПродукции", СчетаУчетаПродукции);
		
		СчетаУчетаСебестоимостиРабот = Новый Массив;
		СчетаУчетаСебестоимостиРабот.Добавить(ПланыСчетов.Хозрасчетный.ОсновноеПроизводство); //20
		СчетаУчетаСебестоимостиРабот.Добавить(ПланыСчетов.Хозрасчетный.ВспомогательныеПроизводства); //23
				
		НастройкиВариантаОтчета.Параметры.Вставить("СчетаУчетаСебестоимостиРабот", СчетаУчетаСебестоимостиРабот);
		
		СчетаВыручкиСДетализацией = РеглУчетВыборкиСерверПовтИсп.СчетаВыручка();
