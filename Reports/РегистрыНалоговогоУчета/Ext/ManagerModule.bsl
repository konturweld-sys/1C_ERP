			СчетаВыручки = СчетаВыручки();

		КонецЕсли;

		НастройкиВариантаОтчета.Параметры.Вставить("СчетаУчета"    , СчетаУчета);
		НастройкиВариантаОтчета.Параметры.Вставить("КорСчетаУчета" , КорСчетаУчета);
		НастройкиВариантаОтчета.Параметры.Вставить("СчетаВыручки"  , СчетаВыручки);

	КонецЕсли;

	#КонецОбласти

	Возврат НастройкиВариантаОтчета;

КонецФункции

