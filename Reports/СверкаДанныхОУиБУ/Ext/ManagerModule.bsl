Функция ТекстЗапросаОтклоненияПоРегистраторам()
	
	МассивТекстовЗапроса = Новый Массив;
	
	МассивТекстовЗапроса.Добавить(ОтклоненияВСтоимостиТоваровОборотыОУ(Истина));
	
	МассивВидовСчетов = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве("ОтклоненияВСтоимости");
	ТекстЗапроса = РегистрыСведений.ПорядокОтраженияНаСчетахУчета.ТекстВременнойТаблицыПорядкаОтраженияПоПериодуДействия(МассивВидовСчетов);
	МассивТекстовЗапроса.Добавить(ТекстЗапроса);
	
	#Область ОтклоненияВСтоимостиТоваровОУиБУ
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ОтклоненияОбороты.Организация КАК Организация,
	|	ОтклоненияОбороты.Подразделение КАК Подразделение,
