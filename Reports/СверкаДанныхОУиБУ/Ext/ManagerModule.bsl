	#КонецОбласти
	
	ТекстЗапроса = СтрСоединить(МассивТекстовЗапроса, ОбщегоНазначения.РазделительПакетаЗапросов());
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция РасчетыСПоставщиками(ПолучатьОстатки, ПолучатьРегистраторы, РежимОтладкиПоИсточникам)
	
	ТекстыВложенногоЗапроса = Новый Массив;
	
	#Область ВТ_РасчетыСПоставщикамиРегПредварительная
	ТекстЗапроса =
	"ВЫБРАТЬ ПЕРВЫЕ 0
	|	//РежимОтладки""Инициализация"" КАК ИсточникДанных,
	|	ДАТАВРЕМЯ(1,1,1) КАК Период,
	|	НЕОПРЕДЕЛЕНО КАК Регистратор,
	|	НЕОПРЕДЕЛЕНО КАК ОбъектРасчетов,
	|	ЛОЖЬ КАК Долгосрочный,
	|	ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка) КАК Валюта,
	|	0 КАК ДолгРеглПриход,
	|	0 КАК ДолгРеглРасход,
	|	0 КАК ДолгРеглНачальныйОстаток,
	|	0 КАК ДолгРеглКонечныйОстаток,
	|	0 КАК ПредоплатаРеглПриход,
	|	0 КАК ПредоплатаРеглРасход,
	|	0 КАК ПредоплатаРеглНачальныйОстаток,
	|	0 КАК ПредоплатаРеглКонечныйОстаток,
	|	ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ПустаяСсылка) КАК ХозяйственнаяОперация
	|ПОМЕСТИТЬ ВТ_РасчетыСПоставщикамиРегПредварительная";
	Если РежимОтладкиПоИсточникам Тогда
		ТекстыВложенногоЗапроса.Добавить(ТекстЗапроса);
	КонецЕсли;
	#КонецОбласти
	
	#Область РасчетыСПоставщиками_Приход_Старые
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	//РежимОтладки""РасчетыСПоставщиками_Приход_Старые"" КАК ИсточникДанных,
	|	НАЧАЛОПЕРИОДА(Данные.Период, МЕСЯЦ) КАК Период,
	|	Данные.Регистратор КАК Регистратор,
	|	Данные.ЗаказПоставщику КАК ОбъектРасчетов,
	|	ЛОЖЬ КАК Долгосрочный,
	|	Данные.Валюта КАК Валюта,
	|	ВЫБОР
	|		КОГДА Данные.ДолгРегл < 0
	|		ТОГДА 0
	|		ИНАЧЕ Данные.ДолгРегл
	|	КОНЕЦ КАК ДолгРеглПриход,
	|	ВЫБОР
	|		КОГДА Данные.ДолгРегл < 0
	|		ТОГДА -Данные.ДолгРегл
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК ДолгРеглРасход,
	|	0 КАК ДолгРеглНачальныйОстаток,
	|	0 КАК ДолгРеглКонечныйОстаток,
	|	ВЫБОР
	|		КОГДА Данные.ПредоплатаРегл < 0
	|		ТОГДА 0
	|		ИНАЧЕ Данные.ПредоплатаРегл
	|	КОНЕЦ КАК ПредоплатаРеглПриход,
	|	ВЫБОР
	|		КОГДА Данные.ПредоплатаРегл < 0
	|		ТОГДА -Данные.ПредоплатаРегл
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК ПредоплатаРеглРасход,
	|	0 КАК ПредоплатаРеглНачальныйОстаток,
	|	0 КАК ПредоплатаРеглКонечныйОстаток,
	|	Данные.ХозяйственнаяОперация КАК ХозяйственнаяОперация
	|ИЗ
	|	РегистрНакопления.РасчетыСПоставщикамиПоДокументам КАК Данные
	|ГДЕ
	|	Данные.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|	И Данные.Период МЕЖДУ &НачалоПериода И &КонецПериода
	|	И НЕ Данные.ХозяйственнаяОперация В (&ИсключаемыеХозОперацииПоАвансам)
	|	И Данные.Активность
	|	И НЕ &НоваяАрхитектураВзаиморасчетов";
	ТекстыВложенногоЗапроса.Добавить(ТекстЗапроса);
	#КонецОбласти
	
	#Область РасчетыСПоставщиками_Расход_Старые
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	//РежимОтладки""РасчетыСПоставщиками_Расход_Старые"" КАК ИсточникДанных,
	|	НАЧАЛОПЕРИОДА(Данные.Период, МЕСЯЦ) КАК Период,
	|	Данные.Регистратор КАК Регистратор,
	|	Данные.ЗаказПоставщику,
	|	ЛОЖЬ КАК Долгосрочный,
	|	Данные.Валюта,
	|	0,
	|	Данные.ДолгРегл,
	|	0,
	|	0,
	|	0,
	|	ВЫБОР
	|		КОГДА Данные.Регистратор <> Данные.РасчетныйДокумент
	|		ТОГДА Данные.ПредоплатаРегл
	|	ИНАЧЕ 0 КОНЕЦ,
	|	0,
	|	0,
	|	Данные.ХозяйственнаяОперация
	|ИЗ
	|	РегистрНакопления.РасчетыСПоставщикамиПоДокументам КАК Данные
	|ГДЕ
	|	Данные.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	|	И Данные.Период МЕЖДУ &НачалоПериода И &КонецПериода
	|	И Данные.Активность
	|	И НЕ &НоваяАрхитектураВзаиморасчетов";
	ТекстыВложенногоЗапроса.Добавить(ТекстЗапроса);
	#КонецОбласти
	
	#Область РасчетыСПоставщиками_РасходПредоплата_Старые
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	//РежимОтладки""РасчетыСПоставщиками_РасходПредоплата_Старые"" КАК ИсточникДанных,
