	|		КОГДА Данные.ВидПереводаДенежныхСредств В (ЗНАЧЕНИЕ(Перечисление.ВидыПереводовДенежныхСредств.ИнкассацияВБанк), ЗНАЧЕНИЕ(Перечисление.ВидыПереводовДенежныхСредств.ПеречислениеНаДругойСчет), ЗНАЧЕНИЕ(Перечисление.ВидыПереводовДенежныхСредств.ИнкассацияИзБанка), ЗНАЧЕНИЕ(Перечисление.ВидыПереводовДенежныхСредств.ПеремещениеВДругуюКассу))
	|			И Данные.Валюта = ВТВалютыРеглОрганизаций.ВалютаРегламентированногоУчета
	|		ТОГДА ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ПереводыВПути)
	|		КОГДА Данные.ВидПереводаДенежныхСредств В (ЗНАЧЕНИЕ(Перечисление.ВидыПереводовДенежныхСредств.ИнкассацияВБанк), ЗНАЧЕНИЕ(Перечисление.ВидыПереводовДенежныхСредств.ПеречислениеНаДругойСчет), ЗНАЧЕНИЕ(Перечисление.ВидыПереводовДенежныхСредств.ИнкассацияИзБанка), ЗНАЧЕНИЕ(Перечисление.ВидыПереводовДенежныхСредств.ПеремещениеВДругуюКассу))
	|			И Данные.Валюта <> ВТВалютыРеглОрганизаций.ВалютаРегламентированногоУчета
	|		ТОГДА ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ПереводыВПутиВал)
	|		КОГДА Данные.ВидПереводаДенежныхСредств = ЗНАЧЕНИЕ(Перечисление.ВидыПереводовДенежныхСредств.ПриобретениеВалюты)
	|		ТОГДА ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ПриобретениеИностраннойВалюты)
	|		КОГДА Данные.ВидПереводаДенежныхСредств = ЗНАЧЕНИЕ(Перечисление.ВидыПереводовДенежныхСредств.РеализацияВалюты)
	|		ТОГДА ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.РеализацияИностраннойВалюты)
	|		КОГДА Данные.ВидПереводаДенежныхСредств = ЗНАЧЕНИЕ(Перечисление.ВидыПереводовДенежныхСредств.ПоступлениеОтБанкаПоЭквайрингу)
	|		ТОГДА ЕСТЬNULL(НастройкиИсключений.СчетУчета, ЕСТЬNULL(НастройкиПоАналитике.СчетУчета, ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ПустаяСсылка)))
	|	КОНЕЦ,
	|	Данные.Валюта,
	|	Данные.Регистратор,
	|	Данные.СуммаРеглПриход,
	|	Данные.СуммаРеглРасход,
	|	0,
	|	0
	|ИЗ
	|	РегистрНакопления.ДенежныеСредстваВПути.ОстаткиИОбороты(&НачалоПериода, &КонецПериода, Регистратор, , Организация В (&МассивОрганизаций)) КАК Данные
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТВалютыРеглОрганизаций КАК ВТВалютыРеглОрганизаций
	|		ПО Данные.Организация = ВТВалютыРеглОрганизаций.Организация
	|	
	|	ЛЕВОЕ СОЕДИНЕНИЕ ПорядокОтраженияНаСчетахУчетаПоПериодуДействия КАК НастройкиПоАналитике
	|	ПО Данные.ВидПереводаДенежныхСредств = ЗНАЧЕНИЕ(Перечисление.ВидыПереводовДенежныхСредств.ПоступлениеОтБанкаПоЭквайрингу)
	|		И НастройкиПоАналитике.ВидСчета = ЗНАЧЕНИЕ(Перечисление.ВидыСчетовРеглУчета.ПродажиПоЭквайрингу)
	|		И НастройкиПоАналитике.Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
	|		И НастройкиПоАналитике.АналитикаУчета = Данные.Договор
	|		И НастройкиПоАналитике.МестоУчета = НЕОПРЕДЕЛЕНО
	|		И Данные.Период >= НастройкиПоАналитике.НачалоДействия
	|		И Данные.Период < НастройкиПоАналитике.ОкончаниеДействия
	|	
	|	ЛЕВОЕ СОЕДИНЕНИЕ ПорядокОтраженияНаСчетахУчетаПоПериодуДействия КАК НастройкиИсключений
	|	ПО Данные.ВидПереводаДенежныхСредств = ЗНАЧЕНИЕ(Перечисление.ВидыПереводовДенежныхСредств.ПоступлениеОтБанкаПоЭквайрингу)
	|		И Данные.Договор = ЗНАЧЕНИЕ(Справочник.ДоговорыЭквайринга.ПустаяСсылка)
	|		И НастройкиИсключений.ВидСчета = ЗНАЧЕНИЕ(Перечисление.ВидыСчетовРеглУчета.ПродажиПоЭквайрингу)
	|		И НастройкиИсключений.Организация = Данные.Организация
	|		И НастройкиИсключений.АналитикаУчета = Данные.Договор
	|		И НастройкиИсключений.МестоУчета = НЕОПРЕДЕЛЕНО
	|		И Данные.Период >= НастройкиИсключений.НачалоДействия
	|		И Данные.Период < НастройкиИсключений.ОкончаниеДействия";
	ТекстыВложенногоЗапроса.Добавить(ТекстЗапроса);
	#КонецОбласти
	
	#Область ДенежныеСредстваБУ
	ТекстЗапроса =
	"ВЫБРАТЬ 
	|	//РежимОтладки""ДенежныеСредстваБУ"" КАК ИсточникДанных,
