КонецФункции

Функция ТекстЗапросаРасчетыСКонтрагентами(РежимОтладкиПоИсточникам)
	
	МассивТекстовЗапроса = Новый Массив;
	
	МассивТекстовЗапроса.Добавить(ТекстЗапросаВТДолгосрочныеКакКраткосрочные());
	
	МассивТекстовЗапроса.Добавить(РасчетыСПоставщиками(Истина, Ложь, РежимОтладкиПоИсточникам));
	МассивТекстовЗапроса.Добавить(РасчетыПоКорректировкамРеализаций());
	МассивТекстовЗапроса.Добавить(РасчетыСКлиентами(Истина, Ложь, РежимОтладкиПоИсточникам));
	МассивТекстовЗапроса.Добавить(РасчетыПоКредитамДепозитам(Истина, Ложь));
	МассивТекстовЗапроса.Добавить(РасчетыПоЛизингу(Истина, Ложь));
	МассивТекстовЗапроса.Добавить(НеотфактурованныеПоставки(Истина, Ложь));
	
	МассивВидовСчетов = СтрРазделить("РасчетыСПоставщиками,АвансыВыданные,РасчетыСКлиентами,АвансыПолученные,НеотфактурованныеПоставки", ",");
	СписокВидовСчетов = РегистрыСведений.ПорядокОтраженияНаСчетахУчета.СписокСчетовУчетаПоРазделуУчета("РасчетыСКредиторами");
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(МассивВидовСчетов, ОбщегоНазначенияКлиентСервер.ОтмеченныеЭлементы(СписокВидовСчетов));
	СписокВидовСчетов = РегистрыСведений.ПорядокОтраженияНаСчетахУчета.СписокСчетовУчетаПоРазделуУчета("РасчетыСДебиторами");
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(МассивВидовСчетов, ОбщегоНазначенияКлиентСервер.ОтмеченныеЭлементы(СписокВидовСчетов));
	СписокВидовСчетов = РегистрыСведений.ПорядокОтраженияНаСчетахУчета.СписокСчетовУчетаПоРазделуУчета("РасчетыСАрендодателями");
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(МассивВидовСчетов, ОбщегоНазначенияКлиентСервер.ОтмеченныеЭлементы(СписокВидовСчетов));
	ТекстЗапроса = РегистрыСведений.ПорядокОтраженияНаСчетахУчета.ТекстВременнойТаблицыПорядкаОтраженияПоПериодуДействия(МассивВидовСчетов);
	МассивТекстовЗапроса.Добавить(ТекстЗапроса);
	
	МассивТекстовЗапроса.Добавить(РасчетыСПоставщикамиОУ(Истина, Ложь));
	МассивТекстовЗапроса.Добавить(РасчетыСКлиентамиОУ(Истина, Ложь));
	МассивТекстовЗапроса.Добавить(РасчетыПоКредитамДепозитамОУ(Истина, Ложь));
	МассивТекстовЗапроса.Добавить(РасчетыПоЛизингуОУ(Истина, Ложь));
	МассивТекстовЗапроса.Добавить(НеотфактурованныеПоставкиОУ(Истина, Ложь));
	МассивТекстовЗапроса.Добавить("УНИЧТОЖИТЬ ПорядокОтраженияНаСчетахУчетаПоПериодуДействия");
	
	ТекстЗапроса = РегистрыСведений.ПорядокОтраженияНаСчетахУчета.ТекстЗапросаДанныеПрочихРасчетов(Истина);
	МассивТекстовЗапроса.Добавить(ТекстЗапроса);
	МассивВидовСчетов = СтрРазделить("НДСАвансыПолученные,НДСАвансыВыданные,РезервыПоСомнительнымДолгам", ",");
	ТекстЗапроса = РегистрыСведений.ПорядокОтраженияНаСчетахУчета.ТекстВременнойТаблицыПорядкаОтраженияПоПериодуДействия(МассивВидовСчетов);
	МассивТекстовЗапроса.Добавить(ТекстЗапроса);
	МассивТекстовЗапроса.Добавить(ПрочиеРасчеты(Ложь));
	
	#Область РасчетыСПартнерамиБУ
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	""Поставщики"" КАК РазделУчета,
	|	ХозрасчетныйОстаткиИОбороты.Организация КАК Организация,
	|	ХозрасчетныйОстаткиИОбороты.Подразделение КАК Подразделение,
	|	ХозрасчетныйОстаткиИОбороты.Счет КАК Счет,
	|	ХозрасчетныйОстаткиИОбороты.Субконто1 КАК Субконто1,
	|	ХозрасчетныйОстаткиИОбороты.СуммаНачальныйОстаток КАК СуммаНачальныйОстаток,
	|	ХозрасчетныйОстаткиИОбороты.СуммаОборотДт КАК СуммаОборотДт,
	|	ХозрасчетныйОстаткиИОбороты.СуммаОборотКт КАК СуммаОборотКт,
	|	ХозрасчетныйОстаткиИОбороты.СуммаКонечныйОстаток КАК СуммаКонечныйОстаток
	|ПОМЕСТИТЬ ВТ_РасчетыСКонтрагентамиРегл
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.ОстаткиИОбороты(&НачалоПериода, &КонецПериода, , , Счет В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.РасчетыСПоставщикамиИПодрядчиками)), , Организация В (&МассивОрганизаций)) КАК ХозрасчетныйОстаткиИОбороты
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
