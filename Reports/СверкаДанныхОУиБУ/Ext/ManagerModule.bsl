Функция РасчетыСПоставщикамиОУ(ПолучатьОстатки, ПолучатьРегистраторы)
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	Данные.Регистратор КАК Регистратор,
	|	Данные.ОбъектРасчетов КАК ОбъектРасчетов,
	|	Данные.Организация КАК Организация,
	|	Данные.Контрагент КАК Контрагент,
	|	МАКСИМУМ(ВЫБОР
	|		КОГДА ЕСТЬNULL(НастройкиПоОрганизации.ВидСчета, ЕСТЬNULL(НастройкиПоАналитике.ВидСчета, НЕОПРЕДЕЛЕНО)) = ЗНАЧЕНИЕ(Перечисление.ВидыСчетовРеглУчета.РасчетыСПоставщиками)
	|		ТОГДА ЕСТЬNULL(НастройкиПоОрганизации.СчетУчета, ЕСТЬNULL(НастройкиПоАналитике.СчетУчета, &ПустойСчет))
	|		ИНАЧЕ &ПустойСчет
	|	КОНЕЦ) КАК СчетУчетаРасчетов,
	|	ВЫБОР
	|		КОГДА Данные.РасчетыПоПретензиям
	|			ТОГДА МАКСИМУМ(ВЫБОР
	|					КОГДА ЕСТЬNULL(НастройкиПоОрганизации.ВидСчета, ЕСТЬNULL(НастройкиПоАналитике.ВидСчета, НЕОПРЕДЕЛЕНО)) = ЗНАЧЕНИЕ(Перечисление.ВидыСчетовРеглУчета.РасчетыСПоставщиками)
	|					ТОГДА ЕСТЬNULL(НастройкиПоОрганизации.СчетУчета, ЕСТЬNULL(НастройкиПоАналитике.СчетУчета, &ПустойСчет))
	|					ИНАЧЕ &ПустойСчет
	|				КОНЕЦ)
	|		ИНАЧЕ МАКСИМУМ(ВЫБОР
	|					КОГДА ЕСТЬNULL(НастройкиПоОрганизации.ВидСчета, ЕСТЬNULL(НастройкиПоАналитике.ВидСчета, НЕОПРЕДЕЛЕНО)) = ЗНАЧЕНИЕ(Перечисление.ВидыСчетовРеглУчета.АвансыВыданные)
	|					ТОГДА ЕСТЬNULL(НастройкиПоОрганизации.СчетУчета, ЕСТЬNULL(НастройкиПоАналитике.СчетУчета, &ПустойСчет))
	|					ИНАЧЕ &ПустойСчет
	|				КОНЕЦ)
	|	КОНЕЦ КАК СчетУчетаАванса,
	|	Данные.Подразделение КАК Подразделение,
	|	Данные.ГруппаФинансовогоУчета КАК ГруппаФинансовогоУчета,
	|	(Данные.ДолгРеглНачальныйОстаток) КАК ДолгРеглНачальныйОстаток,
	|	(Данные.ДолгРеглПриход) КАК ДолгРеглПриход,
	|	(Данные.ДолгРеглРасход) КАК ДолгРеглРасход,
	|	(Данные.ДолгРеглКонечныйОстаток) КАК ДолгРеглКонечныйОстаток,
	|	(Данные.ПредоплатаРеглНачальныйОстаток) КАК ПредоплатаРеглНачальныйОстаток,
	|	(Данные.ПредоплатаРеглПриход) КАК ПредоплатаРеглПриход,
	|	(Данные.ПредоплатаРеглРасход) КАК ПредоплатаРеглРасход,
	|	(Данные.ПредоплатаРеглКонечныйОстаток) КАК ПредоплатаРеглКонечныйОстаток
	|ПОМЕСТИТЬ ВТ_РасчетыСПоставщиками
	|ИЗ
	|	ВТ_РасчетыСПоставщикамиРег КАК Данные
	|	ЛЕВОЕ СОЕДИНЕНИЕ ПорядокОтраженияНаСчетахУчетаПоПериодуДействия КАК НастройкиПоОрганизации
	|	ПО (НастройкиПоОрганизации.ВидСчета В (ЗНАЧЕНИЕ(Перечисление.ВидыСчетовРеглУчета.РасчетыСПоставщиками), ЗНАЧЕНИЕ(Перечисление.ВидыСчетовРеглУчета.АвансыВыданные)))
	|		И (НастройкиПоОрганизации.Организация = Данные.Организация)
	|		И (НастройкиПоОрганизации.АналитикаУчета = Данные.ГруппаФинансовогоУчета)
	|		И (НастройкиПоОрганизации.МестоУчета = НЕОПРЕДЕЛЕНО)
	|		И (НастройкиПоОрганизации.Долгосрочный = Данные.Долгосрочный)
	|		И Данные.Период >= НастройкиПоОрганизации.НачалоДействия
	|		И Данные.Период < НастройкиПоОрганизации.ОкончаниеДействия
	|	ЛЕВОЕ СОЕДИНЕНИЕ ПорядокОтраженияНаСчетахУчетаПоПериодуДействия КАК НастройкиПоАналитике
	|	ПО (НастройкиПоАналитике.ВидСчета В (ЗНАЧЕНИЕ(Перечисление.ВидыСчетовРеглУчета.РасчетыСПоставщиками), ЗНАЧЕНИЕ(Перечисление.ВидыСчетовРеглУчета.АвансыВыданные)))
	|		И (НастройкиПоАналитике.Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка))
	|		И (НастройкиПоАналитике.АналитикаУчета = Данные.ГруппаФинансовогоУчета)
	|		И (НастройкиПоАналитике.МестоУчета = НЕОПРЕДЕЛЕНО)
	|		И (НастройкиПоАналитике.Долгосрочный = Данные.Долгосрочный)
	|		И Данные.Период >= НастройкиПоАналитике.НачалоДействия
	|		И Данные.Период < НастройкиПоАналитике.ОкончаниеДействия
	|
	|СГРУППИРОВАТЬ ПО
	|	Данные.Регистратор,
	|	Данные.ОбъектРасчетов,
	|	Данные.Организация,
	|	Данные.РасчетыПоПретензиям,
	|	Данные.Контрагент,
	|	Данные.Подразделение,
	|	Данные.ГруппаФинансовогоУчета,
	|	(Данные.ДолгРеглНачальныйОстаток),
	|	(Данные.ДолгРеглПриход),
	|	(Данные.ДолгРеглРасход),
	|	(Данные.ДолгРеглКонечныйОстаток),
	|	(Данные.ПредоплатаРеглНачальныйОстаток),
	|	(Данные.ПредоплатаРеглПриход),
	|	(Данные.ПредоплатаРеглРасход),
	|	(Данные.ПредоплатаРеглКонечныйОстаток)";
	
	Если Не ПолучатьРегистраторы Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Данные.Регистратор", "НЕОПРЕДЕЛЕНО");
	КонецЕсли;
	Если Не ПолучатьОстатки Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Данные.ДолгРеглНачальныйОстаток", "0");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Данные.ДолгРеглКонечныйОстаток", "0");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Данные.ПредоплатаРеглНачальныйОстаток", "0");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Данные.ПредоплатаРеглНачальныйОстаток", "0");
	КонецЕсли;
	
	Возврат ТекстЗапроса;
	
