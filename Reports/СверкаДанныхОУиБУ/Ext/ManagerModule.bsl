	|	ОбъектыРасчетов.Объект ССЫЛКА Документ.ВозвратТоваровПоставщику ИЛИ ОбъектыРасчетов.Объект ССЫЛКА Документ.ВозвратТоваровМеждуОрганизациями,
	|	ЛОЖЬ,
	|	СУММА(0),
	|	СУММА(ВЫБОР
	|		КОГДА Данные.ТипСуммы = ЗНАЧЕНИЕ(Перечисление.ТипыСуммЗадолженности.ДолгПоставщику)
	|		ТОГДА Данные.СуммаРеглОборот
	|		ИНАЧЕ 0
	|	КОНЕЦ),
	|	СУММА(ВЫБОР
	|		КОГДА Данные.ТипСуммы = ЗНАЧЕНИЕ(Перечисление.ТипыСуммЗадолженности.ДолгПоставщику)
	|		ТОГДА Данные.СуммаРеглОборот
	|		ИНАЧЕ 0
	|	КОНЕЦ),
	|	СУММА(0),
	|	СУММА(0),
	|	СУММА(ВЫБОР
	|		КОГДА Данные.ТипСуммы = ЗНАЧЕНИЕ(Перечисление.ТипыСуммЗадолженности.АвансВыданный)
	|		ТОГДА Данные.СуммаРеглОборот
	|		ИНАЧЕ 0
	|	КОНЕЦ),
	|	СУММА(ВЫБОР
	|		КОГДА Данные.ТипСуммы = ЗНАЧЕНИЕ(Перечисление.ТипыСуммЗадолженности.АвансВыданный)
	|		ТОГДА Данные.СуммаРеглОборот
	|		ИНАЧЕ 0
	|	КОНЕЦ),
	|	СУММА(0)
	|ИЗ
	|	РегистрНакопления.ДвиженияКонтрагентКонтрагент.Обороты(&НачалоПериода, &КонецПериода, Регистратор,
	|		ХозяйственнаяОперация = ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ВзаимозачетЗадолженности)
	|			И ТипСуммы В (ЗНАЧЕНИЕ(Перечисление.ТипыСуммЗадолженности.АвансВыданный), ЗНАЧЕНИЕ(Перечисление.ТипыСуммЗадолженности.ДолгПоставщику))
	|			И Организация В (&МассивОрганизаций)) КАК Данные
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ОбъектыРасчетов КАК ОбъектыРасчетов
	|	ПО ОбъектыРасчетов.Ссылка = Данные.ОбъектРасчетов
	|ГДЕ
	|	Данные.Организация <> ОбъектыРасчетов.Организация
	|	И НЕ &НоваяАрхитектураВзаиморасчетов
	|
	|СГРУППИРОВАТЬ ПО
	|	Данные.Период,
	|	Данные.Регистратор,
	|	Данные.Организация,
	|	Данные.Контрагент,
	|	Данные.Подразделение,
	|	ОбъектыРасчетов.Ссылка,
	|	ОбъектыРасчетов.ГруппаФинансовогоУчета,
	|	ОбъектыРасчетов.Объект ССЫЛКА Документ.ВозвратТоваровПоставщику ИЛИ ОбъектыРасчетов.Объект ССЫЛКА Документ.ВозвратТоваровМеждуОрганизациями";
	ТекстыВложенногоЗапроса.Добавить(ТекстЗапроса);
	#КонецОбласти
	
	ТекстЗапроса = СтрСоединить(ТекстыВложенногоЗапроса, ОбщегоНазначенияУТ.РазделительЗапросовВОбъединении());
	
	Если Не ПолучатьРегистраторы Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Данные.Регистратор КАК", "НЕОПРЕДЕЛЕНО КАК");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Данные.Регистратор,", "НЕОПРЕДЕЛЕНО,");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Расчеты.ДокументРегистратор КАК Регистратор", "НЕОПРЕДЕЛЕНО КАК Регистратор");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, ", Регистратор,", ", Месяц,");
	КонецЕсли;
	Если Не ПолучатьОстатки Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Данные.ДолгРеглНачальныйОстаток", "0");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Данные.ДолгРеглКонечныйОстаток", "0");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Данные.ПредоплатаРеглНачальныйОстаток", "0");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Данные.ПредоплатаРеглНачальныйОстаток", "0");
	КонецЕсли;
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция РасчетыПоКорректировкамРеализаций()
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	НАЧАЛОПЕРИОДА(Расчеты.Период, МЕСЯЦ) КАК Период,
	|	Расчеты.ОбъектРасчетов КАК ОбъектРасчетов,
	|	РАЗНОСТЬДАТ(Расчеты.Период, Расчеты.ДатаПлановогоПогашения, МЕСЯЦ) >= ЕСТЬNULL(УчетнаяПолитикаОрганизаций.МесяцыДолгосрочнойЗадолженности, 999) КАК Долгосрочный,
	|	Расчеты.Валюта КАК Валюта,
	|	ВЫБОР
	|		КОГДА Операция.ВидКорректировки = ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.РеализацияПерепоставленногоТовара)
	|		ТОГДА ЛОЖЬ
	|		КОГДА ЕСТЬNULL(ДанныеДокументаОснования.ХозяйственнаяОперация, НЕОПРЕДЕЛЕНО) = ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.РеализацияБезПереходаПраваСобственности)
	|		ТОГДА НАЧАЛОПЕРИОДА(Операция.Дата, ГОД) <> НАЧАЛОПЕРИОДА(ЕСТЬNULL(ДанныеДокументаОснования.ДатаПереходаПраваСобственности, Операция.Дата), ГОД)
	|		ИНАЧЕ НАЧАЛОПЕРИОДА(Операция.Дата, ГОД) <> НАЧАЛОПЕРИОДА(ЕСТЬNULL(ДанныеДокументаОснования.Дата, Операция.Дата), ГОД)
	|	КОНЕЦ КАК КорректировкаПрошлыхПериодов,
	|	ВЫБОР
	|		КОГДА Расчеты.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|		ТОГДА Расчеты.ДолгРегл
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК ДолгРеглПриход,
	|	ВЫБОР
	|		КОГДА Расчеты.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	|		ТОГДА Расчеты.ДолгРегл
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК ДолгРеглРасход,
	|	ВЫБОР
	|		КОГДА Расчеты.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	|		ТОГДА Расчеты.ПредоплатаРегл
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК ПредоплатаРеглПриход,
	|	ВЫБОР
	|		КОГДА Расчеты.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|		ТОГДА Расчеты.ПредоплатаРегл
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК ПредоплатаРеглРасход,
	|	Расчеты.ДокументРегистратор КАК Регистратор
	|ПОМЕСТИТЬ ВТ_РасчетыПоКорректировкаРеализаций
	|ИЗ
	|	РегистрНакопления.РасчетыСКлиентамиПоСрокам КАК Расчеты
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.КорректировкаРеализации КАК Операция
	|	ПО Расчеты.ДокументРегистратор = Операция.Ссылка
	|	ЛЕВОЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг КАК ДанныеДокументаОснования
	|	ПО (Операция.ДокументОснование = ДанныеДокументаОснования.Ссылка)
	|	ЛЕВОЕ СОЕДИНЕНИЕ ВТУчетнаяПолитикаОрганизацийПоПериодам КАК УчетнаяПолитикаОрганизаций
	|	ПО Расчеты.АналитикаУчетаПоПартнерам.Организация = УчетнаяПолитикаОрганизаций.Организация
	|		И Расчеты.Период >= УчетнаяПолитикаОрганизаций.НачалоДействия
	|		И Расчеты.Период <= УчетнаяПолитикаОрганизаций.ОкончаниеДействия
	|		И (УчетнаяПолитикаОрганизаций.ДолгосрочныеАктивыОбязательства)
	|ГДЕ
	|	Расчеты.Период МЕЖДУ &НачалоПериода И &КонецПериода
	|	И Расчеты.Активность
	|	И &НоваяАрхитектураВзаиморасчетов";
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция РасчетыСКлиентами(ПолучатьОстатки, ПолучатьРегистраторы, РежимОтладкиПоИсточникам)
	
	ТекстыВложенногоЗапроса = Новый Массив;
	
	#Область ВТ_РасчетыСКлиентамиРегПредварительная
	ТекстЗапроса =
	"ВЫБРАТЬ ПЕРВЫЕ 0
	|	//РежимОтладки""Инициализация"" КАК ИсточникДанных,
	|	ДАТАВРЕМЯ(1,1,1) КАК Период,
	|	НЕОПРЕДЕЛЕНО КАК Регистратор,
	|	НЕОПРЕДЕЛЕНО КАК ОбъектРасчетов,
	|	ЛОЖЬ КАК Долгосрочный,
	|	ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка) КАК Валюта,
	|	0 КАК ДолгРеглПриход,
	|	0 КАК ДолгРеглРасход,
	|	0 КАК ДолгРеглНачальныйОстаток,
	|	0 КАК ДолгРеглКонечныйОстаток,
	|	0 КАК ПредоплатаРеглПриход,
	|	0 КАК ПредоплатаРеглРасход,
	|	0 КАК ПредоплатаРеглНачальныйОстаток,
	|	0 КАК ПредоплатаРеглКонечныйОстаток
	|ПОМЕСТИТЬ ВТ_РасчетыСКлиентамиРегПредварительная";
	Если РежимОтладкиПоИсточникам Тогда
		ТекстыВложенногоЗапроса.Добавить(ТекстЗапроса);
	КонецЕсли;
	#КонецОбласти
	
	#Область РасчетыСКлиентами_Приход_Старые
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	//РежимОтладки""РасчетыСКлиентами_Приход_Старые"" КАК ИсточникДанных,
	|	НАЧАЛОПЕРИОДА(Данные.Период, МЕСЯЦ) КАК Период,
	|	Данные.Регистратор КАК Регистратор,
	|	Данные.ЗаказКлиента КАК ОбъектРасчетов,
	|	ЛОЖЬ КАК Долгосрочный,
	|	Данные.Валюта КАК Валюта,
	|	Данные.ДолгРегл КАК ДолгРеглПриход,
	|	0 КАК ДолгРеглРасход,
	|	0 КАК ДолгРеглНачальныйОстаток,
	|	0 КАК ДолгРеглКонечныйОстаток,
	|	ВЫБОР
	|		КОГДА Данные.Регистратор <> Данные.РасчетныйДокумент
	|		ТОГДА Данные.ПредоплатаРегл
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК ПредоплатаРеглПриход,
	|	0 КАК ПредоплатаРеглРасход,
	|	0 КАК ПредоплатаРеглНачальныйОстаток,
	|	0 КАК ПредоплатаРеглКонечныйОстаток
	|ИЗ
	|	РегистрНакопления.РасчетыСКлиентамиПоДокументам КАК Данные
	|ГДЕ
	|	Данные.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|	И Данные.Период МЕЖДУ &НачалоПериода И &КонецПериода
	|	И Данные.Активность
	|	И НЕ &НоваяАрхитектураВзаиморасчетов";
	ТекстыВложенногоЗапроса.Добавить(ТекстЗапроса);
	#КонецОбласти
	
	#Область РасчетыСКлиентами_Расход_Старые
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	//РежимОтладки""РасчетыСКлиентами_Расход_Старые"" КАК ИсточникДанных,
	|	НАЧАЛОПЕРИОДА(Данные.Период, МЕСЯЦ) КАК Период,
	|	Данные.Регистратор КАК Регистратор,
	|	Данные.ЗаказКлиента,
	|	ЛОЖЬ КАК Долгосрочный,
	|	Данные.Валюта,
	|	ВЫБОР
	|		КОГДА Данные.ДолгРегл < 0
	|		ТОГДА -Данные.ДолгРегл
	|		ИНАЧЕ 0
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА Данные.ДолгРегл < 0
	|		ТОГДА 0
	|		ИНАЧЕ Данные.ДолгРегл
	|	КОНЕЦ,
	|	0,
	|	0,
	|	ВЫБОР
	|		КОГДА Данные.ПредоплатаРегл < 0
	|		ТОГДА -Данные.ПредоплатаРегл
	|		ИНАЧЕ 0
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА Данные.ПредоплатаРегл < 0
	|		ТОГДА 0
	|		ИНАЧЕ Данные.ПредоплатаРегл
	|	КОНЕЦ,
	|	0,
	|	0
	|ИЗ
	|	РегистрНакопления.РасчетыСКлиентамиПоДокументам КАК Данные
	|ГДЕ
	|	НЕ(Данные.Регистратор ССЫЛКА Документ.КорректировкаРеализации
	|		ИЛИ Данные.Регистратор ССЫЛКА Документ.ВозвратТоваровОтКлиента
	|		ИЛИ Данные.Регистратор ССЫЛКА Документ.ВозвратТоваровМеждуОрганизациями)
	|	И Данные.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	|	И Данные.Период МЕЖДУ &НачалоПериода И &КонецПериода
	|	И НЕ Данные.ХозяйственнаяОперация В (&ИсключаемыеХозОперацииПоАвансам)
	|	И Данные.Активность
	|	И НЕ &НоваяАрхитектураВзаиморасчетов";
	ТекстыВложенногоЗапроса.Добавить(ТекстЗапроса);
	#КонецОбласти
	
	#Область РасчетыСКлиентами_ПриходПредоплата_Старые
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	//РежимОтладки""РасчетыСКлиентами_ПриходПредоплата_Старые"" КАК ИсточникДанных,
	|	НАЧАЛОПЕРИОДА(Данные.Период, МЕСЯЦ) КАК Период,
	|	Данные.Регистратор КАК Регистратор,
	|	Данные.ЗаказКлиента,
	|	ЛОЖЬ КАК Долгосрочный,
	|	Данные.Валюта,
	|	Данные.ПредоплатаРегл,
	|	Данные.ПредоплатаРегл,
	|	0,
	|	0,
	|	0,
	|	0,
	|	0,
	|	0
	|ИЗ
	|	РегистрНакопления.РасчетыСКлиентамиПоДокументам КАК Данные
	|ГДЕ
	|	Данные.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|	И Данные.Период МЕЖДУ &НачалоПериода И &КонецПериода
	|	И Данные.Регистратор = Данные.РасчетныйДокумент
	|	И Данные.Активность
	|	И Данные.ПредоплатаРегл <> 0
	|	И НЕ &НоваяАрхитектураВзаиморасчетов";
	ТекстыВложенногоЗапроса.Добавить(ТекстЗапроса);
	#КонецОбласти
	
	#Область РасчетыСКлиентами_РасходПредоплата_Старые
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	//РежимОтладки""РасчетыСКлиентами_РасходПредоплата_Старые"" КАК ИсточникДанных,
	|	НАЧАЛОПЕРИОДА(Данные.Период, МЕСЯЦ) КАК Период,
	|	Данные.Регистратор КАК Регистратор,
	|	Данные.ЗаказКлиента,
	|	ЛОЖЬ КАК Долгосрочный,
	|	Данные.Валюта,
	|	-Данные.ПредоплатаРегл - Данные.ДолгРегл,
	|	0,
	|	0,
	|	0,
	|	-Данные.ПредоплатаРегл,
	|	0,
	|	0,
	|	Данные.ПредоплатаРегл
	|ИЗ
	|	РегистрНакопления.РасчетыСКлиентамиПоДокументам КАК Данные
	|ГДЕ
	|	(Данные.Регистратор ССЫЛКА Документ.КорректировкаРеализации
	|		ИЛИ Данные.Регистратор ССЫЛКА Документ.ВозвратТоваровОтКлиента
	|		ИЛИ Данные.Регистратор ССЫЛКА Документ.ВозвратТоваровМеждуОрганизациями)
	|	И Данные.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	|	И Данные.Период МЕЖДУ &НачалоПериода И &КонецПериода
	|	И Данные.Активность
	|	И НЕ &НоваяАрхитектураВзаиморасчетов";
	ТекстыВложенногоЗапроса.Добавить(ТекстЗапроса);
	#КонецОбласти
	
	#Область РасчетыСКлиентами_ВозвратПредоплата_Старые
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	//РежимОтладки""РасчетыСКлиентами_ВозвратПредоплата_Старые"" КАК ИсточникДанных,
	|	НАЧАЛОПЕРИОДА(Данные.Период, МЕСЯЦ) КАК Период,
	|	Данные.Регистратор КАК Регистратор,
	|	Данные.ЗаказКлиента,
	|	ЛОЖЬ КАК Долгосрочный,
	|	Данные.Валюта,
	|	0,
	|	-Данные.ПредоплатаРегл,
	|	0,
	|	-Данные.ПредоплатаРегл,
	|	0,
	|	0,
	|	0,
	|	0
	|ИЗ
	|	РегистрНакопления.РасчетыСКлиентамиПоДокументам КАК Данные
	|ГДЕ
	|	(Данные.Регистратор ССЫЛКА Документ.КорректировкаРеализации
