	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ДоступныеСчетаУчетаРасходов.СчетаРасходов,
		РеглУчетВыборкиСерверПовтИсп.СчетаРезервыПодСнижениеСтоимостиНезавершенногоПроизводства());
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ДоступныеСчетаУчетаРасходов.СчетаРасходов,
