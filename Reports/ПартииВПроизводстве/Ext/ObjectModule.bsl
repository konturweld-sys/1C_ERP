#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область СлужебныйПрограммныйИнтерфейс	
	
// Настройки общей формы отчета подсистемы "Варианты отчетов".
//
// Параметры:
//   Форма - ФормаКлиентскогоПриложения - Форма отчета.
//   КлючВарианта - Строка - Имя предопределенного варианта отчета или уникальный идентификатор пользовательского.
//   Настройки - См. ОтчетыКлиентСервер.ПолучитьНастройкиОтчетаПоУмолчанию
//
Процедура ОпределитьНастройкиФормы(Форма, КлючВарианта, Настройки) Экспорт
	Настройки.События.ПриСозданииНаСервере = Истина;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)
	
	СостоянияЭтапов = СхемаКомпоновкиДанных.НаборыДанных.Найти("СостоянияЭтапов");
	
	ТекстЗапроса = СостоянияЭтапов.Запрос;
	
	ТекстЗапроса = СтрЗаменить(
		ТекстЗапроса,
		"&ПредставлениеЭтапа",
		Документы.ЭтапПроизводства2_2.ТекстЗапросаПредставлениеЭтапа("Этапы"));
	
	ТекстЗапроса = СтрЗаменить(
		ТекстЗапроса,
		"&КоэффициентУпаковкиПлан",
		Справочники.УпаковкиЕдиницыИзмерения.ТекстЗапросаКоэффициентаУпаковки(
			"Этапы.УпаковкаПлан",
			"Этапы.ПартияПроизводства.ОсновноеИзделиеНоменклатура"));
			
	ТекстЗапроса = СтрЗаменить(
		ТекстЗапроса,
		"&КоэффициентУпаковкиФакт",
		Справочники.УпаковкиЕдиницыИзмерения.ТекстЗапросаКоэффициентаУпаковки(
			"Этапы.УпаковкаФакт",
			"Этапы.ПартияПроизводства.ОсновноеИзделиеНоменклатура"));
	
	ПоляЗапроса = РедакторПроизводственногоПроцесса.ПоляЗапросаПараметрыТехпроцессаЭтапа("Этапы");
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТипТехнологическогоПроцесса", ПоляЗапроса.ТипТехнологическогоПроцесса);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТехнологическийПроцесс", ПоляЗапроса.ТехнологическийПроцесс);
	
	Если УправлениеПроизводствомПовтИсп.ИспользуетсяГрафикПроизводства()
		И ПолучитьФункциональнуюОпцию("ДинамическаяСтруктураЗаказовНаПроизводство") Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,
			"&ЕстьНормативныйГрафик",
			"ЛОЖЬ");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,
			"&НормативныйГрафикНачало",
			"ДАТАВРЕМЯ(1,1,1)");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,
			"&НормативныйГрафикОкончание",
			"ДАТАВРЕМЯ(1,1,1)");
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,
			"&ЕстьНормативныйГрафик",
			"НормативныйГрафикПроизводства.ЭтапПроизводства ЕСТЬ НЕ NULL");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,
			"&НормативныйГрафикНачало",
			"ДОБАВИТЬКДАТЕ(Этапы.Распоряжение.НачатьНеРанее, СЕКУНДА, НормативныйГрафикПроизводства.ДлительностьДоЗапуска)");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,
			"&НормативныйГрафикОкончание",
			"ДОБАВИТЬКДАТЕ(Этапы.Распоряжение.НачатьНеРанее, СЕКУНДА, НормативныйГрафикПроизводства.ДлительностьДоЗапуска + НормативныйГрафикПроизводства.Ресурсоемкость)");
	КонецЕсли;
	
	УправлениеПроизводством.ПодстановкаАктуальногоРегистраГрафика(ТекстЗапроса);
	
	СостоянияЭтапов.Запрос = ТекстЗапроса;
		
	Если НЕ ПолучитьФункциональнуюОпцию("ИспользоватьПооперационноеУправление") Тогда
		КомпоновкаДанныхСервер.УдалитьВыбранноеПолеИзВсехНастроекОтчета(КомпоновщикНастроек, "Операция");
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#КонецЕсли
