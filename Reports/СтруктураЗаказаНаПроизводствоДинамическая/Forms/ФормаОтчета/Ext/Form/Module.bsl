&НаСервере
Процедура ЗаполнитьРеквизитыПоЗаказу()
	
	Если Заказ.Пустая() Тогда
		ТипПроцесса = Неопределено;
		СтатусЗаказа = Неопределено;
		ПредставлениеЗаказа = "";
	Иначе
		ДанныеЗаказа = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Заказ,
			"Номер, Дата, ТипПроизводственногоПроцесса, Статус");
		
		ТипПроцесса = ДанныеЗаказа.ТипПроизводственногоПроцесса;
		СтатусЗаказа = ДанныеЗаказа.Статус;
		ПредставлениеЗаказа = Документы.ЗаказНаПроизводство2_2.ПредставлениеЗаказа(Заказ, "", ДанныеЗаказа);
	КонецЕсли;
	
КонецПроцедуры

// Настроить зависимые элементы формы.
// 
// Параметры:
//  Форма - ФормаКлиентскогоПриложения
//  СписокРеквизитов - Строка - Список реквизитов
//
&НаКлиентеНаСервереБезКонтекста
Процедура НастроитьЗависимыеЭлементыФормы(Форма, СписокРеквизитов = "")
	
	Элементы = Форма.Элементы; // ВсеЭлементыФормы
	
	Инициализация = ПустаяСтрока(СписокРеквизитов);
	СтруктураРеквизитов = Новый Структура(СписокРеквизитов);
	
	Если Инициализация
		ИЛИ СтруктураРеквизитов.Свойство("Заказ") Тогда
		
		Элементы.ПоказыватьВыпускиДетализация.Видимость = 
			Форма.ТипПроцесса = ПредопределенноеЗначение("Перечисление.ТипыПроизводственныхПроцессов.ВыполнениеРемонтныхРабот")
			ИЛИ Форма.ТипПроцесса = ПредопределенноеЗначение("Перечисление.ТипыПроизводственныхПроцессов.Разборка");
		
		ДатыГрафикаВидимость = 
			Форма.ТипПроцесса <> ПредопределенноеЗначение("Перечисление.ТипыПроизводственныхПроцессов.Разборка")
			ИЛИ Форма.ИспользуетсяГрафикПроизводства;
		Элементы.Начало.Видимость = ДатыГрафикаВидимость;
		Элементы.Окончание.Видимость = ДатыГрафикаВидимость;
		
		Если Форма.ЭтоРежимРасшифровки Тогда
			Форма.Заголовок = СтрШаблон(НСтр("ru = 'Расшифровка строки структуры заказа %1';
											|en = 'Drill down the line of the %1 order structure'"), Форма.ПредставлениеЗаказа);
		ИначеЕсли Форма.Заказ.Пустая() Тогда
			Форма.Заголовок = НСтр("ru = 'Структура заказа на производство';
									|en = 'Production order structure'");
		Иначе
			Форма.Заголовок = СтрШаблон(НСтр("ru = 'Структура заказа %1';
											|en = '%1 order structure'"), Форма.ПредставлениеЗаказа);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДействияПриИзмененииПометкиДетализации()
	
	УстановитьПометкиКнопокДетализации();	
	ОчиститьСообщения();
	
	Если НЕ ПроверитьЗаполнение() Тогда
		Возврат;
	КонецЕсли;
	
	СохранитьНастройки();
	
	Действие = "Заполнить";
	ОжидатьРасчетСтруктурыИВыполнитьДействие();

КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()

	УсловноеОформление.Элементы.Очистить();
	
	ТипыСтрокПервогоУровня = Новый СписокЗначений;
	ТипыСтрокПервогоУровня.Добавить(ТипСтрокиИзделие());
	ТипыСтрокПервогоУровня.Добавить(ТипСтрокиНоменклатураРасшифровки());
	
	ТипыСтрокЭтапы = Новый СписокЗначений();
	ТипыСтрокЭтапы.Добавить(ТипСтрокиЭтапДокумент());
	ТипыСтрокЭтапы.Добавить(ТипСтрокиЭтапСтруктуры());
	
	ТипыСтрокНоменклатура = Новый СписокЗначений; // У строк с типом Выпуск отдельные правила
	ТипыСтрокНоменклатура.Добавить(ТипСтрокиИзделие());
	ТипыСтрокНоменклатура.Добавить(ТипСтрокиНоменклатураРасшифровки());
	ТипыСтрокНоменклатура.Добавить(ТипСтрокиПолуфабрикат());
	ТипыСтрокНоменклатура.Добавить(ТипСтрокиПеремещение());
	ТипыСтрокНоменклатура.Добавить(ТипСтрокиМатериал());
	
	#Область СкрытьНазначениеПолуфабриката
	
	Элемент = УсловноеОформление.Элементы.Добавить();

	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.Назначение.Имя);
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Дерево.ТипСтроки");
