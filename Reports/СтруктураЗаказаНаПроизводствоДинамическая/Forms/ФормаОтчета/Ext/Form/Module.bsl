&НаКлиенте
Процедура ИзменениеКачестваЗавершение(Результат, ПараметрыПроцедуры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Результат.Статус = "Ошибка" Тогда
		СтандартныеПодсистемыКлиент.ВывестиИнформациюОбОшибке(Результат.ИнформацияОбОшибке);
		Возврат;
	КонецЕсли;
	
	Строка = Дерево.НайтиПоИдентификатору(ПараметрыПроцедуры.ИдентификаторСтроки);
	Если Строка <> Неопределено Тогда
		РезультатДействия = РезультатИзмененияКачества(Результат.АдресРезультата);
		ЗаполнитьЗначенияСвойств(Строка, РезультатДействия, "Номенклатура, Характеристика, ПредставлениеСтроки");
		Строка.Качество = ПараметрыПроцедуры.Качество;
		
		Элементы.ДеревоКонтекстноеМенюИзменитьКачество.Видимость = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция РезультатИзмененияКачества(АдресРезультата)
	
	РезультатОбработки = ПолучитьИзВременногоХранилища(АдресРезультата);
	
	Ссылки = Новый Массив;
	Ссылки.Добавить(РезультатОбработки.НоменклатураДругогоКачества);
	Если ЗначениеЗаполнено(РезультатОбработки.ХарактеристикаДругогоКачества) Тогда
		Ссылки.Добавить(РезультатОбработки.ХарактеристикаДругогоКачества);
	КонецЕсли;
	
	ЗначениеРеквизитов = ОбщегоНазначения.ЗначениеРеквизитаОбъектов(Ссылки, "Наименование");
	
	ПредставлениеСтроки = НоменклатураКлиентСервер.ПредставлениеНоменклатуры(
		ЗначениеРеквизитов[РезультатОбработки.НоменклатураДругогоКачества],
		ЗначениеРеквизитов[РезультатОбработки.ХарактеристикаДругогоКачества]);
	
	Результат = Новый Структура;
	Результат.Вставить("Номенклатура", РезультатОбработки.НоменклатураДругогоКачества);
	Результат.Вставить("Характеристика", РезультатОбработки.ХарактеристикаДругогоКачества);
	Результат.Вставить("ПредставлениеСтроки", ПредставлениеСтроки);
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ВыборРаботКДобавлениюЗавершение(РезультатВыбора, ПараметрыПроцедуры) Экспорт
	
	Если ТипЗнч(РезультатВыбора) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	ДлительнаяОперация = НачатьДобавлениеРаботНаСервере(
		ПараметрыПроцедуры.Этап,
		ПараметрыПроцедуры.КлючПартия,
		ПараметрыПроцедуры.ЭтоПолуфабрикат,
		РезультатВыбора.АдресТаблицыРаботы,
		РезультатВыбора.ЭтапыРазборкиСборки);
	
	ПараметрыПроцедуры.Вставить("АдресТаблицыРаботы", РезультатВыбора.АдресТаблицыРаботы);
	ПараметрыПроцедуры.Вставить("ЭтапыРазборкиСборки", РезультатВыбора.ЭтапыРазборкиСборки);
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ДобавлениеРаботЗавершение",
		ЭтотОбъект,
		ПараметрыПроцедуры);
	
	ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, ОписаниеОповещения);
	
КонецПроцедуры

&НаСервере
Функция НачатьДобавлениеРаботНаСервере(Этап, КлючПартия, ЭтоПолуфабрикат, АдресТаблицыРаботы, ЭтапыРазборкиСборки)
	
	ПараметрыВывода = ?(ЭтоПолуфабрикат, ПараметрыЧтенияДереваПолуфабрикатов(), ПараметрыЧтенияДереваЗаказа());
	
	ПараметрыПроцедуры = Новый Структура;
	ПараметрыПроцедуры.Вставить("Заказ", Заказ);
	ПараметрыПроцедуры.Вставить("Этап", Этап);
	ПараметрыПроцедуры.Вставить("КлючПартия", КлючПартия);
	ПараметрыПроцедуры.Вставить("Работы", ПолучитьИзВременногоХранилища(АдресТаблицыРаботы));
	ПараметрыПроцедуры.Вставить("ЭтапыРазборкиСборки", ЭтапыРазборкиСборки);
	ПараметрыПроцедуры.Вставить("ЭтоПолуфабрикат", ЭтоПолуфабрикат);
	ПараметрыПроцедуры.Вставить("ПараметрыВывода", ПараметрыВывода);
	ПараметрыПроцедуры.Вставить("Назначение", НазначениеОтбор);
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = НСтр("ru = 'Добавление работ в этап производства';
															|en = 'Add works to the production stage'");
	
	Возврат ДлительныеОперации.ВыполнитьВФоне(
		"Отчеты.СтруктураЗаказаНаПроизводствоДинамическая.ДобавитьРаботыИРемонтируемыеИзделияОтложенно",
		ПараметрыПроцедуры,
		ПараметрыВыполнения);
	
КонецФункции

&НаКлиенте
Процедура ДобавлениеРаботЗавершение(Результат, ПараметрыПроцедуры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Результат.Статус = "Ошибка" Тогда
		СтандартныеПодсистемыКлиент.ВывестиИнформациюОбОшибке(Результат.ИнформацияОбОшибке);
		Возврат;
	КонецЕсли;
	
	ВывестиДобавленныеРаботыИИзделия(Результат.АдресРезультата, ПараметрыПроцедуры);
	
КонецПроцедуры

&НаСервере
Процедура ВывестиДобавленныеРаботыИИзделия(АдресРезультата, ПараметрыПроцедуры)
	
	СтрокаЭтапРабот = Дерево.НайтиПоИдентификатору(ПараметрыПроцедуры.ИдентификаторСтроки);
	Если СтрокаЭтапРабот = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтруктураПоиска = Новый Структура("ТипСтроки, ЭтапСсылка", ТипСтрокиЭтапДокумент());
	ДеревоРезультат = ПолучитьИзВременногоХранилища(АдресРезультата); // ДеревоЗначений
	
	// Этап с работами
	Если НЕ СтрокаЭтапРабот.ДостроитьДерево Тогда
		СтруктураПоиска.ЭтапСсылка = СтрокаЭтапРабот.ЭтапСсылка;
		НайденныеСтроки = ДеревоРезультат.Строки.НайтиСтроки(СтруктураПоиска, Истина);
		Если НайденныеСтроки.Количество() <> 0 Тогда
			СтрокаЭтапРабот.ПолучитьЭлементы().Очистить();
			ЗаполнитьДеревоРекурсивно(СтрокаЭтапРабот.ПолучитьЭлементы(), НайденныеСтроки[0].Строки);
			
			Работы = ПолучитьИзВременногоХранилища(ПараметрыПроцедуры.АдресТаблицыРаботы); // ТаблицаЗначений
			Работы.Индексы.Добавить("Номенклатура, Характеристика");
			СтруктураПоискаРаботы = Новый Структура("Номенклатура, Характеристика");
			
			Для каждого Строка Из СтрокаЭтапРабот.ПолучитьЭлементы() Цикл
				ЗаполнитьЗначенияСвойств(СтруктураПоискаРаботы, Строка);
				НайденныеСтроки = Работы.НайтиСтроки(СтруктураПоискаРаботы);
				Если НайденныеСтроки.Количество() > 0
					И Строка.ПолучитьЭлементы().Количество() = 0
					И НЕ Строка.Спецификация.Пустая()
					И Строка.Готово = 0 Тогда
					СтрокаИнформация = Строка.ПолучитьЭлементы().Добавить();
					СтрокаИнформация.ТипСтроки = ТипСтрокиИнформация();
					СтрокаИнформация.ПредставлениеСтроки = НСтр("ru = '<данные рассчитываются>';
																|en = '<data is calculated>'");
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
	// Этапы разборки и сборки
	Для каждого ЭтапСсылка Из ПараметрыПроцедуры.ЭтапыРазборкиСборки Цикл
		
		СтрокаЭтап = Неопределено;
		Для каждого Строка Из СтрокаЭтапРабот.ПолучитьРодителя().ПолучитьЭлементы() Цикл
			Если Строка.ЭтапСсылка = ЭтапСсылка Тогда
				СтрокаЭтап = Строка;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если СтрокаЭтап <> Неопределено
			И НЕ СтрокаЭтап.ДостроитьДерево Тогда
			СтруктураПоиска.ЭтапСсылка = СтрокаЭтап.ЭтапСсылка;
			НайденныеСтроки = ДеревоРезультат.Строки.НайтиСтроки(СтруктураПоиска, Истина);
			Если НайденныеСтроки.Количество() <> 0 Тогда
				СтрокаЭтап.ПолучитьЭлементы().Очистить();
				ЗаполнитьДеревоРекурсивно(СтрокаЭтап.ПолучитьЭлементы(), НайденныеСтроки[0].Строки);
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти
