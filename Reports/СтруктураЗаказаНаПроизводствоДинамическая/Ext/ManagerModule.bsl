Функция ТекстЗапросаОстаткиПоДругимНазначениямВКоличественномВыражение() Экспорт
	
	ТекстыЗапроса = Новый Массив();
	ТекстЗапроса =
		"ВЫБРАТЬ
		|	Запасы.Номенклатура КАК Номенклатура,
		|	Запасы.Характеристика КАК Характеристика,
		|	Запасы.Склад КАК Склад,
		|	Запасы.Назначение КАК Назначение,
		|	Запасы.ВНаличииОстаток КАК ВНаличииОстаток,
		|	Запасы.ЗаблокированоВНаличииОстаток КАК ЗаблокированоВНаличииОстаток,
		|	Запасы.ЗаказаноОстаток КАК ЗаказаноОстаток,
		|	Запасы.ПоступитОстаток КАК ПоступитОстаток,
		|	Запасы.ЗаблокированоПоступитОстаток КАК ЗаблокированоПоступитОстаток,
		|	Запасы.РезервироватьНаСкладеОстаток КАК РезервироватьНаСкладеОстаток,
		|	Запасы.РезервироватьПоМереПоступленияОстаток КАК РезервироватьПоМереПоступленияОстаток,
		|	Запасы.ОтложитьРезервированиеОстаток КАК ОтложитьРезервированиеОстаток,
		|	Запасы.КОбеспечениюОстаток КАК КОбеспечениюОстаток,
		|	Запасы.НеОбеспечиватьОстаток КАК НеОбеспечиватьОстаток
		|ПОМЕСТИТЬ ЗапасыИПотребностиОстатки
		|ИЗ
		|	РегистрНакопления.ЗапасыИПотребности.Остатки(,
		|		Номенклатура = &Номенклатура
		|			И Характеристика = &Характеристика) КАК Запасы
		|ИНДЕКСИРОВАТЬ ПО
		|	Номенклатура, Характеристика, Склад, Назначение
		|;
		|
		|//////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Запасы.Номенклатура КАК Номенклатура,
		|	Запасы.Характеристика КАК Характеристика,
		|	Запасы.Склад КАК Склад,
		|	Запасы.Назначение КАК Назначение,
		|	Запасы.Заказ КАК Заказ,
		|	Запасы.ЗаблокированоВНаличииОстаток КАК ЗаблокированоВНаличииОстаток,
		|	Запасы.ЗаблокированоПоступитОстаток КАК ЗаблокированоПоступитОстаток,
		|	Запасы.КРазблокировкеОстаток КАК КРазблокировкеОстаток,
		|	Запасы.РезервироватьНаСкладеИзЗаблокированныхОстаток КАК РезервироватьНаСкладеИзЗаблокированныхОстаток,
		|	Запасы.РезервироватьПоМереПоступленияИзЗаблокированныхОстаток КАК РезервироватьПоМереПоступленияИзЗаблокированныхОстаток
		|	
		|ПОМЕСТИТЬ ЗапасыИПотребностиОстаткиКонтролируемыхПартий
		|ИЗ
		|	РегистрНакопления.ЗапасыИПотребности.Остатки(,
		|		Номенклатура = &Номенклатура
		|			И Характеристика = &Характеристика) КАК Запасы
		|ИНДЕКСИРОВАТЬ ПО
		|	Номенклатура, Характеристика, Склад, Назначение";
	
	ИменаТаблиц = ОбеспечениеВДокументахСервер.НовыеИменаТаблицДляРаспределенияЗапасов();
	ИменаТаблиц.Остатки = "ЗапасыИПотребностиОстатки"; // @query-part-1
	ИменаТаблиц.ОстаткиКонтролируемыхПартий = "ЗапасыИПотребностиОстаткиКонтролируемыхПартий"; // @query-part-1
	ИменаТаблиц.Результат = "РасчетРаспределенияЗапасов"; // @query-part-1
	
	ОбеспечениеВДокументахСервер.РаспределениеЗапасов(ТекстЗапроса, ИменаТаблиц);
	ТекстыЗапроса.Добавить(ТекстЗапроса);

	ТекстЗапроса =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЕСТЬNULL(СУММА(Таблица.НаТекущемСкладе), 0)                КАК НаТекущемСкладе,
	|	ЕСТЬNULL(СУММА(Таблица.НаТекущемСкладеСвободноИзлишек), 0) КАК НаТекущемСкладеСвободноИзлишек,
	|	ЕСТЬNULL(СУММА(Таблица.НаДругихСкладах), 0)                КАК НаДругихСкладах,
	|	ЕСТЬNULL(СУММА(Таблица.НаДругихСкладахСвободноИзлишек), 0) КАК НаДругихСкладахСвободноИзлишек
	|ИЗ
	|	(ВЫБРАТЬ
	|		Остатки.Назначение КАК Назначение,
	|		ВЫБОР
	|			КОГДА Остатки.Склад = &Склад
	|				ТОГДА Остатки.ВНаличии + Остатки.ВНаличииСБлокировкой
	|			ИНАЧЕ 0
	|		КОНЕЦ КАК НаТекущемСкладе,
	|		0     КАК НаТекущемСкладеСвободноИзлишек,
	|		ВЫБОР
	|			КОГДА Остатки.Склад <> &Склад
	|				ТОГДА Остатки.ВНаличии + Остатки.ВНаличииСБлокировкой
	|			ИНАЧЕ 0
	|		КОНЕЦ КАК НаДругихСкладах,
	|		0     КАК НаДругихСкладахСвободноИзлишек
	|	ИЗ
	|		РасчетРаспределенияЗапасов КАК Остатки
	|	ГДЕ
	|		Остатки.ВНаличии + Остатки.ВНаличииСБлокировкой > 0
	|
	|	ОБЪЕДИНИТЬ ВСЕ
	|
	|	ВЫБРАТЬ
	|		Остатки.Назначение КАК Назначение,
	|		0     КАК НаТекущемСкладе,
	|		ВЫБОР
	|			КОГДА Остатки.Склад = &Склад
	|				ТОГДА МАКСИМУМ(Остатки.ВНаличии_Излишек + Остатки.ВНаличииСБлокировкой_Излишек) - СУММА(ЕСТЬNULL(СтруктураЗаказа.РаспределеноИзЗапасов, 0))
	|			ИНАЧЕ 0
	|		КОНЕЦ КАК НаТекущемСкладеСвободноИзлишек,
	|		0     КАК НаДругихСкладах,
	|		ВЫБОР
	|			КОГДА Остатки.Склад <> &Склад
	|				ТОГДА МАКСИМУМ(Остатки.ВНаличии_Излишек + Остатки.ВНаличииСБлокировкой_Излишек) - СУММА(ЕСТЬNULL(СтруктураЗаказа.РаспределеноИзЗапасов, 0))
	|			ИНАЧЕ 0
	|		КОНЕЦ КАК НаДругихСкладахСвободноИзлишек
	|	ИЗ
	|		РасчетРаспределенияЗапасов КАК Остатки
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтруктураЗаказа КАК СтруктураЗаказа
	|			ПО Остатки.Номенклатура   = СтруктураЗаказа.Номенклатура
	|			 И Остатки.Характеристика = СтруктураЗаказа.Характеристика
	|			 И Остатки.Склад          = СтруктураЗаказа.Склад
	|			 И Остатки.Назначение     = СтруктураЗаказа.Назначение
	|			 И СтруктураЗаказа.ВидСтроки = ЗНАЧЕНИЕ(Перечисление.ВидыСтрокСтруктурыЗаказаНаПроизводство.Зарезервировано)
	|	ГДЕ
	|		Остатки.Номенклатура   = &Номенклатура
	|		И Остатки.Характеристика = &Характеристика
	|		И Остатки.Склад          = &Склад
	|		И Остатки.Назначение     = ЗНАЧЕНИЕ(Справочник.Назначения.ПустаяСсылка)
	|		И &Назначение <> ЗНАЧЕНИЕ(Справочник.Назначения.ПустаяСсылка)
	|	СГРУППИРОВАТЬ ПО
	|		Остатки.Склад, Остатки.Назначение
	|	ИМЕЮЩИЕ
	|		МАКСИМУМ(Остатки.ВНаличии_Излишек + Остатки.ВНаличииСБлокировкой_Излишек) - СУММА(ЕСТЬNULL(СтруктураЗаказа.РаспределеноИзЗапасов, 0)) > 0
	|
	|	ОБЪЕДИНИТЬ ВСЕ
	|
	|	ВЫБРАТЬ
	|		Остатки.Назначение КАК Назначение,
	|		0     КАК НаТекущемСкладе,
	|		ВЫБОР
	|			КОГДА Остатки.Склад = &Склад
	|				ТОГДА МАКСИМУМ(Остатки.ВНаличии_Излишек + Остатки.ВНаличииСБлокировкой_Излишек) - СУММА(ЕСТЬNULL(СтруктураЗаказа.РаспределеноИзЗапасовОбособленно, 0))
	|			ИНАЧЕ 0
	|		КОНЕЦ КАК НаТекущемСкладеСвободноИзлишек,
	|		0     КАК НаДругихСкладах,
	|		ВЫБОР
	|			КОГДА Остатки.Склад <> &Склад
	|				ТОГДА МАКСИМУМ(Остатки.ВНаличии_Излишек + Остатки.ВНаличииСБлокировкой_Излишек) - СУММА(ЕСТЬNULL(СтруктураЗаказа.РаспределеноИзЗапасовОбособленно, 0))
	|			ИНАЧЕ 0
	|		КОНЕЦ КАК НаДругихСкладахСвободноИзлишек
	|	ИЗ
	|		РасчетРаспределенияЗапасов КАК Остатки
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтруктураЗаказа КАК СтруктураЗаказа
	|			ПО Остатки.Номенклатура   = СтруктураЗаказа.Номенклатура
	|			 И Остатки.Характеристика = СтруктураЗаказа.Характеристика
	|			 И Остатки.Склад          = СтруктураЗаказа.Склад
	|			 И Остатки.Назначение     = СтруктураЗаказа.НазначениеСтруктуры
	|			 И СтруктураЗаказа.ВидСтроки = ЗНАЧЕНИЕ(Перечисление.ВидыСтрокСтруктурыЗаказаНаПроизводство.Зарезервировано)
	|	ГДЕ
	|		Остатки.Номенклатура   = &Номенклатура
	|		И Остатки.Характеристика = &Характеристика
	|		И Остатки.Склад          = &Склад
	|		И Остатки.Назначение    <> ЗНАЧЕНИЕ(Справочник.Назначения.ПустаяСсылка)
	|		И &Назначение           <> ЗНАЧЕНИЕ(Справочник.Назначения.ПустаяСсылка)
	|	СГРУППИРОВАТЬ ПО
	|		Остатки.Склад, Остатки.Назначение
	|	ИМЕЮЩИЕ
	|		МАКСИМУМ(Остатки.ВНаличии_Излишек + Остатки.ВНаличииСБлокировкой_Излишек) - СУММА(ЕСТЬNULL(СтруктураЗаказа.РаспределеноИзЗапасовОбособленно, 0)) > 0
	|
	|) КАК Таблица
	|";
	ТекстыЗапроса.Добавить(ТекстЗапроса);
	ТекстЗапроса = СтрСоединить(ТекстыЗапроса, ОбщегоНазначения.РазделительПакетаЗапросов());
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ТекстЗапросаЭтоПолуфабрикат(ИмяВнешнейТаблицы = "СтруктураЗаказа") Экспорт
	
	Возврат 
		СтрЗаменить(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ИСТИНА
		|ИЗ
		|	РегистрСведений.КэшНСИСтруктурыЗаказа КАК СпособыОбеспечения
		|ГДЕ
		|	СпособыОбеспечения.Номенклатура = ИмяВнешнейТаблицы.Номенклатура
		|	И СпособыОбеспечения.Характеристика = ИмяВнешнейТаблицы.Характеристика
		|	И СпособыОбеспечения.ЗаказНаПроизводство = ИмяВнешнейТаблицы.ЗаказНаПроизводство
		|	И СпособыОбеспечения.Запланировать
		|	И СпособыОбеспечения.ТипОбеспечения = ЗНАЧЕНИЕ(Перечисление.ТипыОбеспечения.Производство)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ ПЕРВЫЕ 1
		|	ИСТИНА
		|ИЗ
		|	ВТРазбираемыеИзделия КАК РазбираемыеИзделия
		|ГДЕ
		|	РазбираемыеИзделия.Номенклатура = ИмяВнешнейТаблицы.Номенклатура
		|	И РазбираемыеИзделия.Характеристика = ИмяВнешнейТаблицы.Характеристика",
		"ИмяВнешнейТаблицы",
		ИмяВнешнейТаблицы);
	
КонецФункции

Функция ТекстыЗапросаВыпускВТ(УсловиеОтбора, ПоказыватьЭтапы, Постфикс)
	
	ТекстыЗапроса = Новый СписокЗначений;
	
	ТекстЗапроса = 
		"ВЫБРАТЬ
		|	СтруктураЗаказа.Номенклатура         КАК Номенклатура,
		|	СтруктураЗаказа.Характеристика       КАК Характеристика,
		|	СтруктураЗаказа.Склад                КАК Склад,
		|	СтруктураЗаказа.Назначение           КАК Назначение,
		|	СтруктураЗаказа.КлючНоменклатура     КАК КлючНоменклатура,
		|	СтруктураЗаказа.КлючПартия           КАК КлючПартия,
		|	СтруктураЗаказа.Этап                 КАК Этап,
		|	ВЫБОР
		|		КОГДА СтруктураЗаказа.Этап ССЫЛКА Документ.ЭтапПроизводства2_2
		|			ТОГДА ВЫРАЗИТЬ(СтруктураЗаказа.Этап КАК Документ.ЭтапПроизводства2_2).ПартияПроизводства
		|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ПартииПроизводства.ПустаяСсылка)
		|	КОНЕЦ                                КАК ПартияПроизводства,
		|	СУММА(СтруктураЗаказа.Запланировано) КАК Запланировано
		|ПОМЕСТИТЬ ВТКлючиПартийВыпуск
		|ИЗ
		|	РегистрСведений.СтруктураЗаказа КАК СтруктураЗаказа
		|ГДЕ
		|	&УсловиеОтбора
		|	И (&Назначение = ЗНАЧЕНИЕ(Справочник.Назначения.ПустаяСсылка) ИЛИ СтруктураЗаказа.Назначение = &Назначение)
		|
		|СГРУППИРОВАТЬ ПО
		|	СтруктураЗаказа.Номенклатура,
		|	СтруктураЗаказа.Характеристика,
		|	СтруктураЗаказа.Склад,
		|	СтруктураЗаказа.Назначение,
		|	СтруктураЗаказа.КлючНоменклатура,
		|	СтруктураЗаказа.КлючПартия,
		|	СтруктураЗаказа.Этап,
		|	ВЫБОР
		|		КОГДА СтруктураЗаказа.Этап ССЫЛКА Документ.ЭтапПроизводства2_2
		|			ТОГДА ВЫРАЗИТЬ(СтруктураЗаказа.Этап КАК Документ.ЭтапПроизводства2_2).ПартияПроизводства
		|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ПартииПроизводства.ПустаяСсылка)
		|	КОНЕЦ
		|
		|ИМЕЮЩИЕ
		|	СУММА(СтруктураЗаказа.Запланировано) > 0
		|	ИЛИ СУММА(СтруктураЗаказа.РаспределеноИзПартий) > 0
		|	ИЛИ СУММА(СтруктураЗаказа.РаспределеноИзПартийОбособленно) > 0
		|	ИЛИ СУММА(СтруктураЗаказа.Готово) > 0";
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеОтбора", УсловиеОтбора);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ВТКлючиПартийВыпуск", "ВТКлючиПартийВыпуск" + Постфикс);
	ТекстыЗапроса.Добавить(ТекстЗапроса, "ВТКлючиПартийВыпуск" + Постфикс);
	
	ТекстЗапроса = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Выпуск.КлючПартия         КАК КлючПартия,
		|	Выпуск.ПартияПроизводства КАК ПартияПроизводства
		|ПОМЕСТИТЬ ВТПартииПроизводстваВыпуск
		|ИЗ
		|	ВТКлючиПартийВыпуск КАК Выпуск
		|ГДЕ
		|	Выпуск.ПартияПроизводства <> ЗНАЧЕНИЕ(Справочник.ПартииПроизводства.ПустаяСсылка)
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	ПартияПроизводства";
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ВТКлючиПартийВыпуск", "ВТКлючиПартийВыпуск" + Постфикс);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ВТПартииПроизводстваВыпуск", "ВТПартииПроизводстваВыпуск" + Постфикс);
	ТекстыЗапроса.Добавить(ТекстЗапроса, "ВТПартииПроизводстваВыпуск" + Постфикс);
	
	ТекстЗапроса = 
		"ВЫБРАТЬ
		|	СтруктураЗаказа.Номенклатура                           КАК Номенклатура,
		|	СтруктураЗаказа.Номенклатура.ЕдиницаИзмерения          КАК ЕдиницаИзмерения,
		|	СтруктураЗаказа.Номенклатура.Представление             КАК НоменклатураПредставление,
		|	СтруктураЗаказа.Номенклатура.ТипНоменклатуры           КАК ТипНоменклатуры,
		|	СтруктураЗаказа.Номенклатура.Качество                  КАК Качество,
		|	СтруктураЗаказа.Характеристика                         КАК Характеристика,
		|	СтруктураЗаказа.Характеристика.Представление           КАК ХарактеристикаПредставление,
		|	СтруктураЗаказа.Склад                                  КАК Склад,
		|	СтруктураЗаказа.Назначение                             КАК Назначение,
		|	ЛОЖЬ                                                   КАК Отменено,
		|	СтруктураЗаказа.КлючПартия                             КАК КлючПартия,
		|	ЗНАЧЕНИЕ(Справочник.ПартииПроизводства.ПустаяСсылка)   КАК ПартияПроизводства,
		|	&ТекстПоляЭтапРегистр                                  КАК ЭтапСсылка,
		|	МИНИМУМ(
		|		ВЫБОР
		|			КОГДА График.Начало ЕСТЬ НЕ NULL
		|				ТОГДА График.Начало
		|		КОНЕЦ)                                             КАК Начало,
		|	МАКСИМУМ(ЕСТЬNULL(График.Окончание, ДАТАВРЕМЯ(1,1,1))) КАК Окончание,
		|	СУММА(СтруктураЗаказа.Запланировано)                   КАК Требуется,
		|	0                                                      КАК Готово
		|ПОМЕСТИТЬ ВТВыпуск
		|ИЗ
		|	ВТКлючиПартийВыпуск КАК СтруктураЗаказа
		|
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ГрафикЭтаповПроизводства2_2 КАК График
		|	ПО График.ЗаказНаПроизводство = &Заказ
		|		И График.СтатусГрафика = &СтатусРабочийГрафик
		|		И СтруктураЗаказа.КлючПартия = График.КлючПартия
		|		И СтруктураЗаказа.Этап = График.Этап
		|ГДЕ
		|	СтруктураЗаказа.Запланировано > 0
		|	И СтруктураЗаказа.Номенклатура.ТипНоменклатуры <> ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Работа)
		|
		|СГРУППИРОВАТЬ ПО
		|	СтруктураЗаказа.Номенклатура,
		|	СтруктураЗаказа.Характеристика,
		|	СтруктураЗаказа.Склад,
		|	СтруктураЗаказа.Назначение,
		|	СтруктураЗаказа.КлючНоменклатура,
		|	СтруктураЗаказа.КлючПартия,
		|	&ТекстПоляЭтапРегистр
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	Изделия.Номенклатура                  КАК Номенклатура,
		|	Изделия.Номенклатура.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
		|	Изделия.Номенклатура.Представление    КАК НоменклатураПредставление,
		|	Изделия.Номенклатура.ТипНоменклатуры  КАК ТипНоменклатуры,
		|	Изделия.Номенклатура.Качество         КАК Качество,
		|	Изделия.Характеристика                КАК Характеристика,
		|	Изделия.Характеристика.Представление  КАК ХарактеристикаПредставление,
		|	Изделия.Получатель                    КАК Склад,
		|	Изделия.Назначение                    КАК Назначение,
		|	Изделия.Отменено                      КАК Отменено,
		|	Партии.КлючПартия                     КАК КлючПартия,
		|	Партии.ПартияПроизводства             КАК ПартияПроизводства,
		|	&ТекстПоляЭтапДокумент                КАК ЭтапСсылка,
		|	МИНИМУМ(
		|		ВЫБОР
		|			КОГДА График.Начало ЕСТЬ НЕ NULL
		|					И (Изделия.ДатаПроизводства = ДАТАВРЕМЯ(1,1,1)
		|						ИЛИ График.Начало <= Изделия.ДатаПроизводства)
		|				ТОГДА График.Начало
		|		КОНЕЦ)                            КАК Начало,
		|	МАКСИМУМ(
		|		ВЫБОР
		|			КОГДА Изделия.ДатаПроизводства <> ДАТАВРЕМЯ(1,1,1)
		|				ТОГДА Изделия.ДатаПроизводства
		|			ИНАЧЕ ЕСТЬNULL(График.Окончание, ДАТАВРЕМЯ(1,1,1))
		|		КОНЕЦ)                            КАК Окончание,
		|	СУММА(Изделия.Количество)             КАК Требуется,
		|	СУММА(
		|		ВЫБОР
		|			КОГДА Изделия.Произведено
		|				ТОГДА Изделия.Количество
		|			ИНАЧЕ 0
		|		КОНЕЦ)                            КАК Готово
		|ИЗ
		|	ВТПартииПроизводстваВыпуск КАК Партии
		|
		|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЭтапПроизводства2_2 КАК Этапы
		|	ПО Партии.ПартияПроизводства = Этапы.ПартияПроизводства
		|		И Этапы.Проведен
		|
		|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЭтапПроизводства2_2.ВыходныеИзделия КАК Изделия
		|	ПО Этапы.Ссылка = Изделия.Ссылка
		|
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ГрафикЭтаповПроизводства2_2 КАК График
		|	ПО График.ЗаказНаПроизводство = &Заказ
		|		И График.СтатусГрафика = &СтатусРабочийГрафик
		|		И Партии.КлючПартия = График.КлючПартия
		|		И Этапы.Ссылка = График.Этап
		|ГДЕ
		|	(&Назначение = ЗНАЧЕНИЕ(Справочник.Назначения.ПустаяСсылка) ИЛИ Изделия.Назначение = &Назначение)
		|	И Изделия.Номенклатура.ТипНоменклатуры <> ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Работа)
		|
		|СГРУППИРОВАТЬ ПО
		|	Изделия.Номенклатура,
		|	Изделия.Характеристика,
		|	Изделия.Получатель,
		|	Изделия.Назначение,
		|	Изделия.Отменено,
		|	Партии.КлючПартия,
		|	Партии.ПартияПроизводства,
		|	&ТекстПоляЭтапДокумент
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	Изделия.Номенклатура                  КАК Номенклатура,
		|	Изделия.Номенклатура.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
		|	Изделия.Номенклатура.Представление    КАК НоменклатураПредставление,
		|	Изделия.Номенклатура.ТипНоменклатуры  КАК ТипНоменклатуры,
		|	Изделия.Номенклатура.Качество         КАК Качество,
		|	Изделия.Характеристика                КАК Характеристика,
		|	Изделия.Характеристика.Представление  КАК ХарактеристикаПредставление,
		|	Изделия.Получатель                    КАК Склад,
		|	Изделия.Назначение                    КАК Назначение,
		|	Изделия.Отменено                      КАК Отменено,
		|	Партии.КлючПартия                     КАК КлючПартия,
		|	Партии.ПартияПроизводства             КАК ПартияПроизводства,
		|	&ТекстПоляЭтапДокумент                КАК ЭтапСсылка,
		|	МИНИМУМ(
		|		ВЫБОР
		|			КОГДА График.Начало ЕСТЬ НЕ NULL
		|					И (Изделия.ДатаПроизводства = ДАТАВРЕМЯ(1,1,1)
		|						ИЛИ График.Начало <= Изделия.ДатаПроизводства)
		|				ТОГДА График.Начало
		|		КОНЕЦ)                            КАК Начало,
		|	МАКСИМУМ(
		|		ВЫБОР
		|			КОГДА Изделия.ДатаПроизводства <> ДАТАВРЕМЯ(1,1,1)
		|				ТОГДА Изделия.ДатаПроизводства
		|			ИНАЧЕ ЕСТЬNULL(График.Окончание, ДАТАВРЕМЯ(1,1,1))
		|		КОНЕЦ)                            КАК Окончание,
		|	СУММА(Изделия.Количество)             КАК Требуется,
		|	СУММА(
		|		ВЫБОР
		|			КОГДА Изделия.Произведено
		|				ТОГДА Изделия.Количество
		|			ИНАЧЕ 0
		|		КОНЕЦ)                            КАК Готово
		|ИЗ
		|	ВТПартииПроизводстваВыпуск КАК Партии
		|
		|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЭтапПроизводства2_2 КАК Этапы
		|	ПО Партии.ПартияПроизводства = Этапы.ПартияПроизводства
		|		И Этапы.Проведен
		|
		|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЭтапПроизводства2_2.ПобочныеИзделия КАК Изделия
		|	ПО Этапы.Ссылка = Изделия.Ссылка
		|
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ГрафикЭтаповПроизводства2_2 КАК График
		|	ПО График.ЗаказНаПроизводство = &Заказ
		|		И График.СтатусГрафика = &СтатусРабочийГрафик
		|		И Партии.КлючПартия = График.КлючПартия
		|		И Этапы.Ссылка = График.Этап
		|ГДЕ
		|	(&Назначение = ЗНАЧЕНИЕ(Справочник.Назначения.ПустаяСсылка) ИЛИ Изделия.Назначение = &Назначение)
		|	И Изделия.Номенклатура.ТипНоменклатуры <> ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Работа)
		|
		|СГРУППИРОВАТЬ ПО
		|	Изделия.Номенклатура,
		|	Изделия.Характеристика,
		|	Изделия.Получатель,
		|	Изделия.Назначение,
		|	Изделия.Отменено,
		|	Партии.КлючПартия,
		|	Партии.ПартияПроизводства,
		|	&ТекстПоляЭтапДокумент
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	КлючПартия,
		|	Номенклатура";
	
	УправлениеПроизводством.ПодстановкаАктуальногоРегистраГрафика(ТекстЗапроса);
	
	ТекстПоляЭтапРегистр = ?(ПоказыватьЭтапы, "СтруктураЗаказа.Этап", "НЕОПРЕДЕЛЕНО");
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТекстПоляЭтапРегистр", ТекстПоляЭтапРегистр);
	
	ТекстПоляЭтапДокумент = ?(ПоказыватьЭтапы, "Этапы.Ссылка", "НЕОПРЕДЕЛЕНО");
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТекстПоляЭтапДокумент", ТекстПоляЭтапДокумент);
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ВТКлючиПартийВыпуск", "ВТКлючиПартийВыпуск" + Постфикс);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ВТПартииПроизводстваВыпуск", "ВТПартииПроизводстваВыпуск" + Постфикс);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ВТВыпуск", "ВТВыпуск" + Постфикс);
	
	ТекстыЗапроса.Добавить(ТекстЗапроса, "ВТВыпуск" + Постфикс);
	
	Возврат ТекстыЗапроса;
	
КонецФункции

Функция ТекстЗапросаВыпускВТИмитация(Постфикс)
	
	ТекстЗапроса = 
		"ВЫБРАТЬ ПЕРВЫЕ 0
		|	&ПустойКлючСвязи                                             КАК КлючПартия,
		|	ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)               КАК Номенклатура,
		|	ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка) КАК Характеристика,
		|	ЛОЖЬ                                                         КАК Отменено
		|ПОМЕСТИТЬ ВТВыпуск";
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ВТВыпуск", "ВТВыпуск" + Постфикс);
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ТекстЗапросаВыпуск(Постфикс, УстановитьОтборНаЭтап)
	
	ТекстЗапроса = 
		"ВЫБРАТЬ
		|	Выпуск.Номенклатура                КАК Номенклатура,
		|	Выпуск.ЕдиницаИзмерения            КАК ЕдиницаИзмерения,
		|	Выпуск.НоменклатураПредставление   КАК НоменклатураПредставление,
		|	Выпуск.ТипНоменклатуры             КАК ТипНоменклатуры,
		|	Выпуск.Качество                    КАК Качество,
		|	Выпуск.Характеристика              КАК Характеристика,
		|	Выпуск.ХарактеристикаПредставление КАК ХарактеристикаПредставление,
		|	Выпуск.Склад                       КАК Склад,
		|	Выпуск.Назначение                  КАК Назначение,
		|	Выпуск.Отменено                    КАК Отменено,
		|	Выпуск.КлючПартия                  КАК КлючПартия,
		|	Выпуск.ПартияПроизводства          КАК ПартияПроизводства,
		|	Выпуск.ЭтапСсылка                  КАК ЭтапСсылка,
		|	Выпуск.Начало                      КАК Начало,
		|	Выпуск.Окончание                   КАК Окончание,
		|	Выпуск.Требуется                   КАК Требуется,
		|	Выпуск.Готово                      КАК Готово
		|ИЗ
		|	ВТВыпуск КАК Выпуск
		|ГДЕ
		|	Выпуск.ЭтапСсылка = &Этап
		|
		|УПОРЯДОЧИТЬ ПО
		|	КлючПартия,
		|	Номенклатура,
		|	Характеристика
		|АВТОУПОРЯДОЧИВАНИЕ";
	
	Если НЕ УстановитьОтборНаЭтап Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Выпуск.ЭтапСсылка = &Этап", "ИСТИНА");
	КонецЕсли;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ВТВыпуск", "ВТВыпуск" + Постфикс);
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ТекстЗапросаВыпускСвернуто(Постфикс)
	
	ТекстЗапроса = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Выпуск.КлючПартия   КАК КлючПартия,
		|	Выпуск.ЭтапСсылка   КАК ЭтапСсылка
		|ИЗ
		|	ВТВыпуск КАК Выпуск";
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ВТВыпуск", "ВТВыпуск" + Постфикс);
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ТекстЗапросаРазбираемыеИзделияВТ()
	
	ТекстЗапроса = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ТабличнаяЧасть.Номенклатура   КАК Номенклатура,
		|	ТабличнаяЧасть.Характеристика КАК Характеристика
		|ПОМЕСТИТЬ ВТРазбираемыеИзделия
		|ИЗ
		|	Документ.ЗаказНаПроизводство2_2.Продукция КАК ТабличнаяЧасть
		|ГДЕ
		|	ТабличнаяЧасть.Ссылка = &Заказ
		|	И НЕ ТабличнаяЧасть.Отменено
		|	И ТабличнаяЧасть.Ссылка.ТипПроизводственногоПроцесса = ЗНАЧЕНИЕ(Перечисление.ТипыПроизводственныхПроцессов.Разборка)
		|ИНДЕКСИРОВАТЬ ПО
		|	Номенклатура, Характеристика";
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ТекстЗапросаРазбираемыеИзделияВТИмитация()
	
	ТекстЗапроса = 
		"ВЫБРАТЬ ПЕРВЫЕ 0
		|	ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)               КАК Номенклатура,
		|	ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка) КАК Характеристика
		|ПОМЕСТИТЬ ВТРазбираемыеИзделия";
	
	Возврат ТекстЗапроса;
	
КонецФункции

