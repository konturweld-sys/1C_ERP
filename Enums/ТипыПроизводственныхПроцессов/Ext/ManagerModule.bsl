// Возвращает список доступных типов производственного процесса в зависимости от текущих значений функциональных опций
//
// Параметры:
//  ДинамическаяСтруктура	 - Булево	 - значение опции (контекстное)
// 
// Возвращаемое значение:
//  Массив - массив доступных типов производственного процесса
//
Функция ДоступныеТипы(ДинамическаяСтруктура = Неопределено) Экспорт
	
	Если ДинамическаяСтруктура = Неопределено Тогда
		ДинамическаяСтруктура = Ложь;
		//++ НЕ УТКА
		ДинамическаяСтруктура = ПолучитьФункциональнуюОпцию("ДинамическаяСтруктураЗаказовНаПроизводство");
		//-- НЕ УТКА
	КонецЕсли;

	ТипыПроцессов = Новый Массив();
	
	ТипыПроцессов.Добавить(Перечисления.ТипыПроизводственныхПроцессов.Сборка);
	
	Если ДинамическаяСтруктура Тогда
		ТипыПроцессов.Добавить(Перечисления.ТипыПроизводственныхПроцессов.ВыполнениеРемонтныхРабот);
	Иначе
		ТипыПроцессов.Добавить(Перечисления.ТипыПроизводственныхПроцессов.Ремонт);
		ТипыПроцессов.Добавить(Перечисления.ТипыПроизводственныхПроцессов.БезСпецификаций);
	КонецЕсли;
	
	ТипыПроцессов.Добавить(Перечисления.ТипыПроизводственныхПроцессов.Разборка);
	
	Возврат ТипыПроцессов;

КонецФункции

#КонецОбласти

#КонецЕсли
