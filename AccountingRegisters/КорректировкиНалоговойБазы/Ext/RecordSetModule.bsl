#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ, Замещение)
		
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если Отказ Или Не ЗначениеЗаполнено(ЭтотОбъект) Тогда
		Возврат;
	КонецЕсли;
	
	НеКонтролироватьИзменения = Ложь;
	ПроверкаИзмененияРегистра = Ложь;
	Если Не (ДополнительныеСвойства.Свойство("НеКонтролироватьИзменения", НеКонтролироватьИзменения) И НеКонтролироватьИзменения = Истина)
		И ДополнительныеСвойства.Свойство("ПроверкаИзмененияРегистра", ПроверкаИзмененияРегистра) И ПроверкаИзмененияРегистра = Истина Тогда
		// Проверим изменения в наборе записей проводок и если изменения есть - зарегистрируем операции к пересчету налога на прибыль.
		
		// Текущее состояние набора помещается во временную таблицу,
		// чтобы при записи получить изменение нового набора относительно текущего.
		
		ТекстыЗапросовДляПолученияТаблицыИзменений = 
			ЗакрытиеМесяцаСервер.ТекстыЗапросовДляПолученияТаблицыИзмененийРегистра(Метаданные(), Отбор);
			
		СтруктураПроверкиИзмененияРегистра = Новый Структура();
		СтруктураПроверкиИзмененияРегистра.Вставить("ТекстВыборкиТаблицыИзменений", ТекстыЗапросовДляПолученияТаблицыИзменений.ТекстВыборкиТаблицыИзменений);
		СтруктураПроверкиИзмененияРегистра.Вставить("МенеджерВременныхТаблиц", Новый МенеджерВременныхТаблиц);
		
		Запрос = Новый Запрос;
		Запрос.МенеджерВременныхТаблиц = СтруктураПроверкиИзмененияРегистра.МенеджерВременныхТаблиц;
		Запрос.Текст = ТекстыЗапросовДляПолученияТаблицыИзменений.ТекстВыборкиНачальныхДанных;
		Запрос.УстановитьПараметр("Регистратор", Отбор.Регистратор.Значение);
		
		Запрос.Выполнить();
		
		ДополнительныеСвойства.Вставить("СтруктураПроверкиИзмененияРегистра", СтруктураПроверкиИзмененияРегистра);

	КонецЕсли;
	
	РучнаяКорректировкаНалоговойБазы = ДополнительныеСвойства.Свойство("РучнаяКорректировкаНалоговойБазы")
										И ДополнительныеСвойства.РучнаяКорректировкаНалоговойБазы;
	
	Если РучнаяКорректировкаНалоговойБазы Или ТипЗнч(Отбор.Регистратор.Значение) = Тип("ДокументСсылка.ОперацияБух") Тогда
		
		Кеш = Новый Соответствие;
		
		Для Каждого Проводка Из ЭтотОбъект Цикл 
			Если Проводка.НаборКорректировок.Пустая() Тогда
				Проводка.НаборКорректировок = ПолучитьНаборКорректировок(Проводка.Организация, Кеш);
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;

КонецПроцедуры

Процедура ПриЗаписи(Отказ, Замещение)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли; 
	
	СтруктураПроверкиИзмененияРегистра = Неопределено;
	Если Не Отказ И ДополнительныеСвойства.Свойство("СтруктураПроверкиИзмененияРегистра", СтруктураПроверкиИзмененияРегистра) Тогда
		
		ИмяРегистра = "КорректировкиНалоговойБазы";
		Запрос = Новый Запрос;
		Запрос.МенеджерВременныхТаблиц = СтруктураПроверкиИзмененияРегистра.МенеджерВременныхТаблиц;
		
		Если НЕ ПланыОбмена.ГлавныйУзел() = Неопределено Тогда // В РИБ данный регистр обрабатывается только в главном узле.
			
			// Уничтожаем таблицу начальных записей регистра:
			Запрос.Текст = "УНИЧТОЖИТЬ НачальныеЗаписи" + ИмяРегистра;
			Запрос.Выполнить();
			Возврат;
			
		КонецЕсли;
		
		// Рассчитывается изменение нового набора относительно текущего с учетом накопленных изменений
		// и если отличия найдены, регистрируем задание на перерасчет налога на прибыль
		Запрос.Текст = СтруктураПроверкиИзмененияРегистра.ТекстВыборкиТаблицыИзменений;
		Запрос.УстановитьПараметр("Регистратор", Отбор.Регистратор.Значение);
		
		ТекстАктуализацииЗакрытияМесяца =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ТаблицаИзменений.Организация КАК Организация,
		|	ТаблицаИзменений.НаборКорректировок КАК Документ,
		|	ЗНАЧЕНИЕ(Справочник.ОперацииЗакрытияМесяца.ПерерасчетНалогаНаПрибыльПрошлыхПериодов) КАК Операция,
		|	НАЧАЛОПЕРИОДА(КарточкаКорректировки.ДатаНачалаПодготовкиДекларации, Месяц) КАК Месяц
		|ИЗ
		|	ТаблицаИзмененийКорректировкиНалоговойБазы КАК ТаблицаИзменений
		|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КорректировкиПрошлыхПериодовНУ КАК КарточкаКорректировки
		|	ПО ТаблицаИзменений.НаборКорректировок = КарточкаКорректировки.Ссылка
		|ГДЕ
		|	КарточкаКорректировки.СборКорректировокЗакрыт
		|";
				
		Запрос.Текст = Запрос.Текст + ОбщегоНазначения.РазделительПакетаЗапросов() + ТекстАктуализацииЗакрытияМесяца;
			
		// Уничтожаем таблицу изменений регистра:
		Запрос.Текст = Запрос.Текст + ОбщегоНазначения.РазделительПакетаЗапросов() + "УНИЧТОЖИТЬ ТаблицаИзмененийКорректировкиНалоговойБазы";
		
		Выборка = Запрос.Выполнить().Выбрать();
		РегистрыСведений.ЗаданияКЗакрытиюМесяца.СоздатьЗаписиРегистраПоДаннымВыборки(Выборка);
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПолучитьНаборКорректировок(Организация, Кеш)
	
	НаборКорректировок = Кеш.Получить(Организация);
	Если НаборКорректировок = Неопределено Тогда
		НаборКорректировок = Справочники.КорректировкиПрошлыхПериодовНУ.ОткрытыйНаборКорректировок(Организация);
		Кеш.Вставить(Организация, НаборКорректировок);
	КонецЕсли;
	Возврат НаборКорректировок;
	
КонецФункции

#КонецОбласти

#КонецЕсли