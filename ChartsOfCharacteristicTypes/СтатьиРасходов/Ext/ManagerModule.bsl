// Заполняет обработчик разделенных данных.
//
// Параметры:
//   Параметры - Структура - структура параметров обработчиков:
//     * РазделенныеОбработчики - см. ОбновлениеИнформационнойБазы.НоваяТаблицаОбработчиковОбновления
// 
Процедура ЗаполнитьОбработчикиРазделенныхДанных(Параметры = Неопределено) Экспорт
	
	Если Параметры <> Неопределено Тогда
		Обработчики = Параметры.РазделенныеОбработчики;
		Обработчик = Обработчики.Добавить();
		Обработчик.Версия = "11.5.26.36";
		Обработчик.Процедура = "ПланыВидовХарактеристик.СтатьиРасходов.ПроверитьДобавитьСтатьюКомиссионноеВознаграждение";
		Обработчик.РежимВыполнения = "Оперативно";
		Обработчик.Идентификатор = Новый УникальныйИдентификатор("e9f91957-88a0-41bd-b5a0-bae0dd1d5b969");
		Обработчик.Комментарий = НСтр("ru = 'При отсутствии статьи расходов с вариантом распределения ""На себестоимость продаж"" и отключенным контролем заполнения аналитики создает новый элемент ""Комиссионное вознаграждение"".';
										|en = 'If there is no expense item with the ""To cost of goods sold"" allocation option and disabled dimension population control, creates a new ""Commission"" item.'");
		
		Читаемые = Новый Массив;
		Читаемые.Добавить(Метаданные.ПланыВидовХарактеристик.СтатьиРасходов.ПолноеИмя());
		Обработчик.ЧитаемыеОбъекты = СтрСоединить(Читаемые, ",");
		
		Изменяемые = Новый Массив;
		Изменяемые.Добавить(Метаданные.ПланыВидовХарактеристик.СтатьиРасходов.ПолноеИмя());
		Обработчик.ИзменяемыеОбъекты = СтрСоединить(Изменяемые, ",");
	КонецЕсли;
	
КонецПроцедуры

