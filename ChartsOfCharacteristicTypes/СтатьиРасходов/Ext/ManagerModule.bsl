// Добавляет статью комиссионного вознаграждения, если не найдена статья с нужными настройками.
//
// Параметры:
//   Параметры - Структура - структура параметров обработчиков:
//     * РазделенныеОбработчики - см. ОбновлениеИнформационнойБазы.НоваяТаблицаОбработчиковОбновления
// 
Процедура ПроверитьДобавитьСтатьюКомиссионноеВознаграждение(Параметры = Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	СтатьиРасходов.Ссылка КАК Ссылка
	|ИЗ
	|	ПланВидовХарактеристик.СтатьиРасходов КАК СтатьиРасходов
	|ГДЕ
	|	СтатьиРасходов.ВариантРаспределенияРасходовРегл = ЗНАЧЕНИЕ(Перечисление.ВариантыРаспределенияРасходов.НаСебестоимостьПродаж)
	|	И СтатьиРасходов.ВариантРаспределенияРасходовУпр = ЗНАЧЕНИЕ(Перечисление.ВариантыРаспределенияРасходов.НаСебестоимостьПродаж)
	|	И СтатьиРасходов.ВариантРаспределенияРасходовНУ = ЗНАЧЕНИЕ(Перечисление.ВариантыРаспределенияРасходов.НаСебестоимостьПродаж)
	|	И НЕ СтатьиРасходов.КонтролироватьЗаполнениеАналитики
	|	И НЕ СтатьиРасходов.ПометкаУдаления";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если Не РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	НачатьТранзакцию();
	
	Попытка
		
		Элемент = СоздатьЭлемент();
		Элемент.Наименование = НСтр("ru = 'Комиссионное вознаграждение';
									|en = 'Commission'");
		Элемент.ТипРасходов = Перечисления.ТипыРасходов.ПродажаТоваров;
		Элемент.ТипЗначения = Новый ОписаниеТипов("СправочникСсылка.Партнеры");
		Элемент.ПравилоРаспределенияНаСебестоимостьПродажУпр =
			Перечисления.ПравилаРаспределенияНаСебестоимостьПродаж.ПропорциональноКоличеству;
		Элемент.ПравилоРаспределенияНаСебестоимостьПродажРегл =
			Перечисления.ПравилаРаспределенияНаСебестоимостьПродаж.ПропорциональноКоличеству;
		Элемент.ВариантРаспределенияРасходовРегл = Перечисления.ВариантыРаспределенияРасходов.НаСебестоимостьПродаж;
		Элемент.ВидДеятельностиРасходов = Перечисления.ВидыДеятельностиРасходов.ОсновнаяДеятельность;
		Элемент.УстановитьНовыйКод();
		ДополнитьЭлементСтатьиРасходов(Элемент);
		ОбновлениеИнформационнойБазы.ЗаписатьДанные(Элемент);
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		
		ОтменитьТранзакцию();
		ВызватьИсключение;
		
	КонецПопытки;
	
КонецПроцедуры

