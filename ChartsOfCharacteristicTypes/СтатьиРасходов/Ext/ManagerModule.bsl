//	Соответствие:
//		Ключ - ПланВидовХарактеристикСсылка.СтатьиРасходов - статья, для которой используется неизменяемый тип расходов;
//		Значение - ПеречислениеСсылка.ТипыРасходов - тип расхода который должен использоваться для статьи.
//
Функция СоответствиеСтатейТипамРасходов() Экспорт
	
	СоответствиеСтатейТипамРасходов = Новый Соответствие;
	
	//++ НЕ УТ
	СоответствиеСтатейТипамРасходов.Вставить(ПланыВидовХарактеристик.СтатьиРасходов.РасходыПриСписанииОС, Перечисления.ТипыРасходов.ПрочиеРасходы);
	СоответствиеСтатейТипамРасходов.Вставить(ПланыВидовХарактеристик.СтатьиРасходов.РасходыПриПродажеОС, Перечисления.ТипыРасходов.ПрочиеРасходы);
	СоответствиеСтатейТипамРасходов.Вставить(ПланыВидовХарактеристик.СтатьиРасходов.ВыбытиеМатериальныхЦенностей, Перечисления.ТипыРасходов.ПрочиеРасходы);
	СоответствиеСтатейТипамРасходов.Вставить(ПланыВидовХарактеристик.СтатьиРасходов.ПродажаМатериальныхЦенностей, Перечисления.ТипыРасходов.ПрочиеРасходы);
	СоответствиеСтатейТипамРасходов.Вставить(ПланыВидовХарактеристик.СтатьиРасходов.ДолгосрочныеАктивыКПродаже, Перечисления.ТипыРасходов.ПрочиеРасходы);
	//-- НЕ УТ
	СоответствиеСтатейТипамРасходов.Вставить(ПланыВидовХарактеристик.СтатьиРасходов.НДСНалоговогоАгента, Перечисления.ТипыРасходов.ЗакупкаТоваров);
	
	Возврат СоответствиеСтатейТипамРасходов;
	
КонецФункции

// Возвращает типы значений статьи расходов, распределяемой на продажу. Для перечисленных типов в качестве аналитики
//	статьи расходов будут выбираться именно эти документы.
//
//	Возвращаемое значение:
//		ОписаниеТипов - описание типа, которое будет назначаться такой статье.
Функция ТипыДокументовСтатейРаспределяемыхНаПродажу() Экспорт
	
	МассивТиповДокументов = Новый Массив;
	МассивДокументов = СписокДокументовДляСтатейРаспределяемыхНаПродажу().ВыгрузитьЗначения();
	Для каждого МетаданныеДокумента Из МассивДокументов Цикл
		МассивТиповДокументов.Добавить("ДокументСсылка." + МетаданныеДокумента.Имя);
	КонецЦикла;
	
	ТипыДокументовСтрокой = СтрСоединить(МассивТиповДокументов, ",");
	Возврат Новый ОписаниеТипов(ТипыДокументовСтрокой);
	
КонецФункции

// Возвращает идентификаторы объектов метаданных документов статьи расходов, распределяемой на продажу.
// Для перечисленных типов в качестве аналитики статьи расходов будут выбираться именно эти документы.
//
//	Возвращаемое значение:
//		Массив из СправочникСсылка.ИдентификаторыОбъектовМетаданных - документы, которые могут выбираться в качестве аналитики
//	статьи расходов, распределяемой на продажу.
Функция ИдентификаторыДокументовСтатейРаспределяемыхНаПродажу() Экспорт
	
	МассивИдентификаторов = Новый Массив;
	Для каждого МетаданныеДокумента Из СписокДокументовДляСтатейРаспределяемыхНаПродажу() Цикл
		
		Если Не ПравоДоступа("Чтение", МетаданныеДокумента.Значение) ИЛИ Не МетаданныеДокумента.Пометка Тогда
			Продолжить;
		КонецЕсли;
		
		МассивИдентификаторов.Добавить(ОбщегоНазначения.ИдентификаторОбъектаМетаданных(МетаданныеДокумента.Значение));
		
	КонецЦикла;
	
	Возврат МассивИдентификаторов;
	
КонецФункции

