#Область Прочее
&НаКлиенте
Процедура УстановитьСтатусКартыИсследованияТоваров(ЗначениеСтатуса, ПредставлениеСтатуса)

	ВыделенныеСсылки = ОбщегоНазначенияУТКлиент.ПроверитьПолучитьВыделенныеВСпискеСсылки(Элементы.Список);
	
	ИсследованиеТоваровКлиент.УстановитьСтатусКартИсследованияТоваров(ЗначениеСтатуса, ПредставлениеСтатуса, ВыделенныеСсылки);

КонецПроцедуры

&НаСервере
Процедура ОтборНоменклатураПриИзмененииНаСервере()

	ТекстыЗапроса = Новый Массив;
	
	Если ЗначениеЗаполнено(ОтборНоменклатура) Тогда
		
		ТекстыЗапроса.Добавить("
		|ВЫБРАТЬ
		|	Т.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.КартыИсследованияТоваров.Товары КАК Т
		|ГДЕ
		|	Т.Номенклатура = &Номенклатура
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	Т.Ссылка
		|ИЗ
		|	Справочник.КартыИсследованияТоваров.Товары КАК Т
		|ГДЕ
		|	Т.Номенклатура = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
		|	И Т.ВидНоменклатуры = &ВидНоменклатуры
		|");
		
	КонецЕсли;
	
	СписокОтбора = Новый СписокЗначений;
	Использовать = (ТекстыЗапроса.Количество() > 0);
	
	Если Использовать Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = СтрСоединить(ТекстыЗапроса, " ОБЪЕДИНИТЬ ");
		Запрос.УстановитьПараметр("Номенклатура",    ОтборНоменклатура);
		ВидНоменклатуры = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОтборНоменклатура, "ВидНоменклатуры");
		Запрос.УстановитьПараметр("ВидНоменклатуры", ВидНоменклатуры);
		
		СписокОтбора.ЗагрузитьЗначения(Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка"));
		
		Если ОтборВидНоменклатуры <> ВидНоменклатуры Тогда
			ОтборВидНоменклатуры = Неопределено;
			ОбщегоНазначенияКлиентСервер.УдалитьЭлементыГруппыОтбораДинамическогоСписка(Список, "Ссылка");
		КонецЕсли;
		
	КонецЕсли;
		
	ОтборПоНоменклатуре = ОбщегоНазначенияКлиентСервер.СоздатьГруппуЭлементовОтбора(
		Список.КомпоновщикНастроек.ФиксированныеНастройки.Отбор.Элементы,
		НСтр("ru = 'Отбор по номенклатуре';
			|en = 'Filter by items'"),
		ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИ);
	
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(
			ОтборПоНоменклатуре,
			"Ссылка",
			ВидСравненияКомпоновкиДанных.ВСписке,
			СписокОтбора,
			,
			Использовать);

КонецПроцедуры

&НаСервере
Процедура ОтборВидНоменклатурыПриИзмененииНаСервере()

	ТекстыЗапроса = Новый Массив;
	
	Если ЗначениеЗаполнено(ОтборВидНоменклатуры) Тогда
		
		ТекстыЗапроса.Добавить("
		|ВЫБРАТЬ
		|	Т.Ссылка
		|ИЗ
		|	Справочник.КартыИсследованияТоваров.Товары КАК Т
		|ГДЕ
		|	Т.ВидНоменклатуры = &ВидНоменклатуры
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	Т.Ссылка
		|ИЗ
		|	Справочник.КартыИсследованияТоваров.Товары КАК Т
		|ГДЕ
		|	Т.Номенклатура.ВидНоменклатуры = &ВидНоменклатуры
		|");
		
	КонецЕсли;
	
	СписокОтбора = Новый СписокЗначений;
	Использовать = (ТекстыЗапроса.Количество() > 0);
	
	Если Использовать Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = СтрСоединить(ТекстыЗапроса, " ОБЪЕДИНИТЬ ");
		Запрос.УстановитьПараметр("ВидНоменклатуры", ОтборВидНоменклатуры);
		
		СписокОтбора.ЗагрузитьЗначения(Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка"));
		
		ВидНоменклатуры = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОтборНоменклатура, "ВидНоменклатуры");
		Если ОтборВидНоменклатуры <> ВидНоменклатуры Тогда
			ОтборНоменклатура = Неопределено;
			ОбщегоНазначенияКлиентСервер.УдалитьЭлементыГруппыОтбораДинамическогоСписка(Список, "Ссылка");
		КонецЕсли;
		
	КонецЕсли;
	
	ОтборПоВидуНоменклатуры = ОбщегоНазначенияКлиентСервер.СоздатьГруппуЭлементовОтбора(
		Список.КомпоновщикНастроек.ФиксированныеНастройки.Отбор.Элементы,
		НСтр("ru = 'Отбор по виду номенклатуры';
			|en = 'Filter by item kind'"),
		ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИ);
	
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(
			ОтборПоВидуНоменклатуры,
			"Ссылка",
			ВидСравненияКомпоновкиДанных.ВСписке,
			СписокОтбора,
			,
			Использовать);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимость()
	
	ЕстьДоступНаИзменение = ПравоДоступа("Изменение", Метаданные.Справочники.КартыИсследованияТоваров);
	
	Элементы.СписокУстановитьСтатусВРазработке.Видимость = ЕстьДоступНаИзменение;
	Элементы.СписокУстановитьСтатусДействует.Видимость = ЕстьДоступНаИзменение;
	Элементы.СписокУстановитьСтатусЗакрыта.Видимость = ЕстьДоступНаИзменение;
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти
