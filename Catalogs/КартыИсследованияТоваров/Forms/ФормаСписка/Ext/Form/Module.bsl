#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСписок

&НаСервереБезКонтекста
Процедура СписокПриПолученииДанныхНаСервере(ИмяЭлемента, Настройки, Строки)
	
	ШаблонВидноменклатуры = Нстр("ru = '%1 %2 %3';
								|en = '%1 %2 %3'");
	ШаблонСписокНоменклатуры = Нстр("ru = '%1 %2';
									|en = '%1 %2'");
	ШаблонНесколькоПозиций = Нстр("ru = '%1 и еще %2';
									|en = '%1 and %2 more'");
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	КартыИсследованияТоваровТовары.Ссылка КАК Ссылка,
		|	КартыИсследованияТоваровТовары.Номенклатура КАК Номенклатура,
		|	КартыИсследованияТоваровТовары.Характеристика КАК Характеристика,
		|	КартыИсследованияТоваровТовары.ВидНоменклатуры КАК ВидНоменклатуры,
		|	КартыИсследованияТоваровТовары.Ссылка.ВариантНазначения КАК ВариантНазначения
		|ИЗ
		|	Справочник.КартыИсследованияТоваров.Товары КАК КартыИсследованияТоваровТовары
		|ГДЕ
		|	КартыИсследованияТоваровТовары.Ссылка В(&Ссылки)
		|ИТОГИ ПО
		|	Ссылка";
	
	Запрос.УстановитьПараметр("Ссылки", Строки.ПолучитьКлючи());
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаСсылка = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаСсылка.Следующий() Цикл
		
		ПерваяПозиция = Истина;
		КоличествоПозиций = 1;
		ВыборкаДетальныеЗаписи = ВыборкаСсылка.Выбрать();
	
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			Если ПерваяПозиция Тогда
				ПерваяПозиция = Ложь;
				Если ВыборкаДетальныеЗаписи.ВариантНазначения
					= Перечисления.ВариантыНазначенияКартыИсследованияТоваров.ВидНоменклатуры Тогда
					Представление = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонВидноменклатуры, 
						?(ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.ВидНоменклатуры), Строка(
						ВыборкаДетальныеЗаписи.ВидНоменклатуры) + ";", ""), ?(ЗначениеЗаполнено(
						ВыборкаДетальныеЗаписи.Номенклатура), Строка(ВыборкаДетальныеЗаписи.Номенклатура) + ";", ""),
						?(ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.Характеристика), Строка(
						ВыборкаДетальныеЗаписи.Характеристика) + ";", ""));
				Иначе
					Представление = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонСписокНоменклатуры,
						?(ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.Номенклатура), Строка(
						ВыборкаДетальныеЗаписи.Номенклатура) + ";", ""), ?(ЗначениеЗаполнено(
						ВыборкаДетальныеЗаписи.Характеристика), Строка(ВыборкаДетальныеЗаписи.Характеристика) + ";", ""));
				КонецЕсли;
			Иначе
				КоличествоПозиций = КоличествоПозиций + 1;
			КонецЕсли;
		КонецЦикла;
		
		СтрокаСписка = Строки[ВыборкаСсылка.Ссылка];
		Если КоличествоПозиций > 1 Тогда
			Если ТекущийЯзык().КодЯзыка = "ru" Тогда
				ПредставлениеКоличествоПозиций = ПолучитьСклоненияСтрокиПоЧислу("позиция", КоличествоПозиций - 1, "",
					"ЧС=Количественное", "ПД=Именительный; ПЧ=Число");
				СтрокаСписка.Данные["Текст"] = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					ШаблонНесколькоПозиций, СокрЛП(Представление), ПредставлениеКоличествоПозиций[0]);
			Иначе
				СтрокаСписка.Данные["Текст"] = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					ШаблонНесколькоПозиций, Представление, Строка(КоличествоПозиций - 1));
			КонецЕсли;
		Иначе
			Представление = СокрЛП(Представление);
			СтроковыеФункцииКлиентСервер.УдалитьПоследнийСимволВСтроке(Представление);
			СтрокаСписка.Данные["Текст"] = Представление;
		КонецЕсли;
		СтрокаСписка.Оформление["Текст"].УстановитьЗначениеПараметра("ЦветТекста", WebЦвета.Синий);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

