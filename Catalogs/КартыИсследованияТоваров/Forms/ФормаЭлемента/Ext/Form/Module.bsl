&НаКлиентеНаСервереБезКонтекста
Процедура НастроитьЗависимыеЭлементыФормы(Форма, СписокРеквизитов = "")
	
	Объект = Форма.Объект;
	Элементы = Форма.Элементы;
	
	Инициализация = ПустаяСтрока(СписокРеквизитов);
	СтруктураРеквизитов = Новый Структура(СписокРеквизитов);
	
	Если СтруктураРеквизитов.Свойство("Контроль")
		ИЛИ Инициализация Тогда
		
		ВидКонтроляВыборочный = Объект.Контроль = ПредопределенноеЗначение("Перечисление.КонтрольКачества.Выборочный");
		Элементы.ВариантОтбораОбразцов.Видимость = ВидКонтроляВыборочный;
		
		Если ЗначениеЗаполнено(Объект.ВариантОтбораОбразцов) И ВидКонтроляВыборочный Тогда
			ВариантОтбораОбразцовПроцент = Объект.ВариантОтбораОбразцов = ПредопределенноеЗначение("Перечисление.ВариантыОтбораОбразцовИсследованияТоваров.Процент");
			Элементы.КоличествоОбразцов.Видимость    = Не ВариантОтбораОбразцовПроцент;
			Элементы.ПроцентОбразцов.Видимость       = ВариантОтбораОбразцовПроцент;
		Иначе
			Элементы.КоличествоОбразцов.Видимость    = Ложь;
			Элементы.ПроцентОбразцов.Видимость       = Ложь;
		КонецЕсли;
		
	КонецЕсли;
	
	Если СтруктураРеквизитов.Свойство("ВариантОтбораОбразцов")
		ИЛИ Инициализация Тогда
		
		ВидКонтроляВыборочный = Объект.Контроль = ПредопределенноеЗначение("Перечисление.КонтрольКачества.Выборочный");
		ВариантОтбораОбразцовПроцент = Объект.ВариантОтбораОбразцов = ПредопределенноеЗначение("Перечисление.ВариантыОтбораОбразцовИсследованияТоваров.Процент");
		
		Если ЗначениеЗаполнено(Объект.ВариантОтбораОбразцов) И ВидКонтроляВыборочный Тогда
			Элементы.КоличествоОбразцов.Видимость = Не ВариантОтбораОбразцовПроцент;
			Элементы.ПроцентОбразцов.Видимость    = ВариантОтбораОбразцовПроцент;
		Иначе
			Элементы.КоличествоОбразцов.Видимость = Ложь;
			Элементы.ПроцентОбразцов.Видимость    = Ложь;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьПредставлениеОбластиДействия()
	
	ПредставлениеОбластиДействия = НСтр("ru = 'Область применения не задана';
										|en = 'Scope is not set'");
	
	Если Объект.Товары.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ШаблонВидноменклатуры = НСтр("ru = '%1 %2 %3';
								|en = '%1 %2 %3'");
	ШаблонСписокНоменклатуры = НСтр("ru = '%1 %2';
									|en = '%1 %2'");
	ШаблонНесколькоПозиций = НСтр("ru = '%1 и еще %2';
									|en = '%1 and %2 more'");
	
	ПерваяПозиция = Истина;
	КоличествоПозиций = 1;

	Для Каждого СтрокаТовары Из Объект.Товары Цикл

		Если ПерваяПозиция Тогда
			ПерваяПозиция = Ложь;
			Если Объект.ВариантНазначения = Перечисления.ВариантыНазначенияКартыИсследованияТоваров.ВидНоменклатуры Тогда
				Представление = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонВидноменклатуры, 
					?(ЗначениеЗаполнено(СтрокаТовары.ВидНоменклатуры), Строка(СтрокаТовары.ВидНоменклатуры) + ";", ""),
					?(ЗначениеЗаполнено(СтрокаТовары.Номенклатура), Строка(СтрокаТовары.Номенклатура) + ";", ""),
					?(ЗначениеЗаполнено(СтрокаТовары.Характеристика), Строка(СтрокаТовары.Характеристика) + ";", ""));
			Иначе
				Представление = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонСписокНоменклатуры,
				?(ЗначениеЗаполнено(СтрокаТовары.Номенклатура), Строка(СтрокаТовары.Номенклатура) + ";", ""),
				?(ЗначениеЗаполнено(СтрокаТовары.Характеристика), Строка(СтрокаТовары.Характеристика) + ";", ""));
			КонецЕсли;
		Иначе
			КоличествоПозиций = КоличествоПозиций + 1;
		КонецЕсли;

	КонецЦикла;
	
	Если КоличествоПозиций > 1 Тогда 
		Если ТекущийЯзык().КодЯзыка = "ru" Тогда
			ПредставлениеКоличествоПозиций = ПолучитьСклоненияСтрокиПоЧислу("позиция", КоличествоПозиций - 1, "",
				"ЧС=Количественное", "ПД=Именительный; ПЧ=Число");
			ПредставлениеОбластиДействия = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				ШаблонНесколькоПозиций, Представление, ПредставлениеКоличествоПозиций[0]);
		Иначе
			ПредставлениеОбластиДействия = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				ШаблонНесколькоПозиций, Представление, Строка(КоличествоПозиций - 1));
		КонецЕсли;
	Иначе
		Представление = СокрЛП(Представление);
		СтроковыеФункцииКлиентСервер.УдалитьПоследнийСимволВСтроке(Представление);
		ПредставлениеОбластиДействия = Представление;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьНовыйСтатусИЗаписать(Статус)

	ОчиститьСообщения();
	Отказ = Ложь;

	Если Объект.ПометкаУдаления Тогда
		ТекстПредупреждения = НСтр("ru = 'Нельзя изменить статус помеченной на удаление карты исследования товаров.';
									|en = 'Cannot change the status of a goods research sheet marked for deletion.'");
		ПоказатьПредупреждение( , ТекстПредупреждения);
		Возврат;
	КонецЕсли;

	Если Статус = ПредопределенноеЗначение("Перечисление.СтатусыКартыИсследованияТоваров.Действует") Тогда

		Если Объект.Товары.Количество() = 0 Тогда

			ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Поле", "Заполнение", НСтр(
			"ru = 'Применяется к';
			|en = 'Applies to'"), , , НСтр(
			"ru = 'Не указана область применения карты исследования товаров';
			|en = 'The scope of the goods research sheet is not specified'"));
			ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения, , "ПредставлениеОбластиДействия", , Отказ);

		КонецЕсли;

	КонецЕсли;

	Если Не Отказ Тогда

		ЗаписатьКартуИсследованияНаСервере(Статус);

	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ЗаписатьКартуИсследованияНаСервере(Знач Статус = Неопределено)
	
	Результат      = Ложь;
	ИзменитьСтатус = Статус <> Неопределено И Объект.Статус <> Статус;
	
	Если ИзменитьСтатус Тогда
		ТекущийСтатус = Объект.Статус;
		Объект.Статус = Статус;
	КонецЕсли;
	
	Попытка
		
		Результат = Записать();
		
	Исключение
		
		Если ИзменитьСтатус Тогда
			СобытиеЖурналаРегистрации = НСтр("ru = 'Не удалось изменить статус карты исследования товаров';
											|en = 'Cannot change the goods research sheet status'",
				ОбщегоНазначения.КодОсновногоЯзыка());
		Иначе
			СобытиеЖурналаРегистрации = НСтр("ru = 'Не удалось записать карту исследования товаров';
											|en = 'Cannot save the goods research sheet'",
				ОбщегоНазначения.КодОсновногоЯзыка());
		КонецЕсли;
		
		ЗаписьЖурналаРегистрации(
			СобытиеЖурналаРегистрации,
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		
	КонецПопытки;
	
	Если ИзменитьСтатус И Не Результат Тогда
		Объект.Статус = ТекущийСтатус;
	КонецЕсли;
	
	Возврат Результат;

КонецФункции

// Оповещение о завершении настройки области действия карты исследования товаров
// 
// Параметры:
// 	РезультатНастройки - Структура - из:
// 		* ОтборПоСвойствам - ТаблицаЗначений - таблица отбора по свойствам
// 		* Описание - Строка - описание настройки
// 	ДополнительныеПараметры - Структура - дополнительные параметры
&НаКлиенте
Процедура ОткрытьФормуВводаОбластиДействияЗавершение(РезультатНастройки, ДополнительныеПараметры) Экспорт
	
	Если РезультатНастройки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Модифицированность = Истина;
	
	ИсследованиеТоваровКлиент.ОбновитьТабличнуюЧасть(
		Объект.ОтборПоСвойствам,
		РезультатНастройки.ОтборПоСвойствам);
		
	ИсследованиеТоваровКлиент.ОбновитьТабличнуюЧасть(
		Объект.Товары,
		РезультатНастройки.СписокНоменклатуры);
	
	Объект.ВариантНазначения = РезультатНастройки.ВариантНастройки;
	
	ОбновитьПредставлениеОбластиДействия();
	
КонецПроцедуры

&НаСервере
Процедура НастроитьЭлементыФормы()

	УстановитьДоступностьЭлементовПоСтатусуСервер();
	УстановитьДоступностьКомандИзмененияСтатуса();
	
	НастроитьЗависимыеЭлементыФормы(ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьДоступностьЭлементовПоСтатусуСервер()
	
	Если ТолькоПросмотр Тогда
		Возврат;
	КонецЕсли;
	
	ДоступностьРеквизитов = (Объект.Статус = Перечисления.СтатусыКартыИсследованияТоваров.Черновик);
	
	МассивЭлементов = Справочники.КартыИсследованияТоваров.ПолучитьБлокируемыеРеквизитыОбъекта();

	ОбщегоНазначенияУТКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, МассивЭлементов, "ТолькоПросмотр", НЕ ДоступностьРеквизитов);
	
	ИмяОбластиДействия = Элементы.ПредставлениеОбластиДействия.Имя;
	ЭлементОбластиДействия = МассивЭлементов.Найти(ИмяОбластиДействия);
	Если ЭлементОбластиДействия <> Неопределено Тогда
		ОбщегоНазначенияУТКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, ИмяОбластиДействия, "Доступность", ДоступностьРеквизитов);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьДоступностьКомандИзмененияСтатуса()
	
	Элементы.УстановитьСтатусДействует.Доступность	= (Объект.Статус <> Перечисления.СтатусыКартыИсследованияТоваров.Действует);
	Элементы.УстановитьСтатусЗакрыта.Доступность	= (Объект.Статус <> Перечисления.СтатусыКартыИсследованияТоваров.Закрыта);
	Элементы.УстановитьСтатусЧерновик.Доступность	= (Объект.Статус <> Перечисления.СтатусыКартыИсследованияТоваров.Черновик);

КонецПроцедуры

&НаСервере
Процедура ПроверитьОчиститьРеквизитыПриИзмененииВидКонтроля()
	
	ВидКонтроляСплошной = Объект.Контроль = ПредопределенноеЗначение("Перечисление.КонтрольКачества.Сплошной");

	Если ВидКонтроляСплошной Тогда
		Объект.КоличествоОбразцов = 0;
		Объект.ПроцентОбразцов = 0;
	КонецЕсли;
	
	НастроитьЗависимыеЭлементыФормы(ЭтотОбъект, "Контроль");
	
КонецПроцедуры

&НаСервере
Процедура ПроверитьОчиститьРеквизитыПриИзмененииВариантаОтбораОбразцов()
	
	ВариантОтбораОбразцовПроцент = Объект.ВариантОтбораОбразцов = ПредопределенноеЗначение("Перечисление.ВариантыОтбораОбразцовИсследованияТоваров.Процент");

	Если ВариантОтбораОбразцовПроцент Тогда
		Объект.КоличествоОбразцов = 0;
	Иначе
		Объект.ПроцентОбразцов = 0;
	КонецЕсли;
	
	НастроитьЗависимыеЭлементыФормы(ЭтотОбъект, "ВариантОтбораОбразцов");
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимость()
	
	ЕстьДоступНаИзменение = ПравоДоступа("Изменение", Метаданные.Справочники.КартыИсследованияТоваров);
	ДоступностьРеквизитов = (Объект.Статус = Перечисления.СтатусыКартыИсследованияТоваров.Черновик);
	
	Элементы.УстановитьСтатусДействует.Доступность = ЕстьДоступНаИзменение И (Объект.Статус <> Перечисления.СтатусыКартыИсследованияТоваров.Действует);
	Элементы.УстановитьСтатусЗакрыта.Доступность = ЕстьДоступНаИзменение И (Объект.Статус <> Перечисления.СтатусыКартыИсследованияТоваров.Закрыта);
	Элементы.УстановитьСтатусЧерновик.Доступность = ЕстьДоступНаИзменение И (Объект.Статус <> Перечисления.СтатусыКартыИсследованияТоваров.Черновик);
	Элементы.ПредставлениеОбластиДействия.Доступность = ЕстьДоступНаИзменение И ДоступностьРеквизитов;
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти