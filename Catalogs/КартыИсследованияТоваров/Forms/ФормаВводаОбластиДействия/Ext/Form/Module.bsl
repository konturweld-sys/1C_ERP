#Область ОписаниеПеременных

&НаКлиенте
Перем КэшированныеЗначения;

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("АвтоТест") Тогда // Возврат при получении формы для анализа.
		Возврат;
	КонецЕсли;
	
	Если Параметры.Свойство("ВариантНастройки") Тогда
		ВариантНастройки = Параметры.ВариантНастройки;
	КонецЕсли;

	ОтборПоСвойствамТЧ = Новый Массив;
	СписокТоваровТЧ = Новый Массив;
	
	Если Параметры.Свойство("ОтборПоСвойствам") Тогда
		ОтборПоСвойствамТЧ = Параметры.ОтборПоСвойствам;
	КонецЕсли;
	
	Если Параметры.Свойство("СписокНоменклатуры") Тогда
		СписокТоваровТЧ = Параметры.СписокНоменклатуры;
	КонецЕсли;
	
	Если ОтборПоСвойствамТЧ.Количество() > 0 Тогда
		МассивСтруктурВТаблицуЗначений(ОтборПоСвойствамТЧ, ОтборПоСвойствам, Истина);
	КонецЕсли;
	
	Если СписокТоваровТЧ.Количество() > 0 И ВариантНастройки = ПредопределенноеЗначение(
		"Перечисление.ВариантыНазначенияКартыИсследованияТоваров.СписокНоменклатуры") Тогда
		МассивСтруктурВТаблицуЗначений(СписокТоваровТЧ, СписокТоваров, Ложь);
	ИначеЕсли СписокТоваровТЧ.Количество() = 1 Тогда
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, СписокТоваровТЧ[0], "ВидНоменклатуры, Номенклатура, Характеристика");
	КонецЕсли;
	
	УстановитьУсловноеОформление();
	УстановитьДоступностьЭлементов();
	
	ЗаполнитьСлужебныеРеквизитыИспользованияСвойствХарактеристик();
	ОбновитьИнформацию(ОтборПоСвойствам);
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Если Модифицированность Тогда 
		ОчиститьСообщения();
		ТекстВопроса = НСтр("ru = 'Данные были изменены. Сохранить изменения?';
							|en = 'The data has changed. Do you want to save the changes?'");
		Оповещение = Новый ОписаниеОповещения("ЗаписатьИЗакрытьНаКлиенте", ЭтотОбъект);
		ОбщегоНазначенияКлиент.ПоказатьПодтверждениеЗакрытияФормы(Оповещение, Отказ, ЗавершениеРаботы, ТекстВопроса); 
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ПересчитатьНомераСтрок();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ВариантНастройкиПриИзменении(Элемент)
	ВариантНастройкиПриИзмененииНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура НоменклатураПриИзменении(Элемент)
	НоменклатураПриИзмененииНаСервере();
	Модифицированность = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ХарактеристикаПриИзменении(Элемент)
	ХарактеристикаПриИзмененииНаСервере();
	Модифицированность = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ВидНоменклатурыПриИзменении(Элемент)
	ВидНоменклатурыПриИзмененииНаСервере();
	Модифицированность = Истина;
КонецПроцедуры

&НаКлиенте
Процедура НоменклатураОчистка(Элемент, СтандартнаяОбработка)
	ВидНоменклатурыПриИзмененииНаСервере();
	Модифицированность = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ВидНоменклатурыОчистка(Элемент, СтандартнаяОбработка)
	ВидНоменклатурыПриИзмененииНаСервере();
	Модифицированность = Истина;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыТовары

&НаКлиенте
Процедура ТоварыНоменклатураПриИзменении(Элемент)
	СтрокаТаблицы = Элементы.Товары.ТекущиеДанные;
	Если СтрокаТаблицы <> Неопределено Тогда
		Если ЗначениеЗаполнено(СтрокаТаблицы.Номенклатура) Тогда
			СтрокаТаблицы.ВидНоменклатуры = ПолучитьВидНоменклатуры(СтрокаТаблицы.Номенклатура);
		КонецЕсли;
	КонецЕсли;

	ЗаполнитьПризнакХарактеристикиИспользуются = Новый Структура("Номенклатура", "ХарактеристикиИспользуются");

	СтруктураДействий = Новый Структура();
	СтруктураДействий.Вставить("ЗаполнитьПризнакХарактеристикиИспользуются", ЗаполнитьПризнакХарактеристикиИспользуются);
	СтруктураДействий.Вставить("ПроверитьХарактеристикуПоВладельцу", СтрокаТаблицы.Характеристика);
	
	ПакетнаяОбработкаТабличнойЧастиКлиент.ОбработатьСтрокуТЧ(СтрокаТаблицы, СтруктураДействий, КэшированныеЗначения);
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыПриИзменении(Элемент)
	
	ПересчитатьНомераСтрок();
	Модифицированность = Истина;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура УточнениеПримененияНоменклатура(Команда)
	ОткрытьНастройкуУточненияПримененияТребования("Номенклатура");
КонецПроцедуры

&НаКлиенте
Процедура УточнениеПримененияХарактеристика(Команда)
	ОткрытьНастройкуУточненияПримененияТребования("Характеристика");
КонецПроцедуры

&НаКлиенте
Процедура КомандаОК(Команда)
	
	ОчиститьСообщения();
	Если Модифицированность Тогда
		ЗавершитьРедактирование();
	Иначе
		Закрыть();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаОтмена(Команда)
	
	Модифицированность = Ложь;
	
	Закрыть();
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ВыполнитьПереопределяемуюКоманду(Команда)
	
	СобытияФормКлиент.ВыполнитьПереопределяемуюКоманду(ЭтотОбъект, Команда);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ЗавершитьРедактирование()
	
	ОтборПоСвойствамМассив = Новый Массив;
	
	Если ВариантНастройки = ПредопределенноеЗначение(
		"Перечисление.ВариантыНазначенияКартыИсследованияТоваров.ВидНоменклатуры") Тогда
		СписокНоменклатурыМассив = Новый Массив;
		ДанныеСтруктуры = Новый Структура;
		ДанныеСтруктуры.Вставить("ВидНоменклатуры", ВидНоменклатуры);
		ДанныеСтруктуры.Вставить("Номенклатура", Номенклатура);
		ДанныеСтруктуры.Вставить("Характеристика", Характеристика);
		Если ЗначениеЗаполнено(ВидНоменклатуры) Или ЗначениеЗаполнено(Номенклатура) Или ЗначениеЗаполнено(
			Характеристика) Тогда
			СписокНоменклатурыМассив.Добавить(ДанныеСтруктуры);
		КонецЕсли;
		ОтборПоСвойствамМассив = ИсследованиеТоваровКлиент.РеквизитыТаблицыВМассивСтруктур(
			ОтборПоСвойствам, ИсследованиеТоваровКлиент.РеквизитыОтбораПоСвойствам());
	Иначе
		Отказ = Ложь;
		СтрокиСОшибками = Новый Массив;
		ПроверитьЗаполнениеСпискаНоменклатуры(СписокТоваров, СтрокиСОшибками, Отказ);
		Если Не ПроверитьЗаполнение() Или Отказ Тогда
			Для Каждого Ошибка Из СтрокиСОшибками Цикл
				Если Ошибка.ТипОшибки = "ПроверкаХарактеристик" Тогда
					ТекстОшибки = СтрШаблон(НСтр(
						"ru = 'Не заполнена колонка ""Характеристика"" в строке %1 списка ""Список номенклатуры""';
						|en = 'The ""Variant"" column in line %1 of the ""Item list"" list is not filled in'"),
						Ошибка.НомерСтроки);
					ОбщегоНазначенияКлиент.СообщитьПользователю(
						ТекстОшибки, , ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("СписокТоваров", 
						Ошибка.НомерСтроки, "Характеристика"), , Отказ);
				ИначеЕсли Ошибка.ТипОшибки = "ПроверкаДублей" Тогда
					ТекстОшибки = СтрШаблон(
					НСтр("ru = 'В строке %1 списка ""Список номенклатуры"" дублируется номенклатура ""%2""';
						|en = 'In line %1 of the ""Item list"" list, the ""%2"" is duplicated'"),
						Ошибка.НомерСтроки, Ошибка.Номенклатура);
					ОбщегоНазначенияКлиент.СообщитьПользователю(
						ТекстОшибки, , ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("СписокТоваров", 
						Ошибка.НомерСтроки, "Номенклатура"), , Отказ);
				КонецЕсли;
			КонецЦикла;
			Возврат;
		КонецЕсли;
		СписокНоменклатурыМассив = ИсследованиеТоваровКлиент.РеквизитыТаблицыВМассивСтруктур(
			СписокТоваров, ИсследованиеТоваровКлиент.РеквизитыНастройкаСписокНоменклатуры());
	КонецЕсли;

	Модифицированность = Ложь;
	
	Закрыть(Новый Структура("ОтборПоСвойствам,СписокНоменклатуры,ВариантНастройки",ОтборПоСвойствамМассив, СписокНоменклатурыМассив, ВариантНастройки));
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьИЗакрытьНаКлиенте(Результат, ДополнительныеПараметры) Экспорт 
	
	ЗавершитьРедактирование();
	
КонецПроцедуры

&НаСервере
Процедура ПроверитьОчиститьРеквизитыПриИзмененииВариантаНазначения()
	
	Если ВариантНастройки = Перечисления.ВариантыНазначенияКартыИсследованияТоваров.ВидНоменклатуры Тогда
		ВидНоменклатуры = Неопределено;
		Номенклатура	= Неопределено;
		Характеристика	= Неопределено;
		ИсследованиеТоваров.ОчиститьНастройкиУточненияПримененияКартыИсследованияТоваров(ОтборПоСвойствам);
	КонецЕсли;
	
	Если ВариантНастройки = Перечисления.ВариантыНазначенияКартыИсследованияТоваров.СписокНоменклатуры Тогда
		СписокТоваров.Очистить();
		Если НЕ ЗначениеЗаполнено(Номенклатура) Тогда
			ИсследованиеТоваров.ОчиститьНастройкиУточненияПримененияКартыИсследованияТоваров(ОтборПоСвойствам);
		КонецЕсли;
	КонецЕсли;
	
	ЗаполнитьСлужебныеРеквизитыИспользованияСвойствХарактеристик();
	
КонецПроцедуры

&НаСервере
Процедура НоменклатураПриИзмененииНаСервере()
	
	Если ЗначениеЗаполнено(Номенклатура) Тогда
		ОтборВидНоменклатуры = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Номенклатура, "ВидНоменклатуры");
		Если ОтборВидНоменклатуры <> ВидНоменклатуры Тогда
			ВидНоменклатуры = ОтборВидНоменклатуры;
		КонецЕсли;
	КонецЕсли;
	
	ЗаполнитьСлужебныеРеквизитыИспользованияСвойствХарактеристик();
	ИсследованиеТоваров.ОчиститьНастройкиУточненияПримененияКартыИсследованияТоваров(ОтборПоСвойствам);
	
	ОбновитьИнформацию(ОтборПоСвойствам);
	
КонецПроцедуры

&НаСервере
Процедура ХарактеристикаПриИзмененииНаСервере()

	ИсследованиеТоваров.ОчиститьНастройкиУточненияПримененияКартыИсследованияТоваров(ОтборПоСвойствам);
	ОбновитьИнформацию(ОтборПоСвойствам);
	
КонецПроцедуры

&НаСервере
Процедура ВидНоменклатурыПриИзмененииНаСервере()
	
	Если ЗначениеЗаполнено(ВидНоменклатуры) Тогда
		ОтборВидНоменклатуры = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Номенклатура, "ВидНоменклатуры");
		Если ОтборВидНоменклатуры <> ВидНоменклатуры Тогда
			Номенклатура = Неопределено;
		КонецЕсли; 
	Иначе
		Номенклатура = Неопределено;
	КонецЕсли;
	
	ЗаполнитьСлужебныеРеквизитыИспользованияСвойствХарактеристик();
	
	ИсследованиеТоваров.ОчиститьНастройкиУточненияПримененияКартыИсследованияТоваров(ОтборПоСвойствам);
	
	ОбновитьИнформацию(ОтборПоСвойствам);
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьИнформацию(Знач ОтборПоСвойствам1)

	ДоступностьУточненийПрименения = Новый Структура("Номенклатура,Характеристика",Истина,Истина);
	
	ВариантНазначенияВидНоменклатуры = (ВариантНастройки = ПредопределенноеЗначение("Перечисление.ВариантыНазначенияКартыИсследованияТоваров.ВидНоменклатуры"));
	
	ИспользоватьХарактеристикиНоменклатуры = ПолучитьФункциональнуюОпцию("ИспользоватьХарактеристикиНоменклатуры");
	Элементы.ГруппаВидНоменклатурыХарактеристика.Видимость     = ИспользоватьХарактеристикиНоменклатуры;
	Элементы.ТоварыХарактеристика.Видимость                    = ИспользоватьХарактеристикиНоменклатуры;
	
	Если ВариантНазначенияВидНоменклатуры Тогда
		Если ЗначениеЗаполнено(Номенклатура) Тогда
			ДоступностьУточненийПрименения.Номенклатура            = Ложь;
		Иначе
			Элементы.Номенклатура.ПодсказкаВвода    = НСтр("ru = '<любая номенклатура>';
															|en = '<any items>'");
			ДоступностьУточненийПрименения.Номенклатура            = Истина;
		КонецЕсли;
	Иначе
		Элементы.Номенклатура.ПодсказкаВвода    = "";
	КонецЕсли;
	
	Если ХарактеристикиИспользуются Тогда
		Элементы.Характеристика.Доступность     = ВариантНазначенияВидНоменклатуры;
		Элементы.Характеристика.ПодсказкаВвода  = НСтр("ru = '<любая характеристика>';
														|en = '<any variant>'");
	Иначе
		Элементы.Характеристика.Доступность     = Ложь;
		Элементы.Характеристика.ПодсказкаВвода  = НСтр("ru = '<характеристики не используются>';
														|en = '<variants are not used>'");
		ДоступностьУточненийПрименения.Характеристика          = Ложь;
	КонецЕсли;
	
	Для каждого КлючИЗначение Из ДоступностьУточненийПрименения Цикл
		
		УстановитьНастройкиЭлементовУточненияПрименения(ЭтотОбъект, ОтборПоСвойствам1, КлючИЗначение.Ключ, КлючИЗначение.Значение);
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьНастройкиЭлементовУточненияПрименения(Форма, ОтборПоСвойствам1, ВидНастройки, Доступность = Истина)
	
	Элементы = Форма.Элементы;
	
	НазванияЭлементов = НазванияЭлементовПоВидуНастройки(ВидНастройки);
	
	ТекущаяКоманда = Элементы[НазванияЭлементов.УточнениеПрименения]; // КнопкаФормы
	
	КлючСвязи = ИсследованиеТоваровКлиентСервер.ОтборПоСвойствамКлючСвязиПредопределенный(ВидНастройки);
		
	СписокСтрокОтбора = ОтборПоСвойствам1.НайтиСтроки(Новый Структура("КлючСвязи", КлючСвязи));
	ЕстьВеденныеНастройки = (СписокСтрокОтбора.Количество() > 0);
	
	ТекущаяКоманда.Доступность = НЕ ЗначениеЗаполнено(Форма[НазванияЭлементов.ОбластьПрименения])
		И (Форма[НазванияЭлементов.ЕстьСвойства] ИЛИ ЕстьВеденныеНастройки)
		И Доступность;
		
	Если ЕстьВеденныеНастройки Тогда
		Элементы[НазванияЭлементов.ОбластьПрименения].ПодсказкаВвода = НСтр("ru = '<с отбором по свойствам>';
																			|en = '<with filter by properties>'");
		ТекущаяКоманда.Картинка = БиблиотекаКартинок.ФильтрПоВидамИСвойствамНоменклатуры;
	Иначе
		ТекущаяКоманда.Картинка = БиблиотекаКартинок.Отборы;
	КонецЕсли;
	УстановитьТекстПодсказкиУточненияПрименения(Форма, ВидНастройки, ТекущаяКоманда, СписокСтрокОтбора);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьТекстПодсказкиУточненияПрименения(Форма, ВидНастройки, Команда, СписокСтрокОтбора)
	
	ТекстПодсказки = "";
	
	Если Команда.Доступность Тогда
		
		Если СписокСтрокОтбора.Количество() > 0 Тогда
			
			МассивСвойств = Новый Массив;
			Для каждого Строка Из СписокСтрокОтбора Цикл
				Если МассивСвойств.Найти(Строка.Свойство) = Неопределено Тогда
					МассивСвойств.Добавить(Строка.Свойство);
				КонецЕсли;
			КонецЦикла;
			
			ТекстПодсказки = СтрШаблон(НСтр("ru = 'Установлен отбор по %1: %2';
											|en = 'Filter by %1: %2 is set'"),
				?(МассивСвойств.Количество()>1, НСтр("ru = 'свойствам';
													|en = 'properties'"), НСтр("ru = 'свойству';
																				|en = 'property'")),
				СтрСоединить(МассивСвойств, "; "));
				
		Иначе
			
			ТекстПодсказки = НСтр("ru = 'Установить отбор по свойствам';
									|en = 'Set filter by properties'");
			
		КонецЕсли;
		
	Иначе
		НазванияЭлементов = НазванияЭлементовПоВидуНастройки(ВидНастройки);
	
		Если ВидНастройки = "Номенклатура" Тогда
			ТекстПодсказки = НСтр("ru = 'Отбор по свойствам номенклатуры доступен для карты исследования товаров на вид номенклатуры';
									|en = 'Filter by item properties is available for the goods research sheet for item kind'");
		ИначеЕсли ВидНастройки = "Характеристика" И НЕ Форма.ХарактеристикиИспользуются Тогда
			ТекстПодсказки = НСтр("ru = 'Характеристики не используются, отбор по свойствам недоступен';
									|en = 'Variants are not used, filter by properties is not available'");
		ИначеЕсли НЕ Форма[НазванияЭлементов.ЕстьСвойства] Тогда
			ТекстПодсказки = НСтр("ru = 'Отсутствуют свойства для установки отбора';
									|en = 'Missing properties for setting filter'");
		КонецЕсли;
		
	КонецЕсли;
	
	Команда.РасширеннаяПодсказка.Заголовок = ТекстПодсказки;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция НазванияЭлементовПоВидуНастройки(ВидНастройки)
	
	СтруктураВозврата = Новый Структура;
	
	Если ВидНастройки = "Номенклатура" Тогда
		СтруктураВозврата.Вставить("УточнениеПрименения", "УточнениеПримененияНоменклатура");
		СтруктураВозврата.Вставить("ОбластьПрименения", "Номенклатура");
		СтруктураВозврата.Вставить("ЕстьСвойства", "НоменклатураЕстьСвойства");
	ИначеЕсли ВидНастройки = "Характеристика" Тогда
		СтруктураВозврата.Вставить("УточнениеПрименения", "УточнениеПримененияХарактеристика");
		СтруктураВозврата.Вставить("ОбластьПрименения", "Характеристика");
		СтруктураВозврата.Вставить("ЕстьСвойства", "ХарактеристикаЕстьСвойства");
	КонецЕсли;
	
	Возврат СтруктураВозврата;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьСлужебныеРеквизитыИспользованияСвойствХарактеристик()
	
	ТекстыЗапроса = Новый Массив;
	ТекстыЗапроса.Добавить("
	|ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА Т.ИспользованиеХарактеристик В (
	|				ЗНАЧЕНИЕ(Перечисление.ВариантыИспользованияХарактеристикНоменклатуры.ОбщиеДляВидаНоменклатуры),
	|				ЗНАЧЕНИЕ(Перечисление.ВариантыИспользованияХарактеристикНоменклатуры.ИндивидуальныеДляНоменклатуры),
	|				ЗНАЧЕНИЕ(Перечисление.ВариантыИспользованияХарактеристикНоменклатуры.ОбщиеСДругимВидомНоменклатуры))
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ           КАК ХарактеристикиИспользуются,
	|
	|	МАКСИМУМ(ВЫБОР
	|		КОГДА НаборСвойстваНоменклатуры.Ссылка ЕСТЬ NULL
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ)          КАК НоменклатураЕстьСвойства,
	|
	|	МАКСИМУМ(ВЫБОР
	|		КОГДА Т.ИспользованиеХарактеристик В (
	|				ЗНАЧЕНИЕ(Перечисление.ВариантыИспользованияХарактеристикНоменклатуры.ОбщиеДляВидаНоменклатуры),
	|				ЗНАЧЕНИЕ(Перечисление.ВариантыИспользованияХарактеристикНоменклатуры.ИндивидуальныеДляНоменклатуры),
	|				ЗНАЧЕНИЕ(Перечисление.ВариантыИспользованияХарактеристикНоменклатуры.ОбщиеСДругимВидомНоменклатуры))
	|			ТОГДА (НЕ НаборСвойстваХарактеристики.Ссылка ЕСТЬ NULL)
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ)          КАК ХарактеристикаЕстьСвойства
	|
	|ИЗ
	|	&Таблица КАК Т
	|
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.НаборыДополнительныхРеквизитовИСведений.ДополнительныеРеквизиты КАК НаборСвойстваНоменклатуры
	|		ПО &ИспользоватьДополнительныеРеквизитыИСведения
	|			И НЕ НаборСвойстваНоменклатуры.ПометкаУдаления
	|			И (НаборСвойстваНоменклатуры.Ссылка = &ВидНоменклатурыНаборСвойств1
	|				ИЛИ НаборСвойстваНоменклатуры.Ссылка = &Набор_Справочник_Номенклатура_Общие)
	|
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.НаборыДополнительныхРеквизитовИСведений.ДополнительныеРеквизиты КАК НаборСвойстваХарактеристики
	|		ПО &ИспользоватьДополнительныеРеквизитыИСведения
	|			И НЕ НаборСвойстваХарактеристики.ПометкаУдаления
	|			И (НаборСвойстваХарактеристики.Ссылка =
	|					ВЫБОР
	|						КОГДА Т.ИспользованиеХарактеристик = ЗНАЧЕНИЕ(Перечисление.ВариантыИспользованияХарактеристикНоменклатуры.ОбщиеСДругимВидомНоменклатуры)
	|							ТОГДА Т.ВладелецХарактеристик.НаборСвойствХарактеристик
	|						ИНАЧЕ &ВидНоменклатурыНаборСвойств2
	|					КОНЕЦ
	|				ИЛИ НаборСвойстваХарактеристики.Ссылка = &Набор_Справочник_ХарактеристикиНоменклатуры_Общие)
	|ГДЕ
	|	Т.Ссылка = &Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	ВЫБОР
	|		КОГДА Т.ИспользованиеХарактеристик В (
	|				ЗНАЧЕНИЕ(Перечисление.ВариантыИспользованияХарактеристикНоменклатуры.ОбщиеДляВидаНоменклатуры),
	|				ЗНАЧЕНИЕ(Перечисление.ВариантыИспользованияХарактеристикНоменклатуры.ИндивидуальныеДляНоменклатуры),
	|				ЗНАЧЕНИЕ(Перечисление.ВариантыИспользованияХарактеристикНоменклатуры.ОбщиеСДругимВидомНоменклатуры))
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ");
	
	Если ВариантНастройки = ПредопределенноеЗначение("Перечисление.ВариантыНазначенияКартыИсследованияТоваров.ВидНоменклатуры") И ЗначениеЗаполнено(Номенклатура) Тогда
		ИмяТаблицы = "Номенклатура";
		ИмяРеквизита = "Номенклатура";
		ИсточникДанныхВидНоменклатуры = "Т.ВидНоменклатуры";
	Иначе
		ИмяТаблицы = "ВидыНоменклатуры";
		ИмяРеквизита = "ВидНоменклатуры";
		ИсточникДанныхВидНоменклатуры = "Т";
	КонецЕсли;
	
	Запрос = Новый Запрос;
	ТекстЗапроса = УправлениеПроизводством.ОбъединитьТекстыЗапросаВПакет(ТекстыЗапроса);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&Таблица",                      СтрШаблон("Справочник.%1", ИмяТаблицы));
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ВидНоменклатурыНаборСвойств1", СтрШаблон("%1.НаборСвойств", ИсточникДанныхВидНоменклатуры));
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ВидНоменклатурыНаборСвойств2", СтрШаблон("%1.НаборСвойствХарактеристик", ИсточникДанныхВидНоменклатуры));
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("Ссылка", ЭтотОбъект[ИмяРеквизита]);
	Запрос.УстановитьПараметр("ИспользоватьДополнительныеРеквизитыИСведения", ПолучитьФункциональнуюОпцию("ИспользоватьДополнительныеРеквизитыИСведения"));
	Запрос.УстановитьПараметр("Набор_Справочник_Номенклатура_Общие", УправлениеСвойствами.НаборСвойствПоИмени("Справочник_Номенклатура_Общие"));
	Запрос.УстановитьПараметр("Набор_Справочник_ХарактеристикиНоменклатуры_Общие", УправлениеСвойствами.НаборСвойствПоИмени("Справочник_ХарактеристикиНоменклатуры_Общие"));
	
	РезультатыЗапроса = Запрос.ВыполнитьПакет();
	
	Выборка = РезультатыЗапроса[0].Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, Выборка);
	Иначе
		НоменклатураЕстьСвойства   = Ложь;
		ХарактеристикаЕстьСвойства = Ложь;
		ХарактеристикиИспользуются = Ложь;
	КонецЕсли;
	
КонецПроцедуры

#Область Прочее

&НаКлиенте
Процедура ОткрытьНастройкуУточненияПримененияТребования(ВидНастройки)
	
	ПараметрыФормы = Новый Структура;
	
	ПараметрыФормы.Вставить("КлючСвязи", ИсследованиеТоваровКлиентСервер.ОтборПоСвойствамКлючСвязиПредопределенный(ВидНастройки));
	
	ОтборПоСвойствамМассив = ИсследованиеТоваровКлиент.РеквизитыНастроекПоСтрокеВМассивСтруктур(
		ПараметрыФормы,
		ОтборПоСвойствам,
		ИсследованиеТоваровКлиент.РеквизитыНастройкаОтбораПоСвойствам());
		
	ПараметрыФормы.Вставить("ОтборПоСвойствам", ОтборПоСвойствамМассив);
	ПараметрыФормы.Вставить("ВидНастройки",     ВидНастройки);
	ПараметрыФормы.Вставить("ВидНоменклатуры",  ВидНоменклатуры);
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ОткрытьНастройкуУточненияПримененияКартыИсследованияТоваровЗавершение",
		ЭтотОбъект,
		ВидНастройки);
	
	ОткрытьФорму("Справочник.КартыИсследованияТоваров.Форма.ФормаНастройкиУточненияПримененияКартыИсследованияТоваров",
		ПараметрыФормы,
		ЭтотОбъект,,,,
		ОписаниеОповещения);
	
КонецПроцедуры

// Оповещение о завершении настройки уточнения применения
// 
// Параметры:
// 	РезультатНастройки - Структура - из:
// 		* ОтборПоСвойствам - ТаблицаЗначений - таблица отбора по свойствам
// 		* Описание - Строка - описание настройки
// 	ДополнительныеПараметры - Структура - дополнительные параметры
&НаКлиенте
Процедура ОткрытьНастройкуУточненияПримененияКартыИсследованияТоваровЗавершение(РезультатНастройки, ДополнительныеПараметры) Экспорт
	
	Если РезультатНастройки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Модифицированность = Истина;
	
	КлючСвязи = ИсследованиеТоваровКлиентСервер.ОтборПоСвойствамКлючСвязиПредопределенный(ДополнительныеПараметры);
	
	ИсследованиеТоваровКлиент.ОбновитьНастройкиОтбораПоСвойствамПоКлючу(
		ОтборПоСвойствам,
		РезультатНастройки.ОтборПоСвойствам,
		КлючСвязи);
		
	ОбновитьИнформацию(ОтборПоСвойствам);
	
КонецПроцедуры

&НаСервере
Процедура ВариантНастройкиПриИзмененииНаСервере()
	
	ПроверитьОчиститьРеквизитыПриИзмененииВариантаНазначения();
	
	УстановитьДоступностьЭлементов();
	
	ОбновитьИнформацию(ОтборПоСвойствам);
	
КонецПроцедуры

&НаСервере
Процедура МассивСтруктурВТаблицуЗначений(МассивСтруктур, ТаблицаЗначений, ОтборПоСвойствам)
	
	Для каждого Элемент Из МассивСтруктур Цикл
		НоваяСтрока = ТаблицаЗначений.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Элемент);
		Если Не ОтборПоСвойствам Тогда
			Если ЗначениеЗаполнено(НоваяСтрока.Характеристика) Тогда
				НоваяСтрока.ХарактеристикиИспользуются = Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьДоступностьЭлементов()
	
	ВидимостьВариантНазначения = (ВариантНастройки = Перечисления.ВариантыНазначенияКартыИсследованияТоваров.СписокНоменклатуры);
	
	Элементы.ГруппаСписокНоменклатуры.Видимость = ВидимостьВариантНазначения;
	Элементы.ГруппаВидНоменклатуры.Видимость = Не ВидимостьВариантНазначения;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьВидНоменклатуры(Номенклатура)
	
	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Номенклатура, "ВидНоменклатуры");
	
КонецФункции

&НаСервере
Процедура УстановитьУсловноеОформление()

	НоменклатураСервер.УстановитьУсловноеОформлениеХарактеристикНоменклатуры(ЭтотОбъект,
		"ТоварыХарактеристика", "СписокТоваров.ХарактеристикиИспользуются");

КонецПроцедуры

// Проверяет заполнение характеристик в таблице значений.
//
// Параметры:
//  СписокТоваров - ТаблицаЗначений - таблица для проверки с колонками: Номенклатура, Характеристика.
//  СтрокиСОшибками - Массив из Число - строки с ошибками.
//  Отказ - Булево - Истина - характеристики не заполнены в требуемых строках, в противном случае - Ложь.
&НаСервере
Процедура ПроверитьЗаполнениеХарактеристикВТаблицеЗначений(Знач СписокТоваров, СтрокиСОшибками, Отказ)
	
	Запрос = Новый Запрос;
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	СписокТоваров.Номенклатура КАК Номенклатура,
	|	СписокТоваров.НомерСтроки КАК НомерСтроки
	|ПОМЕСТИТЬ СтрокиСОшибками
	|ИЗ
	|	&СписокТоваров КАК СписокТоваров
	|ГДЕ
	|	СписокТоваров.Характеристика = ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА ВЫРАЗИТЬ(СтрокиСОшибками.Номенклатура КАК Справочник.Номенклатура).ИспользованиеХарактеристик = ЗНАЧЕНИЕ(Перечисление.ВариантыИспользованияХарактеристикНоменклатуры.ОбщиеДляВидаНоменклатуры)
	|			ИЛИ ВЫРАЗИТЬ(СтрокиСОшибками.Номенклатура КАК Справочник.Номенклатура).ИспользованиеХарактеристик = ЗНАЧЕНИЕ(Перечисление.ВариантыИспользованияХарактеристикНоменклатуры.ИндивидуальныеДляНоменклатуры)
	|			ИЛИ ВЫРАЗИТЬ(СтрокиСОшибками.Номенклатура КАК Справочник.Номенклатура).ИспользованиеХарактеристик = ЗНАЧЕНИЕ(Перечисление.ВариантыИспользованияХарактеристикНоменклатуры.ОбщиеСДругимВидомНоменклатуры)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК НеЗаполненаХарактеристика,
	|	СтрокиСОшибками.НомерСтроки КАК НомерСтроки
	|ИЗ
	|	СтрокиСОшибками КАК СтрокиСОшибками
	|ГДЕ
	|	ВЫРАЗИТЬ(СтрокиСОшибками.Номенклатура КАК Справочник.Номенклатура).ИспользованиеХарактеристик <> ЗНАЧЕНИЕ(Перечисление.ВариантыИспользованияХарактеристикНоменклатуры.НеИспользовать)";

	Запрос.Текст = ТекстЗапроса;
	
	Запрос.УстановитьПараметр("СписокТоваров", СписокТоваров.Выгрузить());
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Если Выборка.НеЗаполненаХарактеристика Тогда
			Отказ = Истина;
			Ошибка = Новый Структура("НомерСтроки, ТипОшибки, Номенклатура", Выборка.НомерСтроки, "ПроверкаХарактеристик", "");
			СтрокиСОшибками.Добавить(Ошибка);
		КонецЕсли;
		
	КонецЦикла;

КонецПроцедуры

// Проверяет дублирующих строк в таблице значений.
//
// Параметры:
//  СписокТоваров - ТаблицаЗначений - таблица для проверки с колонками: Номенклатура, Характеристика.
//  СтрокиСОшибками - Массив из Структура - строки с ошибками.
//  Отказ - Булево - Истина - есть дубли в строках, в противном случае - Ложь.
&НаСервере
Процедура ПроверитьДублиВТаблицеЗначений(Знач СписокТоваров, СтрокиСОшибками, Отказ)
	
	Запрос = Новый Запрос;
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	СписокТоваров.Номенклатура КАК Номенклатура,
	|	СписокТоваров.Характеристика КАК Характеристика,
	|	СписокТоваров.НомерСтроки КАК НомерСтроки
	|ПОМЕСТИТЬ СтрокиСОшибками
	|ИЗ
	|	&СписокТоваров КАК СписокТоваров
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КОЛИЧЕСТВО(*) КАК КоличествоДублей,
	|	СтрокиСОшибками.Номенклатура КАК Номенклатура,
	|	СтрокиСОшибками.Характеристика КАК Характеристика
	|ПОМЕСТИТЬ ДублиСтрок
	|ИЗ
	|	СтрокиСОшибками КАК СтрокиСОшибками
	|СГРУППИРОВАТЬ ПО
	|	СтрокиСОшибками.Номенклатура,
	|	СтрокиСОшибками.Характеристика
	|ИМЕЮЩИЕ
	|	КОЛИЧЕСТВО(*) > 1
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СтрокиСОшибками.Номенклатура КАК Номенклатура,
	|	СтрокиСОшибками.Характеристика КАК Характеристика,
	|	СтрокиСОшибками.НомерСтроки КАК НомерСтроки
	|ИЗ
	|	ДублиСтрок КАК ДублиСтрок
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ СтрокиСОшибками КАК СтрокиСОшибками
	|		ПО СтрокиСОшибками.Номенклатура = ДублиСтрок.Номенклатура
	|		И СтрокиСОшибками.Характеристика = ДублиСтрок.Характеристика";

	Запрос.Текст = ТекстЗапроса;
	
	Запрос.УстановитьПараметр("СписокТоваров", СписокТоваров.Выгрузить());
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл

		Отказ = Истина;
		Ошибка = Новый Структура("НомерСтроки, ТипОшибки, Номенклатура", Выборка.НомерСтроки, "ПроверкаДублей",
			НоменклатураКлиентСервер.ПредставлениеНоменклатуры(Выборка.Номенклатура, Выборка.Характеристика));
		СтрокиСОшибками.Добавить(Ошибка);

	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ПроверитьЗаполнениеСпискаНоменклатуры(Знач СписокТоваров, СтрокиСОшибками, Отказ)
	
	ПроверитьЗаполнениеХарактеристикВТаблицеЗначений(СписокТоваров, СтрокиСОшибками, Отказ);
	ПроверитьДублиВТаблицеЗначений(СписокТоваров, СтрокиСОшибками, Отказ);
	
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьНомераСтрок()
	
	Для Каждого Строка Из СписокТоваров Цикл
		Строка.НомерСтроки = СписокТоваров.Индекс(Строка)+1;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти
