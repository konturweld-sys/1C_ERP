#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	Если ЭтоГруппа Тогда
		Возврат
	КонецЕсли;
	
	ИнициализироватьСправочник(ДанныеЗаполнения);
	
	ВариантНазначения = Перечисления.ВариантыНазначенияКартыИсследованияТоваров.ВидНоменклатуры;
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	Если ЭтоГруппа Тогда
		Возврат;
	КонецЕсли;
	
	МассивНепроверяемыхРеквизитов = Новый Массив;

	Если Контроль = Перечисления.КонтрольКачества.Сплошной И Статус <> Перечисления.СтатусыКартыИсследованияТоваров.Черновик Тогда
		МассивНепроверяемыхРеквизитов.Добавить("ВариантОтбораОбразцов");
	КонецЕсли;
	
	Если Статус = Перечисления.СтатусыКартыИсследованияТоваров.Черновик Тогда
		МассивНепроверяемыхРеквизитов.Добавить("ВариантОтбораОбразцов");
		МассивНепроверяемыхРеквизитов.Добавить("Контроль");
	КонецЕсли;
	
	Если Проверки.Количество() = 0 Или Статус <> Перечисления.СтатусыКартыИсследованияТоваров.Действует Тогда
		МассивНепроверяемыхРеквизитов.Добавить("Проверки.ПоказательКачества");
	КонецЕсли;
	
	ОбщегоНазначения.УдалитьНепроверяемыеРеквизитыИзМассива(ПроверяемыеРеквизиты, МассивНепроверяемыхРеквизитов);
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	Если ЭтоГруппа Тогда
		Возврат
	КонецЕсли;

	ИнициализироватьСправочник();

КонецПроцедуры

Процедура ПередЗаписью(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
	Если Не ЭтоГруппа Тогда
		
		Если ПометкаУдаления Тогда
			Статус = Перечисления.СтатусыКартыИсследованияТоваров.Закрыта;
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЭтоГруппа Тогда

		РегистрыСведений.КартыИсследованияТоваров.ЗаписатьКартыКонтроляКачества(Ссылка, Статус
			<> Перечисления.СтатусыКартыИсследованияТоваров.Действует);
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ИнициализацияИЗаполнение

// Инициализирует реквизиты справочника "КартыИсследованияТоваров" значениями по умолчанию.
//
// Параметры:
//   ДанныеЗаполнения - Неопределено - Данные для заполнения справочника
Процедура ИнициализироватьСправочник(ДанныеЗаполнения = Неопределено) Экспорт
	
	Дата = ТекущаяДатаСеанса();
	Статус = Перечисления.СтатусыКартыИсследованияТоваров.Черновик;
	Автор = Пользователи.ТекущийПользователь();
	Если Не ЗначениеЗаполнено(Контроль) Тогда
		Контроль = Перечисления.КонтрольКачества.Выборочный;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ВариантОтбораОбразцов) Тогда
		ВариантОтбораОбразцов = Перечисления.ВариантыОтбораОбразцовИсследованияТоваров.Количество;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#КонецЕсли
