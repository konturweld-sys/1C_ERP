// Возвращает имена блокируемых реквизитов для механизма блокирования реквизитов БСП.
//
// Возвращаемое значение:
//  Массив из Строка:
//   * Поля - Строка - список имен реквизитов объекта.
Функция ПолучитьБлокируемыеРеквизитыОбъекта() Экспорт
	
	Результат = Новый Массив;
	
	// Элементы шапки
	Результат.Добавить("Код");
	Результат.Добавить("Наименование");
	Результат.Добавить("Родитель");
	Результат.Добавить("Автор");
	Результат.Добавить("Дата");
	Результат.Добавить("Контроль");
	Результат.Добавить("ПроцентОбразцов");
	Результат.Добавить("КоличествоОбразцов");
	Результат.Добавить("ВариантОтбораОбразцов");
	Результат.Добавить("ВариантНазначения");
	Результат.Добавить("ОписаниеУточненияПрименения");
	Результат.Добавить("ПредставлениеОбластиДействия");
	
	// Элементы табличных частей
	Результат.Добавить("Проверки");
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

