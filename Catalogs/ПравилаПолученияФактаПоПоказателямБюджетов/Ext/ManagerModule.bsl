#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область СлужебныйПрограммныйИнтерфейс

Функция ЕстьОтключенныеПравилаПолученияФакта(ПоказательБюджетов = Неопределено, ИсточникДанных = Неопределено) Экспорт
	
	ТекстЗапроса = "
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	ИСТИНА
	|ИЗ
	|	Справочник.ПравилаПолученияФактаПоПоказателямБюджетов КАК ПравилаПолученияФакта
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПланВидовХарактеристик.СтатьиАктивовПассивов КАК СтатьиАктивовПассивов
	|	ПО ПравилаПолученияФакта.ИсточникДанных = СтатьиАктивовПассивов.Ссылка
	|ГДЕ
	|	ПравилаПолученияФакта.РазделИсточникаДанных = ЗНАЧЕНИЕ(Перечисление.РазделыИсточниковДанныхБюджетирования.ОперативныйУчет)
	|	И НЕ ПравилаПолученияФакта.ПометкаУдаления
	|	И СтатьиАктивовПассивов.Предопределенный
	|	И &ЭтоПравилоОтключеннойНастройки
	|	И &УсловиеОтбораПоПоказателюБюджетов
	|	И &УсловиеОтбораПоИсточникуДанных
	|";
	
	Если ПолучитьФункциональнуюОпцию("НастройкаПравилПолученияФактаПоСтатьямАктивовПассивов") Тогда
		ЭтоПравилоОтключеннойНастройки = "СтатьиАктивовПассивов.ИсточникДанных = """"";
	Иначе
		ЭтоПравилоОтключеннойНастройки = "СтатьиАктивовПассивов.ИмяИсточникаДанныхБюджетов = """"";
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПоказательБюджетов) Тогда
		УсловиеОтбораПоПоказателюБюджетов = "ПравилаПолученияФакта.ПоказательБюджетов = &ПоказательБюджетов";
	Иначе
		УсловиеОтбораПоПоказателюБюджетов = "ИСТИНА";
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ИсточникДанных) Тогда
		УсловиеОтбораПоИсточникуДанных = "ПравилаПолученияФакта.ИсточникДанных = &ИсточникДанных";
	Иначе
		УсловиеОтбораПоИсточникуДанных = "ИСТИНА";
	КонецЕсли;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ЭтоПравилоОтключеннойНастройки", ЭтоПравилоОтключеннойНастройки);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеОтбораПоПоказателюБюджетов", УсловиеОтбораПоПоказателюБюджетов);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеОтбораПоИсточникуДанных", УсловиеОтбораПоИсточникуДанных);
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ПоказательБюджетов", ПоказательБюджетов);
	Запрос.УстановитьПараметр("ИсточникДанных", ИсточникДанных);
	
	Результат = Запрос.Выполнить();
	
	Возврат НЕ Результат.Пустой();
	
КонецФункции

Функция ПравилоПоСтатьеАктивовПассивов(Правило) Экспорт
	
	ТипПравила = ТипЗнч(Правило);
	
	Если ТипПравила = Тип("СправочникСсылка.ПравилаПолученияФактаПоПоказателямБюджетов") Тогда
		ЗначенияРеквизитовПравила = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
			Правило, "ИсточникДанных,РазделИсточникаДанных");
	ИначеЕсли ТипПравила = Тип("СправочникОбъект.ПравилаПолученияФактаПоПоказателямБюджетов") Тогда
		ЗначенияРеквизитовПравила = Правило;
	ИначеЕсли (ТипПравила = Тип("Структура") ИЛИ ТипПравила = Тип("ДанныеФормыСтруктура"))
		И Правило.Свойство("ИсточникДанных") И Правило.Свойство("РазделИсточникаДанных") Тогда
		ЗначенияРеквизитовПравила = Правило;
	ИначеЕсли ТипПравила = Тип("СтрокаТаблицыЗначений") Тогда
		ТаблицаПравил = Правило.Владелец(); // ТаблицаЗначений -
		КолонкиТаблицыПравил = ТаблицаПравил.Колонки;
		Если КолонкиТаблицыПравил.Найти("ИсточникДанных") <> Неопределено
		   И КолонкиТаблицыПравил.Найти("РазделИсточникаДанных") <> Неопределено Тогда
			ЗначенияРеквизитовПравила = Правило;
		Иначе
			Возврат Ложь;
		КонецЕсли;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
	Возврат ЗначенияРеквизитовПравила.РазделИсточникаДанных = Перечисления.РазделыИсточниковДанныхБюджетирования.ОперативныйУчет
		И ?(ЗначениеЗаполнено(ЗначенияРеквизитовПравила.ИсточникДанных),
			?(ПолучитьФункциональнуюОпцию("НастройкаПравилПолученияФактаПоСтатьямАктивовПассивов"),
				ИсточникиДанныхСервер.ЭтоСтатьяАктивовПассивов(ЗначенияРеквизитовПравила.ИсточникДанных),
				НЕ ИсточникиДанныхСервер.ЭтоСтатьяУправленческогоБаланса(ЗначенияРеквизитовПравила.ИсточникДанных)),
			ПолучитьФункциональнуюОпцию("НастройкаПравилПолученияФактаПоСтатьямАктивовПассивов"));
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область Отчеты

// Определяет список команд отчетов.
//
// Параметры:
//   КомандыОтчетов - См. ВариантыОтчетовПереопределяемый.ПередДобавлениемКомандОтчетов.КомандыОтчетов
//   Параметры - См. ВариантыОтчетовПереопределяемый.ПередДобавлениемКомандОтчетов.Параметры
//
Процедура ДобавитьКомандыОтчетов(КомандыОтчетов, Параметры) Экспорт
	
	//++ НЕ УТ
	Отчеты.РезультатРаботыПравилПолученияФактическихДанных.ДобавитьКомандуОтчетаПоПоказателюБюджетов(КомандыОтчетов);
	//-- НЕ УТ
	
КонецПроцедуры

#КонецОбласти

#Область НастройкаПравилПолученияФактаПоСтатьямАктивовПассивов

Процедура ИзменитьНастройкиПравилПолученияФакта(Параметры, АдресХранилища) Экспорт
	
	ЗаймыВыданныеУпрБаланс = Новый Массив();
	ЗаймыВыданныеУпрБаланс.Добавить(ПланыВидовХарактеристик.СтатьиАктивовПассивов.ЗаймыВыданные);
	
	ЗаймыВыданныеОбъектыУчета = Новый Массив();
	ЗаймыВыданныеОбъектыУчета.Добавить(ПланыВидовХарактеристик.СтатьиАктивовПассивов.ДепозитыКредитыЗаймыВыданныеДолг);
	ЗаймыВыданныеОбъектыУчета.Добавить(ПланыВидовХарактеристик.СтатьиАктивовПассивов.ДепозитыКредитыЗаймыВыданныеКомиссия);
	ЗаймыВыданныеОбъектыУчета.Добавить(ПланыВидовХарактеристик.СтатьиАктивовПассивов.ДепозитыКредитыЗаймыВыданныеПроценты);
	
	НастройкаПравилПоСтатьямАктивовПассивов = Параметры.НастройкаПравилПолученияФактаПоСтатьямАктивовПассивов;
	ВсеЗаймыВыданные = ОбщегоНазначения.СкопироватьРекурсивно(ЗаймыВыданныеУпрБаланс);
	
	Если НЕ НастройкаПравилПоСтатьямАктивовПассивов Тогда
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ВсеЗаймыВыданные, ЗаймыВыданныеОбъектыУчета);
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	ТекстЗапроса = "
	|ВЫБРАТЬ
	|	ПравилаПолученияФакта.Ссылка КАК Ссылка,
	|	ПравилаПолученияФакта.ИсточникДанных КАК ИсточникДанных,
	|	ПравилаПолученияФакта.ИсточникСуммыОперации КАК ИсточникСуммыОперации,
	|	ПравилаПолученияФакта.КомпоновщикНастроек КАК КомпоновщикНастроек,
	|	ВЫРАЗИТЬ(ПравилаПолученияФакта.ПредставлениеОтбора КАК СТРОКА(16)) КАК ПредставлениеОтбора
	|ИЗ
	|	Справочник.ПравилаПолученияФактаПоПоказателямБюджетов КАК ПравилаПолученияФакта
	|ГДЕ
	|	НЕ ПравилаПолученияФакта.ПометкаУдаления
	|	И ПравилаПолученияФакта.РазделИсточникаДанных = ЗНАЧЕНИЕ(Перечисление.РазделыИсточниковДанныхБюджетирования.ОперативныйУчет)
	|	И (ПравилаПолученияФакта.ИсточникДанных В (&ЗаймыВыданные)
	|	ИЛИ (ПравилаПолученияФакта.ИсточникДанных В (
	|		ЗНАЧЕНИЕ(ПланВидовХарактеристик.СтатьиАктивовПассивов.Налоги),
	|		ЗНАЧЕНИЕ(ПланВидовХарактеристик.СтатьиАктивовПассивов.ОплатаТруда))
	|	И ПравилаПолученияФакта.ИсточникСуммыОперации = ЗНАЧЕНИЕ(Перечисление.ПоказателиАналитическихРегистров.ПустаяСсылка)))
	|";
		
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ЗаймыВыданные", ВсеЗаймыВыданные);
	Результат = Запрос.Выполнить();
	
	НачатьТранзакцию();
	
	Попытка
		
		Блокировка = Новый БлокировкаДанных();
		ЭлементБлокировки = Блокировка.Добавить("Справочник.ПравилаПолученияФактаПоПоказателямБюджетов");
		ЭлементБлокировки.ИсточникДанных = Результат;
		ЭлементБлокировки.ИспользоватьИзИсточникаДанных("Ссылка", "Ссылка");
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		Блокировка.Заблокировать();
		
		Выборка = Результат.Выбрать();
		Пока Выборка.Следующий() Цикл
			ПравилоОбъект = Выборка.Ссылка.ПолучитьОбъект(); // 
			
			Если НастройкаПравилПоСтатьямАктивовПассивов Тогда
				Если ЗаймыВыданныеУпрБаланс.Найти(Выборка.ИсточникДанных) <> Неопределено
				И НЕ ЗначениеЗаполнено(Выборка.ИсточникСуммыОперации) Тогда
					Если ПустаяСтрока(Выборка.ПредставлениеОтбора) Тогда
						НовыйИсточникДанных = ПланыВидовХарактеристик.СтатьиАктивовПассивов.ДепозитыКредитыЗаймыВыданныеДолг;
					Иначе
						ТипСуммы = ТипСуммыИзОтбораПравила(Выборка.КомпоновщикНастроек);
						Если ТипСуммы = Перечисления.ТипыСуммГрафикаКредитовИДепозитов.Комиссия Тогда
							НовыйИсточникДанных = ПланыВидовХарактеристик.СтатьиАктивовПассивов.ДепозитыКредитыЗаймыВыданныеКомиссия;
						ИначеЕсли ТипСуммы = Перечисления.ТипыСуммГрафикаКредитовИДепозитов.Проценты Тогда
							НовыйИсточникДанных = ПланыВидовХарактеристик.СтатьиАктивовПассивов.ДепозитыКредитыЗаймыВыданныеПроценты;
						Иначе
							НовыйИсточникДанных = ПланыВидовХарактеристик.СтатьиАктивовПассивов.ДепозитыКредитыЗаймыВыданныеДолг;
						КонецЕсли;
					КонецЕсли;
					ПравилоОбъект.ИсточникДанных = НовыйИсточникДанных;
					ПравилоОбъект.ИсточникСуммыОперации = Перечисления.ПоказателиАналитическихРегистров.Сумма;
				КонецЕсли;
			Иначе
				Если ЗаймыВыданныеОбъектыУчета.Найти(Выборка.ИсточникДанных) <> Неопределено Тогда
					НовыйИсточникДанных = ПланыВидовХарактеристик.СтатьиАктивовПассивов.ЗаймыВыданные;
					ПравилоОбъект.ИсточникДанных = НовыйИсточникДанных;
					ПравилоОбъект.ИсточникСуммыОперации = Неопределено;
				КонецЕсли;
				
				Если ЗаймыВыданныеУпрБаланс.Найти(Выборка.ИсточникДанных) <> Неопределено
					И ЗначениеЗаполнено(Выборка.ИсточникСуммыОперации) Тогда
					ПравилоОбъект.ПометкаУдаления = Истина;
				КонецЕсли;
			КонецЕсли;
			
			Если Выборка.ИсточникДанных = ПланыВидовХарактеристик.СтатьиАктивовПассивов.Налоги
			 ИЛИ Выборка.ИсточникДанных = ПланыВидовХарактеристик.СтатьиАктивовПассивов.ОплатаТруда Тогда
				Если НЕ ЗначениеЗаполнено(Выборка.ИсточникСуммыОперации) Тогда
					ПравилоОбъект.ИсточникСуммыОперации = Перечисления.ПоказателиАналитическихРегистров.Сумма;
				КонецЕсли;
			КонецЕсли;
			
			Если ПравилоОбъект.Модифицированность() Тогда
				ПравилоОбъект.Записать();
			КонецЕсли;
		КонецЦикла;
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		
		ОтменитьТранзакцию();
		
		ТекстОшибки = СтрШаблон(
			НСтр("ru = 'Не удалось изменить настройки правил получения фактических данных по показателям по причине: %1';
				|en = 'Cannot change the settings of actual data query rules by items. Reason: %1'"),
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		
		ЗаписьЖурналаРегистрации(
			НСтр("ru = 'Изменение настроек правил получения фактических данных по показателям.';
				|en = 'Change the settings of actual data query rules by items.'",
			ОбщегоНазначения.КодОсновногоЯзыка()),
			УровеньЖурналаРегистрации.Ошибка,
			Метаданные.Справочники.ПравилаПолученияФактаПоПоказателямБюджетов,,
			ТекстОшибки);
		
		ВызватьИсключение ТекстОшибки;
		
	КонецПопытки;
	
	ПоместитьВоВременноеХранилище(Параметры, АдресХранилища);
	
КонецПроцедуры

Функция ТипСуммыИзОтбораПравила(ХранилищеНастроек)
	
	ТипСуммы = Перечисления.ТипыСуммГрафикаКредитовИДепозитов.ПустаяСсылка();
	
	КомпоновщикНастроек = Новый КомпоновщикНастроекКомпоновкиДанных();
	НастройкиКомпоновки = ХранилищеНастроек.Получить(); // НастройкиКомпоновкиДанных
	
	ПланыВидовХарактеристик.СтатьиАктивовПассивов.ИнициализироватьКомпоновщикНастроекИсточникомДанных(
		КомпоновщикНастроек, Метаданные.РегистрыНакопления.РасчетыПоФинансовымИнструментам.Имя);
	
	Если ТипЗнч(НастройкиКомпоновки) = Тип("НастройкиКомпоновкиДанных") Тогда
		КомпоновщикНастроек.ЗагрузитьНастройки(НастройкиКомпоновки);
	КонецЕсли;
	
	НастройкиОтбора = КомпоновщикНастроек.Настройки.Отбор;
	ОтборНаРавенствоТипуСуммы = Неопределено;
	
	Для Каждого ЭлементОтбора Из НастройкиОтбора.Элементы Цикл
		Если ЭлементОтбора.Использование = Истина
			И ТипЗнч(ЭлементОтбора) = Тип("ЭлементОтбораКомпоновкиДанных")
			И ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ТипСуммы")
			И ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно Тогда
			ОтборНаРавенствоТипуСуммы = ЭлементОтбора;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если ОтборНаРавенствоТипуСуммы <> Неопределено Тогда
		ТипСуммы = ОтборНаРавенствоТипуСуммы.ПравоеЗначение;
	КонецЕсли;
	
	Возврат ТипСуммы;
	
КонецФункции

#КонецОбласти

#КонецОбласти

#КонецЕсли
