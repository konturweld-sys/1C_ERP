
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	УстановитьОтборВидаНачисленийУдержаний(Параметры);   
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура УстановитьОтборВидаНачисленийУдержаний(Параметры)
	
	Если Параметры.ТолькоУдержание = Истина Тогда
		УстановитьЭлементОтбора(Истина);
	ИначеЕсли Параметры.ТолькоНачисление = Истина Тогда
		УстановитьЭлементОтбора(Ложь);
	КонецЕсли;
	
	Если Параметры.ТолькоРазовые Тогда 
		
		СписокВидимыхПериодичностиВвода = Новый СписокЗначений();
		СписокВидимыхПериодичностиВвода.Добавить(2);
		СписокВидимыхПериодичностиВвода.Добавить(3);
		
		Элемент = Список.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		Элемент.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;
		Элемент.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ПериодичностьВвода");
		Элемент.ПравоеЗначение = СписокВидимыхПериодичностиВвода;

	КонецЕсли;
		
	Если Параметры.ТолькоКадровые Тогда 
		
		СписокВидимыхПериодичностиВвода = Новый СписокЗначений();
		СписокВидимыхПериодичностиВвода.Добавить(0);
		СписокВидимыхПериодичностиВвода.Добавить(1);
		СписокВидимыхПериодичностиВвода.Добавить(2);
		
		Элемент = Список.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		Элемент.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;
		Элемент.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ПериодичностьВвода");
		Элемент.ПравоеЗначение = СписокВидимыхПериодичностиВвода;

	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьЭлементОтбора(ЗначениеЯвляетсяУдержанием)
	
	Элемент = Список.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Элемент.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Элемент.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ЯвляетсяУдержанием");
	Элемент.ПравоеЗначение = ЗначениеЯвляетсяУдержанием;

	Если Параметры.Свойство("АвтоТест") Тогда // Возврат при получении формы для анализа.
		Возврат;
	КонецЕсли;

	МультиязычностьСервер.ПриСозданииНаСервере(ЭтотОбъект);
		
	Если Параметры.ТолькоУдержание Тогда
		
		Элемент = Список.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		Элемент.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		Элемент.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ЯвляетсяУдержанием");
		Элемент.ПравоеЗначение = Параметры.ТолькоУдержание;

		Элементы.СпособНачисления.Видимость = Ложь;
		Элементы.ФормулаРасчета.Видимость = Ложь;
		
	ИначеЕсли Параметры.ТолькоНачисление Тогда
		
		Элемент = Список.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		Элемент.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		Элемент.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ЯвляетсяУдержанием");
		Элемент.ПравоеЗначение = НЕ Параметры.ТолькоНачисление;
		
	КонецЕсли;	
	
КонецПроцедуры 

#КонецОбласти
