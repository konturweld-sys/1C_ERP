#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	УсловноеОформление.Элементы.Очистить();
	
	Возврат;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьЭлементов()
	
	Если НЕ ПолучитьФункциональнуюОпцию("ИспользоватьЗарплатаИКадрыWE") Тогда
		Элементы.ГруппаВидыНачисленийУдержаний.Видимость = Ложь;
		Возврат;
	КонецЕсли;
	Возврат;
	
КонецПроцедуры	

&НаСервере
Процедура ПриЧтенииСозданииНаСервере()
	
	СписокВыбора = Элементы.ВидЭлемента.СписокВыбора;
	СписокВыбора.Добавить("Начисление", НСтр("ru = 'Начисление';
											|en = 'Accrued payroll'"));
	СписокВыбора.Добавить("Удержание", НСтр("ru = 'Удержание';
											|en = 'Deduction'"));
	
	ОбновитьЗависимыеРеквизиты(); 
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьЗависимыеРеквизиты()
	
	ВидЭлемента = ?(Объект.ЯвляетсяУдержанием, "Удержание", "Начисление");
	
	АвтоЗаголовок = Не ЗначениеЗаполнено(Параметры.Ключ);
	Если Не АвтоЗаголовок Тогда
		ЭлементСписка = Элементы.ВидЭлемента.СписокВыбора.НайтиПоЗначению(ВидЭлемента);
		
		СуффиксЯзыка = МультиязычностьСервер.СуффиксТекущегоЯзыка();
		Если ПустаяСтрока(СуффиксЯзыка) Тогда
			Наименование = Объект.Наименование;
		Иначе
			Наименование = Объект["Наименование" + СуффиксЯзыка]
		КонецЕсли;
		
		Заголовок = СтрШаблон("%1: %2", ЭлементСписка.Представление, Наименование);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНачальнымиДанными()
	Возврат;
	
КонецПроцедуры

// СтандартныеПодсистемы.Свойства 
