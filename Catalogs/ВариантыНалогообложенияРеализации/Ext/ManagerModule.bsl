#Область ПрограммныйИнтерфейс    

// Возвращает наименование налогообложения реализации.
//
// Параметры:
//  СтруктураНалогообложенияРеализации - СправочникОбъект.ВариантыНалогообложенияРеализации, Структура - налогообложение реализаций.
// 
// Возвращаемое значение:
//  Строка - наименование налогообложения реализации.
//
Функция НаименованиеНалогообложенияРеализации(СтруктураНалогообложенияРеализации) Экспорт
	
	ПредставлениеНалогообложенияРеализации = НСтр("ru = '%СтавкаНДС%, %ВариантНалогообложенияПрибыли%;';
													|en = '%СтавкаНДС%, %ВариантНалогообложенияПрибыли%;'");
	
	ПредставлениеНалогообложенияРеализации = СтрЗаменить(ПредставлениеНалогообложенияРеализации, "%СтавкаНДС%",
		ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтруктураНалогообложенияРеализации.СтавкаНДС,"Наименование"));
	ПредставлениеНалогообложенияРеализации = СтрЗаменить(ПредставлениеНалогообложенияРеализации, "%ВариантНалогообложенияПрибыли%",
		ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтруктураНалогообложенияРеализации.ВариантНалогообложенияПрибыли,"Наименование"));
	
	Возврат ПредставлениеНалогообложенияРеализации;
	
КонецФункции

// Параметры аналитики.
// 
// Возвращаемое значение:
//  Структура - Параметры аналитики:
//   * СтавкаНДС - СправочникСсылка.СтавкиНДС - 
//   * ВариантНалогообложенияПрибыли - СправочникСсылка.ВариантыНалогообложенияПрибыли - 
Функция ПараметрыАналитики() Экспорт
	
	ПараметрыАналитики = Новый Структура;
	ПараметрыАналитики.Вставить("СтавкаНДС", Справочники.СтавкиНДС.ПустаяСсылка());
	ПараметрыАналитики.Вставить("ВариантНалогообложенияПрибыли", Справочники.ВариантыНалогообложенияПрибыли.ПустаяСсылка());
	
	Возврат ПараметрыАналитики;
	
КонецФункции

// Производит поиск/создание элемента справочника ВариантыНалогообложенияРеализации по входным данным.
// Возвращает массив ссылок на найденные/созданные элементы справочника ВариантыНалогообложенияРеализации.
//
// Параметры:
//  ПараметрыАналитики - Структура - Коллекция параметров для поиска/создания элемента справочника.
// 
// Возвращаемое значение:
//  - СправочникСсылка.ВариантыНалогообложенияРеализации
//  - Неопределено.
//
Функция ЗначениеНалогообложенияРеализаций(ПараметрыАналитики) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	НалогообложенияРеализаций.Ссылка
		|ИЗ
		|	Справочник.ВариантыНалогообложенияРеализации КАК НалогообложенияРеализаций
		|ГДЕ
		|	НалогообложенияРеализаций.СтавкаНДС = &СтавкаНДС
		|	И НалогообложенияРеализаций.ВариантНалогообложенияПрибыли = &ВариантНалогообложенияПрибыли";
	
	Запрос.УстановитьПараметр("СтавкаНДС", ПараметрыАналитики.СтавкаНДС);
	Запрос.УстановитьПараметр("ВариантНалогообложенияПрибыли", ПараметрыАналитики.ВариантНалогообложенияПрибыли);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	Иначе
		Возврат СоздатьНалогообложенияРеализаций(ПараметрыАналитики);
	КонецЕсли;
	
КонецФункции

// Производит создание элементов справочника ВариантыНалогообложенияРеализации по входным данным.
// Возвращает массив ссылок на созданные элементы справочника ВариантыНалогообложенияРеализации.
//
// Параметры:
//  ИсходныеДанные - Структура, ТаблицаЗначений, МенеджерВременныхТаблиц - Коллекция данных для поиска/создания элемента справочника.
//  ИмяТаблицы - Строка - Имя временной таблицы, содержащей исходные данные, для случая, когда в качестве параметра ИсходныеДанные передается МенеджерВременныхТаблиц.
// 
// Возвращаемое значение:
//  - СправочникСсылка.ВариантыНалогообложенияРеализации
//  - Массив из СправочникСсылка.ВариантыНалогообложенияРеализации
//  - Неопределено.
//
Функция СоздатьНалогообложенияРеализаций(ИсходныеДанные, ИмяТаблицы = "ВтДанныеПродаж") Экспорт
	
	МассивСозданныхЭлементов = Новый Массив;
	Запрос = Новый Запрос;
	ТекстыЗапроса = Новый Массив;
	
	Если ТипЗнч(ИсходныеДанные) = Тип("Структура") Тогда
		
		Запрос.УстановитьПараметр("СтавкаНДС", ИсходныеДанные.СтавкаНДС);
		Запрос.УстановитьПараметр("ВариантНалогообложенияПрибыли", ИсходныеДанные.ВариантНалогообложенияПрибыли);
		
		ТекстЗапроса =
		"ВЫБРАТЬ
		|	&СтавкаНДС КАК СтавкаНДС,
		|	&ВариантНалогообложенияПрибыли КАК ВариантНалогообложенияПрибыли
		|ПОМЕСТИТЬ ВтДанныеПродаж
		|";
		
		ТекстыЗапроса.Добавить(ТекстЗапроса);
		
	ИначеЕсли ТипЗнч(ИсходныеДанные) = Тип("ТаблицаЗначений") 
		И ИсходныеДанные.Колонки.Найти("СтавкаНДС") <> Неопределено
		И ИсходныеДанные.Колонки.Найти("ВариантНалогообложенияПрибыли") <> Неопределено Тогда
		
		Запрос.УстановитьПараметр("ДанныеПродаж", ИсходныеДанные);
		
		ТекстЗапроса =
		"ВЫБРАТЬ
		|	Данные.СтавкаНДС КАК СтавкаНДС,
		|	Данные.ВариантНалогообложенияПрибыли КАК ВариантНалогообложенияПрибыли
		|ПОМЕСТИТЬ ВтДанныеПродаж
		|ИЗ
		|	&ДанныеПродаж КАК Данные
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	СтавкаНДС,
		|	ВариантНалогообложенияПрибыли
		|";
		
		ТекстыЗапроса.Добавить(ТекстЗапроса);
		
	ИначеЕсли ТипЗнч(ИсходныеДанные) = Тип("МенеджерВременныхТаблиц")
		И ИсходныеДанные.Таблицы.Найти(ИмяТаблицы) <> Неопределено Тогда
		
		Запрос.МенеджерВременныхТаблиц = ИсходныеДанные;
		
	Иначе
		
		Возврат Неопределено;
		
	КонецЕсли;
	
	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Данные.СтавкаНДС                       КАК СтавкаНДС,
	|	Данные.ВариантНалогообложенияПрибыли   КАК ВариантНалогообложенияПрибыли
	|ИЗ
	|	ВтДанныеПродаж КАК Данные
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВариантыНалогообложенияРеализации КАК НалогообложенияРеализаций
	|		ПО Данные.СтавкаНДС = НалогообложенияРеализаций.СтавкаНДС
	|			И Данные.ВариантНалогообложенияПрибыли = НалогообложенияРеализаций.ВариантНалогообложенияПрибыли
	|ГДЕ
	|	НалогообложенияРеализаций.Ссылка ЕСТЬ NULL
	|";
	
	Если ТипЗнч(ИсходныеДанные) = Тип("МенеджерВременныхТаблиц") Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ВтДанныеПродаж", ИмяТаблицы);
	КонецЕсли;
	
	ТекстыЗапроса.Добавить(ТекстЗапроса);
	
	Запрос.Текст = СтрСоединить(ТекстыЗапроса, ОбщегоНазначения.РазделительПакетаЗапросов());
	
	БлокировкаДанных = Новый БлокировкаДанных;
	
	ЭлементБлокировки = БлокировкаДанных.Добавить("Справочник.ВариантыНалогообложенияРеализации");
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	
	НачатьТранзакцию();
	
	Попытка
		
		БлокировкаДанных.Заблокировать();
		
		РезультатЗапроса = Запрос.Выполнить();
		Выборка = РезультатЗапроса.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			НалогообложениеРеализаций = Справочники.ВариантыНалогообложенияРеализации.СоздатьЭлемент();
			НалогообложениеРеализаций.Заполнить(Неопределено);
			ЗаполнитьЗначенияСвойств(НалогообложениеРеализаций, Выборка);
			НалогообложениеРеализаций.Записать();
			
			МассивСозданныхЭлементов.Добавить(НалогообложениеРеализаций.Ссылка);
			
		КонецЦикла;
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		
		ОтменитьТранзакцию();
		ЗаписьЖурналаРегистрации(
			СтрШаблон(НСтр("ru = 'Не удалось создать элементы справочника %1';
							|en = 'Cannot create the %1 catalog items'"),
				Метаданные.Справочники.ВариантыНалогообложенияРеализации.ПолноеИмя()),
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		
	КонецПопытки;
	
	Если НЕ МассивСозданныхЭлементов.Количество() Тогда
		Возврат Неопределено;
	ИначеЕсли
		МассивСозданныхЭлементов.Количество() = 1 Тогда
		Возврат МассивСозданныхЭлементов[0];
	Иначе
		Возврат МассивСозданныхЭлементов;
	КонецЕсли;
	
КонецФункции

// Возвращает имена блокируемых реквизитов для механизма блокирования реквизитов БСП.
//
// Возвращаемое значение:
//	Массив Из Строка - имена блокируемых реквизитов.
//
Функция ПолучитьБлокируемыеРеквизитыОбъекта() Экспорт
	
	РеквизитыСправочника = ПустаяСсылка().Метаданные().Реквизиты;

	Результат = Новый Массив;
	Результат.Добавить("Наименование");
	Для каждого Реквизит Из РеквизитыСправочника Цикл
		Результат.Добавить(Реквизит.Имя);
	КонецЦикла;
	
	Возврат Результат;
КонецФункции

#КонецОбласти

#КонецЕсли
