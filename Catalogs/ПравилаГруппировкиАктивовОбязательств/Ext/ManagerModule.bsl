#Область СлужебныеПроцедурыИФункции

#Область ОбновлениеИнформационнойБазы

Процедура ВыполнитьНачальноеЗаполнение() Экспорт
	
	Выборка = Справочники.ПравилаГруппировкиАктивовОбязательств.Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат;
	КонецЕсли;
	
	ПравилаГруппировки = НалогНаПрибыльБухгалтерскийУчет.НовыйПравилаГруппировкиАктивовОбязательств();
	НалогНаПрибыльБухгалтерскийУчет.ЗаполнитьПравилаГруппировкиВидовАктивовИОбязательств(ПравилаГруппировки);

	НачатьТранзакцию();
	Попытка
		Для Каждого Правило Из ПравилаГруппировки Цикл
			
			СправочникОбъект = Справочники.ПравилаГруппировкиАктивовОбязательств.СоздатьЭлемент();
			СправочникОбъект.ВидАктивовОбязательств = Правило.ВидАктивовОбязательств;
			СправочникОбъект.ОсновнойСчет = Правило.ОсновнойСчет;
			Для Каждого Счет Из Правило.ДополнительныеСчета Цикл
				СтрокаТЧ = СправочникОбъект.ДополнительныеСчета.Добавить();
				СтрокаТЧ.СчетУчета = Счет;
			КонецЦикла;
			Для Каждого Субконто Из Правило.ИсключенныеСубконто Цикл
				СтрокаТЧ = СправочникОбъект.ИсключенныеСубконто.Добавить();
				СтрокаТЧ.Субконто = Субконто;
			КонецЦикла;
			СправочникОбъект.Наименование = Правило.ВидАктивовОбязательств;
			СправочникОбъект.Записать();
			
		КонецЦикла;
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ОбновлениеИнформационнойБазыУТ.СообщитьОНеудачнойОбработке(ИнформацияОбОшибке(), Выборка.Ссылка);
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

Процедура ПриДобавленииОбработчиковОбновления(Обработчики) Экспорт
	
	Обработчик = Обработчики.Добавить();
	Обработчик.Процедура = "Справочники.ПравилаГруппировкиАктивовОбязательств.ОбработатьДанныеДляПереходаНаНовуюВерсию";
	Обработчик.Версия = "2.5.26.62";
	Обработчик.РежимВыполнения = "Оперативно";
	Обработчик.Идентификатор = Новый УникальныйИдентификатор("e773725f-20b1-4e0a-acfc-bc045820c7ad");
	Обработчик.Комментарий = НСтр("ru = 'Добавление элемента группировки в 19.НП – ПраваНаВозмещениеНДС и 60.НП – НеотфактурованныеПоставки';
									|en = 'Add a grouping item to 19.GRNI – ПраваНаВозмещениеНДС and 60.GRNI – НеотфактурованныеПоставки'");
	
КонецПроцедуры

Процедура ОбработатьДанныеДляПереходаНаНовуюВерсию() Экспорт
	
	Если Не ПолучитьФункциональнуюОпцию("ИспользоватьНастраиваемуюГруппировкуАктивовОбязательств") Тогда
		Возврат;
	КонецЕсли;
	
	ПравилаГруппировки = НалогНаПрибыльБухгалтерскийУчет.НовыйПравилаГруппировкиАктивовОбязательств();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Правила.ОсновнойСчет КАК ОсновнойСчет,
	|	Правила.ВидАктивовОбязательств КАК ВидАктивовОбязательств
	|ИЗ
	|	Справочник.ПравилаГруппировкиАктивовОбязательств КАК Правила
	|ГДЕ
	|	Правила.ОсновнойСчет В(&ОсновныеСчета)
	|	И Правила.ВидАктивовОбязательств В(&ВидыАктивовОбязательств)";
	
	ОсновныеСчета = Новый Массив;
	ОсновныеСчета.Добавить(ПланыСчетов.Хозрасчетный.НДСпоНеотфактурованнымПоставкам);
	ОсновныеСчета.Добавить(ПланыСчетов.Хозрасчетный.ОбязательстваПоНеотфактурованнымПоставкам);
	
	ВидыАктивовОбязательств = Новый Массив;
	ВидыАктивовОбязательств.Добавить(Перечисления.ВидыАктивовИОбязательств.ПраваНаВозмещениеНДС);
	ВидыАктивовОбязательств.Добавить(Перечисления.ВидыАктивовИОбязательств.НеотфактурованныеПоставки);
	
	Запрос.УстановитьПараметр("ОсновныеСчета", ОсновныеСчета);
	Запрос.УстановитьПараметр("ВидыАктивовОбязательств", ВидыАктивовОбязательств);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	
	Поиск = Новый Структура("ОсновнойСчет, ВидАктивовОбязательств",
		ПланыСчетов.Хозрасчетный.НДСпоНеотфактурованнымПоставкам,
		Перечисления.ВидыАктивовИОбязательств.ПраваНаВозмещениеНДС);
	
	Если Не Выборка.НайтиСледующий(Поиск) Тогда
		Правило = ПравилаГруппировки.Добавить();
		Правило.ОсновнойСчет           = ПланыСчетов.Хозрасчетный.НДСпоНеотфактурованнымПоставкам;
		Правило.ВидАктивовОбязательств = Перечисления.ВидыАктивовИОбязательств.ПраваНаВозмещениеНДС;
	КонецЕсли;
	
	Выборка.Сбросить();
	
	Поиск = Новый Структура("ОсновнойСчет, ВидАктивовОбязательств",
		ПланыСчетов.Хозрасчетный.ОбязательстваПоНеотфактурованнымПоставкам,
		Перечисления.ВидыАктивовИОбязательств.НеотфактурованныеПоставки);
	
	Если Не Выборка.НайтиСледующий(Поиск) Тогда
		Правило = ПравилаГруппировки.Добавить();
		Правило.ОсновнойСчет           = ПланыСчетов.Хозрасчетный.ОбязательстваПоНеотфактурованнымПоставкам;
		Правило.ВидАктивовОбязательств = Перечисления.ВидыАктивовИОбязательств.НеотфактурованныеПоставки;		
	КонецЕсли;
	
	Если Не ПравилаГруппировки.Количество() = 0 Тогда
		НачатьТранзакцию();
		Попытка
			Для Каждого Правило Из ПравилаГруппировки Цикл
				
				СправочникОбъект = Справочники.ПравилаГруппировкиАктивовОбязательств.СоздатьЭлемент();
				СправочникОбъект.ВидАктивовОбязательств = Правило.ВидАктивовОбязательств;
				СправочникОбъект.ОсновнойСчет = Правило.ОсновнойСчет;
				Для Каждого Счет Из Правило.ДополнительныеСчета Цикл
					СтрокаТЧ = СправочникОбъект.ДополнительныеСчета.Добавить();
					СтрокаТЧ.СчетУчета = Счет;
				КонецЦикла;
				Для Каждого Субконто Из Правило.ИсключенныеСубконто Цикл
					СтрокаТЧ = СправочникОбъект.ИсключенныеСубконто.Добавить();
					СтрокаТЧ.Субконто = Субконто;
				КонецЦикла;
				СправочникОбъект.Наименование = Правило.ВидАктивовОбязательств;
				СправочникОбъект.Записать();
			
			КонецЦикла;
		
			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			ОбновлениеИнформационнойБазыУТ.СообщитьОНеудачнойОбработке(ИнформацияОбОшибке(), Выборка.Ссылка);
			ВызватьИсключение;
		КонецПопытки;
	КонецЕсли;
	
КонецПроцедуры

Процедура ВыполнитьЗаполнениеПриВключенииРасширеннойДетализацииРеглУчета() Экспорт
	
	ПравилаГруппировки = НалогНаПрибыльБухгалтерскийУчет.НовыйПравилаГруппировкиАктивовОбязательств();
	НалогНаПрибыльБухгалтерскийУчет.ДополнитьПравилаОсновногоПроизводства(ПравилаГруппировки);
	НалогНаПрибыльБухгалтерскийУчет.ДополнитьПравилаВспомогательныхПроизводств(ПравилаГруппировки);

	НачатьТранзакцию();
	Попытка
		Для Каждого Правило Из ПравилаГруппировки Цикл
			
			СправочникОбъект = Справочники.ПравилаГруппировкиАктивовОбязательств.СоздатьЭлемент();
			СправочникОбъект.ВидАктивовОбязательств = Правило.ВидАктивовОбязательств;
			СправочникОбъект.ОсновнойСчет = Правило.ОсновнойСчет;
			Для Каждого Счет Из Правило.ДополнительныеСчета Цикл
				СтрокаТЧ = СправочникОбъект.ДополнительныеСчета.Добавить();
				СтрокаТЧ.СчетУчета = Счет;
			КонецЦикла;
			Для Каждого Субконто Из Правило.ИсключенныеСубконто Цикл
				СтрокаТЧ = СправочникОбъект.ИсключенныеСубконто.Добавить();
				СтрокаТЧ.Субконто = Субконто;
			КонецЦикла;
			СправочникОбъект.Наименование = Правило.ВидАктивовОбязательств;
			СправочникОбъект.Записать();
		
		КонецЦикла;
	
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ТекстСообщения = НСтр("ru = 'Не удалось заполнить правила группировки активов и обязательств по причине: %Причина%';
								|en = 'Cannot fill in the rules for grouping assets and liabilities due to: %Причина%'");
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Причина%", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			
		ЗаписьЖурналаРегистрации(
				НСтр("ru = 'Правила группировки активов и обязательств.';
					|en = 'Rules for grouping assets and liabilities.'", ОбщегоНазначения.КодОсновногоЯзыка()), 
				УровеньЖурналаРегистрации.Ошибка, , , ТекстСообщения);
		
		ВызватьИсключение ТекстСообщения;
	КонецПопытки;
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

