#Если Не МобильныйАвтономныйСервер Тогда
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Формирует задания к перерасчету налога на прибыль для текущего набора корректировок.
//
// Параметры:
// 	Организация - СправочникСсылка.Организации - Организация, по которой нужно зарегистрировать задания.
// 	Ссылка - СправочникСсылка.КорректировкиПрошлыхПериодовНУ - Набор корректировок, по которому нужно зарегистрировать задание.
// 	Период - Дата - период, с которого нужно зарегистрировать задания к перерасчету по закрытым наборам корректировок. 
// 	СборКорректировокЗакрыт - Булево
//
Процедура ЗарегистрироватьЗаданияКЗакрытиюМесяца(Организация, Ссылка, Период, СборКорректировокЗакрыт) Экспорт
	
	Если ЗначениеЗаполнено(Ссылка) Тогда //Если это новый элемент, то не нужно регистрировать задание, тк движений по нему точно нет
		
		ДанныеСсылки = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Ссылка, "ДатаНачалаПодготовкиДекларации, СборКорректировокЗакрыт");
		Если ДанныеСсылки.СборКорректировокЗакрыт <> СборКорректировокЗакрыт
			Или НачалоМесяца(ДанныеСсылки.ДатаНачалаПодготовкиДекларации) <> НачалоМесяца(Период) Тогда
			
			МассивОрганизаций = Новый Массив();
			МассивОрганизаций.Добавить(Организация);
			ПараметрыРасчета     = Обработки.ОперацииЗакрытияМесяца.ИнициализироватьСтруктуруПараметрыРасчета(Дата(1,1,1),, МассивОрганизаций);
			СтруктураДанных      = Обработки.ОперацииЗакрытияМесяца.ИнициализироватьСтруктуруДанныхДляЗаполненияСостоянияЭтапов(Дата(1,1,1), МассивОрганизаций);
			СтрокаТаблицыЭтапов  = СтруктураДанных.ТаблицаЭтапы.Найти(Справочники.ОперацииЗакрытияМесяца.ПерерасчетНалогаНаПрибыльПрошлыхПериодов, "Код");
			ПараметрыОбработчика = Обработки.ОперацииЗакрытияМесяца.ИнициализироватьПараметрыОбработчикаЭтапа(СтруктураДанных, СтрокаТаблицыЭтапов);
			ПараметрыРасчета.ДатаОкончанияПериода = Дата(1,1,1);//удаляем задания за все периоды.
			ПараметрыРасчета.КонецПериода = Дата(1,1,1);
			ПараметрыОбработчика.Вставить("ПараметрыРасчета", Новый ФиксированнаяСтруктура(ПараметрыРасчета)); 
			
			ЗакрытиеМесяцаСервер.УдалитьЗаданияКРасчетуЗаТекущийПериод(ПараметрыОбработчика,,Ссылка);
			
			Если СборКорректировокЗакрыт Тогда
				РегистрыСведений.ЗаданияКЗакрытиюМесяца.СоздатьЗаписьРегистра(НачалоМесяца(Период), Ссылка, Организация,
														Справочники.ОперацииЗакрытияМесяца.ПерерасчетНалогаНаПрибыльПрошлыхПериодов); 
				Организации = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Организация);
				РеглУчетСервер.СформироватьЗаданияДляПоследующихНаборовКорректировок(Организации, Период);
			КонецЕсли;
	
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

// Закрыть активный (при наличии) и создать новый набор корректировок.
// 
// Параметры:
//  ПараметрыЗакрытияНабораКорректировок - Структура:
//     * Организация - СправочникСсылка.Организации - Организация
//     * ЗакрываемыйНаборКорректировок - СправочникСсылка.КорректировкиПрошлыхПериодовНУ - Закрываемый набор корректировок или пустая ссылка
//     * ЗакрытьСуществующий - Булево - Закрыть существующий открытый набор корректировок перед созданием нового.
Процедура ЗакрытьАктивныйИСоздатьНовыйНаборКорректировок(ПараметрыЗакрытияНабораКорректировок) Экспорт
	
	Организация = ПараметрыЗакрытияНабораКорректировок.Организация;
	ЗакрываемыйНаборКорректировок = ПараметрыЗакрытияНабораКорректировок.ЗакрываемыйНаборКорректировок;
	ЗакрытьСуществующий = ПараметрыЗакрытияНабораКорректировок.ЗакрытьСуществующий;

	Если Не ЗначениеЗаполнено(Организация) Тогда
		Возврат;
	КонецЕсли;

	УстановитьПривилегированныйРежим(Истина);

	ДатаНачалаПодготовкиДекларации = ТекущаяДатаСеанса();

	НачатьТранзакцию();

	Попытка
		// Закрываем активный набор корректировок по указанной организации (если есть и это требуется).
		
		СуществуетОткрытыйНаборКорректировок = Ложь;
		
		Если ЗакрываемыйНаборКорректировок <> Справочники.КорректировкиПрошлыхПериодовНУ.ПустаяСсылка() Тогда
			СуществуетОткрытыйНаборКорректировок = Истина;
			
			Если ЗакрытьСуществующий Тогда
				НаборКорректировок = ЗакрываемыйНаборКорректировок.ПолучитьОбъект(); // СправочникОбъект.КорректировкиПрошлыхПериодовНУ
				Попытка
					НаборКорректировок.Заблокировать();
					
					Если ЗакрываемыйНаборКорректировок <> ОткрытыйНаборКорректировок(Организация) Тогда
						ШаблонОшибки = НСтр("ru = 'Набор корректировок %1 по организации %2 уже закрыт ранее';
											|en = 'The %1 adjustment set for the %2 company was already closed earlier'");
						ТекстОшибки = СтрШаблон(ШаблонОшибки,
												ЗакрываемыйНаборКорректировок,
												Организация);
						ОтменитьТранзакцию();
						ВызватьИсключение ТекстОшибки;
					КонецЕсли;
					
				Исключение
					ШаблонОшибки = НСтр(
						"ru = 'Не удалось заблокировать для закрытия открытый набор корректировок по организации %1.
						|Текущий набор корректировок редактируется другим пользователем.';
						|en = 'Cannot lock the open set of adjustments for the %1 company.
						|The current set of adjustments is being edited by another user.'");
					Информация =  ИнформацияОбОшибке();
					ТекстОшибки = СтрШаблон(ШаблонОшибки, Организация, Информация.Причина);
					
					ОбщегоНазначения.СообщитьПользователю(ТекстОшибки);
					ОтменитьТранзакцию();
					Возврат;
				КонецПопытки;
				
				НаборКорректировок.СборКорректировокЗакрыт = Истина;
				НаборКорректировок.ДатаНачалаПодготовкиДекларации = ДатаНачалаПодготовкиДекларации;
				НаборКорректировок.Записать();
				
				СуществуетОткрытыйНаборКорректировок = Ложь;
			КонецЕсли;
			
		КонецЕсли;
		
		Если Не СуществуетОткрытыйНаборКорректировок Тогда
			// Создаем новый набор корректировок.
			НовыйНаборКорректировок = Справочники.КорректировкиПрошлыхПериодовНУ.СоздатьЭлемент();
			НовыйНаборКорректировок.Заполнить(Неопределено);
			НовыйНаборКорректировок.Владелец = Организация;
			НовыйНаборКорректировок.ДатаНачалаВводаКорректировок = ДатаНачалаПодготовкиДекларации;
			НовыйНаборКорректировок.Записать();
		КонецЕсли;

		ЗафиксироватьТранзакцию();

	Исключение
		ОтменитьТранзакцию();
		ШаблонОшибки = НСтр("ru = 'Не удалось создать новый набор корректировок по организации %1.';
							|en = 'Cannot create a new set of adjustments for the %1 company.'");
		ТекстОшибки = СтрШаблон(ШаблонОшибки, Организация);
		ОбщегоНазначения.СообщитьПользователю(ТекстОшибки);
		Возврат;
	КонецПопытки;
	
КонецПроцедуры

// Получить параметры закрытия набора корректировок.
// 
// Возвращаемое значение:
//  Структура - Параметры закрытия набора корректировок по умолчанию:
// * Организация - СправочникСсылка.Организации - 
// * ЗакрываемыйНаборКорректировок - СправочникСсылка.КорректировкиПрошлыхПериодовНУ - 
// * ЗакрытьСуществующий - Булево - 
Функция ПолучитьПараметрыЗакрытияНабораКорректировок() Экспорт
	ПараметрыЗакрытияНабораКорректировок = Новый Структура;
	
	ПараметрыЗакрытияНабораКорректировок.Вставить("Организация", Справочники.Организации.ПустаяСсылка());
	ПараметрыЗакрытияНабораКорректировок.Вставить("ЗакрываемыйНаборКорректировок", Справочники.КорректировкиПрошлыхПериодовНУ.ПустаяСсылка());
	ПараметрыЗакрытияНабораКорректировок.Вставить("ЗакрытьСуществующий", Ложь);

	Возврат ПараметрыЗакрытияНабораКорректировок;
КонецФункции

// Объединить корректировки.
// 
// Параметры:
//  ОбъединяемыеНаборыКорректировок - Структура:
//   * НаборКорректировокИсточник - СправочникСсылка.КорректировкиПрошлыхПериодовНУ - 
//   * НаборКорректировокПриемник - СправочникСсылка.КорректировкиПрошлыхПериодовНУ -
// 
// Возвращаемое значение:
//  Строка - Результат обработки
Функция ОбъединитьКорректировки(ОбъединяемыеНаборыКорректировок) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Результат = "";
	
	ШаблонОшибки = НСтр("ru = 'Не удалось объединенить наборы корректировок по причине: %1';
						|en = 'Cannot merge sets of adjustments. Reason: %1'");
	
	Если ОбъединяемыеНаборыКорректировок.НаборКорректировокИсточник = ОбъединяемыеНаборыКорректировок.НаборКорректировокПриемник Тогда
		Результат = СтрШаблон(ШаблонОшибки, НСтр("ru = 'Совпадают объединяемые наборы корректировок';
												|en = 'The adjustment sets to merge match'"));
		Возврат Результат;
	КонецЕсли;
	
	НаборыКорректировок = Новый Массив; // Массив из СправочникСсылка.КорректировкиПрошлыхПериодовНУ
	НаборыКорректировок.Добавить(ОбъединяемыеНаборыКорректировок.НаборКорректировокИсточник);
	НаборыКорректировок.Добавить(ОбъединяемыеНаборыКорректировок.НаборКорректировокПриемник);
	
	ПроверкаВладельцев = ОбщегоНазначения.ЗначениеРеквизитаОбъектов(НаборыКорректировок, "Владелец");
	
	Если ПроверкаВладельцев.Получить(ОбъединяемыеНаборыКорректировок.НаборКорректировокИсточник) <> ПроверкаВладельцев.Получить(ОбъединяемыеНаборыКорректировок.НаборКорректировокПриемник) Тогда
		Результат = СтрШаблон(ШаблонОшибки, НСтр("ru = 'Наборы корректировок разных организаций';
												|en = 'Adjustment sets from different companies'"));
		Возврат Результат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	КорректировкиПрошлыхПериодовНУ.Ссылка КАК Ссылка,
	|	КорректировкиПрошлыхПериодовНУ.ДатаНачалаВводаКорректировок КАК ДатаНачалаВводаКорректировок,
	|	КорректировкиПрошлыхПериодовНУ.ДатаНачалаПодготовкиДекларации КАК ДатаНачалаПодготовкиДекларации,
	|	КорректировкиПрошлыхПериодовНУ.Владелец КАК Владелец,
	|	ВЫБОР
	|		КОГДА КорректировкиПрошлыхПериодовНУ.Ссылка = &НаборКорректировокИсточник
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ЭтоИсточник
	|ПОМЕСТИТЬ ДанныеНаборовКорректировок
	|ИЗ
	|	Справочник.КорректировкиПрошлыхПериодовНУ КАК КорректировкиПрошлыхПериодовНУ
	|ГДЕ
	|	КорректировкиПрошлыхПериодовНУ.Ссылка В (&НаборКорректировокИсточник, &НаборКорректировокПриемник)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	МАКСИМУМ(КорректировкиПрошлыхПериодовНУ.ДатаНачалаПодготовкиДекларации) КАК ДатаНачалаПодготовкиДекларации
	|ПОМЕСТИТЬ ДатаПоследнейКорректировки
	|ИЗ
	|	ДанныеНаборовКорректировок КАК ДанныеНаборовКорректировок
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КорректировкиПрошлыхПериодовНУ КАК КорректировкиПрошлыхПериодовНУ
	|		ПО КорректировкиПрошлыхПериодовНУ.Владелец = ДанныеНаборовКорректировок.Владелец
	|		И НЕ ДанныеНаборовКорректировок.ЭтоИсточник
	|		И КорректировкиПрошлыхПериодовНУ.ДатаНачалаПодготовкиДекларации <> ДАТАВРЕМЯ(1, 1, 1)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА МИНИМУМ(ДанныеНаборовКорректировок.ДатаНачалаПодготовкиДекларации) <> ДАТАВРЕМЯ(1, 1, 1)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК НетОткрытогоНабораКорректировок,
	|	МАКСИМУМ(ВЫБОР
	|		КОГДА ДанныеНаборовКорректировок.ДатаНачалаПодготовкиДекларации = ДатаПоследнейКорректировки.ДатаНачалаПодготовкиДекларации
	|		И ДанныеНаборовКорректировок.ЭтоИсточник = ЛОЖЬ
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ) КАК ПриемникПоследнийЗакрытыйНаборКорректировок
	|ИЗ
	|	ДанныеНаборовКорректировок КАК ДанныеНаборовКорректировок
	|		ЛЕВОЕ СОЕДИНЕНИЕ ДатаПоследнейКорректировки КАК ДатаПоследнейКорректировки
	|		ПО ИСТИНА";
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("НаборКорректировокИсточник", ОбъединяемыеНаборыКорректировок.НаборКорректировокИсточник);
	Запрос.УстановитьПараметр("НаборКорректировокПриемник", ОбъединяемыеНаборыКорректировок.НаборКорректировокПриемник);
	
	НачатьТранзакцию();
	Попытка
		БлокировкаДанных = Новый БлокировкаДанных;
		ЭлементБлокировкиДанных = БлокировкаДанных.Добавить("Справочник.КорректировкиПрошлыхПериодовНУ");
		ЭлементБлокировкиДанных.УстановитьЗначение("Ссылка", ОбъединяемыеНаборыКорректировок.НаборКорректировокИсточник);
		ЭлементБлокировкиДанных = БлокировкаДанных.Добавить("Справочник.КорректировкиПрошлыхПериодовНУ");
		ЭлементБлокировкиДанных.УстановитьЗначение("Ссылка", ОбъединяемыеНаборыКорректировок.НаборКорректировокПриемник);
		ЭлементБлокировкиДанных.Режим = РежимБлокировкиДанных.Исключительный;
		БлокировкаДанных.Заблокировать();
				
		РезультатПроверки = Запрос.Выполнить().Выбрать();
	
		Пока РезультатПроверки.Следующий() Цикл
		
			Если РезультатПроверки.НетОткрытогоНабораКорректировок Тогда
				Результат = СтрШаблон(ШаблонОшибки, НСтр("ru = 'Объединить можно открытый набор корректировок с последним закрытым набором корректировок';
														|en = 'You can merge an open adjustment set with the last closed adjustment set'"));
				ОтменитьТранзакцию();
				Возврат Результат;
			КонецЕсли;
		
			Если Не РезультатПроверки.ПриемникПоследнийЗакрытыйНаборКорректировок Тогда
				Результат = СтрШаблон(ШаблонОшибки, НСтр("ru = 'Объединить можно открытый набор корректировок с последним закрытым набором корректировок';
														|en = 'You can merge an open adjustment set with the last closed adjustment set'"));
				ОтменитьТранзакцию();
				Возврат Результат;
			КонецЕсли;
		КонецЦикла;
		
		// Изменяем даты в наборах корректировок источника и приемника.
		ДатаДляНаборовКорректировок = ТекущаяДатаСеанса();
		
		// Сначала заблокируем данные для последующего изменения.
		// Пока идет перенос движений между наборами корректировок, они должны быть неизменны.
		
		БлокировкаДанных = Новый БлокировкаДанных;
		ЭлементБлокировкиДанных = БлокировкаДанных.Добавить("РегистрБухгалтерии.КорректировкиНалоговойБазы");
		ЭлементБлокировкиДанных.УстановитьЗначение("НаборКорректировок", ОбъединяемыеНаборыКорректировок.НаборКорректировокИсточник);
		БлокировкаДанных.Заблокировать();
		
		Приемник = ОбъединяемыеНаборыКорректировок.НаборКорректировокПриемник.ПолучитьОбъект(); // СправочникОбъект.КорректировкиПрошлыхПериодовНУ
		Приемник.ДатаНачалаПодготовкиДекларации = ДатаДляНаборовКорректировок;
		Приемник.Записать();

		Источник = ОбъединяемыеНаборыКорректировок.НаборКорректировокИсточник.ПолучитьОбъект(); // СправочникОбъект.КорректировкиПрошлыхПериодовНУ
		Источник.ДатаНачалаВводаКорректировок = ДатаДляНаборовКорректировок;
		Источник.Записать();
			
		ПерерасчетНалога = НалогНаПрибыльКорректировки.ДокументПерерасчетаНалога(ОбъединяемыеНаборыКорректировок.НаборКорректировокПриемник);
		
		Если ЗначениеЗаполнено(ПерерасчетНалога) Тогда
			ДатаПерерасчетаНалога = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПерерасчетНалога, "Дата");
			
			Если НачалоМесяца(ДатаПерерасчетаНалога) < НачалоМесяца(ДатаДляНаборовКорректировок) Тогда
				ОрганизацияНабора = ПроверкаВладельцев.Получить(ОбъединяемыеНаборыКорректировок.НаборКорректировокПриемник);
				
				НастройкиБлокировок = РегистрыСведений.НастройкаБлокировкиОтИзменений.СведенияОБлокировкеОтИзменений(
					ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ОрганизацияНабора),
					НачалоМесяца(ДатаПерерасчетаНалога));
				
				Если НастройкиБлокировок.ПериодЗаблокированПоВсемОрганизациям Тогда
					Результат = СтрШаблон(ШаблонОшибки, НСтр("ru = 'По закрытому набору корректировок выполнен перерасчет налога, период заблокирован от изменений.';
															|en = 'For the closed adjustment set, the tax is recalculated, and the period is locked from changes.'"));
					
					ОтменитьТранзакцию();
					Возврат Результат;

				Иначе
					ПерерасчетНалогаОбъект = ПерерасчетНалога.ПолучитьОбъект();
					ПерерасчетНалогаОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
					РегистрыСведений.ЗаданияКЗакрытиюМесяца.СоздатьЗаписьРегистра(НачалоМесяца(ДатаДляНаборовКорректировок), 
						ОбъединяемыеНаборыКорректировок.НаборКорректировокПриемник, ОрганизацияНабора,
						Справочники.ОперацииЗакрытияМесяца.ПерерасчетНалогаНаПрибыльПрошлыхПериодов); 
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	
		// Переносим корректировки с источника на приемник.

		ТекстЗапроса =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	КорректировкиНалоговойБазы.Регистратор КАК Документ,
		|	КорректировкиНалоговойБазы.Период КАК Период
		|ИЗ
		|	РегистрБухгалтерии.КорректировкиНалоговойБазы КАК КорректировкиНалоговойБазы
		|ГДЕ
		|	КорректировкиНалоговойБазы.НаборКорректировок = &НаборКорректировокИсточник
		|
		|УПОРЯДОЧИТЬ ПО
		|	Период";

		Запрос.Текст = ТекстЗапроса;

		ДокументыПоИсточнику = Запрос.Выполнить();

		Регистраторы = ДокументыПоИсточнику.Выбрать();

		ДвиженияКорректировок = РегистрыБухгалтерии.КорректировкиНалоговойБазы.СоздатьНаборЗаписей();
		ДвиженияКорректировок.ДополнительныеСвойства.Вставить("ПроверкаИзмененияРегистра", Истина);

		Пока Регистраторы.Следующий() Цикл

			ДвиженияКорректировок.Отбор.Регистратор.Установить(Регистраторы.Документ);

			ДвиженияКорректировок.Прочитать();

			Для Каждого Движение Из ДвиженияКорректировок Цикл
				Движение.НаборКорректировок = ОбъединяемыеНаборыКорректировок.НаборКорректировокПриемник;
			КонецЦикла;

			ДвиженияКорректировок.Записать();

		КонецЦикла;

		Результат = НСтр("ru = 'Выполнено объединение наборов корректировок';
						|en = 'Adjustment sets are merged'");

		ЗафиксироватьТранзакцию();

	Исключение
		ОтменитьТранзакцию();
			
		КраткоеПредставлениеОшибки = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		
		Результат = СтрШаблон(ШаблонОшибки, КраткоеПредставлениеОшибки);

	КонецПопытки;

	Возврат Результат;
	
КонецФункции

// Открытые наборы корректировок.
// 
// Возвращаемое значение:
//  Массив из СправочникСсылка.КорректировкиПрошлыхПериодовНУ - Открытые наборы корректировок
Функция ОткрытыеНаборыКорректировок() Экспорт
	
	ОткрытыеНаборыКорректировок = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса_ОткрытыеНаборыКорректировок();
	Запрос.УстановитьПараметр("БезОтбораПоОрганизации", Истина);
	Запрос.УстановитьПараметр("Организации", Новый Массив);
	Результат = Запрос.Выполнить();

	Если Результат.Пустой() Тогда
		Возврат ОткрытыеНаборыКорректировок;
	КонецЕсли;
		
	Выборка = Результат.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ОткрытыеНаборыКорректировок.Добавить(Выборка.НаборКорректировок);	
	КонецЦикла;
	
	Возврат ОткрытыеНаборыКорректировок;
	
КонецФункции

// Открытый набор корректировок.
// 
// Параметры:
//  Организация - СправочникСсылка.Организации - Организация
// 
// Возвращаемое значение:
//  СправочникСсылка.КорректировкиПрошлыхПериодовНУ - Открытый набор корректировок
Функция ОткрытыйНаборКорректировок(Знач Организация) Экспорт
	
	ОткрытыйНаборКорректировок = Справочники.КорректировкиПрошлыхПериодовНУ.ПустаяСсылка();
	
	Организации = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Организация);
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса_ОткрытыеНаборыКорректировок();
	Запрос.УстановитьПараметр("БезОтбораПоОрганизации", Ложь);
	Запрос.УстановитьПараметр("Организации", Организации);
	
	Результат = Запрос.Выполнить();

	Если Результат.Пустой() Тогда
		Возврат ОткрытыйНаборКорректировок;
	КонецЕсли;
		
	Выборка = Результат.Выбрать();
	Выборка.Следующий();
	
	ОткрытыйНаборКорректировок = Выборка.НаборКорректировок;
	
	Возврат ОткрытыйНаборКорректировок;
	
КонецФункции

// Актуальные закрытые наборы корректировок.
// 
// Возвращаемое значение:
//  Массив из СправочникСсылка.КорректировкиПрошлыхПериодовНУ - Открытые наборы корректировок
Функция АктуальныеЗакрытыеНаборыКорректировок() Экспорт
		
	АктуальныеЗакрытыеНаборыКорректировок = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса_ЗакрытыйНаборКорректировок();
	Запрос.УстановитьПараметр("БезОтбораПоОрганизации", Истина);
	Запрос.УстановитьПараметр("Организации", Новый Массив);
	Результат = Запрос.Выполнить();

	Если Результат.Пустой() Тогда
		Возврат АктуальныеЗакрытыеНаборыКорректировок;
	КонецЕсли;
		
	Выборка = Результат.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		АктуальныеЗакрытыеНаборыКорректировок.Добавить(Выборка.НаборКорректировок);	
	КонецЦикла;
	
	Возврат АктуальныеЗакрытыеНаборыКорректировок;
	
КонецФункции

// Актуальный закрытый набор корректировок.
// 
// Параметры:
//  Организация - СправочникСсылка.Организации - Организация
// 
// Возвращаемое значение:
//  СправочникСсылка.КорректировкиПрошлыхПериодовНУ - Актуальный закрытый набор корректировок
Функция АктуальныйЗакрытыйНаборКорректировок(Знач Организация) Экспорт
	
	АктуальныйЗакрытыйНаборКорректировок = Справочники.КорректировкиПрошлыхПериодовНУ.ПустаяСсылка();
	
	Организации = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Организация);
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса_ЗакрытыйНаборКорректировок();
	Запрос.УстановитьПараметр("БезОтбораПоОрганизации", Ложь);
	Запрос.УстановитьПараметр("Организации", Организации);
	
	Результат = Запрос.Выполнить();

	Если Результат.Пустой() Тогда
		Возврат АктуальныйЗакрытыйНаборКорректировок;
	КонецЕсли;
		
	Выборка = Результат.Выбрать();
	Выборка.Следующий();
	
	АктуальныйЗакрытыйНаборКорректировок = Выборка.НаборКорректировок;
	
	Возврат АктуальныйЗакрытыйНаборКорректировок;
	
КонецФункции

// Наборы корректировок по дате подписи декларации.
// 
// Параметры:
//  ДатаПодписи - Дата - Дата подписи
//  Организация - СправочникСсылка.Организации - Организация
// 
// Возвращаемое значение:
//  Массив из СправочникСсылка.КорректировкиПрошлыхПериодовНУ - Наборы корректировок по дате подписи декларации
Функция НаборыКорректировокПоДатеПодписиДекларации(Знач ДатаПодписи, Знач Организация) Экспорт
	
	НаборыКорректировок = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДатаПодписи", КонецДня(ДатаПодписи));
	Запрос.УстановитьПараметр("Владелец", Организация);
	
	Запрос.Текст = "
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	КорректировкиПрошлыхПериодовНУ.Ссылка
	|ИЗ
	|	Справочник.КорректировкиПрошлыхПериодовНУ КАК КорректировкиПрошлыхПериодовНУ
	|ГДЕ
	|	КорректировкиПрошлыхПериодовНУ.Владелец = &Владелец
	|	И КорректировкиПрошлыхПериодовНУ.ДатаНачалаПодготовкиДекларации <= &ДатаПодписи
	|	И КорректировкиПрошлыхПериодовНУ.СборКорректировокЗакрыт";
	
	Результат = Запрос.Выполнить();
	
	Если Результат.Пустой() Тогда
		Возврат НаборыКорректировок;
	КонецЕсли;
	
	Выборка = Результат.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		НаборыКорректировок.Добавить(Выборка.Ссылка);
	КонецЦикла;
	
	Возврат НаборыКорректировок;
	
КонецФункции

// Последний закрытый набор корректировок по дате подписи декларации.
// 
// Параметры:
//  ДатаПодписи - Дата - Дата подписи
//  Организация - СправочникСсылка.Организации - Организация
// 
// Возвращаемое значение:
//  СправочникСсылка.КорректировкиПрошлыхПериодовНУ - Последний закрытый набор корректировок по дате подписи декларации
Функция ПоследнийЗакрытыйНаборКорректировокПоДатеПодписиДекларации(Знач ДатаПодписи, Знач Организация) Экспорт
	
	НаборКорректировок = Справочники.КорректировкиПрошлыхПериодовНУ.ПустаяСсылка();
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДатаПодписи", КонецДня(ДатаПодписи));
	Запрос.УстановитьПараметр("Владелец", Организация);
	
	Запрос.Текст = "
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	МАКСИМУМ(КорректировкиПрошлыхПериодовНУ.ДатаНачалаПодготовкиДекларации) КАК ДатаНачалаПодготовкиДекларации
	|ПОМЕСТИТЬ ВТ_МаксимальныеДатыЗакрытыхНаборов
	|ИЗ
	|	Справочник.КорректировкиПрошлыхПериодовНУ КАК КорректировкиПрошлыхПериодовНУ
	|ГДЕ
	|	КорректировкиПрошлыхПериодовНУ.СборКорректировокЗакрыт
	|	И НЕ КорректировкиПрошлыхПериодовНУ.ПометкаУдаления
	|	И КорректировкиПрошлыхПериодовНУ.ДатаНачалаПодготовкиДекларации <= &ДатаПодписи
	|	И КорректировкиПрошлыхПериодовНУ.Владелец = &Владелец
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	КорректировкиПрошлыхПериодовНУ.Ссылка КАК НаборКорректировок
	|ИЗ
	|	ВТ_МаксимальныеДатыЗакрытыхНаборов КАК ВТ_МаксимальныеДатыЗакрытыхНаборов
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КорректировкиПрошлыхПериодовНУ КАК КорректировкиПрошлыхПериодовНУ
	|		ПО ВТ_МаксимальныеДатыЗакрытыхНаборов.ДатаНачалаПодготовкиДекларации = КорректировкиПрошлыхПериодовНУ.ДатаНачалаПодготовкиДекларации
	|		И КорректировкиПрошлыхПериодовНУ.Владелец = &Владелец
	|		И НЕ КорректировкиПрошлыхПериодовНУ.ПометкаУдаления
	|		И КорректировкиПрошлыхПериодовНУ.СборКорректировокЗакрыт";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		НаборКорректировок = Выборка.НаборКорректировок;
	КонецЕсли;
	
	Возврат НаборКорректировок;
	
КонецФункции

// Открытый набор корректировок закрыт.
// 
// Параметры:
//  ОрганизацияПерерасчетаНалога - СправочникСсылка.Организации - Организация перерасчета налога
//  ОткрытыйНаборКорректировок - СправочникСсылка.КорректировкиПрошлыхПериодовНУ - Открытый набор корректировок
// 
// Возвращаемое значение:
//  Булево - Открытый набор корректировок закрыт
Функция ОткрытыйНаборКорректировокЗакрыт(ОрганизацияПерерасчетаНалога, ОткрытыйНаборКорректировок) Экспорт
	
	ТекущийОткрытыйНаборКорректировок = Справочники.КорректировкиПрошлыхПериодовНУ.ОткрытыйНаборКорректировок(ОрганизацияПерерасчетаНалога);
	
	Возврат  ТекущийОткрытыйНаборКорректировок <> ОткрытыйНаборКорректировок;
	
КонецФункции

#Область ДляВызоваИзДругихПодсистем
// СтандартныеПодсистемы.УправлениеДоступом
// Параметры:
//   Ограничение - см. УправлениеДоступомПереопределяемый.ПриЗаполненииОграниченияДоступа.Ограничение.
//
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт
	
	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЧтениеОбъектаРазрешено(Владелец)
	|";

КонецПроцедуры

// Конец СтандартныеПодсистемы.УправлениеДоступом
#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции
	
Функция ТекстЗапроса_ОткрытыеНаборыКорректировок()
	
	Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	КорректировкиПрошлыхПериодовНУ.Ссылка КАК НаборКорректировок
	|ИЗ
	|	Справочник.КорректировкиПрошлыхПериодовНУ КАК КорректировкиПрошлыхПериодовНУ
	|ГДЕ
	|	НЕ КорректировкиПрошлыхПериодовНУ.СборКорректировокЗакрыт
	|	И НЕ КорректировкиПрошлыхПериодовНУ.ПометкаУдаления
	|	И (&БезОтбораПоОрганизации
	|	ИЛИ КорректировкиПрошлыхПериодовНУ.Владелец В (&Организации))";
	
	Возврат Текст;
	
КонецФункции

Функция ТекстЗапроса_ЗакрытыйНаборКорректировок()
	
	Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	КорректировкиПрошлыхПериодовНУ.Владелец КАК Организация,
	|	МАКСИМУМ(КорректировкиПрошлыхПериодовНУ.ДатаНачалаПодготовкиДекларации) КАК ДатаНачалаПодготовкиДекларации
	|ПОМЕСТИТЬ ВТ_МаксимальныеДатыЗакрытыхНаборов
	|ИЗ
	|	Справочник.КорректировкиПрошлыхПериодовНУ КАК КорректировкиПрошлыхПериодовНУ
	|ГДЕ
	|	КорректировкиПрошлыхПериодовНУ.СборКорректировокЗакрыт
	|	И НЕ КорректировкиПрошлыхПериодовНУ.ПометкаУдаления
	|	И (&БезОтбораПоОрганизации
	|	ИЛИ КорректировкиПрошлыхПериодовНУ.Владелец В (&Организации))
	|СГРУППИРОВАТЬ ПО
	|	КорректировкиПрошлыхПериодовНУ.Владелец
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	КорректировкиПрошлыхПериодовНУ.Ссылка КАК НаборКорректировок
	|ИЗ
	|	ВТ_МаксимальныеДатыЗакрытыхНаборов КАК ВТ_МаксимальныеДатыЗакрытыхНаборов
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КорректировкиПрошлыхПериодовНУ КАК КорректировкиПрошлыхПериодовНУ
	|		ПО ВТ_МаксимальныеДатыЗакрытыхНаборов.ДатаНачалаПодготовкиДекларации = КорректировкиПрошлыхПериодовНУ.ДатаНачалаПодготовкиДекларации
	|		И ВТ_МаксимальныеДатыЗакрытыхНаборов.Организация = КорректировкиПрошлыхПериодовНУ.Владелец
	|		И НЕ КорректировкиПрошлыхПериодовНУ.ПометкаУдаления
	|		И КорректировкиПрошлыхПериодовНУ.СборКорректировокЗакрыт
	|		И НЕ КорректировкиПрошлыхПериодовНУ.НеКонтролироватьСдачуДеклараций";

	Возврат Текст;
	
КонецФункции

#Область ОбновлениеИнформационнойБазы
// см. ОбновлениеИнформационнойБазыБСП.ПриДобавленииОбработчиковОбновления
//
Процедура ПриДобавленииОбработчиковОбновления(Обработчики) Экспорт

	Обработчик = Обработчики.Добавить();
	Обработчик.Процедура = "Справочники.КорректировкиПрошлыхПериодовНУ.ОбработатьДанныеДляПереходаНаНовуюВерсию";
	Обработчик.Версия = "2.5.26.61";
	Обработчик.РежимВыполнения = "Отложенно";
	Обработчик.Идентификатор = Новый УникальныйИдентификатор("e4c9a9d4-12d6-44f3-9401-010b3ec8b060");
	Обработчик.Многопоточный = Истина;
	Обработчик.ПроцедураЗаполненияДанныхОбновления = "Справочники.КорректировкиПрошлыхПериодовНУ.ЗарегистрироватьДанныеКОбработкеДляПереходаНаНовуюВерсию";
	Обработчик.ПроцедураПроверки = "ОбновлениеИнформационнойБазы.ДанныеОбновленыНаНовуюВерсиюПрограммы";
	
	Обработчик.Комментарий = НСтр("ru = 'Создание наборов корректировок прошлых периодов НУ по головным организациям на общей системе налогообложения';
									|en = 'Create adjustment sets of previous TA periods for parent companies based on the general taxation system'");
	Обработчик.Порядок = Перечисления.ПорядокОбработчиковОбновления.Обычный;
	
	Читаемые = Новый Массив;
	Читаемые.Добавить(Метаданные.Справочники.Организации.ПолноеИмя());
	Читаемые.Добавить(Метаданные.РегистрыСведений.НастройкиСистемыНалогообложения.ПолноеИмя());
	Читаемые.Добавить(Метаданные.Справочники.КорректировкиПрошлыхПериодовНУ.ПолноеИмя());
	Обработчик.ЧитаемыеОбъекты = СтрСоединить(Читаемые, ",");
	
	Изменяемые = Новый Массив;
	Изменяемые.Добавить(Метаданные.Справочники.КорректировкиПрошлыхПериодовНУ.ПолноеИмя());
	Обработчик.ИзменяемыеОбъекты = СтрСоединить(Изменяемые, ",");
	
	Блокируемые = Новый Массив;
	Блокируемые.Добавить(Метаданные.Справочники.Организации.ПолноеИмя());
	Блокируемые.Добавить(Метаданные.Справочники.КорректировкиПрошлыхПериодовНУ.ПолноеИмя());
	Блокируемые.Добавить(Метаданные.РегистрыСведений.НастройкиСистемыНалогообложения.ПолноеИмя());
	Обработчик.БлокируемыеОбъекты = СтрСоединить(Блокируемые, ",");

КонецПроцедуры

// Параметры:
// 	Параметры - см. ОбновлениеИнформационнойБазы.ОсновныеПараметрыОтметкиКОбработке
//
Процедура ЗарегистрироватьДанныеКОбработкеДляПереходаНаНовуюВерсию(Параметры) Экспорт
	
	ПараметрыВыборки = Параметры.ПараметрыВыборки;
	ПараметрыВыборки.ПолныеИменаОбъектов = Метаданные.Справочники.Организации.ПолноеИмя();
	ПараметрыВыборки.СпособВыборки = ОбновлениеИнформационнойБазы.СпособВыборкиСсылки();
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	НастройкиСистемыНалогообложенияСрезПоследних.Организация КАК Организация
	|ПОМЕСТИТЬ ГоловныеОрганизацииНаОСНО
	|ИЗ
	|	РегистрСведений.НастройкиСистемыНалогообложения.СрезПоследних(, Организация.Ссылка = Организация.ГоловнаяОрганизация
	|	И Организация <> ЗНАЧЕНИЕ(Справочник.Организации.УправленческаяОрганизация)) КАК
	|		НастройкиСистемыНалогообложенияСрезПоследних
	|ГДЕ
	|	НастройкиСистемыНалогообложенияСрезПоследних.СистемаНалогообложения = ЗНАЧЕНИЕ(Перечисление.СистемыНалогообложения.Общая)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ГоловныеОрганизацииНаОСНО.Организация КАК Организация
	|ИЗ
	|	ГоловныеОрганизацииНаОСНО КАК ГоловныеОрганизацииНаОСНО
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КорректировкиПрошлыхПериодовНУ КАК КорректировкиПрошлыхПериодовНУ
	|		ПО ГоловныеОрганизацииНаОСНО.Организация = КорректировкиПрошлыхПериодовНУ.Владелец
	|		И КорректировкиПрошлыхПериодовНУ.СборКорректировокЗакрыт = ЛОЖЬ
	|ГДЕ
	|	КорректировкиПрошлыхПериодовНУ.Ссылка ЕСТЬ NULL";

	ОрганизацииДляСозданияНаборовКорректировок = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Организация");

	ОбновлениеИнформационнойБазы.ОтметитьКОбработке(Параметры, ОрганизацииДляСозданияНаборовКорректировок);
	
КонецПроцедуры

// Обработчик обновления
// 
// Параметры:
// 	Параметры - См. ОбновлениеИнформационнойБазы.ДополнительныеПараметрыВыборкиДанныхДляМногопоточнойОбработки 
//
Процедура ОбработатьДанныеДляПереходаНаНовуюВерсию(Параметры) Экспорт
	
	Параметры.ОбработкаЗавершена = Ложь;
	
	ПолноеИмяОбъекта = Метаданные.Справочники.Организации.ПолноеИмя();
	
	ОбновляемыеДанные = ОбновлениеИнформационнойБазы.ДанныеДляОбновленияВМногопоточномОбработчике(Параметры);
	
	Если ОбновляемыеДанные.Количество() = 0 Тогда
		
		Параметры.ОбработкаЗавершена =
			ОбновлениеИнформационнойБазы.ОбработкаДанныхЗавершена(Параметры.Очередь, ПолноеИмяОбъекта);
		Возврат;
		
	КонецЕсли;
	
	ПараметрыЗакрытияНабораКорректировок = ПолучитьПараметрыЗакрытияНабораКорректировок();
	
	Для Каждого СтрокаОбновляемыхДанных Из ОбновляемыеДанные Цикл
		ПараметрыЗакрытияНабораКорректировок.Организация = СтрокаОбновляемыхДанных.Ссылка;
		Справочники.КорректировкиПрошлыхПериодовНУ.ЗакрытьАктивныйИСоздатьНовыйНаборКорректировок(ПараметрыЗакрытияНабораКорректировок);
		ОбновлениеИнформационнойБазы.ОтметитьВыполнениеОбработки(СтрокаОбновляемыхДанных.Ссылка);
		
	КонецЦикла;
	
	Параметры.ОбработкаЗавершена =
		ОбновлениеИнформационнойБазы.ОбработкаДанныхЗавершена(Параметры.Очередь, ПолноеИмяОбъекта);
	
КонецПроцедуры

#КонецОбласти
#КонецОбласти

#КонецЕсли
#КонецЕсли
