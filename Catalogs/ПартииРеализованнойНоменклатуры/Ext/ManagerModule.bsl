#Область ПрограммныйИнтерфейс

// Возвращает наименование партии реализованной номенклатуры.
//
// Параметры:
//  СтруктураПартии				- СправочникОбъект.ПартииРеализованнойНоменклатуры, Структура - партия реализованной номенклатуры.
// 
// Возвращаемое значение:
//  Строка - наименование партии реализованной номенклатуры.
//
Функция НаименованиеПартииРеализованнойНоменклатуры(СтруктураПартии) Экспорт
	
	Если ЗначениеЗаполнено(СтруктураПартии.ДокументРеализации) Тогда 
		МенеджерОбъекта = ОбщегоНазначения.МенеджерОбъектаПоСсылке(СтруктураПартии.ДокументРеализации);
		ПредставлениеДокумента = МенеджерОбъекта.ПредставлениеОбъектаНаОсновномЯзыке();
	Иначе
		ПредставлениеДокумента = "";
	КонецЕсли;
	Если ЗначениеЗаполнено(СтруктураПартии.ПартияНоменклатуры) Тогда 
		ПредставлениеПартииНоменклатуры = Строка(СтруктураПартии.ПартияНоменклатуры);
	Иначе
		ПредставлениеПартииНоменклатуры = "";
	КонецЕсли;
	Если ЗначениеЗаполнено(СтруктураПартии.Номенклатура) Тогда
		ПредставлениеНоменклатуры = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтруктураПартии.Номенклатура,"Наименование")
	Иначе 
		ПредставлениеНоменклатуры = "";
	КонецЕсли;
	Если ЗначениеЗаполнено(СтруктураПартии.Контрагент) Тогда
		ПредставлениеКонтрагента = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтруктураПартии.Контрагент,"Наименование")
	Иначе 
		ПредставлениеКонтрагента = "";
	КонецЕсли;
	Если ЗначениеЗаполнено(СтруктураПартии.Договор) Тогда
		ПредставлениеДоговора = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтруктураПартии.Договор,"Наименование")
	Иначе 
		ПредставлениеДоговора = "";
	КонецЕсли;
	
	ПредставлениеПартии = НСтр("ru = '%ПредставлениеДокумента% (%Номенклатура%, %Контрагент%, %Договор%, %ПредставлениеПартииНоменклатуры%)';
								|en = '%ПредставлениеДокумента% (%Номенклатура%, %Контрагент%, %Договор%, %ПредставлениеПартииНоменклатуры%)'");
	
	ПредставлениеПартии = СтрЗаменить(ПредставлениеПартии, "%ПредставлениеДокумента%",	ПредставлениеДокумента);
	ПредставлениеПартии = СтрЗаменить(ПредставлениеПартии, "%ПредставлениеПартииНоменклатуры%",	ПредставлениеПартииНоменклатуры);
	ПредставлениеПартии = СтрЗаменить(ПредставлениеПартии, "%Номенклатура%",			ПредставлениеНоменклатуры);
	ПредставлениеПартии = СтрЗаменить(ПредставлениеПартии, "%Контрагент%",				ПредставлениеКонтрагента);
	ПредставлениеПартии = СтрЗаменить(ПредставлениеПартии, "%Договор%",					ПредставлениеДоговора);
	
	ПредставлениеПартии = СокрЛП(ПредставлениеПартии);
	
	Возврат ПредставлениеПартии;
	
КонецФункции

// Производит поиск/создание элемента справочника ПартииРеализованнойНоменклатуры по входным данным.
// Возвращает массив ссылок на найденные/созданные элементы справочника ПартииРеализованнойНоменклатуры.
//
// Параметры:
//  ПараметрыАналитики - Структура - Коллекция параметров для поиска/создания элемента справочника.
// 
// Возвращаемое значение:
//  - СправочникСсылка.ПартииРеализованнойНоменклатуры
//  - Неопределено.
//
Функция ЗначениеПартииРеализованнойНоменклатуры(ПараметрыАналитики) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ПартииРеализованнойНоменклатуры.Ссылка
		|ИЗ
		|	Справочник.ПартииРеализованнойНоменклатуры КАК ПартииРеализованнойНоменклатуры
		|ГДЕ
		|	ПартииРеализованнойНоменклатуры.ДокументРеализации = &ДокументРеализации
		|	И ПартииРеализованнойНоменклатуры.Номенклатура = &Номенклатура
		|	И ПартииРеализованнойНоменклатуры.ПартияНоменклатуры = &ПартияНоменклатуры
		|	И ПартииРеализованнойНоменклатуры.Контрагент = &Контрагент
		|	И ПартииРеализованнойНоменклатуры.Договор = &Договор";
	
	Запрос.УстановитьПараметр("ДокументРеализации", ПараметрыАналитики.ДокументРеализации);
	Запрос.УстановитьПараметр("Номенклатура", ПараметрыАналитики.Номенклатура);
	Запрос.УстановитьПараметр("ПартияНоменклатуры", ПараметрыАналитики.ПартияНоменклатуры);
	Запрос.УстановитьПараметр("Контрагент", ПараметрыАналитики.Контрагент);
	Запрос.УстановитьПараметр("Договор", ПараметрыАналитики.Договор);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	Иначе
		Возврат СоздатьПартииРеализованнойНоменклатуры(ПараметрыАналитики);
	КонецЕсли;
	
КонецФункции

// Производит создание элементов справочника ПартииРеализованнойНоменклатуры по входным данным.
// Возвращает массив ссылок на созданные элементы справочника ПартииРеализованнойНоменклатуры.
//
// Параметры:
//  ИсходныеДанные - Структура, ТаблицаЗначений, МенеджерВременныхТаблиц - Коллекция данных для поиска/создания элемента справочника.
//  ИмяТаблицы - Строка - Имя временной таблицы, содержащей исходные данные, для случая, когда в качестве параметра ИсходныеДанные передается МенеджерВременныхТаблиц.
// 
// Возвращаемое значение:
//  - СправочникСсылка.ПартииРеализованнойНоменклатуры
//  - Массив из СправочникСсылка.ПартииРеализованнойНоменклатуры
//  - Неопределено.
//
Функция СоздатьПартииРеализованнойНоменклатуры(ИсходныеДанные, ИмяТаблицы = "ВтДанныеПродаж") Экспорт
	
	МассивСозданныхЭлементов = Новый Массив;
	Запрос = Новый Запрос;
	ТекстыЗапроса = Новый Массив;
	
	Если ТипЗнч(ИсходныеДанные) = Тип("Структура") Тогда
		
		Запрос.УстановитьПараметр("ДокументРеализации", ИсходныеДанные.ДокументРеализации);
		Запрос.УстановитьПараметр("Номенклатура", ИсходныеДанные.Номенклатура);
		Запрос.УстановитьПараметр("ПартияНоменклатуры", ИсходныеДанные.ПартияНоменклатуры);
		Запрос.УстановитьПараметр("Контрагент", ИсходныеДанные.Контрагент);
		Запрос.УстановитьПараметр("Договор", ИсходныеДанные.Договор);
		Запрос.УстановитьПараметр("ТоварыРаботыУслугиСобственногоПроизводства",
			ИсходныеДанные.ТоварыРаботыУслугиСобственногоПроизводства);
		
		ТекстЗапроса =
		"ВЫБРАТЬ
		|	&ДокументРеализации КАК ДокументРеализации,
		|	&Номенклатура КАК Номенклатура,
		|	&ПартияНоменклатуры КАК ПартияНоменклатуры,
		|	&Контрагент КАК Контрагент,
		|	&Договор КАК Договор,
		|	&ТоварыРаботыУслугиСобственногоПроизводства КАК ТоварыРаботыУслугиСобственногоПроизводства
		|ПОМЕСТИТЬ ВтДанныеПродаж
		|";
		
		ТекстыЗапроса.Добавить(ТекстЗапроса);
		
	ИначеЕсли ТипЗнч(ИсходныеДанные) = Тип("ТаблицаЗначений") 
		И ИсходныеДанные.Колонки.Найти("ДокументРеализации") <> Неопределено
		И ИсходныеДанные.Колонки.Найти("Номенклатура") <> Неопределено
		И ИсходныеДанные.Колонки.Найти("ПартияНоменклатуры") <> Неопределено
		И ИсходныеДанные.Колонки.Найти("Контрагент") <> Неопределено
		И ИсходныеДанные.Колонки.Найти("Договор") <> Неопределено
		И ИсходныеДанные.Колонки.Найти("ТоварыРаботыУслугиСобственногоПроизводства") <> Неопределено Тогда
		
		Запрос.УстановитьПараметр("ДанныеПродаж", ИсходныеДанные);
		
		ТекстЗапроса =
		"ВЫБРАТЬ
		|	Данные.ДокументРеализации КАК ДокументРеализации,
		|	Данные.Номенклатура КАК Номенклатура,
		|	Данные.ПартияНоменклатуры КАК ПартияНоменклатуры,
		|	Данные.Контрагент КАК Контрагент,
		|	Данные.Договор КАК Договор,
		|	Данные.ТоварыРаботыУслугиСобственногоПроизводства КАК ТоварыРаботыУслугиСобственногоПроизводства
		|ПОМЕСТИТЬ ВтДанныеПродаж
		|ИЗ
		|	&ДанныеПродаж КАК Данные
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	ДокументРеализации,
		|	Номенклатура,
		|	ПартияНоменклатуры,
		|	Контрагент,
		|	Договор
		|";
		
		ТекстыЗапроса.Добавить(ТекстЗапроса);
		
	ИначеЕсли ТипЗнч(ИсходныеДанные) = Тип("МенеджерВременныхТаблиц")
		И ИсходныеДанные.Таблицы.Найти(ИмяТаблицы) <> Неопределено Тогда
		
		Запрос.МенеджерВременныхТаблиц = ИсходныеДанные;
		
	Иначе
		
		Возврат Неопределено;
		
	КонецЕсли;
	
	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Данные.ДокументРеализации     КАК ДокументРеализации,
	|	Данные.Номенклатура           КАК Номенклатура,
	|	Данные.ПартияНоменклатуры     КАК ПартияНоменклатуры,
	|	Данные.Контрагент             КАК Контрагент,
	|	Данные.Договор                КАК Договор,
	|	Данные.ТоварыРаботыУслугиСобственногоПроизводства КАК ТоварыРаботыУслугиСобственногоПроизводства
	|ИЗ
	|	ВтДанныеПродаж КАК Данные
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПартииРеализованнойНоменклатуры КАК ПартииРеализованнойНоменклатуры
	|		ПО Данные.ДокументРеализации = ПартииРеализованнойНоменклатуры.ДокументРеализации
	|			И Данные.Номенклатура = ПартииРеализованнойНоменклатуры.Номенклатура
	|			И Данные.ПартияНоменклатуры = ПартииРеализованнойНоменклатуры.ПартияНоменклатуры
	|			И Данные.Контрагент = ПартииРеализованнойНоменклатуры.Контрагент
	|			И Данные.Договор = ПартииРеализованнойНоменклатуры.Договор
	|ГДЕ
	|	Данные.Номенклатура <> НЕОПРЕДЕЛЕНО
	|		И ПартииРеализованнойНоменклатуры.ПартияРеализованнойНоменклатуры ЕСТЬ NULL";
	
	Если ТипЗнч(ИсходныеДанные) = Тип("МенеджерВременныхТаблиц") Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ВтДанныеПродаж", ИмяТаблицы);
	КонецЕсли;
	
	ТекстыЗапроса.Добавить(ТекстЗапроса);
	
	Запрос.Текст = СтрСоединить(ТекстыЗапроса, ОбщегоНазначения.РазделительПакетаЗапросов());
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		ПартияРеализованнойНоменклатуры = Справочники.ПартииРеализованнойНоменклатуры.СоздатьЭлемент();
		ПартияРеализованнойНоменклатуры.Заполнить(Неопределено);
		ЗаполнитьЗначенияСвойств(ПартияРеализованнойНоменклатуры, Выборка);
		ПартияРеализованнойНоменклатуры.Записать();
		
		МассивСозданныхЭлементов.Добавить(ПартияРеализованнойНоменклатуры.Ссылка);
		
	КонецЦикла;
	
	Если НЕ МассивСозданныхЭлементов.Количество() Тогда
		Возврат Неопределено;
	ИначеЕсли
		МассивСозданныхЭлементов.Количество() = 1 Тогда
		Возврат МассивСозданныхЭлементов[0];
	Иначе
		Возврат МассивСозданныхЭлементов;
	КонецЕсли;
	
КонецФункции

// Возвращает имена блокируемых реквизитов для механизма блокирования реквизитов БСП.
//
// Возвращаемое значение:
//	Массив Из Строка - имена блокируемых реквизитов.
//
Функция ПолучитьБлокируемыеРеквизитыОбъекта() Экспорт
	
	РеквизитыСправочника = ПустаяСсылка().Метаданные().Реквизиты;

	Результат = Новый Массив;
	Результат.Добавить("Наименование");
	Для каждого Реквизит Из РеквизитыСправочника Цикл
		Результат.Добавить(Реквизит.Имя);
	КонецЦикла;
	
	Возврат Результат;
КонецФункции

// Возращает значение признака ТоварыРаботыУслугиСобственногоПроизводства по полям ключа
// 
// Параметры:
//  ДокументРеализации - ДокументСсылка
//  Номенклатура -  СправочникСсылка.Номенклатура
//  ПартияНоменклатуры - ДокументСсылка
// 
// Возвращаемое значение:
//  Булево - 
Функция ТоварыРаботыУслугиСобственногоПроизводства(ДокументРеализации, Номенклатура, ПартияНоменклатуры) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	&Номенклатура КАК Номенклатура,
	|	&ПартияНоменклатуры КАК ПартияНоменклатуры,
	|	&ДокументРеализации КАК ДокументРеализации
	|ПОМЕСТИТЬ Данные
	|;
	|
	|///////////////////////////////////
	|ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА СправочникНоменклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Услуга)
	|			ТОГДА ИСТИНА
	//++ НЕ УТКА
	|		КОГДА СправочникНоменклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Работа)
	|			И ТИПЗНАЧЕНИЯ(Данные.ПартияНоменклатуры) В (
	|				ТИП(Документ.ОтчетДавальцу),
	|				ТИП(Документ.ОтчетДавальцу2_5),
	|				ТИП(Документ.ОтчетДавальцуМеждуОрганизациями))
	|			ТОГДА ИСТИНА
	|		КОГДА СправочникНоменклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Работа)
	|			И Данные.ПартияНоменклатуры = НЕОПРЕДЕЛЕНО
	|			И ТИПЗНАЧЕНИЯ(Данные.ДокументРеализации) В (
	|				ТИП(Документ.ОтчетДавальцу),
	|				ТИП(Документ.ОтчетДавальцу2_5),
	|				ТИП(Документ.ОтчетДавальцуМеждуОрганизациями))
	|			ТОГДА ИСТИНА
	//-- НЕ УТКА
	|		КОГДА СправочникНоменклатура.ТипНоменклатуры В (
	|				ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Товар),
	|				ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.МногооборотнаяТара),
	|				ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Работа))
	|			ТОГДА ВЫБОР
	|				КОГДА ТИПЗНАЧЕНИЯ(Данные.ПартияНоменклатуры) В (
	//++ НЕ УТКА
	|					ТИП(Документ.ЭтапПроизводства2_2),
	//-- НЕ УТКА
	|					ТИП(Документ.ПроизводствоБезЗаказа),
	|					ТИП(Документ.ВыпускПродукции),
	|					ТИП(Документ.РаспределениеВозвратныхОтходов),
	|					ТИП(Документ.ОтчетПереработчика2_5),
	|					ТИП(Документ.ОтчетПереработчика))
	|					ТОГДА ИСТИНА
	|				КОГДА ТИПЗНАЧЕНИЯ(Данные.ПартияНоменклатуры) = ТИП(Документ.СборкаТоваров)
	|					И ЕСТЬNULL(УчетнаяПолитикаОрганизаций.СборкаТоваровЧерезСчет20, ЛОЖЬ)
	|					ТОГДА ИСТИНА
	|				КОГДА ТИПЗНАЧЕНИЯ(Данные.ПартияНоменклатуры) = ТИП(Документ.ПервичныйДокумент)
	|					ТОГДА ВЫБОР
	|						КОГДА ВЫРАЗИТЬ(Данные.ПартияНоменклатуры КАК Документ.ПервичныйДокумент).ТипПервичногоДокумента В (
	|							ЗНАЧЕНИЕ(Перечисление.ТипыПервичныхДокументов.ВнутренняяНакладная),
	|							ЗНАЧЕНИЕ(Перечисление.ТипыПервичныхДокументов.ОтчетПереработчика))
	|							ТОГДА ИСТИНА
	|						ИНАЧЕ ЛОЖЬ
	|					КОНЕЦ
	|				ИНАЧЕ ЛОЖЬ
	|			КОНЕЦ
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ТоварыРаботыУслугиСобственногоПроизводства
	|ИЗ
	|	Данные КАК Данные
	|	ЛЕВОЕ СОЕДИНЕНИЕ
	|		Справочник.Номенклатура КАК СправочникНоменклатура
	|	ПО
	|		Данные.Номенклатура = СправочникНоменклатура.Ссылка
	|	ЛЕВОЕ СОЕДИНЕНИЕ 
	|		РегистрСведений.УчетнаяПолитикаБухУчета.СрезПоследних(&Дата, Организация = &Организация) КАК УчетнаяПолитикаОрганизаций
	|	ПО ИСТИНА
	|";
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("ПартияНоменклатуры", 
		?(ПартияНоменклатуры = Неопределено, Документы.ПервичныйДокумент.ПустаяСсылка(), ПартияНоменклатуры));
	Запрос.УстановитьПараметр("ДокументРеализации", 
		?(ДокументРеализации = Неопределено, Документы.ПервичныйДокумент.ПустаяСсылка(), ДокументРеализации));
	
	Дата = Неопределено;
	Организация = Неопределено;
	ДокументРеализации = Неопределено;
	Если ЗначениеЗаполнено(ДокументРеализации) Тогда
		Документ = ДокументРеализации;
	ИначеЕсли ЗначениеЗаполнено(ПартияНоменклатуры) Тогда
		Документ = ДокументРеализации;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Документ) Тогда
		ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Документ, "Дата, Организация");
		Дата = ЗначенияРеквизитов.Дата;
		Организация = ЗначенияРеквизитов.Организация;
	КонецЕсли;
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("Организация", Организация);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Возврат Выборка.ТоварыРаботыУслугиСобственногоПроизводства;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

#КонецОбласти

#КонецЕсли
