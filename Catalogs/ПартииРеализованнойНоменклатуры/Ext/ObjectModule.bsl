#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий
Процедура ПередЗаписью(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Наименование = Справочники.ПартииРеализованнойНоменклатуры.НаименованиеПартииРеализованнойНоменклатуры(ЭтотОбъект);

КонецПроцедуры

Процедура ПриЗаписи(Отказ)

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПартииРеализованнойНоменклатуры.ПартияРеализованнойНоменклатуры КАК ПартияРеализованнойНоменклатуры
	|ИЗ
	|	РегистрСведений.ПартииРеализованнойНоменклатуры КАК ПартииРеализованнойНоменклатуры
	|ГДЕ
	|	ПартииРеализованнойНоменклатуры.ДокументРеализации = &ДокументРеализации
	|	И ПартииРеализованнойНоменклатуры.Номенклатура = &Номенклатура
	|	И ПартииРеализованнойНоменклатуры.ПартияНоменклатуры = &ПартияНоменклатуры
	|	И ПартииРеализованнойНоменклатуры.Контрагент = &Контрагент
	|	И ПартииРеализованнойНоменклатуры.Договор = &Договор
	|	И ПартииРеализованнойНоменклатуры.ПартияРеализованнойНоменклатуры <> &ПартияРеализованнойНоменклатуры";
	Запрос.УстановитьПараметр("ДокументРеализации", ДокументРеализации);
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("ПартияНоменклатуры", ПартияНоменклатуры);
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.УстановитьПараметр("Договор", Договор);
	Запрос.УстановитьПараметр("ПартияРеализованнойНоменклатуры", Ссылка);

	Блокировка = Новый БлокировкаДанных;
	
	ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.ПартииРеализованнойНоменклатуры");
	ЭлементБлокировки.УстановитьЗначение("ДокументРеализации", ДокументРеализации);
	ЭлементБлокировки.УстановитьЗначение("Номенклатура", Номенклатура);
	ЭлементБлокировки.УстановитьЗначение("ПартияНоменклатуры", ПартияНоменклатуры);
	ЭлементБлокировки.УстановитьЗначение("Контрагент", Контрагент);
	ЭлементБлокировки.УстановитьЗначение("Договор", Договор);
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	
	Блокировка.Заблокировать();
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Отказ = Истина;
		ВызватьИсключение НСтр("ru = 'Уже существует партия реализованной номенклатуры с указанными реквизитами';
								|en = 'Sold item lot with the specified attributes already exists'");
	Иначе	
		МенеджерЗаписи = РегистрыСведений.ПартииРеализованнойНоменклатуры.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.Заполнить(ЭтотОбъект);
		МенеджерЗаписи.ПартияРеализованнойНоменклатуры = Ссылка;
	КонецЕсли;
	Попытка
		МенеджерЗаписи.Записать();
	Исключение
		Отказ = Истина;
		ВызватьИсключение ОписаниеОшибки();  
	КонецПопытки;
	
КонецПроцедуры

Процедура ПередУдалением(Отказ)
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	УдалитьЗаписьРегистра();
КонецПроцедуры
#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область Прочее

Процедура УдалитьЗаписьРегистра()
	
	Запрос = Новый Запрос("
	|ВЫБРАТЬ
	|	*
	|ИЗ
	|	РегистрСведений.ПартииРеализованнойНоменклатуры КАК ДанныеРегистра
	|ГДЕ
	|	ДанныеРегистра.ПартияРеализованнойНоменклатуры = &ПартияРеализованнойНоменклатуры
	|");
	Запрос.УстановитьПараметр("ПартияРеализованнойНоменклатуры", Ссылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		МенеджерЗаписи = РегистрыСведений.ПартииРеализованнойНоменклатуры.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(МенеджерЗаписи, Выборка);
		МенеджерЗаписи.Удалить();
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#КонецЕсли
