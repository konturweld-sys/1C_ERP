			Для Каждого СтрокаПравило Из ПравилаПоСтатьеБюджетов Цикл
				ЗаполнитьЗначенияСвойств(СтруктураПоискаКоличестваСтатей, СтрокаПравило);
				КоличествоСтатей = КоличествоСтатейПоТипамИсточника.НайтиСтроки(СтруктураПоискаКоличестваСтатей)[0].КоличествоСтатей;
				ВидыПланов = Новый Массив;
				Если КоличествоСтатей > 1 Тогда
					ЗаполнитьЗначенияСвойств(СтруктураПоискаВидовПланов, СтрокаПравило);
					ВидыПланов = ТаблицаРезультат.Скопировать(СтруктураПоискаВидовПланов, "ВидПлана").ВыгрузитьКолонку("ВидПлана");
				КонецЕсли;
				Справочники.ПравилаРасчетаСвязанныхОстатковИОборотовБюджетов.СоздатьПравилоРасчетаПоТипуИсточника(
					СтрокаПравило.ТипИсточника, СтрокаПравило.СтатьяБюджетов, СтрокаПравило.ИсточникСуммы, ВидыПланов);
			КонецЦикла;
			
			СтрокаТаблицаПоЛимитам = ТаблицаРезультатПоЛимитам.Найти(ДанныеСтатьиБюджетов.Ссылка, "СтатьяБюджетов");
			Если СтрокаТаблицаПоЛимитам <> Неопределено Тогда
			
				Блокировка = Новый БлокировкаДанных;
				ЭлементБлокировки = Блокировка.Добавить(ПолноеИмяОбъекта);
				ЭлементБлокировки.УстановитьЗначение("Ссылка", ДанныеСтатьиБюджетов.Ссылка);
				ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
				Блокировка.Заблокировать();
			
				СтатьяБюджетовОбъект = ДанныеСтатьиБюджетов.Ссылка.ПолучитьОбъект();
				СтатьяБюджетовОбъект.ЛимитируемаяОперация = Перечисления.ЛимитируемыеОперации.ДвижениеДенежныхСредств;
				ОбновлениеИнформационнойБазы.ЗаписатьОбъект(СтатьяБюджетовОбъект);
				
			КонецЕсли;
			
			ОбновлениеИнформационнойБазы.ОтметитьВыполнениеОбработки(ДанныеСтатьиБюджетов.Ссылка);
			
			ЗафиксироватьТранзакцию();
			
		Исключение
			
			ОтменитьТранзакцию();
			ОбновлениеИнформационнойБазыУТ.СообщитьОНеудачнойОбработке(ИнформацияОбОшибке(), ДанныеСтатьиБюджетов.Ссылка);
			ОбновлениеИнформационнойБазы.ОтметитьВыполнениеОбработки(ДанныеСтатьиБюджетов.Ссылка);
			ОбновлениеИнформационнойБазы.ЗарегистрироватьПроблемуСДанными(ДанныеСтатьиБюджетов.Ссылка,
				ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			
		КонецПопытки;
		
	КонецЦикла;
	
	Параметры.ОбработкаЗавершена =
		ОбновлениеИнформационнойБазы.ОбработкаДанныхЗавершена(Параметры.Очередь, ПолноеИмяОбъекта);
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#КонецЕсли
