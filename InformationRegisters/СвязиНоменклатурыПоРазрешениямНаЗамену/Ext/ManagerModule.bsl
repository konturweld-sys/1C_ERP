#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

#Область ОбновлениеИнформационнойБазы

// Добавляет в список процедуры-обработчики обновления данных ИБ
// для всех поддерживаемых версий библиотеки или конфигурации.
// Вызывается перед началом обновления данных ИБ для построения плана обновления.
//
// Параметры:
//  Обработчики - см. ОбновлениеИнформационнойБазы.НоваяТаблицаОбработчиковОбновления
//
Процедура ПриДобавленииОбработчиковОбновления(Обработчики) Экспорт

	Обработчик = Обработчики.Добавить();
	Обработчик.Процедура = "РегистрыСведений.СвязиНоменклатурыПоРазрешениямНаЗамену.ОбработатьДанныеДляПереходаНаНовуюВерсию";
	Обработчик.Версия = "2.5.26.84";
	Обработчик.РежимВыполнения = "Отложенно";
	Обработчик.Идентификатор = Новый УникальныйИдентификатор("23dde64f-3131-4a6e-920b-a872353e5a0d");
	Обработчик.Многопоточный = Истина;
	Обработчик.ПроцедураЗаполненияДанныхОбновления = "РегистрыСведений.СвязиНоменклатурыПоРазрешениямНаЗамену.ЗарегистрироватьДанныеКОбработкеДляПереходаНаНовуюВерсию";
	Обработчик.ПроцедураПроверки = "ОбновлениеИнформационнойБазы.ДанныеОбновленыНаНовуюВерсиюПрограммы";
	Обработчик.Порядок = Перечисления.ПорядокОбработчиковОбновления.Обычный;
	Обработчик.Комментарий = НСтр("ru = 'Полный расчет связей материалов и аналогов в планировании.';
									|en = 'Complete calculation of links between materials and substitutes in planning.'");
	
	Обработчик.ПриоритетыВыполнения = ОбновлениеИнформационнойБазы.ПриоритетыВыполненияОбработчика();
	
	Приоритет = Обработчик.ПриоритетыВыполнения.Добавить();
	Приоритет.Процедура = "РегистрыСведений.АналогиМатериалов.ОбработатьДанныеДляПереходаНаНовуюВерсию";
	Приоритет.Порядок = "После";
	
	Читаемые = Новый Массив;
	Читаемые.Добавить(Метаданные.Документы.РазрешениеНаЗаменуМатериалов.ПолноеИмя());
	Читаемые.Добавить(Метаданные.РегистрыСведений.АналогиМатериалов.ПолноеИмя());
	Читаемые.Добавить(Метаданные.РегистрыСведений.СвязиНоменклатурыПоРазрешениямНаЗамену.ПолноеИмя());
	Обработчик.ЧитаемыеОбъекты = СтрСоединить(Читаемые, ",");
	
	Изменяемые = Новый Массив;
	Изменяемые.Добавить(Метаданные.РегистрыСведений.СвязиНоменклатурыПоРазрешениямНаЗамену.ПолноеИмя());
	Обработчик.ИзменяемыеОбъекты = СтрСоединить(Изменяемые, ",");
	
КонецПроцедуры

// Регистрация данных для обработки.
//
// Параметры:
// 	Параметры - см. ОбновлениеИнформационнойБазы.ОсновныеПараметрыОтметкиКОбработке
//
Процедура ЗарегистрироватьДанныеКОбработкеДляПереходаНаНовуюВерсию(Параметры) Экспорт
	
	ПолноеИмяРегистра = "РегистрСведений.СвязиНоменклатурыПоРазрешениямНаЗамену";
	
	ПараметрыВыборки = Параметры.ПараметрыВыборки;
	ПараметрыВыборки.ПолныеИменаРегистров = ПолноеИмяРегистра;
	ПараметрыВыборки.СпособВыборки = ОбновлениеИнформационнойБазы.СпособВыборкиИзмеренияНезависимогоРегистраСведений();
	
	ДополнительныеПараметры = ОбновлениеИнформационнойБазы.ДополнительныеПараметрыОтметкиОбработки();
	ДополнительныеПараметры.Вставить("ЭтоНезависимыйРегистрСведений", Истина);
	ДополнительныеПараметры.Вставить("ПолноеИмяРегистра",             ПолноеИмяРегистра);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ДанныеДокумента.Ссылка КАК Ссылка,
	|	ДанныеДокумента.Ссылка.ВариантЗамены КАК ВариантЗамены,
	|	ДанныеДокумента.Ссылка.ИспользоватьПриАвтозаменеВЗаказах КАК ИспользоватьПриАвтозаменеВЗаказах,
	|	СУММА(ДанныеДокумента.КоличествоМатериалов) КАК КоличествоМатериалов,
	|	СУММА(ДанныеДокумента.КоличествоАналогов) КАК КоличествоАналогов
	|ПОМЕСТИТЬ ДанныеРазрешенийНаЗамену
	|ИЗ
	|	(ВЫБРАТЬ
	|		РазрешениеНаЗаменуМатериаловМатериалы.Ссылка КАК Ссылка,
	|		СУММА(1) КАК КоличествоМатериалов,
	|		0 КАК КоличествоАналогов
	|	ИЗ
	|		Документ.РазрешениеНаЗаменуМатериалов.Материалы КАК РазрешениеНаЗаменуМатериаловМатериалы
	|	
	|	СГРУППИРОВАТЬ ПО
	|		РазрешениеНаЗаменуМатериаловМатериалы.Ссылка
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		РазрешениеНаЗаменуМатериаловАналоги.Ссылка,
	|		0,
	|		СУММА(1)
	|	ИЗ
	|		Документ.РазрешениеНаЗаменуМатериалов.Аналоги КАК РазрешениеНаЗаменуМатериаловАналоги
	|	
	|	СГРУППИРОВАТЬ ПО
	|		РазрешениеНаЗаменуМатериаловАналоги.Ссылка) КАК ДанныеДокумента
	|
	|СГРУППИРОВАТЬ ПО
	|	ДанныеДокумента.Ссылка,
	|	ДанныеДокумента.Ссылка.ВариантЗамены,
	|	ДанныеДокумента.Ссылка.ИспользоватьПриАвтозаменеВЗаказах
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДанныеРазрешенийНаЗамену.Ссылка КАК Ссылка,
	|	ДанныеРазрешенийНаЗамену.ИспользоватьПриАвтозаменеВЗаказах КАК ИспользоватьПриАвтозаменеВЗаказахВДокументе,
	|	ВЫБОР
	|		КОГДА ДанныеРазрешенийНаЗамену.ВариантЗамены = ЗНАЧЕНИЕ(Перечисление.ВариантЗаменыАналогов.СписокАналогов)
	|			ТОГДА ИСТИНА
	|		КОГДА ДанныеРазрешенийНаЗамену.ВариантЗамены = ЗНАЧЕНИЕ(Перечисление.ВариантЗаменыАналогов.НаборНаНабор)
	|			ТОГДА ДанныеРазрешенийНаЗамену.КоличествоМатериалов = 1
	|					И ДанныеРазрешенийНаЗамену.КоличествоАналогов = 1
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ИспользоватьПриАвтозаменеВЗаказахКУстановке
	|ПОМЕСТИТЬ ТаблицаПрименениеВЗаказах
	|ИЗ
	|	ДанныеРазрешенийНаЗамену КАК ДанныеРазрешенийНаЗамену
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка) КАК Номенклатура,
	|	ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка) КАК Характеристика
	|ИЗ
	|	РегистрСведений.АналогиМатериалов КАК Таблица
	|ГДЕ
	|	&ДинамическаяСтруктураЗаказовНаПроизводство
	|	И ИСТИНА В
	|				(ВЫБРАТЬ ПЕРВЫЕ 1
	|					ИСТИНА
	|				ИЗ
	|					ТаблицаПрименениеВЗаказах КАК ТаблицаПрименениеВЗаказах
	|				ГДЕ
	|					ТаблицаПрименениеВЗаказах.Ссылка = Таблица.Регистратор
	|					И ТаблицаПрименениеВЗаказах.ИспользоватьПриАвтозаменеВЗаказахКУстановке)
	|	И НЕ ИСТИНА В
	|				(ВЫБРАТЬ ПЕРВЫЕ 1
	|					ИСТИНА
	|				ИЗ
	|					РегистрСведений.СвязиНоменклатурыПоРазрешениямНаЗамену КАК ТаблицаСвязей
	|				ГДЕ
	|					ТаблицаСвязей.Номенклатура = Таблица.Номенклатура
	|					И ТаблицаСвязей.Характеристика = Таблица.Характеристика)
	|";
	
	Запрос.УстановитьПараметр(
		"ДинамическаяСтруктураЗаказовНаПроизводство",
		ПолучитьФункциональнуюОпцию("ДинамическаяСтруктураЗаказовНаПроизводство"));	
	
	Данные = Запрос.Выполнить().Выгрузить();
	
	ОбновлениеИнформационнойБазы.ОтметитьКОбработке(Параметры, Данные, ДополнительныеПараметры);
	
КонецПроцедуры

// Обработчик обновления.
// 
// Параметры:
//  Параметры - Структура - параметры обработчика:
//   * ВерсияПодсистемыНаНачалоОбновления - Строка - версия подсистемы.
//   * ИмяОбработчика - Строка - имя обработчика.
//   * ОбновляемыеДанные - Структура.
//   * ОбработкаЗавершена - Булево, Неопределено - признак завершения обработки.
//   * Очередь - Число - очередь.
//   * ПрогрессВыполнения - Структура:
//     ** ВсегоОбъектов - Число - всего обработано объектов.
//     ** ОбработаноОбъектов - Число - обработано объектов.
//
Процедура ОбработатьДанныеДляПереходаНаНовуюВерсию(Параметры) Экспорт
	
	ПолноеИмяРегистра = "РегистрСведений.СвязиНоменклатурыПоРазрешениямНаЗамену";
	
	Если Не ОбновлениеИнформационнойБазы.ОбработкаДанныхЗавершена(Неопределено, "РегистрСведений.АналогиМатериалов") Тогда
		Параметры.ОбработкаЗавершена = Ложь;
		Возврат;
	КонецЕсли;
	
	ОбновляемыеДанные = ОбновлениеИнформационнойБазы.ДанныеДляОбновленияВМногопоточномОбработчике(Параметры);
	Если ОбновляемыеДанные.Количество() = 0 Тогда
		Параметры.ОбработкаЗавершена = Истина;
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры = ОбновлениеИнформационнойБазы.ДополнительныеПараметрыОтметкиОбработки();
	ДополнительныеПараметры.ЭтоНезависимыйРегистрСведений = Истина;
	ДополнительныеПараметры.ПолноеИмяРегистра             = ПолноеИмяРегистра;
	
	НачатьТранзакцию();
	
	Попытка
		
		РегистрыСведений.СвязиНоменклатурыПоРазрешениямНаЗамену.ЗапуститьПолныйРасчет();
		
		ОбновлениеИнформационнойБазы.ОтметитьВыполнениеОбработки(ОбновляемыеДанные, ДополнительныеПараметры);
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		
		ОтменитьТранзакцию();
		
		ШаблонОшибки = НСтр("ru = 'Не удалось выполнить полный расчет связей материалов и аналогов в планировании:
								   |
								   |%1';
								   |en = 'Cannot perform a complete calculation of links between materials and substitutes in planning:
								   |
								   |%1'");
		
		ТекстОшибки = СтрШаблон(ШаблонОшибки, ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			
		ЗаписьЖурналаРегистрации(
			ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
			УровеньЖурналаРегистрации.Предупреждение,
			Метаданные.РегистрыСведений.СвязиНоменклатурыПоРазрешениямНаЗамену,,
			ТекстОшибки);
		
	КонецПопытки;
	
	Параметры.ОбработкаЗавершена = Не ОбновлениеИнформационнойБазы.ЕстьДанныеДляОбработки(
										Параметры.Очередь,
										ПолноеИмяРегистра);
	
КонецПроцедуры

#КонецОбласти

// Запускает полный расчет связей материалов и аналогов в планировании.
//
Процедура ЗапуститьПолныйРасчет() Экспорт
	
	Если Не ПолучитьФункциональнуюОпцию("ДинамическаяСтруктураЗаказовНаПроизводство") Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Таблица.Регистратор     КАК Разрешение,
	|	Таблица.ПриоритетЗамены КАК ПриоритетЗамены,
	|	Таблица.Номенклатура    КАК Номенклатура,
	|	Таблица.Характеристика  КАК Характеристика
	|ПОМЕСТИТЬ ТаблицаНовыхЗаписей
	|ИЗ
	|	РегистрСведений.АналогиМатериалов КАК Таблица
	|ГДЕ
	|	Таблица.РольНоменклатуры В (
	|					ЗНАЧЕНИЕ(Перечисление.РолиАналогов.Материал),
	|					ЗНАЧЕНИЕ(Перечисление.РолиАналогов.ВзаимозаменяемыйАналог))
	|	И Таблица.ИспользоватьПриАвтозаменеВЗаказах
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Таблица.Регистратор     КАК Разрешение,
	|	Таблица.ПриоритетЗамены КАК ПриоритетЗамены,
	|	Таблица.Номенклатура    КАК Номенклатура,
	|	Таблица.Характеристика  КАК Характеристика
	|ИЗ
	|	РегистрСведений.АналогиМатериалов КАК Таблица
	|ГДЕ
	|	Таблица.РольНоменклатуры = ЗНАЧЕНИЕ(Перечисление.РолиАналогов.Аналог)
	|	И Таблица.ИспользоватьПриАвтозаменеВЗаказах
	|	И НЕ ИСТИНА В
	|			(ВЫБРАТЬ ПЕРВЫЕ 1
	|				ИСТИНА
	|			ИЗ
	|				РегистрСведений.АналогиМатериалов КАК ТаблицаМатериалов
	|			ГДЕ
	|				ТаблицаМатериалов.Регистратор        = Таблица.Регистратор
	|				И ТаблицаМатериалов.Номенклатура     = Таблица.Номенклатура
	|				И ТаблицаМатериалов.Характеристика   = Таблица.Характеристика
	|				И ТаблицаМатериалов.РольНоменклатуры = ЗНАЧЕНИЕ(Перечисление.РолиАналогов.Материал))
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Номенклатура,
	|	Характеристика
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(Документ.РазрешениеНаЗаменуМатериалов.ПустаяСсылка) КАК Разрешение,
	|	ЗНАЧЕНИЕ(Перечисление.ПравилаЗаменыНаАналоги.ПустаяСсылка)   КАК ПриоритетЗамены,
	|	ТаблицаСтарыхЗаписей.Номенклатура                            КАК Номенклатура,
	|	ТаблицаСтарыхЗаписей.Характеристика                          КАК Характеристика,
	|	ИСТИНА                                                       КАК СтараяЗапись
	|ИЗ
	|	РегистрСведений.СвязиНоменклатурыПоРазрешениямНаЗамену КАК ТаблицаСтарыхЗаписей
	|ГДЕ
	|	НЕ ИСТИНА В
	|			(ВЫБРАТЬ ПЕРВЫЕ 1
	|				ИСТИНА
	|			ИЗ
	|				ТаблицаНовыхЗаписей КАК ТаблицаНовыхЗаписей
	|			ГДЕ
	|				ТаблицаНовыхЗаписей.Номенклатура    = ТаблицаСтарыхЗаписей.Номенклатура
	|				И ТаблицаНовыхЗаписей.Характеристика = ТаблицаСтарыхЗаписей.Характеристика)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ТаблицаНовыхЗаписей.Разрешение       КАК Разрешение,
	|	ТаблицаНовыхЗаписей.ПриоритетЗамены  КАК ПриоритетЗамены,
	|	ТаблицаНовыхЗаписей.Номенклатура   КАК Номенклатура,
	|	ТаблицаНовыхЗаписей.Характеристика КАК Характеристика,
	|	ЛОЖЬ                               КАК СтараяЗапись
	|ИЗ
	|	ТаблицаНовыхЗаписей КАК ТаблицаНовыхЗаписей
	|
	|УПОРЯДОЧИТЬ ПО
	|	Разрешение
	|ИТОГИ ПО
	|	Разрешение
	|";
	
	Результат = Запрос.Выполнить();
	
	Очередь        = "ЗаданияКРасчетуСвязейНоменклатурыПоРазрешениямНаЗамену";
	ТаблицаЗаданий = ОтложенныеЗадания.ИнициализироватьТаблицуЗаданий(Очередь);
	ТаблицаЗаписей = ТаблицаЗаданий[0].Задания.СкопироватьКолонки();
	
	ВыборкаДокумента = Результат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаДокумента.Следующий() Цикл
		
		ТаблицаЗаписей.Очистить();
		
		ОтметкаВремени = ТекущаяУниверсальнаяДатаВМиллисекундах();
		
		Выборка = ВыборкаДокумента.Выбрать();
		Пока Выборка.Следующий() Цикл
			
			СтрокаТаблицы = ТаблицаЗаписей.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаТаблицы, Выборка);
			СтрокаТаблицы.ОтметкаВремени = ОтметкаВремени;
			
		КонецЦикла;
		
		ОтложенныеЗадания.ДобавитьЗаданияВОчередь(Очередь, ТаблицаЗаписей,, ТаблицаЗаданий);
		
	КонецЦикла;
	
	Если ТаблицаЗаданий[0].Задания.Количество() > 0 Тогда
		ОтложенныеЗадания.Запустить(ТаблицаЗаданий);
	КонецЕсли;
	
КонецПроцедуры

// Запускает полный расчет связей материалов и аналогов в планировании в фоне.
//
Процедура ЗапуститьПолныйРасчетВФоне() Экспорт
	
	Параметры = ДлительныеОперации.ПараметрыВыполненияПроцедуры();
	Параметры.НаименованиеФоновогоЗадания = НСтр("ru = 'Полный расчет связей материалов и аналогов в планировании';
												|en = 'Complete calculation of links between materials and substitutes in planning'");
	Параметры.ЗапуститьВФоне              = Истина;
	Параметры.ОжидатьЗавершение           = 0;
	
	ДлительныеОперации.ВыполнитьПроцедуру(
		Параметры,
		"РегистрыСведений.СвязиНоменклатурыПоРазрешениямНаЗамену.ЗапуститьПолныйРасчет");
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Рассчитывает связи материалов и аналогов в планировании.
//
// Параметры:
//  Задания - ТаблицаЗначений - колонки соответствуют измерениям, ресурсам и реквизитам регистра сведений
//                              "ЗаданияКРасчетуСвязейНоменклатурыПоРазрешениямНаЗамену", есть и служебные колонки:
//             * Разрешение             - ДокументСсылка.РазрешениеНаЗаменуМатериалов -
//             * Номенклатура         - СправочникСсылка.Номенклатура -
//             * Характеристика       - СправочникСсылка.ХарактеристикиНоменклатуры -
//             * ОтметкаВремени       - Число -
//             * СтараяЗапись         - Булево -
//             * ИдентификаторЗаписи  - УникальныйИдентификатор -
//             * ДатаЗаписи           - Дата   -
//             * ИдентификаторЗадания - УникальныйИдентификатор - служебная
//             * ДатаЗадания          - Дата                    - служебная
//  ИдентификаторыНеОбработанныхЗаписей - Соответствие из УникальныйИдентификатор - ключ, это идентификатор 
//                                                                                   не выполненных (выдающих ошибку при
//                                                                                   выполнении) записей регистра
//                                                                                   сведений очереди заданий
//                                                                                   (измерение ИдентификаторЗаписи
//                                                                                   регистра сведений очереди заданий),
//                                                                                  значение, это представление ошибки.
//  ДополнительныеСвойства - Неопределено, Структура - дополнительные свойства выполнения заданий.
//
Процедура РассчитатьСвязиМатериаловИАналоговВПланировании(
			Задания,
			ИдентификаторыНеОбработанныхЗаписей,
			ДополнительныеСвойства = Неопределено) Экспорт
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	Задания.Разрешение        КАК Разрешение,
	|	Задания.Номенклатура      КАК Номенклатура,
	|	Задания.Характеристика    КАК Характеристика,
	|	Задания.ОтметкаВремени    КАК ОтметкаВремени,
	|	Задания.СтараяЗапись      КАК СтараяЗапись
	|ПОМЕСТИТЬ Задания
	|ИЗ
	|	&Задания КАК Задания
	|
	|ИНДЕКСИРОВАТЬ ПО
	|
	|Разрешение,
	|СтараяЗапись
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Задания.Разрешение КАК Разрешение,
	|	ВЫБОР
	|		КОГДА МИНИМУМ(ВЫБОР
	|						КОГДА Задания.СтараяЗапись
	|							ТОГДА Задания.ОтметкаВремени
	|						ИНАЧЕ 99999999999999
	|					КОНЕЦ) > МИНИМУМ(Задания.ОтметкаВремени)
	|			ТОГДА -1
	|		ИНАЧЕ МИНИМУМ(ВЫБОР
	|						КОГДА Задания.СтараяЗапись
	|							ТОГДА Задания.ОтметкаВремени
	|						ИНАЧЕ 99999999999999
	|					КОНЕЦ)
	|	КОНЕЦ КАК ОтметкаВремениСтарыхЗаписей,
	|	ВЫБОР
	|		КОГДА МАКСИМУМ(ВЫБОР
	|							КОГДА Задания.СтараяЗапись
	|								ТОГДА 0
	|							ИНАЧЕ Задания.ОтметкаВремени
	|					КОНЕЦ) < МАКСИМУМ(Задания.ОтметкаВремени)
	|			ТОГДА -1
	|		ИНАЧЕ МАКСИМУМ(ВЫБОР
	|							КОГДА Задания.СтараяЗапись
	|								ТОГДА 0
	|							ИНАЧЕ Задания.ОтметкаВремени
	|					КОНЕЦ)
	|	КОНЕЦ КАК ОтметкаВремениНовыхЗаписей
	|ПОМЕСТИТЬ ТаблицаОтметокВремени
	|ИЗ
	|	Задания КАК Задания
	|СГРУППИРОВАТЬ ПО
	|	Задания.Разрешение
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Разрешение
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Таблица.Разрешение КАК Разрешение,
	|	МИНИМУМ(ВЫБОР
	|				КОГДА Таблица.СтараяЗапись
	|					ТОГДА Таблица.ОтметкаВремени
	|				ИНАЧЕ 99999999999999
	|			КОНЕЦ) КАК ОтметкаВремениСтарыхЗаписей
	|ПОМЕСТИТЬ ТаблицаОтметокВремениДругихЗаданий
	|ИЗ
	|	РегистрСведений.ЗаданияКРасчетуСвязейНоменклатурыПоРазрешениямНаЗамену КАК Таблица
	|ГДЕ
	|	ИСТИНА В
	|		(ВЫБРАТЬ ПЕРВЫЕ 1
	|			ИСТИНА
	|		ИЗ
	|			Задания КАК Задания
	|		ГДЕ
	|			Задания.Номенклатура     = Таблица.Номенклатура
	|			И Задания.Характеристика = Таблица.Характеристика)
	|	И НЕ ИСТИНА В
	|			(ВЫБРАТЬ ПЕРВЫЕ 1
	|				ИСТИНА
	|			ИЗ
	|				Задания КАК Задания
	|			ГДЕ
	|				Задания.Разрешение = Таблица.Разрешение)
	|СГРУППИРОВАТЬ ПО
	|	Таблица.Разрешение
	|
	|ИМЕЮЩИЕ
	|	МИНИМУМ(ВЫБОР
	|				КОГДА Таблица.СтараяЗапись
	|					ТОГДА Таблица.ОтметкаВремени
	|				ИНАЧЕ 99999999999999
	|			КОНЕЦ) <= МИНИМУМ(Таблица.ОтметкаВремени)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Разрешение,
	|	ОтметкаВремениСтарыхЗаписей
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Задания.Разрешение       КАК Разрешение,
	|	Задания.Номенклатура   КАК Номенклатура,
	|	Задания.Характеристика КАК Характеристика,
	|	Задания.ОтметкаВремени КАК ОтметкаВремени,
	|	Задания.СтараяЗапись   КАК СтараяЗапись
	|ПОМЕСТИТЬ ТаблицаЗаписей
	|ИЗ
	|	ТаблицаОтметокВремени КАК ТаблицаОтметокВремени
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Задания КАК Задания
	|		ПО ТаблицаОтметокВремени.Разрешение                    = Задания.Разрешение
	|		И ТаблицаОтметокВремени.ОтметкаВремениСтарыхЗаписей = Задания.ОтметкаВремени
	|		И Задания.СтараяЗапись
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Задания.Разрешение       КАК Разрешение,
	|	Задания.Номенклатура   КАК Номенклатура,
	|	Задания.Характеристика КАК Характеристика,
	|	Задания.ОтметкаВремени КАК ОтметкаВремени,
	|	Задания.СтараяЗапись   КАК СтараяЗапись
	|ИЗ
	|	ТаблицаОтметокВремени КАК ТаблицаОтметокВремени
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Задания КАК Задания
	|		ПО ТаблицаОтметокВремени.Разрешение                   = Задания.Разрешение
	|		И ТаблицаОтметокВремени.ОтметкаВремениНовыхЗаписей = Задания.ОтметкаВремени
	|		И НЕ Задания.СтараяЗапись
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Номенклатура,
	|	Характеристика
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаГрупп.Номенклатура   КАК Номенклатура,
	|	ТаблицаГрупп.Характеристика КАК Характеристика,
	|	ТаблицаГрупп.Идентификатор  КАК Идентификатор
	|ПОМЕСТИТЬ ТаблицаСуществующихГрупп
	|ИЗ
	|	РегистрСведений.СвязиНоменклатурыПоРазрешениямНаЗамену КАК ТаблицаГрупп
	|ГДЕ
	|	ИСТИНА В
	|		(ВЫБРАТЬ ПЕРВЫЕ 1
	|			ИСТИНА
	|		ИЗ
	|			РегистрСведений.СвязиНоменклатурыПоРазрешениямНаЗамену КАК Таблица
	|		ГДЕ
	|			Таблица.Идентификатор = ТаблицаГрупп.Идентификатор
	|			И ИСТИНА В
	|				(ВЫБРАТЬ ПЕРВЫЕ 1
	|					ИСТИНА
	|				ИЗ
	|					ТаблицаЗаписей КАК ТаблицаЗаписей
	|				ГДЕ
	|					ТаблицаЗаписей.Номенклатура     = Таблица.Номенклатура
	|					И ТаблицаЗаписей.Характеристика = Таблица.Характеристика))
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Номенклатура,
	|	Характеристика
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Таблица.Разрешение       КАК Разрешение,
	|	Таблица.Номенклатура   КАК Номенклатура,
	|	Таблица.Характеристика КАК Характеристика
	|ИЗ
	|	ТаблицаЗаписей КАК Таблица
	|ГДЕ
	|	НЕ Таблица.СтараяЗапись
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Таблица.Разрешение       КАК Разрешение,
	|	Таблица.Номенклатура   КАК Номенклатура,
	|	Таблица.Характеристика КАК Характеристика
	|ИЗ
	|	ТаблицаОтметокВремениДругихЗаданий КАК ТаблицаОтметокВремениДругихЗаданий
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЗаданияКРасчетуСвязейНоменклатурыПоРазрешениямНаЗамену КАК Таблица
	|		ПО ТаблицаОтметокВремениДругихЗаданий.Разрешение                    = Таблица.Разрешение
	|		И ТаблицаОтметокВремениДругихЗаданий.ОтметкаВремениСтарыхЗаписей = Таблица.ОтметкаВремени
	|		И Таблица.СтараяЗапись
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Таблица.Регистратор    КАК Разрешение,
	|	Таблица.Номенклатура   КАК Номенклатура,
	|	Таблица.Характеристика КАК Характеристика
	|ИЗ
	|	РегистрСведений.АналогиМатериалов КАК Таблица
	|ГДЕ
	|	Таблица.ПриоритетЗамены В (
	|					ЗНАЧЕНИЕ(Перечисление.ПравилаЗаменыНаАналоги.ПриОтсутствииМатериала),
	|					ЗНАЧЕНИЕ(Перечисление.ПравилаЗаменыНаАналоги.ПриНаличииАналога))
	|	И Таблица.ИспользоватьПриАвтозаменеВЗаказах
	|	И ИСТИНА В
	|			(ВЫБРАТЬ ПЕРВЫЕ 1
	|				ИСТИНА
	|			ИЗ
	|				РегистрСведений.АналогиМатериалов КАК АналогиМатериалов
	|			ГДЕ
	|				АналогиМатериалов.Регистратор = Таблица.Регистратор
	|				И НЕ ИСТИНА В
	|						(ВЫБРАТЬ ПЕРВЫЕ 1
	|							ИСТИНА
	|						ИЗ
	|							ТаблицаЗаписей КАК ТаблицаЗаписей
	|						ГДЕ
	|							ТаблицаЗаписей.Разрешение = АналогиМатериалов.Регистратор)
	|				И НЕ ИСТИНА В
	|						(ВЫБРАТЬ ПЕРВЫЕ 1
	|							ИСТИНА
	|						ИЗ
	|							РегистрСведений.ЗаданияКРасчетуСвязейНоменклатурыПоРазрешениямНаЗамену КАК Задания
	|						ГДЕ
	|							Задания.Разрешение = АналогиМатериалов.Регистратор)
	|				И (ИСТИНА В
	|						(ВЫБРАТЬ ПЕРВЫЕ 1
	|							ИСТИНА
	|						ИЗ
	|							ТаблицаЗаписей КАК ТаблицаЗаписей
	|						ГДЕ
	|							ТаблицаЗаписей.Номенклатура     = АналогиМатериалов.Номенклатура
	|							И ТаблицаЗаписей.Характеристика = АналогиМатериалов.Характеристика)
	|					ИЛИ ИСТИНА В
	|							(ВЫБРАТЬ ПЕРВЫЕ 1
	|								ИСТИНА
	|							ИЗ
	|								ТаблицаСуществующихГрупп КАК ТаблицаСуществующихГрупп
	|							ГДЕ
	|								ТаблицаСуществующихГрупп.Номенклатура     = АналогиМатериалов.Номенклатура
	|								И ТаблицаСуществующихГрупп.Характеристика = АналогиМатериалов.Характеристика)))
	|
	|УПОРЯДОЧИТЬ ПО
	|	Разрешение
	|";
	
	УстановитьПривилегированныйРежим(Истина);
	
	Попытка
		
		Запрос = Новый Запрос;
		Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
		
		Запрос.Текст = ТекстЗапроса;
		
		Запрос.УстановитьПараметр("Задания", Задания);
		
		Результат = Запрос.Выполнить();
		
		ВременныеТаблицы = Запрос.МенеджерВременныхТаблиц.Таблицы;
		
		ТаблицаЗаписей = Результат.Выгрузить();
		
		ТаблицаСуществующихГрупп = ВременныеТаблицы["ТаблицаСуществующихГрупп"].ПолучитьДанные().Выгрузить();
		ТаблицаСуществующихГрупп.Индексы.Добавить("Номенклатура, Характеристика, Идентификатор");
		ТаблицаСуществующихГрупп.Индексы.Добавить("Номенклатура, Характеристика");
		ТаблицаСуществующихГрупп.Индексы.Добавить("Идентификатор");
		
		ТаблицаБуфер = Новый ТаблицаЗначений;
		ТаблицаБуфер.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
		ТаблицаБуфер.Колонки.Добавить("Характеристика", Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
		ТаблицаБуфер.Колонки.Добавить("Склад", Новый ОписаниеТипов("СправочникСсылка.Склады"));
		ТаблицаБуфер.Колонки.Добавить("Назначение", Новый ОписаниеТипов("СправочникСсылка.Назначения"));
		
		ТаблицаГрупп = ТаблицаСуществующихГрупп.СкопироватьКолонки();
		ТаблицаГрупп.Индексы.Добавить("Номенклатура, Характеристика");
		ТаблицаГрупп.Индексы.Добавить("Идентификатор");
		
		ОтборНоменклатураИдентификатор = Новый Структура("Номенклатура, Характеристика, Идентификатор");
		ОтборНоменклатура              = Новый Структура("Номенклатура, Характеристика");
		ОтборИдентификатор             = Новый Структура("Идентификатор");
		
		ТекущийДокумент            = Неопределено;
		ТекущийИдентификаторГруппы = Неопределено;
		
		ИдентификаторыСвязанныхГрупп = Новый Массив;
		
		Для каждого СтрокаТаблицыЗаписей Из ТаблицаЗаписей Цикл
			
			Если ТекущийДокумент <> СтрокаТаблицыЗаписей.Разрешение Тогда
				
				Если ИдентификаторыСвязанныхГрупп.Количество() > 1 Тогда
					
					ВГраница = ИдентификаторыСвязанныхГрупп.ВГраница();
					
					ИдентификаторГруппы = ИдентификаторыСвязанныхГрупп[ВГраница];
					
					Индекс = 0;
					Пока Индекс < ВГраница Цикл
						
						ОтборИдентификатор.Идентификатор = ИдентификаторыСвязанныхГрупп[Индекс];
						
						НайденныеСтрокиГрупп = ТаблицаГрупп.НайтиСтроки(ОтборИдентификатор);
						Для каждого СтрокаТаблицыГрупп Из НайденныеСтрокиГрупп Цикл
							СтрокаТаблицыГрупп.Идентификатор = ИдентификаторГруппы;
						КонецЦикла;
						
						Индекс = Индекс + 1;
						
					КонецЦикла;
					
				КонецЕсли;
				
				ИдентификаторыСвязанныхГрупп.Очистить();
				
				ТекущийДокумент            = СтрокаТаблицыЗаписей.Разрешение;
				ТекущийИдентификаторГруппы = Новый УникальныйИдентификатор;
				
			КонецЕсли;
			
			ЗаполнитьЗначенияСвойств(ОтборНоменклатура, СтрокаТаблицыЗаписей);
			
			НайденныеСтрокиТаблицыГрупп = ТаблицаГрупп.НайтиСтроки(ОтборНоменклатура);
			Если НайденныеСтрокиТаблицыГрупп.Количество() = 0 Тогда
				
				СтрокаТаблицыГрупп = ТаблицаГрупп.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаТаблицыГрупп, ОтборНоменклатура);
				СтрокаТаблицыГрупп.Идентификатор = ТекущийИдентификаторГруппы;
				
			Иначе
				ТекущийИдентификаторГруппы = НайденныеСтрокиТаблицыГрупп[0].Идентификатор;
			КонецЕсли;
			
			Если ИдентификаторыСвязанныхГрупп.Найти(ТекущийИдентификаторГруппы) = Неопределено Тогда
				ИдентификаторыСвязанныхГрупп.Добавить(ТекущийИдентификаторГруппы);
			КонецЕсли;
			
		КонецЦикла;
		
		Если ИдентификаторыСвязанныхГрупп.Количество() > 1 Тогда
			
			ВГраница = ИдентификаторыСвязанныхГрупп.ВГраница();
			
			ИдентификаторГруппы = ИдентификаторыСвязанныхГрупп[ВГраница];
			
			Индекс = 0;
			Пока Индекс < ВГраница Цикл
				
				ОтборИдентификатор.Идентификатор = ИдентификаторыСвязанныхГрупп[Индекс];
				
				НайденныеСтрокиГрупп = ТаблицаГрупп.НайтиСтроки(ОтборИдентификатор);
				Для каждого СтрокаТаблицыГрупп Из НайденныеСтрокиГрупп Цикл
					СтрокаТаблицыГрупп.Идентификатор = ИдентификаторГруппы;
				КонецЦикла;
				
				Индекс = Индекс + 1;
				
			КонецЦикла;
			
		КонецЕсли;
		
		Если ТаблицаГрупп.Количество() > 0 И ТаблицаСуществующихГрупп.Количество() > 0 Тогда
			
			ИдентификаторыГрупп = ОбщегоНазначенияКлиентСервер.СвернутьМассив(
									ТаблицаГрупп.ВыгрузитьКолонку("Идентификатор"));
			
			ИдентификаторыСуществующихГрупп = ТаблицаСуществующихГрупп.Скопировать(, "Идентификатор");
			ИдентификаторыСуществующихГрупп.Свернуть("Идентификатор");
			ИдентификаторыСуществующихГрупп.Колонки.Добавить("КоличествоСтрок", ОбщегоНазначения.ОписаниеТипаЧисло(10));
			ИдентификаторыСуществующихГрупп.Индексы.Добавить("Идентификатор");
			
			Для каждого ИдентификаторГруппы Из ИдентификаторыГрупп Цикл
				
				ОтборИдентификатор.Идентификатор = ИдентификаторГруппы;
				
				НайденныеСтрокиТаблицыГрупп = ТаблицаГрупп.НайтиСтроки(ОтборИдентификатор);
				КоличествоСтрокНовойГруппы  = НайденныеСтрокиТаблицыГрупп.Количество();
				
				Для каждого ИдентификаторСуществующейГруппы Из ИдентификаторыСуществующихГрупп Цикл
					
					ОтборНоменклатураИдентификатор.Идентификатор = ИдентификаторСуществующейГруппы.Идентификатор;
					
					КоличествоСтрок = ИдентификаторСуществующейГруппы.КоличествоСтрок;
					
					Если Не ЗначениеЗаполнено(КоличествоСтрок) Тогда
						
						ОтборИдентификатор.Идентификатор = ИдентификаторСуществующейГруппы.Идентификатор;
						
						ИдентификаторСуществующейГруппы.КоличествоСтрок =
							ТаблицаСуществующихГрупп.НайтиСтроки(ОтборИдентификатор).Количество();
							
						КоличествоСтрок = ИдентификаторСуществующейГруппы.КоличествоСтрок;
						
					КонецЕсли;
					
					Если КоличествоСтрок <> КоличествоСтрокНовойГруппы Тогда
						Продолжить;
					КонецЕсли;
					
					КоличествоСовпадений = 0;
					
					Для каждого СтрокаТаблицыГрупп Из НайденныеСтрокиТаблицыГрупп Цикл
						
						ЗаполнитьЗначенияСвойств(ОтборНоменклатураИдентификатор, СтрокаТаблицыГрупп,, "Идентификатор");
						
						Если ТаблицаСуществующихГрупп.НайтиСтроки(ОтборНоменклатураИдентификатор).Количество() = 0 Тогда
							Прервать;
						КонецЕсли;
						
						КоличествоСовпадений = КоличествоСовпадений + 1;
						
					КонецЦикла;
					
					Если КоличествоСтрок <> КоличествоСовпадений Тогда
						Продолжить;
					КонецЕсли;
					
					Для каждого СтрокаТаблицыГрупп Из НайденныеСтрокиТаблицыГрупп Цикл
						ТаблицаГрупп.Удалить(СтрокаТаблицыГрупп);
					КонецЦикла;
					
					ЗаполнитьЗначенияСвойств(ОтборИдентификатор, ОтборНоменклатураИдентификатор);
					
					НайденныеСтрокиТаблицыСуществующихГрупп = ТаблицаСуществующихГрупп.НайтиСтроки(ОтборИдентификатор);
					Для каждого СтрокаТаблицыСуществующихГрупп Из НайденныеСтрокиТаблицыСуществующихГрупп Цикл
						ТаблицаСуществующихГрупп.Удалить(СтрокаТаблицыСуществующихГрупп);
					КонецЦикла;
					
					ИдентификаторыСуществующихГрупп.Удалить(ИдентификаторСуществующейГруппы);
					
					Прервать;
					
				КонецЦикла;
				
				Если ИдентификаторыСуществующихГрупп.Количество() = 0 Тогда
					Прервать;
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;
		
		ПустойСклад = Справочники.Склады.ПустаяСсылка();
		ПустоеНазначение = Справочники.Назначения.ПустаяСсылка();
		МассивОбработанныхГрупп = Новый Массив;
		
		Для каждого СтрокаТаблицыСуществующихГрупп Из ТаблицаСуществующихГрупп Цикл
			
			ЗаполнитьЗначенияСвойств(ОтборНоменклатура, СтрокаТаблицыСуществующихГрупп);
			
			НайденныеСтрокиТаблицыГрупп = ТаблицаГрупп.НайтиСтроки(ОтборНоменклатура);
			Если НайденныеСтрокиТаблицыГрупп.Количество() = 0 Тогда
				СтрокиТаблицыГрупп = Неопределено;
				Идентификатор      = Неопределено;
			Иначе
				СтрокиТаблицыГрупп = НайденныеСтрокиТаблицыГрупп[0];
				Идентификатор      = СтрокиТаблицыГрупп.Идентификатор;
			КонецЕсли;
			
			НаборЗаписей = РегистрыСведений.СвязиНоменклатурыПоРазрешениямНаЗамену.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.Номенклатура.Установить(СтрокаТаблицыСуществующихГрупп.Номенклатура);
			НаборЗаписей.Отбор.Характеристика.Установить(СтрокаТаблицыСуществующихГрупп.Характеристика);
			
			Если ЗначениеЗаполнено(Идентификатор) Тогда
				
				ЗаписьНабора = НаборЗаписей.Добавить();
				ЗаполнитьЗначенияСвойств(ЗаписьНабора, СтрокаТаблицыСуществующихГрупп,, "Идентификатор");
				ЗаписьНабора.Идентификатор = Идентификатор;
				
				ТаблицаГрупп.Удалить(СтрокиТаблицыГрупп);
				
				Если МассивОбработанныхГрупп.Найти(Идентификатор) = Неопределено Тогда
					
					СтрокаБуфер = ТаблицаБуфер.Добавить();
					СтрокаБуфер.Номенклатура = СтрокаТаблицыСуществующихГрупп.Номенклатура;
					СтрокаБуфер.Характеристика = СтрокаТаблицыСуществующихГрупп.Характеристика;
					СтрокаБуфер.Склад = ПустойСклад;
					СтрокаБуфер.Назначение = ПустоеНазначение;
					
					МассивОбработанныхГрупп.Добавить(Идентификатор);
				
				КонецЕсли;
				
			Иначе
				
				СтрокаБуфер = ТаблицаБуфер.Добавить();
				СтрокаБуфер.Номенклатура = СтрокаТаблицыСуществующихГрупп.Номенклатура;
				СтрокаБуфер.Характеристика = СтрокаТаблицыСуществующихГрупп.Характеристика;
				СтрокаБуфер.Склад = ПустойСклад;
				СтрокаБуфер.Назначение = ПустоеНазначение;
				
			КонецЕсли;
			
			НаборЗаписей.Записать();
			
		КонецЦикла;
		
		Для каждого СтрокиТаблицыГрупп Из ТаблицаГрупп Цикл
			
			НаборЗаписей = РегистрыСведений.СвязиНоменклатурыПоРазрешениямНаЗамену.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.Номенклатура.Установить(СтрокиТаблицыГрупп.Номенклатура);
			НаборЗаписей.Отбор.Характеристика.Установить(СтрокиТаблицыГрупп.Характеристика);
			
			ЗаписьНабора = НаборЗаписей.Добавить();
			ЗаполнитьЗначенияСвойств(ЗаписьНабора, СтрокиТаблицыГрупп);
			
			НаборЗаписей.Записать();
			
			Если МассивОбработанныхГрупп.Найти(Идентификатор) = Неопределено Тогда
				
				СтрокаБуфер = ТаблицаБуфер.Добавить();
				СтрокаБуфер.Номенклатура = СтрокиТаблицыГрупп.Номенклатура;
				СтрокаБуфер.Характеристика = СтрокиТаблицыГрупп.Характеристика;
				СтрокаБуфер.Склад = ПустойСклад;
				СтрокаБуфер.Назначение = ПустоеНазначение;
				МассивОбработанныхГрупп.Добавить(Идентификатор);
			
			КонецЕсли;
			
		КонецЦикла;
		
		Если ТаблицаБуфер.Количество() > 0 Тогда
		
			РегистрыСведений.ЗаданияКРасчетуСтруктурыЗаказаРаспределениеЗапасов.ДобавитьЗадания(ТаблицаБуфер);
		
		КонецЕсли;
		
	Исключение
		
		ТекстИсключения = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		
		ЗаписьЖурналаРегистрации(
			ОтложенныеЗадания.ИмяСобытия(),
			УровеньЖурналаРегистрации.Ошибка,
			Метаданные.РегистрыСведений.СвязиНоменклатурыПоРазрешениямНаЗамену,,
			ТекстИсключения);
		
		ПоляОшибки = Новый Структура;
		ПоляОшибки.Вставить("Разрешение");
		ПоляОшибки.Вставить("Номенклатура");
		ПоляОшибки.Вставить("Характеристика");
		ПоляОшибки.Вставить("ОтметкаВремени");
		ПоляОшибки.Вставить("СтараяЗапись");
		
		Для каждого СтрокаТаблицы Из Задания Цикл
			
			ИдентификаторыНеОбработанныхЗаписей.Вставить(
				СтрокаТаблицы.ИдентификаторЗаписи,
				ОтложенныеЗадания.ТекстОшибкиВыполнения(ПоляОшибки, СтрокаТаблицы, ТекстИсключения));
			
		КонецЦикла;
		
	КонецПопытки;
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли