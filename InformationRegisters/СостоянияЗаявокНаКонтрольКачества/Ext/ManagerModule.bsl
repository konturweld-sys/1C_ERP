#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Отражает изменения состояний заказов в регистре.
//
// Параметры:
//  Заявка - ДокументСсылка.ЗаявкаНаКонтрольКачестваТоваров
//  Ошибки - Неопределено, Соответствие из КлючИЗначение - со структурой:
//                          *Ключ     - ДокументСсылка -
//                          *Значение - Строка - Подробное представление ошибки.
//
Процедура ОтразитьСостоянияЗаявок(Заявка, Ошибки = Неопределено) Экспорт
	
	Таблица = ТаблицаИзмененийСостоянийЗаявки(Заявка);
	ЗаписатьСостояния(Таблица, Ошибки);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ТаблицаИзмененийСостоянийЗаявки(Заявка)
	
	Аналитики = КонтрольКачества.АналитикиПоступившегоТовара(Заявка);
	ТаблицаДанных = КонтрольКачества.ОстаткиПоАналитикам(Аналитики, Ложь, Неопределено);
	
	ТекстыЗапроса = Новый СписокЗначений();
	ТекстыЗапроса.Добавить(ВременнаяТаблицаРеквизитыДокумента(),               "");
	ТекстыЗапроса.Добавить(ВременнаяТаблицаВыполненныеИсследования(),          "");
	ТекстыЗапроса.Добавить(ВременнаяТаблицаОформленныеАкты(),                  "");
	ТекстыЗапроса.Добавить(ТекстЗапросаРасчетаСостояний(),              "Таблица");
	
	Запрос = Новый Запрос();
	
	Если ТаблицаДанных.Количество() = 0 Тогда
		Запрос.УстановитьПараметр("ЕстьОстатокТоваровНаКонтроле", Ложь);
	Иначе
		Запрос.УстановитьПараметр("ЕстьОстатокТоваровНаКонтроле", Истина);
	КонецЕсли;
	
	Запрос.УстановитьПараметр("ЗаявкаНаКонтроль", Заявка);
	
	Таблицы = ОбщегоНазначенияУТ.ВыгрузитьРезультатыЗапроса(Запрос, ТекстыЗапроса, , Истина);

	Возврат Таблицы.Таблица;

КонецФункции

Функция ТекстЗапросаРасчетаСостояний()
	
	ТекстЗапроса =
		"ВЫБРАТЬ
		|	Таблица.Ссылка                        КАК Заявка,
		|	Таблица.Состояние                     КАК Состояние
		|ИЗ(
		|ВЫБРАТЬ
		|	ВтРеквизитыДокумента.Ссылка КАК Ссылка,
		|
		|	ВЫБОР КОГДА НЕ ВтРеквизитыДокумента.Проведен ТОГДА
		|
		|			ЗНАЧЕНИЕ(Перечисление.СостоянияЗаявокНаИсследование.ПустаяСсылка)
		|
		|		КОГДА НЕ ВтОформленныеАкты.Ссылка ЕСТЬ NULL И НЕ &ЕстьОстатокТоваровНаКонтроле 
		|			И ЕстьNull(ВтОформленныеАкты.КоличествоОтработанных, 0) <> 0 ТОГДА
		|
		|			ЗНАЧЕНИЕ(Перечисление.СостоянияЗаявокНаИсследование.Завершена)
		|
		|		КОГДА НЕ ВтОформленныеАкты.Ссылка ЕСТЬ NULL ТОГДА
		|
		|			ЗНАЧЕНИЕ(Перечисление.СостоянияЗаявокНаИсследование.ОжидаетОтработкиАктов)
		|
		|		КОГДА НЕ ВтВыполненныеИсследования.Ссылка ЕСТЬ NULL И 
		|			ЕстьNull(ВтВыполненныеИсследования.КоличествоВсего, 0) = ЕстьNull(ВтВыполненныеИсследования.КоличествоЗавершенных, 0)
		|			 И  ЕстьNull(ВтВыполненныеИсследования.КоличествоЗавершенных, 0) <> 0 ТОГДА
		|
		|			ЗНАЧЕНИЕ(Перечисление.СостоянияЗаявокНаИсследование.ИсследованияЗавершены)
		|
		|		КОГДА НЕ ВтВыполненныеИсследования.Ссылка ЕСТЬ NULL И 
		|			ЕстьNull(ВтВыполненныеИсследования.КоличествоВсего, 0) > ЕстьNull(ВтВыполненныеИсследования.КоличествоЗавершенных, 0)
		|			 И  ЕстьNull(ВтВыполненныеИсследования.КоличествоВсего, 0) <> 0 ТОГДА
		|
		|			ЗНАЧЕНИЕ(Перечисление.СостоянияЗаявокНаИсследование.ВПроцессеИсследования)
		|
		|		КОГДА НЕ ВтВыполненныеИсследования.Ссылка ЕСТЬ NULL  ТОГДА
		|
		|			ЗНАЧЕНИЕ(Перечисление.СостоянияЗаявокНаИсследование.ОжидаетсяИсследование)
		|
		|		ИНАЧЕ
		|
		|			ЗНАЧЕНИЕ(Перечисление.СостоянияЗаявокНаИсследование.ОжидаетсяИсследование)
		|
		|	КОНЕЦ КАК Состояние
		|
		|ИЗ
		|	ВтРеквизитыДокумента КАК ВтРеквизитыДокумента
		|
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВтВыполненныеИсследования КАК ВтВыполненныеИсследования
		|		ПО ВтВыполненныеИсследования.Ссылка = ВтРеквизитыДокумента.Ссылка
		|
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВтОформленныеАкты КАК ВтОформленныеАкты
		|		ПО ВтОформленныеАкты.Ссылка = ВтРеквизитыДокумента.Ссылка) КАК Таблица";
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ВременнаяТаблицаВыполненныеИсследования()
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ИсследованиеКачестваТоваров.ЗаявкаНаКонтроль КАК Ссылка,
	|	КОЛИЧЕСТВО(ИсследованиеКачестваТоваров.Ссылка) КАК КоличествоВсего,
	|	СУММА(ВЫБОР
	|		КОГДА ИсследованиеКачестваТоваров.Завершено = ИСТИНА
	|			ТОГДА 1
	|		ИНАЧЕ 0
	|	КОНЕЦ) КАК КоличествоЗавершенных
	|ПОМЕСТИТЬ ВтВыполненныеИсследования
	|ИЗ
	|	Документ.ИсследованиеКачестваТоваров КАК ИсследованиеКачестваТоваров
	|ГДЕ
	|	ИсследованиеКачестваТоваров.ЗаявкаНаКонтроль = &ЗаявкаНаКонтроль
	|	И ИсследованиеКачестваТоваров.Проведен = ИСТИНА
	|СГРУППИРОВАТЬ ПО
	|	ИсследованиеКачестваТоваров.ЗаявкаНаКонтроль";
	
	Возврат ТекстЗапроса
	
КонецФункции

Функция ВременнаяТаблицаРеквизитыДокумента()
	
	ТекстЗапроса =
		"ВЫБРАТЬ
		|	Таблица.Ссылка КАК Ссылка,
		|	Таблица.Проведен КАК Проведен
		|ПОМЕСТИТЬ ВтРеквизитыДокумента
		|ИЗ
		|	Документ.ЗаявкаНаКонтрольКачестваТоваров КАК Таблица
		|ГДЕ
		|	Таблица.Ссылка = &ЗаявкаНаКонтроль";
		
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ВременнаяТаблицаОформленныеАкты()
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	Таблица.ДокументОснование КАК Ссылка,
	|	СУММА(ВЫБОР
	|		КОГДА Таблица.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыАктовКонтроляКачества.Отработан)
	|			ТОГДА 1
	|		ИНАЧЕ 0
	|	КОНЕЦ) КАК КоличествоОтработанных,
	|	СУММА(ВЫБОР
	|		КОГДА Таблица.Статус <> ЗНАЧЕНИЕ(Перечисление.СтатусыАктовКонтроляКачества.Отработан)
	|			ТОГДА 1
	|		ИНАЧЕ 0
	|	КОНЕЦ) КАК КоличествоОформленных
	|ПОМЕСТИТЬ ВтОформленныеАкты
	|ИЗ
	|	Документ.АктКонтроляКачестваТоваров КАК Таблица
	|ГДЕ
	|	Таблица.ДокументОснование = &ЗаявкаНаКонтроль
	|	И Таблица.Проведен = ИСТИНА
	|СГРУППИРОВАТЬ ПО
	|	Таблица.ДокументОснование";
		
	Возврат ТекстЗапроса;
	
КонецФункции

Процедура ЗаписатьСостояния(Таблица, Ошибки = Неопределено)
	
	УстановитьПривилегированныйРежим(Истина);
	
	Для Каждого СтрокаТаблицы Из Таблица Цикл
	
		Набор = РегистрыСведений.СостоянияЗаявокНаКонтрольКачества.СоздатьНаборЗаписей();
		Набор.Отбор.Заявка.Установить(СтрокаТаблицы.Заявка);
		
		Если Не СтрокаТаблицы.Состояние.Пустая() Тогда
			СтрокаНабора = Набор.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаНабора, СтрокаТаблицы);
		КонецЕсли;
		
		Попытка
			Набор.Записать(Истина);
		Исключение
			
			Заявка = СтрокаТаблицы.Заявка;
			
			ТекстОшибки = СтрШаблон(НСтр("ru = 'Не удалось отразить состояние Заявкаи: %1 по причине: %2';
										|en = 'Cannot record the %1 request state. Reason: %2'"),
									Заявка,
									ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			
			ЗаписьЖурналаРегистрации(
				СобытиеЖурналаРегистрации(),
				УровеньЖурналаРегистрации.Предупреждение,
				Заявка.Метаданные(),
				Заявка,
				ТекстОшибки);
			
			Если Ошибки <> Неопределено Тогда
				Ошибки.Вставить(СтрокаТаблицы.Заявка, ТекстОшибки);
			КонецЕсли;
			
		КонецПопытки;
		
	КонецЦикла;
	
КонецПроцедуры

Функция СобытиеЖурналаРегистрации()
	
	Возврат НСтр("ru = 'Ошибка отражения состояния заявки на контроль контроль качества товаров';
				|en = 'An error occurred when recording the state of the request for goods quality control'", ОбщегоНазначения.КодОсновногоЯзыка());
	
КонецФункции

#КонецОбласти

#КонецЕсли
