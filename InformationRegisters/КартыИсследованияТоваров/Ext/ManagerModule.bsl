
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Записывает данные о требованиях контроля качества в регистр
//
// Параметры:
//  КартаИсследованияТоваров  - СправочникСсылка.КартыИсследованияТоваров.
//  ОчисткаЗаписейРегистра - Булево - определяет необходимость записи данных, либо только очистку уже имеющихся в регистре
//  ВызовИзОбработчикаОбновления - Булево - режим вызова из обработчика обновления
//
Процедура ЗаписатьКартыКонтроляКачества(КартаИсследованияТоваров, ОчисткаЗаписейРегистра = Ложь, ВызовИзОбработчикаОбновления = Ложь) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапросаКартыИсследованияТоваров(ВызовИзОбработчикаОбновления);
	Запрос.УстановитьПараметр("КартаИсследованияТоваров", КартаИсследованияТоваров);
	Запрос.УстановитьПараметр("ПрочитатьТребования", Не ОчисткаЗаписейРегистра);

	БлокировкаЗаписей = Новый БлокировкаДанных;
	ЭлементБлокировки = БлокировкаЗаписей.Добавить("РегистрСведений.КартыИсследованияТоваров");
	ЭлементБлокировки.УстановитьЗначение("КартаИсследованияТоваров", КартаИсследованияТоваров);

	НачатьТранзакцию();

	Попытка

		БлокировкаЗаписей.Заблокировать();

		РезультатЗапроса = Запрос.Выполнить();
		Если Не РезультатЗапроса.Пустой() Тогда

			ВыборкаТребований = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам,
				"КартаИсследованияТоваров");
			Пока ВыборкаТребований.Следующий() Цикл

				НаборЗаписей = РегистрыСведений.КартыИсследованияТоваров.СоздатьНаборЗаписей();
				НаборЗаписей.Отбор.КартаИсследованияТоваров.Установить(ВыборкаТребований.КартаИсследованияТоваров);

				Выборка = ВыборкаТребований.Выбрать(ОбходРезультатаЗапроса.Прямой);
				Пока Выборка.Следующий() Цикл

					Если ЗначениеЗаполнено(Выборка.Видноменклатуры) Тогда
						НоваяСтрока = НаборЗаписей.Добавить();
						ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
					КонецЕсли;

				КонецЦикла;

				Если ВызовИзОбработчикаОбновления Тогда
					ОбновлениеИнформационнойБазы.ЗаписатьДанные(НаборЗаписей);
				Иначе
					НаборЗаписей.Заполнить(Неопределено);
					НаборЗаписей.Записать();
				КонецЕсли;

			КонецЦикла;

		КонецЕсли;

		ЗафиксироватьТранзакцию();

	Исключение

		ОтменитьТранзакцию();

		ТекстСообщения = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);

		ВызватьИсключение;

	КонецПопытки;

КонецПроцедуры
	
// Возвращает список доступных карт исследования для указанной номенклатуры и характеристики.
//
// Параметры:
//   Номенклатура - СправочникСсылка.Номенклатура - Ссылка на элемент номенклатуры
//   Характеристика - СправочникСсылка.ХарактеристикиНоменклатуры - Ссылка на характеристику номенклатуры
//
// Возвращаемое значение:
//   Массив из СправочникСсылка.КартыИсследованияТоваров - Список доступных карт исследования
Функция ДоступныйСписокКартИсследованияТоваров(Номенклатура, Характеристика) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	КартыИсследованияТоваров.КартаИсследованияТоваров КАК Ссылка
		|ИЗ
		|	РегистрСведений.КартыИсследованияТоваров КАК КартыИсследованияТоваров
		|ГДЕ
		|	КартыИсследованияТоваров.ВидНоменклатуры = &ВидНоменклатуры
		|	И КартыИсследованияТоваров.Номенклатура = &Номенклатура
		|	И КартыИсследованияТоваров.Характеристика = &Характеристика";
	
	Запрос.УстановитьПараметр("ВидНоменклатуры", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Номенклатура, "ВидНоменклатуры"));
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("Характеристика", Характеристика);
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
	Возврат РезультатЗапроса;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область Прочее

Функция ТекстЗапросаКартыИсследованияТоваров(ВызовИзОбработчикаОбновления = Ложь)
	
	ТекстЗапроса = "ВЫБРАТЬ
	|	Т.Ссылка КАК КартаИсследованияТоваров,
	|	ВЫБОР
	|		КОГДА Т.ВидНоменклатуры ЕСТЬ NULL
	|			ТОГДА ЕСТЬNULL(Т.Номенклатура.ВидНоменклатуры, ЗНАЧЕНИЕ(Справочник.ВидыНоменклатуры.ПустаяСсылка))
	|		КОГДА Т.ВидНоменклатуры = ЗНАЧЕНИЕ(Справочник.ВидыНоменклатуры.ПустаяСсылка)
	|			ТОГДА ЕСТЬNULL(Т.Номенклатура.ВидНоменклатуры, ЗНАЧЕНИЕ(Справочник.ВидыНоменклатуры.ПустаяСсылка))
	|		ИНАЧЕ Т.ВидНоменклатуры
	|	КОНЕЦ КАК Видноменклатуры,
	|	Т.Номенклатура КАК Номенклатура,
	|	Т.Характеристика КАК Характеристика,
	|	Т.Ссылка.Статус КАК Статус
	|ПОМЕСТИТЬ ВтТовары
	|ИЗ
	|	Справочник.КартыИсследованияТоваров.Товары КАК Т
	|ГДЕ
	|	Т.Ссылка В (&КартаИсследованияТоваров)
	|	И Т.Ссылка.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыКартыИсследованияТоваров.Действует)
	|	И &ПрочитатьТребования
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КартыИсследованияТоваров.Ссылка                КАК КартаИсследованияТоваров,
	|	КартыИсследованияТоваров.Контроль           КАК Контроль,
	|	КартыИсследованияТоваров.ВариантОтбораОбразцов КАК ВариантОтбораОбразцов,
	|	КартыИсследованияТоваров.КоличествоОбразцов    КАК КоличествоОбразцов,
	|	КартыИсследованияТоваров.ПроцентОбразцов       КАК ПроцентОбразцов,
	|	ТоварыТ.*
	|ИЗ
	|	Справочник.КартыИсследованияТоваров КАК КартыИсследованияТоваров
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВтТовары КАК ТоварыТ
	|		ПО КартыИсследованияТоваров.Ссылка = ТоварыТ.КартаИсследованияТоваров
	|ГДЕ
	|	КартыИсследованияТоваров.Ссылка В (&КартаИсследованияТоваров)
	|ИТОГИ
	|ПО
	|	КартыИсследованияТоваров.Ссылка";
	
	Возврат ТекстЗапроса;
	
КонецФункции

#КонецОбласти

#КонецОбласти

#КонецЕсли
