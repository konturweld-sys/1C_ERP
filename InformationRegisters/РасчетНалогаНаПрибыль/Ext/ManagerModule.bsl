#Область ОбновлениеИнформационнойБазы
 // см. ОбновлениеИнформационнойБазыБСП.ПриДобавленииОбработчиковОбновления
Процедура ПриДобавленииОбработчиковОбновления(Обработчики) Экспорт

	Обработчик = Обработчики.Добавить();
	Обработчик.Процедура = "РегистрыСведений.РасчетНалогаНаПрибыль.ОбработатьДанныеДляПереходаНаНовуюВерсию";
	Обработчик.Версия = "2.5.26.61";
	Обработчик.РежимВыполнения = "Отложенно";
	Обработчик.Идентификатор = Новый УникальныйИдентификатор("154b3b6b-5722-4d5f-b9c8-8b4651d900e7");
	Обработчик.ПроцедураЗаполненияДанныхОбновления = "РегистрыСведений.РасчетНалогаНаПрибыль.ЗарегистрироватьДанныеКОбработкеДляПереходаНаНовуюВерсию";
	Обработчик.ПроцедураПроверки = "ОбновлениеИнформационнойБазы.ДанныеОбновленыНаНовуюВерсиюПрограммы";
	Обработчик.Порядок = Перечисления.ПорядокОбработчиковОбновления.Некритичный;
	Обработчик.Комментарий = НСтр("ru = 'Заполнение данных прошлых периодов по расчету налога на прибыль"".';
									|en = 'Fill in data from previous periods for calculating income tax.'");
	
	Читаемые = Новый Массив;
	Читаемые.Добавить(Метаданные.Документы.РегламентнаяОперация.ПолноеИмя());
	Обработчик.ЧитаемыеОбъекты = СтрСоединить(Читаемые, ",");
	
	Изменяемые = Новый Массив;
	Изменяемые.Добавить(Метаданные.РегистрыСведений.РасчетНалогаНаПрибыль.ПолноеИмя());
	Обработчик.ИзменяемыеОбъекты = СтрСоединить(Изменяемые, ",");
	
	Блокируемые = Новый Массив;
	Блокируемые.Добавить(Метаданные.РегистрыСведений.РасчетНалогаНаПрибыль.ПолноеИмя());
	Обработчик.БлокируемыеОбъекты = СтрСоединить(Блокируемые, ",");
	
	Обработчик.ПриоритетыВыполнения = ОбновлениеИнформационнойБазы.ПриоритетыВыполненияОбработчика();
КонецПроцедуры

// Параметры:
// 	Параметры - см. ОбновлениеИнформационнойБазы.ОсновныеПараметрыОтметкиКОбработке
//
Процедура ЗарегистрироватьДанныеКОбработкеДляПереходаНаНовуюВерсию(Параметры) Экспорт
	
	ДополнительныеПараметры = ОбновлениеИнформационнойБазы.ДополнительныеПараметрыОтметкиОбработки();
	ДополнительныеПараметры.ЭтоДвижения = Истина;
	ДополнительныеПараметры.ПолноеИмяРегистра = "РегистрСведений.РасчетНалогаНаПрибыль";

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ТаблицаДокумента.Ссылка КАК Ссылка,
	|	РасчетНалогаНаПрибыль.Регистратор КАК Регистратор
	|ИЗ
	|	Документ.РегламентнаяОперация КАК ТаблицаДокумента
	|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РасчетНалогаНаПрибыль КАК РасчетНалогаНаПрибыль
	|		ПО ТаблицаДокумента.Ссылка = РасчетНалогаНаПрибыль.Регистратор
	|ГДЕ
	|	ТаблицаДокумента.Проведен
	|	И ТаблицаДокумента.ТипОперации = ЗНАЧЕНИЕ(Перечисление.ТипыРегламентныхОпераций.РасчетНалогаНаПрибыль)
	|	И РасчетНалогаНаПрибыль.Регистратор ЕСТЬ NULL";
	
	Регистраторы = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
	ОбновлениеИнформационнойБазы.ОтметитьКОбработке(Параметры, Регистраторы, ДополнительныеПараметры);
	
КонецПроцедуры

Процедура ОбработатьДанныеДляПереходаНаНовуюВерсию(Параметры) Экспорт
	
	ПолноеИмяРегистра = "РегистрСведений.РасчетНалогаНаПрибыль";
	
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	ПараметрыОбработки = ОбновлениеИнформационнойБазы.СоздатьВременнуюТаблицуРегистраторовРегистраДляОбработки(
							Параметры.Очередь, 
							"Документ.РегламентнаяОперация", 
							ПолноеИмяРегистра, 
							МенеджерВременныхТаблиц);
		
	Если Не ПараметрыОбработки.ЕстьДанныеДляОбработки Тогда
		Параметры.ОбработкаЗавершена = Истина;
		Возврат;
	КонецЕсли;
	
	Если Не ПараметрыОбработки.ЕстьЗаписиВоВременнойТаблице Тогда
		Параметры.ОбработкаЗавершена = Ложь;
		Возврат;
	КонецЕсли;
	
	СоставБазы = Новый Массив;
	СоставБазы.Добавить(Перечисления.ПрибылиИУбытки.ПрибыльУбытокОтПродаж);
	СоставБазы.Добавить(Перечисления.ПрибылиИУбытки.СальдоПрочихДоходовИРасходов);
	СоставБазы.Добавить(Перечисления.ПрибылиИУбытки.ЧрезвычайныеДоходыРасходы);

	Субконто68_04_1 = Новый Массив;
	Субконто68_04_1.Добавить(ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.ВидыПлатежейВГосБюджет);
	Субконто68_04_1.Добавить(ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.УровниБюджетов);
	Субконто68_04_1.Добавить(ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.РегистрацияВНалоговомОргане);
	
	УровниБюджетов = Новый Массив;
	УровниБюджетов.Добавить(Перечисления.УровниБюджетов.ФедеральныйБюджет);
	УровниБюджетов.Добавить(Перечисления.УровниБюджетов.РегиональныйБюджет);
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц =  МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("Субконто68_04_1", Субконто68_04_1);
	Запрос.УстановитьПараметр("УровниБюджетов",  УровниБюджетов);
	Запрос.УстановитьПараметр("СоставБазы",      СоставБазы);
	Запрос.УстановитьПараметр("СчетаРасчетыСБюджетом", БухгалтерскийУчетПовтИсп.СчетаВИерархии(ПланыСчетов.Хозрасчетный.РасчетыСБюджетом));
	Запрос.УстановитьПараметр("ПрименяютсяРазныеСтавкиНалогаНаПрибыль", НалоговыйУчет.ПрименяютсяРазныеСтавкиНалогаНаПрибыль());

	Запрос.Текст = 
	"ВЫБРАТЬ
	|	НАЧАЛОПЕРИОДА(РегламентнаяОперация.Дата, МЕСЯЦ) КАК МесяцЗаписи,
	|	НАЧАЛОПЕРИОДА(КОНЕЦПЕРИОДА(РегламентнаяОперация.Дата, МЕСЯЦ), ДЕНЬ) КАК ПериодРасчета,
	|	РегламентнаяОперация.Организация КАК Организация,
	|	РегламентнаяОперация.Ссылка КАК Ссылка,
	|	УровниБюджетов.Ссылка КАК УровеньБюджета
	|ПОМЕСТИТЬ ВТ_Регистраторы
	|ИЗ
	|	Документ.РегламентнаяОперация КАК РегламентнаяОперация
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТДляОбработкиРасчетНалогаНаПрибыль КАК ДляОбработкиРегламентнаяОперация
	|		ПО РегламентнаяОперация.Ссылка = ДляОбработкиРегламентнаяОперация.Регистратор,
	|	Перечисление.УровниБюджетов КАК УровниБюджетов
	|ГДЕ
	|	УровниБюджетов.Ссылка В (ЗНАЧЕНИЕ(Перечисление.УровниБюджетов.РегиональныйБюджет), ЗНАЧЕНИЕ(Перечисление.УровниБюджетов.ФедеральныйБюджет))
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Организация,
	|	МесяцЗаписи,
	|	УровеньБюджета
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Регистраторы.Организация КАК Организация,
	|	ВТ_Регистраторы.МесяцЗаписи КАК МесяцЗаписи,
	|	ВТ_Регистраторы.Ссылка КАК Регистратор,
	|	ВТ_Регистраторы.УровеньБюджета КАК УровеньБюджета,
	|	ВТ_Регистраторы.МесяцЗаписи КАК Период,
	|	НАЧАЛОПЕРИОДА(КОНЕЦПЕРИОДА(ВТ_Регистраторы.МесяцЗаписи, МЕСЯЦ), ДЕНЬ) КАК ПериодРасчета,
	|	НЕ (РасчетДолейБазыНалогаНаПрибыльПоВариантамНалогообложения.НалоговаяБаза ЕСТЬ NULL
	|	И РасчетДолейБазыНалогаНаПрибыль.НалоговаяБаза ЕСТЬ NULL) КАК ВыборкаИзРегистра,
	|	ЕСТЬNULL(База.Субконто2, ЗНАЧЕНИЕ(Справочник.ВариантыНалогообложенияПрибыли.ПустаяСсылка)) КАК ВариантНалогообложенияПрибыли,
	|	ЕСТЬNULL(РасчетДолейБазыНалогаНаПрибыльПоВариантамНалогообложения.ДоляНалоговойБазы, ЕСТЬNULL(РасчетДолейБазыНалогаНаПрибыль.ДоляНалоговойБазы, 1)) КАК ДоляНалоговойБазы,
	|	ЕСТЬNULL(РасчетДолейБазыНалогаНаПрибыльПоВариантамНалогообложения.РегистрацияВНалоговомОргане,
	|						ЕСТЬNULL(РасчетДолейБазыНалогаНаПрибыль.РегистрацияВНалоговомОргане, ВТ_Регистраторы.Организация.РегистрацияВНалоговомОргане)) КАК РегистрацияВНалоговомОргане,
	|	ЕСТЬNULL(РасчетДолейБазыНалогаНаПрибыльПоВариантамНалогообложения.НалоговаяБаза, ЕСТЬNULL(РасчетДолейБазыНалогаНаПрибыль.НалоговаяБаза, ЕСТЬNULL(-База.СуммаНУОборот, 0))) КАК НалоговаяБаза,
	|	-База.СуммаНУОборот КАК НалоговаяБазаИзПроводок
	|ПОМЕСТИТЬ БазаПоНалогуНаПрибыль
	|ИЗ
	|	ВТ_Регистраторы КАК ВТ_Регистраторы
	|	ЛЕВОЕ СОЕДИНЕНИЕ
	|		РегистрБухгалтерии.Хозрасчетный.Обороты(, , Месяц, Счет В (ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ПрибылиИУбыткиНеЕНВД)), , Субконто1 В (&СоставБазы), , ) КАК База
	|		ПО ВТ_Регистраторы.Организация = База.Организация
	|			И ВТ_Регистраторы.МесяцЗаписи = База.Период
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РасчетДолейБазыНалогаНаПрибыль КАК РасчетДолейБазыНалогаНаПрибыль
	|		ПО ВТ_Регистраторы.Организация = РасчетДолейБазыНалогаНаПрибыль.Организация
	|			И ВТ_Регистраторы.ПериодРасчета = РасчетДолейБазыНалогаНаПрибыль.ПериодРасчета
	|			И ВТ_Регистраторы.УровеньБюджета = ЗНАЧЕНИЕ(Перечисление.УровниБюджетов.РегиональныйБюджет)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РасчетДолейБазыНалогаНаПрибыльПоВариантамНалогообложения КАК РасчетДолейБазыНалогаНаПрибыльПоВариантамНалогообложения
	|		ПО ВТ_Регистраторы.Организация = РасчетДолейБазыНалогаНаПрибыльПоВариантамНалогообложения.Организация
	|			И ВТ_Регистраторы.ПериодРасчета = РасчетДолейБазыНалогаНаПрибыльПоВариантамНалогообложения.ПериодРасчета
	|			И База.Субконто2 = РасчетДолейБазыНалогаНаПрибыльПоВариантамНалогообложения.ВариантНалогообложенияПрибыли
	|			И ВТ_Регистраторы.УровеньБюджета = ЗНАЧЕНИЕ(Перечисление.УровниБюджетов.РегиональныйБюджет)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Организация,
	|	Период,
	|	УровеньБюджета,
	|	ВариантНалогообложенияПрибыли,
	|	РегистрацияВНалоговомОргане
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Налоги.Организация КАК Организация,
	|	Налоги.Период КАК Период,
	|	ЕСТЬNULL(Налоги.СубконтоКт3, Налоги.Организация.РегистрацияВНалоговомОргане) КАК РегистрацияВНалоговомОргане,
	|	Налоги.СубконтоКт2 КАК УровеньБюджета,
	|	ЕСТЬNULL(Налоги.СубконтоДт1, ЗНАЧЕНИЕ(Справочник.ВариантыНалогообложенияПрибыли.ПустаяСсылка)) КАК ВариантНалогообложенияПрибыли,
	|	ЕСТЬNULL(Налоги.СуммаОборот, 0) КАК СуммаНалога
	|ПОМЕСТИТЬ ДанныеПоНалогу
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.ОборотыДтКт(
	|			,
	|			,
	|			Месяц,
	|			,
	|			ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконтоХозрасчетные.ВариантыНалогообложенияПрибыли),
	|			СчетКт В (&СчетаРасчетыСБюджетом),
	|			&Субконто68_04_1,
	|			СубконтоКт1 = ЗНАЧЕНИЕ(Перечисление.ВидыПлатежейВГосБюджет.Налог)
	|				И СубконтоКт2 В (&УровниБюджетов)) КАК Налоги
	|	
	|ИНДЕКСИРОВАТЬ ПО
	|	Организация,
	|	Период,
	|	УровеньБюджета,
	|	ВариантНалогообложенияПрибыли,
	|	РегистрацияВНалоговомОргане
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	БазаПоНалогуНаПрибыль.Организация КАК Организация,
	|	БазаПоНалогуНаПрибыль.Период КАК Период,
	|	БазаПоНалогуНаПрибыль.ПериодРасчета КАК ПериодРасчета,
	|	БазаПоНалогуНаПрибыль.Регистратор КАК Регистратор,
	|	БазаПоНалогуНаПрибыль.РегистрацияВНалоговомОргане КАК РегистрацияВНалоговомОргане,
	|	БазаПоНалогуНаПрибыль.УровеньБюджета КАК УровеньБюджета,
	|	ЕСТЬNULL(БазаПоНалогуНаПрибыль.ВариантНалогообложенияПрибыли, ЗНАЧЕНИЕ(Справочник.ВариантыНалогообложенияПрибыли.ПустаяСсылка)) КАК ВариантНалогообложенияПрибыли,
	|	ЕСТЬNULL(ДанныеПоНалогу.СуммаНалога, 0) КАК СуммаНалога,
	|	БазаПоНалогуНаПрибыль.ВыборкаИзРегистра КАК ВыборкаИзРегистра,
	|	БазаПоНалогуНаПрибыль.НалоговаяБаза КАК НалоговаяБаза,
	|	БазаПоНалогуНаПрибыль.НалоговаяБазаИзПроводок КАК НалоговаяБазаИзПроводок,
	|	БазаПоНалогуНаПрибыль.ДоляНалоговойБазы КАК ДоляНалоговойБазы,
	|	ГОД(БазаПоНалогуНаПрибыль.Период) КАК Год
