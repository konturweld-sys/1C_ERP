	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СтавкиНалогаНаПрибыльВБюджетСубъектовРФ.Организация КАК Организация,
	|	КОНЕЦПЕРИОДА(СтавкиНалогаНаПрибыльВБюджетСубъектовРФ.Период, МЕСЯЦ) КАК Период
	|ИЗ
	|	РегистрСведений.СтавкиНалогаНаПрибыльВБюджетСубъектовРФ КАК СтавкиНалогаНаПрибыльВБюджетСубъектовРФ
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВТ_Регистраторы.Организация,
	|	СтавкиНалогаНаПрибыльДляВсехОрганизаций.Период
	|ИЗ
	|	ВТ_Регистраторы КАК ВТ_Регистраторы,
	|	РегистрСведений.СтавкиНалогаНаПрибыльДляВсехОрганизаций КАК СтавкиНалогаНаПрибыльДляВсехОрганизаций";
	
	ГОД = 0;
	
	РезультатыЗапросов = Запрос.ВыполнитьПакет();
	КоличествоРезультатов = РезультатыЗапросов.Количество();

	ВыборкаРезультат = РезультатыЗапросов[КоличествоРезультатов - 3].Выбрать();
	ИзмененияПоСтавкамФБ = РезультатыЗапросов[КоличествоРезультатов - 2].Выгрузить();
	ИзмененияПоСтавкамРБ = РезультатыЗапросов[КоличествоРезультатов - 1].Выгрузить();
	ИзмененияПоСтавкамРБ.Индексы.Добавить("Период, Организация");
	ИзмененияПоСтавкамФБ.Индексы.Добавить("Период");
	
	ТаблицаСтавокРБ = ТаблицаДанных(Истина);
	ТаблицаСтавокФБ = ТаблицаДанных();
	ДанныеПредыдущегоПериода = ТаблицаДанных(Истина, Ложь);
	
	ОбъектовОбработано = 0;
	ИсключенияПриОбновлении = Новый Массив;
		
	Пока ВыборкаРезультат.СледующийПоЗначениюПоля("Организация") Цикл
		
		ТаблицаСтавокРБ.Очистить();
		ТаблицаСтавокФБ.Очистить();
		ДанныеПредыдущегоПериода.Очистить();
		
		Пока ВыборкаРезультат.СледующийПоЗначениюПоля("Период") Цикл
			
			Отбор = Новый Структура();
			Отбор.Вставить("Период", ВыборкаРезультат.Период);
			
			Строки = ИзмененияПоСтавкамФБ.НайтиСтроки(Отбор);
			
			Если Строки.Количество() > 0 Тогда
				ТаблицаСтавокФБ.Очистить();
			КонецЕсли;
			
			Отбор.Вставить("Организация", ВыборкаРезультат.Организация);
			Строки = ИзмененияПоСтавкамРБ.НайтиСтроки(Отбор);
			
			Если Строки.Количество() > 0 Тогда
				ТаблицаСтавокРБ.Очистить();
			КонецЕсли;
			
			Если Год <> ВыборкаРезультат.Год Тогда
				Год = Год(ВыборкаРезультат.Период);
				ДанныеПредыдущегоПериода.Очистить();
			КонецЕсли;
			
			Пока ВыборкаРезультат.СледующийПоЗначениюПоля("Регистратор") Цикл
				
				ПричинаИсключения = "";
				Рекомендация = "";
			
				СписокОписаний = Новый Массив;
				СписокОписаний.Добавить(НСтр("ru = 'Не удалось выполнить заполнение регистра ""Расчет налога на прибыль"".';
											|en = 'Cannot fill in the ""Income tax calculation"" register.'"));
				
				НачатьТранзакцию();
				
				Попытка
					
					ПричинаИсключения = "Блокировка";
					
					Блокировка = Новый БлокировкаДанных;
					
					ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.РасчетНалогаНаПрибыль.НаборЗаписей");
					ЭлементБлокировки.УстановитьЗначение("Регистратор", ВыборкаРезультат.Регистратор);
					ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
					
					Блокировка.Заблокировать();
					
					ПричинаИсключения = "ПлохиеДанные";
					Рекомендация = НСтр("ru = 'Перепроведите документ вручную.';
										|en = 'Repost the document manually.'");
					
					НаборЗаписей = РегистрыСведений.РасчетНалогаНаПрибыль.СоздатьНаборЗаписей();
					НаборЗаписей.Отбор.Регистратор.Установить(ВыборкаРезультат.Регистратор);
					
					Пока ВыборкаРезультат.Следующий() Цикл
						
						Если ЗначениеЗаполнено(ВыборкаРезультат.СуммаНалога) Или ЗначениеЗаполнено(ВыборкаРезультат.НалоговаяБазаИзПроводок) Тогда
							
							Отбор = Новый Структура();
							Отбор.Вставить("Организация", ВыборкаРезультат.Организация);
							Отбор.Вставить("ВариантНалогообложенияПрибыли", ВыборкаРезультат.ВариантНалогообложенияПрибыли);
							Отбор.Вставить("РегистрацияВНалоговомОргане", ВыборкаРезультат.РегистрацияВНалоговомОргане);
							Отбор.Вставить("УровеньБюджета", ВыборкаРезультат.УровеньБюджета);
							Строки = ДанныеПредыдущегоПериода.НайтиСтроки(Отбор);
							Если Строки.Количество() > 0 Тогда
								СтрокаДанных = Строки[0];
								СтрокаДанных.СуммаНалогаПрошлыхМесяцев = СтрокаДанных.СуммаНалога;
								ВыборкаИзРегистра = ВыборкаРезультат.ВыборкаИзРегистра;
								Если ЗначениеЗаполнено(ВыборкаРезультат.НалоговаяБазаИзПроводок) Тогда
									Если ВыборкаРезультат.ВыборкаИзРегистра Тогда
										НалоговаяБаза = ?(ВыборкаРезультат.НалоговаяБаза = 0, ВыборкаРезультат.НалоговаяБазаИзПроводок * ВыборкаРезультат.ДоляНалоговойБазы,
															ВыборкаРезультат.НалоговаяБаза);
									Если ВыборкаРезультат.НалоговаяБаза = 0 Тогда
											ВыборкаИзРегистра = Ложь;
									КонецЕсли;
									Иначе
										НалоговаяБаза = ВыборкаРезультат.НалоговаяБаза;
									КонецЕсли;
									СтрокаДанных.НалоговаяБаза = ?(ВыборкаИзРегистра, 0, СтрокаДанных.НалоговаяБаза) + НалоговаяБаза;
								КонецЕсли;
								СтрокаДанных.СуммаНалога = СтрокаДанных.СуммаНалога + ВыборкаРезультат.СуммаНалога;
							Иначе
								СтрокаДанных = ДанныеПредыдущегоПериода.Добавить();
								ЗаполнитьЗначенияСвойств(СтрокаДанных, ВыборкаРезультат);
								Если ВыборкаРезультат.ВыборкаИзРегистра И ВыборкаРезультат.НалоговаяБаза = 0 Тогда
										СтрокаДанных.НалоговаяБаза = ВыборкаРезультат.НалоговаяБазаИзПроводок * ВыборкаРезультат.ДоляНалоговойБазы;
								КонецЕсли;
							КонецЕсли;
							
							Если ВыборкаРезультат.УровеньБюджета = Перечисления.УровниБюджетов.ФедеральныйБюджет Тогда
								
								Отбор = Новый Структура();
								Отбор.Вставить("Организация", ВыборкаРезультат.Организация);
								Отбор.Вставить("ВариантНалогообложенияПрибыли", ВыборкаРезультат.ВариантНалогообложенияПрибыли);
								Строки = ТаблицаСтавокФБ.НайтиСтроки(Отбор);
								
								Если Строки.Количество() > 0 Тогда
									СтрокаДанных.СтавкаНалога = Строки[0].СтавкаНалога;
								Иначе
									СтрокаСтавок = ТаблицаСтавокФБ.Добавить();
									ЗаполнитьЗначенияСвойств(СтрокаСтавок, ВыборкаРезультат);
									СтрокаСтавок.СтавкаНалога = НалоговыйУчет.НалоговаяСтавкаФедеральныйБюджет(ВыборкаРезультат.Период,
											ВыборкаРезультат.Организация, "%", ВыборкаРезультат.ВариантНалогообложенияПрибыли);
									СтрокаДанных.СтавкаНалога = СтрокаСтавок.СтавкаНалога;
								КонецЕсли;
								
							Иначе
								
								Отбор = Новый Структура();
								Отбор.Вставить("Организация", ВыборкаРезультат.Организация);
								Отбор.Вставить("ВариантНалогообложенияПрибыли", ВыборкаРезультат.ВариантНалогообложенияПрибыли);
								Отбор.Вставить("РегистрацияВНалоговомОргане", ВыборкаРезультат.РегистрацияВНалоговомОргане);
								Строки = ТаблицаСтавокРБ.НайтиСтроки(Отбор);
								
								Если Строки.Количество() > 0 Тогда
									СтрокаДанных.СтавкаНалога = Строки[0].СтавкаНалога;
								Иначе
									СтрокаСтавок = ТаблицаСтавокРБ.Добавить();
									ЗаполнитьЗначенияСвойств(СтрокаСтавок, ВыборкаРезультат);
									СтрокаСтавок.СтавкаНалога = НалоговыйУчет.НалоговаяСтавкаРегиональныйБюджет(ВыборкаРезультат.Период,
										ВыборкаРезультат.Организация, "%", ВыборкаРезультат.ВариантНалогообложенияПрибыли, ВыборкаРезультат.РегистрацияВНалоговомОргане);
									СтрокаДанных.СтавкаНалога = СтрокаСтавок.СтавкаНалога;
							КонецЕсли;
							
							КонецЕсли;
							
						КонецЕсли;
						
					КонецЦикла;
					
					ДанныеПредыдущегоПериода.ЗаполнитьЗначения(ВыборкаРезультат.Регистратор, "Регистратор"); 
					ДанныеПредыдущегоПериода.ЗаполнитьЗначения(ВыборкаРезультат.ПериодРасчета, "ПериодРасчета");
					НаборЗаписей.Загрузить(ДанныеПредыдущегоПериода);
					
					ПричинаИсключения = "Запись";
					
					ОбновлениеИнформационнойБазы.ЗаписатьНаборЗаписей(НаборЗаписей);
					ОбъектовОбработано = ОбъектовОбработано + 1;
					
					ЗафиксироватьТранзакцию();
					
				Исключение
						
					ОтменитьТранзакцию();
					
					ОбновлениеИнформационнойБазыУТ.СообщитьОНеудачнойОбработке(ИнформацияОбОшибке(), ВыборкаРезультат.Регистратор);
			
					Если ПричинаИсключения = "ПлохиеДанные" Тогда
						
						ОписаниеПроблемы = ОбновлениеИнформационнойБазыУТ.ПроблемаСДанными(
							ВыборкаРезультат.Регистратор, Рекомендация, ИнформацияОбОшибке());
						ИсключенияПриОбновлении.Добавить(ОписаниеПроблемы);
						
					ИначеЕсли ПричинаИсключения = "Запись" Тогда
						
						ОбновлениеИнформационнойБазыУТ.ЗаписатьПлохиеДанные(
								ИсключенияПриОбновлении, ОбъектовОбработано, Параметры);
						ВызватьИсключение НСтр("ru = 'Не удалось обработать документ ""Расчет налога на прибыль"".';
												|en = 'Cannot process the ""Income tax calculation"" document.'");
						
					КонецЕсли;
					
				КонецПопытки;
			
			КонецЦикла;
			
		КонецЦикла;
	
	КонецЦикла;
	
	Если ОбъектовОбработано > 0 Тогда
		ОбновлениеИнформационнойБазыУТ.ЗаписатьПлохиеДанные(ИсключенияПриОбновлении, ОбъектовОбработано, Параметры);
	КонецЕсли;
		
	Параметры.ОбработкаЗавершена = Не ОбновлениеИнформационнойБазы.ЕстьДанныеДляОбработки(Параметры.Очередь, ПолноеИмяРегистра);
	
КонецПроцедуры

#КонецОбласти

Функция ТаблицаДанных(Региональный = Ложь, Ставки = Истина)
	
	ТаблицаДанных = Новый ТаблицаЗначений();
	ТаблицаДанных.Колонки.Добавить("Организация", Новый ОписаниеТипов("СправочникСсылка.Организации")); 
	Если Региональный Тогда
		ТаблицаДанных.Колонки.Добавить("РегистрацияВНалоговомОргане", Новый ОписаниеТипов("СправочникСсылка.РегистрацииВНалоговомОргане")); 
	КонецЕсли;
	ТаблицаДанных.Колонки.Добавить("ВариантНалогообложенияПрибыли", Новый ОписаниеТипов("СправочникСсылка.ВариантыНалогообложенияПрибыли"));
	ТаблицаДанных.Колонки.Добавить("СтавкаНалога", Новый ОписаниеТипов("Число"));
	
	Если НЕ Ставки Тогда
		ТаблицаДанных.Колонки.Добавить("УровеньБюджета",Новый ОписаниеТипов("ПеречислениеСсылка.УровниБюджетов"));
		ТаблицаДанных.Колонки.Добавить("НалоговаяБаза", Новый ОписаниеТипов("Число"));
		ТаблицаДанных.Колонки.Добавить("СуммаНалога",   Новый ОписаниеТипов("Число")); 
		ТаблицаДанных.Колонки.Добавить("СуммаНалогаПрошлыхМесяцев", Новый ОписаниеТипов("Число")); 
		ТаблицаДанных.Колонки.Добавить("Регистратор", );
		ТаблицаДанных.Колонки.Добавить("ПериодРасчета", );
	КонецЕсли;
	
	Возврат ТаблицаДанных;
	
КонецФункции 

#КонецОбласти

#КонецЕсли
