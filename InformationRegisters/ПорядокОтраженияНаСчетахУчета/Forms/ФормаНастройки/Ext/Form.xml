	<Attributes>
		<Attribute name="Список" id="1">
			<Type>
				<v8:Type>cfg:DynamicList</v8:Type>
			</Type>
			<MainAttribute>true</MainAttribute>
			<Settings xsi:type="DynamicList">
				<ManualQuery>true</ManualQuery>
				<DynamicDataRead>true</DynamicDataRead>
				<QueryText>ВЫБРАТЬ
	ОбщиеНастройки.Период КАК НачалоДействия,
	МИНИМУМ(ЕСТЬNULL(СледующиеОбщиеНастройки.Период, ДАТАВРЕМЯ(2222, 2, 2))) КАК ОкончаниеДействия,
	ОбщиеНастройки.АналитикаУчета КАК АналитикаУчета,
	ОбщиеНастройки.ВидСчета КАК ВидСчета,
	ОбщиеНастройки.Долгосрочный КАК Долгосрочный,
	ОбщиеНастройки.СчетУчета КАК СчетУчета,
	ОбщиеНастройки.Субконто КАК Субконто,
	ОбщиеНастройки.ОтноситсяКМалоценнымТМЦ КАК ОтноситсяКМалоценнымТМЦ,
	ОбщиеНастройки.Организация КАК ОрганизацияАналитики,
	ОбщиеНастройки.МестоУчета КАК МестоУчетаАналитики
ПОМЕСТИТЬ ОбщиеНастройки
ИЗ
	РегистрСведений.ПорядокОтраженияНаСчетахУчета КАК ОбщиеНастройки
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПорядокОтраженияНаСчетахУчета КАК СледующиеОбщиеНастройки
		ПО ОбщиеНастройки.Период &lt; СледующиеОбщиеНастройки.Период
			И ОбщиеНастройки.ВидСчета = СледующиеОбщиеНастройки.ВидСчета
			И ОбщиеНастройки.АналитикаУчета = СледующиеОбщиеНастройки.АналитикаУчета
			И ОбщиеНастройки.Организация = СледующиеОбщиеНастройки.Организация
			И ОбщиеНастройки.МестоУчета = СледующиеОбщиеНастройки.МестоУчета
			И ОбщиеНастройки.Долгосрочный = СледующиеОбщиеНастройки.Долгосрочный
ГДЕ
	ОбщиеНастройки.Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
	И ОбщиеНастройки.МестоУчета = НЕОПРЕДЕЛЕНО
{ГДЕ
	ОбщиеНастройки.АналитикаУчета.*,
	ОбщиеНастройки.ВидСчета.*,
