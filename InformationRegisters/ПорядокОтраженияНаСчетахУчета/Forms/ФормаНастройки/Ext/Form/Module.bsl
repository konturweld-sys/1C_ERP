#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	УстановитьУсловноеОформление();
	
	Если Параметры.Свойство("АвтоТест") Тогда // Возврат при получении формы для анализа.
		Возврат;
	КонецЕсли;
	
	СобытияФорм.ПриСозданииНаСервере(ЭтотОбъект, Отказ, СтандартнаяОбработка);
	
	ИмяВидаСчета = Неопределено;
	Параметры.Свойство("ИмяВидаСчета", ИмяВидаСчета);
	Если ИмяВидаСчета <> Неопределено Тогда
		Параметры.Отбор.Вставить("ВидСчета", Перечисления.ВидыСчетовРеглУчета[ИмяВидаСчета]);
	КонецЕсли;
	
	ЗаполнитьФормуПоПараметрам(Параметры.Отбор);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ОтборВидСчетаПриИзменении(Элемент)
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
		Список, "ВидСчета", ВидСчета,,, ЗначениеЗаполнено(ВидСчета));
КонецПроцедуры

&НаКлиенте
Процедура ОтборАналитикаУчетаПриИзменении(Элемент)
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
		Список, "АналитикаУчета", АналитикаУчета,,, ЗначениеЗаполнено(АналитикаУчета));
КонецПроцедуры

&НаКлиенте
Процедура ОтборОрганизацияПриИзменении(Элемент)
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
		Список, "Организация", Организация,,, ЗначениеЗаполнено(Организация));
КонецПроцедуры

&НаКлиенте
Процедура ОтборМестоУчетаПриИзменении(Элемент)
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
		Список, "МестоУчета", МестоУчета,,, ЗначениеЗаполнено(МестоУчета));
КонецПроцедуры

&НаКлиенте
Процедура ВидЗадолженностиПриИзменении(Элемент)
	СтрокаОтбора = НСтр("ru = 'Показаны все виды задолженности';
						|en = 'Showing all debt kinds'");
	Если ВидЗадолженности = 1 Тогда
		СтрокаОтбора = НСтр("ru = 'Показана краткосрочная задолженность';
							|en = 'Showing short-term debt'");
	ИначеЕсли ВидЗадолженности = 2 Тогда
		СтрокаОтбора = НСтр("ru = 'Показана долгосрочная задолженность';
							|en = 'Showing long-term debt'");
	КонецЕсли;
	ВидЗадолженностиСтрокой = Новый ФорматированнаяСтрока(СтрокаОтбора);
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
		Список, "Долгосрочный", ВидЗадолженности = 2,,, ЗначениеЗаполнено(ВидЗадолженности));
КонецПроцедуры
	
&НаКлиенте
Процедура РежимНастройкиПриИзменении(Элемент)
	СтрокаОтбора = НСтр("ru = 'Выбор режима настройки';
						|en = 'Select setup mode'");
	Если РежимНастройки = 1 Тогда
		СтрокаОтбора = НСтр("ru = 'Показаны общие настройки';
							|en = 'General settings are shown'");
	ИначеЕсли РежимНастройки = 2 Тогда
		СтрокаОтбора = НСтр("ru = 'Показаны настройки исключений';
							|en = 'Exception settings are shown'");
	КонецЕсли;
	РежимНастройкиСтрокой = Новый ФорматированнаяСтрока(СтрокаОтбора);
	ОтборРежимаНастройки = ?(РежимНастройки = 1, ВидСравненияКомпоновкиДанных.НеЗаполнено, ВидСравненияКомпоновкиДанных.Заполнено);
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
		Список, "Организация",, ОтборРежимаНастройки,, ЗначениеЗаполнено(РежимНастройки));
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	УсловноеОформление.Элементы.Очистить();
	
	СтруктураНастроекИзмерений = Новый Структура("АналитикаУчета, Организация, МестоУчета", Новый Соответствие, Новый Соответствие, Новый Соответствие);
	
	Элемент = УсловноеОформление.Элементы.Добавить();
	
	КомпоновкаДанныхКлиентСервер.ДобавитьОформляемоеПоле(Элемент.Поля, Элементы["МестоУчета"].Имя);
	КомпоновкаДанныхКлиентСервер.ДобавитьОформляемоеПоле(Элемент.Поля, Элементы["Организация"].Имя);
		
	КомпоновкаДанныхКлиентСервер.ДобавитьОтбор(Элемент.Отбор, "Список.МестоУчета", , ВидСравненияКомпоновкиДанных.НеЗаполнено);
	КомпоновкаДанныхКлиентСервер.ДобавитьОтбор(Элемент.Отбор, "Список.Организация", , ВидСравненияКомпоновкиДанных.НеЗаполнено);
	
	Элемент.Оформление.УстановитьЗначениеПараметра("ОтметкаНезаполненного", Ложь);
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.НезаполненноеПолеТаблицы);
	Элемент.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru = 'Настройка для аналитики учета';
																|en = 'Setting for accounting dimension'"));
	
	Для каждого РазделУчета Из РегистрыСведений.ПорядокОтраженияНаСчетахУчета.СписокРазделовСчетовУчета() Цикл
		
		Если Не РазделУчета.Пометка Тогда
			Продолжить;
		КонецЕсли;
		
		СчетаУчетаРаздела = НастройкаСчетовУчетаСервер.ВидыСчетовРеглУчетаПоРазделуУчета(РазделУчета.Значение, Истина);
		
		НастройкаАналитики = НастройкаСчетовУчетаСервер.НастройкиАналитикиУчетаПоРазделуУчета(РазделУчета.Значение);
		НастройкаМестаУчета = НастройкаСчетовУчетаСервер.НастройкиМестаУчетаПоРазделуУчета(РазделУчета.Значение);
		НастройкаОрганизации = НастройкаСчетовУчетаСервер.НастройкиОрганизацииПоРазделуУчета(РазделУчета.Значение);
		
		Если Не НастройкаАналитики.Используется Тогда
			
			ДополнитьМассивСчетовСтруктуры(СтруктураНастроекИзмерений.АналитикаУчета, "НеИспользуется", СчетаУчетаРаздела);
		
		ИначеЕсли ЗначениеЗаполнено(НастройкаАналитики.ПредставлениеПустого) Тогда
			
			ДополнитьМассивСчетовСтруктуры(СтруктураНастроекИзмерений.АналитикаУчета, НастройкаАналитики.ПредставлениеПустого, СчетаУчетаРаздела);
		
		Иначе
			
			ДополнитьМассивСчетовСтруктуры(СтруктураНастроекИзмерений.АналитикаУчета, "ОтметкаНезаполненного", СчетаУчетаРаздела);
			
		КонецЕсли;
		
		Если Не НастройкаМестаУчета.Используется Тогда
			
			ДополнитьМассивСчетовСтруктуры(СтруктураНастроекИзмерений.МестоУчета, "НеИспользуется", СчетаУчетаРаздела);
		
		ИначеЕсли ЗначениеЗаполнено(НастройкаМестаУчета.ПредставлениеПустого) Тогда
			
			ДополнитьМассивСчетовСтруктуры(СтруктураНастроекИзмерений.МестоУчета, НастройкаМестаУчета.ПредставлениеПустого, СчетаУчетаРаздела);
		
		Иначе
			
			ДополнитьМассивСчетовСтруктуры(СтруктураНастроекИзмерений.МестоУчета, "ОтметкаНезаполненного", СчетаУчетаРаздела);
			
		КонецЕсли;
		
		Если Не НастройкаОрганизации.Используется Тогда
			
			ДополнитьМассивСчетовСтруктуры(СтруктураНастроекИзмерений.Организация, "НеИспользуется", СчетаУчетаРаздела);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Для каждого НастройкаИзмерения Из СтруктураНастроекИзмерений Цикл
		
		Для каждого НастройкаУсловногоОформленияИзмерения Из НастройкаИзмерения.Значение Цикл
			
			СписокСчетов = Новый СписокЗначений;
			СписокСчетов.ЗагрузитьЗначения(НастройкаУсловногоОформленияИзмерения.Значение);
			
			Элемент = УсловноеОформление.Элементы.Добавить();
			
			КомпоновкаДанныхКлиентСервер.ДобавитьОформляемоеПоле(Элемент.Поля, Элементы[НастройкаИзмерения.Ключ].Имя);
			
			КомпоновкаДанныхКлиентСервер.ДобавитьОтбор(Элемент.Отбор, "Список.ВидСчета", СписокСчетов, ВидСравненияКомпоновкиДанных.ВСписке);
			КомпоновкаДанныхКлиентСервер.ДобавитьОтбор(Элемент.Отбор, "Список." + НастройкаИзмерения.Ключ, , ВидСравненияКомпоновкиДанных.НеЗаполнено);
			Если НастройкаИзмерения.Ключ = "МестоУчета" Тогда
				КомпоновкаДанныхКлиентСервер.ДобавитьОтбор(Элемент.Отбор, "Список.Организация", , ВидСравненияКомпоновкиДанных.Заполнено);
			КонецЕсли;
			
			Если НастройкаУсловногоОформленияИзмерения.Ключ = "НеИспользуется" Тогда
				Элемент.Оформление.УстановитьЗначениеПараметра("ОтметкаНезаполненного", Ложь);
				Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ЗаблокированныйРеквизитЦвет);
				Если НастройкаИзмерения.Ключ = "Организация" Тогда
					Элемент.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru = 'Настройка по организации не применяется';
																				|en = 'Setting by company is not used'"));
				Иначе
					Элемент.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru = 'Не используется';
																				|en = 'Inactive'"));
				КонецЕсли;
			ИначеЕсли НастройкаУсловногоОформленияИзмерения.Ключ = "ОтметкаНезаполненного" Тогда
				Элемент.Оформление.УстановитьЗначениеПараметра("ОтметкаНезаполненного", Истина);
			Иначе
				Элемент.Оформление.УстановитьЗначениеПараметра("ОтметкаНезаполненного", Ложь);
				Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.НезаполненноеПолеТаблицы);
				Элемент.Оформление.УстановитьЗначениеПараметра("Текст", НастройкаУсловногоОформленияИзмерения.Ключ);
			КонецЕсли
			
		КонецЦикла;
		
	КонецЦикла;
	
	Элемент = УсловноеОформление.Элементы.Добавить();
	
	КомпоновкаДанныхКлиентСервер.ДобавитьОформляемоеПоле(Элемент.Поля, Элементы["Период"].Имя);
	
	КомпоновкаДанныхКлиентСервер.ДобавитьОтбор(Элемент.Отбор, "Список.Период", , ВидСравненияКомпоновкиДанных.НеЗаполнено);
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ЗаблокированныйРеквизитЦвет);
	Элемент.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru = 'с начала учета';
																|en = 'from accounting start'"));
	
	ДолгосрочныеСчета = НастройкаСчетовУчетаКлиентСервер.ВидыСчетовСНастройкамиДолгосрочнойЗадолженности();
	СписокДолгосрочныхСчетов = Новый СписокЗначений;
	Для каждого ДолгосрочныйСчет Из ДолгосрочныеСчета Цикл
		СписокДолгосрочныхСчетов.Добавить(Перечисления.ВидыСчетовРеглУчета[ДолгосрочныйСчет]);
	КонецЦикла;
	
	Элемент = УсловноеОформление.Элементы.Добавить();
	
	КомпоновкаДанныхКлиентСервер.ДобавитьОформляемоеПоле(Элемент.Поля, Элементы["Долгосрочный"].Имя);
	
	КомпоновкаДанныхКлиентСервер.ДобавитьОтбор(Элемент.Отбор, "Список.ВидСчета", СписокДолгосрочныхСчетов, ВидСравненияКомпоновкиДанных.НеВСписке);
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ЗаблокированныйРеквизитЦвет);
	Элемент.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru = 'не применяется';
																|en = 'not applied'"));
	
	СчетаИспользующиеСубконто = НастройкаСчетовУчетаКлиентСервер.СчетаИспользующиеСубконто();
	СписокСчетаИспользующиеСубконто = Новый СписокЗначений;
	Для каждого СчетИспользующийСубконто Из СчетаИспользующиеСубконто Цикл
		СписокСчетаИспользующиеСубконто.Добавить(Перечисления.ВидыСчетовРеглУчета[СчетИспользующийСубконто.Значение]);
	КонецЦикла;
	
	СписокПрочихДоходовРасходов = Новый СписокЗначений;
	СписокПрочихДоходовРасходов.Добавить(ПредопределенноеЗначение("ПланСчетов.Хозрасчетный.ПрочиеДоходы"));
	СписокПрочихДоходовРасходов.Добавить(ПредопределенноеЗначение("ПланСчетов.Хозрасчетный.ПрочиеРасходы"));
	Элемент = УсловноеОформление.Элементы.Добавить();
	КомпоновкаДанныхКлиентСервер.ДобавитьОформляемоеПоле(Элемент.Поля, Элементы["Субконто"].Имя);
	ГруппаОтбора = КомпоновкаДанныхКлиентСервер.ДобавитьГруппуОтбора(Элемент.Отбор.Элементы, ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИли);
	КомпоновкаДанныхКлиентСервер.ДобавитьОтбор(ГруппаОтбора, "Список.ВидСчета", СписокСчетаИспользующиеСубконто, ВидСравненияКомпоновкиДанных.НеВСписке);
	ГруппаОтбораЗаполнено = КомпоновкаДанныхКлиентСервер.ДобавитьГруппуОтбора(ГруппаОтбора.Элементы, ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИ);
	КомпоновкаДанныхКлиентСервер.ДобавитьОтбор(ГруппаОтбораЗаполнено, "Список.СчетУчета", Неопределено, ВидСравненияКомпоновкиДанных.Заполнено);
	КомпоновкаДанныхКлиентСервер.ДобавитьОтбор(ГруппаОтбораЗаполнено, "Список.СчетУчета", СписокПрочихДоходовРасходов, ВидСравненияКомпоновкиДанных.НеВСписке);
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ЦветНедоступногоТекста);
	Элемент.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru = 'Не используется';
																|en = 'Inactive'"));
	Элемент.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
			Элемент = УсловноеОформление.Элементы.Добавить();
	КомпоновкаДанныхКлиентСервер.ДобавитьОформляемоеПоле(Элемент.Поля, Элементы["Субконто"].Имя);
	КомпоновкаДанныхКлиентСервер.ДобавитьОтбор(Элемент.Отбор, "Список.СчетУчета", СписокПрочихДоходовРасходов, ВидСравненияКомпоновкиДанных.ВСписке);
	КомпоновкаДанныхКлиентСервер.ДобавитьОтбор(Элемент.Отбор, "Список.Субконто", Неопределено, ВидСравненияКомпоновкиДанных.НеЗаполнено);
	Элемент.Оформление.УстановитьЗначениеПараметра("ОтметкаНезаполненного", Истина);
	
	СчетДопПоля = НастройкаСчетовУчетаКлиентСервер.СчетУчетаДляКоторогоИспользуетсяДопПоле("ОтноситсяКМалоценнымТМЦ");
	СчетДопПоля = Перечисления.ВидыСчетовРеглУчета[СчетДопПоля];
	
	Элемент = УсловноеОформление.Элементы.Добавить();
	
	КомпоновкаДанныхКлиентСервер.ДобавитьОформляемоеПоле(Элемент.Поля, Элементы["ОтноситсяКМалоценнымТМЦ"].Имя);
	
	КомпоновкаДанныхКлиентСервер.ДобавитьОтбор(Элемент.Отбор, "Список.ВидСчета", СчетДопПоля, ВидСравненияКомпоновкиДанных.НеРавно);
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ЗаблокированныйРеквизитЦвет);
	Элемент.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru = 'не применяется';
																|en = 'not applied'"));
	
	Элемент = УсловноеОформление.Элементы.Добавить();
	
	КомпоновкаДанныхКлиентСервер.ДобавитьОформляемоеПоле(Элемент.Поля, Элементы.СчетУчета.Имя);
	
	КомпоновкаДанныхКлиентСервер.ДобавитьОтбор(Элемент.Отбор, "Список.СчетПоУмолчанию", Истина, ВидСравненияКомпоновкиДанных.Равно);
	КомпоновкаДанныхКлиентСервер.ДобавитьОтбор(Элемент.Отбор, "Список.СчетУчета", Неопределено, ВидСравненияКомпоновкиДанных.Заполнено);
	
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ТекстИнформационнойНадписи);
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ДополнитьМассивСчетовСтруктуры(СоответствиеНастроек, ВидНастройки, СчетаУчетаРаздела)
	
	СчетаУчета = СоответствиеНастроек.Получить(ВидНастройки);
	Если СчетаУчета = Неопределено Тогда
		СчетаУчета = Новый Массив;
	КонецЕсли;
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(СчетаУчета, СчетаУчетаРаздела, Истина);
	СоответствиеНастроек.Вставить(ВидНастройки, СчетаУчета);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьФормуПоПараметрам(ПараметрыОтбора)
	
	ВидЗадолженностиСтрокой = Новый ФорматированнаяСтрока(НСтр("ru = 'Показаны все виды задолженности';
																|en = 'Showing all debt kinds'"));
	РежимНастройкиСтрокой = Новый ФорматированнаяСтрока(НСтр("ru = 'Выбор режима настройки';
															|en = 'Select setup mode'"));
	
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, ПараметрыОтбора);
	
	Для Каждого КлючИЗначение Из ПараметрыОтбора Цикл
		
		Если КлючИЗначение.Ключ = "Долгосрочный" Тогда
			ВидЗадолженности = ?(КлючИЗначение.Значение, 2, 1);
			Если ВидЗадолженности = 1 Тогда
				ВидЗадолженностиСтрокой = Новый ФорматированнаяСтрока(НСтр("ru = 'Показана краткосрочная задолженность';
																			|en = 'Showing short-term debt'"));
			ИначеЕсли ВидЗадолженности = 2 Тогда
				ВидЗадолженностиСтрокой = Новый ФорматированнаяСтрока(НСтр("ru = 'Показана долгосрочная задолженность';
																			|en = 'Showing long-term debt'"));
			КонецЕсли;
			ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
				Список, "Долгосрочный", ВидЗадолженности = 2,,, Истина);
		ИначеЕсли ЗначениеЗаполнено(КлючИЗначение.Значение) Тогда
			ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
				Список, КлючИЗначение.Ключ, КлючИЗначение.Значение,,, Истина);
		КонецЕсли;
		
	КонецЦикла;
	
	ПараметрыОтбора.Очистить();
	
	Если ЗначениеЗаполнено(АналитикаУчета) Тогда
		Заголовок = Заголовок + " " + НСтр("ru = 'по аналитике ""';
											|en = 'by dimension ""'") + АналитикаУчета + """";
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти