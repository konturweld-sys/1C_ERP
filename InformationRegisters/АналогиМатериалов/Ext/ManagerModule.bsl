#Область ОбновлениеИнформационнойБазы

// Добавляет в список процедуры-обработчики обновления данных ИБ
// для всех поддерживаемых версий библиотеки или конфигурации.
// Вызывается перед началом обновления данных ИБ для построения плана обновления.
// Параметры:
// 	Обработчики - см. ОбновлениеИнформационнойБазы.НоваяТаблицаОбработчиковОбновления
//
Процедура ПриДобавленииОбработчиковОбновления(Обработчики) Экспорт

	Обработчик = Обработчики.Добавить();
	Обработчик.Процедура = "РегистрыСведений.АналогиМатериалов.ОбработатьДанныеДляПереходаНаНовуюВерсию";
	Обработчик.Версия = "2.5.26.84";
	Обработчик.РежимВыполнения = "Отложенно";
	Обработчик.Идентификатор = Новый УникальныйИдентификатор("a017c4fc-f9c7-449c-b476-03eb0ad7aaa0");
	Обработчик.Многопоточный = Истина;
	Обработчик.ПроцедураЗаполненияДанныхОбновления = "РегистрыСведений.АналогиМатериалов.ЗарегистрироватьДанныеКОбработкеДляПереходаНаНовуюВерсию";
	Обработчик.ПроцедураПроверки = "ОбновлениеИнформационнойБазы.ДанныеОбновленыНаНовуюВерсиюПрограммы";
	Обработчик.Порядок = Перечисления.ПорядокОбработчиковОбновления.Обычный;
	Обработчик.Комментарий = НСтр("ru = 'Актуализация движений по регистру сведений ""Аналоги материалов"".';
									|en = 'Update records of the ""Substitutes"" information register.'");
	
	ПриоритетыВыполнения = ОбновлениеИнформационнойБазы.ПриоритетыВыполненияОбработчика();
	Приоритет = ПриоритетыВыполнения.Добавить();
	Приоритет.Порядок = "После";
	Приоритет.Процедура = "Документы.РазрешениеНаЗаменуМатериалов.ОбработатьДанныеДляПереходаНаНовуюВерсию";
	Обработчик.ПриоритетыВыполнения = ПриоритетыВыполнения;
	
	Читаемые = Новый Массив;
	Читаемые.Добавить(Метаданные.Документы.РазрешениеНаЗаменуМатериалов.ПолноеИмя());
	Читаемые.Добавить(Метаданные.РегистрыСведений.АналогиМатериалов.ПолноеИмя());
	Обработчик.ЧитаемыеОбъекты = СтрСоединить(Читаемые, ",");
	
	Изменяемые = Новый Массив;
	Изменяемые.Добавить(Метаданные.РегистрыСведений.АналогиМатериалов.ПолноеИмя());
	Обработчик.ИзменяемыеОбъекты = СтрСоединить(Изменяемые, ",");
	
	Блокируемые = Новый Массив;
	Блокируемые.Добавить(Метаданные.РегистрыСведений.АналогиМатериалов.ПолноеИмя());
	Обработчик.БлокируемыеОбъекты = СтрСоединить(Блокируемые, ",");

КонецПроцедуры

// Регистрирует документы к обработке для изменения записей.
//
// Параметры:
// 	Параметры - см. ОбновлениеИнформационнойБазы.ОсновныеПараметрыОтметкиКОбработке
//
Процедура ЗарегистрироватьДанныеКОбработкеДляПереходаНаНовуюВерсию(Параметры) Экспорт
	
	ПолноеИмяРегистра = "РегистрСведений.АналогиМатериалов";
	
	ПараметрыВыборки = Параметры.ПараметрыВыборки;
	ПараметрыВыборки.ПолныеИменаОбъектов = "Документ.РазрешениеНаЗаменуМатериалов";
	ПараметрыВыборки.ПолныеИменаРегистров = ПолноеИмяРегистра;
	ПараметрыВыборки.СпособВыборки = ОбновлениеИнформационнойБазы.СпособВыборкиРегистраторыРегистра();
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	ДанныеДокумента.Ссылка КАК Ссылка,
	|	ДанныеДокумента.Ссылка.ВариантЗамены КАК ВариантЗамены,
	|	ДанныеДокумента.Ссылка.ИспользоватьПриАвтозаменеВЗаказах КАК ИспользоватьПриАвтозаменеВЗаказах,
	|	СУММА(ДанныеДокумента.КоличествоМатериалов) КАК КоличествоМатериалов,
	|	СУММА(ДанныеДокумента.КоличествоАналогов) КАК КоличествоАналогов
	|ПОМЕСТИТЬ ДанныеРазрешенийНаЗамену
	|ИЗ
	|	(ВЫБРАТЬ
	|		РазрешениеНаЗаменуМатериаловМатериалы.Ссылка КАК Ссылка,
	|		СУММА(1) КАК КоличествоМатериалов,
	|		0 КАК КоличествоАналогов
	|	ИЗ
	|		Документ.РазрешениеНаЗаменуМатериалов.Материалы КАК РазрешениеНаЗаменуМатериаловМатериалы
	|	
	|	СГРУППИРОВАТЬ ПО
	|		РазрешениеНаЗаменуМатериаловМатериалы.Ссылка
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		РазрешениеНаЗаменуМатериаловАналоги.Ссылка,
	|		0,
	|		СУММА(1)
	|	ИЗ
	|		Документ.РазрешениеНаЗаменуМатериалов.Аналоги КАК РазрешениеНаЗаменуМатериаловАналоги
	|	
	|	СГРУППИРОВАТЬ ПО
	|		РазрешениеНаЗаменуМатериаловАналоги.Ссылка) КАК ДанныеДокумента
	|
	|СГРУППИРОВАТЬ ПО
	|	ДанныеДокумента.Ссылка,
	|	ДанныеДокумента.Ссылка.ВариантЗамены,
	|	ДанныеДокумента.Ссылка.ИспользоватьПриАвтозаменеВЗаказах
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ВариантЗамены,
	|	ИспользоватьПриАвтозаменеВЗаказах,
	|	КоличествоМатериалов,
	|	КоличествоАналогов
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДанныеРазрешенийНаЗамену.Ссылка КАК Ссылка,
	|	ДанныеРазрешенийНаЗамену.ИспользоватьПриАвтозаменеВЗаказах КАК ИспользоватьПриАвтозаменеВЗаказахВДокументе,
	|	ВЫБОР
	|		КОГДА ДанныеРазрешенийНаЗамену.ВариантЗамены = ЗНАЧЕНИЕ(Перечисление.ВариантЗаменыАналогов.СписокАналогов)
	|			ТОГДА ИСТИНА
	|		КОГДА ДанныеРазрешенийНаЗамену.ВариантЗамены = ЗНАЧЕНИЕ(Перечисление.ВариантЗаменыАналогов.НаборНаНабор)
	|			ТОГДА ДанныеРазрешенийНаЗамену.КоличествоМатериалов = 1
	|					И ДанныеРазрешенийНаЗамену.КоличествоАналогов = 1
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ИспользоватьПриАвтозаменеВЗаказахКУстановке
	|ПОМЕСТИТЬ ТаблицаПрименениеВЗаказах
	|ИЗ
	|	ДанныеРазрешенийНаЗамену КАК ДанныеРазрешенийНаЗамену
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	РазрешениеНаЗаменуМатериалов.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.РазрешениеНаЗаменуМатериалов КАК РазрешениеНаЗаменуМатериалов
	|ГДЕ
	|	РазрешениеНаЗаменуМатериалов.Проведен
	|	И РазрешениеНаЗаменуМатериалов.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыРазрешенийНаЗаменуМатериалов.Утверждено)
	|	И ИСТИНА В
	|			(ВЫБРАТЬ ПЕРВЫЕ 1
	|				ИСТИНА
	|			ИЗ
	|				РегистрСведений.АналогиМатериалов КАК АналогиМатериалов
	|			ГДЕ
	|				АналогиМатериалов.Регистратор = РазрешениеНаЗаменуМатериалов.Ссылка
	|				И (АналогиМатериалов.ПриоритетЗамены = ЗНАЧЕНИЕ(Перечисление.ПравилаЗаменыНаАналоги.ПустаяСсылка)
	|					ИЛИ АналогиМатериалов.Количество = 0
	|					ИЛИ (ИСТИНА В
	|							(ВЫБРАТЬ ПЕРВЫЕ 1
	|								ИСТИНА
	|							ИЗ
	|								ТаблицаПрименениеВЗаказах КАК ТаблицаПрименениеВЗаказах
	|							ГДЕ
	|								ТаблицаПрименениеВЗаказах.Ссылка = АналогиМатериалов.Регистратор
	|								И ТаблицаПрименениеВЗаказах.ИспользоватьПриАвтозаменеВЗаказахКУстановке <> АналогиМатериалов.ИспользоватьПриАвтозаменеВЗаказах))))";
		
	Запрос = Новый Запрос(ТекстЗапроса);
	Регистраторы = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
	ОбновлениеИнформационнойБазы.ОтметитьРегистраторыКОбработке(Параметры, Регистраторы, ПолноеИмяРегистра);
	
КонецПроцедуры

// Обработчик обновления.
// 
// Параметры:
//  Параметры - см. ОбновлениеИнформационнойБазы.ОсновныеПараметрыОтметкиКОбработке.
//
Процедура ОбработатьДанныеДляПереходаНаНовуюВерсию(Параметры) Экспорт
		
	ДополнительныеПараметры = ОбновлениеИнформационнойБазыУТ.ДополнительныеПараметрыПерезаписиДвиженийИзОчереди();
	ДополнительныеПараметры.ОбновляемыеДанные = Параметры.ОбновляемыеДанные;
	
	Параметры.ОбработкаЗавершена = ОбновлениеИнформационнойБазыУТ.ПерезаписатьДвиженияИзОчереди(
									"Документ.РазрешениеНаЗаменуМатериалов",
									"РегистрСведений.АналогиМатериалов",
									Параметры.Очередь,
									ДополнительныеПараметры);
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#КонецЕсли