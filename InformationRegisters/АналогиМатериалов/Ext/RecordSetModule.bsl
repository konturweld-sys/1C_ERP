#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ, Замещение)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
	РассчитатьСвязи = ПолучитьФункциональнуюОпцию("ДинамическаяСтруктураЗаказовНаПроизводство");
	
	Если РассчитатьСвязи Тогда
	
		ДополнительныеСвойства.Вставить("ОтметкаВремениАналогиМатериалов", ТекущаяУниверсальнаяДатаВМиллисекундах());
		
		Запрос = Новый Запрос;
		Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
		
		Запрос.Текст = ТекстЗапросаМатериалыИАналоги("МатериалыИАналогиПередЗаписью");
		
		Запрос.УстановитьПараметр("Регистратор", Отбор.Регистратор.Значение);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() И Выборка.Количество > 0 Тогда
			ДополнительныеСвойства.Вставить("МенеджерВременныхТаблицАналогиМатериалов", Запрос.МенеджерВременныхТаблиц);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ, Замещение)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	РассчитатьСвязи = ПолучитьФункциональнуюОпцию("ДинамическаяСтруктураЗаказовНаПроизводство");
	
	Если РассчитатьСвязи Тогда
	
		ТекущийРегистратор = Отбор.Регистратор.Значение;
	
		ТаблицаЗаданий = Неопределено;
		
		МенеджерВременныхТаблиц = Неопределено;
		
		Если ДополнительныеСвойства.Свойство("МенеджерВременныхТаблицАналогиМатериалов", МенеджерВременныхТаблиц) Тогда
			
			ТекстыЗапроса = Новый Массив;
			ТекстыЗапроса.Добавить(ТекстЗапросаМатериалыИАналоги("МатериалыИАналогиПриЗаписи"));
			
			ТекстЗапроса =
			"ВЫБРАТЬ
			|	Таблица.Номенклатура      КАК Номенклатура,
			|	Таблица.Характеристика    КАК Характеристика,
			|	Таблица.ПриоритетЗамены   КАК ПриоритетЗамены,
			|	СУММА(Таблица.Количество) КАК Количество
			|ИЗ
			|	(ВЫБРАТЬ
			|		Таблица.Номенклатура    КАК Номенклатура,
			|		Таблица.Характеристика  КАК Характеристика,
			|		Таблица.ПриоритетЗамены КАК ПриоритетЗамены,
			|		Таблица.Количество      КАК Количество
			|	ИЗ
			|		МатериалыИАналогиПриЗаписи КАК Таблица
			|
			|	ОБЪЕДИНИТЬ ВСЕ
			|
			|	ВЫБРАТЬ
			|		Таблица.Номенклатура    КАК Номенклатура,
			|		Таблица.Характеристика  КАК Характеристика,
			|		Таблица.ПриоритетЗамены КАК ПриоритетЗамены,
			|		-Таблица.Количество     КАК Количество
			|	ИЗ
			|		МатериалыИАналогиПередЗаписью КАК Таблица) КАК Таблица
			|СГРУППИРОВАТЬ ПО
			|	Таблица.Номенклатура,
			|	Таблица.Характеристика,
			|	Таблица.ПриоритетЗамены
			|ИМЕЮЩИЕ
			|	СУММА(Таблица.Количество) <> 0";
			
			ТекстыЗапроса.Добавить(ТекстЗапроса);
			
			Запрос = Новый Запрос;
			Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
			
			Запрос.Текст = СтрСоединить(ТекстыЗапроса, ОбщегоНазначения.РазделительПакетаЗапросов());
			
			Запрос.УстановитьПараметр("Регистратор", ТекущийРегистратор);
			
			Результат = Запрос.Выполнить();
			Если Не Результат.Пустой() Тогда
				
				Очередь       = "ЗаданияКРасчетуСвязейНоменклатурыПоРазрешениямНаЗамену";
				ТаблицаЗаданий = ОтложенныеЗадания.ИнициализироватьТаблицуЗаданий(Очередь)[0].Задания;
				
				ОтметкаВремениАналогиМатериалов = ДополнительныеСвойства.ОтметкаВремениАналогиМатериалов;
				
				ВременныеТаблицы = МенеджерВременныхТаблиц.Таблицы;
				
				РезультатСтарыеЗаписи = ВременныеТаблицы["МатериалыИАналогиПередЗаписью"].ПолучитьДанные();
				Если Не РезультатСтарыеЗаписи.Пустой() Тогда
					
					ВыборкаСтарыеЗаписи = РезультатСтарыеЗаписи.Выбрать();
					Пока ВыборкаСтарыеЗаписи.Следующий() Цикл
						
						СтрокаТаблицы = ТаблицаЗаданий.Добавить();
						СтрокаТаблицы.Разрешение       = ТекущийРегистратор;
						СтрокаТаблицы.Номенклатура   = ВыборкаСтарыеЗаписи.Номенклатура;
						СтрокаТаблицы.Характеристика = ВыборкаСтарыеЗаписи.Характеристика;
						СтрокаТаблицы.ОтметкаВремени = ОтметкаВремениАналогиМатериалов;
						СтрокаТаблицы.СтараяЗапись   = Истина;
						
					КонецЦикла;
					
				КонецЕсли;
				
				РезультатНовыеЗаписи = ВременныеТаблицы["МатериалыИАналогиПриЗаписи"].ПолучитьДанные();
				Если Не РезультатНовыеЗаписи.Пустой() Тогда
					
					ВыборкаНовыеЗаписи = РезультатНовыеЗаписи.Выбрать();
					Пока ВыборкаНовыеЗаписи.Следующий() Цикл
						
						СтрокаТаблицы = ТаблицаЗаданий.Добавить();
						СтрокаТаблицы.Разрешение       = ТекущийРегистратор;
						СтрокаТаблицы.Номенклатура   = ВыборкаНовыеЗаписи.Номенклатура;
						СтрокаТаблицы.Характеристика = ВыборкаНовыеЗаписи.Характеристика;
						СтрокаТаблицы.ОтметкаВремени = ОтметкаВремениАналогиМатериалов;
						
					КонецЦикла;
					
				КонецЕсли;
				
			КонецЕсли;
			
			ДополнительныеСвойства.Удалить("МенеджерВременныхТаблицАналогиМатериалов");
			
		Иначе
			
			Запрос = Новый Запрос;
			Запрос.Текст = ТекстЗапросаМатериалыИАналоги();
			
			Запрос.УстановитьПараметр("Регистратор", ТекущийРегистратор);
			
			РезультатНовыеЗаписи = Запрос.Выполнить();
			Если Не РезультатНовыеЗаписи.Пустой() Тогда
				
				Очередь       = "ЗаданияКРасчетуСвязейНоменклатурыПоРазрешениямНаЗамену";
				ТаблицаЗаданий = ОтложенныеЗадания.ИнициализироватьТаблицуЗаданий(Очередь)[0].Задания;
				
				ОтметкаВремениАналогиМатериалов = ДополнительныеСвойства.ОтметкаВремениАналогиМатериалов;
				
				ВыборкаНовыеЗаписи = РезультатНовыеЗаписи.Выбрать();
				Пока ВыборкаНовыеЗаписи.Следующий() Цикл
					
					СтрокаТаблицы = ТаблицаЗаданий.Добавить();
					СтрокаТаблицы.Разрешение       = ТекущийРегистратор;
					СтрокаТаблицы.Номенклатура   = ВыборкаНовыеЗаписи.Номенклатура;
					СтрокаТаблицы.Характеристика = ВыборкаНовыеЗаписи.Характеристика;
					СтрокаТаблицы.ОтметкаВремени = ОтметкаВремениАналогиМатериалов;
					
				КонецЦикла;
			
			КонецЕсли;
			
		КонецЕсли;
		
		ДополнительныеСвойства.Удалить("ОтметкаВремениАналогиМатериалов");
		
		Если ЗначениеЗаполнено(ТаблицаЗаданий) Тогда
			ОтложенныеЗадания.ОбработатьЗаданияОчереди(Очередь, ТаблицаЗаданий);
		КонецЕсли;	
	
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ТекстЗапросаМатериалыИАналоги(ИмяВременнойТаблицы = "")
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	Таблица.Номенклатура                                                       КАК Номенклатура,
	|	Таблица.Характеристика                                                     КАК Характеристика,
	|	Таблица.ПриоритетЗамены                                                    КАК ПриоритетЗамены,
	|	Таблица.КоличествоУпаковок * ЕСТЬNULL(&ТекстЗапросаКоэффициентУпаковки, 1) КАК Количество
	|ПОМЕСТИТЬ ИмяВременнойТаблицы
	|ИЗ
	|	РегистрСведений.АналогиМатериалов КАК Таблица
	|ГДЕ
	|	Таблица.Регистратор = &Регистратор
	|	И Таблица.РольНоменклатуры В (
	|					ЗНАЧЕНИЕ(Перечисление.РолиАналогов.Материал),
	|					ЗНАЧЕНИЕ(Перечисление.РолиАналогов.ВзаимозаменяемыйАналог))
	|	И Таблица.ИспользоватьПриАвтозаменеВЗаказах
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Таблица.Номенклатура                                                       КАК Номенклатура,
	|	Таблица.Характеристика                                                     КАК Характеристика,
	|	Таблица.ПриоритетЗамены                                                    КАК ПриоритетЗамены,
	|	Таблица.КоличествоУпаковок * ЕСТЬNULL(&ТекстЗапросаКоэффициентУпаковки, 1) КАК Количество
	|ИЗ
	|	РегистрСведений.АналогиМатериалов КАК Таблица
	|ГДЕ
	|	Таблица.Регистратор        = &Регистратор
	|	И Таблица.РольНоменклатуры = ЗНАЧЕНИЕ(Перечисление.РолиАналогов.Аналог)
	|	И Таблица.ИспользоватьПриАвтозаменеВЗаказах
	|	И НЕ ИСТИНА В
	|			(ВЫБРАТЬ ПЕРВЫЕ 1
	|				ИСТИНА
	|			ИЗ
	|				РегистрСведений.АналогиМатериалов КАК ТаблицаМатериалов
	|			ГДЕ
	|				ТаблицаМатериалов.Регистратор        = Таблица.Регистратор
	|				И ТаблицаМатериалов.Номенклатура     = Таблица.Номенклатура
	|				И ТаблицаМатериалов.Характеристика   = Таблица.Характеристика
	|				И ТаблицаМатериалов.РольНоменклатуры = ЗНАЧЕНИЕ(Перечисление.РолиАналогов.Материал))";
	
	Если ЗначениеЗаполнено(ИмяВременнойТаблицы) Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ИмяВременнойТаблицы", ИмяВременнойТаблицы);
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ПОМЕСТИТЬ ИмяВременнойТаблицы", "");
	КонецЕсли;
	
	ТекстЗапроса = СтрЗаменить(
						ТекстЗапроса,
						"&ТекстЗапросаКоэффициентУпаковки",
						Справочники.УпаковкиЕдиницыИзмерения.ТекстЗапросаКоэффициентаУпаковки(
							"Таблица.Упаковка",
							"Таблица.Номенклатура"));
	
	Возврат ТекстЗапроса;
	
КонецФункции

#КонецОбласти

#КонецЕсли