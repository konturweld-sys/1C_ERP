#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Декларации наборов.
// 
// Параметры:
//  НаборыКорректировок - Массив из СправочникСсылка.КорректировкиПрошлыхПериодовНУ - Наборы корректировок
// 
// Возвращаемое значение:
//  Соответствие из КлючИЗначение - Декларации наборов:
//   * Ключ - СправочникСсылка.КорректировкиПрошлыхПериодовНУ - 
//   * Значение - Массив из ДокументСсылка.РегламентированныйОтчет - 
Функция ДекларацииНаборов(НаборыКорректировок) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	ДекларацииНаборов = Новый Соответствие;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НаборыКорректировок", НаборыКорректировок);
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	УточненныеДекларацииПоНалогуНаПрибыль.НаборКорректировок КАК НаборКорректировок,
	|	УточненныеДекларацииПоНалогуНаПрибыль.Декларация КАК Декларация
	|ИЗ
	|	РегистрСведений.УточненныеДекларацииПоНалогуНаПрибыль КАК УточненныеДекларацииПоНалогуНаПрибыль
	|ГДЕ
	|	УточненныеДекларацииПоНалогуНаПрибыль.НаборКорректировок В (&НаборыКорректировок)
	|	И НЕ УточненныеДекларацииПоНалогуНаПрибыль.ДекларацияНеАктуальна
	|ИТОГИ
	|	КОЛИЧЕСТВО(Декларация)
	|ПО
	|	НаборКорректировок";
	
	Результат = Запрос.Выполнить();
	
	Если Результат.Пустой() Тогда
		Возврат ДекларацииНаборов;	
	КонецЕсли;
	
	ВыборкаНаборы = Результат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаНаборы.Следующий() Цикл
		
		Декларации = Новый Массив;
	
		ВыборкаДекларации = ВыборкаНаборы.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Пока ВыборкаДекларации.Следующий() Цикл
			Декларации.Добавить(ВыборкаДекларации.Декларация);
		КонецЦикла;

		ДекларацииНаборов.Вставить(ВыборкаНаборы.НаборКорректировок, Декларации);
	КонецЦикла;
	
	Возврат ДекларацииНаборов;
	
КонецФункции

// Количество деклараций к формированию.
// 
// Параметры:
//  НаборКорректировок - СправочникСсылка.КорректировкиПрошлыхПериодовНУ - Набор корректировок
// 
// Возвращаемое значение:
//  Число - Количество деклараций к формированию
Функция КоличествоДекларацийКФормированию(Знач НаборКорректировок) Экспорт
	
	КоличествоДекларацийКФормированию = 0;
	
	УстановитьПривилегированныйРежим(Истина);

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НаборКорректировок", НаборКорректировок);
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	КОЛИЧЕСТВО(УточненныеДекларацииПоНалогуНаПрибыль.Декларация) КАК Количество
	|ИЗ
	|	РегистрСведений.УточненныеДекларацииПоНалогуНаПрибыль КАК УточненныеДекларацииПоНалогуНаПрибыль
	|ГДЕ
	|	УточненныеДекларацииПоНалогуНаПрибыль.НаборКорректировок = &НаборКорректировок
	|	И НЕ УточненныеДекларацииПоНалогуНаПрибыль.ДекларацияНеАктуальна";
	
	Результат = Запрос.Выполнить();
	
	Если Результат.Пустой() Тогда
		Возврат КоличествоДекларацийКФормированию;	
	КонецЕсли;
		
	Выборка = Результат.Выбрать();
	Выборка.Следующий();
	
	КоличествоДекларацийКФормированию = Выборка.Количество;
	
	Возврат КоличествоДекларацийКФормированию;
	
КонецФункции

// Декларации набора.
// 
// Параметры:
//  НаборКорректировок - СправочникСсылка.КорректировкиПрошлыхПериодовНУ - Набор корректировок
// 
// Возвращаемое значение:
//  Массив из ДокументСсылка.РегламентированныйОтчет - Декларации набора
Функция ДекларацииНабора(Знач НаборКорректировок) Экспорт

	НаборыКорректировок = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(НаборКорректировок);
	
	ДекларацииНаборов = ДекларацииНаборов(НаборыКорректировок);		
	ДекларацииНабора = ДекларацииНаборов.Получить(НаборКорректировок);
	
	Если ДекларацииНабора = Неопределено Тогда
		ДекларацииНабора = Новый Массив;		
	КонецЕсли;
	
	Возврат ДекларацииНабора;
	
КонецФункции

// Данные деклараций набора корректировок.
// 
// Параметры:
//  НаборКорректировок - СправочникСсылка.КорректировкиПрошлыхПериодовНУ - Набор корректировок
// 
// Возвращаемое значение:
//  ТаблицаЗначений - Данные деклараций набора корректировок:
//   * НаборКорректировок - СправочникСсылка.КорректировкиПрошлыхПериодовНУ - 
//   * РегистрацияВНалоговомОргане - СправочникСсылка.РегистрацииВНалоговомОргане - 
//   * КодМестаПредставления - Строка - 
//   * ОтчетныйПериод - Дата - 
//   * Декларация - ДокументСсылка.РегламентированныйОтчет - 
//   * ДекларацияНеАктуальна - Булево - 
Функция ДанныеДекларацийНабораКорректировок(Знач НаборКорректировок) Экспорт
	
	НаборыКорректировок = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(НаборКорректировок);
	
	Возврат ДанныеДекларацийНаборовКорректировок(НаборыКорректировок);
	
КонецФункции

// Данные деклараций наборов корректировок.
// 
// Параметры:
//  НаборыКорректировок - Массив Из СправочникСсылка.КорректировкиПрошлыхПериодовНУ - Наборы корректировок
// 
// Возвращаемое значение:
//  ТаблицаЗначений - Данные деклараций набора корректировок:
//   * НаборКорректировок - СправочникСсылка.КорректировкиПрошлыхПериодовНУ - 
//   * РегистрацияВНалоговомОргане - СправочникСсылка.РегистрацииВНалоговомОргане - 
//   * КодМестаПредставления - Строка - 
//   * ОтчетныйПериод - Дата - 
//   * Декларация - ДокументСсылка.РегламентированныйОтчет - 
//   * ДекларацияНеАктуальна - Булево - 
Функция ДанныеДекларацийНаборовКорректировок(Знач НаборыКорректировок) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);

	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	УточненныеДекларацииПоНалогуНаПрибыль.НаборКорректировок,
	|	УточненныеДекларацииПоНалогуНаПрибыль.РегистрацияВНалоговомОргане,
	|	УточненныеДекларацииПоНалогуНаПрибыль.КодМестаПредставления,
	|	УточненныеДекларацииПоНалогуНаПрибыль.ОтчетныйПериод,
	|	УточненныеДекларацииПоНалогуНаПрибыль.Декларация,
	|	УточненныеДекларацииПоНалогуНаПрибыль.ДекларацияНеАктуальна
	|ИЗ
	|	РегистрСведений.УточненныеДекларацииПоНалогуНаПрибыль КАК УточненныеДекларацииПоНалогуНаПрибыль
	|ГДЕ
	|	УточненныеДекларацииПоНалогуНаПрибыль.НаборКорректировок В (&НаборыКорректировок)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ОтчетныйПериод,
	|	РегистрацияВНалоговомОргане,
	|	КодМестаПредставления";
		
	Запрос.УстановитьПараметр("НаборыКорректировок", НаборыКорректировок);
	
	ДанныеДекларацийНаборовКорректировок = Запрос.Выполнить().Выгрузить();
	
	Возврат ДанныеДекларацийНаборовКорректировок;
	
КонецФункции

// Данные деклараций наборов корректировок по отбору.
// 
// Параметры:
//  НаборыКорректировок - Массив Из СправочникСсылка.КорректировкиПрошлыхПериодовНУ - Наборы корректировок
//  Отбор - ТаблицаЗначений:
//   * РегистрацияВНалоговомОргане - СправочникСсылка.РегистрацииВНалоговомОргане - 
//   * КодМестаПредставления - Строка - 
//   * ОтчетныйПериод - Дата - 
// Возвращаемое значение:
//  ТаблицаЗначений - Данные деклараций набора корректировок:
//   * НаборКорректировок - СправочникСсылка.КорректировкиПрошлыхПериодовНУ - 
//   * РегистрацияВНалоговомОргане - СправочникСсылка.РегистрацииВНалоговомОргане - 
//   * КодМестаПредставления - Строка - 
//   * ОтчетныйПериод - Дата - 
//   * Декларация - ДокументСсылка.РегламентированныйОтчет - 
//   * ДекларацияНеАктуальна - Булево - 
Функция ДанныеДекларацийНаборовКорректировокПоОтбору(Знач НаборыКорректировок, Отбор) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НаборыКорректировок", НаборыКорректировок);
	Запрос.УстановитьПараметр("Отбор", Отбор);
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	Отбор.РегистрацияВНалоговомОргане КАК РегистрацияВНалоговомОргане,
	|	Отбор.КодМестаПредставления КАК КодМестаПредставления,
	|	Отбор.ОтчетныйПериод КАК ОтчетныйПериод
	|ПОМЕСТИТЬ ВТ_Отбор
	|ИЗ
	|	&Отбор КАК Отбор
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	УточненныеДекларацииПоНалогуНаПрибыль.НаборКорректировок КАК НаборКорректировок,
	|	УточненныеДекларацииПоНалогуНаПрибыль.РегистрацияВНалоговомОргане КАК РегистрацияВНалоговомОргане,
	|	УточненныеДекларацииПоНалогуНаПрибыль.КодМестаПредставления КАК КодМестаПредставления,
	|	УточненныеДекларацииПоНалогуНаПрибыль.ОтчетныйПериод КАК ОтчетныйПериод,
	|	УточненныеДекларацииПоНалогуНаПрибыль.Декларация КАК Декларация,
	|	УточненныеДекларацииПоНалогуНаПрибыль.ДекларацияНеАктуальна КАК ДекларацияНеАктуальна
	|ИЗ
	|	РегистрСведений.УточненныеДекларацииПоНалогуНаПрибыль КАК УточненныеДекларацииПоНалогуНаПрибыль
	|ГДЕ
	|	УточненныеДекларацииПоНалогуНаПрибыль.НаборКорректировок В (&НаборыКорректировок)
	|	И УточненныеДекларацииПоНалогуНаПрибыль.Декларация <> ЗНАЧЕНИЕ(Документ.РегламентированныйОтчет.ПустаяСсылка)
	|	И (УточненныеДекларацииПоНалогуНаПрибыль.РегистрацияВНалоговомОргане,
	|		УточненныеДекларацииПоНалогуНаПрибыль.КодМестаПредставления, УточненныеДекларацииПоНалогуНаПрибыль.ОтчетныйПериод) В
	|		(ВЫБРАТЬ
	|			ВТ_Отбор.РегистрацияВНалоговомОргане,
	|			ВТ_Отбор.КодМестаПредставления,
	|			ВТ_Отбор.ОтчетныйПериод
	|		ИЗ
	|			ВТ_Отбор)";
			
	ДанныеДекларацийНаборовКорректировок = Запрос.Выполнить().Выгрузить();
	
	Возврат ДанныеДекларацийНаборовКорректировок;
	
КонецФункции

// Параметры записи декларации.
// 
// Возвращаемое значение:
//  Структура - Параметры записи декларации:
//   * НаборКорректировок - СправочникСсылка.КорректировкиПрошлыхПериодовНУ - 
//   * РегистрацияВНалоговомОргане - СправочникСсылка.РегистрацииВНалоговомОргане - 
//   * КодМестаПредставления - Строка - 
//   * ОтчетныйПериод - Дата - 
//   * Декларация - ДокументСсылка.РегламентированныйОтчет - 
//   * ДекларацияНеАктуальна - Булево - 
Функция ПараметрыЗаписиДекларации() Экспорт
	
	ПараметрыЗаписиДекларации = Новый Структура;
	ПараметрыЗаписиДекларации.Вставить("НаборКорректировок", Справочники.КорректировкиПрошлыхПериодовНУ.ПустаяСсылка());
	ПараметрыЗаписиДекларации.Вставить("РегистрацияВНалоговомОргане", Справочники.РегистрацииВНалоговомОргане.ПустаяСсылка());
	ПараметрыЗаписиДекларации.Вставить("КодМестаПредставления", "");
	ПараметрыЗаписиДекларации.Вставить("ОтчетныйПериод", Дата(1, 1, 1));
	ПараметрыЗаписиДекларации.Вставить("Декларация", Документы.РегламентированныйОтчет.ПустаяСсылка());
	ПараметрыЗаписиДекларации.Вставить("ДекларацияНеАктуальна", Ложь);

	Возврат ПараметрыЗаписиДекларации;
		
КонецФункции

// Записать данные декларации по набору.
// 
// Параметры:
//  ПараметрыЗаписиДекларации - Структура - См. ПараметрыЗаписиДекларации()
Процедура ЗаписатьДанныеДекларацииПоНабору(ПараметрыЗаписиДекларации) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
		
	НачатьТранзакцию();
		
	Попытка
					
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.УточненныеДекларацииПоНалогуНаПрибыль");
		ЭлементБлокировки.УстановитьЗначение("НаборКорректировок", ПараметрыЗаписиДекларации.НаборКорректировок);
		ЭлементБлокировки.УстановитьЗначение("РегистрацияВНалоговомОргане", ПараметрыЗаписиДекларации.РегистрацияВНалоговомОргане);
		ЭлементБлокировки.УстановитьЗначение("КодМестаПредставления", ПараметрыЗаписиДекларации.КодМестаПредставления);
		ЭлементБлокировки.УстановитьЗначение("ОтчетныйПериод", ПараметрыЗаписиДекларации.ОтчетныйПериод);
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		Блокировка.Заблокировать();	
		
		Декларация = УточненнаяДекларация(ПараметрыЗаписиДекларации);
			
		Если НЕ ЗначениеЗаполнено(Декларация) Тогда
			ЗаписатьДекларацию(ПараметрыЗаписиДекларации);
		КонецЕсли;
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
					
		КраткоеПредставлениеОшибки = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		
		ТекстОшибки = СтрШаблон(
			НСтр("ru = 'Не удалось записать декларацию по набору корректировок по причине:
				|%1';
				|en = 'Cannot save the declaration based on the adjustment set. Reason:
				|%1'"),
			КраткоеПредставлениеОшибки);
		
		ВызватьИсключение ТекстОшибки;
	КонецПопытки;
		
КонецПроцедуры

// Очистить декларацию по набору.
// 
// Параметры:
//  ПараметрыЗаписиДекларации - Структура - См. ПараметрыЗаписиДекларации()
Процедура ОчиститьДекларациюПоНабору(ПараметрыЗаписиДекларации) Экспорт
		
	УстановитьПривилегированныйРежим(Истина);

	НачатьТранзакцию();
	
	Попытка
		
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.УточненныеДекларацииПоНалогуНаПрибыль");
		ЭлементБлокировки.УстановитьЗначение("НаборКорректировок", ПараметрыЗаписиДекларации.НаборКорректировок);
		ЭлементБлокировки.УстановитьЗначение("РегистрацияВНалоговомОргане", ПараметрыЗаписиДекларации.РегистрацияВНалоговомОргане);
		ЭлементБлокировки.УстановитьЗначение("КодМестаПредставления", ПараметрыЗаписиДекларации.КодМестаПредставления);
		ЭлементБлокировки.УстановитьЗначение("ОтчетныйПериод", ПараметрыЗаписиДекларации.ОтчетныйПериод);
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		Блокировка.Заблокировать();	
		
		НаборЗаписей = РегистрыСведений.УточненныеДекларацииПоНалогуНаПрибыль.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.НаборКорректировок.Установить(ПараметрыЗаписиДекларации.НаборКорректировок);
		НаборЗаписей.Отбор.РегистрацияВНалоговомОргане.Установить(ПараметрыЗаписиДекларации.РегистрацияВНалоговомОргане);
		НаборЗаписей.Отбор.КодМестаПредставления.Установить(ПараметрыЗаписиДекларации.КодМестаПредставления);
		НаборЗаписей.Отбор.ОтчетныйПериод.Установить(ПараметрыЗаписиДекларации.ОтчетныйПериод);
		
		НаборЗаписей.Прочитать();
		
		Если НаборЗаписей.Количество() = 0 Тогда
			ЗафиксироватьТранзакцию();
			Возврат;
		КонецЕсли;
		
		Запись = НаборЗаписей[0];
		
		Если Запись.ДекларацияНеАктуальна Тогда
			НаборЗаписей.Очистить();
		Иначе
			Запись.Декларация = Документы.РегламентированныйОтчет.ПустаяСсылка();
		КонецЕсли;
		
		НаборЗаписей.Записать();
			
		ЗафиксироватьТранзакцию();
		
	Исключение
		
		ОтменитьТранзакцию();
				
		КраткоеПредставлениеОшибки = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		
		ТекстОшибки = СтрШаблон(
			НСтр("ru = 'Не удалось записать данные по уточненной декларации по причине:
				|%1';
				|en = 'Cannot save data on the updated declaration. Reason:
				|%1'"),
			КраткоеПредставлениеОшибки);
			
		ВызватьИсключение ТекстОшибки;
		
	КонецПопытки;
	
КонецПроцедуры

// Отмена данных по набору корректировок.
// Если декларация по набору корректировок уже сформирована,
// запись оставляем и устанавливаем ДекларарияНеАктуральна = Истина.
// 
// Параметры:
//  НаборКорректировок - СправочникСсылка.КорректировкиПрошлыхПериодовНУ - Набор корректировок
//	Отказ - Булево
Процедура ОтменаДанныхПоНаборуКорректировок(НаборКорректировок, Отказ) Экспорт
	
	Попытка
		
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.УточненныеДекларацииПоНалогуНаПрибыль");
		ЭлементБлокировки.УстановитьЗначение("НаборКорректировок", НаборКорректировок);
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		Блокировка.Заблокировать();
		
		НаборЗаписей = РегистрыСведений.УточненныеДекларацииПоНалогуНаПрибыль.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.НаборКорректировок.Установить(НаборКорректировок);
		НаборЗаписей.Прочитать();
		МассивСтрокКУдалению = Новый Массив();
		Для Каждого СтрокаДанных Из НаборЗаписей Цикл
			Если ЗначениеЗаполнено(СтрокаДанных.Декларация) Тогда
				СтрокаДанных.ДекларацияНеАктуальна = Истина;
			Иначе
				МассивСтрокКУдалению.Добавить(СтрокаДанных);
			КонецЕсли;
		КонецЦикла;
		Для Каждого Строка Из МассивСтрокКУдалению Цикл
			НаборЗаписей.Удалить(Строка);
		КонецЦикла;
		НаборЗаписей.Записать();
		
	Исключение
					
		КраткоеПредставлениеОшибки = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		
		ТекстОшибки = СтрШаблон(
			НСтр("ru = 'Не удалось отменить данные по набору корректировок по причине:
				|%1';
				|en = 'Cannot cancel data on the adjustment set. Reason:
				|%1'"),
			КраткоеПредставлениеОшибки);
			
		Отказ = Истина;
		
		ВызватьИсключение ТекстОшибки;
		
	КонецПопытки;
	
КонецПроцедуры

// Отмена данных по набору корректировок.
// Если декларация по набору корректировок уже сформирована,
// запись оставляем и устанавливаем ДекларарияНеАктуральна = Истина.
// 
// Параметры:
//  ТаблицаДанных - см. Документы.РегламентнаяОперация.ТаблицаПроводокНовый
//  СтруктураШапкиДокумента - см. РасчетНалогаНаПрибыль.НовыйКонтекстРасчета
//  Отказ - Булево
Процедура ЗаписьДанныхПерерасчета(ТаблицаДанных, СтруктураШапкиДокумента, Отказ) Экспорт
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("ТаблицаДанных", ТаблицаДанных);
	Запрос.УстановитьПараметр("Организация", СтруктураШапкиДокумента.Организация);
	Запрос.УстановитьПараметр("НаборКорректировок", СтруктураШапкиДокумента.НаборКорректировок);
	Запрос.УстановитьПараметр("ОсновнаяРегистрацияВНалоговомОргане", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтруктураШапкиДокумента.Организация, "РегистрацияВНалоговомОргане"));
	
	Попытка 
		
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.УточненныеДекларацииПоНалогуНаПрибыль");
		ЭлементБлокировки.УстановитьЗначение("НаборКорректировок", СтруктураШапкиДокумента.НаборКорректировок);
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		Блокировка.Заблокировать();
		
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ТаблицаДанных.ПериодРасчета КАК Период,
		|	ТаблицаДанных.Организация КАК Организация,
		|	ТаблицаДанных.РегистрацияВНалоговомОргане КАК РегистрацияВНалоговомОргане,
		|	ТаблицаДанных.ВариантНалогообложенияПрибыли КАК ВариантНалогообложенияПрибыли
		|ПОМЕСТИТЬ ВТ_Данные
		|ИЗ
		|	&ТаблицаДанных КАК ТаблицаДанных
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Период
		|;
		|////////////////////////////////////////////////////////////////////////////////
		|	
		|ВЫБРАТЬ
		|	ПериодыГоловнойОрганизации.РегистрацияВНалоговомОргане КАК РегистрацияВНалоговомОргане,
		|	ПериодыГоловнойОрганизации.ВариантНалогообложенияПрибыли КАК ВариантНалогообложенияПрибыли,
		|	НастройкиУчетаНалогаНаПрибыль.Организация КАК Организация,
		|	ПериодыГоловнойОрганизации.Период КАК ПериодРасчета,
		|	МАКСИМУМ(НастройкиУчетаНалогаНаПрибыль.Период) КАК Период
		|ПОМЕСТИТЬ ТаблицаНастроекВспомогательная
		|ИЗ
		|	ВТ_Данные КАК ПериодыГоловнойОрганизации
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НастройкиУчетаНалогаНаПрибыль КАК НастройкиУчетаНалогаНаПрибыль
		|		ПО НастройкиУчетаНалогаНаПрибыль.Организация = &Организация
		|			И ПериодыГоловнойОрганизации.Период >= НастройкиУчетаНалогаНаПрибыль.Период
		|
		|СГРУППИРОВАТЬ ПО
		|	ПериодыГоловнойОрганизации.РегистрацияВНалоговомОргане,
		|	ПериодыГоловнойОрганизации.ВариантНалогообложенияПрибыли,
		|	НастройкиУчетаНалогаНаПрибыль.Организация,
		|	ПериодыГоловнойОрганизации.Период
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Организация,
		|	Период,
		|	РегистрацияВНалоговомОргане,
		|	ВариантНалогообложенияПрибыли
		|;
		|////////////////////////////////////////////////////////////////////////////////
		|
		|ВЫБРАТЬ
		|	ТаблицаНастроек.РегистрацияВНалоговомОргане КАК РегистрацияВНалоговомОргане,
		|	ТаблицаНастроек.ВариантНалогообложенияПрибыли КАК ВариантНалогообложенияПрибыли,
		|	ТаблицаНастроек.Организация КАК Организация,
		|	ВЫБОР 
		|		КОГДА ЕСТЬNULL(НастройкиУчетаНалогаНаПрибыль.ПодаватьУточненныеДекларацииТолькоПоНалоговомуПериоду, ЛОЖЬ)
		|			ТОГДА НАЧАЛОПЕРИОДА(КОНЕЦПЕРИОДА(ТаблицаНастроек.ПериодРасчета, ГОД), ДЕНЬ)
		|		КОГДА НастройкиУчетаНалогаНаПрибыль.ПорядокУплатыАвансовПоНалогуНаПрибыль = ЗНАЧЕНИЕ(Перечисление.ПорядокУплатыАвансовПоНалогуНаПрибыль.ПоФактическойПрибыли)
		|			ТОГДА НАЧАЛОПЕРИОДА(КОНЕЦПЕРИОДА(ТаблицаНастроек.ПериодРасчета, МЕСЯЦ), ДЕНЬ)
		|		ИНАЧЕ НАЧАЛОПЕРИОДА(КОНЕЦПЕРИОДА(ТаблицаНастроек.ПериодРасчета, КВАРТАЛ), ДЕНЬ)	
		|	КОНЕЦ КАК ОтчетныйПериод
		|ПОМЕСТИТЬ ТаблицаНастроек
		|ИЗ
		|	ТаблицаНастроекВспомогательная КАК ТаблицаНастроек
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НастройкиУчетаНалогаНаПрибыль КАК НастройкиУчетаНалогаНаПрибыль
		|		ПО ТаблицаНастроек.Организация = НастройкиУчетаНалогаНаПрибыль.Организация
		|			И ТаблицаНастроек.Период = НастройкиУчетаНалогаНаПрибыль.Период
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Организация,
		|	РегистрацияВНалоговомОргане,
		|	ВариантНалогообложенияПрибыли
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВложенныйЗапрос.НаборКорректировок КАК НаборКорректировок,
		|	ВложенныйЗапрос.РегистрацияВНалоговомОргане КАК РегистрацияВНалоговомОргане,
		|	ВложенныйЗапрос.ОтчетныйПериод КАК ОтчетныйПериод,
		|	ВложенныйЗапрос.КодМестаПредставления КАК КодМестаПредставления,
		|	МАКСИМУМ(ВложенныйЗапрос.Декларация) КАК Декларация,
		|	МАКСИМУМ(ВложенныйЗапрос.ЗаписьПерерасчета) КАК ЗаписьПерерасчета
		|ИЗ
		|(ВЫБРАТЬ
		|	&НаборКорректировок КАК НаборКорректировок,
		|	ТаблицаНастроек.РегистрацияВНалоговомОргане КАК РегистрацияВНалоговомОргане,
		|	ТаблицаНастроек.ОтчетныйПериод КАК ОтчетныйПериод,
		|	ВЫБОР
		|		КОГДА ТаблицаНастроек.РегистрацияВНалоговомОргане <> &ОсновнаяРегистрацияВНалоговомОргане
		|				И РегистрацииВНалоговомОргане.ДатаСнятияСУчета <> ДАТАВРЕМЯ(1, 1, 1)
		|				И РегистрацииВНалоговомОргане.ДатаСнятияСУчета <= ТаблицаНастроек.ОтчетныйПериод
		|			ТОГДА ""223""
		|		КОГДА ТаблицаНастроек.РегистрацияВНалоговомОргане <> &ОсновнаяРегистрацияВНалоговомОргане
		|			ТОГДА ""220""
		|		КОГДА Организации.КрупнейшийНалогоплательщик
		|				И ЕСТЬNULL(ВариантыНалогообложенияПрибыли.КодМестаПредставления, ""213"") = ""214""
		|					ТОГДА ""213""
		|		КОГДА Организации.КрупнейшийНалогоплательщик
		|			ТОГДА ЕСТЬNULL(ВариантыНалогообложенияПрибыли.КодМестаПредставления, ""213"")
		|		ИНАЧЕ ЕСТЬNULL(ВариантыНалогообложенияПрибыли.КодМестаПредставления, ""214"")
		|	КОНЕЦ КАК КодМестаПредставления,
		|	НЕОПРЕДЕЛЕНО КАК Декларация,
		|	ИСТИНА КАК ЗаписьПерерасчета
		|ИЗ
		|	ТаблицаНастроек КАК ТаблицаНастроек
		|	ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Организации КАК Организации
		|		ПО ТаблицаНастроек.Организация = Организации.Ссылка
		|	ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВариантыНалогообложенияПрибыли КАК ВариантыНалогообложенияПрибыли
		|		ПО ТаблицаНастроек.ВариантНалогообложенияПрибыли = ВариантыНалогообложенияПрибыли.Ссылка
		|	ЛЕВОЕ СОЕДИНЕНИЕ Справочник.РегистрацииВНалоговомОргане КАК РегистрацииВНалоговомОргане
		|		ПО ТаблицаНастроек.РегистрацияВНалоговомОргане = РегистрацииВНалоговомОргане.Ссылка
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	УточненныеДекларацииПоНалогуНаПрибыль.НаборКорректировок КАК НаборКорректировок,
		|	УточненныеДекларацииПоНалогуНаПрибыль.РегистрацияВНалоговомОргане КАК РегистрацияВНалоговомОргане,
		|	УточненныеДекларацииПоНалогуНаПрибыль.ОтчетныйПериод КАК ОтчетныйПериод,
		|	УточненныеДекларацииПоНалогуНаПрибыль.КодМестаПредставления КАК КодМестаПредставления,
		|	УточненныеДекларацииПоНалогуНаПрибыль.Декларация КАК Декларация,
		|	ЛОЖЬ КАК ЗаписьПерерасчета
		|ИЗ
		|	РегистрСведений.УточненныеДекларацииПоНалогуНаПрибыль КАК УточненныеДекларацииПоНалогуНаПрибыль
		|ГДЕ
		|	УточненныеДекларацииПоНалогуНаПрибыль.НаборКорректировок = &НаборКорректировок
		|	И НЕ УточненныеДекларацииПоНалогуНаПрибыль.Декларация = ЗНАЧЕНИЕ(Документ.РегламентированныйОтчет.ПустаяСсылка)
		|) КАК ВложенныйЗапрос
		|
		|СГРУППИРОВАТЬ ПО
		|	ВложенныйЗапрос.НаборКорректировок,
		|	ВложенныйЗапрос.РегистрацияВНалоговомОргане,
		|	ВложенныйЗапрос.ОтчетныйПериод,
		|	ВложенныйЗапрос.КодМестаПредставления
		|";
		
		РезультатЗапроса = Запрос.Выполнить().Выбрать();
		
		НаборЗаписей = РегистрыСведений.УточненныеДекларацииПоНалогуНаПрибыль.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.НаборКорректировок.Установить(СтруктураШапкиДокумента.НаборКорректировок);
		Пока РезультатЗапроса.Следующий() Цикл
			Если РезультатЗапроса.ОтчетныйПериод < НачалоДня(ТекущаяДатаСеанса()) Тогда
				ЗаписьРегистра = НаборЗаписей.Добавить();
				ЗаполнитьЗначенияСвойств(ЗаписьРегистра, РезультатЗапроса);
				Если ЗначениеЗаполнено(ЗаписьРегистра.Декларация) И Не РезультатЗапроса.ЗаписьПерерасчета Тогда
					ЗаписьРегистра.ДекларацияНеАктуальна = Истина;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		НаборЗаписей.Записать();
		
	Исключение
					
		КраткоеПредставлениеОшибки = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		
		ТекстОшибки = СтрШаблон(
			НСтр("ru = 'Не удалось записать данные по набору корректировок по причине:
				|%1';
				|en = 'Cannot save data on the adjustment set. Reason:
				|%1'"),
			КраткоеПредставлениеОшибки);
			
		Отказ = Истина;
		
		ВызватьИсключение ТекстОшибки;
		
	КонецПопытки;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ЗаписатьДекларацию(ПараметрыЗаписиДекларации) Экспорт

	Попытка
		
		УстановитьПривилегированныйРежим(Истина);
	
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.УточненныеДекларацииПоНалогуНаПрибыль");
		ЭлементБлокировки.УстановитьЗначение("НаборКорректировок", ПараметрыЗаписиДекларации.НаборКорректировок);
		ЭлементБлокировки.УстановитьЗначение("РегистрацияВНалоговомОргане", ПараметрыЗаписиДекларации.РегистрацияВНалоговомОргане);
		ЭлементБлокировки.УстановитьЗначение("КодМестаПредставления", ПараметрыЗаписиДекларации.КодМестаПредставления);
		ЭлементБлокировки.УстановитьЗначение("ОтчетныйПериод", ПараметрыЗаписиДекларации.ОтчетныйПериод);
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		Блокировка.Заблокировать();	
		
		НаборЗаписей = РегистрыСведений.УточненныеДекларацииПоНалогуНаПрибыль.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.НаборКорректировок.Установить(ПараметрыЗаписиДекларации.НаборКорректировок);
		НаборЗаписей.Отбор.РегистрацияВНалоговомОргане.Установить(ПараметрыЗаписиДекларации.РегистрацияВНалоговомОргане);
		НаборЗаписей.Отбор.КодМестаПредставления.Установить(ПараметрыЗаписиДекларации.КодМестаПредставления);
		НаборЗаписей.Отбор.ОтчетныйПериод.Установить(ПараметрыЗаписиДекларации.ОтчетныйПериод);
		
		НаборЗаписей.Прочитать();
		
		Если НаборЗаписей.Количество() = 0 Тогда
			Запись = НаборЗаписей.Добавить();
			ЗаполнитьЗначенияСвойств(Запись, ПараметрыЗаписиДекларации);
			Запись.ДекларацияНеАктуальна = Истина;
		Иначе
			Запись = НаборЗаписей[0];
			Если ЗначениеЗаполнено(Запись.Декларация) Тогда
				Возврат;
			КонецЕсли;
		КонецЕсли;
		
		Запись.Декларация = ПараметрыЗаписиДекларации.Декларация;
		
		НаборЗаписей.Записать();
		
	Исключение
					
		КраткоеПредставлениеОшибки = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		
		ТекстОшибки = СтрШаблон(
			НСтр("ru = 'Не удалось записать данные по уточненной декларации по причине:
				|%1';
				|en = 'Cannot save data on the updated declaration. Reason:
				|%1'"),
			КраткоеПредставлениеОшибки);
			
		ВызватьИсключение ТекстОшибки;
		
	КонецПопытки;
	
КонецПроцедуры

// Уточненная декларация.
// 
// Параметры:
//  ПараметрыЗаписиДекларации - Структура - См. ПараметрыЗаписиДекларации()
// 
// Возвращаемое значение:
//  ДокументСсылка.РегламентированныйОтчет - Уточненная декларация
Функция УточненнаяДекларация(ПараметрыЗаписиДекларации) Экспорт
	
	УточненнаяДекларация = Документы.РегламентированныйОтчет.ПустаяСсылка();
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НаборКорректировок", ПараметрыЗаписиДекларации.НаборКорректировок);
	Запрос.УстановитьПараметр("РегистрацияВНалоговомОргане", ПараметрыЗаписиДекларации.РегистрацияВНалоговомОргане);
	Запрос.УстановитьПараметр("КодМестаПредставления", ПараметрыЗаписиДекларации.КодМестаПредставления);
	Запрос.УстановитьПараметр("ОтчетныйПериод", ПараметрыЗаписиДекларации.ОтчетныйПериод);
	
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	УточненныеДекларацииПоНалогуНаПрибыль.Декларация
	|ИЗ
	|	РегистрСведений.УточненныеДекларацииПоНалогуНаПрибыль КАК УточненныеДекларацииПоНалогуНаПрибыль
	|ГДЕ
	|	УточненныеДекларацииПоНалогуНаПрибыль.НаборКорректировок = &НаборКорректировок
	|	И УточненныеДекларацииПоНалогуНаПрибыль.РегистрацияВНалоговомОргане = &РегистрацияВНалоговомОргане
	|	И УточненныеДекларацииПоНалогуНаПрибыль.КодМестаПредставления = &КодМестаПредставления
	|	И УточненныеДекларацииПоНалогуНаПрибыль.ОтчетныйПериод = &ОтчетныйПериод";
	
	Результат = Запрос.Выполнить();
	
	Если Результат.Пустой() Тогда
		Возврат УточненнаяДекларация;
	КонецЕсли;
	
	Выборка = Результат.Выбрать();
	Выборка.Следующий();
	
	УточненнаяДекларация = Выборка.Декларация;
	
	Возврат УточненнаяДекларация;
	
КонецФункции

// Данные деклараций по декларации.
// 
// Параметры:
//  Декларация - ДокументСсылка.РегламентированныйОтчет - 
// 
// Возвращаемое значение:
//  ТаблицаЗначений - Данные деклараций по декларации:
//   * НаборКорректировок - СправочникСсылка.КорректировкиПрошлыхПериодовНУ - 
//   * РегистрацияВНалоговомОргане - СправочникСсылка.РегистрацииВНалоговомОргане - 
//   * КодМестаПредставления - Строка - 
//   * ОтчетныйПериод - Дата - 
Функция ДанныеДекларацийПоДекларации(Знач Декларация) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Декларация", Декларация);
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	УточненныеДекларацииПоНалогуНаПрибыль.НаборКорректировок КАК НаборКорректировок,
	|	УточненныеДекларацииПоНалогуНаПрибыль.РегистрацияВНалоговомОргане КАК РегистрацияВНалоговомОргане,
	|	УточненныеДекларацииПоНалогуНаПрибыль.КодМестаПредставления КАК КодМестаПредставления,
	|	УточненныеДекларацииПоНалогуНаПрибыль.ОтчетныйПериод КАК ОтчетныйПериод
	|ИЗ
	|	РегистрСведений.УточненныеДекларацииПоНалогуНаПрибыль КАК УточненныеДекларацииПоНалогуНаПрибыль
	|ГДЕ
	|	УточненныеДекларацииПоНалогуНаПрибыль.Декларация = &Декларация";
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

#КонецОбласти

#КонецЕсли
