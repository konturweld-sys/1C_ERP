#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ДекларацияНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
		
	СтандартнаяОбработка = Ложь;
	
	ИсточникОтчета = "РегламентированныйОтчетПрибыль";

	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ИсточникОтчета", ИсточникОтчета);
	ПараметрыФормы.Вставить("Организация", ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ОрганизацияНабора(Запись.НаборКорректировок)));
	ПараметрыФормы.Вставить("ОтборКодИФНС", Ложь);
	ПараметрыФормы.Вставить("ОтборПериод", Ложь);
	
	ФормаВыбораОтчета = РегламентированнаяОтчетностьКлиент.ПолучитьОбщуюФормуПоИмени("ФормаВыбораОтчета", ПараметрыФормы, ЭтотОБъект);
				
	ОписаниеОповещения = Новый ОписаниеОповещения("ДекларацияНачалоВыбораЗавершение", ЭтотОбъект);
	
	ФормаВыбораОтчета.ОписаниеОповещенияОЗакрытии = ОписаниеОповещения;
	ФормаВыбораОтчета.РежимОткрытияОкна = РежимОткрытияОкнаФормы.БлокироватьОкноВладельца;
	ФормаВыбораОтчета.Открыть();  

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ДекларацияНачалоВыбораЗавершение(РезультатВыбора, ДополнительныеПараметры) Экспорт
	
	Если РезультатВыбора <> Истина И ЗначениеЗаполнено(РезультатВыбора) Тогда
		Запись.Декларация = РезультатВыбора;
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ОрганизацияНабора(Знач Набор)
	
	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Набор, "Владелец");
	
КонецФункции

#КонецОбласти
