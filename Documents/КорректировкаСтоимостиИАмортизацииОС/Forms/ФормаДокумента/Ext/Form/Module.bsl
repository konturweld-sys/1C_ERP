КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПоУчету(Команда)
	
	Если Элементы.ОС.ВыделенныеСтроки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	СписокКнопок = Новый СписокЗначений;
	СписокКнопок.Добавить(КодВозвратаДиалога.Да, НСтр("ru = 'Заполнить';
														|en = 'Fill'"));
	СписокКнопок.Добавить(КодВозвратаДиалога.Нет);
	
	Если Объект.ВидИмущества = ПредопределенноеЗначение("Перечисление.ВидыИмущества.Арендованное") Тогда
		
		ТекстВопроса = НСтр("ru = 'Заполнить залоговую стоимость по данным учета в выбранных строках?';
							|en = 'Fill in collateral value according to accounting data in the selected lines?'");
				
	ИначеЕсли (Объект.КорректировкаСтоимости ИЛИ Объект.КорректировкаПервоначальнойСтоимости)
		И Объект.КорректировкаАмортизации
		И НЕ Объект.КорректировкаАмортизацииЗаПериод Тогда
		
		ТекстВопроса = НСтр("ru = 'Заполнить стоимость и амортизацию по данным учета в выбранных строках?';
							|en = 'Fill in the cost and depreciation according to accounting data in the selected lines?'");
				
	ИначеЕсли Объект.КорректировкаСтоимости ИЛИ Объект.КорректировкаПервоначальнойСтоимости Тогда
		
		ТекстВопроса = НСтр("ru = 'Заполнить стоимость по данным учета в выбранных строках?';
							|en = 'Do you want to fill the cost by accounting data in the selected lines?'");
				
	ИначеЕсли Объект.КорректировкаАмортизации
		И НЕ Объект.КорректировкаАмортизацииЗаПериод Тогда
		
		ТекстВопроса = НСтр("ru = 'Заполнить амортизацию по данным учета в выбранных строках?';
							|en = 'Do you want to fill the depreciation by accounting data in the selected lines?'");
		
	Иначе
		
		ТекстВопроса = НСтр("ru = 'Заполнить по данным учета в выбранных строках?';
							|en = 'Do you want to fill it in by accounting data in the selected lines?'");
		
	КонецЕсли;
			
	ОписаниеОповещения = Новый ОписаниеОповещения("ЗаполнитьПоУчетуЗавершение", ЭтотОбъект);
	ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, СписокКнопок,, КодВозвратаДиалога.Да);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьАмортизациюНаОснованииПараметровУчета(Команда)
	
	Если Элементы.ОС.ВыделенныеСтроки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	АмортизацияЗаполнена = Ложь;
	
	Для Каждого Элемент Из Элементы.ОС.ВыделенныеСтроки Цикл
		
		ДанныеСтроки = Элементы.ОС.ДанныеСтроки(Элемент);
		
		Если ДанныеСтроки.АмортизацияБУ <> 0
				И (Элементы.ОСАмортизацияБУ.Видимость
					ИЛИ Элементы.ОСАмортизацияБУ_Отдельно.Видимость)
			ИЛИ ДанныеСтроки.АмортизацияНУ <> 0
				И Элементы.ОСАмортизацияНУ.Видимость
			ИЛИ ДанныеСтроки.АмортизацияУУ <> 0
				И (Элементы.ОСАмортизацияУУ.Видимость
					ИЛИ Элементы.ОСАмортизацияУУ_Отдельно.Видимость)
			ИЛИ ДанныеСтроки.АмортизацияЦФ <> 0 
				И Элементы.ОСАмортизацияЦФ.Видимость Тогда
				
			АмортизацияЗаполнена = Истина;
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Если АмортизацияЗаполнена Тогда
		
		СписокКнопок = Новый СписокЗначений;
		СписокКнопок.Добавить(КодВозвратаДиалога.Да, НСтр("ru = 'Заполнить';
															|en = 'Fill'"));
		СписокКнопок.Добавить(КодВозвратаДиалога.Нет);
		
		ТекстВопроса = НСтр("ru = 'Заполнить амортизацию в выбранных строках на основании расчета по параметрам учета?';
							|en = 'Fill in depreciation in the selected lines based on the calculation by accounting parameters?'");
					
		ОписаниеОповещения = Новый ОписаниеОповещения("ЗаполнитьАмортизациюНаОснованииПараметровУчетаЗавершение", ЭтотОбъект);
		ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, СписокКнопок,, КодВозвратаДиалога.Да);
		
	Иначе
		ЗаполнитьАмортизациюНаОснованииПараметровУчетаЗавершение(КодВозвратаДиалога.Да, Неопределено);
	КонецЕсли;
	
КонецПроцедуры

