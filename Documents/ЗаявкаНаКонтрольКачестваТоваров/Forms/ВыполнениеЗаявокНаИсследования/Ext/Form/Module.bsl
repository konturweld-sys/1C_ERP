&НаСервереБезКонтекста
Процедура СписокПриПолученииДанныхНаСервере(ИмяЭлемента, Настройки, Строки)
	
	//++ НЕ УТКА
	Шаблон = НСтр("ru = '%1 из %2';
					|en = '%1 out of %2'");
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ИсследованиеКачестваТоваров.ЗаявкаНаКонтроль КАК Ссылка,
	|	КОЛИЧЕСТВО(ИсследованиеКачестваТоваров.Ссылка) КАК КоличествоВсего,
	|	СУММА(ВЫБОР
	|		КОГДА ИсследованиеКачестваТоваров.Завершено = ИСТИНА
	|			ТОГДА 1
	|		ИНАЧЕ 0
	|	КОНЕЦ) КАК КоличествоЗавершенных
	|ИЗ
	|	Документ.ИсследованиеКачестваТоваров КАК ИсследованиеКачестваТоваров
	|ГДЕ
	|	ИсследованиеКачестваТоваров.ЗаявкаНаКонтроль В (&ЗаявкиНаКонтроль)
	|	И ИсследованиеКачестваТоваров.ПометкаУдаления = ЛОЖЬ
	|	И ИсследованиеКачестваТоваров.Проведен = ИСТИНА
	|СГРУППИРОВАТЬ ПО
	|	ИсследованиеКачестваТоваров.ЗаявкаНаКонтроль";
	
	Запрос.УстановитьПараметр("ЗаявкиНаКонтроль", Строки.ПолучитьКлючи());
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		СтрокаСписка = Строки[Выборка.Ссылка];
		Представление = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Шаблон, Выборка.КоличествоЗавершенных, Выборка.КоличествоВсего);
		СтрокаСписка.Данные["ИсследованийВыполнено"] = Представление;
	КонецЦикла;
	//-- НЕ УТКА
	Возврат;

КонецПроцедуры

&НаКлиенте
Процедура ИсследованийВыполненоНажатие(Элемент, СтандартнаяОбработка)
	
	//++ НЕ УТКА
	СтандартнаяОбработка = Ложь;
	
	ТекущиеДанные = Элементы.Список.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Ссылка", ТекущиеДанные.Ссылка);
	ОткрытьФорму("Документ.ИсследованиеКачестваТоваров.Форма.ФормаСостояниеИсследования", ПараметрыФормы, ЭтотОбъект);
	//-- НЕ УТКА
	
	Возврат;
	
КонецПроцедуры

&НаКлиенте
Процедура СписокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	//++ НЕ УТКА
	СтандартнаяОбработка = Ложь;
	
	ТекущиеДанные = Элементы.Список.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Поле = Элементы.ИсследованийВыполнено Тогда
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("ЗаявкаНаКонтроль", ТекущиеДанные.Ссылка);
		ОткрытьФорму("Документ.ИсследованиеКачестваТоваров.Форма.ФормаСостояниеИсследования", ПараметрыФормы,
			ЭтотОбъект);
	Иначе
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("Ключ", ТекущиеДанные.Ссылка);
		ОткрытьФорму("Документ.ЗаявкаНаКонтрольКачестваТоваров.Форма.ФормаДокумента", ПараметрыФормы,
			ЭтотОбъект);
	КонецЕсли;
	//-- НЕ УТКА
	
	Возврат;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура НазначитьИсследования(Команда)
	
	//++ НЕ УТКА
	ОчиститьСообщения();
	ТекущиеДанные = Элементы.Список.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Не выбраны строки, команда не может быть выполнена.';
										|en = 'No lines are selected, cannot run the command.'"));
		Возврат;
	КонецЕсли;
	
	ЗаявкаПроведена = ЗаявкаПроведена(ТекущиеДанные.Ссылка);
	Если Не ЗаявкаПроведена Тогда
		ТекстОшибки = НСтр("ru = 'Невозможно назначить исследование для непроведенного документа.';
							|en = 'Cannot assign research for an unposted document.'");
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстОшибки, , , ,);
		Возврат;
	Иначе
		ОткрытьНазначениеИсследований(ТекущиеДанные.Ссылка);
	КонецЕсли;
	//-- НЕ УТКА
	
	Возврат;
	
КонецПроцедуры

&НаКлиенте
Процедура ОформитьАктКонтроля(Команда)
	
	//++ НЕ УТКА
	ОчиститьСообщения();
	ТекущиеДанные = Элементы.Список.ТекущиеДанные;

	Если ТекущиеДанные = Неопределено Тогда
		ПоказатьПредупреждение( , НСтр("ru = 'Не выбраны строки, команда не может быть выполнена.';
										|en = 'No lines are selected, cannot run the command.'"));
		Возврат;
	КонецЕсли;

	ЗаявкаПроведена = ЗаявкаПроведена(ТекущиеДанные.Ссылка);
	Если Не ЗаявкаПроведена Тогда
		ТекстОшибки = НСтр("ru = 'Невозможно оформить акт контроля для непроведенного документа.';
							|en = 'Cannot issue a control certificate for an unposted document.'");
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстОшибки, , , , );
		Возврат;
	Иначе
		ПараметрыФормы = ПолучитьПараметрыФормыАктаКонтроляКачества();

		Если ПараметрыФормы <> Неопределено Тогда
			ОткрытьФорму("Документ.АктКонтроляКачестваТоваров.Форма.ФормаДокумента", ПараметрыФормы);
		КонецЕсли;
	КонецЕсли;
	//-- НЕ УТКА
	
	Возврат;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

//++ НЕ УТКА
#Область АктКонтроляКачества

&НаКлиенте
Функция ПолучитьПараметрыФормыАктаКонтроляКачества()
	
	СписокИсследований = Новый Массив;
	
	ДанныеСтроки = Элементы.Список.ДанныеСтроки(Элементы.Список.ВыделенныеСтроки[0]);
	
	Если ДанныеСтроки.Состояние = ПредопределенноеЗначение("Перечисление.СостоянияЗаявокНаИсследование.ОжидаетсяИсследование") Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Исследования не назначены, команда не может быть выполнена.';
										|en = 'The research is not assigned. Cannot run the command.'"));
		Возврат Неопределено;
	КонецЕсли;
	
	Если ДанныеСтроки.Состояние = ПредопределенноеЗначение("Перечисление.СостоянияЗаявокНаИсследование.ВПроцессеИсследования") Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Не все исследования завершены, команда не может быть выполнена.';
										|en = 'Not all the research is done. Cannot run the command.'"));
		Возврат Неопределено;
	КонецЕсли;
	
	СписокИсследований = СписокИсследованийСОформленнымиАктамиКонтроляКачества(ДанныеСтроки.Ссылка);
	Если СписокИсследований.Количество() = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Нет исследований для оформления акта контроля, команда не может быть выполнена.';
										|en = 'There is no research to register the control certificate. Cannot run the command.'"));
		Возврат Неопределено;
	КонецЕсли;
	
	ДанныеЗаполнения = Новый Структура;
	ДанныеЗаполнения.Вставить("ДокументОснование", ДанныеСтроки.Ссылка);
	ДанныеЗаполнения.Вставить("ПоДокументамИсследования", СписокИсследований);
	
	ПараметрыФормы = Новый Структура("Основание", ДанныеЗаполнения);
	
	Возврат ПараметрыФормы;
	
КонецФункции

