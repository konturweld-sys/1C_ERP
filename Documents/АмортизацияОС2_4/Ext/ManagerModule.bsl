			ПараметрыДляРасчета.АмортизацияРеглНаНачалоПериода = 0;
		КонецЕсли;
		
		ПараметрыДляРасчета.АмортизацияНаНачалоПериода = 0;
		
	КонецЕсли;
	
	Выборка = Результат[Результат.ВГраница()-1].Выбрать();
	Если Выборка.Следующий() Тогда
		
		ПараметрыДляРасчета.ДатаВводаВЭксплуатациюУУ = Выборка.ДатаВводаВЭксплуатациюУУ;
		
	КонецЕсли;
	
	ПараметрыЗаПериодУУ = Результат[Результат.ВГраница()].Выгрузить();
	
	НомерСтроки = 1;
	Для Каждого ДанныеСтроки Из ПараметрыЗаПериодУУ Цикл
		ДанныеСтроки.НомерСтроки = НомерСтроки;
		НомерСтроки = НомерСтроки + 1;
	КонецЦикла;
	
	ПараметрыРасчета = Новый Структура;
	ПараметрыРасчета.Вставить("Организация", Параметры.Организация);
	ПараметрыРасчета.Вставить("ОсновноеСредство", Параметры.ОсновноеСредство);
	ПараметрыРасчета.Вставить("ДатаВводаВЭксплуатациюУУ", ПараметрыДляРасчета.ДатаВводаВЭксплуатациюУУ);
	ПараметрыРасчета.Вставить("ДатаВводаВЭксплуатациюБУ", ПараметрыДляРасчета.ДатаВводаВЭксплуатациюУУ);
	ПараметрыРасчета.Вставить("СтоимостьНаНачалоГода", ПараметрыДляРасчета.СтоимостьНаНачалоГода);
	ПараметрыРасчета.Вставить("СтоимостьРеглНаНачалоГода", ПараметрыДляРасчета.СтоимостьРеглНаНачалоГода);
	ПараметрыРасчета.Вставить("АмортизацияНаНачалоГода", ПараметрыДляРасчета.АмортизацияНаНачалоГода);
	ПараметрыРасчета.Вставить("АмортизацияРеглНаНачалоГода", ПараметрыДляРасчета.АмортизацияРеглНаНачалоГода);
	ПараметрыРасчета.Вставить("АмортизацияНаНачалоПериода", ПараметрыДляРасчета.АмортизацияНаНачалоПериода);
	ПараметрыРасчета.Вставить("АмортизацияРеглНаНачалоПериода", ПараметрыДляРасчета.АмортизацияРеглНаНачалоПериода);
	ПараметрыРасчета.Вставить("ЭтоАрендованныеОС", УчетАрендованныхОС.ОсновноеСредствоПолученоВАренду(Параметры.ОсновноеСредство, Параметры.Дата));

	ТаблицыРасчета = Новый Структура;
	ТаблицыРасчета.Вставить("ПараметрыЗаПериодУУ", ПараметрыЗаПериодУУ);

	ЗначенияПараметровРасчетаИзменений = Новый Соответствие;

	Выборка = Результат[Результат.ВГраница()-6].Выбрать();
	Пока Выборка.Следующий() Цикл
		
		// Стоимость исходных ОС при разукомплектации и объединении
		ЗначенияПараметров = Новый Структура;
		ЗначенияПараметров.Вставить("Стоимость", 0);
		ЗначенияПараметров.Вставить("СтоимостьРегл", 0);
		ЗначенияПараметров.Вставить("СтоимостьЦФ", 0);
		ЗначенияПараметров.Вставить("СтоимостьПР", 0);
		ЗначенияПараметров.Вставить("Амортизация", 0);
		ЗначенияПараметров.Вставить("АмортизацияРегл", 0);
		ЗначенияПараметров.Вставить("АмортизацияЦФ", 0);
		ЗначенияПараметров.Вставить("АмортизацияПР", 0);
		ЗначенияПараметров.Вставить("ОбесценениеУпр", 0);
		ЗначенияПараметров.Вставить("ОбесценениеРегл", 0);
		ЗначенияПараметров.Вставить("АмортизацияЗаПериодУпр", 0);  
		ЗначенияПараметров.Вставить("АмортизацияЗаПериодРегл", 0);
		ЗначенияПараметров.Вставить("АмортизацияЗаПериодПР", 0);
		
		ЗаполнитьЗначенияСвойств(ЗначенияПараметров, Выборка);
		
		ЗначенияПараметровРасчетаИзменений.Вставить(Выборка.ОсновноеСредство, ЗначенияПараметров);
		
	КонецЦикла;
	
	АмортизацияЗаПериодУпр = 0;
	АмортизацияЗаПериодРегл = 0;
	
	Для Каждого ДанныеСтроки Из ПараметрыЗаПериодУУ Цикл
		
		Если НЕ ДанныеСтроки.НеРассчитыватьАмортизацию Тогда
			
			ДанныеСтроки.Амортизация = ПараметрыРасчета.АмортизацияНаНачалоПериода + АмортизацияЗаПериодУпр;
			ДанныеСтроки.АмортизацияРегл = ПараметрыРасчета.АмортизацияРеглНаНачалоПериода + АмортизацияЗаПериодРегл;
			
			ЗначенияПараметров = РассчитатьСтоимостьАмортизациюПоДаннымДокумента(
				ДанныеСтроки, ЗначенияПараметровРасчетаИзменений, ТаблицаИсточникИПолучатель);
			
			ДанныеСтроки.Стоимость = ЗначенияПараметров.Стоимость;
			ДанныеСтроки.СтоимостьРегл = ЗначенияПараметров.СтоимостьРегл;
		
			ДанныеСтроки.АмортизацияИзменение = ЗначенияПараметров.АмортизацияИзменение;
			ДанныеСтроки.АмортизацияРеглИзменение = ЗначенияПараметров.АмортизацияРеглИзменение;
			
			Если НЕ ДанныеСтроки.ЭтоИзменения
				ИЛИ Параметры.ПоСтандартамМУ
					И Параметры.ПорядокНачисленияАмортизацииУпр = Перечисления.ПорядокНачисленияАмортизации.СДатыПринятияКУчету Тогда
			
				Результат = РассчитатьАмортизациюПоТаблице(ТаблицыРасчета, ПараметрыРасчета, ДанныеСтроки.НомерСтроки);
				
				СтрокаАмортизация = Результат.РезультатРасчетаУУ[ДанныеСтроки.НомерСтроки - 1];
				
				ДанныеСтроки.Амортизация = СтрокаАмортизация.Амортизация;
				ДанныеСтроки.АмортизацияРегл = СтрокаАмортизация.АмортизацияРегл;
				
			Иначе
				
				ДанныеСтроки.Амортизация = 0;
				ДанныеСтроки.АмортизацияРегл = 0;
				
			КонецЕсли;
		
			ЗначенияПараметров.АмортизацияЗаПериодУпр = ЗначенияПараметров.АмортизацияЗаПериодУпр + ДанныеСтроки.Амортизация;
			ЗначенияПараметров.АмортизацияЗаПериодРегл = ЗначенияПараметров.АмортизацияЗаПериодРегл + ДанныеСтроки.АмортизацияРегл;
				
		КонецЕсли;
		
		АмортизацияЗаПериодУпр = АмортизацияЗаПериодУпр + ДанныеСтроки.Амортизация;
		АмортизацияЗаПериодРегл = АмортизацияЗаПериодРегл + ДанныеСтроки.АмортизацияРегл;
		
	КонецЦикла;

	КолонкиСуммирования = Новый Массив;
	КолонкиСуммирования.Добавить("Амортизация");
	КолонкиСуммирования.Добавить("АмортизацияРегл");
	КолонкиСуммирования.Добавить("АмортизацияИзменение");
	КолонкиСуммирования.Добавить("АмортизацияРеглИзменение");

	СгруппироватьПараметрыЗаПериод(
		ПараметрыЗаПериодУУ, 
		КолонкиСуммирования, 
		Параметры.ПоСтандартамМУ И Параметры.ПорядокНачисленияАмортизацииУпр = Перечисления.ПорядокНачисленияАмортизации.СДатыПринятияКУчету);	
	
	ПараметрыДляРасчета.Вставить("ПараметрыЗаПериодУУ", ПараметрыЗаПериодУУ);
	
	ОбщегоНазначенияУТ.УничтожитьВременныеТаблицы(Параметры.МенеджерВременныхТаблиц,, ИспользуемыеВТ);
	
КонецПроцедуры

Процедура ЗаполнитьПараметрыЗаПериодБУ(ПараметрыДляРасчета, Параметры)
	
	Если НЕ Параметры.ЗаполнитьБУ
		ИЛИ НЕ Параметры.РеглУчетВНАВедетсяНезависимо Тогда
		Возврат;
	КонецЕсли;
	
	ИспользуемыеВТ = ОбщегоНазначенияУТ.СписокВременныхТаблиц(Параметры.МенеджерВременныхТаблиц);

	ПараметрыДляРасчета.Вставить("ДатаВводаВЭксплуатациюБУ", '00010101');
	ПараметрыДляРасчета.Вставить("СтоимостьРеглНаНачалоГода", 0);
	ПараметрыДляРасчета.Вставить("АмортизацияРеглНаНачалоГода", 0);
	ПараметрыДляРасчета.Вставить("АмортизацияРеглНаНачалоПериода", 0);
	ПараметрыДляРасчета.Вставить("АмортизацияПРНаНачалоПериода", 0);
	ПараметрыДляРасчета.Вставить("АмортизацияЦФНаНачалоПериода", 0);
	ПараметрыДляРасчета.Вставить("АмортизацияПРЦФНаНачалоПериода", 0);

	ПрименяетсяФСБУ6 = НастройкиНалоговУчетныхПолитикПовтИсп.ПрименяетсяФСБУ6(Параметры.Организация, КонецМесяца(Параметры.КонецПериода));
		
	СписокЗапросов = Новый Массив;
	
	#Область ТаблицаДатБУ
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	ВсеЗаписиРегистров.Дата КАК Дата,
	|	ВсеЗаписиРегистров.Регистратор КАК Регистратор,
	|
	|	МИНИМУМ(СледующиеЗаписиРегистров.Дата) КАК СледующаяДата
	|
	|ПОМЕСТИТЬ СледующиеЗаписиРегистров
	|
	|ИЗ
	|	ВсеЗаписиРегистров КАК ВсеЗаписиРегистров
	|
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВсеЗаписиРегистров КАК СледующиеЗаписиРегистров
	|		ПО СледующиеЗаписиРегистров.Дата <= &КонецПериодаБУ
	|			И СледующиеЗаписиРегистров.ЭтоИзменения
	|			И СледующиеЗаписиРегистров.ОтражатьВБУ
	|			И СледующиеЗаписиРегистров.Дата >= НАЧАЛОПЕРИОДА(ВсеЗаписиРегистров.Дата, МЕСЯЦ)
	|			И СледующиеЗаписиРегистров.Дата <= КОНЕЦПЕРИОДА(ВсеЗаписиРегистров.Дата, МЕСЯЦ)
	|			И (НЕ ВсеЗаписиРегистров.ЭтоИзменения
	|				ИЛИ СледующиеЗаписиРегистров.Дата > ВсеЗаписиРегистров.Дата
	|				ИЛИ СледующиеЗаписиРегистров.Дата = ВсеЗаписиРегистров.Дата
	|					И СледующиеЗаписиРегистров.Порядок >= ВсеЗаписиРегистров.Порядок
	|					И СледующиеЗаписиРегистров.Регистратор > ВсеЗаписиРегистров.Регистратор)
	|
	|ГДЕ
	|	ВсеЗаписиРегистров.Дата <= &КонецПериодаБУ
	|	И ВсеЗаписиРегистров.ОтражатьВБУ
	|
	|СГРУППИРОВАТЬ ПО
	|	ВсеЗаписиРегистров.Дата,
	|	ВсеЗаписиРегистров.Регистратор
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВсеЗаписиРегистров.Дата КАК Период,
	|	ВсеЗаписиРегистров.Регистратор КАК Регистратор,
	|	ВсеЗаписиРегистров.ХозяйственнаяОперация КАК ХозяйственнаяОперация,
	|	ВсеЗаписиРегистров.ЭтоИзменения КАК ЭтоИзменения,
	|	ВсеЗаписиРегистров.Порядок КАК Порядок,
	|	НАЧАЛОПЕРИОДА(ВсеЗаписиРегистров.Дата, МЕСЯЦ) КАК НачалоМесяца,
	|
	|	ВЫБОР 
	|		КОГДА НЕ ВсеЗаписиРегистров.ЭтоИзменения
	|			И &ПорядокНачисленияАмортизацииРегл = ЗНАЧЕНИЕ(Перечисление.ПорядокНачисленияАмортизации.СоСледующегоМесяца)
	|
	|			ТОГДА НАЧАЛОПЕРИОДА(ВсеЗаписиРегистров.Дата, МЕСЯЦ)
	|
	|		КОГДА СледующиеЗаписиРегистров.СледующаяДата ЕСТЬ NULL
	|
	|			ТОГДА ВЫБОР 
	|					КОГДА КОНЕЦПЕРИОДА(ВсеЗаписиРегистров.Дата, МЕСЯЦ) > &КонецПериодаБУ 
	|						ТОГДА &КонецПериодаБУ
	|					ИНАЧЕ КОНЕЦПЕРИОДА(ВсеЗаписиРегистров.Дата, МЕСЯЦ) 
	|				КОНЕЦ
	|
	|		КОГДА НАЧАЛОПЕРИОДА(СледующиеЗаписиРегистров.СледующаяДата, ДЕНЬ) = НАЧАЛОПЕРИОДА(СледующиеЗаписиРегистров.СледующаяДата, МЕСЯЦ)
	|
	|			ТОГДА СледующиеЗаписиРегистров.СледующаяДата
	|
	|		КОГДА НАЧАЛОПЕРИОДА(СледующиеЗаписиРегистров.СледующаяДата, ДЕНЬ) = НАЧАЛОПЕРИОДА(ВсеЗаписиРегистров.Дата, ДЕНЬ)
	|			И ВсеЗаписиРегистров.ЭтоИзменения
	|
	|			ТОГДА ВсеЗаписиРегистров.Дата
	|
	|		ИНАЧЕ ДОБАВИТЬКДАТЕ(СледующиеЗаписиРегистров.СледующаяДата, ДЕНЬ, -1)
	|
	|	КОНЕЦ КАК Дата,
	|
	|	ВЫБОР 
	|		КОГДА НЕ ВсеЗаписиРегистров.ЭтоИзменения
	|			И &ПорядокНачисленияАмортизацииРегл = ЗНАЧЕНИЕ(Перечисление.ПорядокНачисленияАмортизации.СоСледующегоМесяца)
	|
	|			ТОГДА НАЧАЛОПЕРИОДА(ВсеЗаписиРегистров.Дата, МЕСЯЦ)
	|
	|		КОГДА &ПорядокНачисленияАмортизацииРегл = ЗНАЧЕНИЕ(Перечисление.ПорядокНачисленияАмортизации.СДатыПринятияКУчету)
	|			
	|			ТОГДА ВЫБОР 
	|					КОГДА СледующиеЗаписиРегистров.СледующаяДата ЕСТЬ NULL
	|
	|						ТОГДА КОНЕЦПЕРИОДА(ВсеЗаписиРегистров.Дата, МЕСЯЦ)
	|
	|					КОГДА НАЧАЛОПЕРИОДА(СледующиеЗаписиРегистров.СледующаяДата, ДЕНЬ) = НАЧАЛОПЕРИОДА(СледующиеЗаписиРегистров.СледующаяДата, МЕСЯЦ)
	|
	|						ТОГДА СледующиеЗаписиРегистров.СледующаяДата
	|
	|					КОГДА НАЧАЛОПЕРИОДА(СледующиеЗаписиРегистров.СледующаяДата, ДЕНЬ) = НАЧАЛОПЕРИОДА(ВсеЗаписиРегистров.Дата, ДЕНЬ)
	|						И ВсеЗаписиРегистров.ЭтоИзменения
	|
	|						ТОГДА СледующиеЗаписиРегистров.СледующаяДата
	|
	|					ИНАЧЕ ДОБАВИТЬКДАТЕ(СледующиеЗаписиРегистров.СледующаяДата, ДЕНЬ, -1)
	|
	|				КОНЕЦ
	|
	|		ИНАЧЕ ДОБАВИТЬКДАТЕ(НАЧАЛОПЕРИОДА(ВсеЗаписиРегистров.Дата, МЕСЯЦ), СЕКУНДА, -1)
	|
	|	КОНЕЦ КАК ДатаПараметров
	|
	|ПОМЕСТИТЬ ТаблицаИзменений
	|
	|ИЗ
	|	ВсеЗаписиРегистров КАК ВсеЗаписиРегистров
	|
	|		ЛЕВОЕ СОЕДИНЕНИЕ СледующиеЗаписиРегистров КАК СледующиеЗаписиРегистров
	|		ПО СледующиеЗаписиРегистров.Дата = ВсеЗаписиРегистров.Дата
	|			И СледующиеЗаписиРегистров.Регистратор = ВсеЗаписиРегистров.Регистратор
	|
	|ГДЕ
	|	ВсеЗаписиРегистров.Дата <= &КонецПериодаБУ
	|	И ВсеЗаписиРегистров.ОтражатьВБУ
	|	И (&ПорядокНачисленияАмортизацииРегл = ЗНАЧЕНИЕ(Перечисление.ПорядокНачисленияАмортизации.СоСледующегоМесяца)
	|		ИЛИ ВсеЗаписиРегистров.ЭтоИзменения
	|		ИЛИ НАЧАЛОПЕРИОДА(ЕСТЬNULL(СледующиеЗаписиРегистров.СледующаяДата,ДАТАВРЕМЯ(1,1,1)), ДЕНЬ) <> НАЧАЛОПЕРИОДА(ВсеЗаписиРегистров.Дата, МЕСЯЦ))
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДанныеРегистраРегистраторЗаписи.Дата КАК Дата,
	|	ДанныеРегистраРегистраторЗаписи.Период КАК Период,
	|	ДанныеРегистраРегистраторЗаписи.Регистратор КАК Регистратор,
	|	ДанныеРегистраРегистраторЗаписи.ХозяйственнаяОперация КАК ХозяйственнаяОперация,
	|	ДанныеРегистраРегистраторЗаписи.ДатаПараметров КАК ДатаПараметров,
	|	ДанныеРегистраРегистраторЗаписи.ЭтоИзменения КАК ЭтоИзменения,
	|	ДанныеРегистраРегистраторЗаписи.Порядок КАК Порядок,
	|	МестонахождениеОС_Записи.Организация КАК Организация
	|
	|ПОМЕСТИТЬ ТаблицаДатБУ
	|
	|ИЗ
	|	(ВЫБРАТЬ
	|		ДанныеРегистраПериодЗаписи.Дата КАК Дата,
	|		ДанныеРегистраПериодЗаписи.Период КАК Период,
	|		ДанныеРегистраПериодЗаписи.Регистратор КАК Регистратор,
	|		ДанныеРегистраПериодЗаписи.ХозяйственнаяОперация КАК ХозяйственнаяОперация,
	|		ДанныеРегистраПериодЗаписи.ДатаПараметров КАК ДатаПараметров,
	|		ДанныеРегистраПериодЗаписи.ЭтоИзменения КАК ЭтоИзменения,
	|		ДанныеРегистраПериодЗаписи.Порядок КАК Порядок,
	|		ДанныеРегистраПериодЗаписи.ПериодЗаписи КАК ПериодЗаписи,
	|		МАКСИМУМ(ДанныеРегистраРегистраторЗаписи.Регистратор) КАК РегистраторЗаписи
	|	ИЗ
	|		(ВЫБРАТЬ
	|			ТаблицаИзменений.Дата КАК Дата,
	|			ТаблицаИзменений.Период КАК Период,
	|			ТаблицаИзменений.Регистратор КАК Регистратор,
	|			ТаблицаИзменений.ХозяйственнаяОперация КАК ХозяйственнаяОперация,
	|			ТаблицаИзменений.ДатаПараметров КАК ДатаПараметров,
	|			ТаблицаИзменений.ЭтоИзменения КАК ЭтоИзменения,
