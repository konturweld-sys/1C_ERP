	|
	|		ВЫБОР КОГДА АмортизацияВНА.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход) 
	|			ТОГДА АмортизацияВНА.АмортизацияПРЦФ 
	|			ИНАЧЕ -АмортизацияВНА.АмортизацияПРЦФ 
	|		КОНЕЦ КАК АмортизацияПРЦФ
	|
	|	ИЗ
	|		ВтПериодКорректировки КАК ВтПериодКорректировки
	|
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.АмортизацияОС КАК АмортизацияВНА
	|			ПО АмортизацияВНА.ОсновноеСредство = ВтПериодКорректировки.ОсновноеСредство
	|				И АмортизацияВНА.Период >= ВтПериодКорректировки.НачалоПериода
	|				И АмортизацияВНА.Период < ВтПериодКорректировки.КонецПериода
	|				И АмортизацияВНА.Активность
	|
	|			ЛЕВОЕ СОЕДИНЕНИЕ Документ.КорректировкаСтоимостиИАмортизацииОС КАК Корректировка
	|			ПО Корректировка.Ссылка = АмортизацияВНА.Регистратор
	|
	|		ГДЕ
	|			Корректировка.Ссылка ЕСТЬ NULL
	|				ИЛИ Корректировка.ДокументОснование = НЕОПРЕДЕЛЕНО
	|					И НЕ Корректировка.ДокументОснование ССЫЛКА Документ.ОбъединениеОС
	|					И НЕ Корректировка.ДокументОснование ССЫЛКА Документ.РазукомплектацияОС
	|					И НЕ Корректировка.ДокументОснование ССЫЛКА Документ.МодернизацияОС2_4
	|					И НЕ Корректировка.ДокументОснование ССЫЛКА Документ.ОтнесениеОтклоненийВСтоимостьОС
	|					И НЕ Корректировка.ДокументОснование ССЫЛКА Документ.ПереоценкаОС2_4
	|					И НЕ Корректировка.ДокументОснование ССЫЛКА Документ.ПринятиеКУчетуОС2_4
	|
	|	) КАК АмортизацияЗаПериод
	|
	|СГРУППИРОВАТЬ ПО
	|	АмортизацияЗаПериод.ОсновноеСредство,
	|	АмортизацияЗаПериод.КонецМесяца
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ОсновноеСредство,
	|	КонецМесяца
	|";
	
	СписокЗапросов.Добавить(ТекстЗапроса);
	
	#КонецОбласти

	#Область Выборка
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ТаблицаОС.Ссылка КАК Ссылка,
	|	ТаблицаОС.Дата КАК Дата,
	|	ТаблицаОС.Организация КАК Организация,
	|	ТаблицаОС.ОсновноеСредство КАК ОсновноеСредство,
	|	ТаблицаОС.НачалоПериодаДоначисления КАК НачалоПериодаДоначисления,
	|	ТаблицаОС.КонецПериодаДоначисления КАК КонецПериодаДоначисления,
	|	ТаблицаОС.КорректировкаАмортизацииЗаПериод КАК КорректировкаАмортизацииЗаПериод,
	|	ТаблицаОС.ЗаполнитьУУ КАК ЗаполнитьУУ,
	|	ТаблицаОС.ЗаполнитьБУ КАК ЗаполнитьБУ,
	|	ТаблицаОС.ЗаполнитьНУ КАК ЗаполнитьНУ,
	|	НЕ ВТ_АрендованныеОС.ОсновноеСредство ЕСТЬ NULL КАК ЭтоАрендованныеОС,
	|	ПорядокУчетаОСБУ.СтатьяРасходовБУ КАК СтатьяРасходовБУ,
	|	ПорядокУчетаОСБУ.СтатьяРасходовНУ КАК СтатьяРасходовНУ,
	|	ПорядокУчетаОСУУ.СтатьяРасходов КАК СтатьяРасходовУУ,
	|	ПорядокУчетаОСБУ.АналитикаРасходовБУ КАК АналитикаРасходовБУ,
	|	ПорядокУчетаОСБУ.АналитикаРасходовНУ КАК АналитикаРасходовНУ,
	|	ПорядокУчетаОСУУ.АналитикаРасходов КАК АналитикаРасходовУУ,
	|	ПорядокУчетаОСБУ.ПодразделениеБУ КАК ПодразделениеБУ,
	|	ПорядокУчетаОСБУ.ПодразделениеНУ КАК ПодразделениеНУ,
	|	ПорядокУчетаОСУУ.Подразделение КАК ПодразделениеУУ,
	|	ПорядокУчетаОСБУ.НаправлениеДеятельностиБУ КАК НаправлениеДеятельностиБУ,
	|	ПорядокУчетаОСБУ.НаправлениеДеятельностиНУ КАК НаправлениеДеятельностиНУ,
	|	ПорядокУчетаОСУУ.НаправлениеДеятельности КАК НаправлениеДеятельностиУУ,
	|	ПорядокУчетаОСБУ.СпособОтраженияАмортизацииБУ КАК СпособОтраженияАмортизацииБУ,
	|	ПорядокУчетаОСБУ.СпособОтраженияАмортизацииНУ КАК СпособОтраженияАмортизацииНУ,
	|	ПорядокУчетаОСУУ.СпособОтраженияАмортизации КАК СпособОтраженияАмортизацииУУ,
	|	ПорядокУчетаОСБУ.ПередаватьРасходыВДругуюОрганизацию КАК ПередаватьРасходыВДругуюОрганизациюБУ,
	|	ПорядокУчетаОСБУ.ПередаватьРасходыВДругуюОрганизацию КАК ПередаватьРасходыВДругуюОрганизациюНУ,
	|	ПорядокУчетаОСУУ.ПередаватьРасходыВДругуюОрганизацию КАК ПередаватьРасходыВДругуюОрганизациюУУ,
	|	ПорядокУчетаОСБУ.ОрганизацияПолучательРасходов КАК ОрганизацияПолучательРасходовБУ,
	|	ПорядокУчетаОСБУ.ОрганизацияПолучательРасходов КАК ОрганизацияПолучательРасходовНУ,
	|	ПорядокУчетаОСУУ.ОрганизацияПолучательРасходов КАК ОрганизацияПолучательРасходовУУ
	|
	|ИЗ
	|	ТаблицаОС КАК ТаблицаОС
	|
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПорядокУчетаОСБУ КАК ПорядокУчетаОСБУ
	|		ПО ПорядокУчетаОСБУ.Организация = ТаблицаОС.Организация
	|			И ПорядокУчетаОСБУ.ОсновноеСредство = ТаблицаОС.ОсновноеСредство
	|			И ПорядокУчетаОСБУ.НачалоМесяца = &НачалоМесяца
	|			И ПорядокУчетаОСБУ.ПериодПараметров = &КонецПредыдущегоМесяца
	|
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПорядокУчетаОСУУ КАК ПорядокУчетаОСУУ
	|		ПО ПорядокУчетаОСУУ.Организация = ТаблицаОС.Организация
	|			И ПорядокУчетаОСУУ.ОсновноеСредство = ТаблицаОС.ОсновноеСредство
	|			И ПорядокУчетаОСУУ.НачалоМесяца = &НачалоМесяца
	|			И ПорядокУчетаОСУУ.ПериодПараметров = &КонецПредыдущегоМесяца
	|
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_АрендованныеОС КАК ВТ_АрендованныеОС
	|		ПО ВТ_АрендованныеОС.ОсновноеСредство = ТаблицаОС.ОсновноеСредство
	|			И ВТ_АрендованныеОС.НачалоМесяца = &НачалоМесяца
	|";
	
	СписокЗапросов.Добавить(ТекстЗапроса);
	
	#КонецОбласти
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = ПараметрыРасчета.МенеджерВременныхТаблиц;
	РасчетАмортизацииОС.УстановитьПараметрыЗапросаДляРасчетаАмортизации(Запрос, ПараметрыРасчета);

	УстановитьПривилегированныйРежим(Истина);
	Результат = ВнеоборотныеАктивыСлужебный.ВыполнитьЗапрос(Запрос, СписокЗапросов);
	УстановитьПривилегированныйРежим(Ложь);
	
	ТаблицаОС = Результат.Выгрузить();
	
	#КонецОбласти

	#Область РасчетАмортизацииПоДокументам
	
	//@skip-check query-in-loop
	Для Каждого Выборка Из ТаблицаОС Цикл
		
		#Область ПолучениеПараметровРасчета
		
		РеглУчетВНАВедетсяНезависимо = НастройкиНалоговУчетныхПолитикПовтИсп.РеглУчетВНАВедетсяНезависимо(
			Выборка.Организация, КонецМесяца(Выборка.Дата));
		
		Параметры = Новый Структура;
		Параметры.Вставить("Ссылка", Документы.КорректировкаСтоимостиИАмортизацииОС.ПустаяСсылка());
		Параметры.Вставить("Организация", Выборка.Организация);
		Параметры.Вставить("ОсновноеСредство", Выборка.ОсновноеСредство);
		Параметры.Вставить("Дата", Выборка.Дата);
		Параметры.Вставить("НачалоПериода", НачалоМесяца(Выборка.НачалоПериодаДоначисления));
		Параметры.Вставить("КонецПериода", КонецМесяца(Выборка.КонецПериодаДоначисления));
		Параметры.Вставить("КонецПериодаУУ", КонецМесяца(Выборка.КонецПериодаДоначисления));
		Параметры.Вставить("КонецПериодаБУ", КонецМесяца(Выборка.КонецПериодаДоначисления));
		Параметры.Вставить("КонецПериодаНУ", КонецМесяца(Выборка.КонецПериодаДоначисления));
		Параметры.Вставить("АмортизационнаяПремия", 0);
		Параметры.Вставить("ЗаполнитьУУ", Выборка.ЗаполнитьУУ);
		Параметры.Вставить("ЗаполнитьБУ", Выборка.ЗаполнитьБУ И РеглУчетВНАВедетсяНезависимо);
		Параметры.Вставить("ЗаполнитьНУ", Выборка.ЗаполнитьНУ);
		
		ПараметрыДляРасчета = ПараметрыДляРасчетаАмортизацииПоТаблице(Параметры);

		#КонецОбласти
		
		#Область РасчетАмортизации
		
		Параметры = Новый Структура;
		Параметры.Вставить("Организация", Выборка.Организация);
		Параметры.Вставить("ОсновноеСредство", Выборка.ОсновноеСредство);
		Параметры.Вставить("ЭтоАрендованныеОС", Выборка.ЭтоАрендованныеОС);
		
		Если Выборка.ЗаполнитьУУ Тогда
			Параметры.Вставить("ДатаВводаВЭксплуатациюУУ", ПараметрыДляРасчета.ДатаВводаВЭксплуатациюУУ);
			Параметры.Вставить("СтоимостьНаНачалоГода", ПараметрыДляРасчета.СтоимостьНаНачалоГода);
			Параметры.Вставить("СтоимостьРеглНаНачалоГода", ПараметрыДляРасчета.СтоимостьРеглНаНачалоГода);
			Параметры.Вставить("АмортизацияНаНачалоГода", ПараметрыДляРасчета.АмортизацияНаНачалоГода);
			Параметры.Вставить("АмортизацияРеглНаНачалоГода", ПараметрыДляРасчета.АмортизацияРеглНаНачалоГода);
			Параметры.Вставить("АмортизацияНаНачалоПериода", ПараметрыДляРасчета.АмортизацияНаНачалоПериода);
			Параметры.Вставить("АмортизацияРеглНаНачалоПериода", ПараметрыДляРасчета.АмортизацияРеглНаНачалоПериода);
		КонецЕсли;
		
		Если Выборка.ЗаполнитьБУ И РеглУчетВНАВедетсяНезависимо Тогда
			Параметры.Вставить("ДатаВводаВЭксплуатациюБУ", ПараметрыДляРасчета.ДатаВводаВЭксплуатациюБУ);
			Параметры.Вставить("СтоимостьРеглНаНачалоГода", ПараметрыДляРасчета.СтоимостьРеглНаНачалоГода);
			Параметры.Вставить("АмортизацияРеглНаНачалоГода", ПараметрыДляРасчета.АмортизацияРеглНаНачалоГода);
			Параметры.Вставить("АмортизацияРеглНаНачалоПериода", ПараметрыДляРасчета.АмортизацияРеглНаНачалоПериода);
			Параметры.Вставить("АмортизацияЦФНаНачалоПериода", ПараметрыДляРасчета.АмортизацияЦФНаНачалоПериода);
			Параметры.Вставить("АмортизацияПРНаНачалоПериода", ПараметрыДляРасчета.АмортизацияПРНаНачалоПериода);
			Параметры.Вставить("АмортизацияПРЦФНаНачалоПериода", ПараметрыДляРасчета.АмортизацияПРЦФНаНачалоПериода);
		КонецЕсли;
		
		Если Выборка.ЗаполнитьНУ Тогда
			Параметры.Вставить("АмортизацияНУНаНачалоПериода", ПараметрыДляРасчета.АмортизацияНУНаНачалоПериода);
			Параметры.Вставить("ДатаВводаВЭксплуатациюНУ", ПараметрыДляРасчета.ДатаВводаВЭксплуатациюНУ);
			Параметры.Вставить("АмортизацияНУНаНачалоПериода", ПараметрыДляРасчета.АмортизацияНУНаНачалоПериода);
			Параметры.Вставить("АмортизацияДо2009", ПараметрыДляРасчета.АмортизацияДо2009);
			Параметры.Вставить("ФактическийСрокИспользованияДо2009", ПараметрыДляРасчета.ФактическийСрокИспользованияДо2009);
		КонецЕсли;

		ТаблицыРасчета = Новый Структура;
		
		Если Выборка.ЗаполнитьУУ Тогда
			ТаблицыРасчета.Вставить("ПараметрыЗаПериодУУ", ПараметрыДляРасчета.ПараметрыЗаПериодУУ.Скопировать());
			Для НомерСтроки = 1 По ТаблицыРасчета.ПараметрыЗаПериодУУ.Количество() Цикл
				ТаблицыРасчета.ПараметрыЗаПериодУУ[НомерСтроки-1].НомерСтроки = НомерСтроки;
			КонецЦикла;
		КонецЕсли;
		
		Если Выборка.ЗаполнитьБУ И РеглУчетВНАВедетсяНезависимо Тогда
			ТаблицыРасчета.Вставить("ПараметрыЗаПериодБУ", ПараметрыДляРасчета.ПараметрыЗаПериодБУ.Скопировать());
			Для НомерСтроки = 1 По ТаблицыРасчета.ПараметрыЗаПериодБУ.Количество() Цикл
				ТаблицыРасчета.ПараметрыЗаПериодБУ[НомерСтроки-1].НомерСтроки = НомерСтроки;
			КонецЦикла;
		КонецЕсли;
		
		Если Выборка.ЗаполнитьНУ Тогда
			ТаблицыРасчета.Вставить("ПараметрыЗаПериодНУ", ПараметрыДляРасчета.ПараметрыЗаПериодНУ.Скопировать());
			Для НомерСтроки = 1 По ТаблицыРасчета.ПараметрыЗаПериодНУ.Количество() Цикл
				ТаблицыРасчета.ПараметрыЗаПериодНУ[НомерСтроки-1].НомерСтроки = НомерСтроки;
			КонецЦикла;
		КонецЕсли;
		
		РезультатРасчета = РассчитатьАмортизациюПоТаблице(ТаблицыРасчета, Параметры);
		
		#КонецОбласти
		
		#Область ДобавлениеРасчетаВТаблицу
		
		Если РезультатРасчета.Свойство("РезультатРасчетаУУ") Тогда
			
			Для Каждого ДанныеСтроки Из РезультатРасчета.РезультатРасчетаУУ Цикл
				
				НоваяСтрока = РасчетАмортизации.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, ДанныеСтроки);
				
				НоваяСтрока.ЭтоУУ = Истина;
				НоваяСтрока.СуммаУУ = ДанныеСтроки.Амортизация;
				НоваяСтрока.Ссылка = Выборка.Ссылка;
				НоваяСтрока.ОсновноеСредство = Выборка.ОсновноеСредство;
				
				НоваяСтрока.СтатьяРасходов = Выборка.СтатьяРасходовУУ;
				НоваяСтрока.АналитикаРасходов = Выборка.АналитикаРасходовУУ;
				НоваяСтрока.ПодразделениеРасходов = Выборка.ПодразделениеУУ;
				НоваяСтрока.НаправлениеДеятельностиРасходов = Выборка.НаправлениеДеятельностиУУ;
				НоваяСтрока.ПередаватьРасходыВДругуюОрганизацию = Выборка.ПередаватьРасходыВДругуюОрганизациюУУ;
				НоваяСтрока.ОрганизацияПолучательРасходов = Выборка.ОрганизацияПолучательРасходовУУ;
				НоваяСтрока.СпособОтраженияАмортизации = Выборка.СпособОтраженияАмортизацииУУ;
				
				ПараметрыЗаПериод = ТаблицыРасчета.ПараметрыЗаПериодУУ.Найти(ДанныеСтроки.НомерСтроки, "НомерСтроки");
				НоваяСтрока.АмортизацияИзменениеУУ = ПараметрыЗаПериод.АмортизацияИзменение;
				НоваяСтрока.АмортизацияИзменениеБУ = ПараметрыЗаПериод.АмортизацияРеглИзменение;
				
				Если Выборка.КорректировкаАмортизацииЗаПериод
					И НачалоМесяца(ДанныеСтроки.Период) < НачалоМесяца(ПараметрыРасчета.Период) Тогда
					
					НоваяСтрока.Период = КонецМесяца(НоваяСтрока.Период);
					
				Иначе
					
					НоваяСтрока.СтоимостьДляВычисленияАмортизацииУУ = ДанныеСтроки.СтоимостьДляВычисленияАмортизации;
					НоваяСтрока.РесурсВыработанныйЗаТекущийПериодУУ = ДанныеСтроки.РесурсВыработанныйЗаТекущийПериод;
					НоваяСтрока.РесурсВыработанныйЗаПрошлыйПериодУУ = ДанныеСтроки.РесурсВыработанныйЗаПрошлыйПериод;
					НоваяСтрока.ПорядокНачисленияАмортизацииУУ = ДанныеСтроки.ПорядокНачисленияАмортизации;
