Процедура РассчитатьАмортизацию_ЗаПрошлыйМесяцБУ(ПараметрыРасчета)
	
	ИспользуемыеВТ = ОбщегоНазначенияУТ.СписокВременныхТаблиц(ПараметрыРасчета.МенеджерВременныхТаблиц);
	ИспользуемыеВТ.Добавить("ДоначислениеАмортизацииБУ_МУ");
	ИспользуемыеВТ.Добавить("ДоначислениеАмортизацииБУ_МУ_Сгруппированная");

	РассчитатьАмортизацию_ЗаПрошлыйМесяц_БезИзмененийБУ(ПараметрыРасчета);
	РассчитатьАмортизацию_ЗаПрошлыйМесяц_СУчетомИзмененийБУ(ПараметрыРасчета);
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	Амортизация.ПериодРасчета КАК ПериодРасчета,
	|	Амортизация.Организация КАК Организация,
	|	Амортизация.ОсновноеСредство КАК ОсновноеСредство,
	|	Амортизация.ГруппаФинансовогоУчета КАК ГруппаФинансовогоУчета,
