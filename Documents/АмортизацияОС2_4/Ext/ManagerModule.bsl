		ПараметрыДляРасчета.АмортизацияПРНаНачалоПериода = 0;
		ПараметрыДляРасчета.АмортизацияЦФНаНачалоПериода = 0;
		ПараметрыДляРасчета.АмортизацияПРЦФНаНачалоПериода = 0;
		
	КонецЕсли;
	
	Выборка = Результат[Результат.ВГраница()-1].Выбрать();
	Если Выборка.Следующий() Тогда
		
		ПараметрыДляРасчета.ДатаВводаВЭксплуатациюБУ = Выборка.ДатаВводаВЭксплуатациюБУ;
		
	КонецЕсли;
	
	ПараметрыЗаПериодБУ = Результат[Результат.ВГраница()].Выгрузить();
	
	НомерСтроки = 1;
	Для Каждого ДанныеСтроки Из ПараметрыЗаПериодБУ Цикл
		ДанныеСтроки.НомерСтроки = НомерСтроки;
		НомерСтроки = НомерСтроки + 1;
	КонецЦикла;
	
	ПараметрыРасчета = Новый Структура;
	ПараметрыРасчета.Вставить("Организация", Параметры.Организация);
	ПараметрыРасчета.Вставить("ОсновноеСредство", Параметры.ОсновноеСредство);
	ПараметрыРасчета.Вставить("ДатаВводаВЭксплуатациюБУ", ПараметрыДляРасчета.ДатаВводаВЭксплуатациюБУ);
	ПараметрыРасчета.Вставить("СтоимостьНаНачалоГода", 0);
	ПараметрыРасчета.Вставить("СтоимостьРеглНаНачалоГода", ПараметрыДляРасчета.СтоимостьРеглНаНачалоГода);
	ПараметрыРасчета.Вставить("АмортизацияНаНачалоГода", 0);
	ПараметрыРасчета.Вставить("АмортизацияРеглНаНачалоГода", ПараметрыДляРасчета.АмортизацияРеглНаНачалоГода);
	ПараметрыРасчета.Вставить("АмортизацияНаНачалоПериода", 0);
	ПараметрыРасчета.Вставить("АмортизацияРеглНаНачалоПериода", ПараметрыДляРасчета.АмортизацияРеглНаНачалоПериода);
	ПараметрыРасчета.Вставить("АмортизацияПРНаНачалоПериода", ПараметрыДляРасчета.АмортизацияПРНаНачалоПериода);
	ПараметрыРасчета.Вставить("АмортизацияЦФНаНачалоПериода", ПараметрыДляРасчета.АмортизацияЦФНаНачалоПериода);
	ПараметрыРасчета.Вставить("АмортизацияПРЦФНаНачалоПериода", ПараметрыДляРасчета.АмортизацияПРЦФНаНачалоПериода);
	ПараметрыРасчета.Вставить("ЭтоАрендованныеОС", УчетАрендованныхОС.ОсновноеСредствоПолученоВАренду(Параметры.ОсновноеСредство, Параметры.Дата));

	ТаблицыРасчета = Новый Структура;
	ТаблицыРасчета.Вставить("ПараметрыЗаПериодБУ", ПараметрыЗаПериодБУ);
	
	ЗначенияПараметровРасчетаИзменений = Новый Соответствие;

	Выборка = Результат[Результат.ВГраница()-6].Выбрать();
	Пока Выборка.Следующий() Цикл
		
		// Стоимость исходных ОС при разукомплектации и объединении
		ЗначенияПараметров = Новый Структура;
		ЗначенияПараметров.Вставить("Стоимость", 0);
		ЗначенияПараметров.Вставить("СтоимостьРегл", 0);
		ЗначенияПараметров.Вставить("СтоимостьПР", 0);
		ЗначенияПараметров.Вставить("СтоимостьЦФ", 0);
		ЗначенияПараметров.Вставить("СтоимостьПРЦФ", 0);
		ЗначенияПараметров.Вставить("Амортизация", 0);
		ЗначенияПараметров.Вставить("АмортизацияРегл", 0);
		ЗначенияПараметров.Вставить("АмортизацияПР", 0);
		ЗначенияПараметров.Вставить("АмортизацияЦФ", 0);
		ЗначенияПараметров.Вставить("АмортизацияПРЦФ", 0);
		ЗначенияПараметров.Вставить("ОбесценениеУпр", 0);
		ЗначенияПараметров.Вставить("ОбесценениеРегл", 0);
		ЗначенияПараметров.Вставить("АмортизацияЗаПериодУпр", 0);  
		ЗначенияПараметров.Вставить("АмортизацияЗаПериодРегл", 0);
		ЗначенияПараметров.Вставить("АмортизацияЗаПериодПР", 0);
		ЗначенияПараметров.Вставить("АмортизацияЗаПериодЦФ", 0);
		ЗначенияПараметров.Вставить("АмортизацияЗаПериодПРЦФ", 0);
		
		ЗаполнитьЗначенияСвойств(ЗначенияПараметров, Выборка);
		
		ЗначенияПараметровРасчетаИзменений.Вставить(Выборка.ОсновноеСредство, ЗначенияПараметров);
		
	КонецЦикла;
	
	АмортизацияЗаПериодРегл = 0;
	АмортизацияЗаПериодПР = 0;
	АмортизацияЗаПериодЦФ = 0;
	АмортизацияЗаПериодПРЦФ = 0;
	
	Для Каждого ДанныеСтроки Из ПараметрыЗаПериодБУ Цикл
		
		Если НЕ ДанныеСтроки.НеРассчитыватьАмортизациюБУ Тогда
			
			ДанныеСтроки.АмортизацияРегл = ПараметрыРасчета.АмортизацияРеглНаНачалоПериода + АмортизацияЗаПериодРегл;
			ДанныеСтроки.АмортизацияПР = ПараметрыРасчета.АмортизацияПРНаНачалоПериода + АмортизацияЗаПериодПР;
			ДанныеСтроки.АмортизацияЦФ = ПараметрыРасчета.АмортизацияЦФНаНачалоПериода + АмортизацияЗаПериодЦФ;
			ДанныеСтроки.АмортизацияПРЦФ = ПараметрыРасчета.АмортизацияПРЦФНаНачалоПериода + АмортизацияЗаПериодПРЦФ;
			
			ЗначенияПараметров = РассчитатьСтоимостьАмортизациюПоДаннымДокумента(
				ДанныеСтроки, ЗначенияПараметровРасчетаИзменений, ТаблицаИсточникИПолучатель);
			
			ДанныеСтроки.СтоимостьРегл = ЗначенияПараметров.СтоимостьРегл;
			ДанныеСтроки.СтоимостьБУ = ЗначенияПараметров.СтоимостьРегл;
			ДанныеСтроки.СтоимостьПР = ЗначенияПараметров.СтоимостьПР;
			ДанныеСтроки.СтоимостьЦФ = ЗначенияПараметров.СтоимостьЦФ;
			ДанныеСтроки.СтоимостьПРЦФ = ЗначенияПараметров.СтоимостьПРЦФ;
		
			ДанныеСтроки.АмортизацияРеглИзменение = ЗначенияПараметров.АмортизацияРеглИзменение;
			
			Если НЕ ДанныеСтроки.ЭтоИзменения
				ИЛИ ПрименяетсяФСБУ6
					И Параметры.ПорядокНачисленияАмортизацииРегл = Перечисления.ПорядокНачисленияАмортизации.СДатыПринятияКУчету Тогда
					
				Результат = РассчитатьАмортизациюПоТаблице(ТаблицыРасчета, ПараметрыРасчета, ДанныеСтроки.НомерСтроки);
				
				СтрокаАмортизация = Результат.РезультатРасчетаБУ[ДанныеСтроки.НомерСтроки - 1];
				
				ДанныеСтроки.АмортизацияБУ = СтрокаАмортизация.АмортизацияБУ;
				ДанныеСтроки.АмортизацияРегл = СтрокаАмортизация.АмортизацияБУ;
				ДанныеСтроки.АмортизацияПР = СтрокаАмортизация.АмортизацияПР;
				ДанныеСтроки.АмортизацияЦФ = СтрокаАмортизация.АмортизацияЦФ;
				
			Иначе
				
				ДанныеСтроки.АмортизацияБУ = 0;
				ДанныеСтроки.АмортизацияРегл = 0;
				ДанныеСтроки.АмортизацияПР = 0;
				ДанныеСтроки.АмортизацияЦФ = 0;
	
			КонецЕсли;
			
			ЗначенияПараметров.АмортизацияЗаПериодРегл = ЗначенияПараметров.АмортизацияЗаПериодРегл + ДанныеСтроки.АмортизацияРегл;
			ЗначенияПараметров.АмортизацияЗаПериодПР = ЗначенияПараметров.АмортизацияЗаПериодПР + ДанныеСтроки.АмортизацияПР;
			ЗначенияПараметров.АмортизацияЗаПериодЦФ = ЗначенияПараметров.АмортизацияЗаПериодЦФ + ДанныеСтроки.АмортизацияЦФ;
			ЗначенияПараметров.АмортизацияЗаПериодПРЦФ = ЗначенияПараметров.АмортизацияЗаПериодПРЦФ + ДанныеСтроки.АмортизацияПРЦФ;
				
		КонецЕсли;
		
		АмортизацияЗаПериодРегл = АмортизацияЗаПериодРегл + ДанныеСтроки.АмортизацияРегл;
		АмортизацияЗаПериодПР = АмортизацияЗаПериодПР + ДанныеСтроки.АмортизацияПР;
		АмортизацияЗаПериодЦФ = АмортизацияЗаПериодЦФ + ДанныеСтроки.АмортизацияЦФ;
		АмортизацияЗаПериодПРЦФ = АмортизацияЗаПериодПРЦФ + ДанныеСтроки.АмортизацияПРЦФ;
		
	КонецЦикла;
	
	КолонкиСуммирования = Новый Массив;
	КолонкиСуммирования.Добавить("АмортизацияБУ");
	КолонкиСуммирования.Добавить("АмортизацияПР");
	КолонкиСуммирования.Добавить("АмортизацияЦФ");
	КолонкиСуммирования.Добавить("АмортизацияРеглИзменение");
	КолонкиСуммирования.Добавить("АмортизацияПРИзменение");
	КолонкиСуммирования.Добавить("АмортизацияЦФИзменение");
	КолонкиСуммирования.Добавить("АмортизацияПРЦФИзменение");
	
	СгруппироватьПараметрыЗаПериод(
		ПараметрыЗаПериодБУ, 
		КолонкиСуммирования, 
		ПрименяетсяФСБУ6 И Параметры.ПорядокНачисленияАмортизацииРегл = Перечисления.ПорядокНачисленияАмортизации.СДатыПринятияКУчету);	
	
	ПараметрыДляРасчета.Вставить("ПараметрыЗаПериодБУ", ПараметрыЗаПериодБУ);
	
	ОбщегоНазначенияУТ.УничтожитьВременныеТаблицы(Параметры.МенеджерВременныхТаблиц,, ИспользуемыеВТ);
	
КонецПроцедуры

Процедура СгруппироватьПараметрыЗаПериод(ПараметрыЗаПериод, КолонкиСуммирования, СДатыПринятияКУчету) Экспорт
	
	СтрокиКУдалению = Новый Массив;
	
	ВсегоСтрок = ПараметрыЗаПериод.Количество();
		
	Если СДатыПринятияКУчету Тогда
			
		// Нужно оставить только последнюю строку дня
		 
		Для Сч = 1 По ВсегоСтрок Цикл

			ДанныеСтроки = ПараметрыЗаПериод[Сч - 1];
			
			Если Сч < ВсегоСтрок 
				И НачалоДня(ДанныеСтроки.Дата) = НачалоДня(ПараметрыЗаПериод[Сч].Дата) Тогда
				
				Для Каждого ИмяКолонки Из КолонкиСуммирования Цикл
					ПараметрыЗаПериод[Сч][ИмяКолонки] = ПараметрыЗаПериод[Сч][ИмяКолонки] + ДанныеСтроки[ИмяКолонки];
				КонецЦикла;
				
				СтрокиКУдалению.Добавить(ДанныеСтроки);
			КонецЕсли;
			
			ДанныеСтроки.Дата = КонецДня(ДанныеСтроки.Дата);
			
		КонецЦикла;
		
	Иначе
			
		// Нужно оставить только первую строку месяца 
		
		Для Сч = -ВсегоСтрок По -1 Цикл
			
			ДанныеСтроки = ПараметрыЗаПериод[-Сч - 1];
			
			Если Сч < -1 
				И Месяц(ДанныеСтроки.Дата) = Месяц(ПараметрыЗаПериод[-Сч-2].Дата) Тогда
				
				Для Каждого ИмяКолонки Из КолонкиСуммирования Цикл
					ПараметрыЗаПериод[-Сч-2][ИмяКолонки] = ПараметрыЗаПериод[-Сч-2][ИмяКолонки] + ДанныеСтроки[ИмяКолонки];
				КонецЦикла;
				
				СтрокиКУдалению.Добавить(ДанныеСтроки);
			КонецЕсли;
			
			ДанныеСтроки.Дата = КонецМесяца(ДанныеСтроки.Дата);
			
		КонецЦикла;
		
	КонецЕсли;
		
	Для Каждого Элемент Из СтрокиКУдалению Цикл
		ПараметрыЗаПериод.Удалить(Элемент);
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#КонецЕсли
