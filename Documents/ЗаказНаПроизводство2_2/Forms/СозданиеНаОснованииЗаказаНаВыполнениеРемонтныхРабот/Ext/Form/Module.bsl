#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	УстановитьУсловноеОформление();
	
	ЗаполнитьТоварыПоДокументу();
	
	НастроитьЭлементыФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Для каждого Строка Из Товары.ПолучитьЭлементы() Цикл
		Элементы.Товары.Развернуть(Строка.ПолучитьИдентификатор(), Истина);
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыТовары

&НаКлиенте
Процедура ТоварыКЗаказуПриИзменении(Элемент)
	
	СтрокаТовары = Элементы.Товары.ТекущиеДанные;
	СтрокаТовары.Отметка = СтрокаТовары.КЗаказу > 0;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура УстановитьФлажки(Команда)
	
	УстановитьСнятьФлажки(ЭтотОбъект, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура СнятьФлажки(Команда)
	
	УстановитьСнятьФлажки(ЭтотОбъект, Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьДокумент(Команда)
	
	Закрыть(РезультатНаСервере());
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	//
	ЭлементУсловногоОформления = УсловноеОформление.Элементы.Добавить();

	ПолеЭлемента = ЭлементУсловногоОформления.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.ТоварыОтметка.Имя);

	ОтборЭлемента = ЭлементУсловногоОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Товары.Номенклатура");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено;
	
	ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("Отображать", Ложь);
	
	//
	ЭлементУсловногоОформления = УсловноеОформление.Элементы.Добавить();
	
	ПолеЭлемента = ЭлементУсловногоОформления.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.ТоварыНаименование.Имя);
	
	ОтборЭлемента = ЭлементУсловногоОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Товары.Уровень");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = 0;
	
	ОтборЭлемента = ЭлементУсловногоОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Товары.РемонтируемоеИзделиеНоменклатура");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено;
	
	ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ПоясняющийТекст);
	ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru = '<любое изделие>';
																					|en = '<any product>'"));
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТоварыПоДокументу()
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", Параметры.СсылкаНаДокумент);
	
	Если ТипЗнч(Параметры.СсылкаНаДокумент) = Тип("ДокументСсылка.ЭтапПроизводства2_2") Тогда
		
		Запрос.Текст = "
		|ВЫБРАТЬ
		|	МИНИМУМ(Таблица.НомерСтроки)                      КАК НомерСтроки,
		|	Таблица.РемонтируемоеИзделиеНоменклатура          КАК РемонтируемоеИзделиеНоменклатура,
		|	Таблица.РемонтируемоеИзделиеХарактеристика        КАК РемонтируемоеИзделиеХарактеристика,
		|	Таблица.РемонтируемоеИзделиеСерия                 КАК РемонтируемоеИзделиеСерия,
		|	Таблица.Номенклатура                              КАК Номенклатура,
		|	Таблица.Характеристика                            КАК Характеристика,
		|	Таблица.Серия                                     КАК Серия,
		|	Таблица.Спецификация                              КАК Спецификация,
		|	Таблица.Назначение                                КАК Назначение,
		|	Таблица.Подразделение                             КАК Подразделение,
		|	СУММА(Таблица.Количество)                         КАК КоличествоПоДокументу,
		|	СУММА(Таблица.Количество)                         КАК КЗаказу,
		|	0                                                 КАК Количество,
		|	0                                                 КАК КоличествоУпаковок
		|ИЗ
		|	Документ.ЭтапПроизводства2_2.ОбеспечениеМатериаламиИРаботами КАК Таблица
		|ГДЕ
		|	Таблица.Ссылка = &Ссылка
		|	И Таблица.Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Работа)
		|	И НЕ Таблица.Отменено
		|	И НЕ Таблица.Номенклатура = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
		|
		|СГРУППИРОВАТЬ ПО
		|	Таблица.РемонтируемоеИзделиеНоменклатура,
		|	Таблица.РемонтируемоеИзделиеХарактеристика,
		|	Таблица.РемонтируемоеИзделиеСерия,
		|	Таблица.Номенклатура,
		|	Таблица.Характеристика,
		|	Таблица.Серия,
		|	Таблица.Упаковка,
		|	Таблица.Спецификация,
		|	Таблица.Подразделение,
		|	Таблица.Назначение
		|
		|УПОРЯДОЧИТЬ ПО
		|	РемонтируемоеИзделиеНоменклатура,
		|	РемонтируемоеИзделиеХарактеристика,
		|	РемонтируемоеИзделиеСерия,
		|	НомерСтроки
		|";
		
		СтрокаРодитель = Неопределено;
		
		ТаблицаТовары = Запрос.Выполнить().Выгрузить();
		Для каждого Строка Из ТаблицаТовары Цикл
			
			Если СтрокаРодитель = Неопределено
				ИЛИ СтрокаРодитель.РемонтируемоеИзделиеНоменклатура <> Строка.РемонтируемоеИзделиеНоменклатура
				ИЛИ СтрокаРодитель.РемонтируемоеИзделиеХарактеристика <> Строка.РемонтируемоеИзделиеХарактеристика
				ИЛИ СтрокаРодитель.РемонтируемоеИзделиеСерия <> Строка.РемонтируемоеИзделиеСерия Тогда
				СтрокаРодитель = Товары.ПолучитьЭлементы().Добавить();
				СтрокаРодитель.РемонтируемоеИзделиеНоменклатура   = Строка.РемонтируемоеИзделиеНоменклатура;
				СтрокаРодитель.РемонтируемоеИзделиеХарактеристика = Строка.РемонтируемоеИзделиеХарактеристика;
				СтрокаРодитель.РемонтируемоеИзделиеСерия          = Строка.РемонтируемоеИзделиеСерия;
				СтрокаРодитель.Наименование = НоменклатураКлиентСервер.ПредставлениеНоменклатуры(
					СтрокаРодитель.РемонтируемоеИзделиеНоменклатура,
					СтрокаРодитель.РемонтируемоеИзделиеХарактеристика,,
					СтрокаРодитель.РемонтируемоеИзделиеСерия);
				СтрокаРодитель.Уровень = 0;
			КонецЕсли;
			
			НоваяСтрока = СтрокаРодитель.ПолучитьЭлементы().Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
			НоваяСтрока.Наименование = НоменклатураКлиентСервер.ПредставлениеНоменклатуры(
				НоваяСтрока.Номенклатура, НоваяСтрока.Характеристика,, НоваяСтрока.Серия);
			НоваяСтрока.Уровень = 1;
			НоваяСтрока.Отметка = Истина;
			
		КонецЦикла;
		
		Шаблон = ТаблицаТовары.СкопироватьКолонки("Номенклатура,Характеристика,Серия,Спецификация,Подразделение,Назначение,Количество,КоличествоУпаковок");
		ШаблонАдрес = ПоместитьВоВременноеХранилище(Шаблон, УникальныйИдентификатор)
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура НастроитьЭлементыФормы()
	
	Если Товары.ПолучитьЭлементы().Количество() > 1 Тогда
		Элементы.ФормаСоздатьДокумент.Заголовок = НСтр("ru = 'Создать документы';
														|en = 'Create documents'");
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция РезультатНаСервере()
	
	Результат = Новый Структура;
	Результат.Вставить("Основание", Параметры.СсылкаНаДокумент);
	Результат.Вставить("ДанныеЗаполнения", Новый Массив);
	
	Шаблон = ПолучитьИзВременногоХранилища(ШаблонАдрес); // ТаблицаЗначений
	
	Для каждого СтрокаИзделие Из Товары.ПолучитьЭлементы() Цикл
		ТаблицаТовары = Шаблон.СкопироватьКолонки(); 
		Для каждого СтрокаРабота Из СтрокаИзделие.ПолучитьЭлементы() Цикл
			Если СтрокаРабота.Отметка Тогда
				НоваяСтрока = ТаблицаТовары.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаРабота);
				НоваяСтрока.Количество = СтрокаРабота.КЗаказу;
				НоваяСтрока.КоличествоУпаковок = СтрокаРабота.КЗаказу;
			КонецЕсли;
		КонецЦикла;
		Если ТаблицаТовары.Количество() > 0 Тогда
			ДанныеЗаполнения = ДанныеЗаполненияКонструктор();
			ДанныеЗаполнения.РеквизитыШапки.РемонтируемоеИзделиеНоменклатура   = СтрокаИзделие.РемонтируемоеИзделиеНоменклатура;
			ДанныеЗаполнения.РеквизитыШапки.РемонтируемоеИзделиеХарактеристика = СтрокаИзделие.РемонтируемоеИзделиеХарактеристика;
			ДанныеЗаполнения.РеквизитыШапки.РемонтируемоеИзделиеСерия          = СтрокаИзделие.РемонтируемоеИзделиеСерия;
			ДанныеЗаполнения.АдресТовары = ПоместитьВоВременноеХранилище(ТаблицаТовары, Новый УникальныйИдентификатор());
			Результат.ДанныеЗаполнения.Добавить(ДанныеЗаполнения);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьСнятьФлажки(Форма, Значение)
	
	Для каждого СтрокаИзделие Из Форма.Товары.ПолучитьЭлементы() Цикл
		Для каждого СтрокаРабота Из СтрокаИзделие.ПолучитьЭлементы() Цикл
			СтрокаРабота.Отметка = Значение;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ДанныеЗаполненияКонструктор()
	
	РеквизитыШапки = Новый Структура;
	РеквизитыШапки.Вставить("ТипПроизводственногоПроцесса", ПредопределенноеЗначение("Перечисление.ТипыПроизводственныхПроцессов.ВыполнениеРемонтныхРабот"));
	РеквизитыШапки.Вставить("РемонтируемоеИзделиеНоменклатура");
	РеквизитыШапки.Вставить("РемонтируемоеИзделиеХарактеристика");
	РеквизитыШапки.Вставить("РемонтируемоеИзделиеСерия");
	
	Возврат Новый Структура("РеквизитыШапки, АдресТовары", РеквизитыШапки);
	
КонецФункции

#КонецОбласти