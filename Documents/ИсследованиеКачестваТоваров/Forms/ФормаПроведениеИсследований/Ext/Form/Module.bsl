&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьОтборНаИсследовании(Форма)
	
	ОтборНаИсследовании = ОбщегоНазначенияКлиентСервер.СоздатьГруппуЭлементовОтбора(
		Форма.Список.КомпоновщикНастроек.ФиксированныеНастройки.Отбор.Элементы,
		НСтр("ru = 'Исследование';
			|en = 'Research'"),
		ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИ);
	
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(
		ОтборНаИсследовании,
		"Проведен",
		ВидСравненияКомпоновкиДанных.Равно,
		Истина,
		,
		Истина);
			
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(
		ОтборНаИсследовании,
		"Завершено",
		ВидСравненияКомпоновкиДанных.Равно,
		Форма.ОтборЗавершено,
		,
		Истина);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьОтборБезОтклонений(Форма)
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
		Форма.Список,
		"ЕстьОтклонения",
		Истина,
		ВидСравненияКомпоновкиДанных.НеРавно,
		, 
		Истина);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьОтборСОтклонениями(Форма)
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
		Форма.Список,
		"ЕстьОтклонения",
		Истина,
		ВидСравненияКомпоновкиДанных.Равно,
		, 
		Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьОтбор()
	
	СтруктураОтбора = СтруктураОтбораИсследований();
	
	Для каждого Элемент Из СтруктураОтбора Цикл
		ОбщегоНазначенияКлиентСервер.УдалитьЭлементыГруппыОтбораДинамическогоСписка(Список, Элемент.Ключ); 
	КонецЦикла;

	ОтборЗаявкаНаКонтроль			= Неопределено;
	ОтборНоменклатура				= Неопределено;
	ОтборКартаИсследованияТоваров	= Неопределено;
	ОтборОтветственный				= Неопределено;
	ОтборЗавершено 					= Ложь;
	ОтборБезОтклонений 				= Ложь;
	ОтборСОтклонениями 				= Ложь;
	ОтборНаИсследовании 			= Ложь;
	ОтборВсе 						= Истина;
	
	НастроитьЗависимыеЭлементыФормы(ЭтотОбъект, "Отбор");
	
КонецПроцедуры

&НаКлиенте
Функция СтруктураОтбораИсследований()
	
	СтруктураОтбора = Новый Структура;
	СтруктураОтбора.Вставить("ЗаявкаНаКонтроль");
	СтруктураОтбора.Вставить("Номенклатура");
	СтруктураОтбора.Вставить("КартаИсследованияТоваров");
	СтруктураОтбора.Вставить("Ответственный");
	СтруктураОтбора.Вставить("Завершено");
	СтруктураОтбора.Вставить("Проведен");
	СтруктураОтбора.Вставить("ЕстьОтклонения");
	СтруктураОтбора.Вставить("Исследование");
	
	Возврат СтруктураОтбора;
	
КонецФункции

#КонецОбласти

#Область УправлениеНастройками

&НаСервере
Процедура ВосстановитьНастройкиФормыПриСоздании()
	
	НастройкиФормы = ХранилищеНастроекДанныхФорм.Загрузить(
		МенеджерНастроекКлючОбъекта(), МенеджерНастроекКлючНастроек());
	Если ЗначениеЗаполнено(НастройкиФормы) Тогда
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, НастройкиФормы);
	КонецЕсли; 
	
	УстановитьОтборЗаявкаНаКонтроль(ЭтотОбъект);
	УстановитьОтборНоменклатура();
	УстановитьОтборКартаИсследованияТоваров(ЭтотОбъект);
	УстановитьОтборОтветственный(ЭтотОбъект);
	
	Если ОтборНаИсследовании Или ОтборЗавершено Тогда
		УстановитьОтборНаИсследовании(ЭтотОбъект);
	КонецЕсли;
	Если ОтборБезОтклонений Тогда
		УстановитьОтборБезОтклонений(ЭтотОбъект);
	КонецЕсли;
	Если ОтборСОтклонениями Тогда
		УстановитьОтборСОтклонениями(ЭтотОбъект);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура СохранитьНастройкиФормы()
	
	НастройкиФормы = СохраняемыеНастройкиФормы();
	
	ЗаполнитьЗначенияСвойств(НастройкиФормы, ЭтотОбъект);
	ХранилищеНастроекДанныхФорм.Сохранить(
		МенеджерНастроекКлючОбъекта(), МенеджерНастроекКлючНастроек(), НастройкиФормы);
	
КонецПроцедуры

&НаСервере
Функция СохраняемыеНастройкиФормы()
	
	Результат = Новый Структура;
	Результат.Вставить("ОтборЗаявкаНаКонтроль");
	Результат.Вставить("ОтборНоменклатура");
	Результат.Вставить("ОтборКартаИсследованияТоваров");
	Результат.Вставить("ОтборОтветственный");
	Результат.Вставить("ОтборВсе");
	Результат.Вставить("ОтборЗавершено");
	Результат.Вставить("ОтборНаИсследовании");
	Результат.Вставить("ОтборСОтклонениями");
	Результат.Вставить("ОтборБезОтклонений");
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция МенеджерНастроекКлючОбъекта()
	
	Возврат "Исследования";
	
КонецФункции

&НаСервере
Функция МенеджерНастроекКлючНастроек()
	
	Возврат "НастройкиФормы";
	
КонецФункции

#КонецОбласти

#Область Прочее

&НаСервере
Процедура УстановитьУсловноеОформление()

	УсловноеОформление.Элементы.Очистить();
	
	СтандартныеПодсистемыСервер.УстановитьУсловноеОформлениеПоляДата(ЭтотОбъект);
	
	// выделение цветом просроченного исследования
	#Область ПросроченныеИсследования
	
	Элемент = УсловноеОформление.Элементы.Добавить();
	
	Элемент.Поля.Элементы.Добавить().Поле = Новый ПолеКомпоновкиДанных("СрокВыполнения");
	
	ГруппаОтбора1 = Элемент.Отбор.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
	ГруппаОтбора1.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИ;
	
	ОтборЭлемента = ГруппаОтбора1.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Список.СрокВыполнения");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Меньше;
	ОтборЭлемента.ПравоеЗначение = ТекущаяДатаСеанса();
	
	ОтборЭлемента = ГруппаОтбора1.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Список.Завершено");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Ложь;
	
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ПросроченныйДокумент);
	
	#КонецОбласти
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура НастроитьЗависимыеЭлементыФормы(Форма, СписокРеквизитов = "")
	
	Элементы = Форма.Элементы;
	
	Инициализация = ПустаяСтрока(СписокРеквизитов);
	СтруктураРеквизитов = Новый Структура(СписокРеквизитов);
	
	Если Инициализация Или СтруктураРеквизитов.Свойство("Отбор") Тогда
		
		УстановитьСостояниеГиперссылки(Форма, Элементы.ГиперссылкаВсе, Форма.ОтборВсе);
		УстановитьСостояниеГиперссылки(Форма, Элементы.ГиперссылкаНаИсследовании, Форма.ОтборНаИсследовании);
		УстановитьСостояниеГиперссылки(Форма, Элементы.ГиперссылкаЗавершены, Форма.ОтборЗавершено);
		УстановитьСостояниеГиперссылки(Форма, Элементы.ГиперссылкаБезОтклонений, Форма.ОтборБезОтклонений);
		УстановитьСостояниеГиперссылки(Форма, Элементы.ГиперссылкаСОтклонениями, Форма.ОтборСОтклонениями);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьСостояниеГиперссылки(Форма, Элемент, Нажата)
	
	Если Нажата Тогда
		Элемент.ЦветФона = Форма.Кэш.ЦветНажатогоОтбора;
	Иначе
		Элемент.ЦветФона = Новый Цвет();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ИнициализироватьКэш()
	
	Кэш = Новый Структура;
	
	Кэш.Вставить("ЦветНажатогоОтбора", ЦветаСтиля.БыстрыеОтборыФонГиперссылки);
	Кэш.Вставить("ДанныеТекущейСтроки", Неопределено);
	
КонецПроцедуры

&НаСервере
Функция СписокИсследованийСОформленнымиАктамиКонтроляКачества(СписокИсследований, ЗаявкаНаКонтроль)
	Возврат ИсследованиеТоваров.СписокИсследованийСОформленнымиАктамиКонтроляКачества(СписокИсследований, ЗаявкаНаКонтроль);
КонецФункции

#КонецОбласти

#КонецОбласти
