&НаСервереБезКонтекста
Процедура СписокПриПолученииДанныхНаСервере(ИмяЭлемента, Настройки, Строки)
	
	Шаблон = НСтр("ru = '%1 %2 %3';
					|en = '%1 %2 %3'");
	Шаблон2 = НСтр("ru = '%1 и еще %2';
					|en = '%1 and %2 more'");
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ИсследованиеКачестваТоваровПланИРезультатИсследования.Ссылка КАК Ссылка,
		|	ИсследованиеКачестваТоваровПланИРезультатИсследования.Номенклатура,
		|	ИсследованиеКачестваТоваровПланИРезультатИсследования.Характеристика,
		|	ИсследованиеКачестваТоваровПланИРезультатИсследования.Серия,
		|	ИсследованиеКачестваТоваровПланИРезультатИсследования.Назначение
		|ИЗ
		|	Документ.ИсследованиеКачестваТоваров.ПланИРезультатИсследования КАК
		|		ИсследованиеКачестваТоваровПланИРезультатИсследования
		|ГДЕ
		|	ИсследованиеКачестваТоваровПланИРезультатИсследования.Ссылка В (&Ссылки)
		|ИТОГИ
		|ПО
		|	Ссылка";
	
	Запрос.УстановитьПараметр("Ссылки", Строки.ПолучитьКлючи());
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаСсылка = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаСсылка.Следующий() Цикл
		
		ПерваяПозиция = Истина;
		КоличествоПозиций = 1;
		ВыборкаДетальныеЗаписи = ВыборкаСсылка.Выбрать();
	
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			Если ПерваяПозиция Тогда
				ПерваяПозиция = Ложь;
				Представление = НоменклатураКлиентСервер.ПредставлениеНоменклатуры(ВыборкаДетальныеЗаписи.Номенклатура,
					ВыборкаДетальныеЗаписи.Характеристика, , ВыборкаДетальныеЗаписи.Серия, ВыборкаДетальныеЗаписи.Назначение);
			Иначе
				КоличествоПозиций = КоличествоПозиций + 1;
			КонецЕсли;
		КонецЦикла;
		
		СтрокаСписка = Строки[ВыборкаСсылка.Ссылка];
		Если КоличествоПозиций > 1 Тогда
			ПредставлениеКоличествоПозиций = ПолучитьСклоненияСтрокиПоЧислу("позиция", КоличествоПозиций-1,
				"","ЧС=Количественное", "ПД=Именительный; ПЧ=Число");
			СтрокаСписка.Данные["Товар"] = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Шаблон2, СокрЛП(Представление), ПредставлениеКоличествоПозиций[0]);
		Иначе
			СтрокаСписка.Данные["Товар"] = Представление;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

