#Область СлужебныеПроцедурыИФункции

#Область АктКонтроляКачества

&НаКлиенте
Функция ПолучитьПараметрыФормыАктаКонтроляКачества()
	
	СписокИсследований = Новый Массив;
	
	ВыделенныеСтроки = Элементы.Список.ВыделенныеСтроки;
	
	Если ВыделенныеСтроки.Количество() = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Не выбраны строки, команда не может быть выполнена.';
										|en = 'No lines are selected, cannot run the command.'"));
		Возврат Неопределено;
	КонецЕсли;
	
	ДанныеСтроки = Элементы.Список.ДанныеСтроки(Элементы.Список.ВыделенныеСтроки[0]);
	ЗаявкаНаКонтроль = ДанныеСтроки.ЗаявкаНаКонтроль;
	
	Для Каждого Строка Из ВыделенныеСтроки Цикл

		ДанныеСтроки = Элементы.Список.ДанныеСтроки(Строка);

		Если ДанныеСтроки.ЗаявкаНаКонтроль <> ЗаявкаНаКонтроль Тогда
			ПоказатьПредупреждение( , НСтр(
				"ru = 'Выбраны исследования по разным заявкам на контроль, команда не может быть выполнена.';
				|en = 'Research for different control requests is selected. Cannot run the command.'"));
			Возврат Неопределено;
		КонецЕсли;

		Если Не ДанныеСтроки.Завершено Тогда
			ПоказатьПредупреждение( , НСтр("ru = 'Не все исследования завершены, команда не может быть выполнена.';
											|en = 'Not all the research is done. Cannot run the command.'"));
			Возврат Неопределено;
		КонецЕсли;
		
		Если Не ДанныеСтроки.Проведен Тогда
			ПоказатьПредупреждение( , НСтр("ru = 'Не все исследования проведены, команда не может быть выполнена.';
											|en = 'Not all the research is done. Cannot run the command.'"));
			Возврат Неопределено;
		КонецЕсли;

		СписокИсследований.Добавить(ДанныеСтроки.Ссылка);

	КонецЦикла;
	
	СписокИсследованийСОформленнымиАктамиКонтроляКачества = СписокИсследованийСОформленнымиАктамиКонтроляКачества(СписокИсследований, ЗаявкаНаКонтроль);
	
	СписокИсследований = ОбщегоНазначенияКлиентСервер.РазностьМассивов(СписокИсследований, СписокИсследованийСОформленнымиАктамиКонтроляКачества);
	
	Если СписокИсследований.Количество() = 0 Тогда
		ПоказатьПредупреждение( , НСтр("ru = 'По выбранным исследованиям акты контроля качества уже оформлены.';
										|en = 'Quality control certificates are already issued for the selected research.'"));
		Возврат Неопределено;
	КонецЕсли;
		
	ДанныеЗаполнения = Новый Структура;
	ДанныеЗаполнения.Вставить("ДокументОснование", ЗаявкаНаКонтроль);
	ДанныеЗаполнения.Вставить("ПоДокументамИсследования", СписокИсследований);
	
	ПараметрыФормы = Новый Структура("Основание", ДанныеЗаполнения);
	
	Возврат ПараметрыФормы;
	
КонецФункции

