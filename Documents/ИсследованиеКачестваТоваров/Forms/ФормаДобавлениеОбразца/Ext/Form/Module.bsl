
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("АвтоТест") Тогда // Возврат при получении формы для анализа.
		Возврат;
	КонецЕсли;
	
	Номенклатура 	= Параметры.Номенклатура;
	Образец 		= Параметры.Образец;
	ХарактеристикиИспользуются = Параметры.ХарактеристикиИспользуются;
	Если ХарактеристикиИспользуются И ЗначениеЗаполнено(Параметры.Характеристика) Тогда
		Элементы.Характеристика.СписокВыбора.Очистить();
		Элементы.Характеристика.СписокВыбора.Добавить(Параметры.Характеристика, Строка(Параметры.Характеристика));
		Характеристика = Элементы.Характеристика.СписокВыбора[0].Значение;
	КонецЕсли;
	СписокВыбораХарактеристика.ЗагрузитьЗначения(Параметры.СписокВыбораХарактеристика);
	Элементы.Номенклатура.СписокВыбора.ЗагрузитьЗначения(Параметры.СписокВыбораНоменклатура);
	УстановитьУсловноеОформление();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ХарактеристикаНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	Элемент.СписокВыбора.Очистить();
	СписокХарактеристик = НайтиВМассивеСтруктурХарактеристики(СписокВыбораХарактеристика.ВыгрузитьЗначения(), Номенклатура, "Номенклатура");
	Для Каждого ЭлементМассива Из СписокХарактеристик Цикл
		Элемент.СписокВыбора.Добавить(ЭлементМассива, Строка(ЭлементМассива));
	КонецЦикла;
	Если Не ЗначениеЗаполнено(Характеристика) И СписокХарактеристик.Количество() > 0 Тогда
		Характеристика = Элементы.Характеристика.СписокВыбора[0].Значение;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НоменклатураПриИзменении(Элемент)
	
	ИспользоватьХарактеристики();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура КомандаОК(Команда)
	
	ЗавершитьРедактирование();
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаОтмена(Команда)
	
	Модифицированность = Ложь;
	
	Закрыть();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ЗавершитьРедактирование()
		
	Закрыть(Новый Структура("Образец,Номенклатура,Характеристика",Образец, Номенклатура, Характеристика));
	
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	ИспользоватьХарактеристикиНоменклатуры = ПолучитьФункциональнуюОпцию("ИспользоватьХарактеристикиНоменклатуры");
	Элементы.Характеристика.Видимость = ИспользоватьХарактеристикиНоменклатуры;
	
	НастроитьЗависимыеЭлементы();

КонецПроцедуры

&НаСервере
Процедура НастроитьЗависимыеЭлементы()
	
	Если ХарактеристикиИспользуются Тогда
		Элементы.Характеристика.Доступность = Истина;
		Элементы.Характеристика.ПодсказкаВвода = "";
	Иначе
		Элементы.Характеристика.Доступность = Ложь;
		Элементы.Характеристика.ПодсказкаВвода = НСтр("ru = '<характеристики не используются>';
														|en = '<variants are not used>'");
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция НайтиВМассивеСтруктурХарактеристики(Массив, ИскомоеЗначение, Ключ)
	
	Результат = Новый Массив;
	Для Каждого ЭлементМассива Из Массив Цикл
		Если ЭлементМассива[Ключ] = ИскомоеЗначение Тогда
			Результат.Добавить(ЭлементМассива["Характеристика"]);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ИспользоватьХарактеристики()
	
	ХарактеристикиИспользуются = Справочники.Номенклатура.ХарактеристикиИспользуются(Номенклатура);
	НастроитьЗависимыеЭлементы();
	
КонецПроцедуры

#КонецОбласти
