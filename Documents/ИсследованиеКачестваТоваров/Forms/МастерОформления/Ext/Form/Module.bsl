#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	УстановитьУсловноеОформление();
	
	Если Параметры.Свойство("АвтоТест") Тогда // Возврат при получении формы для анализа.
		Возврат;
	КонецЕсли;
		
	ЗаявкаНаКонтроль = Параметры.ЗаявкаНаКонтроль;
	СписокТоваровТЧ = Параметры.СписокТоваров;
	ВсеСтроки = Параметры.ВсеСтроки;
	
	ВосстановитьНастройкиФормыПриСоздании();
	
	Если СписокТоваровТЧ.Количество() > 0 Тогда
		МассивСтруктурВТаблицуЗначений(СписокТоваровТЧ, СписокТоваров);
	КонецЕсли;
	
	УстановитьСвойстваДинамическогоСпискаПроверки(Справочники.КартыИсследованияТоваров.ПустаяСсылка());
	
	УстановитьСтраницыМастера(ЭтотОбъект, "ФормированиеИсследований");
	
	СформироватьДеревоНазначенияИсследованийНаСервере(ЗаявкаНаКонтроль, ВсеСтроки, Неопределено, Неопределено);
	
	НастроитьЗависимыеЭлементыФормы(ЭтотОбъект);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ДеревоНоменклатураПриИзменении(Элемент)
	
	ОчиститьСообщения();
	ТоварыКИсследованию.ПолучитьЭлементы().Очистить();
	СформироватьДеревоНазначенияИсследованийНаСервере(ЗаявкаНаКонтроль, ВсеСтроки, ?(ЗначениеЗаполнено(ДеревоНоменклатура),
		ДеревоНоменклатура, Неопределено), ?(ЗначениеЗаполнено(ДеревоВидКонтроля), ДеревоВидКонтроля, Неопределено));
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоВидКонтроляПриИзменении(Элемент)
	
	ОчиститьСообщения();
	ТоварыКИсследованию.ПолучитьЭлементы().Очистить();
	СформироватьДеревоНазначенияИсследованийНаСервере(ЗаявкаНаКонтроль, ВсеСтроки, ?(ЗначениеЗаполнено(ДеревоНоменклатура),
		ДеревоНоменклатура, Неопределено), ?(ЗначениеЗаполнено(ДеревоВидКонтроля), ДеревоВидКонтроля, Неопределено));
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыКИсследованиюИсполнительПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ТоварыКИсследованию.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТекущиеДанные.ПолучитьРодителя() = Неопределено Тогда
		Для Каждого Строка Из ТекущиеДанные.ПолучитьЭлементы() Цикл
			Строка.Исполнитель = ТекущиеДанные.Исполнитель;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыКИсследованиюИсследоватьПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ТоварыКИсследованию.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекущиеДанные.Исследовать) Тогда
		ТекущиеДанные.ВыбратьПозицию = Истина;
	Иначе
		ТекущиеДанные.ВыбратьПозицию = Ложь;
	КонецЕсли;
	
	Родитель = ТекущиеДанные.ПолучитьРодителя();
	
	Если Родитель <> Неопределено Тогда
		ОбновитьВыборРодительскихСтрок(ТекущиеДанные.ПолучитьИдентификатор());
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НесколькоНоменклатурВИсследованииПриИзменении(Элемент)
	
	СохранитьНастройкиФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказыватьДеталиНажатие(Элемент)
	
	ПоказыватьДетали = Не ПоказыватьДетали;
	НастроитьЗависимыеЭлементыФормы(ЭтотОбъект, "ПоказыватьДетали");
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыТоварыКИсследованию

&НаКлиенте
Процедура ТоварыКИсследованиюВыбратьПозициюПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ТоварыКИсследованию.ТекущиеДанные;
	
	ВыбранПриИзмененииНаСервере(ТекущиеДанные.ПолучитьИдентификатор());
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыКИсследованиюПриАктивизацииСтроки(Элемент)
	
	ТекущиеДанные = Элементы.ТоварыКИсследованию.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	УстановитьСвойстваДинамическогоСпискаПроверки(ТекущиеДанные.КартаИсследованияТоваров);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Далее(Команда)
	
	ОчиститьСообщения();
	
	Если Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.СтраницаМастер Тогда
	
		ПерейтиКШагуПредварительныйПросмотр();
	
	ИначеЕсли Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.СтраницаПредварительныйПросмотр Тогда
		
		ПерейтиКШагуФормированияРезультата();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьИсполнителя(Команда)
	
	ОчиститьСообщения();
	
	ВыделенныеСтроки = Элементы.ТоварыКИсследованию.ВыделенныеСтроки;
	
	Если ТоварыКИсследованию.ПолучитьЭлементы().Количество() = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'В дереве ""Назначение исследований"" нет ни одной строки.';
										|en = 'There are no lines in the ""Assignment of research"" tree.'"));
		Возврат;
	ИначеЕсли ВыделенныеСтроки.Количество() = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'В дереве ""Назначение исследований"" не выбрано ни одной строки.';
										|en = 'No lines are selected in the ""Assignment of research"" tree.'"));
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ТабличнаяЧасть", ТоварыКИсследованию);
	ДополнительныеПараметры.Вставить("ВыделенныеСтроки", ВыделенныеСтроки);
	
	ПараметрыПодбора = Новый Структура;
	ПараметрыПодбора.Вставить("РежимВыбора", Истина);
	ПараметрыПодбора.Вставить("ЗакрыватьПриВыборе", Истина);
	ПараметрыПодбора.Вставить("МножественныйВыбор", Ложь);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ЗаполнитьИсполнителяЗавершение", ЭтотОбъект, ДополнительныеПараметры);

	ОткрытьФорму("Справочник.Пользователи.ФормаВыбора", ПараметрыПодбора,,,,, ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ИсключитьСтроки(Команда)
	
	Строки = ТоварыКИсследованию.ПолучитьЭлементы();
	Если Строки.Количество() > 0 Тогда
		ВыбратьИсключитьВыделенныеСтроки(Ложь);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьСтроки(Команда)
	
	Строки = ТоварыКИсследованию.ПолучитьЭлементы();
	Если Строки.Количество() > 0 Тогда
		ВыбратьИсключитьВыделенныеСтроки(Истина);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура Назад(Команда)
	
	ОчиститьСообщения();
	
	Если Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.СтраницаРезультат Тогда
		
		Если СозданныеОбъекты.Количество() > 0 Тогда
			
			Кнопки = Новый СписокЗначений;
			Кнопки.Добавить(КодВозвратаДиалога.Да, НСтр("ru = 'Пометить документы на удаление';
														|en = 'Mark documents for deletion'"));
			Кнопки.Добавить(КодВозвратаДиалога.Отмена);
			
			ПоказатьВопрос
				(Новый ОписаниеОповещения("НазадЗавершение", ЭтотОбъект), 
				НСтр("ru = 'Список созданных исследований не пуст. Сформированные документы будут помечены на удаление. Пометить на удаление документы исследования товаров и продолжить?';
					|en = 'The list of created research is not empty. The generated documents will be marked for deletion. Mark the goods research documents for deletion and continue?'"),
				Кнопки);
			Возврат;
		Иначе
			УстановитьСтраницыМастера(ЭтотОбъект, "ПредварительныйПросмотр");
		КонецЕсли;
		
	ИначеЕсли Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.СтраницаПредварительныйПросмотр Тогда
		
		ТоварыКПредпросмотру.ПолучитьЭлементы().Очистить();
		УстановитьСтраницыМастера(ЭтотОбъект, "ФормированиеИсследований");
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьЕще(Команда)
	
	ОчиститьСообщения();
	
	ТоварыКПредпросмотру.ПолучитьЭлементы().Очистить();
	ТоварыКИсследованию.ПолучитьЭлементы().Очистить();
	СформироватьДеревоНазначенияИсследованийНаСервере(ЗаявкаНаКонтроль, ВсеСтроки, Неопределено, Неопределено);
	УстановитьСтраницыМастера(ЭтотОбъект, "ФормированиеИсследований");
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область РезультатФормирования

&НаСервере
Процедура СоздатьДокументыНаСервере(Отказ)
	
	Данные = Неопределено;
	СписокРеквизитов = СтрРазделить("Номенклатура,Характеристика,Серия,Назначение,КартаИсследованияТоваров,КонтролируемаяПартия,Контроль,Исполнитель,Склад,Упаковка,Количество,Исследовать",",");
	ДеревоТоварыКИсследованию = РеквизитФормыВЗначение("ТоварыКИсследованию");
	ПреобразоватьДеревоВТаблицу(ДеревоТоварыКИсследованию, СписокРеквизитов, Данные);
	
	// Запуск формирования
	ОтменитьДлительнуюОперацию();
	
	ПараметрыПроцедуры = Новый Структура;
	ПараметрыПроцедуры.Вставить("Товары", Данные);
	ПараметрыПроцедуры.Вставить("ЗаявкаНаКонтроль", ЗаявкаНаКонтроль);
	ПараметрыПроцедуры.Вставить("НесколькоНоменклатурВИсследовании", НесколькоНоменклатурВИсследовании);
	
	АдресРезультатФормирования = ПоместитьВоВременноеХранилище(
		Документы.ИсследованиеКачестваТоваров.РезультатФормирования(), УникальныйИдентификатор);
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = НСтр("ru = 'Формирование исследований товаров: создание документов';
															|en = 'Generate goods research: create documents'");
	ПараметрыВыполнения.АдресРезультата = АдресРезультатФормирования;
	
	ДлительнаяОперация = ДлительныеОперации.ВыполнитьВФоне(
		"Документы.ИсследованиеКачестваТоваров.СоздатьДокументыОтложенно",
		ПараметрыПроцедуры,
		ПараметрыВыполнения);
	
	Если ДлительнаяОперация.Статус = "Выполняется" Тогда
		
		ОбработчикОжиданияДлительнойОперации = "СоздатьДокументыОтложенноЗавершение";
		НачатьОжиданиеДлительнойОперации = Истина;
		
	Иначе
		
		СоздатьДокументыОтложенно(ДлительнаяОперация);
		
		НачатьОжиданиеДлительнойОперации = Ложь;
		ДлительнаяОперация = Неопределено;
		
	КонецЕсли;
	
КонецПроцедуры

// Дерево в таблицу значений
// 
// Параметры:
// 	Дерево - ДеревоЗначений, СтрокаДереваЗначений -
// 	СписокРеквизитов - Структура - Список реквизитов дерева
// 	Таблица - ТаблицаЗначений, Неопределено -
// 	Исполнитель - СправочникСсылка.Пользователи - Исполнитель
// Возвращаемое значение:
// 	ТаблицаЗначений, Неопределено - Описание
&НаСервере
Функция ПреобразоватьДеревоВТаблицу(Дерево, СписокРеквизитов, Таблица = Неопределено, Исполнитель = Неопределено)
	
	Если Таблица = Неопределено Тогда
		Таблица = Новый ТаблицаЗначений;
		Для Каждого Колонка Из СписокРеквизитов Цикл
			Таблица.Колонки.Добавить(Колонка);
		КонецЦикла;
	КонецЕсли;
	
	Для Каждого СтрокаДерева Из Дерево.Строки Цикл
		
		Если ЗначениеЗаполнено(СтрокаДерева.Номенклатура) И СтрокаДерева.ВыбратьПозицию Тогда
			НоваяСтрока = Таблица.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаДерева);
			НоваяСтрока.Количество = СтрокаДерева.Исследовать;
			Если Не ЗначениеЗаполнено(НоваяСтрока.Исполнитель) И Исполнитель <> Неопределено Тогда
				НоваяСтрока.Исполнитель = Исполнитель;
			КонецЕсли;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаДерева.Исполнитель) Тогда
			Исполнитель = СтрокаДерева.Исполнитель;
		Иначе
			Исполнитель = Неопределено;
		КонецЕсли;
		
		ПреобразоватьДеревоВТаблицу(СтрокаДерева, СписокРеквизитов, Таблица, Исполнитель);
		
	КонецЦикла;
	
	Возврат Таблица;
	
КонецФункции

&НаКлиенте
Процедура СоздатьДокументыОтложенноЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ДлительнаяОперация = Неопределено;
	НастроитьОжиданиеВФорме(Ложь);
	
	СоздатьДокументыОтложенно(Результат);
	УстановитьСтраницыМастера(ЭтотОбъект, "РезультатФормирования");
	
	Если Результат <> Неопределено И Результат.Статус = "Ошибка" Тогда
		ПоказатьПредупреждение(, Результат.КраткоеПредставлениеОшибки);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура СоздатьДокументыОтложенно(Результат)

	Если ЭтоАдресВременногоХранилища(АдресРезультатФормирования) Тогда

		СтруктураРезультата = ПолучитьИзВременногоХранилища(АдресРезультатФормирования);
		АдресРезультатФормирования = Неопределено;

		СвойстваСписка = ОбщегоНазначения.СтруктураСвойствДинамическогоСписка();

		ТекстЗапроса = Документы.ИсследованиеКачестваТоваров.ТекстЗапросаДинамическогоСпискаИсследованияТоваров();
		СвойстваСписка.ТекстЗапроса = ТекстЗапроса;

		СвойстваСписка.ОсновнаяТаблица = "Документ.ИсследованиеКачестваТоваров";
		СвойстваСписка.ДинамическоеСчитываниеДанных = Истина;

		ОбщегоНазначения.УстановитьСвойстваДинамическогоСписка(Элементы.СписокДокументов, СвойстваСписка);

		СсылкиНаСозданныеДокументы = СтруктураРезультата.РезультатФормирования.ВыгрузитьКолонку(
			"ИсследованиеКачестваТоваров");

		ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(
									СписокДокументов, "Ссылки", СсылкиНаСозданныеДокументы, ЗначениеЗаполнено(
			СсылкиНаСозданныеДокументы));

		СозданныеОбъекты.ЗагрузитьЗначения(СтруктураРезультата.СозданныеОбъекты);

	КонецЕсли;

	Если ТипЗнч(Результат) = Тип("Структура") И Результат.Свойство("Сообщения") Тогда
		Для Каждого Сообщение Из Результат.Сообщения Цикл
			Сообщение.Сообщить();
		КонецЦикла;
	КонецЕсли;

	Если Результат = Неопределено Или Результат.Статус <> "Выполнено" Тогда
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Документы сформированы не полностью';
													|en = 'Documents are not fully generated'"));
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ОтменитьДлительнуюОперацию()
	
	Если НЕ ДлительнаяОперация = Неопределено Тогда
		ДлительныеОперации.ОтменитьВыполнениеЗадания(ДлительнаяОперация.ИдентификаторЗадания);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НачатьОжиданиеДлительнойОперации(ВыводитьОкноОжидания = Истина)
	
	ОповещениеОЗавершении = Новый ОписаниеОповещения(ОбработчикОжиданияДлительнойОперации, ЭтотОбъект);
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	
	ПараметрыОжидания.ВыводитьОкноОжидания = ВыводитьОкноОжидания;
	
	ДлительныеОперацииКлиент.ОжидатьЗавершение(
			ДлительнаяОперация,
			ОповещениеОЗавершении,
			ПараметрыОжидания);
	
	НачатьОжиданиеДлительнойОперации = Ложь;
	
КонецПроцедуры

&НаСервере
Процедура УдалитьСозданныеОбъекты(Отказ)
	
	ОтменитьДлительнуюОперацию();
	
	ПараметрыПроцедуры = Новый Структура("Ссылки", СозданныеОбъекты.ВыгрузитьЗначения());
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания =
		НСтр("ru = 'Назначение исследований: удаление созданных объектов';
			|en = 'Assignment of research: delete created objects'");
	
	ДлительнаяОперация = ДлительныеОперации.ВыполнитьВФоне(
		"Документы.ИсследованиеКачестваТоваров.УдалитьОбъектыОтложенно",
		ПараметрыПроцедуры,
		ПараметрыВыполнения);
	
	Если ДлительнаяОперация.Статус = "Выполняется" Тогда
		
		НачатьОжиданиеДлительнойОперации = Истина;
		ОбработчикОжиданияДлительнойОперации = "УдалитьСозданныеОбъектыОтложенноЗавершение";
		
	Иначе
		
		Если ДлительнаяОперация.Статус = "Ошибка" Тогда
			ВызватьИсключение ДлительнаяОперация.КраткоеПредставлениеОшибки;
		КонецЕсли;
		
		Если ДлительнаяОперация.Статус <> "Выполнено" Тогда
			Отказ = Истина;
		КонецЕсли;
		НачатьОжиданиеДлительнойОперации = Ложь;
		ДлительнаяОперация = Неопределено;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьСозданныеОбъектыОтложенноЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ДлительнаяОперация = Неопределено;
	НастроитьОжиданиеВФорме(Ложь);
	
	Если Результат <> Неопределено Тогда
		
		Если Результат.Статус = "Ошибка" Тогда
			ВызватьИсключение Результат.КраткоеПредставлениеОшибки;
		КонецЕсли;
		
		ПослеУдаленияСозданныхОбъектов(Результат.Статус <> "Выполнено");
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеУдаленияСозданныхОбъектов(Отказ)
	
	Если Не Отказ Тогда
		
		СозданныеОбъекты.Очистить();
		
		ПоказатьОповещениеПользователя(
			НСтр("ru = 'Удаление объектов';
				|en = 'Delete objects'"),
			,
			НСтр("ru = 'Сформированные объекты помечены на удаление.';
				|en = 'Generated objects are marked for deletion.'"));
		
		УстановитьСтраницыМастера(ЭтотОбъект, "ФормированиеИсследований");
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ПредварительныйПросмотр

&НаКлиенте
Процедура РазвернутьПредпросмотр(Команда)
	
	Для каждого Строка Из ТоварыКПредпросмотру.ПолучитьЭлементы() Цикл
		Если Не Элементы.ТоварыКПредпросмотру.Развернут(Строка.ПолучитьИдентификатор()) Тогда
			Элементы.ТоварыКПредпросмотру.Развернуть(Строка.ПолучитьИдентификатор());
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура СвернутьПредпросмотр(Команда)
	
	Для каждого Строка Из ТоварыКПредпросмотру.ПолучитьЭлементы() Цикл
		Если Элементы.ТоварыКПредпросмотру.Развернут(Строка.ПолучитьИдентификатор()) Тогда
			Элементы.ТоварыКПредпросмотру.Свернуть(Строка.ПолучитьИдентификатор());
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура СформироватьДанныеДляПредварительногоПросмотра(Отказ)
	
	Данные = Неопределено;
	СписокРеквизитов = СтрРазделить("Номенклатура,Характеристика,Серия,Назначение,КартаИсследованияТоваров,КонтролируемаяПартия,Контроль,Исполнитель,Склад,ЕдиницаИзмерения,Упаковка,Количество,Исследовать",",");
	ДеревоТоварыКИсследованию = РеквизитФормыВЗначение("ТоварыКИсследованию");
	ПреобразоватьДеревоВТаблицу(ДеревоТоварыКИсследованию, СписокРеквизитов, Данные);

	Если Данные.Количество() = 0 Тогда

		ТекстОшибки = НСтр("ru = 'Не выбраны товары к исследованию. Отметьте флажками товары, которые необходимо исследовать и повторите попытку.';
							|en = 'No goods to research are selected. Select the goods to research and try again.'");

		ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, , , , Отказ);

		Возврат;

	КонецЕсли;
	
	КоличествоКИсследованию = Данные.ВыгрузитьКолонку("Исследовать");
	Если КоличествоКИсследованию.Найти(0) <> Неопределено Тогда
		ТекстОшибки = НСтр("ru = 'Для выбранных товаров не указано количество к исследованию.';
							|en = 'The quantity for research is not specified for the selected goods.'");

		ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, , , , Отказ);

		Возврат;

	КонецЕсли;
	
	ТоварыКПредпросмотру.ПолучитьЭлементы().Очистить();
	
	ДеревоТоварыКПредпросмотру = РеквизитФормыВЗначение("ТоварыКПредпросмотру");
	СтрокиДерева = ДеревоТоварыКПредпросмотру.Строки;
	
	Для Каждого СтрокаТЧ Из Данные Цикл
		
		Если НесколькоНоменклатурВИсследовании Тогда
			СтруктураПоиска = Новый Структура;
			СтруктураПоиска.Вставить("КартаИсследованияТоваров", СтрокаТЧ.КартаИсследованияТоваров);
			СтруктураПоиска.Вставить("Исполнитель", СтрокаТЧ.Исполнитель);
		Иначе
			СтруктураПоиска = Новый Структура;
			СтруктураПоиска.Вставить("КартаИсследованияТоваров", СтрокаТЧ.КартаИсследованияТоваров);
			СтруктураПоиска.Вставить("Исполнитель", СтрокаТЧ.Исполнитель);
			СтруктураПоиска.Вставить("Номенклатура", СтрокаТЧ.Номенклатура);
			СтруктураПоиска.Вставить("Характеристика", СтрокаТЧ.Характеристика);
		КонецЕсли;
		
		НайденныеСтроки = СтрокиДерева.НайтиСтроки(СтруктураПоиска);

		Если НайденныеСтроки.Количество() = 0 Тогда
			СтрокаДерева = СтрокиДерева.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаДерева, СтрокаТЧ, "КартаИсследованияТоваров, Исполнитель");
			ДобавитьСтрокуДереваПредпросмотр(СтрокаДерева, СтрокаТЧ);
		Иначе
			Если НесколькоНоменклатурВИсследовании Тогда
				СтрокаТовара = НайденныеСтроки[0];
				ДобавитьСтрокуДереваПредпросмотр(СтрокаТовара, СтрокаТЧ);
			Иначе
				СтрокаДерева = СтрокиДерева.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаДерева, СтрокаТЧ, "КартаИсследованияТоваров, Исполнитель");
				ДобавитьСтрокуДереваПредпросмотр(СтрокаДерева, СтрокаТЧ);
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	ЗначениеВРеквизитФормы(ДеревоТоварыКПредпросмотру, "ТоварыКПредпросмотру");
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьСтрокуДереваПредпросмотр(Родитель, СтрокаЗаполнения)
	
	СтрокаДерева = Родитель.Строки.Добавить();
	СтрокаДерева.ПредставлениеСтроки = НоменклатураКлиентСервер.ПредставлениеНоменклатуры(
		СтрокаЗаполнения.Номенклатура,
		СтрокаЗаполнения.Характеристика,,
		СтрокаЗаполнения.Серия,
		СтрокаЗаполнения.Назначение);
	ЗаполнитьЗначенияСвойств(СтрокаДерева, СтрокаЗаполнения,,"КартаИсследованияТоваров, Исполнитель");
	
КонецПроцедуры

#КонецОбласти

#Область Отборы

&НаКлиенте
Процедура НазадЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	АдресРезультатФормирования = Неопределено;
	
	Если СозданныеОбъекты.Количество() <> 0 Тогда
		
		Отказ = Ложь;
		УдалитьСозданныеОбъекты(Отказ);
		
		Если НачатьОжиданиеДлительнойОперации Тогда
			НачатьОжиданиеДлительнойОперации(Ложь);
			НастроитьОжиданиеВФорме(Истина, НСтр("ru = 'Документы удаляются...';
												|en = 'Documents are being deleted...'"));
		Иначе
			ПослеУдаленияСозданныхОбъектов(Отказ);
		КонецЕсли;
		
	Иначе
		УстановитьСтраницыМастера(ЭтотОбъект, "ПредварительныйПросмотр");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПерейтиКШагуПредварительныйПросмотр()
	
	Отказ = Ложь;
	СформироватьДанныеДляПредварительногоПросмотра(Отказ);
	
	Если Не Отказ Тогда
		УстановитьСтраницыМастера(ЭтотОбъект, "ПредварительныйПросмотр");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПерейтиКШагуФормированияРезультата()
	
	Отказ = Ложь;
	СоздатьДокументыНаСервере(Отказ);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	Если НачатьОжиданиеДлительнойОперации Тогда
		НачатьОжиданиеДлительнойОперации(Ложь);
		НастроитьОжиданиеВФорме(Истина, НСтр("ru = 'Документы формируются...';
											|en = 'Documents are being generated...'"));
	Иначе
		УстановитьСтраницыМастера(ЭтотОбъект, "РезультатФормирования");
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область МастерНазначенияИсследований

&НаСервере
Процедура ВыбранПриИзмененииНаСервере(Идентификатор)
	
	ТекущиеДанные = ТоварыКИсследованию.НайтиПоИдентификатору(Идентификатор);
	Родитель = ТекущиеДанные.ПолучитьРодителя();
	
	ВыбратьИсключитьСтроки(ТекущиеДанные.ВыбратьПозицию, ТекущиеДанные.ПолучитьИдентификатор());
	
	Если Родитель <> Неопределено Тогда
		ОбновитьВыборРодительскихСтрок(ТекущиеДанные.ПолучитьИдентификатор());
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ВыбратьИсключитьВыделенныеСтроки(ЗначениеВыбора)
	
	Строки = ТоварыКИсследованию.ПолучитьЭлементы();
	
	Для Каждого Строка Из Строки Цикл
		
		Строка.ВыбратьПозицию = ЗначениеВыбора;
		
		ВыбратьИсключитьСтроки(ЗначениеВыбора, Строка.ПолучитьИдентификатор());
		ОбновитьВыборРодительскихСтрок(Строка.ПолучитьИдентификатор());
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ВыбратьИсключитьСтроки(ЗначениеВыбора, Идентификатор = Неопределено)
	
	Если Идентификатор = Неопределено Тогда
		ТекущиеЭлементы = ТоварыКИсследованию.ПолучитьЭлементы();
	Иначе
		
		ТекущаяСтрока = ТоварыКИсследованию.НайтиПоИдентификатору(Идентификатор);
		ТекущиеЭлементы = ТекущаяСтрока.ПолучитьЭлементы();
		
	КонецЕсли;
	
	Для Каждого Строка Из ТекущиеЭлементы Цикл
		Строка.ВыбратьПозицию = ЗначениеВыбора;
		ВыбратьИсключитьСтроки(ЗначениеВыбора, Строка.ПолучитьИдентификатор());
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьВыборРодительскихСтрок(Идентификатор)
	
	ТекущиеДанные = ТоварыКИсследованию.НайтиПоИдентификатору(Идентификатор);
	Родитель = ТекущиеДанные.ПолучитьРодителя();
	
	Если Родитель = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеЭлементы = Родитель.ПолучитьЭлементы();
	
	ВыбраноСтрок = 0;
	Для Каждого Строка Из ТекущиеЭлементы Цикл
		Если Строка.ВыбратьПозицию Тогда
			ВыбраноСтрок = ВыбраноСтрок + 1;
		КонецЕсли;
	КонецЦикла;
	
	Если ВыбраноСтрок = ТекущиеЭлементы.Количество() Тогда
		Родитель.ВыбратьПозицию = Истина;
	Иначе
		Родитель.ВыбратьПозицию = Ложь;
	КонецЕсли;
	
	ОбновитьВыборРодительскихСтрок(Родитель.ПолучитьИдентификатор());
	
КонецПроцедуры

&НаСервере
Процедура СформироватьДеревоНазначенияИсследованийНаСервере(ЗаявкаНаКонтроль, ВсеСтроки, ОтборНоменклатура, ОтборВидКонтроля)
	
	Запрос = Новый Запрос;
	
	ТекстыЗапросов = Новый Массив;
	
	Если ВсеСтроки Тогда
		ТекстЗапроса =
		"ВЫБРАТЬ
		|	Товары.НомерСтроки КАК ИндексДанных,
		|	Товары.Номенклатура КАК Номенклатура,
		|	Товары.Номенклатура.ВидНоменклатуры КАК ВидНоменклатуры,
		|	Товары.Характеристика КАК Характеристика,
		|	Товары.Номенклатура.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
		|	Товары.Назначение КАК Назначение,
		|	Товары.Назначение КАК НаправлениеДеятельности,
		|	Товары.Серия КАК Серия,
		|	Товары.Количество КАК Количество,
		|	&Ответственный КАК Ответственный,
		|	Товары.Склад КАК Склад,
		|	Товары.Упаковка КАК Упаковка,
		|	Товары.КоличествоУпаковок КАК КоличествоУпаковок,
		|	Товары.КонтролируемаяПартия КАК КонтролируемаяПартия
		|ПОМЕСТИТЬ ВтСписокНоменклатуры
		|ИЗ
		|	Документ.ЗаявкаНаКонтрольКачестваТоваров.Товары КАК Товары
		|ГДЕ
		|	Товары.Ссылка = &Ссылка
		|	И &ТекстУсловиеОтбораПоНоменклатуре";
		
		Запрос.УстановитьПараметр("Ссылка", ЗаявкаНаКонтроль);
	Иначе
		ТекстЗапроса =
		"ВЫБРАТЬ
		|	Товары.НомерСтроки КАК ИндексДанных,
		|	Товары.Номенклатура,
		|	Товары.ВидНоменклатуры КАК ВидНоменклатуры,
		|	Товары.Характеристика,
		|	Товары.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
		|	Товары.Назначение КАК Назначение,
		|	Товары.Назначение КАК НаправлениеДеятельности,
		|	Товары.Серия,
		|	Товары.Количество,
		|	&Ответственный КАК Ответственный,
		|	Товары.Склад КАК Склад,
		|	Товары.Упаковка КАК Упаковка,
		|	Товары.КоличествоУпаковок КАК КоличествоУпаковок,
		|	Товары.КонтролируемаяПартия
		|ПОМЕСТИТЬ ВтСписокНоменклатуры
		|ИЗ
		|	&ВыделенныеСтроки КАК Товары
		|ГДЕ
		|	&ТекстУсловиеОтбораПоНоменклатуре";
		
		Запрос.УстановитьПараметр("ВыделенныеСтроки", СписокТоваров.Выгрузить());
		
	КонецЕсли;
	
	Если ОтборНоменклатура <> Неопределено Тогда
		ТекстУсловия = "Товары.Номенклатура = &Номенклатура ";
	Иначе
		ТекстУсловия = "Истина";
	КонецЕсли;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТекстУсловиеОтбораПоНоменклатуре", ТекстУсловия);
	
	ТекстыЗапросов.Добавить(ТекстЗапроса);
	
	ПараметрыВыбораНазначенияИсследований = ИсследованиеТоваров.ПараметрыВыбораНазначенияИсследований();
		
	ПараметрыЗапросаНазначенияИсследований = ИсследованиеТоваров.ПараметрыТекстаЗапросаКартИсследований();
	ПараметрыЗапросаНазначенияИсследований.ИмяВходнойТаблицы         = "ВтСписокНоменклатуры";
	ПараметрыЗапросаНазначенияИсследований.ИмяВыходнойТаблицы         = "ВтНазначенияИсследований";
	ПараметрыЗапросаНазначенияИсследований.РазделительИтоговогоПакета = Ложь;
		
	ТекстыЗапросов.Добавить(ИсследованиеТоваров.ТекстЗапросаКартИсследованийТоваров(
																ПараметрыЗапросаНазначенияИсследований,
																ПараметрыВыбораНазначенияИсследований));
																
	ТекстЗапроса = "ВЫБРАТЬ
	|	Т.ИндексДанных КАК ИндексДанных,
	|	Т.Номенклатура КАК Номенклатура,
	|	Т.ВидНоменклатуры КАК ВидНоменклатуры,
	|	Т.Характеристика КАК Характеристика,
	|	Т.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	Т.Назначение КАК Назначение,
	|	Т.Серия КАК Серия,
	|	Т.Количество КАК Количество,
	|	Т.Ответственный КАК Исполнитель,
	|	Т.Склад	КАК Склад,
	|	Т.Упаковка КАК Упаковка,
	|	Т.КонтролируемаяПартия КАК КонтролируемаяПартия,
	|	Т.КоличествоУпаковок КАК КоличествоУпаковок,
	|	ВтНазначенияИсследований.КартаИсследованияТоваров КАК КартаИсследованияТоваров,
	|	ВтНазначенияИсследований.Контроль КАК Контроль,
	|	Т.Номенклатура.ЕдиницаИзмерения.ТипИзмеряемойВеличины = ЗНАЧЕНИЕ(Перечисление.ТипыИзмеряемыхВеличин.КоличествоШтук) КАК ЕдиницаИзмеренияШтучная,
	|	ВтНазначенияИсследований.ВариантОтбораОбразцов КАК ВариантОтбораОбразцов,
	|	ВтНазначенияИсследований.КоличествоОбразцов КАК КоличествоОбразцов,
	|	ВтНазначенияИсследований.ПроцентОбразцов КАК ПроцентОбразцов
	|ИЗ
	|	ВтСписокНоменклатуры КАК Т
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВтНазначенияИсследований КАК ВтНазначенияИсследований
	|		ПО Т.ИндексДанных = ВтНазначенияИсследований.ИндексДанных
	|
	|ГДЕ
	|	&ТекстУсловиеОтбораПоВидуКонтроля
	|
	|УПОРЯДОЧИТЬ ПО
	|	Т.ИндексДанных";
	
	Если ОтборВидКонтроля <> Неопределено Тогда
		ТекстУсловия = "ВтНазначенияИсследований.КартаИсследованияТоваров.Контроль = &Контроль";
	Иначе
		ТекстУсловия = "ИСТИНА";
	КонецЕсли;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТекстУсловиеОтбораПоВидуКонтроля", ТекстУсловия);

	ТекстыЗапросов.Добавить(ТекстЗапроса);
	
	ТекстЗапроса = СтрСоединить(ТекстыЗапросов, ОбщегоНазначения.РазделительПакетаЗапросов());
	
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("Ответственный", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЗаявкаНаКонтроль, "Ответственный"));
	
	Если ОтборНоменклатура <> Неопределено Тогда
		Запрос.УстановитьПараметр("Номенклатура", ОтборНоменклатура);
	КонецЕсли;
	
	Если ОтборВидКонтроля <> Неопределено Тогда
		Запрос.УстановитьПараметр("Контроль", ОтборВидКонтроля);
	КонецЕсли;
	
	ИсследованиеТоваров.УстановитьПараметрыЗапросаКартИсследованийТоваров(
			Запрос,
			ПараметрыВыбораНазначенияИсследований);
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	НоменклатураБезКартИсследования = Новый Массив;
	
	ТоварыКИсследованию.ПолучитьЭлементы().Очистить();
	
	ДеревоТоварыКИсследованию = РеквизитФормыВЗначение("ТоварыКИсследованию");
	СтрокиДерева = ДеревоТоварыКИсследованию.Строки;
	
	Для Каждого СтрокаРезультата Из Результат Цикл
		
		Если Не ЗначениеЗаполнено(СтрокаРезультата.КартаИсследованияТоваров) Тогда
			НоменклатураБезКартИсследования.Добавить(СтрокаРезультата.Номенклатура);
			Продолжить;
		КонецЕсли;
		
		СтрокаТовара = СтрокиДерева.Найти(СтрокаРезультата.КартаИсследованияТоваров, "КартаИсследованияТоваров");

		Если СтрокаТовара = Неопределено Тогда
			СтрокаДерева = СтрокиДерева.Добавить();
			СтрокаДерева.ИсследоватьПросмотр = Истина;
			СтрокаДерева.ПредставлениеСтроки = Строка(СтрокаРезультата.КартаИсследованияТоваров);
			ЗаполнитьКонтроль(СтрокаДерева, СтрокаРезультата);
			ЗаполнитьЗначенияСвойств(СтрокаДерева, СтрокаРезультата, "КартаИсследованияТоваров, Контроль");
			ДобавитьСтрокуДерева(СтрокаДерева, СтрокаРезультата);
		Иначе
			ДобавитьСтрокуДерева(СтрокаТовара, СтрокаРезультата);
		КонецЕсли;
		
	КонецЦикла;
	
	НоменклатураБезКартИсследования = ОбщегоНазначенияКлиентСервер.СвернутьМассив(НоменклатураБезКартИсследования);
	
	Если НоменклатураБезКартИсследования.Количество() > 0 Тогда
		Шаблон = НСтр("ru = 'Для номенклатуры ""%1"" не задана карта исследования товаров';
						|en = 'The goods research sheet is not set for the ""%1"" item'");
		Для Каждого ЭлементМассива Из НоменклатураБезКартИсследования Цикл
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Шаблон, ЭлементМассива);
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		КонецЦикла;
	КонецЕсли;
	
	ЗначениеВРеквизитФормы(ДеревоТоварыКИсследованию, "ТоварыКИсследованию");
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьСтрокуДерева(Родитель, СтрокаЗаполнения)
	
	СтрокаДерева = Родитель.Строки.Добавить();
	СтрокаДерева.ПредставлениеСтроки = НоменклатураКлиентСервер.ПредставлениеНоменклатуры(
		СтрокаЗаполнения.Номенклатура,
		СтрокаЗаполнения.Характеристика,,
		СтрокаЗаполнения.Серия,
		СтрокаЗаполнения.Назначение);
	ЗаполнитьЗначенияСвойств(СтрокаДерева, СтрокаЗаполнения);
	
	ЗаполнитьКонтроль(СтрокаДерева, СтрокаЗаполнения);
	
	Если СтрокаЗаполнения.Контроль = Перечисления.КонтрольКачества.Сплошной Тогда
		КоличествоИсследовать = СтрокаЗаполнения.Количество;
	Иначе
		Если СтрокаЗаполнения.ВариантОтбораОбразцов = Перечисления.ВариантыОтбораОбразцовИсследованияТоваров.Количество Тогда
			КоличествоИсследовать = Мин(СтрокаЗаполнения.Количество, СтрокаЗаполнения.КоличествоОбразцов);
		Иначе
			КоличествоИсследовать = Окр(СтрокаЗаполнения.Количество * СтрокаЗаполнения.ПроцентОбразцов / 100, ?(СтрокаЗаполнения.ЕдиницаИзмеренияШтучная, 0, 3), 1);
		КонецЕсли;
	КонецЕсли;
	
	СтрокаДерева.КоличествоОбразцов = КоличествоИсследовать;
	СтрокаДерева.Исследовать = КоличествоИсследовать;
	
	Если КоличествоИсследовать <> 0 Тогда
		СтрокаДерева.ВыбратьПозицию = Истина;
	КонецЕсли;
	
	// Обновить выбор родителя
	ВыбраноСтрок = 0;
	Для Каждого Строка Из Родитель.Строки Цикл
		Если Строка.ВыбратьПозицию Тогда
			ВыбраноСтрок = ВыбраноСтрок + 1;
		КонецЕсли;
	КонецЦикла;
	
	Если ВыбраноСтрок = Родитель.Строки.Количество() Тогда
		Родитель.ВыбратьПозицию = Истина;
	Иначе
		Родитель.ВыбратьПозицию = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьКонтроль(СтрокаДерева, СтрокаЗаполнения)
	
	ШаблонКоличество = Нстр("ru = '%1, %2';
							|en = '%1, %2'");
	ШаблонПроцент = Нстр("ru = '%1, %2%';
						|en = '%1, %2%'");

	Если СтрокаЗаполнения.Контроль = Перечисления.КонтрольКачества.Выборочный Тогда
		Если СтрокаЗаполнения.ВариантОтбораОбразцов = Перечисления.ВариантыОтбораОбразцовИсследованияТоваров.Процент Тогда
			ПредставлениеОбразцовКИсследованию = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонПроцент,
				СтрокаЗаполнения.Контроль, СтрокаЗаполнения.ПроцентОбразцов);
		Иначе
			ПредставлениеКоличествоОбразцовКИсследованию = ПолучитьСклоненияСтрокиПоЧислу("образец",
				СтрокаЗаполнения.КоличествоОбразцов, "", "ЧС=Количественное", "ПД=Именительный; ПЧ=Число");
			ПредставлениеОбразцовКИсследованию = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				ШаблонКоличество, СтрокаЗаполнения.Контроль, ПредставлениеКоличествоОбразцовКИсследованию[0]);
		КонецЕсли;
		СтрокаДерева.ПредставлениеСтрокиКонтроль = ПредставлениеОбразцовКИсследованию;
	Иначе
		СтрокаДерева.ПредставлениеСтрокиКонтроль = Строка(СтрокаЗаполнения.Контроль);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область Заполнение

&НаКлиенте
Процедура ЗаполнитьИсполнителяЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(ДополнительныеПараметры.ВыделенныеСтроки) = Тип("Массив") Тогда
		МассивИдентификаторов = ДополнительныеПараметры.ВыделенныеСтроки;
	Иначе
		МассивИдентификаторов = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ДополнительныеПараметры.ВыделенныеСтроки);
	КонецЕсли;
	
	Для Каждого Строка Из МассивИдентификаторов Цикл
		
		ТоварыКИсследованию.НайтиПоИдентификатору(Строка).Исполнитель = Результат;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьСвойстваДинамическогоСпискаПроверки(КартаИсследованияТоваров = Неопределено)
	
	СвойстваСписка = ОбщегоНазначения.СтруктураСвойствДинамическогоСписка();
	
	ТекстЗапроса = Справочники.КартыИсследованияТоваров.ТекстЗапросаСпискаПроверок();
	СвойстваСписка.ТекстЗапроса = ТекстЗапроса;
	
	СвойстваСписка.ОсновнаяТаблица = "";
	СвойстваСписка.ДинамическоеСчитываниеДанных = Ложь;
	
	ОбщегоНазначения.УстановитьСвойстваДинамическогоСписка(Элементы.ВидыПроверок, СвойстваСписка);
	
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(
									ВидыПроверок, "Ссылка", КартаИсследованияТоваров);
	
КонецПроцедуры

#КонецОбласти

#Область УправлениеНастройками

&НаСервере
Процедура ВосстановитьНастройкиФормыПриСоздании()
	
	НастройкиФормы = ХранилищеНастроекДанныхФорм.Загрузить(
		МенеджерНастроекКлючОбъекта(), МенеджерНастроекКлючНастроек());
	Если ЗначениеЗаполнено(НастройкиФормы) Тогда
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, НастройкиФормы);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура СохранитьНастройкиФормы()
	
	НастройкиФормы = СохраняемыеНастройкиФормы();
	
	ЗаполнитьЗначенияСвойств(НастройкиФормы, ЭтотОбъект);
	ХранилищеНастроекДанныхФорм.Сохранить(
		МенеджерНастроекКлючОбъекта(), МенеджерНастроекКлючНастроек(), НастройкиФормы);
	
КонецПроцедуры

&НаСервере
Функция СохраняемыеНастройкиФормы()
	
	Результат = Новый Структура;
	Результат.Вставить("НесколькоНоменклатурВИсследовании");
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция МенеджерНастроекКлючОбъекта()
	
	Возврат "МастерОформления";
	
КонецФункции

&НаСервере
Функция МенеджерНастроекКлючНастроек()
	
	Возврат "НастройкиФормы";
	
КонецФункции

#КонецОбласти

#Область Прочее

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	УсловноеОформление.Элементы.Очистить();
	
	СтандартныеПодсистемыСервер.УстановитьУсловноеОформлениеПоляДата(ЭтотОбъект, "СписокДокументов.Дата");
	
	// Только просмотр.
	ЭлементУсловногоОформления = УсловноеОформление.Элементы.Добавить();
	
	ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	
	ОформляемоеПоле = ЭлементУсловногоОформления.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("ТоварыКИсследованиюПредставлениеСтроки");
	
	ОформляемоеПоле = ЭлементУсловногоОформления.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("ТоварыКИсследованиюЕдиницаИзмерения");
	ОформляемоеПоле = ЭлементУсловногоОформления.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("ТоварыКИсследованиюКоличество");
	ОформляемоеПоле = ЭлементУсловногоОформления.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("ТоварыКИсследованиюПредставлениеСтрокиКонтроль");
	
	ЭлементУсловногоОформления = УсловноеОформление.Элементы.Добавить();
	
	ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	
	ОформляемоеПоле = ЭлементУсловногоОформления.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("ТоварыКИсследованиюИсследовать");
	
	ЭлементОтбора = ЭлементУсловногоОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ТоварыКИсследованию.ИсследоватьПросмотр");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОтбора.ПравоеЗначение = Истина;
	
	// Не задано количество для исследования в карте исследования
	ЭлементУсловногоОформления = УсловноеОформление.Элементы.Добавить();
	ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru = '<В карте исследования не указано, ввести вручную>';
																					|en = '<Not specified in the research sheet, enter manually>'"));
	ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ЦветТекстаОтмененнойСтрокиДокумента);
	
	ОформляемоеПоле = ЭлементУсловногоОформления.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("ТоварыКИсследованиюКоличествоОбразцов");
	
	ЭлементОтбора = ЭлементУсловногоОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ТоварыКИсследованию.КоличествоОбразцов");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено;
	
	ЭлементОтбора = ЭлементУсловногоОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ТоварыКИсследованию.Номенклатура");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Заполнено;
	
	// Не назначено количество для исследования
	ЭлементУсловногоОформления = УсловноеОформление.Элементы.Добавить();
	ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Ложь);
	ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ЦветТекстаОтмененнойСтрокиДокумента);
	
	ОформляемоеПоле = ЭлементУсловногоОформления.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("ТоварыКИсследованиюВыбратьПозицию");
	
	ЭлементОтбора = ЭлементУсловногоОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ТоварыКИсследованию.Исследовать");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено;
	
	ЭлементОтбора = ЭлементУсловногоОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ТоварыКИсследованию.Номенклатура");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Заполнено;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьСтраницыМастера(Форма, ИмяШага)
	
	Элементы = Форма.Элементы;
	
	Если ИмяШага = "ФормированиеИсследований" Тогда
		
		Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.СтраницаМастер;
		
		Элементы.Далее.Видимость = Истина;
		Элементы.Назад.Видимость = Ложь;
		Элементы.СформироватьЕще.Видимость = Ложь;
		Элементы.Далее.КнопкаПоУмолчанию = Истина;
		Элементы.Далее.Заголовок = НСтр("ru = 'Далее';
										|en = 'Next'");
		Элементы.Закрыть.Заголовок = НСтр("ru = 'Отмена';
											|en = 'Cancel'");
		
	ИначеЕсли ИмяШага = "РезультатФормирования" Тогда
		
		Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.СтраницаРезультат;
		
		Элементы.Далее.Видимость = Ложь;
		Элементы.Назад.Видимость = Истина;
		Элементы.СформироватьЕще.Видимость = Истина;
		Элементы.Закрыть.КнопкаПоУмолчанию = Истина;
		Элементы.Закрыть.Заголовок = НСтр("ru = 'Закрыть';
											|en = 'Close'");
	
	ИначеЕсли ИмяШага = "ПредварительныйПросмотр" Тогда
		
		Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.СтраницаПредварительныйПросмотр;
		
		Элементы.Далее.Видимость = Истина;
		Элементы.Назад.Видимость = Истина;
		Элементы.СформироватьЕще.Видимость = Ложь;
		Элементы.Далее.КнопкаПоУмолчанию = Истина;
		Элементы.Далее.Заголовок = НСтр("ru = 'Сформировать документы';
										|en = 'Generate documents'");
		Элементы.Закрыть.Заголовок = НСтр("ru = 'Отмена';
											|en = 'Cancel'");
		
	КонецЕсли;
	
	НастроитьЗависимыеЭлементыФормы(Форма, "ТекущаяСтраница");
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура НастроитьЗависимыеЭлементыФормы(Форма, СписокРеквизитов = "")

	Элементы = Форма.Элементы;
	
	Инициализация = ПустаяСтрока(СписокРеквизитов);
	СтруктураРеквизитов = Новый Структура(СписокРеквизитов);
	
	Если СтруктураРеквизитов.Свойство("ПоказыватьДетали") 
		ИЛИ Инициализация Тогда
		
		Элементы.ВидыПроверок.Видимость = Форма.ПоказыватьДетали;
		Элементы.ПоказыватьДетали.Заголовок = ?(Форма.ПоказыватьДетали,
			НСтр("ru = 'Детальная информация (скрыть)';
				|en = 'Detailed information (hide)'"),
			НСтр("ru = 'Детальная информация (показать)';
				|en = 'Detailed information (show)'"));
		
	КонецЕсли;
	
	Если СтруктураРеквизитов.Свойство("ТекущаяСтраница")
		ИЛИ Инициализация Тогда
		
		Если Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.СтраницаМастер Тогда
			Элементы.ПодЗаголовок.Заголовок = НСтр("ru = 'Шаг 1 из 3. Назначение исследований';
													|en = 'Step 1 of 3. Assignment of researches'");
		ИначеЕсли Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.СтраницаПредварительныйПросмотр Тогда
			Элементы.ПодЗаголовок.Заголовок = НСтр("ru = 'Шаг 2 из 3. Предварительный просмотр';
													|en = 'Step 2 of 3. Preview'");
		Иначе
			Элементы.ПодЗаголовок.Заголовок = НСтр("ru = 'Шаг 3 из 3. Просмотр созданных документов';
													|en = 'Step 3 of 3. View created documents'");
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура МассивСтруктурВТаблицуЗначений(МассивСтруктур, ТаблицаЗначений)
	
	Для каждого Элемент Из МассивСтруктур Цикл
		ЗаполнитьЗначенияСвойств(ТаблицаЗначений.Добавить(), Элемент);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура НастроитьОжиданиеВФорме(ПоказатьДлительнуюОперацию, ПредставлениеОперации = "")
	
	Элементы.СтраницыФормы.ТекущаяСтраница = ?(ПоказатьДлительнуюОперацию,
		Элементы.СтраницаДлительнаяОперация, Элементы.СтраницаЭлементы);
	Элементы.Переход.Доступность = Не ПоказатьДлительнуюОперацию;
	
	Элементы.ДлительнаяОперацияПредставление.Заголовок = ПредставлениеОперации;
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти
