	ЗаполнитьПризнакТипНоменклатуры = Новый Структура("Номенклатура", "ТипНоменклатуры");
	ЗаполнитьПризнакХарактеристикиИспользуются = Новый Структура("Номенклатура", "ХарактеристикиИспользуются");
	ПроверитьСериюРассчитатьСтатус = Новый Структура("Склад,ПараметрыУказанияСерий",
		Объект.Склад, ПараметрыУказанияСерий["ПланИРезультатИсследования"]);
	НоменклатураПриИзмененииПереопределяемый = Новый Структура("ИмяФормы, ИмяТабличнойЧасти",
		ИмяФормы, "ПланИРезультатИсследования");
	
	СтруктураДействий = Новый Структура();
	СтруктураДействий.Вставить("ЗаполнитьПризнакАртикул", ЗаполнитьПризнакАртикул);
	СтруктураДействий.Вставить("ЗаполнитьПризнакТипНоменклатуры", ЗаполнитьПризнакТипНоменклатуры);
	СтруктураДействий.Вставить("ЗаполнитьПризнакХарактеристикиИспользуются", ЗаполнитьПризнакХарактеристикиИспользуются);
	СтруктураДействий.Вставить("НоменклатураПриИзмененииПереопределяемый", НоменклатураПриИзмененииПереопределяемый);
	СтруктураДействий.Вставить("ПроверитьХарактеристикуПоВладельцу", СтрокаТаблицы.Характеристика);
	СтруктураДействий.Вставить("ПроверитьСериюРассчитатьСтатус", ПроверитьСериюРассчитатьСтатус);
	СтруктураДействий.Вставить("ПроверитьЗаполнитьУпаковкуПоВладельцу", СтрокаТаблицы.Упаковка);
	
	ПакетнаяОбработкаТабличнойЧастиКлиент.ОбработатьСтрокуТЧ(СтрокаТаблицы, СтруктураДействий, КэшированныеЗначения);
	
КонецПроцедуры

&НаКлиенте
Процедура ПланИРезультатИсследованияСерияПриИзменении(Элемент)
	
	ВыбранноеЗначение = НоменклатураКлиентСервер.ВыбраннаяСерия();
	
	ВыбранноеЗначение.Значение = Элементы.ПланИРезультатИсследования.ТекущиеДанные.Серия;
	ВыбранноеЗначение.ИдентификаторТекущейСтроки = Элементы.ПланИРезультатИсследования.ТекущиеДанные.ПолучитьИдентификатор();
	
	НоменклатураКлиент.ОбработатьУказаниеСерии(ЭтотОбъект, ПараметрыУказанияСерий["ПланИРезультатИсследования"], ВыбранноеЗначение);
	
КонецПроцедуры

&НаКлиенте
Процедура ПланИРезультатИсследованияСерияНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ОткрытьПодборСерий(Элемент.ТекстРедактирования);
	
КонецПроцедуры

&НаКлиенте
Процедура ПланИРезультатИсследованияПриАктивизацииСтроки(Элемент)
	
	СобытияФормКлиент.ПриАктивизацииСтроки(ЭтотОбъект, Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура ПланИРезультатИсследованияПередУдалением(Элемент, Отказ)
	
	Если Элемент.Имя = "ПланИРезультатИсследования" Тогда
		
		ВыводитьПредупреждение = Ложь;
		Для Каждого ТекИдентификатор Из Элемент.ВыделенныеСтроки Цикл
			СтрокаТаблицы = Объект.ПланИРезультатИсследования.НайтиПоИдентификатору(ТекИдентификатор);
			Если СтрокаТаблицы = Неопределено Тогда
				Продолжить;
			КонецЕсли;
	
			Отбор = Новый Структура;
			Отбор.Вставить("Номенклатура", СтрокаТаблицы.Номенклатура);
			Отбор.Вставить("Характеристика", СтрокаТаблицы.Характеристика);
			Отбор.Вставить("Серия", СтрокаТаблицы.Серия);
			НайденныеСтроки = Объект.ПланИРезультатИсследования.НайтиСтроки(Отбор);
			Если НайденныеСтроки.Количество() = 1 Тогда
				ВыводитьПредупреждение = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;

		Если ВыводитьПредупреждение Тогда
			Отказ = Истина;
		
			Кнопки = Новый СписокЗначений;
			Кнопки.Добавить(КодВозвратаДиалога.Да, НСтр("ru = 'Продолжить';
														|en = 'Continue'"));
			Кнопки.Добавить(КодВозвратаДиалога.Отмена);

			ТекстВопроса = НСтр("ru = 'При удалении товара введенные для него исследования будут очищены.';
								|en = 'When you delete the goods, the research you entered for it will be cleared.'");

			ОписаниеОповещения = Новый ОписаниеОповещения("ПланИРезультатИсследованияПередУдалениемЗавершение", ЭтотОбъект);
			
			ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, Кнопки);
		Иначе
			НастроитьЗависимыеЭлементыФормы(ЭтотОбъект, "ВидФормы");
			ПланИРезультатИсследованияПередУдалениемНаСервере();
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПланИРезультатИсследованияКоличествоГодноеПриИзменении(Элемент)
	ОбновитьРезультатИсследования();
КонецПроцедуры

&НаКлиенте
Процедура ПланИРезультатИсследованияКоличествоНегодноеПриИзменении(Элемент)
	ОбновитьРезультатИсследования();
КонецПроцедуры

&НаКлиенте
Процедура ПланИРезультатИсследованияКоличествоРазрушеноПриИзменении(Элемент)
	ОбновитьРезультатИсследования();
КонецПроцедуры

&НаКлиенте
Процедура ПланИРезультатИсследованияПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НоваяСтрока ИЛИ Копирование Тогда
		Элемент.ТекущиеДанные.ИдентификаторСтроки = Новый УникальныйИдентификатор;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПланИРезультатИсследованияПриИзменении(Элемент)
	НастроитьЗависимыеЭлементыФормы(ЭтотОбъект, "ВидФормы");
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыИсследованияТоваров

&НаКлиенте
Процедура ИсследованияТоваровСерияПриИзменении(Элемент)
	
	ВыбранноеЗначение = НоменклатураКлиентСервер.ВыбраннаяСерия();
	
	ВыбранноеЗначение.Значение = Элементы.ИсследованияТоваров.ТекущиеДанные.Серия;
	ВыбранноеЗначение.ИдентификаторТекущейСтроки = Элементы.ИсследованияТоваров.ТекущиеДанные.ПолучитьИдентификатор();
	
	НоменклатураКлиент.ОбработатьУказаниеСерии(ЭтотОбъект, ПараметрыУказанияСерий["ИсследованияТоваров"], ВыбранноеЗначение);
	
КонецПроцедуры

&НаКлиенте
Процедура ИсследованияТоваровСерияНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ПодобратьСерииНаКлиенте(Элемент.ТекстРедактирования);
	
КонецПроцедуры

&НаКлиенте
Процедура ИсследованияТоваровПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ИсследованияТоваров.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ИсследоватьНесколькоТоваров Тогда
		
		Отбор = Новый Структура;
		Отбор.Вставить("Номенклатура", ТекущиеДанные.Номенклатура);
		Отбор.Вставить("Характеристика", ТекущиеДанные.Характеристика);

		Результат = ИсследованиеЗавершено(Отбор);

		НайденныеОбъектыИсследования = Объект.ПланИРезультатИсследования.НайтиСтроки(Отбор);
		Для Каждого Элемент Из НайденныеОбъектыИсследования Цикл
			Элемент.Результат = Результат;
		КонецЦикла;

		ЗаполнитьРезультатИсследования();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ИсследованияТоваровФактПриИзменении(Элемент)

	УстановитьРезультатИсследованияДляСтроки();

КонецПроцедуры 

&НаКлиенте
Процедура ИсследованияТоваровНормаПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ИсследованияТоваров.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если ЗначениеЗаполнено(ТекущиеДанные.Факт) Тогда
		УстановитьРезультатИсследованияДляСтроки();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ИсследованияТоваровВидПроверкиПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ИсследованияТоваров.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПоказательКачестваЗаполнитьСписокВыбора(ЭтотОбъект, ТекущиеДанные.ВидПроверки);
	
КонецПроцедуры

&НаКлиенте
Процедура ИсследованияТоваровПриАктивизацииСтроки(Элемент)
	
	ТекущиеДанные = Элементы.ИсследованияТоваров.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПоказательКачестваЗаполнитьСписокВыбора(ЭтотОбъект, ТекущиеДанные.ВидПроверки);
	
КонецПроцедуры

&НаКлиенте
Процедура ИсследованияТоваровВидПроверкиНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекущаяСтрока = Элементы.ИсследованияТоваров.ТекущиеДанные;
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ТекущаяСтрока", ТекущаяСтрока);
	
	ОповещениеОЗакрытие = Новый ОписаниеОповещения("ОбработатьРезультатВыбораВидПроверки", ЭтотОбъект, ДополнительныеПараметры);
	
	ОткрытьФорму("Справочник.КартыИсследованияТоваров.Форма.ФормаВыбораВидаПроверки",
		, Элемент,,,, ОповещениеОЗакрытие, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
КонецПроцедуры

// Параметры:
// ВыбранноеЗначение - СправочникСсылка.НоменклатураКонтрагентов
// ДополнительныеПараметры - Структура
// 
&НаКлиенте
Процедура ОбработатьРезультатВыбораВидПроверки(ВыбранноеЗначение, ДополнительныеПараметры) Экспорт
	
	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ВыбранноеЗначение <> ДополнительныеПараметры.ТекущаяСтрока.ВидПроверки Тогда
		ДополнительныеПараметры.ТекущаяСтрока.ПоказательКачества = "";
	КонецЕсли;
	
	ДополнительныеПараметры.ТекущаяСтрока.ВидПроверки = ВыбранноеЗначение;

КонецПроцедуры

&НаКлиенте
Процедура ИсследованияТоваровНоменклатураПриИзменении(Элемент)
	
	СтрокаТаблицы = Элементы.ИсследованияТоваров.ТекущиеДанные;
	
	ЗаполнитьПризнакХарактеристикиИспользуются = Новый Структура("Номенклатура", "ХарактеристикиИспользуются");
	ЗаполнитьПризнакТипНоменклатуры = Новый Структура("Номенклатура", "ТипНоменклатуры");
	ПроверитьСериюРассчитатьСтатус = Новый Структура("Склад,ПараметрыУказанияСерий",
		Объект.Склад, ПараметрыУказанияСерий["ИсследованияТоваров"]);
	НоменклатураПриИзмененииПереопределяемый = Новый Структура("ИмяФормы, ИмяТабличнойЧасти",
		ИмяФормы, "ИсследованияТоваров");
	
	СтруктураДействий = Новый Структура();
	СтруктураДействий.Вставить("ЗаполнитьПризнакХарактеристикиИспользуются", ЗаполнитьПризнакХарактеристикиИспользуются);
	СтруктураДействий.Вставить("ЗаполнитьПризнакТипНоменклатуры", ЗаполнитьПризнакТипНоменклатуры);
	СтруктураДействий.Вставить("НоменклатураПриИзмененииПереопределяемый", НоменклатураПриИзмененииПереопределяемый);
	СтруктураДействий.Вставить("ПроверитьХарактеристикуПоВладельцу", СтрокаТаблицы.Характеристика);
	СтруктураДействий.Вставить("ПроверитьСериюРассчитатьСтатус", ПроверитьСериюРассчитатьСтатус);
	
	ПакетнаяОбработкаТабличнойЧастиКлиент.ОбработатьСтрокуТЧ(СтрокаТаблицы, СтруктураДействий, КэшированныеЗначения);
	
КонецПроцедуры

&НаКлиенте
Процедура ИсследованияТоваровКоличествоПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ИсследованияТоваров.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	НайденныеСтроки = Объект.ИсследованияТоваров.НайтиСтроки(Новый Структура("ИдентификаторЭкземпляра", ТекущиеДанные.ИдентификаторЭкземпляра));
	Для Каждого СтрокаТЧ Из НайденныеСтроки Цикл
		СтрокаТЧ.Количество = ТекущиеДанные.Количество;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ИсследованияТоваровНоменклатураНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	Элемент.СписокВыбора.Очистить();
	СписокНоменклатуры = ИспользуемаяНоменклатураПланИРезультатИсследования();
	Для Каждого ЭлементМассива Из СписокНоменклатуры Цикл
		Элемент.СписокВыбора.Добавить(ЭлементМассива, Строка(ЭлементМассива));
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ИсследованияТоваровХарактеристикаНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.ИсследованияТоваров.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Элемент.СписокВыбора.Очистить();
	СписокХарактеристик = ИспользуемаяХарактеристикаПланИРезультатИсследования(ТекущиеДанные.Номенклатура);
	Для Каждого ЭлементМассива Из СписокХарактеристик Цикл
		Элемент.СписокВыбора.Добавить(ЭлементМассива, Строка(ЭлементМассива));
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ИсследованияТоваровПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)

	Если НоваяСтрока И Не Копирование Тогда
		Если ПоказыватьВсеЭкземпляры Тогда
			Если Не ИсследоватьНесколькоТоваров Тогда
				ТекущиеДанные = Элементы.ПланИРезультатИсследования.ТекущиеДанные;
			Иначе
				Если НоменклатураОбразца = "ВсяНоменклатура" Тогда
					ТекущиеДанные = Элементы.ПланИРезультатИсследования.ТекущиеДанные;
				Иначе
					Отбор = Новый Структура;
					Отбор.Вставить("ИдентификаторСтроки", НоменклатураОбразца);
					НайденныеСтроки = Объект.ПланИРезультатИсследования.НайтиСтроки(Отбор);
					Если НайденныеСтроки.Количество() > 0 Тогда
						ТекущиеДанные = НайденныеСтроки[0];
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;

			Если ТекущиеДанные <> Неопределено Тогда

				СтрокаТаблицы = Элемент.ТекущиеДанные;

				СтрокаТаблицы.Номенклатура = ТекущиеДанные.Номенклатура;
				СтрокаТаблицы.Характеристика = ТекущиеДанные.Характеристика;
				СтрокаТаблицы.Серия = ТекущиеДанные.Серия;

				ИдентификаторРедактируемойСтроки = СтрокаТаблицы.ПолучитьИдентификатор();

				ЗаполнитьИдентификаторСтрокиИсследованияТоваровНаСервере(
					ИдентификаторРедактируемойСтроки);

				ЗаполнитьСлужебныеРеквизитыПриДобавленииСтрокиИсследованияТоваровНаСервере(
					ИдентификаторРедактируемойСтроки);

			КонецЕсли;
		Иначе
			Отбор = Элементы.ИсследованияТоваров.ОтборСтрок;
			ИдентификаторЭкземпляра = Неопределено;
			Если Отбор.Свойство("ИдентификаторЭкземпляра") И ЗначениеЗаполнено(Отбор.ИдентификаторЭкземпляра) Тогда
				ИдентификаторЭкземпляра = Отбор.ИдентификаторЭкземпляра[0];
			Иначе
				Возврат;
			КонецЕсли;

			НайденныеСтроки = Объект.ИсследованияТоваров.НайтиСтроки(Новый Структура("ИдентификаторЭкземпляра",
				ИдентификаторЭкземпляра));
			Если НайденныеСтроки.Количество() = 0 Тогда
				Возврат;
			КонецЕсли;

			СтрокаТаблицы = Элемент.ТекущиеДанные;
			СтрокаТаблицы.Номенклатура = НайденныеСтроки[0].Номенклатура;
			СтрокаТаблицы.Характеристика = НайденныеСтроки[0].Характеристика;
			СтрокаТаблицы.Серия = НайденныеСтроки[0].Серия;
			СтрокаТаблицы.Образец = НайденныеСтроки[0].Образец;

			ИдентификаторРедактируемойСтроки = СтрокаТаблицы.ПолучитьИдентификатор();

			ЗаполнитьИдентификаторСтрокиИсследованияТоваровНаСервере(
					ИдентификаторРедактируемойСтроки);

			ЗаполнитьСлужебныеРеквизитыПриДобавленииСтрокиИсследованияТоваровНаСервере(
					ИдентификаторРедактируемойСтроки);

		КонецЕсли;

	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ИсследованияТоваровЭкземплярОкончаниеВводаТекста(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, СтандартнаяОбработка)
	
	СтрокаТаблицы = Элементы.ИсследованияТоваров.ТекущиеДанные;
	Если СтрокаТаблицы = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ИдентификаторРедактируемойСтроки = СтрокаТаблицы.ПолучитьИдентификатор();
			
	ЗаполнитьИдентификаторСтрокиИсследованияТоваровНаСервере(ИдентификаторРедактируемойСтроки, Текст);
	
КонецПроцедуры

&НаКлиенте
Процедура ИсследованияТоваровЭкземплярПриИзменении(Элемент)
	
	Если ПоказыватьВсеЭкземпляры Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаТаблицы = Элементы.ИсследованияТоваров.ТекущиеДанные;
	Если СтрокаТаблицы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИсследованияТоваровУстановитьОтборПоЭкземпляру(СтрокаТаблицы.Образец);
	
КонецПроцедуры

&НаКлиенте
Процедура ИсследованияТоваровРазрушенПриИзменении(Элемент)
	Если Объект.Контроль = ПредопределенноеЗначение("Перечисление.КонтрольКачества.Сплошной") Тогда
		СтрокаТаблицы = Элементы.ИсследованияТоваров.ТекущиеДанные;
		Если СтрокаТаблицы = Неопределено Тогда
			Возврат;
		КонецЕсли;
		Если СтрокаТаблицы.Разрушен Тогда
			СтрокаТаблицы.Результат = ПредопределенноеЗначение("Перечисление.РезультатИсследованияТоваров.НеПройдено");
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

