		ПараметрыУказанияСерий["ИсследованияТоваров"],
		Текст,
		ТекущиеДанные);
		
	Если НуженСерверныйВызов Тогда
		
		Если ТекущиеДанные = Неопределено Тогда
			ТекущиеДанныеИдентификатор = Элементы.ИсследованияТоваров.ТекущиеДанные.ПолучитьИдентификатор();
		Иначе
			ТекущиеДанныеИдентификатор = ТекущиеДанные.ПолучитьИдентификатор();
		КонецЕсли;
		
		ПараметрыФормыУказанияСерий = ПараметрыФормыУказанияСерий(ТекущиеДанныеИдентификатор, "ИсследованияТоваров");
		
		ТекущиеПараметрыУказанияСерий = Новый Структура("ПараметрыФормыУказанияСерий", ПараметрыУказанияСерий["ИсследованияТоваров"]);
		
		ОписаниеОповещения = Новый ОписаниеОповещения(
			"ОткрытьПодборСерийЗавершение",
			ЭтотОбъект,
			ТекущиеПараметрыУказанияСерий);
		
		ОткрытьФорму(
			ПараметрыФормыУказанияСерий.ИмяФормы,
			ПараметрыФормыУказанияСерий,
			ЭтотОбъект,
			,
			,
			,
			ОписаниеОповещения,
			РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
			
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьПодборСерий(Текст = "", ТекущиеДанные = Неопределено)
	
	НуженСерверныйВызов = НоменклатураКлиент.ДляУказанияСерийНуженСерверныйВызов(
		ЭтотОбъект,
		ПараметрыУказанияСерий["ПланИРезультатИсследования"],
		Текст,
		ТекущиеДанные);
		
	Если НуженСерверныйВызов Тогда
		
		Если ТекущиеДанные = Неопределено Тогда
			ТекущиеДанныеИдентификатор = Элементы.ПланИРезультатИсследования.ТекущиеДанные.ПолучитьИдентификатор();
		Иначе
			ТекущиеДанныеИдентификатор = ТекущиеДанные.ПолучитьИдентификатор();
		КонецЕсли;
		
		ПараметрыФормыУказанияСерий = ПараметрыФормыУказанияСерий(ТекущиеДанныеИдентификатор, "ПланИРезультатИсследования");
		
		ТекущиеПараметрыУказанияСерий = Новый Структура("ПараметрыФормыУказанияСерий", ПараметрыФормыУказанияСерий);
		
		ОписаниеОповещения = Новый ОписаниеОповещения(
			"ОткрытьПодборСерийЗавершение",
			ЭтотОбъект,
			ТекущиеПараметрыУказанияСерий);
		
		ОткрытьФорму(
			ПараметрыФормыУказанияСерий.ИмяФормы,
			ПараметрыФормыУказанияСерий,
			ЭтотОбъект,
			,
			,
			,
			ОписаниеОповещения,
			РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
			
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьПодборСерийЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
		
	ПараметрыФормыУказанияСерий = ДополнительныеПараметры.ПараметрыФормыУказанияСерий;
	ИмяТЧ = ПараметрыФормыУказанияСерий.ПараметрыУказанияСерий.ИмяТЧ;
	
	ОбработатьУказаниеСерийСервер(ДополнительныеПараметры.ПараметрыФормыУказанияСерий, КэшированныеЗначения, ИмяТЧ);
	
КонецПроцедуры

&НаСервере
Процедура ОбработатьУказаниеСерийСервер(ПараметрыФормыУказанияСерий, КэшированныеЗначения, ИмяТЧ)
	
	ПроверитьСериюРассчитатьСтатус = Новый Структура("Склад, ПараметрыУказанияСерий", Объект.Склад, ПараметрыУказанияСерий[ИмяТЧ]);
	
	СтруктураДействий = Новый Структура();
	СтруктураДействий.Вставить("ПроверитьСериюРассчитатьСтатус", ПроверитьСериюРассчитатьСтатус);
	
	НоменклатураСервер.ОбработатьУказаниеСерий(
		Объект,
		ПараметрыУказанияСерий[ИмяТЧ],
		ПараметрыФормыУказанияСерий,
		СтруктураДействий,
		КэшированныеЗначения);
	
КонецПроцедуры

&НаСервере
Функция ПараметрыФормыУказанияСерий(ТекущиеДанныеИдентификатор, ИмяТЧ)
	
	Возврат НоменклатураСервер.ПараметрыФормыУказанияСерий(
		Объект,
		ПараметрыУказанияСерий[ИмяТЧ],
		ТекущиеДанныеИдентификатор,
		ЭтотОбъект);
	
КонецФункции

#КонецОбласти

#Область ИзменениеРеквизитовДокумента

&НаСервере
Процедура СкладПриИзмененииНаСервере()
	
	Если ЗначениеЗаполнено(Объект.Склад) Тогда
		
		ПроверитьСериюРассчитатьСтатус = Новый Структура("Склад, ПараметрыУказанияСерий", Объект.Склад, ПараметрыУказанияСерий["ПланИРезультатИсследования"]);
		
		СтруктураДействий = Новый Структура();
		СтруктураДействий.Вставить("ПроверитьСериюРассчитатьСтатус", ПроверитьСериюРассчитатьСтатус);
		ПакетнаяОбработкаТабличнойЧастиСервер.ОбработатьТЧ(Объект.ПланИРезультатИсследования, СтруктураДействий);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КартаИсследованияТоваровПриИзмененииЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт

	Если РезультатВопроса <> КодВозвратаДиалога.Да Тогда
		Объект.КартаИсследованияТоваров = КартаИсследованияДоИзменения;
		Возврат;
	КонецЕсли;
	
	КартаИсследованияДоИзменения = Объект.КартаИсследованияТоваров;
	ЗаполнитьСлужебныеРеквизитыПриИзмененииКартыИсследования();
	
	НастроитьЗависимыеЭлементыФормы(ЭтотОбъект, "КартаИсследованияТоваров");
	
	Модифицированность = Истина;

КонецПроцедуры

&НаКлиенте
Процедура ВидКонтроляПриИзмененииЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт

	Если РезультатВопроса <> КодВозвратаДиалога.Да Тогда
		Объект.Контроль = ВидКонтроляДоИзменения;
		Возврат;
	КонецЕсли;
	
	ОчиститьРезультатыИсследования();
	
	Модифицированность = Истина;

КонецПроцедуры

#КонецОбласти

#Область Образцы

&НаКлиенте
Процедура ОткрытьФормуДобавлениеОбразцаЗавершение(Результат, ДополнительныеПараметры) Экспорт

	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПоследняяДобавленнаяНоменклатура = Результат.Номенклатура;
	ПоследняяДобавленнаяХарактеристика = Результат.Характеристика;
	ИмяОбразца = Результат.Образец;
	
	Если Не ПоказыватьВсеЭкземпляры Тогда
		ИсследованияТоваровУстановитьОтборПоЭкземпляру(ИмяОбразца);
	КонецЕсли;
	
	ДобавитьЭкземплярНаСервере();
	
	Модифицированность = Истина;

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуВыборОбразцаЗавершение(Результат, ДополнительныеПараметры) Экспорт

	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПоказыватьВсеЭкземпляры = Ложь;
	
	ИсследованияТоваровУстановитьОтборПоЭкземпляру(Результат.Образец);

КонецПроцедуры

&НаСервере
Процедура ИсследованияТоваровУстановитьОтборПоЭкземпляру(Образец)
	
	МассивИдентификаторов = Новый Массив;
	НайденныеСтроки = Объект.ИсследованияТоваров.НайтиСтроки(Новый Структура("Образец", Образец));
	Для Каждого Строка Из НайденныеСтроки Цикл
		МассивИдентификаторов.Добавить(Строка.ИдентификаторЭкземпляра);
	КонецЦикла;
	
	МассивИдентификаторов = ОбщегоНазначенияКлиентСервер.СвернутьМассив(МассивИдентификаторов);
	
	Отбор = Новый Структура;
	Отбор.Вставить("ИдентификаторЭкземпляра", МассивИдентификаторов);
	Элементы.ИсследованияТоваров.ОтборСтрок = Новый ФиксированнаяСтруктура(Отбор);
	Элементы.ИсследованияТоваров.Обновить();
	
	Если ИсследоватьНесколькоТоваров Тогда
		НоменклатураОбразца = "ВсяНоменклатура";
	КонецЕсли;
	
	ШаблонОтбора = Нстр("ru = 'Отобрано: %1';
						|en = 'Picked: %1'");
	Элементы.ДекорацияВыбратьОбразец.Заголовок = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонОтбора, Образец);
	
	НастроитьЗависимыеЭлементыФормы(ЭтотОбъект, "Отбор");
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьЭкземплярНаСервере()
	
	ИдентификаторЭкземпляра = Новый УникальныйИдентификатор;

	ОбрабатываемыеСтроки = Новый Массив;

	Если Проверки.Количество() > 0 Тогда
		Для Каждого СтрокаТаблицы Из Проверки Цикл
			НоваяСтрока = Объект.ИсследованияТоваров.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
			НоваяСтрока.Номенклатура = ПоследняяДобавленнаяНоменклатура;
			НоваяСтрока.Характеристика = ПоследняяДобавленнаяХарактеристика;
			НоваяСтрока.Серия = ПоследняяДобавленнаяСерия;
			НоваяСтрока.Образец = ИмяОбразца;
			НоваяСтрока.Количество = 1;
			НоваяСтрока.ИдентификаторЭкземпляра = ИдентификаторЭкземпляра;
			ОбрабатываемыеСтроки.Добавить(НоваяСтрока);
		КонецЦикла;
	Иначе
		НоваяСтрока = Объект.ИсследованияТоваров.Добавить();
		НоваяСтрока.Номенклатура = ПоследняяДобавленнаяНоменклатура;
		НоваяСтрока.Характеристика = ПоследняяДобавленнаяХарактеристика;
		НоваяСтрока.Серия = ПоследняяДобавленнаяСерия;
		НоваяСтрока.Образец = ИмяОбразца;
		НоваяСтрока.Количество = 1;
		НоваяСтрока.ИдентификаторЭкземпляра = ИдентификаторЭкземпляра;
		ОбрабатываемыеСтроки.Добавить(НоваяСтрока);
	КонецЕсли;
	
	ЗаполнитьПризнакТипНоменклатуры = Новый Структура("Номенклатура", "ТипНоменклатуры");
	ПроверитьСериюРассчитатьСтатус = Новый Структура("Склад, ПараметрыУказанияСерий", Объект.Склад, ПараметрыУказанияСерий["ИсследованияТоваров"]);
	ЗаполнитьПризнакХарактеристикиИспользуются = Новый Структура("Номенклатура", "ХарактеристикиИспользуются");
	
	СтруктураДействий = Новый Структура();
	СтруктураДействий.Вставить("ЗаполнитьПризнакХарактеристикиИспользуются", ЗаполнитьПризнакХарактеристикиИспользуются);
	СтруктураДействий.Вставить("ЗаполнитьПризнакТипНоменклатуры", ЗаполнитьПризнакТипНоменклатуры);
	СтруктураДействий.Вставить("ПроверитьСериюРассчитатьСтатус", ПроверитьСериюРассчитатьСтатус);
	
	КэшированныеЗначения = ПакетнаяОбработкаТабличнойЧастиКлиентСервер.ПолучитьСтруктуруКэшируемыеЗначения();
	ПакетнаяОбработкаТабличнойЧастиСервер.ОбработатьСтрокиТЧ(
		ОбрабатываемыеСтроки,
		СтруктураДействий,
		Объект.ИсследованияТоваров,
		КэшированныеЗначения);
	
КонецПроцедуры

&НаСервере
Функция ОбразцыИсследованияТоваров()
	
	ДокументОбъект = РеквизитФормыВЗначение("Объект");
	Возврат ОбщегоНазначенияУТ.ВыгрузитьЗначенияКолонки(ДокументОбъект.ИсследованияТоваров, "Образец"); 
		
КонецФункции

#КонецОбласти

#Область Прочие

&НаКлиенте
Процедура ОповеститьОПроведенииДокумента(ПараметрыЗаписи)
	
	ПараметрОбработкиОповещения = ОбщегоНазначенияКлиент.СкопироватьРекурсивно(ПараметрыЗаписи);
	Если ТипЗнч(ВладелецФормы) = Тип("ФормаКлиентскогоПриложения") Тогда
		ИдентификаторФормыВладельца = ВладелецФормы.УникальныйИдентификатор;
	Иначе
		ИдентификаторФормыВладельца = Неопределено;
	КонецЕсли;
	КлючиДокументаОповещение = РаботаСЖурналамиДокументовКлиент.ПолучитьПараметрыКлючаПоДокументу(
		Объект.Ссылка, Объект.Дата, Неопределено);
	ПараметрОбработкиОповещения.Вставить("ИдентификаторФормыВладельца", ИдентификаторФормыВладельца);
	ПараметрОбработкиОповещения.Вставить("КлючиДокументаОповещение", КлючиДокументаОповещение);
	Оповестить("Запись_ИсследованиеКачестваТоваров", ПараметрОбработкиОповещения, Объект.Ссылка);
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииСозданииНаСервере()
	
	Если ЗначениеЗаполнено(Объект.КартаИсследованияТоваров) Тогда
		ОписаниеКартыИсследованияТоваров = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.КартаИсследованияТоваров,
			"ОписаниеУточненияПрименения");
	КонецЕсли;
	
	ЗаполнитьПризнакАртикул = Новый Структура("Номенклатура", "Артикул");
	ЗаполнитьПризнакТипНоменклатуры = Новый Структура("Номенклатура", "ТипНоменклатуры");
	ЗаполнитьПризнакХарактеристикиИспользуются = Новый Структура("Номенклатура", "ХарактеристикиИспользуются");
	
	СтруктураДействий = Новый Структура();
	СтруктураДействий.Вставить("ЗаполнитьПризнакХарактеристикиИспользуются", ЗаполнитьПризнакХарактеристикиИспользуются);
	СтруктураДействий.Вставить("ЗаполнитьПризнакТипНоменклатуры", ЗаполнитьПризнакТипНоменклатуры);
	
	ПакетнаяОбработкаТабличнойЧастиСервер.ОбработатьТЧ(Объект.ИсследованияТоваров, СтруктураДействий);
	
	СтруктураДействий.Вставить("ЗаполнитьПризнакАртикул", ЗаполнитьПризнакАртикул);
	
	ПакетнаяОбработкаТабличнойЧастиСервер.ОбработатьТЧ(Объект.ПланИРезультатИсследования, СтруктураДействий);
	
	ТекущиеПараметрыУказанияСерий = Документы.ИсследованиеКачестваТоваров.ПараметрыУказанияСерий(Объект);
	ПараметрыУказанияСерий = Новый ФиксированнаяСтруктура(ТекущиеПараметрыУказанияСерий);
	
	НоменклатураСервер.ЗаполнитьСтатусыУказанияСерий(Объект, ПараметрыУказанияСерий["ПланИРезультатИсследования"]);
	НоменклатураСервер.ЗаполнитьСтатусыУказанияСерий(Объект, ПараметрыУказанияСерий["ИсследованияТоваров"]);
	
	ЗаполнитьСлужебныеРеквизиты();
	ОбновитьРезультатИсследования();
	
	// Управление видимостью.
	УстановитьУсловноеОформление();
	ОбновитьИнформациюПоИспользованиюСерийХарактеристик();
	
КонецПроцедуры

&НаКлиенте
Процедура СпособПроверкиЭкземпляровПриИзмененииЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт

	Если РезультатВопроса <> КодВозвратаДиалога.Да Тогда
		Объект.СпособПроверкиЭкземпляров = МетодИсследованияДоИзменения;
		Возврат;
	КонецЕсли;
	
	ОчиститьРезультатыИсследования();
	
	МетодИсследованияДоИзменения = Объект.СпособПроверкиЭкземпляров;
	
	НастроитьЗависимыеЭлементыФормы(ЭтотОбъект, "СпособПроверкиЭкземпляров");
	
	Модифицированность = Истина;

КонецПроцедуры 

&НаСервере
Процедура ОчиститьРезультатыИсследования(ОбновитьВидКонтроля = Ложь)

	Объект.ИсследованияТоваров.Очистить();
	Если ОбновитьВидКонтроля Тогда
		Объект.Контроль = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.КартаИсследованияТоваров, "Контроль");
		Объект.СпособПроверкиЭкземпляров = Перечисления.ВариантыПроверкиЭкземпляровИсследования.ПоЭкземплярно;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСлужебныеРеквизиты()
	
	ПоказыватьВсеЭкземпляры = Истина;
	
	ВидКонтроляДоИзменения = Перечисления.КонтрольКачества.Выборочный;
	Если ЗначениеЗаполнено(Объект.Контроль) Тогда
		ВидКонтроляДоИзменения = Объект.Контроль;
	КонецЕсли;
	
	МетодИсследованияДоИзменения = Перечисления.ВариантыПроверкиЭкземпляровИсследования.Сводно;
	Если ЗначениеЗаполнено(Объект.СпособПроверкиЭкземпляров) Тогда
		МетодИсследованияДоИзменения = Объект.СпособПроверкиЭкземпляров;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.Склад) Тогда
		Элементы.Склад.СписокВыбора.Очистить();
		Элементы.Склад.СписокВыбора.Добавить(Объект.Склад);
	ИначеЕсли ЗначениеЗаполнено(Объект.ЗаявкаНаКонтроль) Тогда
		СписокСкладов = СписокСкладовЗаявкиНаКонтроль(Объект.ЗаявкаНаКонтроль);
		Если СписокСкладов.Количество() = 1 Тогда
			Объект.Склад = СписокСкладов[0];
			Элементы.Склад.СписокВыбора.Очистить();
			Элементы.Склад.СписокВыбора.Добавить(СписокСкладов[0]);
		Иначе
			Элементы.Склад.ТолькоПросмотр = Ложь;
			Элементы.Склад.СписокВыбора.Очистить();
			Элементы.Склад.СписокВыбора.ЗагрузитьЗначения(СписокСкладов);
		КонецЕсли;
	КонецЕсли;
	
	ИсследоватьНесколькоТоваров = Объект.ПланИРезультатИсследования.Количество() > 1;
	
	Если Не ИсследоватьНесколькоТоваров Тогда
		Если Объект.ПланИРезультатИсследования.Количество() = 0 Тогда
			НоваяСтрока = Объект.ПланИРезультатИсследования.Добавить();
			ИдентификаторСтроки = НоваяСтрока.ПолучитьИдентификатор();
		Иначе
			ИдентификаторСтроки = Объект.ПланИРезультатИсследования[0].ПолучитьИдентификатор();
			Элементы.ПланИРезультатИсследования.ТекущаяСтрока = ИдентификаторСтроки;
		КонецЕсли;
		Элементы.ПланИРезультатИсследования.ТекущаяСтрока = ИдентификаторСтроки;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.КартаИсследованияТоваров) Тогда
		Возврат;
	Иначе
		КартаИсследованияДоИзменения = Объект.КартаИсследованияТоваров;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст = Справочники.КартыИсследованияТоваров.ТекстЗапросаСпискаПроверок();

	Запрос.УстановитьПараметр("Ссылка", Объект.КартаИсследованияТоваров);
	ВыборкаПроверки = Запрос.Выполнить().Выбрать();
	
	Пока ВыборкаПроверки.Следующий() Цикл
		НоваяСтрока = Проверки.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ВыборкаПроверки);
	КонецЦикла;
	
	СтрокаТаблицы = Объект.ПланИРезультатИсследования[0];
	ПоследняяДобавленнаяНоменклатура 	= СтрокаТаблицы.Номенклатура;
	ПоследняяДобавленнаяХарактеристика 	= СтрокаТаблицы.Характеристика;
	ПоследняяДобавленнаяСерия			= СтрокаТаблицы.Серия;
	ХарактеристикиИспользуются 			= СтрокаТаблицы.ХарактеристикиИспользуются;
	СерииИспользуются					= ИсследованиеТоваров.ИспользованиеСерий(СтрокаТаблицы.Номенклатура);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСлужебныеРеквизитыПриИзмененииКартыИсследования()

	Запрос = Новый Запрос;
	Запрос.Текст = Справочники.КартыИсследованияТоваров.ТекстЗапросаСпискаПроверок();

	Запрос.УстановитьПараметр("Ссылка", Объект.КартаИсследованияТоваров);
	ВыборкаПроверки = Запрос.Выполнить().Выбрать();
	
	Проверки.Очистить();
	
	Пока ВыборкаПроверки.Следующий() Цикл
		НоваяСтрока = Проверки.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ВыборкаПроверки);
	КонецЦикла;
	
	ОписаниеКартыИсследованияТоваров = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.КартаИсследованияТоваров,
		"ОписаниеУточненияПрименения");
	
	ОчиститьРезультатыИсследования(Истина);

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСлужебныеРеквизитыПриДобавленииСтрокиИсследованияТоваровНаСервере(ИдентификаторСтрокиИсследованияТоваров)
	
	СтрокаТаблицы = Объект.ИсследованияТоваров.НайтиПоИдентификатору(ИдентификаторСтрокиИсследованияТоваров);
	
	НайденныеЭкземпляры = Объект.ИсследованияТоваров.НайтиСтроки(Новый Структура("Образец", СтрокаТаблицы.Образец));
	Если НайденныеЭкземпляры.Количество() = 1 Тогда
		СтрокаТаблицы.ИдентификаторЭкземпляра = Новый УникальныйИдентификатор;
	Иначе
		СтрокаТаблицы.ИдентификаторЭкземпляра = НайденныеЭкземпляры[0].ИдентификаторЭкземпляра;
	КонецЕсли;
	
	ОбрабатываемыеСтроки = Новый Массив;
	ОбрабатываемыеСтроки.Добавить(СтрокаТаблицы);
	
	ЗаполнитьПризнакТипНоменклатуры = Новый Структура("Номенклатура", "ТипНоменклатуры");
	ПроверитьСериюРассчитатьСтатус = Новый Структура("Склад, ПараметрыУказанияСерий", Объект.Склад, ПараметрыУказанияСерий["ИсследованияТоваров"]);
	ЗаполнитьПризнакХарактеристикиИспользуются = Новый Структура("Номенклатура", "ХарактеристикиИспользуются");
	
	СтруктураДействий = Новый Структура();
	СтруктураДействий.Вставить("ЗаполнитьПризнакХарактеристикиИспользуются", ЗаполнитьПризнакХарактеристикиИспользуются);
	СтруктураДействий.Вставить("ЗаполнитьПризнакТипНоменклатуры", ЗаполнитьПризнакТипНоменклатуры);
	СтруктураДействий.Вставить("ПроверитьСериюРассчитатьСтатус", ПроверитьСериюРассчитатьСтатус);
	
	КэшированныеЗначения = ПакетнаяОбработкаТабличнойЧастиКлиентСервер.ПолучитьСтруктуруКэшируемыеЗначения();
	ПакетнаяОбработкаТабличнойЧастиСервер.ОбработатьСтрокиТЧ(
		ОбрабатываемыеСтроки,
		СтруктураДействий,
		Объект.ИсследованияТоваров,
		КэшированныеЗначения);

	Модифицированность = Истина;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьИдентификаторСтрокиИсследованияТоваровНаСервере(ИдентификаторСтрокиИсследованияТоваров, Текст = Неопределено)
	
	СтрокаТаблицы = Объект.ИсследованияТоваров.НайтиПоИдентификатору(ИдентификаторСтрокиИсследованияТоваров);
	
	Если Текст<>Неопределено Тогда
		СтрокаТаблицы.Образец = Текст;
	КонецЕсли;
	
	НайденныеЭкземпляры = Объект.ИсследованияТоваров.НайтиСтроки(Новый Структура("Образец", СтрокаТаблицы.Образец));
	Если НайденныеЭкземпляры.Количество() = 1 Тогда
		СтрокаТаблицы.ИдентификаторЭкземпляра = Новый УникальныйИдентификатор;
	Иначе
		СтрокаТаблицы.ИдентификаторЭкземпляра = НайденныеЭкземпляры[0].ИдентификаторЭкземпляра;
	КонецЕсли;
		
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ПланИРезультатИсследованияПередУдалениемЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт

	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		ПланИРезультатИсследованияПередУдалениемНаСервере();
		НастроитьЗависимыеЭлементыФормы(ЭтотОбъект, "ВидФормы");
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура УстановитьЗначениеРеквизитаВсемСтрокам(ИмяРеквизита, УстанавливаемоеЗначение, ВыделенныеСтроки)

	Если ТипЗнч(ВыделенныеСтроки) = Тип("Массив") Тогда
		МассивИдентификаторов = ВыделенныеСтроки;
	Иначе
		МассивИдентификаторов = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ВыделенныеСтроки);
	КонецЕсли;

	Для Каждого ИдентификаторСтроки Из МассивИдентификаторов Цикл
		Если ИдентификаторСтроки <> Неопределено Тогда
			Данные = Объект.ИсследованияТоваров.НайтиПоИдентификатору(ИдентификаторСтроки);
			Данные[ИмяРеквизита] = УстанавливаемоеЗначение;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Функция ИсследованиеЗавершено(Отбор)
	
	ДокументОбъект = РеквизитФормыВЗначение("Объект");
	
	НайденныеИсследования = ДокументОбъект.ИсследованияТоваров.НайтиСтроки(Отбор);
	Если НайденныеИсследования.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ИсследованиеЗавершено = Истина;
	
	Для каждого СтрокаМассива Из НайденныеИсследования Цикл
		Если Не ЗначениеЗаполнено(СтрокаМассива.Результат) Тогда
			ИсследованиеЗавершено = Ложь;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат ИсследованиеЗавершено;
	
КонецФункции

&НаСервере
Процедура ПланИРезультатИсследованияПередУдалениемНаСервере()
	
	Для Каждого ТекИдентификатор Из Элементы.ПланИРезультатИсследования.ВыделенныеСтроки Цикл
		УдалитьИсследования(ТекИдентификатор);
		Объект.ПланИРезультатИсследования.Удалить(Объект.ПланИРезультатИсследования.НайтиПоИдентификатору(ТекИдентификатор));
	КонецЦикла;
	
	Если Не ИсследоватьНесколькоТоваров Тогда
		Если Объект.ПланИРезультатИсследования.Количество() = 0 Тогда
			НоваяСтрока = Объект.ПланИРезультатИсследования.Добавить();
			ИдентификаторСтроки = НоваяСтрока.ПолучитьИдентификатор();
		Иначе
			ИдентификаторСтроки = Объект.ПланИРезультатИсследования[0].ПолучитьИдентификатор();
			Элементы.ПланИРезультатИсследования.ТекущаяСтрока = ИдентификаторСтроки;
		КонецЕсли;
		Элементы.ПланИРезультатИсследования.ТекущаяСтрока = ИдентификаторСтроки;
	КонецЕсли;
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаСервере
Процедура УдалитьИсследования(ТекущийИдентификатор)
	
	ТекущиеДанные = Объект.ПланИРезультатИсследования.НайтиПоИдентификатору(ТекущийИдентификатор);
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Отбор = Новый Структура;
	Отбор.Вставить("Номенклатура", ТекущиеДанные.Номенклатура);
	Отбор.Вставить("Характеристика", ТекущиеДанные.Характеристика);
	Отбор.Вставить("Серия", ТекущиеДанные.Серия);
	НайденныеСтроки = Объект.ПланИРезультатИсследования.НайтиСтроки(Отбор);
	Если НайденныеСтроки.Количество() = 1 Тогда
		НайденныеИсследования = Объект.ИсследованияТоваров.НайтиСтроки(Новый Структура("Номенклатура, Характеристика, Серия", ТекущиеДанные.Номенклатура, ТекущиеДанные.Характеристика, ТекущиеДанные.Серия));
		Если НайденныеИсследования.Количество() <> 0 Тогда
			Для Каждого Строка Из НайденныеИсследования Цикл
				Объект.ИсследованияТоваров.Удалить(Строка);
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьРезультатИсследованияДляСтроки()

	ТекущиеДанные = Элементы.ИсследованияТоваров.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если ТекущиеДанные.Разрушен Тогда
		Возврат;
	КонецЕсли;

	ОчиститьСообщения();

	ШаблонСообщения = НСтр("ru = 'Не верно заполнена колонка ""%1"" в строке %2 табличной части ""%3"". %4';
							|en = 'The ""%1"" column in line %2 of the ""%3"" table is not filled in correctly. %4'");
	ПолеНорма = НСтр("ru = 'Норма';
					|en = 'Standard'");
	Факт = СокрЛП(ТекущиеДанные.Факт);
	Норма = СокрЛП(ТекущиеДанные.Норма);
	ТекстСообщения = "";

	ЕстьОшибка = Ложь;
	ЕстьОшибкаФакт = Ложь;
	ПроверитьДиапазон = Ложь;
	ПроверитьСписокЗначений = Ложь;
		
		// Проверка Факта
	ЗначениеФакт = СтроковыеФункцииКлиентСервер.СтрокаВЧисло(Факт);
	Если ЗначениеФакт = Неопределено Тогда
		ЕстьОшибка = Истина;
		ЕстьОшибкаФакт = Истина;
		ПроверитьСписокЗначений = Истина;
	КонецЕсли;
		
		// Числовое значение
	НормаЧисло = СтроковыеФункцииКлиентСервер.СтрокаВЧисло(Норма);
	Если НормаЧисло = Неопределено Тогда
		ЕстьОшибка = Истина;
		ПроверитьДиапазон = Истина;
	КонецЕсли;

	Если Не ЕстьОшибка Тогда
		Если ЗначениеФакт = НормаЧисло Тогда
			ТекущиеДанные.Результат = ПредопределенноеЗначение(
						"Перечисление.РезультатИсследованияТоваров.Пройдено");
		Иначе
			ТекущиеДанные.Результат = ПредопределенноеЗначение(
						"Перечисление.РезультатИсследованияТоваров.НеПройдено");
		КонецЕсли;
		Возврат;
	КонецЕсли;
		
		// Диапазон
	ЧастиДиапазона = СтрРазделить(Норма, "-");
	Если ЧастиДиапазона.Количество() = 2 И ПроверитьДиапазон И Не ЕстьОшибкаФакт Тогда

		ЕстьОшибка = Ложь;

		ЧислоСлева = СтроковыеФункцииКлиентСервер.СтрокаВЧисло(ЧастиДиапазона[0]);
		Если ЧислоСлева = Неопределено Тогда
			ЕстьОшибка = Истина;
		КонецЕсли;

		ЧислоСправа = СтроковыеФункцииКлиентСервер.СтрокаВЧисло(ЧастиДиапазона[1]);
		Если ЧислоСправа = Неопределено Тогда
			ЕстьОшибка = Истина;
		КонецЕсли;

		Если Не ЕстьОшибка Тогда
			Если ЧислоСлева > ЧислоСправа Тогда
				ТекстСообщения = СтрШаблон(ШаблонСообщения, НСтр("ru = 'Норма';
																|en = 'Standard'"), ТекущиеДанные.НомерСтроки, НСтр(
						"ru = 'Исследования';
						|en = 'Research'"), НСтр("ru = 'В первой части диапазона число больше чем во второй';
													|en = 'The number in the first part of the range is greater than in the second part'"));

				ОбщегоНазначенияКлиент.СообщитьПользователю(
					ТекстСообщения, , ПолеНорма, "Объект.Норма", Истина);
				ЕстьОшибка = Истина;
			КонецЕсли;
		КонецЕсли;

		Если Не ЕстьОшибка Тогда
			Если ЗначениеФакт >= ЧислоСлева И ЗначениеФакт <= ЧислоСправа Тогда
				ТекущиеДанные.Результат = ПредопределенноеЗначение(
						"Перечисление.РезультатИсследованияТоваров.Пройдено");
			Иначе
				ТекущиеДанные.Результат = ПредопределенноеЗначение(
						"Перечисление.РезультатИсследованияТоваров.НеПройдено");
			КонецЕсли;
		Иначе
			ПроверитьСписокЗначений = Истина;
		КонецЕсли;
	ИначеЕсли ЧастиДиапазона.Количество() = 3 И ПроверитьДиапазон И Не ЕстьОшибкаФакт Тогда
		ЕстьОшибка = Ложь;

		ЗначениеД1 = СокрЛП(ЧастиДиапазона[0]);
		ЧислоСлева = СтроковыеФункцииКлиентСервер.СтрокаВЧисло(ЧастиДиапазона[1]);
		Если ЧислоСлева = Неопределено Или Не ПустаяСтрока(ЗначениеД1) Тогда

			Если Не ПустаяСтрока(ЗначениеД1) Тогда
				ТекстСообщения = СтрШаблон(ШаблонСообщения, НСтр("ru = 'Норма';
																|en = 'Standard'"), ТекущиеДанные.НомерСтроки, НСтр(
						"ru = 'Исследования';
						|en = 'Research'"), НСтр("ru = 'В первой части диапазона число больше чем во второй';
													|en = 'The number in the first part of the range is greater than in the second part'"));
			КонецЕсли;

			ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения, , ПолеНорма, "Объект.Норма", Истина);
			ЕстьОшибка = Истина;
		КонецЕсли;
		ЧислоСправа = СтроковыеФункцииКлиентСервер.СтрокаВЧисло(ЧастиДиапазона[2]);
		Если ЧислоСправа = Неопределено Тогда
			ЕстьОшибка = Истина;
		КонецЕсли;

		Если Не ЕстьОшибка Тогда
			Если -ЧислоСлева > ЧислоСправа Тогда
				ТекстСообщения = СтрШаблон(ШаблонСообщения, НСтр("ru = 'Норма';
																|en = 'Standard'"), ТекущиеДанные.НомерСтроки, НСтр(
						"ru = 'Исследования';
						|en = 'Research'"), НСтр("ru = 'В первой части диапазона число больше чем во второй';
													|en = 'The number in the first part of the range is greater than in the second part'"));

				ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения, , ПолеНорма, "Объект.Норма", Истина);
				ЕстьОшибка = Истина;
			КонецЕсли;
		КонецЕсли;

		Если Не ЕстьОшибка Тогда
			Если ЗначениеФакт >= -ЧислоСлева И ЗначениеФакт <= ЧислоСправа Тогда
				ТекущиеДанные.Результат = ПредопределенноеЗначение(
						"Перечисление.РезультатИсследованияТоваров.Пройдено");
			Иначе
				ТекущиеДанные.Результат = ПредопределенноеЗначение(
						"Перечисление.РезультатИсследованияТоваров.НеПройдено");
			КонецЕсли;
		Иначе
			ПроверитьСписокЗначений = Истина;
		КонецЕсли;

	ИначеЕсли ЧастиДиапазона.Количество() = 4 И ПроверитьДиапазон И Не ЕстьОшибкаФакт Тогда

		ЕстьОшибка = Ложь;

		ЗначениеД1 = СокрЛП(ЧастиДиапазона[0]);
		ЧислоСлева = СтроковыеФункцииКлиентСервер.СтрокаВЧисло(ЧастиДиапазона[1]);
		Если ЧислоСлева = Неопределено Или Не ПустаяСтрока(ЗначениеД1) Тогда
			ЕстьОшибка = Истина;
		КонецЕсли;

		ЗначениеД3 = СокрЛП(ЧастиДиапазона[2]);
		ЧислоСправа = СтроковыеФункцииКлиентСервер.СтрокаВЧисло(ЧастиДиапазона[3]);
		Если ЧислоСправа = Неопределено Или Не ПустаяСтрока(ЗначениеД3) Тогда
			ЕстьОшибка = Истина;
		КонецЕсли;

		Если Не ЕстьОшибка Тогда
			Если -ЧислоСлева > -ЧислоСправа Тогда
				ТекстСообщения = СтрШаблон(ШаблонСообщения, НСтр("ru = 'Норма';
																|en = 'Standard'"), ТекущиеДанные.НомерСтроки, НСтр(
						"ru = 'Исследования';
						|en = 'Research'"), НСтр("ru = 'В первой части диапазона число больше чем во второй';
													|en = 'The number in the first part of the range is greater than in the second part'"));

				ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения, , ПолеНорма, "Объект.Норма", Истина);
				ЕстьОшибка = Истина;
			КонецЕсли;
		КонецЕсли;

		Если Не ЕстьОшибка Тогда
			Если ЗначениеФакт >= -ЧислоСлева И ЗначениеФакт <= -ЧислоСправа Тогда
				ТекущиеДанные.Результат = ПредопределенноеЗначение(
						"Перечисление.РезультатИсследованияТоваров.Пройдено");
			Иначе
				ТекущиеДанные.Результат = ПредопределенноеЗначение(
						"Перечисление.РезультатИсследованияТоваров.НеПройдено");
			КонецЕсли;
		Иначе
			ПроверитьСписокЗначений = Истина;
		КонецЕсли;
	КонецЕсли;

		// Список значений
	Если ПроверитьСписокЗначений И (СтрНайти(Норма, ";") > 0 Или СтрНайти(Норма, "/") > 0) Тогда
		СписокЗначений = СтрРазделить(Норма, ";/");
		ТекущиеДанные.Результат = ПредопределенноеЗначение(
				"Перечисление.РезультатИсследованияТоваров.НеПройдено");
		Для Каждого Значение Из СписокЗначений Цикл
			Если Значение = Факт Тогда
				ТекущиеДанные.Результат = ПредопределенноеЗначение(
						"Перечисление.РезультатИсследованияТоваров.Пройдено");
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ИнициализироватьКэш()
	
	Кэш = Новый Структура;
	
	Кэш.Вставить("ЦветНажатойГиперссылки", ЦветаСтиля.ГиперссылкаЦвет);
	Кэш.Вставить("ЦветНеНажатойГиперссылки", ЦветаСтиля.ЦветНедоступногоТекста);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьЗаявкаНаКонтрольКачестваТоваровЗавершение(ЗаявкаНаКонтрольКачестваТоваров, ДополнительныеПараметры) Экспорт

	Если ЗаявкаНаКонтрольКачестваТоваров = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ЗаполнитьЗаявкаНаКонтрольКачестваТоваровНаСервере(ЗаявкаНаКонтрольКачестваТоваров);

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьЗаявкаНаКонтрольКачестваТоваровНаСервере(ЗаявкаНаКонтрольКачестваТоваров)
	
	СкладЗаявкиНаКонтроль = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЗаявкаНаКонтрольКачестваТоваров, "Склад");

	Если ЗначениеЗаполнено(СкладЗаявкиНаКонтроль) Тогда
		Объект.Склад = СкладЗаявкиНаКонтроль;
		Элементы.Склад.СписокВыбора.Очистить();
		Элементы.Склад.СписокВыбора.Добавить(СкладЗаявкиНаКонтроль);
	Иначе
		СписокСкладов = СписокСкладовЗаявкиНаКонтроль(ЗаявкаНаКонтрольКачестваТоваров);
		Если СписокСкладов.Количество() = 1 Тогда
			Объект.Склад = СписокСкладов[0];
			Элементы.Склад.СписокВыбора.Очистить();
			Элементы.Склад.СписокВыбора.Добавить(СписокСкладов[0]);
		Иначе
			Элементы.Склад.ТолькоПросмотр = Ложь;
			Элементы.Склад.СписокВыбора.Очистить();
			Элементы.Склад.СписокВыбора.ЗагрузитьЗначения(СписокСкладов);
		КонецЕсли;
	КонецЕсли;
	Объект.ЗаявкаНаКонтроль = ЗаявкаНаКонтрольКачестваТоваров;
	Элементы.Основание.Заголовок = ОбщегоНазначения.ПредметСтрокой(Объект.ЗаявкаНаКонтроль);

	Модифицированность = Истина;
	
КонецПроцедуры

&НаСервере
Функция СписокСкладовЗаявкиНаКонтроль(ЗаявкаНаКонтрольКачестваТоваров)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗаявкаНаКонтрольКачестваТоваровТовары.Склад КАК Склад
		|ИЗ
		|	Документ.ЗаявкаНаКонтрольКачестваТоваров.Товары КАК ЗаявкаНаКонтрольКачестваТоваровТовары
		|ГДЕ
		|	ЗаявкаНаКонтрольКачестваТоваровТовары.Ссылка = &Ссылка
		|СГРУППИРОВАТЬ ПО
		|	ЗаявкаНаКонтрольКачестваТоваровТовары.Склад";
	
	Запрос.УстановитьПараметр("Ссылка", ЗаявкаНаКонтрольКачестваТоваров);
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Склад");
		
	Возврат РезультатЗапроса;
	
КонецФункции

&НаСервере
Функция ИспользуемаяНоменклатураПланИРезультатИсследования()
	
	ДокументОбъект = РеквизитФормыВЗначение("Объект");
	СписокНоменклатуры = ОбщегоНазначенияУТ.ВыгрузитьЗначенияКолонки(ДокументОбъект.ПланИРезультатИсследования, "Номенклатура");
	ОбщегоНазначенияКлиентСервер.УдалитьВсеВхожденияЗначенияИзМассива(СписокНоменклатуры, Справочники.Номенклатура.ПустаяСсылка());
	Возврат СписокНоменклатуры;
		
КонецФункции

&НаСервере
Функция ИспользуемаяНоменклатураХарактеристикаСерияПланИРезультатИсследования()
	
	ДокументОбъект = РеквизитФормыВЗначение("Объект");
	СтрокиПланаИсследования = ДокументОбъект.ПланИРезультатИсследования.Выгрузить(, "Номенклатура, Характеристика, Серия, ИдентификаторСтроки");
	СтрокиПланаИсследования = СвернутьОставивПервыйИдентификатор(СтрокиПланаИсследования);
	СписокНоменклатуры= Новый Массив;
	Для Каждого СтрокаТЧ Из СтрокиПланаИсследования Цикл
		Если ЗначениеЗаполнено(СтрокаТЧ.Номенклатура) Тогда
			НовыйЭлемент = Новый Структура;
			НовыйЭлемент.Вставить("Номенклатура", СтрокаТЧ.Номенклатура);
			НовыйЭлемент.Вставить("Характеристика", СтрокаТЧ.Характеристика);
			НовыйЭлемент.Вставить("Серия", СтрокаТЧ.Серия);
			НовыйЭлемент.Вставить("ИдентификаторСтроки", СтрокаТЧ.ИдентификаторСтроки);
			СписокНоменклатуры.Добавить(НовыйЭлемент);
		КонецЕсли;
	КонецЦикла;
	
	Возврат СписокНоменклатуры;
		
КонецФункции

&НаСервере
Функция СвернутьОставивПервыйИдентификатор(Знач СписокНоменклатуры)
	
	УникальныйПлан = СписокНоменклатуры.СкопироватьКолонки();
	
	Для Каждого СтрокаТЧ Из СписокНоменклатуры Цикл
		НайденаЗапись = Ложь;
		
		Для Каждого УникальнаяСтрока Из УникальныйПлан Цикл
			Если СтрокаТЧ.Номенклатура = УникальнаяСтрока.Номенклатура
				И СтрокаТЧ.Характеристика = УникальнаяСтрока.Характеристика
				И СтрокаТЧ.Серия = УникальнаяСтрока.Серия Тогда
					НайденаЗапись = Истина;
					Прервать;
			КонецЕсли;
		КонецЦикла;
	
		Если Не НайденаЗапись Тогда
			НоваяСтрока = УникальныйПлан.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТЧ);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат УникальныйПлан;
		
КонецФункции

&НаСервере
Функция ИспользуемаяХарактеристикаПланИРезультатИсследования(Номенклатура)
	
	ДокументОбъект = РеквизитФормыВЗначение("Объект");
	НайденныеСтроки = ДокументОбъект.ПланИРезультатИсследования.Выгрузить(Новый Структура("Номенклатура", Номенклатура));
	СписокХарактеристик = Новый Массив;
	Для Каждого Строка Из НайденныеСтроки Цикл
		Если ЗначениеЗаполнено(Строка.Характеристика) Тогда
			СписокХарактеристик.Добавить(Строка.Характеристика);
		КонецЕсли;
	КонецЦикла;
	
	Возврат ОбщегоНазначенияКлиентСервер.СвернутьМассив(СписокХарактеристик);
		
КонецФункции

&НаСервере
Функция ИспользуемыеХарактеристикиНоменклатурыПланИРезультатИсследования()
	
	ДокументОбъект = РеквизитФормыВЗначение("Объект");
	ХарактеристикиНоменклатуры = ДокументОбъект.ПланИРезультатИсследования.Выгрузить(, "Номенклатура, Характеристика");
	ХарактеристикиНоменклатуры.Свернуть("Номенклатура, Характеристика");
	СписокХарактеристик = Новый Массив;
	Для Каждого СтрокаТЧ Из ХарактеристикиНоменклатуры Цикл
		НовыйЭлемент = Новый Структура;
		НовыйЭлемент.Вставить("Номенклатура", СтрокаТЧ.Номенклатура);
		НовыйЭлемент.Вставить("Характеристика", СтрокаТЧ.Характеристика);
		СписокХарактеристик.Добавить(НовыйЭлемент);
	КонецЦикла;
	
	Возврат СписокХарактеристик;
		
КонецФункции

#КонецОбласти

#КонецОбласти
