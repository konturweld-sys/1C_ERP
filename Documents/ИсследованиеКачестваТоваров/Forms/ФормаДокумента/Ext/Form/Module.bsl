&НаСервере
Процедура СкопироватьСтрокиНаСервере(ВыделенныеСтроки, ИмяТаблицы)
	
	РаботаСТабличнымиЧастями.СкопироватьСтрокиВБуферОбмена(Объект[ИмяТаблицы], ВыделенныеСтроки);
	
КонецПроцедуры

&НаСервере
Процедура ПолучитьСтрокиИзБуфераОбмена()
	
	ПараметрыОтбора = Новый Соответствие;
	ПараметрыОтбора.Вставить("Номенклатура.ТипНоменклатуры",
		НоменклатураКлиентСервер.ОтборПоТоваруМногооборотнойТаре(Ложь));
	
	Колонки =
		"Номенклатура,
		|Характеристика,
		|Назначение,
		|КонтролируемаяПартия,
		|Серия,
		|Склад,
		|Количество,
		|КоличествоГодное,
		|КоличествоРазрушено,
		|КоличествоНегодное,
		|КартаИсследованияТоваров,
		|Упаковка,
		|КоличествоУпаковок";
	
	ТаблицаТоваров = РаботаСТабличнымиЧастями.СтрокиИзБуфераОбмена(ПараметрыОтбора, Колонки);
	
	Если Не ЗначениеЗаполнено(ТаблицаТоваров) Тогда
		Возврат;
	КонецЕсли;
	
	ОбрабатываемыеСтроки = Новый Массив();
	Для Каждого СтрокаТовара Из ТаблицаТоваров Цикл
		
		СтрокаТаблицы = Объект.ПланИРезультатИсследования.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаТаблицы, СтрокаТовара);
		СтрокаТаблицы.ИдентификаторСтроки = Новый УникальныйИдентификатор;
		ОбрабатываемыеСтроки.Добавить(СтрокаТаблицы);
		
	КонецЦикла;
	
	ЗаполнитьПризнакАртикул = Новый Структура("Номенклатура", "Артикул");
	ЗаполнитьПризнакТипНоменклатуры = Новый Структура("Номенклатура", "ТипНоменклатуры");
	ПроверитьСериюРассчитатьСтатус = Новый Структура("Склад, ПараметрыУказанияСерий", Объект.Склад, ПараметрыУказанияСерий["ПланИРезультатИсследования"]);
	ЗаполнитьПризнакХарактеристикиИспользуются = Новый Структура("Номенклатура", "ХарактеристикиИспользуются");
	НоменклатураПриИзмененииПереопределяемый = Новый Структура("ИмяФормы, ИмяТабличнойЧасти",
		ИмяФормы, "ПланИРезультатИсследования");
	
	СтруктураДействий = Новый Структура();
	СтруктураДействий.Вставить("ЗаполнитьПризнакХарактеристикиИспользуются", ЗаполнитьПризнакХарактеристикиИспользуются);
	СтруктураДействий.Вставить("ЗаполнитьПризнакАртикул", ЗаполнитьПризнакАртикул);
	СтруктураДействий.Вставить("ЗаполнитьПризнакТипНоменклатуры", ЗаполнитьПризнакТипНоменклатуры);
	СтруктураДействий.Вставить("НоменклатураПриИзмененииПереопределяемый", НоменклатураПриИзмененииПереопределяемый);
	СтруктураДействий.Вставить("ПересчитатьКоличествоЕдиниц");
	СтруктураДействий.Вставить("ПроверитьСериюРассчитатьСтатус", ПроверитьСериюРассчитатьСтатус);
	
	КэшированныеЗначения = ПакетнаяОбработкаТабличнойЧастиКлиентСервер.ПолучитьСтруктуруКэшируемыеЗначения();
	ПакетнаяОбработкаТабличнойЧастиСервер.ОбработатьСтрокиТЧ(
		ОбрабатываемыеСтроки,
		СтруктураДействий,
		Объект.ПланИРезультатИсследования,
		КэшированныеЗначения);
	
	НоменклатураСервер.ЗаполнитьСтатусыУказанияСерий(Объект, ПараметрыУказанияСерий["ПланИРезультатИсследования"], ОбрабатываемыеСтроки);
	
КонецПроцедуры

&НаСервере
Процедура ПолучитьСтрокиИзБуфераОбменаИсследования()
	
	ПараметрыОтбора = Новый Соответствие;
	ПараметрыОтбора.Вставить("Номенклатура.ТипНоменклатуры",
		НоменклатураКлиентСервер.ОтборПоТоваруМногооборотнойТаре(Ложь));
	
	Колонки =
		"Номенклатура,
		|Характеристика,
		|Серия,
		|Образец,
		|ВидПроверки,
		|ПоказательКачества,
		|Количество,
		|Норма,
		|Факт,
		|Описание,
		|Результат,
		|ИдентификаторСтроки,
		|ИдентификаторЭкземпляра";
	
	ТаблицаТоваров = РаботаСТабличнымиЧастями.СтрокиИзБуфераОбмена(ПараметрыОтбора, Колонки);
	
	Если Не ЗначениеЗаполнено(ТаблицаТоваров) Тогда
		Возврат;
	КонецЕсли;
	
	СписокНоменклатуры = ИспользуемаяНоменклатураПланИРезультатИсследования();
	ОбрабатываемыеСтроки = Новый Массив();
	Для Каждого СтрокаТовара Из ТаблицаТоваров Цикл

		СтрокаТаблицы = Объект.ИсследованияТоваров.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаТаблицы, СтрокаТовара);
		ОбрабатываемыеСтроки.Добавить(СтрокаТаблицы);

		НайденнаяНоменклатура = СписокНоменклатуры.Найти(СтрокаТовара.Номенклатура);
		Если НайденнаяНоменклатура = Неопределено Тогда
			СтрокаТаблицы.Номенклатура = Справочники.Номенклатура.ПустаяСсылка();
		КонецЕсли;

	КонецЦикла;
	
	ЗаполнитьПризнакТипНоменклатуры = Новый Структура("Номенклатура", "ТипНоменклатуры");
	ПроверитьСериюРассчитатьСтатус = Новый Структура("Склад, ПараметрыУказанияСерий", Объект.Склад, ПараметрыУказанияСерий["ИсследованияТоваров"]);
	ЗаполнитьПризнакХарактеристикиИспользуются = Новый Структура("Номенклатура", "ХарактеристикиИспользуются");
	НоменклатураПриИзмененииПереопределяемый = Новый Структура("ИмяФормы, ИмяТабличнойЧасти",
		ИмяФормы, "ИсследованияТоваров");
	
	СтруктураДействий = Новый Структура();
	СтруктураДействий.Вставить("ЗаполнитьПризнакХарактеристикиИспользуются", ЗаполнитьПризнакХарактеристикиИспользуются);
	СтруктураДействий.Вставить("ЗаполнитьПризнакТипНоменклатуры", ЗаполнитьПризнакТипНоменклатуры);
	СтруктураДействий.Вставить("НоменклатураПриИзмененииПереопределяемый", НоменклатураПриИзмененииПереопределяемый);
	СтруктураДействий.Вставить("ПроверитьСериюРассчитатьСтатус", ПроверитьСериюРассчитатьСтатус);
	
	КэшированныеЗначения = ПакетнаяОбработкаТабличнойЧастиКлиентСервер.ПолучитьСтруктуруКэшируемыеЗначения();
	ПакетнаяОбработкаТабличнойЧастиСервер.ОбработатьСтрокиТЧ(
		ОбрабатываемыеСтроки,
		СтруктураДействий,
		Объект.ИсследованияТоваров,
		КэшированныеЗначения);
	
	НоменклатураСервер.ЗаполнитьСтатусыУказанияСерий(Объект, ПараметрыУказанияСерий["ИсследованияТоваров"], ОбрабатываемыеСтроки);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьДоступностьКомандБуфераОбмена()
	
	МассивЭлементов = Новый Массив();
	МассивЭлементов.Добавить("ВставитьСтроки");
	МассивЭлементов.Добавить("ПланИРезультатИсследованияКонтекстноеМенюВставитьСтроки");
	
	ОбщегоНазначенияУТКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, МассивЭлементов, "Доступность",
		РаботаСТабличнымиЧастями.ЕстьСтрокиВБуфереОбмена());
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьДоступностьКомандБуфераОбменаНаКлиенте()
	
	МассивЭлементов = Новый Массив();
	МассивЭлементов.Добавить("ВставитьСтроки");
	МассивЭлементов.Добавить("ПланИРезультатИсследованияКонтекстноеМенюВставитьСтроки");
	
	ОбщегоНазначенияУТКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, МассивЭлементов, "Доступность", Истина);
	
КонецПроцедуры

#КонецОбласти

&НаКлиенте
Процедура РазбитьСтрокуЗавершение(НоваяСтрока, ДополнительныеПараметры) Экспорт 
	
	ТекущаяСтрока = Элементы.ПланИРезультатИсследования.ТекущиеДанные;
	
	Если НоваяСтрока <> Неопределено Тогда
		
		СтруктураДействий = Новый Структура();
		СтруктураДействий.Вставить("ПересчитатьКоличествоЕдиниц");
		ПакетнаяОбработкаТабличнойЧастиКлиент.ОбработатьСтрокуТЧ(ТекущаяСтрока, СтруктураДействий, КэшированныеЗначения);
		ПакетнаяОбработкаТабличнойЧастиКлиент.ОбработатьСтрокуТЧ(НоваяСтрока, СтруктураДействий, КэшированныеЗначения);
				
	КонецЕсли;
	
	НастроитьЗависимыеЭлементыФормы(ЭтотОбъект, "ВидФормы");
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьРезультатПроверкиКачестваПослеВыбора(ВыбранноеЗначение, ДополнительныеПараметры) Экспорт
	
	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ЗаполнитьРезультатПроверкиКачестваПослеВыбораСервер(ВыбранноеЗначение);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьРезультатПроверкиКачестваПослеВыбораСервер(ВыбранноеЗначение)
	
	Для Каждого Идентификатор Из Элементы.ПланИРезультатИсследования.ВыделенныеСтроки Цикл
		
		Объект.ПланИРезультатИсследования.НайтиПоИдентификатору(Идентификатор).РезультатПроверкиКачества = ВыбранноеЗначение;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоОстаткамСервер(Знач КомпоновщикНастроек)
	
	Объект.ПланИРезультатИсследования.Очистить();
	НастройкиЗаполненияПоОстаткам.ЗагрузитьНастройки(КомпоновщикНастроек.ПолучитьНастройки());
	НастройкиЗаполненияПоОстаткам.ЗагрузитьПользовательскиеНастройки(КомпоновщикНастроек.ПользовательскиеНастройки);
	
	СхемаКомпоновкиДанных = Документы.ЗаявкаНаКонтрольКачестваТоваров.ПолучитьМакет("СхемаЗаполненияПоОстаткам");
	НастройкиКомпоновки = НастройкиЗаполненияПоОстаткам.ПолучитьНастройки();
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных,
		НастройкиКомпоновки, , , Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки);
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	Аналитики = ПроцессорВывода.Вывести(ПроцессорКомпоновки);
	Объект.ПланИРезультатИсследования.Загрузить(КонтрольКачества.ОстаткиПоАналитикам(Аналитики, Истина, Объект.Дата));
	
КонецПроцедуры

&НаКлиенте
Процедура НастройкаЗаполненияПоОстаткамЗавершение(РезультатЗакрытия, ДополнительныеПараметры) Экспорт

	Если ТипЗнч(РезультатЗакрытия) = Тип("КомпоновщикНастроекКомпоновкиДанных") Тогда
		ЗаполнитьПоОстаткамСервер(РезультатЗакрытия);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаВыбораПодборНаСервере(ВыбранноеЗначение)

	ТаблицаТоваров = ПолучитьИзВременногоХранилища(ВыбранноеЗначение.АдресТоваровВХранилище);
	
	Если Не ЗначениеЗаполнено(ТаблицаТоваров) Тогда
		Возврат;
	КонецЕсли;

	ОбрабатываемыеСтроки = Новый Массив;
	Для Каждого СтрокаТовара Из ТаблицаТоваров Цикл

		СтрокаТаблицы = Объект.ПланИРезультатИсследования.Добавить();
		ОбрабатываемыеСтроки.Добавить(СтрокаТаблицы);
		СтрокаТаблицы.ИдентификаторСтроки = Новый УникальныйИдентификатор();
		ЗаполнитьЗначенияСвойств(СтрокаТаблицы, СтрокаТовара,
			"Номенклатура,Характеристика,Упаковка,КоличествоУпаковок,Серия");

	КонецЦикла;

	ЗаполнитьПризнакАртикул = Новый Структура("Номенклатура", "Артикул");
	ЗаполнитьПризнакТипНоменклатуры = Новый Структура("Номенклатура", "ТипНоменклатуры");
	НоменклатураПриИзмененииПереопределяемый = Новый Структура("ИмяФормы, ИмяТабличнойЧасти", ИмяФормы,
		"ПланИРезультатИсследования");

	СтруктураДействий = Новый Структура;
	СтруктураДействий.Вставить("ЗаполнитьПризнакАртикул", ЗаполнитьПризнакАртикул);
	СтруктураДействий.Вставить("ЗаполнитьПризнакТипНоменклатуры", ЗаполнитьПризнакТипНоменклатуры);
	СтруктураДействий.Вставить("НоменклатураПриИзмененииПереопределяемый", НоменклатураПриИзмененииПереопределяемый);
	СтруктураДействий.Вставить("ПроверитьХарактеристикуПоВладельцу", СтрокаТаблицы.Характеристика);
	СтруктураДействий.Вставить("ПересчитатьКоличествоЕдиниц");

	КэшированныеЗначения = ПакетнаяОбработкаТабличнойЧастиКлиентСервер.ПолучитьСтруктуруКэшируемыеЗначения();
	ПакетнаяОбработкаТабличнойЧастиСервер.ОбработатьСтрокиТЧ(
			ОбрабатываемыеСтроки, СтруктураДействий, Объект.ПланИРезультатИсследования, КэшированныеЗначения);

	НоменклатураСервер.ЗаполнитьСтатусыУказанияСерий(Объект, ПараметрыУказанияСерий["ПланИРезультатИсследования"], ОбрабатываемыеСтроки);

КонецПроцедуры

&НаКлиенте
Процедура ПланИРезультатИсследованияПоискПоШтрихкодуЗавершение(ДанныхШтрихкода, ДополнительныеПараметры) Экспорт
	
	ОбработатьШтрихкоды(ДанныхШтрихкода);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьШтрихкоды(ДанныеШтрихкодов)
	
	ОчиститьСообщения();
	
	Если Не ШтрихкодированиеНоменклатурыКлиент.ШтрихкодыВалидны(ДанныеШтрихкодов) Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьПризнакАртикул = Новый Структура("Номенклатура", "Артикул");
	ЗаполнитьПризнакТипНоменклатуры = Новый Структура("Номенклатура", "ТипНоменклатуры");

	НоменклатураПриИзмененииПереопределяемый = Новый Структура("ИмяФормы, ИмяТабличнойЧасти",
		ИмяФормы, "ПланИРезультатИсследования");
	ПроверитьСериюРассчитатьСтатус = Новый Структура("Склад, ПараметрыУказанияСерий", Объект.Склад, ПараметрыУказанияСерий["ПланИРезультатИсследования"]);
	
	СтруктураДействийСДобавленнымиСтроками = Новый Структура();
	СтруктураДействийСДобавленнымиСтроками.Вставить("ЗаполнитьПризнакАртикул", ЗаполнитьПризнакАртикул);
	СтруктураДействийСДобавленнымиСтроками.Вставить("ЗаполнитьПризнакТипНоменклатуры", ЗаполнитьПризнакТипНоменклатуры);
	СтруктураДействийСДобавленнымиСтроками.Вставить("НоменклатураПриИзмененииПереопределяемый", НоменклатураПриИзмененииПереопределяемый);
	СтруктураДействийСДобавленнымиСтроками.Вставить("ПересчитатьКоличествоЕдиниц");
	СтруктураДействийСДобавленнымиСтроками.Вставить("ПроверитьСериюРассчитатьСтатус", ПроверитьСериюРассчитатьСтатус);
	
	СтруктураДействийСИзмененнымиСтроками = Новый Структура();
	СтруктураДействийСИзмененнымиСтроками.Вставить("ПересчитатьКоличествоЕдиниц");
	
	ПараметрыОбработкиШтрихкодов = ШтрихкодированиеНоменклатурыКлиент.ПараметрыОбработкиШтрихкодов();
	
	ПараметрыОбработкиШтрихкодов.Штрихкоды = ДанныеШтрихкодов;
	ПараметрыОбработкиШтрихкодов.СтруктураДействийСДобавленнымиСтроками = СтруктураДействийСДобавленнымиСтроками;
	ПараметрыОбработкиШтрихкодов.СтруктураДействийСИзмененнымиСтроками = СтруктураДействийСИзмененнымиСтроками;
	ПараметрыОбработкиШтрихкодов.ПараметрыУказанияСерий = ПараметрыУказанияСерий["ПланИРезультатИсследования"];
	ПараметрыОбработкиШтрихкодов.ИзменятьКоличество = Истина;
	ПараметрыОбработкиШтрихкодов.ТолькоТовары = Истина;
	ПараметрыОбработкиШтрихкодов.ИмяТЧ = "ПланИРезультатИсследования";
	
	ОбработатьШтрихкодыСервер(ПараметрыОбработкиШтрихкодов, КэшированныеЗначения);
	
	ШтрихкодированиеНоменклатурыКлиент.ОбработатьНеизвестныеШтрихкоды(ПараметрыОбработкиШтрихкодов,
		КэшированныеЗначения, ЭтотОбъект);
	
	Если ШтрихкодированиеНоменклатурыКлиент.НужноОткрытьФормуУказанияСерийПослеОбработкиШтрихкодов(ПараметрыОбработкиШтрихкодов) Тогда
		ТекущиеДанныеИдентификатор = ПараметрыОбработкиШтрихкодов.МассивСтрокССериями[0];
		ПодключитьОбработчикОжидания("ОткрытьПодборСерийПриСканированииШтрихкодаНоменклатуры", 0.1, Истина);
	КонецЕсли;

	Если ПараметрыОбработкиШтрихкодов.ТекущаяСтрока <> Неопределено Тогда
		Элементы.ПланИРезультатИсследования.ТекущаяСтрока = ПараметрыОбработкиШтрихкодов.ТекущаяСтрока;
	КонецЕсли;
	
	Если Объект.ПланИРезультатИсследования.Количество() > 1 Тогда
		ИсследоватьНесколькоТоваров = Истина; 
	КонецЕсли;
	
	НастроитьЗависимыеЭлементыФормы(ЭтотОбъект, "ВидФормы");
	
КонецПроцедуры

&НаСервере
Процедура ОбработатьШтрихкодыСервер(СтруктураПараметровДействия, КэшированныеЗначения)
	
	ТипыНоменклатуры = НоменклатураСервер.ДопустимыеТипыНоменклатурыДляВыбора(
		Перечисления.ХозяйственныеОперации.КонтрольКачестваТоваров);
	
	ЕстьРаботы = ТипыНоменклатуры.Найти(Перечисления.ТипыНоменклатуры.Работа) <> Неопределено;
	ЕстьУслуги = ТипыНоменклатуры.Найти(Перечисления.ТипыНоменклатуры.Услуга) <> Неопределено;
	
	СтруктураПараметровДействия.ТолькоТовары = Не (ЕстьРаботы Или ЕстьУслуги);
	СтруктураПараметровДействия.ТолькоТоварыИРабота = ЕстьРаботы И Не ЕстьУслуги;
	СтруктураПараметровДействия.ТолькоТоварыИУслуги = ЕстьУслуги И Не ЕстьРаботы;
	
	ШтрихкодированиеНоменклатурыСервер.ОбработатьШтрихкоды(ЭтотОбъект,
		Объект, СтруктураПараметровДействия, КэшированныеЗначения);
	
КонецПроцедуры

&НаСервере
Процедура ПодобратьПроверкиНаСервере()
	
	ОбрабатываемыеСтроки = Новый Массив();
	
	Для Каждого СтрокаТаблицы Из Объект.ПланИРезультатИсследования Цикл
		
		ИдентификаторЭкземпляра = Новый УникальныйИдентификатор;
	
		Для Каждого СтрокаПроверки Из Проверки Цикл

			НоваяСтрока = Объект.ИсследованияТоваров.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаПроверки);
			НоваяСтрока.ИдентификаторЭкземпляра = ИдентификаторЭкземпляра;
			ОбрабатываемыеСтроки.Добавить(НоваяСтрока);
			
		КонецЦикла;

	КонецЦикла;
	
	ЗаполнитьПризнакТипНоменклатуры = Новый Структура("Номенклатура", "ТипНоменклатуры");
	ПроверитьСериюРассчитатьСтатус = Новый Структура("Склад, ПараметрыУказанияСерий", Объект.Склад, ПараметрыУказанияСерий["ИсследованияТоваров"]);
	ЗаполнитьПризнакХарактеристикиИспользуются = Новый Структура("Номенклатура", "ХарактеристикиИспользуются");
	
	СтруктураДействий = Новый Структура();
	СтруктураДействий.Вставить("ЗаполнитьПризнакХарактеристикиИспользуются", ЗаполнитьПризнакХарактеристикиИспользуются);
	СтруктураДействий.Вставить("ЗаполнитьПризнакТипНоменклатуры", ЗаполнитьПризнакТипНоменклатуры);
	СтруктураДействий.Вставить("ПроверитьСериюРассчитатьСтатус", ПроверитьСериюРассчитатьСтатус);
	
	КэшированныеЗначения = ПакетнаяОбработкаТабличнойЧастиКлиентСервер.ПолучитьСтруктуруКэшируемыеЗначения();
	ПакетнаяОбработкаТабличнойЧастиСервер.ОбработатьСтрокиТЧ(
		ОбрабатываемыеСтроки,
		СтруктураДействий,
		Объект.ИсследованияТоваров,
		КэшированныеЗначения);
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьРезультатЗавершение(Результат, ДополнительныеПараметры) Экспорт

	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьЗначениеРеквизитаВсемСтрокам("Результат", Результат, ДополнительныеПараметры.ИдентификаторСтроки);

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьРезультатИсследования()

	ТаблицаПодсчетаРезультатаИсследований = Новый ТаблицаЗначений;
	ТаблицаПодсчетаРезультатаИсследований.Колонки.Добавить("Номенклатура");
	ТаблицаПодсчетаРезультатаИсследований.Колонки.Добавить("Характеристика");
	ТаблицаПодсчетаРезультатаИсследований.Колонки.Добавить("Серия");
	ТаблицаПодсчетаРезультатаИсследований.Колонки.Добавить("ИдентификаторЭкземпляра");
	ТаблицаПодсчетаРезультатаИсследований.Колонки.Добавить("Пройдено");
	ТаблицаПодсчетаРезультатаИсследований.Колонки.Добавить("НеПройдено");
	ТаблицаПодсчетаРезультатаИсследований.Колонки.Добавить("Разрушено");
	ТаблицаПодсчетаРезультатаИсследований.Колонки.Добавить("ИсследованиеЗавершено");

	ТаблицаДляПоиска = Объект.ПланИРезультатИсследования.Выгрузить( , "Номенклатура,Характеристика,Серия");
	ТаблицаДляПоиска.Свернуть("Номенклатура,Характеристика,Серия");

	Для Каждого СтрокаТаблицы Из ТаблицаДляПоиска Цикл

		Отбор = Новый Структура;
		Отбор.Вставить("Номенклатура", СтрокаТаблицы.Номенклатура);
		Отбор.Вставить("Характеристика", СтрокаТаблицы.Характеристика);
		Если ЗначениеЗаполнено(СтрокаТаблицы.Серия) Тогда
			Отбор.Вставить("Серия", СтрокаТаблицы.Серия);
		КонецЕсли;

		НайденныеИсследования = Объект.ИсследованияТоваров.НайтиСтроки(Отбор);
		Если НайденныеИсследования.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;

		Для Каждого СтрокаМассива Из НайденныеИсследования Цикл

			РасчетЭкземпляра = ТаблицаПодсчетаРезультатаИсследований.НайтиСтроки(
				Новый Структура("ИдентификаторЭкземпляра", СтрокаМассива.ИдентификаторЭкземпляра));
			Если РасчетЭкземпляра.Количество() = 0 Тогда
				НоваяСтрока = ТаблицаПодсчетаРезультатаИсследований.Добавить();
				НоваяСтрока.Номенклатура = СтрокаМассива.Номенклатура;
				НоваяСтрока.Характеристика = СтрокаМассива.Характеристика;
				Если ЗначениеЗаполнено(СтрокаТаблицы.Серия) Тогда
					НоваяСтрока.Серия = СтрокаТаблицы.Серия;
				Иначе
					НоваяСтрока.Серия = СтрокаМассива.Серия;
				КонецЕсли;
				НоваяСтрока.ИдентификаторЭкземпляра = СтрокаМассива.ИдентификаторЭкземпляра;
				НоваяСтрока.Пройдено = 0;
				НоваяСтрока.НеПройдено = 0;
				НоваяСтрока.Разрушено = 0;
				НоваяСтрока.ИсследованиеЗавершено = Истина;
				Если Не ЗначениеЗаполнено(СтрокаМассива.Результат) Тогда
					НоваяСтрока.ИсследованиеЗавершено = Ложь;
				Иначе
					Если СтрокаМассива.Результат = Перечисления.РезультатИсследованияТоваров.Пройдено Тогда
						НоваяСтрока.Пройдено = СтрокаМассива.Количество;
					ИначеЕсли СтрокаМассива.Результат
						= Перечисления.РезультатИсследованияТоваров.ПройденоСДругимКачеством Тогда
						НоваяСтрока.НеПройдено = СтрокаМассива.Количество;
					ИначеЕсли СтрокаМассива.Результат = Перечисления.РезультатИсследованияТоваров.НеПройдено Тогда
						НоваяСтрока.НеПройдено = СтрокаМассива.Количество;
					КонецЕсли;
					Если СтрокаМассива.Разрушен Тогда
						НоваяСтрока.Разрушено = СтрокаМассива.Количество;
					КонецЕсли;
				КонецЕсли;
			Иначе
				НайденныйЭкземпляр = РасчетЭкземпляра[0];

				Если Не ЗначениеЗаполнено(СтрокаМассива.Результат) Или НайденныйЭкземпляр.ИсследованиеЗавершено = Ложь Тогда
					НайденныйЭкземпляр.ИсследованиеЗавершено = Ложь;
				Иначе
					Если СтрокаМассива.Результат = Перечисления.РезультатИсследованияТоваров.Пройдено
						И НайденныйЭкземпляр.НеПройдено = 0 Тогда
						НайденныйЭкземпляр.Пройдено = СтрокаМассива.Количество;
					Иначе
						НайденныйЭкземпляр.Пройдено = 0;
					КонецЕсли;

					Если СтрокаМассива.Результат = Перечисления.РезультатИсследованияТоваров.НеПройдено
						Или СтрокаМассива.Результат = Перечисления.РезультатИсследованияТоваров.ПройденоСДругимКачеством Тогда
						НайденныйЭкземпляр.НеПройдено = СтрокаМассива.Количество;
					КонецЕсли;

					Если СтрокаМассива.Разрушен Тогда
						НайденныйЭкземпляр.Разрушено = СтрокаМассива.Количество;
					КонецЕсли;

				КонецЕсли;
			КонецЕсли;

		КонецЦикла;

	КонецЦикла;

	Если ТаблицаПодсчетаРезультатаИсследований.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Для Каждого СтрокаРезультат Из Объект.ПланИРезультатИсследования Цикл
		Если Объект.Контроль = Перечисления.КонтрольКачества.Сплошной
			И Объект.СпособПроверкиЭкземпляров = Перечисления.ВариантыПроверкиЭкземпляровИсследования.СОтклонениями Тогда
			СтрокаРезультат.КоличествоГодное = СтрокаРезультат.КоличествоУпаковок;
		Иначе
			СтрокаРезультат.КоличествоГодное = 0;
		КонецЕсли;
		СтрокаРезультат.КоличествоРазрушено = 0;
		СтрокаРезультат.КоличествоНегодное = 0;
	КонецЦикла;

	Если Объект.Контроль = Перечисления.КонтрольКачества.Сплошной
		И Объект.СпособПроверкиЭкземпляров = Перечисления.ВариантыПроверкиЭкземпляровИсследования.Сводно Тогда
		Для Каждого СтрокаПодсчета Из ТаблицаПодсчетаРезультатаИсследований Цикл
			Отбор = Новый Структура;
			Отбор.Вставить("Номенклатура", СтрокаПодсчета.Номенклатура);
			Отбор.Вставить("Характеристика", СтрокаПодсчета.Характеристика);
			Отбор.Вставить("Серия", СтрокаПодсчета.Серия);
			НайденныеСтрокиПланаИсследования = Объект.ПланИРезультатИсследования.НайтиСтроки(Отбор);
			Если НайденныеСтрокиПланаИсследования.Количество() <> 0 Тогда
				Для Каждого СтрокаРезультат Из НайденныеСтрокиПланаИсследования Цикл
					Если СтрокаПодсчета.ИсследованиеЗавершено Тогда
						Если СтрокаПодсчета.НеПройдено <> 0 Тогда
							СтрокаРезультат.КоличествоНегодное = СтрокаРезультат.КоличествоУпаковок;
							СтрокаРезультат.КоличествоГодное = 0;
						ИначеЕсли СтрокаПодсчета.Пройдено <> 0 И СтрокаРезультат.КоличествоНегодное = 0 Тогда
							СтрокаРезультат.КоличествоГодное = СтрокаРезультат.КоличествоУпаковок;
						КонецЕсли;
					Иначе
						СтрокаРезультат.Результат = Ложь;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
		
	ИначеЕсли Объект.Контроль = Перечисления.КонтрольКачества.Сплошной
		И Объект.СпособПроверкиЭкземпляров = Перечисления.ВариантыПроверкиЭкземпляровИсследования.СОтклонениями Тогда
		Для Каждого СтрокаПодсчета Из ТаблицаПодсчетаРезультатаИсследований Цикл
			ОсталосьНеПройдено = СтрокаПодсчета.НеПройдено;
			ОсталосьРазрушено = СтрокаПодсчета.Разрушено;
			Отбор = Новый Структура;
			Отбор.Вставить("Номенклатура", СтрокаПодсчета.Номенклатура);
			Отбор.Вставить("Характеристика", СтрокаПодсчета.Характеристика);
			Отбор.Вставить("Серия", СтрокаПодсчета.Серия);
