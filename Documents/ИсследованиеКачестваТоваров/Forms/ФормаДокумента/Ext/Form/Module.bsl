#Область ОписаниеПеременных

&НаКлиенте
Перем КэшированныеЗначения;

&НаКлиенте
Перем ТекущиеДанныеИдентификатор; //используется для передачи текущей строки в обработчик ожидания

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("АвтоТест") Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(Объект, ЭтотОбъект);
	
	ОбщегоНазначенияУТ.НастроитьПодключаемоеОборудование(ЭтотОбъект);
	
	Элементы.ОформитьАктКонтроляКачества.Доступность = ПравоДоступа("Добавление",
		Метаданные.Документы.АктКонтроляКачестваТоваров);
	
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ПриЧтенииСозданииНаСервере();
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.ЗаявкаНаКонтроль) Тогда
		Элементы.Основание.Заголовок = ОбщегоНазначения.ПредметСтрокой(Объект.ЗаявкаНаКонтроль);
	КонецЕсли;
	
	ДоступностьЭлементов = ПравоДоступа("Добавление", Метаданные.Документы.ИсследованиеКачестваТоваров);
	
	// Обработчик механизма "Назначения"
	Справочники.Назначения.ФормаДокументаПриСозданииНаСервере(ЭтотОбъект, "Объект.ПланИРезультатИсследования.Назначение");
	
	// Работа с буфером обмена
	УстановитьДоступностьКомандБуфераОбмена();
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	// СтандартныеПодсистемы.ВерсионированиеОбъектов
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ВерсионированиеОбъектов
	
	// СтандартныеПодсистемы.Свойства
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ИмяЭлементаДляРазмещения", "ГруппаДополнительныеРеквизиты");
	ДополнительныеПараметры.Вставить("ОтложеннаяИнициализация", Истина);
	УправлениеСвойствами.ПриСозданииНаСервере(ЭтотОбъект, ДополнительныеПараметры);
	// Конец СтандартныеПодсистемы.Свойства
	
	// ИнтеграцияС1СДокументооборотом
	ИнтеграцияС1СДокументооборотБазоваяФункциональность.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец ИнтеграцияС1СДокументооборотом
	
	// СтандартныеПодсистемы.РаботаСФайлами
	ПараметрыГиперссылки = РаботаСФайлами.ГиперссылкаФайлов();
	ПараметрыГиперссылки.Размещение = "КоманднаяПанель";
	РаботаСФайлами.ПриСозданииНаСервере(ЭтотОбъект, ПараметрыГиперссылки);
	// Конец СтандартныеПодсистемы.РаботаСФайлами
	
	СобытияФорм.ПриСозданииНаСервере(ЭтотОбъект, Отказ, СтандартнаяОбработка);
	
	ИнициализироватьКэш();
	
	НастроитьЗависимыеЭлементыФормы(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	// СтандартныеПодсистемы.РаботаСФайлами
	РаботаСФайламиКлиент.ПриОткрытии(ЭтотОбъект, Отказ);
	// Конец СтандартныеПодсистемы.РаботаСФайлами

	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствамиКлиент.ПослеЗагрузкиДополнительныхРеквизитов(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.Свойства 
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	ОповеститьОПроведенииДокумента(ПараметрыЗаписи);
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	Если ОбщегоНазначенияКлиент.ПодсистемаСуществует("СтандартныеПодсистемы.ПодключаемыеКоманды") Тогда
		МодульПодключаемыеКомандыКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("ПодключаемыеКомандыКлиент");
		МодульПодключаемыеКомандыКлиент.ПослеЗаписи(ЭтотОбъект, Объект, ПараметрыЗаписи);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствами.ПередЗаписьюНаСервере(ЭтотОбъект, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.Свойств
	
	// ИнтеграцияС1СДокументооборотом
	ИнтеграцияС1СДокументооборотБазоваяФункциональность.ПередЗаписьюНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	// Конец ИнтеграцияС1СДокументооборотом
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	ЗаполнитьПризнакАртикул = Новый Структура("Номенклатура", "Артикул");
	ЗаполнитьПризнакТипНоменклатуры = Новый Структура("Номенклатура", "ТипНоменклатуры");
	ЗаполнитьПризнакХарактеристикиИспользуются = Новый Структура("Номенклатура", "ХарактеристикиИспользуются");
	
	СтруктураДействий = Новый Структура();
	СтруктураДействий.Вставить("ЗаполнитьПризнакХарактеристикиИспользуются", ЗаполнитьПризнакХарактеристикиИспользуются);
	СтруктураДействий.Вставить("ЗаполнитьПризнакТипНоменклатуры", ЗаполнитьПризнакТипНоменклатуры);
	
	ПакетнаяОбработкаТабличнойЧастиСервер.ОбработатьТЧ(Объект.ИсследованияТоваров, СтруктураДействий);
	
	СтруктураДействий.Вставить("ЗаполнитьПризнакАртикул", ЗаполнитьПризнакАртикул);
	
	ПакетнаяОбработкаТабличнойЧастиСервер.ОбработатьТЧ(Объект.ПланИРезультатИсследования, СтруктураДействий);
	
	ОбновитьРезультатИсследования();
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствами.ОбработкаПроверкиЗаполнения(ЭтотОбъект, Отказ, ПроверяемыеРеквизиты);
	// Конец СтандартныеПодсистемы.Свойства

	ДокументОбъект = РеквизитФормыВЗначение("Объект");
	ДокументОбъект.ДополнительныеСвойства.Вставить("ОднаНоменклатура", Не ИсследоватьНесколькоТоваров);

	Если Не ДокументОбъект.ПроверитьЗаполнение() Тогда
		Отказ = Истина;
	КонецЕсли;
		
	ПроверяемыеРеквизиты.Очистить();
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	ПриЧтенииСозданииНаСервере();
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствами.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.Свойства
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	Если ИсточникВыбора.ИмяФормы = "Документ.ИсследованиеКачестваТоваров.Форма.ФормаПодбораТоваровИзЗаявки" Тогда
		
		ОбработкаВыбораПодборНаСервере(ВыбранноеЗначение);
		НастроитьЗависимыеЭлементыФормы(ЭтотОбъект, "ВидФормы");
		
	ИначеЕсли НоменклатураКлиент.ЭтоУказаниеСерий(ИсточникВыбора) Тогда
		
		НоменклатураКлиент.ОбработатьУказаниеСерии(
			ЭтотОбъект, ПараметрыУказанияСерий[ВыбранноеЗначение.ИмяТЧ], ВыбранноеЗначение);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	// ПодключаемоеОборудование
	Если ВводДоступен() И Источник = "ПодключаемоеОборудование" Тогда
		Если ИмяСобытия = "ScanData"
			И МенеджерОборудованияУТКлиент.ЕстьНеобработанноеСобытие() Тогда
			ОбработатьШтрихкоды(МенеджерОборудованияУТКлиент.ПреобразоватьДанныеСоСканераВМассив(Параметр));
		КонецЕсли;
	КонецЕсли;
	// Конец ПодключаемоеОборудование
	
	// Неизвестные штрихкоды
	Если ИмяСобытия = "НеизвестныеШтрихкоды"
		И Источник = "ПодключаемоеОборудование"
		И Параметр.ФормаВладелец = УникальныйИдентификатор Тогда
		
		КэшированныеЗначения.Штрихкоды.Очистить();
		ДанныеШтрихкодов = Новый Массив;
		Для Каждого ПолученныйШтрихкод Из Параметр.ШтрихкодыНоменклатуры Цикл
			ДанныеШтрихкодов.Добавить(ПолученныйШтрихкод);
		КонецЦикла;
		
		ОбработатьШтрихкоды(ДанныеШтрихкодов);
		
	КонецЕсли;
	
 	// Работа с буфером обмена
	Если ИмяСобытия = "КопированиеСтрокВБуферОбмена" Тогда
		УстановитьДоступностьКомандБуфераОбменаНаКлиенте();
	КонецЕсли;
	
	// СтандартныеПодсистемы.Свойства 
	Если УправлениеСвойствамиКлиент.ОбрабатыватьОповещения(ЭтотОбъект, ИмяСобытия, Параметр) Тогда
		ОбновитьЭлементыДополнительныхРеквизитов();
		УправлениеСвойствамиКлиент.ПослеЗагрузкиДополнительныхРеквизитов(ЭтотОбъект);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.Свойства
	
	// СтандартныеПодсистемы.РаботаСФайлами
	РаботаСФайламиКлиент.ОбработкаОповещения(ЭтотОбъект, ИмяСобытия);
	// Конец СтандартныеПодсистемы.РаботаСФайлами
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ОснованиеНажатие(Элемент)
	
	Если ЗначениеЗаполнено(Объект.ЗаявкаНаКонтроль) Тогда
		ПараметрыФормы = Новый Структура("Ключ", Объект.ЗаявкаНаКонтроль);
		ОткрытьФорму("Документ.ЗаявкаНаКонтрольКачестваТоваров.ФормаОбъекта", ПараметрыФормы);
	Иначе
		ОткрытьФорму("Документ.ЗаявкаНаКонтрольКачестваТоваров.ФормаВыбора", , ЭтотОбъект, , , ,
			Новый ОписаниеОповещения("ЗаполнитьЗаявкаНаКонтрольКачестваТоваровЗавершение", ЭтотОбъект));
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВидКонтроляПриИзменении(Элемент)
	
	Если ВидКонтроляДоИзменения = Объект.Контроль Тогда
		Возврат;
	КонецЕсли;
	
	Если Объект.Контроль = ПредопределенноеЗначение("Перечисление.КонтрольКачества.Выборочный")
		И Объект.СпособПроверкиЭкземпляров <> ПредопределенноеЗначение(
		"Перечисление.ВариантыПроверкиЭкземпляровИсследования.ПоЭкземплярно") Тогда
		
		Кнопки = Новый СписокЗначений;
		Кнопки.Добавить(КодВозвратаДиалога.Да, НСтр("ru = 'Продолжить';
													|en = 'Continue'"));
		Кнопки.Добавить(КодВозвратаДиалога.Отмена);

		ТекстВопроса = НСтр("ru = 'При изменении вида контроля введенные исследования будут очищены.';
							|en = 'When you change the control kind, the entered research will be cleared.'");

		ОписаниеОповещения = Новый ОписаниеОповещения("ВидКонтроляПриИзмененииЗавершение", ЭтотОбъект);
		
		ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, Кнопки);
		
	КонецЕсли;
	
	ВидКонтроляДоИзменения = Объект.Контроль;
	
	НастроитьЗависимыеЭлементыФормы(ЭтотОбъект, "Контроль");

КонецПроцедуры

&НаКлиенте
Процедура СпособПроверкиЭкземпляровПриИзменении(Элемент)
	
	Если МетодИсследованияДоИзменения = Объект.СпособПроверкиЭкземпляров Тогда
		Возврат;
	КонецЕсли;

	Кнопки = Новый СписокЗначений;
	Кнопки.Добавить(КодВозвратаДиалога.Да, НСтр("ru = 'Продолжить?';
												|en = 'Continue?'"));
	Кнопки.Добавить(КодВозвратаДиалога.Отмена);

	ТекстВопроса = НСтр("ru = 'При изменении способа проверки образцов введенные исследования будут очищены.';
						|en = 'When you change the method to check samples, the entered research will be cleared.'");

	ОписаниеОповещения = Новый ОписаниеОповещения("СпособПроверкиЭкземпляровПриИзмененииЗавершение", ЭтотОбъект);

	ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, Кнопки);
	
КонецПроцедуры

&НаКлиенте
Процедура КартаИсследованияТоваровПриИзменении(Элемент)
	
	Если КартаИсследованияДоИзменения = Объект.КартаИсследованияТоваров Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(КартаИсследованияДоИзменения) Тогда
		Кнопки = Новый СписокЗначений;
		Кнопки.Добавить(КодВозвратаДиалога.Да, НСтр("ru = 'Продолжить';
													|en = 'Continue'"));
		Кнопки.Добавить(КодВозвратаДиалога.Отмена);

		ТекстВопроса = НСтр("ru = 'При изменении карты исследования товаров введенные исследования будут очищены.';
							|en = 'When you change the goods research sheet, the entered research will be cleared.'");

		ОписаниеОповещения = Новый ОписаниеОповещения("КартаИсследованияТоваровПриИзмененииЗавершение", ЭтотОбъект);
		ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, Кнопки);
	Иначе
		КартаИсследованияДоИзменения = Объект.КартаИсследованияТоваров;
		ЗаполнитьСлужебныеРеквизитыПриИзмененииКартыИсследования();
		НастроитьЗависимыеЭлементыФормы(ЭтотОбъект, "КартаИсследованияТоваров");
		Модифицированность = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗавершенПриИзменении(Элемент)
	
	ОчиститьСообщения();
	Отказ = Ложь;
	Ошибки = Новый Массив;

	Если Объект.ПометкаУдаления Тогда
		ТекстСообщения = НСтр("ru = 'Нельзя изменить статус помеченного на удаление исследования товаров.';
								|en = 'Cannot change the status of goods research marked for deletion.'");
		СтруктураОшибки = Новый Структура;
		СтруктураОшибки.Вставить("ТекстСообщения", ТекстСообщения);
		СтруктураОшибки.Вставить("Поле","");
		Ошибки.Добавить(СтруктураОшибки);
		Отказ = Истина;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.ЗаявкаНаКонтроль) Тогда
		ТекстСообщения = НСтр("ru = 'Не заполнена ""Заявка на контроль качества"".';
								|en = 'The ""Request for quality control"" is not filled in.'");
		СтруктураОшибки = Новый Структура;
		СтруктураОшибки.Вставить("ТекстСообщения", ТекстСообщения);
		СтруктураОшибки.Вставить("Поле","");
		Ошибки.Добавить(СтруктураОшибки);
		Отказ = Истина;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.КартаИсследованияТоваров) Тогда
		ТекстСообщения = НСтр("ru = 'Не заполнена ""Карта исследования товаров"".';
								|en = 'The ""Goods research sheet"" is not filled in.'");
		СтруктураОшибки = Новый Структура;
		СтруктураОшибки.Вставить("ТекстСообщения", ТекстСообщения);
		СтруктураОшибки.Вставить("Поле","Объект.КартаИсследованияТоваров");
		Ошибки.Добавить(СтруктураОшибки);
		Отказ = Истина;
	КонецЕсли;
	
	Если Объект.ПланИРезультатИсследования.Количество() = 0 Тогда
		Если ИсследоватьНесколькоТоваров Тогда
			ТекстСообщения = НСтр("ru = 'Не заполнен ""План и результат исследования"".';
									|en = 'The ""Plan and research result"" is not filled in.'");
			СтруктураОшибки = Новый Структура;
			СтруктураОшибки.Вставить("ТекстСообщения", ТекстСообщения);
			СтруктураОшибки.Вставить("Поле","Объект.ПланИРезультатИсследования");
		Иначе
			ТекстСообщения = НСтр("ru = 'Не заполнен ""План исследования"".';
									|en = 'The ""Research plan"" is not filled in.'");
			СтруктураОшибки = Новый Структура;
			СтруктураОшибки.Вставить("ТекстСообщения", ТекстСообщения);
			СтруктураОшибки.Вставить("Поле","Объект.ПланИРезультатИсследования");
		КонецЕсли;
		Ошибки.Добавить(СтруктураОшибки);
		Отказ = Истина;
	КонецЕсли;
	
	Если Не Отказ Тогда
		Ошибки = ПроверитьВыполнениеПланаИсследования(Отказ);
	КонецЕсли;
	
	Если Отказ Тогда
		Для Каждого Сообщение Из Ошибки Цикл
			Если ЗначениеЗаполнено(Сообщение.Поле) Тогда
				ОбщегоНазначенияКлиент.СообщитьПользователю(Сообщение.ТекстСообщения,,Сообщение.Поле,,Отказ);
			Иначе
				ОбщегоНазначенияКлиент.СообщитьПользователю(Сообщение.ТекстСообщения,,,,Отказ);
			КонецЕсли;
		КонецЦикла;
		Объект.Завершено = Ложь;
		Возврат;
	КонецЕсли;
	
	НастроитьЗависимыеЭлементыФормы(ЭтотОбъект, "Статус");
	
КонецПроцедуры

&НаКлиенте
Процедура ДекорацияДобавитьЭкземплярНажатие(Элемент)
	
	ШаблонОбразца = Нстр("ru = 'Образец №:%1';
						|en = 'Template No.%1'");
	
	Если Не ИсследоватьНесколькоТоваров Тогда
		ТекущиеДанные = Элементы.ПланИРезультатИсследования.ТекущиеДанные;
	Иначе
		Если НоменклатураОбразца = "ВсяНоменклатура" Тогда
			ТекущиеДанные = Элементы.ПланИРезультатИсследования.ТекущиеДанные;
		Иначе
			Отбор = Новый Структура;
			Отбор.Вставить("ИдентификаторСтроки", НоменклатураОбразца);
			НайденныеСтроки = Объект.ПланИРезультатИсследования.НайтиСтроки(Отбор);
			Если НайденныеСтроки.Количество() > 0 Тогда
				ТекущиеДанные = НайденныеСтроки[0];
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	ХарактеристикиИспользуются = Истина;
	Если ТекущиеДанные <> Неопределено Тогда
		ПоследняяДобавленнаяНоменклатура = ТекущиеДанные.Номенклатура;
		ПоследняяДобавленнаяХарактеристика = ТекущиеДанные.Характеристика;
		ПоследняяДобавленнаяСерия = ТекущиеДанные.Серия;
		ХарактеристикиИспользуются = ТекущиеДанные.ХарактеристикиИспользуются;
	КонецЕсли;
	
	КоличествоОбразцов = 1;
	
	МассивРазличныхОбразцов = Новый Массив();
	Для Каждого СтрокаИсследований Из Объект.ИсследованияТоваров Цикл
		МассивРазличныхОбразцов.Добавить(СтрокаИсследований.ИдентификаторЭкземпляра);
	КонецЦикла;
	МассивРазличныхОбразцов = ОбщегоНазначенияКлиентСервер.СвернутьМассив(МассивРазличныхОбразцов);
	КоличествоОбразцов = МассивРазличныхОбразцов.Количество()+1;
	
	НомерТекущегоОбразца =  СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонОбразца, КоличествоОбразцов);
	
	ПараметрыФормы = Новый Структура;
		
	ПараметрыФормы.Вставить("Номенклатура", ПоследняяДобавленнаяНоменклатура);
	ПараметрыФормы.Вставить("Характеристика", ПоследняяДобавленнаяХарактеристика);
	ПараметрыФормы.Вставить("Образец", НомерТекущегоОбразца);
	ПараметрыФормы.Вставить("ХарактеристикиИспользуются", ХарактеристикиИспользуются);
	ПараметрыФормы.Вставить("СписокВыбораНоменклатура", ИспользуемаяНоменклатураПланИРезультатИсследования());
	ПараметрыФормы.Вставить("СписокВыбораХарактеристика", ИспользуемыеХарактеристикиНоменклатурыПланИРезультатИсследования());
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ОткрытьФормуДобавлениеОбразцаЗавершение",
		ЭтотОбъект);
	
	ОткрытьФорму("Документ.ИсследованиеКачестваТоваров.Форма.ФормаДобавлениеОбразца", ПараметрыФормы, ЭтотОбъект,,,, ОписаниеОповещения);
			
КонецПроцедуры

&НаКлиенте
Процедура ДекорацияВыбратьЭкземплярНажатие(Элемент)

	Образцы = ОбразцыИсследованияТоваров();
	
	ПараметрыФормы = Новый Структура;
		
	ПараметрыФормы.Вставить("Образцы", Образцы);
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ОткрытьФормуВыборОбразцаЗавершение",
		ЭтотОбъект);
	
	ОткрытьФорму("Документ.ИсследованиеКачестваТоваров.Форма.ФормаВыборОбразца", ПараметрыФормы, ЭтотОбъект,,,, ОписаниеОповещения);
	
КонецПроцедуры

&НаКлиенте
Процедура ДекорацияВсеЭкземплярыНажатие(Элемент)
	
	ПоказыватьВсеЭкземпляры = Истина;
	
	Если Не ИсследоватьНесколькоТоваров Тогда
		Элементы.ИсследованияТоваров.ОтборСтрок = Неопределено;
		Элементы.ИсследованияТоваров.Обновить();
	Иначе
		Если НоменклатураОбразца = "ВсяНоменклатура" Тогда
			Элементы.ИсследованияТоваров.ОтборСтрок = Неопределено;
			Элементы.ИсследованияТоваров.Обновить();
		Иначе
			Отбор = Новый Структура;
			Отбор.Вставить("ИдентификаторСтроки", НоменклатураОбразца);
			НайденныеСтроки = Объект.ПланИРезультатИсследования.НайтиСтроки(Отбор);
			Если НайденныеСтроки.Количество() > 0 Тогда

				Отбор = Новый Структура;
				Отбор.Вставить("Номенклатура", НайденныеСтроки[0].Номенклатура);
				Отбор.Вставить("Характеристика", НайденныеСтроки[0].Характеристика);
				Если ЗначениеЗаполнено(НайденныеСтроки[0].Серия) Тогда
					Отбор.Вставить("Серия", НайденныеСтроки[0].Серия);
				КонецЕсли;
				Элементы.ИсследованияТоваров.ОтборСтрок = Новый ФиксированнаяСтруктура(Отбор);
				Элементы.ИсследованияТоваров.Обновить();
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	НастроитьЗависимыеЭлементыФормы(ЭтотОбъект, "Отбор");
	
КонецПроцедуры

&НаКлиенте
Процедура ПланИРезультатИсследованияНоменклатура1ПриИзменении(Элемент)
	
	СтрокаТаблицы = Элементы.ПланИРезультатИсследования.ТекущиеДанные;
	ЗаполнитьПризнакТипНоменклатуры = Новый Структура("Номенклатура", "ТипНоменклатуры");
	ЗаполнитьПризнакХарактеристикиИспользуются = Новый Структура("Номенклатура", "ХарактеристикиИспользуются");
	ПроверитьСериюРассчитатьСтатус = Новый Структура("Склад,ПараметрыУказанияСерий",
		Объект.Склад, ПараметрыУказанияСерий["ПланИРезультатИсследования"]);
	НоменклатураПриИзмененииПереопределяемый = Новый Структура("ИмяФормы, ИмяТабличнойЧасти",
		ИмяФормы, "ПланИРезультатИсследования");
		
	ЗаполнитьПризнакАртикул = Новый Структура("Номенклатура", "Артикул");

	СтруктураДействий = Новый Структура();
	СтруктураДействий.Вставить("ЗаполнитьПризнакАртикул", ЗаполнитьПризнакАртикул);
	СтруктураДействий.Вставить("ЗаполнитьПризнакТипНоменклатуры", ЗаполнитьПризнакТипНоменклатуры);
	СтруктураДействий.Вставить("ЗаполнитьПризнакХарактеристикиИспользуются", ЗаполнитьПризнакХарактеристикиИспользуются);
	СтруктураДействий.Вставить("НоменклатураПриИзмененииПереопределяемый", НоменклатураПриИзмененииПереопределяемый);
	СтруктураДействий.Вставить("ПроверитьХарактеристикуПоВладельцу", СтрокаТаблицы.Характеристика);
	СтруктураДействий.Вставить("ПроверитьСериюРассчитатьСтатус", ПроверитьСериюРассчитатьСтатус);
	СтруктураДействий.Вставить("ПроверитьЗаполнитьУпаковкуПоВладельцу", СтрокаТаблицы.Упаковка);
	
	ПакетнаяОбработкаТабличнойЧастиКлиент.ОбработатьСтрокуТЧ(СтрокаТаблицы, СтруктураДействий, КэшированныеЗначения);
	
	ОбновитьИнформациюПоИспользованиюСерийХарактеристик();
	
КонецПроцедуры

&НаКлиенте
Процедура ГруппаСтраницыПриСменеСтраницы(Элемент, ТекущаяСтраница)

	// СтандартныеПодсистемы.Свойства
	Если ТекущаяСтраница.Имя = "СтраницаДополнительно"
		И Не ЭтотОбъект.ПараметрыСвойств.ВыполненаОтложеннаяИнициализация Тогда
		
		СвойстваВыполнитьОтложеннуюИнициализацию();
		УправлениеСвойствамиКлиент.ПослеЗагрузкиДополнительныхРеквизитов(ЭтотОбъект);
		
	КонецЕсли;
	// Конец СтандартныеПодсистемы.Свойства
	
	Если ТекущаяСтраница.Имя = "СтраницаПротоколИспытания" Тогда

		НастроитьЗависимыеЭлементыФормы(ЭтотОбъект, "НоменклатураОбразца");
		Если ИсследоватьНесколькоТоваров Тогда
			Элементы.НоменклатураОбразца.СписокВыбора.Очистить();
			СписокНоменклатуры = ИспользуемаяНоменклатураХарактеристикаСерияПланИРезультатИсследования();
			
			Элементы.НоменклатураОбразца.СписокВыбора.Добавить("ВсяНоменклатура", НСтр("ru = 'Вся номенклатура';
																						|en = 'All products'"));
			Для Каждого ЭлементМассива Из СписокНоменклатуры Цикл
				Элементы.НоменклатураОбразца.СписокВыбора.Добавить(ЭлементМассива.ИдентификаторСтроки,
					НоменклатураКлиентСервер.ПредставлениеНоменклатуры(ЭлементМассива.Номенклатура,
					ЭлементМассива.Характеристика, , ЭлементМассива.Серия, ));
			КонецЦикла;
			
			Если Не ЗначениеЗаполнено(НоменклатураОбразца) Тогда
				НоменклатураОбразца = "ВсяНоменклатура";
			КонецЕсли;
			
			ОбновитьОтображениеДанных(Элементы.НоменклатураОбразца);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПланИРезультатИсследованияУпаковкаПриИзменении(Элемент)
	
	СтрокаТаблицы = Элементы.ПланИРезультатИсследования.ТекущиеДанные;
	СтруктураДействий = Новый Структура();
	СтруктураДействий.Вставить("ПересчитатьКоличествоУпаковок");
	
	ПакетнаяОбработкаТабличнойЧастиКлиент.ОбработатьСтрокуТЧ(СтрокаТаблицы, СтруктураДействий, КэшированныеЗначения);
	
КонецПроцедуры

&НаКлиенте
Процедура СтатусУказанияСерийНажатие(Элемент, СтандартнаяОбработка)
	
	ОткрытьПодборСерий();
	
КонецПроцедуры

&НаКлиенте
Процедура ПланИРезультатИсследованияСерия1ПриИзменении(Элемент)
	
	ВыбранноеЗначение = НоменклатураКлиентСервер.ВыбраннаяСерия();
	
	ВыбранноеЗначение.Значение = Элементы.ПланИРезультатИсследования.ТекущиеДанные.Серия;
	ВыбранноеЗначение.ИдентификаторТекущейСтроки = Элементы.ПланИРезультатИсследования.ТекущиеДанные.ПолучитьИдентификатор();
	
	НоменклатураКлиент.ОбработатьУказаниеСерии(ЭтотОбъект, ПараметрыУказанияСерий["ПланИРезультатИсследования"], ВыбранноеЗначение);

КонецПроцедуры

&НаКлиенте
Процедура ПланИРезультатИсследованияСерия1НачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ОткрытьПодборСерий(Элемент.ТекстРедактирования);
	
КонецПроцедуры

&НаКлиенте
Процедура СкладПриИзменении(Элемент)
	
	СкладПриИзмененииНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура НоменклатураОбразцаПриИзменении(Элемент)
	
	Если НоменклатураОбразца = "ВсяНоменклатура" Тогда
		Элементы.ИсследованияТоваров.ОтборСтрок = Неопределено;
		Элементы.ИсследованияТоваров.Обновить();
	Иначе
		Отбор = Новый Структура;
		Отбор.Вставить("ИдентификаторСтроки", НоменклатураОбразца);
		НайденныеСтроки = Объект.ПланИРезультатИсследования.НайтиСтроки(Отбор);
		Если НайденныеСтроки.Количество() > 0 Тогда
			Отбор = Новый Структура;
			Отбор.Вставить("Номенклатура", НайденныеСтроки[0].Номенклатура);
			Отбор.Вставить("Характеристика", НайденныеСтроки[0].Характеристика);
			Если ЗначениеЗаполнено(НайденныеСтроки[0].Серия) Тогда
				Отбор.Вставить("Серия", НайденныеСтроки[0].Серия);
			КонецЕсли;
			Элементы.ИсследованияТоваров.ОтборСтрок = Новый ФиксированнаяСтруктура(Отбор);
			Элементы.ИсследованияТоваров.Обновить();
		КонецЕсли;
	КонецЕсли;
	
	ПоказыватьВсеЭкземпляры = Истина;
	НастроитьЗависимыеЭлементыФормы(ЭтотОбъект, "Отбор");

КонецПроцедуры

&НаКлиенте
Процедура ОднаНоменклатураПриИзменении(Элемент)
	ОбновитьИнформациюПоИспользованиюСерийХарактеристик();
	НастроитьЗависимыеЭлементыФормы(ЭтотОбъект, "ВидФормы");
КонецПроцедуры

#КонецОбласти

