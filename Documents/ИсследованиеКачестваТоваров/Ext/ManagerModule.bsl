#Область СтандартныеПодсистемы

// СтандартныеПодсистемы.Печать

// Переопределяет настройки печати для объекта.
//
// Параметры:
//  Настройки - см. УправлениеПечатью.НастройкиПечатиОбъекта.
//
Процедура ПриОпределенииНастроекПечати(Настройки) Экспорт
	
	Настройки.ПриДобавленииКомандПечати = Истина;
	
КонецПроцедуры

// Конец СтандартныеПодсистемы.Печать

// Определяет настройки объекта для подсистемы ВерсионированиеОбъектов.
//
// Параметры:
//  Настройки - Структура - настройки подсистемы.
Процедура ПриОпределенииНастроекВерсионированияОбъектов(Настройки) Экспорт
	
	Возврат;
	
КонецПроцедуры

// Определяет список команд отчетов.
//
// Параметры:
//   КомандыОтчетов - см. ВариантыОтчетовПереопределяемый.ПередДобавлениемКомандОтчетов.КомандыОтчетов
//   Параметры - см. ВариантыОтчетовПереопределяемый.ПередДобавлениемКомандОтчетов.Параметры
//
Процедура ДобавитьКомандыОтчетов(КомандыОтчетов, Параметры) Экспорт
	
КонецПроцедуры

// Заполняет список команд печати.
//
// Параметры:
//   КомандыПечати - см. УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	
	// Задание на отбор товара
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.Идентификатор = "ЗаданиеНаОтбор";
	КомандаПечати.Представление = НСтр("ru = 'Задание на отбор';
										|en = 'Picking job'");
	КомандаПечати.ПроверкаПроведенияПередПечатью = Истина;

КонецПроцедуры

// Формирует печатные формы.
//
// Параметры:
//  МассивОбъектов - см. УправлениеПечатьюПереопределяемый.ПриПечати.МассивОбъектов
//  ПараметрыПечати - см. УправлениеПечатьюПереопределяемый.ПриПечати.ПараметрыПечати
//  КоллекцияПечатныхФорм - см. УправлениеПечатьюПереопределяемый.ПриПечати.КоллекцияПечатныхФорм
//  ОбъектыПечати - см. УправлениеПечатьюПереопределяемый.ПриПечати.ОбъектыПечати
//  ПараметрыВывода - см. УправлениеПечатьюПереопределяемый.ПриПечати.ПараметрыВывода
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ЗаданиеНаОтбор") Тогда
		
		ТабличныйДокумент = СформироватьПечатнуюФормуЗаданиеНаОтбор(
			МассивОбъектов, ОбъектыПечати, ПараметрыПечати);
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
			КоллекцияПечатныхФорм,
			"ЗаданиеНаОтбор",
			НСтр("ru = 'Задание на отбор';
				|en = 'Picking job'"),
			ТабличныйДокумент);
		
	КонецЕсли;
	
КонецПроцедуры

// Определяет список команд создания на основании.
//
// Параметры:
//  КомандыСозданияНаОсновании - см. СозданиеНаОснованииПереопределяемый.ПередДобавлениемКомандСозданияНаОсновании.КомандыСозданияНаОсновании
//  Параметры - см. СозданиеНаОснованииПереопределяемый.ПередДобавлениемКомандСозданияНаОсновании.Параметры
//
Процедура ДобавитьКомандыСозданияНаОсновании(КомандыСозданияНаОсновании, Параметры) Экспорт
	
	Документы.АктКонтроляКачестваТоваров.ДобавитьКомандуСоздатьНаОсновании(КомандыСозданияНаОсновании);
	
КонецПроцедуры

#КонецОбласти

#Область ВстраиваемыеМеханизмы

// Имена реквизитов, от значений которых зависят параметры указания серий
//
//	Возвращаемое значение:
//		Строка - имена реквизитов, перечисленные через запятую.
//
Функция ИменаРеквизитовДляЗаполненияПараметровУказанияСерий() Экспорт
	
	ИменаРеквизитов = "Дата";
	Возврат ИменаРеквизитов;
	
КонецФункции

// Возвращает параметры указания серий для товаров, указанных в документе
//
// Параметры:
//  Объект - Структура - структура значений реквизитов объекта, необходимых для заполнения параметров указания серий.
//
// Возвращаемое значение:
//  Структура - с ключами:
//   *  ПланИРезультатИсследования - см. НоменклатураКлиентСервер.ПараметрыУказанияСерий
//   *  ИсследованияТоваров - см. НоменклатураКлиентСервер.ПараметрыУказанияСерий
//
Функция ПараметрыУказанияСерий(Объект) Экспорт
	
	ПараметрыУказанияСерий = Новый Структура;
	
	// ПланИРезультатИсследования
	ПараметрыУказанияСерийТЧ = НоменклатураКлиентСервер.ПараметрыУказанияСерий();
	
	ПараметрыУказанияСерийТЧ.ПолноеИмяОбъекта = "Документ.ИсследованиеКачестваТоваров";
	ПараметрыУказанияСерийТЧ.ИмяТЧСерии = "ПланИРезультатИсследования";
	ПараметрыУказанияСерийТЧ.ИмяТЧТовары = "ПланИРезультатИсследования";
	ПараметрыУказанияСерийТЧ.СкладскиеОперации.Добавить(Перечисления.СкладскиеОперации.ПустаяСсылка());
	ПараметрыУказанияСерийТЧ.УчитыватьСебестоимостьПоСериям = ПолучитьФункциональнуюОпцию("УчитыватьСебестоимостьПоСериямСклад");
	ПараметрыУказанияСерийТЧ.ИспользоватьСерииНоменклатуры  = ПолучитьФункциональнуюОпцию("ИспользоватьСерииНоменклатурыСклад");
	ПараметрыУказанияСерийТЧ.ИменаПолейДополнительные.Добавить("Назначение");
	ПараметрыУказанияСерийТЧ.ЭтоНакладная = Ложь;
	
	ПараметрыУказанияСерий.Вставить("ПланИРезультатИсследования", ПараметрыУказанияСерийТЧ);
	
	// ИсследованияТоваров
	ПараметрыУказанияСерийТЧ = НоменклатураКлиентСервер.ПараметрыУказанияСерий();
	
	ПараметрыУказанияСерийТЧ.ПолноеИмяОбъекта = "Документ.ИсследованиеКачестваТоваров";
	ПараметрыУказанияСерийТЧ.ИмяТЧСерии = "ИсследованияТоваров";
	ПараметрыУказанияСерийТЧ.ИмяТЧТовары = "ИсследованияТоваров";
	ПараметрыУказанияСерийТЧ.СкладскиеОперации.Добавить(Перечисления.СкладскиеОперации.ПустаяСсылка());
	ПараметрыУказанияСерийТЧ.УчитыватьСебестоимостьПоСериям = ПолучитьФункциональнуюОпцию("УчитыватьСебестоимостьПоСериямСклад");
	ПараметрыУказанияСерийТЧ.ИспользоватьСерииНоменклатуры  = ПолучитьФункциональнуюОпцию("ИспользоватьСерииНоменклатурыСклад");
	ПараметрыУказанияСерийТЧ.ЭтоНакладная = Ложь;
	
	ПараметрыУказанияСерий.Вставить("ИсследованияТоваров", ПараметрыУказанияСерийТЧ);
	
	Возврат ПараметрыУказанияСерий;
	
КонецФункции

// Процедура заполняет статусы указания серий в строках ТЧ
//
// Параметры:
//  ПараметрыУказанияСерий - см. НоменклатураКлиентСервер.ПараметрыУказанияСерий
//
// Возвращаемое значение:
//	Строка - Текст запроса заполнения статусов.
Функция ТекстЗапросаЗаполненияСтатусовУказанияСерий(ПараметрыУказанияСерий) Экспорт
	
	ТекстЗапроса = "";
	Если ПараметрыУказанияСерий.ИмяТЧТовары = "ПланИРезультатИсследования" Тогда
		
		ТекстЗапроса = ТекстЗапросаЗаполненияСтатусовУказанияСерийПлан(ПараметрыУказанияСерий);
		
	ИначеЕсли ПараметрыУказанияСерий.ИмяТЧТовары = "ИсследованияТоваров" Тогда
		
		ТекстЗапроса = ТекстЗапросаЗаполненияСтатусовУказанияСерийИсследования(ПараметрыУказанияСерий);
		
	КонецЕсли;
	
	Возврат ТекстЗапроса;
	
КонецФункции

// Инициализирует параметры, обслуживающие выбор назначений в формах документа.
//
//  Возвращаемое значение:
//  См. Справочники.Назначения.МакетФормыВыбораНазначений
//
Функция МакетФормыВыбораНазначений() Экспорт
	
	МакетФормы = Справочники.Назначения.МакетФормыВыбораНазначений();
	
	Справочники.Назначения.ДобавитьШаблонНазначений(МакетФормы);
	
	// Остатки товаров на складе.
	ОписаниеКолонок = Справочники.Назначения.ДобавитьОписаниеКолонок(
		МакетФормы,
		"ОбеспечениеЗаказов",
		Истина, "Объект.Товары.Назначение");
	
	ОписаниеКолонок.Колонки.НайтиПоЗначению("ВНаличии").Пометка = Истина;
	ОписаниеКолонок.КолонкиПоУмолчанию.Добавить("ВНаличии");
	
	ОписаниеКолонок.ПутиКДанным.Номенклатура = "Объект.ПланИРезультатИсследования.Номенклатура";
	ОписаниеКолонок.ПутиКДанным.Характеристика = "Объект.ПланИРезультатИсследования.Характеристика";
	ОписаниеКолонок.ПутиКДанным.Склад = "Объект.Склад";
	ОписаниеКолонок.ПутиКДанным.КонтролируемаяПартия = "Объект.ПланИРезультатИсследования.КонтролируемаяПартия";
	
	Возврат МакетФормы;
	
КонецФункции

#КонецОбласти

#Область СозданиеДокументов

// Возвращает структуру с результатами формирования документа "ИсследованиеКачестваТоваров".
//
// Возвращаемое значение:
//   Структура из Массив, ТаблицаЗначений - содержит результаты формирования, включая таблицу значений с картами исследования товаров, заявками на контроль и документами исследования качества товаров,
//               а также массив созданных объектов и массив сообщений.
//
Функция РезультатФормирования() Экспорт
	
	РезультатФормирования = Новый ТаблицаЗначений;
	РезультатФормирования.Колонки.Добавить("КартаИсследованияТоваров", Новый ОписаниеТипов("СправочникСсылка.КартыИсследованияТоваров"));
	РезультатФормирования.Колонки.Добавить("ЗаявкаНаКонтроль", Новый ОписаниеТипов("ДокументСсылка.ЗаявкаНаКонтрольКачестваТоваров"));
	РезультатФормирования.Колонки.Добавить("ИсследованиеКачестваТоваров", Новый ОписаниеТипов("ДокументСсылка.ИсследованиеКачестваТоваров"));
	
	СозданныеОбъекты = Новый Массив;
	
	Сообщения = Новый Массив;
	
	Результат = Новый Структура;
	Результат.Вставить("РезультатФормирования", РезультатФормирования);
	Результат.Вставить("СозданныеОбъекты", СозданныеОбъекты);
	Результат.Вставить("Сообщения", Сообщения);
	
	Возврат Результат;
	
КонецФункции

// Параметры:
//  Параметры - Структура - из:
//  *Товары - ТаблицаЗначений
//  *ЗаявкаНаКонтроль - ДокументСсылка.ЗаявкаНаКонтрольКачестваТоваров
//  *НесколькоНоменклатурВИсследовании - Булево
//  АдресХранилища - Строка
Процедура СоздатьДокументыОтложенно(Параметры, АдресХранилища) Экспорт
	
	ОписаниеЗамера = ОценкаПроизводительности.НачатьЗамерДлительнойОперации("Документ.ИсследованиеКачестваТоваров.МодульМенеджера.СоздатьДокументыОтложенно");
	
	КоличествоДанных = СоздатьДокументыОтложенноВнутриЗамераВремени(Параметры, АдресХранилища);
	
	ОценкаПроизводительности.ЗакончитьЗамерДлительнойОперации(ОписаниеЗамера, КоличествоДанных);
	
КонецПроцедуры

// Параметры:
//  Параметры  - Структура - из:
//  *Ссылки - Массив из ДокументСсылка.ИсследованиеКачестваТоваров
//  АдресХранилища  - Строка
Процедура УдалитьОбъектыОтложенно(Параметры, АдресХранилища) Экспорт
	
	ОписаниеЗамера = ОценкаПроизводительности.НачатьЗамерДлительнойОперации("Документ.ИсследованиеКачестваТоваров.МодульМенеджера.УдалитьОбъектыОтложенно");
	
	УдалитьОбъектыОтложенноВнутриЗамераВремени(Параметры, АдресХранилища);
	
	ОценкаПроизводительности.ЗакончитьЗамерДлительнойОперации(ОписаниеЗамера, Параметры.Ссылки.Количество());
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область Серии

Функция ТекстЗапросаЗаполненияСтатусовУказанияСерийПлан(ПараметрыУказанияСерий)

	ТекстЗапроса =
	"ВЫБРАТЬ
	|	Товары.НомерСтроки КАК НомерСтроки,
	|	Товары.Номенклатура КАК Номенклатура,
	|	Товары.Серия КАК Серия,
	|	Товары.СтатусУказанияСерий КАК СтатусУказанияСерий
	|ПОМЕСТИТЬ Товары
	|ИЗ
	|	&Товары КАК Товары
	|ИНДЕКСИРОВАТЬ ПО
	|	Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Товары.НомерСтроки КАК НомерСтроки,
	|	Товары.Номенклатура КАК Номенклатура,
	|	ВЫРАЗИТЬ(Товары.Номенклатура КАК Справочник.Номенклатура).ВидНоменклатуры КАК ВидНоменклатуры,
	|	Товары.Серия КАК Серия,
	|	Товары.СтатусУказанияСерий КАК СтатусУказанияСерий
	|ПОМЕСТИТЬ ТоварыДляЗапроса
	|ИЗ
	|	Товары КАК Товары
	|ИНДЕКСИРОВАТЬ ПО
	|	ВидНоменклатуры
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Товары.НомерСтроки КАК НомерСтроки,
	|	Товары.СтатусУказанияСерий КАК СтарыйСтатусУказанияСерий,
	|	ВЫБОР
	|		КОГДА ПолитикиУчетаСерий.ПолитикаУчетаСерий ЕСТЬ NULL 
	|			ТОГДА 0
	|		ИНАЧЕ
	|			ВЫБОР
	|				КОГДА ПолитикиУчетаСерий.ПолитикаУчетаСерий.УказыватьПриПланированииОтгрузки
	|					ТОГДА ВЫБОР
	|							КОГДА ПолитикиУчетаСерий.ПолитикаУчетаСерий.УчитыватьСебестоимостьПоСериям
	|								ТОГДА ВЫБОР
	|										КОГДА Товары.Серия = ЗНАЧЕНИЕ(Справочник.СерииНоменклатуры.ПустаяСсылка)
	|											ТОГДА 13
	|										ИНАЧЕ 14
	|									КОНЕЦ
	|							ИНАЧЕ ВЫБОР
	|									КОГДА Товары.Серия = ЗНАЧЕНИЕ(Справочник.СерииНоменклатуры.ПустаяСсылка)
	|										ТОГДА 9
	|									ИНАЧЕ 10
	|								КОНЕЦ
	|						КОНЕЦ
	|				КОГДА ПолитикиУчетаСерий.ПолитикаУчетаСерий.УказыватьПриПланированииОтбора
	|					ТОГДА ВЫБОР
	|							КОГДА Товары.Серия = ЗНАЧЕНИЕ(Справочник.СерииНоменклатуры.ПустаяСсылка)
	|								ТОГДА 7
	|							ИНАЧЕ 8
	|						КОНЕЦ
	|				КОГДА ПолитикиУчетаСерий.ПолитикаУчетаСерий.УказыватьПоФактуОтбора
	|						И ПолитикиУчетаСерий.ПолитикаУчетаСерий.УчитыватьОстаткиСерий
	|					ТОГДА ВЫБОР
	|							КОГДА Товары.Серия = ЗНАЧЕНИЕ(Справочник.СерииНоменклатуры.ПустаяСсылка)
	|								ТОГДА 3
	|							ИНАЧЕ 4
	|						КОНЕЦ
	|				ИНАЧЕ 0
	|			КОНЕЦ
	|	КОНЕЦ КАК СтатусУказанияСерий
	|ПОМЕСТИТЬ ТаблицаСтатусов
	|ИЗ
	|	ТоварыДляЗапроса КАК Товары
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВидыНоменклатуры.ПолитикиУчетаСерий КАК ПолитикиУчетаСерий
	|		ПО Товары.ВидНоменклатуры = ПолитикиУчетаСерий.Ссылка
	|			И ПолитикиУчетаСерий.Склад = &Склад
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаСтатусов.НомерСтроки КАК НомерСтроки,
	|	ТаблицаСтатусов.СтатусУказанияСерий КАК СтатусУказанияСерий
	|ИЗ
	|	ТаблицаСтатусов КАК ТаблицаСтатусов
	|ГДЕ
	|	ТаблицаСтатусов.СтарыйСтатусУказанияСерий <> ТаблицаСтатусов.СтатусУказанияСерий
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки";

	Возврат ТекстЗапроса;

КонецФункции

Функция ТекстЗапросаЗаполненияСтатусовУказанияСерийИсследования(ПараметрыУказанияСерий)
	
	ТекстЗапроса =
		"ВЫБРАТЬ
		|	Товары.НомерСтроки КАК НомерСтроки,
		|	Товары.Номенклатура КАК Номенклатура,
		|	Товары.Серия КАК Серия,
		|	Товары.СтатусУказанияСерий КАК СтатусУказанияСерий
		|ПОМЕСТИТЬ Товары
		|ИЗ
		|	&Товары КАК Товары
		|ИНДЕКСИРОВАТЬ ПО
		|	Номенклатура
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Товары.НомерСтроки КАК НомерСтроки,
		|	Товары.Номенклатура КАК Номенклатура,
		|	ВЫРАЗИТЬ(Товары.Номенклатура КАК Справочник.Номенклатура).ВидНоменклатуры КАК ВидНоменклатуры,
		|	Товары.Серия КАК Серия,
		|	Товары.СтатусУказанияСерий КАК СтатусУказанияСерий
		|ПОМЕСТИТЬ ТоварыДляЗапроса
		|ИЗ
		|	Товары КАК Товары
		|ИНДЕКСИРОВАТЬ ПО
		|	ВидНоменклатуры
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Товары.НомерСтроки КАК НомерСтроки,
		|	Товары.СтатусУказанияСерий КАК СтарыйСтатусУказанияСерий,
		|	ВЫБОР
		|		КОГДА ПолитикиУчетаСерий.ПолитикаУчетаСерий ЕСТЬ NULL 
		|			ТОГДА 0
		|		КОГДА ПолитикиУчетаСерий.ПолитикаУчетаСерий.ТипПолитики = ЗНАЧЕНИЕ(Перечисление.ТипыПолитикУказанияСерий.СправочноеУказаниеСерий)
		|			ТОГДА
		|				ВЫБОР
		|					КОГДА Товары.Серия <> ЗНАЧЕНИЕ(Справочник.СерииНоменклатуры.ПустаяСсылка)
		|						ТОГДА 2
		|					ИНАЧЕ 21
		|				КОНЕЦ
		|		ИНАЧЕ
		|			ВЫБОР
		|				КОГДА ПолитикиУчетаСерий.ПолитикаУчетаСерий.УказыватьПриПланированииОтгрузки
		|					ТОГДА ВЫБОР
		|							КОГДА ПолитикиУчетаСерий.ПолитикаУчетаСерий.УчитыватьСебестоимостьПоСериям
		|								ТОГДА ВЫБОР
		|										КОГДА Товары.Серия = ЗНАЧЕНИЕ(Справочник.СерииНоменклатуры.ПустаяСсылка)
		|											ТОГДА 13
		|										ИНАЧЕ 14
		|									КОНЕЦ
		|							ИНАЧЕ ВЫБОР
		|									КОГДА Товары.Серия = ЗНАЧЕНИЕ(Справочник.СерииНоменклатуры.ПустаяСсылка)
		|										ТОГДА 9
		|									ИНАЧЕ 10
		|								КОНЕЦ
		|						КОНЕЦ
		|				КОГДА ПолитикиУчетаСерий.ПолитикаУчетаСерий.УказыватьПриПланированииОтбора
		|					ТОГДА ВЫБОР
		|							КОГДА Товары.Серия = ЗНАЧЕНИЕ(Справочник.СерииНоменклатуры.ПустаяСсылка)
		|								ТОГДА 7
		|							ИНАЧЕ 8
		|						КОНЕЦ
		|				КОГДА ПолитикиУчетаСерий.ПолитикаУчетаСерий.УказыватьПоФактуОтбора
		|						И ПолитикиУчетаСерий.ПолитикаУчетаСерий.УчитыватьОстаткиСерий
		|					ТОГДА ВЫБОР
		|							КОГДА Товары.Серия = ЗНАЧЕНИЕ(Справочник.СерииНоменклатуры.ПустаяСсылка)
		|								ТОГДА 3
		|							ИНАЧЕ 4
		|						КОНЕЦ
		|				ИНАЧЕ 0
		|			КОНЕЦ
		|	КОНЕЦ КАК СтатусУказанияСерий
		|ПОМЕСТИТЬ Статусы
		|ИЗ
		|	ТоварыДляЗапроса КАК Товары
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВидыНоменклатуры.ПолитикиУчетаСерий КАК ПолитикиУчетаСерий
		|		ПО Товары.ВидНоменклатуры = ПолитикиУчетаСерий.Ссылка
		|			И ПолитикиУчетаСерий.Склад = &Склад
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Статусы.НомерСтроки КАК НомерСтроки,
		|	Статусы.СтатусУказанияСерий КАК СтатусУказанияСерий
		|ИЗ
		|	Статусы КАК Статусы
		|ГДЕ
		|	Статусы.СтатусУказанияСерий <> Статусы.СтарыйСтатусУказанияСерий
		|УПОРЯДОЧИТЬ ПО
		|	Статусы.НомерСтроки";
	
	Возврат ТекстЗапроса;
	
КонецФункции

#КонецОбласти

#Область Прочее
// Создает документы отложенно внутри замера времени.
//
// Параметры:
//   Параметры - Структура - Параметры для создания документов
//   АдресХранилища - Строка - Адрес хранилища для обработки
//
// Возвращаемое значение:
//   Число - Количество сформированных данных
Функция СоздатьДокументыОтложенноВнутриЗамераВремени(Параметры, АдресХранилища)
	
	РезультатФормирования = РезультатФормирования();
	СформироватьИсследования(
		Параметры.Товары, Параметры.ЗаявкаНаКонтроль, Параметры.НесколькоНоменклатурВИсследовании, РезультатФормирования, АдресХранилища);
		
	КоличествоДанных = 0;
	Результат = ПолучитьИзВременногоХранилища(АдресХранилища);
	Если ТипЗнч(Результат) = Тип("Структура") Тогда
		КоличествоДанных = Результат.РезультатФормирования.Количество();
	КонецЕсли;
	
	Возврат КоличествоДанных;
	
КонецФункции

// Сформировать документы исследования товаров.
// 
// Параметры:
//  Товары - ТаблицаЗначений
//  ЗаявкаНаКонтроль - Документссылка.ЗаявкаНаКонтрольКачестваТоваров
//  НесколькоНоменклатурВИсследовании - Булево
//  Результат - Структура
//  АдресХранилища - Строка
//
Процедура СформироватьИсследования(Товары, ЗаявкаНаКонтроль, НесколькоНоменклатурВИсследовании, Результат, АдресХранилища)

	РезультатФормирования = Результат.РезультатФормирования;
	СозданныеОбъекты = Результат.СозданныеОбъекты;
	Сообщения = Результат.Сообщения;

	Если Не НесколькоНоменклатурВИсследовании Тогда
		
	// Создание исследований
		УстановитьПривилегированныйРежим(Истина);
		Для Каждого СтрокаТЗ Из Товары Цикл

			Пока Истина Цикл

				Попытка

					РеквизитыШапки = Новый Структура;

					РеквизитыШапки.Вставить("ЗаявкаНаКонтроль", ЗаявкаНаКонтроль);
					РеквизитыШапки.Вставить("КартаИсследованияТоваров", СтрокаТЗ.КартаИсследованияТоваров);
					РеквизитыШапки.Вставить("Контроль", СтрокаТЗ.Контроль);
					РеквизитыШапки.Вставить("Склад", СтрокаТЗ.Склад);
					РеквизитыШапки.Вставить("Ответственный", СтрокаТЗ.Исполнитель);
					РеквизитыШапки.Вставить("Завершено", Ложь);

					РеквизитыШапки.Вставить("СпособПроверкиЭкземпляров",
						Перечисления.ВариантыПроверкиЭкземпляровИсследования.ПоЭкземплярно);

					РеквизитыШапки.Вставить("Дата", ТекущаяДатаСеанса());
					РеквизитыШапки.Вставить("Комментарий", НСтр(
						"ru = 'Сформирован автоматически (назначение исследований)';
						|en = 'Generated automatically (research assignment)'"));

					ТоварыДляИсследования = Товары.СкопироватьКолонки();
					НоваяСтрока = ТоварыДляИсследования.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТЗ);

					ДанныеЗаполнения = Новый Структура;
					ДанныеЗаполнения.Вставить("РеквизитыШапки", РеквизитыШапки);
					ДанныеЗаполнения.Вставить("Товары", ТоварыДляИсследования);

					Исследование = Документы.ИсследованиеКачестваТоваров.СоздатьДокумент();
					Исследование.Заполнить(ДанныеЗаполнения);
				
					// Отказ от проверки заполнения дополнительных реквизитов
					ПараметрыСеанса.ИнтерактивнаяПроверкаЗаполненияСвойств = Истина;

					Если Исследование.ПроверитьЗаполнение() Тогда

						Исследование.Записать(РежимЗаписиДокумента.Проведение);

						НоваяСтрока = РезультатФормирования.Добавить();
						НоваяСтрока.КартаИсследованияТоваров = СтрокаТЗ.КартаИсследованияТоваров;
						НоваяСтрока.ЗаявкаНаКонтроль = ЗаявкаНаКонтроль;
						НоваяСтрока.ИсследованиеКачестваТоваров = Исследование.Ссылка;

						СозданныеОбъекты.Добавить(Исследование.Ссылка);

					КонецЕсли;

				Исключение

					Событие = НСтр("ru = 'Исследование товаров';
									|en = 'Goods research'", ОбщегоНазначения.КодОсновногоЯзыка()) + "." + НСтр(
						"ru = 'Формирование исследований';
						|en = 'Generate research'", ОбщегоНазначения.КодОсновногоЯзыка());

					ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Ошибка, , ,
						ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));

				КонецПопытки;

				Для Каждого Сообщение Из ПолучитьСообщенияПользователю(Истина) Цикл
					Сообщение.КлючДанных = Исследование.Ссылка;
					Сообщения.Добавить(Сообщение);
				КонецЦикла;

				Прервать;

			КонецЦикла;

		КонецЦикла;
		УстановитьПривилегированныйРежим(Ложь);

	Иначе

		СтруктураПоискаКартыИсследованияТоваров = Новый Структура;
		СтруктураПоискаКартыИсследованияТоваров.Вставить("КартаИсследованияТоваров",
			Справочники.КартыИсследованияТоваров.ПустаяСсылка());
		СтруктураПоискаКартыИсследованияТоваров.Вставить("Исполнитель", Справочники.Пользователи.ПустаяСсылка());
		СтруктураПоискаКартыИсследованияТоваров.Вставить("Склад", Справочники.Склады.ПустаяСсылка());

		КартыИсследованийТоваров = Товары.Скопировать( , "КартаИсследованияТоваров, Исполнитель, Склад");
		КартыИсследованийТоваров.Свернуть("КартаИсследованияТоваров, Исполнитель, Склад");
	
		// Создание исследований
		УстановитьПривилегированныйРежим(Истина);
		Для Каждого СтрокаТЗ Из КартыИсследованийТоваров Цикл

			Пока Истина Цикл

				Попытка

					ЗаполнитьЗначенияСвойств(СтруктураПоискаКартыИсследованияТоваров, СтрокаТЗ);
					ТоварыКПомещениюВИсследование = Товары.Скопировать(СтруктураПоискаКартыИсследованияТоваров);

					РеквизитыШапки = Новый Структура;

					Если ТоварыКПомещениюВИсследование.Количество() <> 0 Тогда

						СтрокаТоваров = ТоварыКПомещениюВИсследование[0];
						РеквизитыШапки.Вставить("ЗаявкаНаКонтроль", ЗаявкаНаКонтроль);
						РеквизитыШапки.Вставить("КартаИсследованияТоваров", СтрокаТоваров.КартаИсследованияТоваров);
						РеквизитыШапки.Вставить("Контроль", СтрокаТоваров.Контроль);
						РеквизитыШапки.Вставить("Склад", СтрокаТоваров.Склад);
						РеквизитыШапки.Вставить("Ответственный", СтрокаТоваров.Исполнитель);
						РеквизитыШапки.Вставить("Завершено", Ложь);

						РеквизитыШапки.Вставить("СпособПроверкиЭкземпляров",
							Перечисления.ВариантыПроверкиЭкземпляровИсследования.ПоЭкземплярно);

						РеквизитыШапки.Вставить("Дата", ТекущаяДатаСеанса());
						РеквизитыШапки.Вставить("Комментарий", НСтр(
						"ru = 'Сформирован автоматически (назначение исследований)';
						|en = 'Generated automatically (research assignment)'"));

					КонецЕсли;

					ДанныеЗаполнения = Новый Структура;
					ДанныеЗаполнения.Вставить("РеквизитыШапки", РеквизитыШапки);
					ДанныеЗаполнения.Вставить("Товары", ТоварыКПомещениюВИсследование);

					Исследование = Документы.ИсследованиеКачестваТоваров.СоздатьДокумент();
					Исследование.Заполнить(ДанныеЗаполнения);
				
					// Отказ от проверки заполнения дополнительных реквизитов
					ПараметрыСеанса.ИнтерактивнаяПроверкаЗаполненияСвойств = Истина;

					Если Исследование.ПроверитьЗаполнение() Тогда
						Исследование.Записать(РежимЗаписиДокумента.Проведение);

						НоваяСтрока = РезультатФормирования.Добавить();
						Если ТоварыКПомещениюВИсследование.Количество() <> 0 Тогда
							НоваяСтрока.КартаИсследованияТоваров = СтрокаТоваров.КартаИсследованияТоваров;
						КонецЕсли;
						НоваяСтрока.ЗаявкаНаКонтроль = ЗаявкаНаКонтроль;
						НоваяСтрока.ИсследованиеКачестваТоваров = Исследование.Ссылка;

						СозданныеОбъекты.Добавить(Исследование.Ссылка);

					КонецЕсли;

				Исключение

					Событие = НСтр("ru = 'Исследование товаров';
									|en = 'Goods research'", ОбщегоНазначения.КодОсновногоЯзыка()) + "." + НСтр(
						"ru = 'Формирование исследований';
						|en = 'Generate research'", ОбщегоНазначения.КодОсновногоЯзыка());

					ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Ошибка, , ,
						ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));

				КонецПопытки;

				Для Каждого Сообщение Из ПолучитьСообщенияПользователю(Истина) Цикл
					Сообщение.КлючДанных = Исследование.Ссылка;
					Сообщения.Добавить(Сообщение);
				КонецЦикла;

				Прервать;

			КонецЦикла;

		КонецЦикла;
		УстановитьПривилегированныйРежим(Ложь);

	КонецЕсли;
	
	// Очистка стека сообщений
	Для Каждого Сообщение Из ПолучитьСообщенияПользователю(Истина) Цикл
		Сообщения.Добавить(Сообщение);
	КонецЦикла;
	
	// Фиксация результата
	ПоместитьВоВременноеХранилище(Результат, АдресХранилища);

КонецПроцедуры

// Возвращает текст запроса для динамического списка исследований товаров.
//
// Возвращаемое значение:
//   Строка - текст запроса для динамического списка исследований товаров
Функция ТекстЗапросаДинамическогоСпискаИсследованияТоваров() Экспорт
	
	ТекстЗапроса = "ВЫБРАТЬ
	|	ИсследованиеКачестваТоваровПереопределяемый.Ссылка,
	|	ИсследованиеКачестваТоваровПереопределяемый.Номер,
	|	ИсследованиеКачестваТоваровПереопределяемый.Дата,
	|	ИсследованиеКачестваТоваровПереопределяемый.КартаИсследованияТоваров,
	|	ИсследованиеКачестваТоваровПереопределяемый.Контроль,
	|	ИсследованиеКачестваТоваровПереопределяемый.Ответственный
	|ИЗ
	|	Документ.ИсследованиеКачестваТоваров КАК ИсследованиеКачестваТоваровПереопределяемый
	|ГДЕ
	|	ИсследованиеКачестваТоваровПереопределяемый.Ссылка В (&Ссылки)";
	
	Возврат ТекстЗапроса;
	
КонецФункции

Процедура УдалитьОбъектыОтложенноВнутриЗамераВремени(Параметры, АдресХранилища)

	Для Каждого Ссылка Из Параметры.Ссылки Цикл

		Объект = Ссылка.ПолучитьОбъект();

		Если Объект = Неопределено Или Объект.ПометкаУдаления Тогда
			Продолжить;
		КонецЕсли;

		Объект.Заблокировать();

		УстановитьПривилегированныйРежим(Истина);
		Объект.УстановитьПометкуУдаления(Истина);
		УстановитьПривилегированныйРежим(Ложь);

	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область Печать

#Область ЗаданиеНаОтбор

Функция СформироватьПечатнуюФормуЗаданиеНаОтбор(МассивОбъектов, ОбъектыПечати, ПараметрыПечати)
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.АвтоМасштаб = Истина;
	ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	ТабличныйДокумент.ИмяПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_ИсследованиеКачестваТоваров_ЗаданиеНаОтбор";
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.ИсследованиеКачестваТоваров.ПФ_MXL_ЗаданиеНаОтбор");
	ПервыйДокумент = Истина;
	
	ДанныеДляПечати = ПолучитьДанныеДляПечатнойФормыЗаданиеНаОтбор(МассивОбъектов, ПараметрыПечати);
	ВыборкаДокумент = ДанныеДляПечати.ВыборкаДокумент;
	
	Пока ВыборкаДокумент.Следующий() Цикл
	
		Если НЕ ПервыйДокумент Тогда
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		ПервыйДокумент = Ложь;
		
		НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
		
		ЗаданиеНаОтборВывестиЗаголовок(ТабличныйДокумент, Макет, ВыборкаДокумент);
		
		ЗаданиеНаОтборВывестиШапку(ТабличныйДокумент, Макет, ВыборкаДокумент);
		
		ЗаданиеНаОтборВывестиТовары(
			ПараметрыПечати, ТабличныйДокумент, Макет, ВыборкаДокумент, ДанныеДляПечати);
		
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(
			ТабличныйДокумент,
			НомерСтрокиНачало,
			ОбъектыПечати,
			ВыборкаДокумент.Ссылка);
		
	КонецЦикла;
	
	Возврат ТабличныйДокумент;
	
КонецФункции

Функция ПолучитьДанныеДляПечатнойФормыЗаданиеНаОтбор(МассивОбъектов, ПараметрыПечати)
	
	ТекстыЗапросовПакета = Новый Массив;
	ИндексыРезультатов = Новый Соответствие;
	Индекс = 0;
	
	#Область ТекстЗапросаШапка
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ДанныеДокумента.Ссылка            КАК Ссылка,
	|	ДанныеДокумента.Номер             КАК Номер,
	|	ДанныеДокумента.Представление     КАК ПредставлениеРаспоряжения,
	|
	|	ДанныеДокумента.Дата              КАК ДатаВыполненияПлан,
	|	ДанныеДокумента.Ответственный.Представление КАК ПредставлениеИсполнителя
	|ИЗ
	|	Документ.ИсследованиеКачестваТоваров КАК ДанныеДокумента
	|ГДЕ
	|	ДанныеДокумента.Ссылка В(&МассивОбъектов)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка";
	
	ТекстыЗапросовПакета.Добавить(ТекстЗапроса);
	ИндексыРезультатов.Вставить("ВыборкаДокумент", Индекс);
	Индекс = Индекс + 1;
	
	#КонецОбласти
	
	#Область ТекстЗапросаТовары
	
	ТекстЗапроса = "ВЫБРАТЬ
	|	Товары.Ссылка КАК Ссылка,
	|	Товары.Номенклатура КАК Номенклатура,
	|	Товары.Номенклатура.Код КАК Код,
	|	Товары.Номенклатура.Артикул КАК Артикул,
	|	Товары.Номенклатура.НаименованиеПолное КАК НоменклатураНаименованиеПолное,
	|	Товары.Характеристика.НаименованиеПолное КАК ХарактеристикаНаименованиеПолное,
	|	Товары.Серия,
	|	Товары.Ссылка.Склад КАК Склад,
	|	Товары.Назначение,
	|	Товары.КонтролируемаяПартия,
	|	Товары.Ссылка.Склад.Представление КАК ПредставлениеСклада,
	|	Товары.Номенклатура.ЕдиницаИзмерения КАК ПредставлениеЕдиницыИзмерения,
	|	Товары.Количество КАК Количество
	|ИЗ
	|	Документ.ИсследованиеКачестваТоваров.ПланИРезультатИсследования КАК Товары
	|ГДЕ
	|	Товары.Ссылка В (&МассивОбъектов)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка,
	|	Товары.НомерСтроки
	|ИТОГИ
	|ПО
	|	Ссылка";
		
	ТекстыЗапросовПакета.Добавить(ТекстЗапроса);
	ИндексыРезультатов.Вставить("ВыборкаТовары", Индекс);
	Индекс = Индекс + 1;
	
	#КонецОбласти
	
	#Область СборкаТекста
	
	Разделитель =
	"
	|;
	|/////////////////////////////////////////////////////////////
	|";
	
	ТекстЗапроса = СтрСоединить(ТекстыЗапросовПакета, Разделитель);
	
	#КонецОбласти
	
	#Область ВыполнениеЗапроса
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	УстановитьПривилегированныйРежим(Истина);
	
	МассивРезультатов = Запрос.ВыполнитьПакет();
	
	УстановитьПривилегированныйРежим(Ложь);
	
	ДанныеДляПечати = Новый Структура;
	
	Для каждого Результат Из ИндексыРезультатов Цикл
		
		РезультатЗапроса = МассивРезультатов[Результат.Значение]; // РезультатЗапроса
		Выборка = РезультатЗапроса.Выбрать(
			?(Результат.Ключ = "ВыборкаДокумент",
				ОбходРезультатаЗапроса.Прямой,
				ОбходРезультатаЗапроса.ПоГруппировкам));
		ДанныеДляПечати.Вставить(Результат.Ключ, Выборка);
		
	КонецЦикла;
	
	#КонецОбласти
	
	Возврат ДанныеДляПечати;
	
КонецФункции

// Выводит заголовок
//
// Параметры:
//  ТабличныйДокумент - ТабличныйДокумент
//  Макет - ТабличныйДокумент, МакетОформленияКомпоновкиДанных, ОболочкаActiveDocument, ГеографическаяСхема, ТекстовыйДокумент, ОболочкаHTMLДокумента, ДвоичныеДанные, ГрафическаяСхема, СхемаКомпоновкиДанных -
//  ВыборкаДокумент - ВыборкаИзРезультатаЗапроса - содержит:
//                     * Ссылка - ДокументСсылка - 
//
Процедура ЗаданиеНаОтборВывестиЗаголовок(ТабличныйДокумент, Макет, ВыборкаДокумент)
	
	Область = Макет.ПолучитьОбласть("Заголовок");
	
	Область.Параметры.Заполнить(ВыборкаДокумент);
	
	ШтрихкодированиеПечатныхФорм.ВывестиШтрихкодВТабличныйДокумент(
		ТабличныйДокумент,
		Макет,
		Область,
		ВыборкаДокумент.Ссылка);
	
	ТабличныйДокумент.Вывести(Область);
	
КонецПроцедуры

Процедура ЗаданиеНаОтборВывестиШапку(ТабличныйДокумент, Макет, ВыборкаДокумент)
	
	Область = Макет.ПолучитьОбласть("Шапка");
	
	Область.Параметры.Заполнить(ВыборкаДокумент);
	Если ЗначениеЗаполнено(ВыборкаДокумент.ПредставлениеИсполнителя) Тогда
		Область.Параметры.ПредставлениеИсполнителя = ФизическиеЛицаКлиентСервер.ФамилияИнициалы(ВыборкаДокумент.ПредставлениеИсполнителя);
	КонецЕсли;
	
	ТабличныйДокумент.Вывести(Область);
	
КонецПроцедуры

// Выводит Товары
//
// Параметры:
//  ПараметрыПечати - Структура
//  ТабличныйДокумент - ТабличныйДокумент
//  Макет - ТабличныйДокумент, МакетОформленияКомпоновкиДанных, ОболочкаActiveDocument, ГеографическаяСхема, ТекстовыйДокумент, ОболочкаHTMLДокумента, ДвоичныеДанные, ГрафическаяСхема, СхемаКомпоновкиДанных -
//  ВыборкаДокумент - ВыборкаИзРезультатаЗапроса - содержит:
// * Ссылка - ДокументСсылка -
//  ДанныеДляПечати - Структура - содержит:
// * ВыборкаТовары - ВыборкаИзРезультатаЗапроса
Процедура ЗаданиеНаОтборВывестиТовары(ПараметрыПечати, ТабличныйДокумент, Макет, ВыборкаДокумент, ДанныеДляПечати)
	
	ВыборкаТовары = ДанныеДляПечати.ВыборкаТовары;
		
	СтруктураПоиска = Новый Структура("Ссылка", ВыборкаДокумент.Ссылка);
	Если НЕ ВыборкаТовары.НайтиСледующий(СтруктураПоиска) Тогда
		Возврат;
	КонецЕсли;
	
	КолонкаКодов = ФормированиеПечатныхФорм.ДополнительнаяКолонкаПечатныхФормДокументов();
	ИмяКолонкиКодов = КолонкаКодов.ИмяКолонки;
	ПредставлениеКолонкиКодов = КолонкаКодов.ПредставлениеКолонки;
	ВыводитьКоды = ЗначениеЗаполнено(ИмяКолонкиКодов);
	
	Если ВыводитьКоды Тогда
		
		ОбластьШапка = Макет.ПолучитьОбласть("ШапкаТаблицыТовары_СКодом");
		ОбластьШапка.Параметры.ИмяКолонкиКодов = ПредставлениеКолонкиКодов;
		
		ИмяОбластиСтрока = "СтрокаТаблицыТовары_СКодом";
		ОбластьСтрока = Макет.ПолучитьОбласть(ИмяОбластиСтрока);
		
	Иначе
		
		ОбластьШапка = Макет.ПолучитьОбласть("ШапкаТаблицыТовары_БезКода");
		
		ИмяОбластиСтрока = "СтрокаТаблицыТовары_БезКода";
		ОбластьСтрока = Макет.ПолучитьОбласть(ИмяОбластиСтрока);
		
	КонецЕсли;
	
	ТабличныйДокумент.Вывести(ОбластьШапка);
		
	НомерСтроки = 0;
	Выборка = ВыборкаТовары.Выбрать();
	Пока Выборка.Следующий() Цикл
		
		ОбластьСтрока.Параметры.Заполнить(Выборка);
		
		НомерСтроки = НомерСтроки + 1;
		ОбластьСтрока.Параметры.НомерСтроки = НомерСтроки;
		
		Если ВыводитьКоды Тогда
			ОбластьСтрока.Параметры.Артикул = Выборка[ИмяКолонкиКодов];
		КонецЕсли;
		
		ДопПараметрыПредставлениеНоменклатуры = НоменклатураКлиентСервер.ДополнительныеПараметрыПредставлениеНоменклатурыДляПечати();
		ДопПараметрыПредставлениеНоменклатуры.КодОсновногоЯзыка = ОбщегоНазначения.КодОсновногоЯзыка();
		
		ПредставлениеНоменклатуры = НоменклатураКлиентСервер.ПредставлениеНоменклатурыДляПечати(
				Выборка.НоменклатураНаименованиеПолное,
				Выборка.ХарактеристикаНаименованиеПолное,
				,
				Выборка.Серия,
				ДопПараметрыПредставлениеНоменклатуры);
		ОбластьСтрока.Параметры.ПредставлениеНоменклатуры = ПредставлениеНоменклатуры;
		ОбластьСтрока.Параметры.ПредставлениеНазначение = Строка(Выборка.Назначение);
		
		ТабличныйДокумент.Вывести(ОбластьСтрока);
		
	КонецЦикла;
	
	ОбластьПодвал = Макет.ПолучитьОбласть("ПодвалТаблицыТовары");
	ТабличныйДокумент.Вывести(ОбластьПодвал);
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#КонецОбласти

#КонецЕсли
