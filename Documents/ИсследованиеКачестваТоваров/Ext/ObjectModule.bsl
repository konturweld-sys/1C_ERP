#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	МассивНепроверяемыхРеквизитов = Новый Массив();
	
	Если ДополнительныеСвойства.Свойство("ОднаНоменклатура") Тогда
		Если ДополнительныеСвойства.ОднаНоменклатура Тогда
			МассивНепроверяемыхРеквизитов.Добавить("ПланИРезультатИсследования.Номенклатура");
			МассивНепроверяемыхРеквизитов.Добавить("ПланИРезультатИсследования.Характеристика");
			МассивНепроверяемыхРеквизитов.Добавить("ПланИРезультатИсследования.КоличествоУпаковок");
			ПроверитьПланИРезультатИсследованияОдногоТовара(Отказ);
		Иначе
			ПараметрыПроверки = НоменклатураСервер.ПараметрыПроверкиЗаполненияХарактеристик();
			ПараметрыПроверки.ИмяТЧ = "ПланИРезультатИсследования";

			НоменклатураСервер.ПроверитьЗаполнениеХарактеристик(
				ЭтотОбъект, МассивНепроверяемыхРеквизитов, Отказ, ПараметрыПроверки);
		КонецЕсли;
	Иначе
		ПараметрыПроверки = НоменклатураСервер.ПараметрыПроверкиЗаполненияХарактеристик();
		ПараметрыПроверки.ИмяТЧ = "ПланИРезультатИсследования";

		НоменклатураСервер.ПроверитьЗаполнениеХарактеристик(
				ЭтотОбъект, МассивНепроверяемыхРеквизитов, Отказ, ПараметрыПроверки);
	КонецЕсли;
	
	ПараметрыУказанияСерий = НоменклатураСервер.ПараметрыУказанияСерий(ЭтотОбъект,
		Документы.ИсследованиеКачестваТоваров);

	МассивПараметров = Новый Массив;
	МассивПараметров.Добавить(ПараметрыУказанияСерий.ПланИРезультатИсследования);
	НоменклатураСервер.ПроверитьЗаполнениеСерий(ЭтотОбъект, МассивПараметров, Отказ, МассивНепроверяемыхРеквизитов);
	
	ПараметрыПроверки = НоменклатураСервер.ПараметрыПроверкиЗаполненияХарактеристик();
	ПараметрыПроверки.ИмяТЧ = "ИсследованияТоваров";

	НоменклатураСервер.ПроверитьЗаполнениеХарактеристик(
	ЭтотОбъект, МассивНепроверяемыхРеквизитов, Отказ, ПараметрыПроверки);
	
	Если МассивНепроверяемыхРеквизитов.Найти("ПланИРезультатИсследования.Упаковка") = Неопределено Тогда
		МассивНепроверяемыхРеквизитов.Добавить("ПланИРезультатИсследования.Упаковка");
	КонецЕсли;
	
	ОбщегоНазначения.УдалитьНепроверяемыеРеквизитыИзМассива(ПроверяемыеРеквизиты, МассивНепроверяемыхРеквизитов);
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ЕстьОтклонения = ВычислитьОтклонение();
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	ИнициализироватьДокумент();
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("Структура") Тогда
		
		Если ДанныеЗаполнения.Свойство("РеквизитыШапки") Тогда
			ЗаполнитьЗначенияСвойств(ЭтотОбъект, ДанныеЗаполнения.РеквизитыШапки);
		Иначе
			ЗаполнитьЗначенияСвойств(ЭтотОбъект, ДанныеЗаполнения);
		КонецЕсли;
		
		Если ДанныеЗаполнения.Свойство("Товары") Тогда
			
			ЗаполнитьПоТаблицеТовары(ДанныеЗаполнения.Товары);
			
		КонецЕсли;
		
		ИнициализироватьДокументПослеЗаполнения();
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ЗаявкаНаКонтроль) Тогда
		РегистрыСведений.СостоянияЗаявокНаКонтрольКачества.ОтразитьСостоянияЗаявок(ЗаявкаНаКонтроль);
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	ИнициализироватьДокумент();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ИнициализацияИЗаполнение

Процедура ИнициализироватьДокумент(ДанныеЗаполнения = Неопределено)
	
	Контроль = Перечисления.КонтрольКачества.Выборочный;
	СпособПроверкиЭкземпляров = Перечисления.ВариантыПроверкиЭкземпляровИсследования.ПоЭкземплярно;
	Завершено = Ложь;
	Ответственный = Пользователи.ТекущийПользователь();
	
КонецПроцедуры

Процедура ИнициализироватьДокументПослеЗаполнения(ДанныеЗаполнения = Неопределено)
	
	ПараметрыУказанияСерий = Новый ФиксированнаяСтруктура(НоменклатураСервер.ПараметрыУказанияСерий(ЭтотОбъект, Документы.ИсследованиеКачестваТоваров));
	НоменклатураСервер.ЗаполнитьСтатусыУказанияСерий(ЭтотОбъект, ПараметрыУказанияСерий["ПланИРезультатИсследования"]);
	НоменклатураСервер.ЗаполнитьСтатусыУказанияСерий(ЭтотОбъект, ПараметрыУказанияСерий["ИсследованияТоваров"]);
	
КонецПроцедуры

Функция ВычислитьОтклонение()
	
	Возврат ПланИРезультатИсследования.Итог("КоличествоНегодное") <> 0;
	
КонецФункции

#КонецОбласти

#Область Заполнение

// Заполняет табличную часть "ПланИРезультатИсследования" документа "ИсследованиеКачестваТоваров" на основе переданной таблицы товаров.
//
// Параметры:
//   ТаблицаТоваров - ТаблицаЗначений - таблица с данными о товарах для заполнения табличной части "ПланИРезультатИсследования"
Процедура ЗаполнитьПоТаблицеТовары(ТаблицаТоваров)
	
	Если ТаблицаТоваров.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	КэшированныеЗначения = ПакетнаяОбработкаТабличнойЧастиКлиентСервер.ПолучитьСтруктуруКэшируемыеЗначения();
	СтруктураДействий = Новый Структура;
	
	Если ТаблицаТоваров.Колонки.Найти("КоличествоУпаковок") = Неопределено Тогда
		СтруктураДействий.Вставить("ПересчитатьКоличествоУпаковок");
	КонецЕсли;
	
	ОбрабатываемыеСтроки = Новый Массив;
	Для каждого СтрокаТовара Из ТаблицаТоваров Цикл
		
		СтрокаТабличнойЧасти = ПланИРезультатИсследования.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаТабличнойЧасти, СтрокаТовара);
		СтрокаТабличнойЧасти.ИдентификаторСтроки = Новый УникальныйИдентификатор;
		
		ОбрабатываемыеСтроки.Добавить(СтрокаТабличнойЧасти);
		
	КонецЦикла;
	
	ПакетнаяОбработкаТабличнойЧастиСервер.ОбработатьСтрокиТЧ(
		ОбрабатываемыеСтроки,
		СтруктураДействий,
		ПланИРезультатИсследования,
		КэшированныеЗначения);
	
КонецПроцедуры

#КонецОбласти

#Область Проверка

Процедура ПроверитьПланИРезультатИсследованияОдногоТовара(Отказ)

	Если ПланИРезультатИсследования.Количество() <> 0 Тогда

		СтрокаТаблицыПланИРезультатИсследования = ПланИРезультатИсследования[0];

		Шаблон = НСтр("ru = 'Поле ""%1"" не заполнено';
						|en = '""%1"" is required'");
		СписокПроверяемыхРеквизитов = Новый Структура("Номенклатура, КоличествоУпаковок",
			"Номенклатура", "К исследованию");

		Для Каждого КлючИЗначение Из СписокПроверяемыхРеквизитов Цикл
			Если Не ЗначениеЗаполнено(СтрокаТаблицыПланИРезультатИсследования[КлючИЗначение.Ключ]) Тогда
				ТекстСообщения = СтрШаблон(Шаблон, КлючИЗначение.Значение);
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ЭтотОбъект, , , Отказ);
			КонецЕсли;
		КонецЦикла;

		ИспользоватьХарактеристики = ПолучитьФункциональнуюОпцию("ИспользоватьХарактеристикиНоменклатуры");

		Если ИспользоватьХарактеристики И Не ЗначениеЗаполнено(СтрокаТаблицыПланИРезультатИсследования.Характеристика)
			И Справочники.Номенклатура.ХарактеристикиИспользуются(
			СтрокаТаблицыПланИРезультатИсследования.Номенклатура) Тогда
			ТекстСообщения = НСтр("ru = 'Поле ""Характеристика"" не заполнено';
									|en = '""Variant"" is not filled in'");
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ЭтотОбъект, , , Отказ);
		КонецЕсли;

	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#КонецОбласти

#КонецЕсли
