Процедура ЗаполнитьПараметрыИнициализации(Запрос, ДокументСсылка)
	
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА ОбластиДействия.ЗаказНаПроизводство В (ЗНАЧЕНИЕ(Документ.ЗаказНаПроизводство2_2.ПустаяСсылка), 
	//++ Устарело_Производство21
	|														 ЗНАЧЕНИЕ(Документ.ЗаказНаПроизводство.ПустаяСсылка), 
	//-- Устарело_Производство21
	|														 НЕОПРЕДЕЛЕНО)
	|				ТОГДА 0
	|			ИНАЧЕ 10000000
	|		КОНЕЦ + ВЫБОР
	|			КОГДА ОбластиДействия.ЗаказКлиента = ЗНАЧЕНИЕ(Документ.ЗаказКлиента.ПустаяСсылка)
	|				ТОГДА 0
	|			ИНАЧЕ 1000000
	|		КОНЕЦ + ВЫБОР
	|			КОГДА ОбластиДействия.Спецификация = ЗНАЧЕНИЕ(Справочник.РесурсныеСпецификации.ПустаяСсылка)
	|				ТОГДА 0
	|			ИНАЧЕ 100000
	|		КОНЕЦ + ВЫБОР
	|			КОГДА ОбластиДействия.Этап = ЗНАЧЕНИЕ(Справочник.ЭтапыПроизводства.ПустаяСсылка)
	|				ТОГДА 0
	|			ИНАЧЕ 10000
	|		КОНЕЦ + ВЫБОР
	|			КОГДА ОбластиДействия.ХарактеристикаИзделия = ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)
	|				ТОГДА ВЫБОР
	|						КОГДА ОбластиДействия.Изделие = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|							ТОГДА 0
	|						ИНАЧЕ 100
	|					КОНЕЦ
	|			ИНАЧЕ 1000
	|		КОНЕЦ + ВЫБОР
	|			КОГДА ОбластиДействия.Подразделение = ЗНАЧЕНИЕ(Справочник.СтруктураПредприятия.ПустаяСсылка)
	|				ТОГДА 0
	|			ИНАЧЕ 10
	|		КОНЕЦ + ВЫБОР
	|			КОГДА ОбластиДействия.НаправлениеДеятельности = ЗНАЧЕНИЕ(Справочник.НаправленияДеятельности.ПустаяСсылка)
	|				ТОГДА 0
	|			ИНАЧЕ 1
	|		КОНЕЦ) КАК Приоритет
	|ИЗ
	|	Документ.РазрешениеНаЗаменуМатериалов.ОбластиДействия КАК ОбластиДействия
	|ГДЕ
	|	ОбластиДействия.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	РазрешениеНаЗаменуМатериалов.ДатаНачалаДействия КАК ДатаНачалаДействия,
	|	РазрешениеНаЗаменуМатериалов.ДатаОкончанияДействия КАК ДатаОкончанияДействия,
	|	РазрешениеНаЗаменуМатериалов.Статус КАК Статус,
	|	РазрешениеНаЗаменуМатериалов.ВариантЗамены КАК ВариантЗамены,
	|	РазрешениеНаЗаменуМатериалов.ВзаимозаменяемыеАналоги КАК ВзаимозаменяемыеАналоги,
	|	РазрешениеНаЗаменуМатериалов.ПриоритетЗамены КАК ПриоритетЗамены,
	|	РазрешениеНаЗаменуМатериалов.ИспользоватьПриАвтозаменеВЗаказах КАК ИспользоватьПриАвтозаменеВЗаказах,
	|	РазрешениеНаЗаменуМатериалов.Проведен КАК Проведен
	|ИЗ
	|	Документ.РазрешениеНаЗаменуМатериалов КАК РазрешениеНаЗаменуМатериалов
	|ГДЕ
	|	РазрешениеНаЗаменуМатериалов.Ссылка = &Ссылка";
	
	МассивРезультатов = Запрос.ВыполнитьПакет();
	Индекс = МассивРезультатов.ВГраница();
	
	РеквизитыШапки = МассивРезультатов[Индекс].Выбрать();
	РеквизитыТЧ = МассивРезультатов[Индекс - 1].Выбрать();
	
	РеквизитыШапки.Следующий();
	РеквизитыТЧ.Следующий();
	
	Запрос.УстановитьПараметр("Приоритет",                 РеквизитыТЧ.Приоритет);
	Запрос.УстановитьПараметр("Статус",                    РеквизитыШапки.Статус);
	Запрос.УстановитьПараметр("ДатаНачалаДействия",        РеквизитыШапки.ДатаНачалаДействия);
	Запрос.УстановитьПараметр("ДатаОкончанияДействия",     РеквизитыШапки.ДатаОкончанияДействия);
	Запрос.УстановитьПараметр("ВариантЗамены",             РеквизитыШапки.ВариантЗамены);
	Запрос.УстановитьПараметр("ВзаимозаменяемыеАналоги",   РеквизитыШапки.ВзаимозаменяемыеАналоги);
	Запрос.УстановитьПараметр("ПриоритетЗамены",           РеквизитыШапки.ПриоритетЗамены);
	Запрос.УстановитьПараметр("Проведен",                  РеквизитыШапки.Проведен);
	
	Запрос.УстановитьПараметр("ИспользоватьПриАвтозаменеВЗаказах",
		РеквизитыШапки.ИспользоватьПриАвтозаменеВЗаказах);
		
КонецПроцедуры

Функция ТекстЗапросаТаблицаАналогиМатериалов(Запрос, ТекстыЗапроса, Регистры)

	ИмяРегистра = "АналогиМатериалов";
	
	Если НЕ ПроведениеДокументов.ТребуетсяТаблицаДляДвижений(ИмяРегистра, Регистры) Тогда
		Возврат "";
	КонецЕсли; 
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	&Ссылка КАК Разрешение,
	|	&ДатаНачалаДействия КАК Период,
	|	&ДатаОкончанияДействия КАК ПериодЗавершения,
	|	&ПриоритетЗамены КАК ПриоритетЗамены,
	|	&ИспользоватьПриАвтозаменеВЗаказах КАК ИспользоватьПриАвтозаменеВЗаказах,
	|	Материалы.Номенклатура КАК Номенклатура,
	|	Материалы.Характеристика КАК Характеристика,
	|	Материалы.ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	Материалы.КоличествоУпаковок КАК КоличествоУпаковок,
	|	ЕСТЬNULL(&ТекстЗапросаКоэффициентУпаковкиМатериал, 1) * Материалы.КоличествоУпаковок КАК Количество,
	|	Материалы.Упаковка КАК Упаковка,
	|	ВЫБОР
	|		КОГДА &ВариантЗамены = ЗНАЧЕНИЕ(Перечисление.ВариантЗаменыАналогов.СписокАналогов)
	|				ИЛИ &ВзаимозаменяемыеАналоги
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.РолиАналогов.ВзаимозаменяемыйАналог)
	|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.РолиАналогов.Материал)
	|	КОНЕЦ КАК РольНоменклатуры,
	|	&Приоритет КАК МаксимальныйПриоритетОбластиДействия
	|ИЗ
	|	Документ.РазрешениеНаЗаменуМатериалов.Материалы КАК Материалы
	|ГДЕ
	|	Материалы.Ссылка = &Ссылка
	|	И &Проведен
	|	И &Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыРазрешенийНаЗаменуМатериалов.Утверждено)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	&Ссылка,
	|	&ДатаНачалаДействия,
	|	&ДатаОкончанияДействия,
	|	&ПриоритетЗамены,
	|	&ИспользоватьПриАвтозаменеВЗаказах,
	|	Аналоги.Номенклатура,
	|	Аналоги.Характеристика,
	|	Аналоги.ИдентификаторСтроки,
	|	Аналоги.КоличествоУпаковок,
	|	ЕСТЬNULL(&ТекстЗапросаКоэффициентУпаковкиАналог, 1) * Аналоги.КоличествоУпаковок,
	|	Аналоги.Упаковка,
	|	ВЫБОР
	|		КОГДА &ВзаимозаменяемыеАналоги
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.РолиАналогов.ВзаимозаменяемыйАналог)
	|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.РолиАналогов.Аналог)
	|	КОНЕЦ,
	|	&Приоритет
	|ИЗ
	|	Документ.РазрешениеНаЗаменуМатериалов.Аналоги КАК Аналоги
	|ГДЕ
	|	Аналоги.Ссылка = &Ссылка
	|	И &Проведен
	|	И &Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыРазрешенийНаЗаменуМатериалов.Утверждено)
	|	И &ВариантЗамены = ЗНАЧЕНИЕ(Перечисление.ВариантЗаменыАналогов.НаборНаНабор)";
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса,
		"&ТекстЗапросаКоэффициентУпаковкиМатериал",
		Справочники.УпаковкиЕдиницыИзмерения.ТекстЗапросаКоэффициентаУпаковки(
		"Материалы.Упаковка",
		"Материалы.Номенклатура"));
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса,
		"&ТекстЗапросаКоэффициентУпаковкиАналог",
		Справочники.УпаковкиЕдиницыИзмерения.ТекстЗапросаКоэффициентаУпаковки(
		"Аналоги.Упаковка",
		"Аналоги.Номенклатура"));
	
	ТекстыЗапроса.Добавить(ТекстЗапроса, ИмяРегистра);
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ТекстЗапросаОбластиДействияАналоговМатериалов(Запрос, ТекстыЗапроса, Регистры)

	ИмяРегистра = "ОбластиДействияАналоговМатериалов";
	
	Если НЕ ПроведениеДокументов.ТребуетсяТаблицаДляДвижений(ИмяРегистра, Регистры) Тогда
		Возврат "";
	КонецЕсли; 
	
	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ОбластиДействия.Ссылка КАК Разрешение,
	|	ОбластиДействия.НаправлениеДеятельности КАК НаправлениеДеятельности,
	|	ОбластиДействия.Подразделение КАК Подразделение,
	|	ОбластиДействия.Изделие КАК Изделие,
	|	ОбластиДействия.ХарактеристикаИзделия КАК ХарактеристикаИзделия,
	|	ОбластиДействия.ЗаказНаПроизводство КАК ЗаказНаПроизводство,
	|	ОбластиДействия.Спецификация КАК Спецификация,
	|	ОбластиДействия.Этап КАК Этап,
	|	ОбластиДействия.ЗаказКлиента КАК ЗаказКлиента
	|ИЗ
	|	Документ.РазрешениеНаЗаменуМатериалов.ОбластиДействия КАК ОбластиДействия
	|ГДЕ
	|	ОбластиДействия.Ссылка = &Ссылка
	|	И &Проведен
	|	И &Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыРазрешенийНаЗаменуМатериалов.Утверждено)";
	
	ТекстыЗапроса.Добавить(ТекстЗапроса, ИмяРегистра);
	
	Возврат ТекстЗапроса;
	
КонецФункции

#КонецОбласти

#Область Прочее

#Область ПомощникВыполненияЗамен

Функция ДоступенПомощникВыполненияЗамен() Экспорт
	
	ИспользоватьУправлениеПроизводством2_2 = Истина;
	
	//++ Устарело_Производство21
	ИспользоватьУправлениеПроизводством2_2 = ПолучитьФункциональнуюОпцию("ИспользоватьУправлениеПроизводством2_2");
	//-- Устарело_Производство21
	
	Возврат ИспользоватьУправлениеПроизводством2_2;
	
КонецФункции

Процедура ДанныеЭтаповДляЗамены(Параметры, АдресХранилища) Экспорт

	ИмяОперации = "Документ.РазрешениеНаЗаменуМатериалов.МодульМенеджера.ДанныеЭтаповДляЗамены";
	ОписаниеЗамера = ОценкаПроизводительности.НачатьЗамерДлительнойОперации(ИмяОперации);
	
	ДанныеДокументов = ДанныеЭтаповПроизводстваДляПодбораАналогов(Параметры);
	
	ПоместитьВоВременноеХранилище(ДанныеДокументов, АдресХранилища);
	
	ОценкаПроизводительности.ЗакончитьЗамерДлительнойОперации(ОписаниеЗамера, ДанныеДокументов.Этапы.Количество());
	
КонецПроцедуры

Функция ДанныеЭтаповПроизводстваДляПодбораАналогов(Параметры)
	
	Если ЗначениеЗаполнено(Параметры.Этап) Тогда
	
		Возврат ДанныеПомощникаПриВызовеИзДокумента(Параметры);
	
	КонецЕсли;
	
	РольАналогов = Параметры.РольАналогов;
	Разрешение = Параметры.Разрешение;
	Этапы = Параметры.Этапы;
	ПриоритетЗамены = Параметры.ПриоритетЗамены;
	ПодборВзаимозаменяемыхАналогов = (РольАналогов = Перечисления.РолиАналогов.ВзаимозаменяемыйАналог);
	
	ТекстЗапроса = Документы.РазрешениеНаЗаменуМатериалов.ТекстЗапросаЗаполненияПомощникаВыполненияЗамен(РольАналогов);
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Разрешение", Разрешение);
	Запрос.УстановитьПараметр("Период", НачалоДня(ТекущаяДатаСеанса()));
	
	МассивРезультатов = Запрос.ВыполнитьПакет();
	РезультатДокументы = МассивРезультатов[МассивРезультатов.ВГраница()];
	РезультатНормативы = МассивРезультатов[МассивРезультатов.ВГраница() - 1];
	РезультатУпаковки = МассивРезультатов[МассивРезультатов.ВГраница() - 2];
	
	ТаблицаНормативов = РезультатНормативы.Выгрузить();
	ТаблицаДанныеУпаковок = РезультатУпаковки.Выгрузить();
	
	УправлениеДаннымиОбИзделиях.ЗаполнитьДанныеУпаковокВНабореДанных(ТаблицаНормативов, ТаблицаДанныеУпаковок);
	
	ТаблицаМатериаловШаблон = ТаблицаНормативов.Скопировать(Новый Структура("ЭтоМатериал", Истина), "Номенклатура, Характеристика");
	ТекущиеМатериалы = ТаблицаМатериаловШаблон;
	ТекущийКлюч = 0;
	УдалитьПозицию = Ложь;
	МассивДобавленныхСтрок = Новый Массив;
	
	Выборка = РезультатДокументы.Выбрать();
	
	ТекущееЗначениеОбособленно = Неопределено;
	ТекущийСклад = Неопределено;
	ТекущийЭтап = Неопределено;
	ТекущееНазначение = Неопределено;
	ОбособленныйНабор = Ложь;
	СтруктураПоискаМатериалов = Новый Структура("Номенклатура, Характеристика");
	
	Пока Выборка.Следующий() Цикл
		
		ИзменилисьКлючевыеПоля = ?(ПодборВзаимозаменяемыхАналогов, Истина, 
			Выборка.Этап <> ТекущийЭтап
			ИЛИ Выборка.Склад <> ТекущийСклад 
			ИЛИ Выборка.Назначение <> ТекущееНазначение 
			ИЛИ Выборка.Обособленно <> ТекущееЗначениеОбособленно);
		
		Если ИзменилисьКлючевыеПоля Тогда
			
			Если ТекущиеМатериалы.Количество() > 0 Тогда
				УдалитьПозицию = Истина;
			КонецЕсли;
			
			Если УдалитьПозицию Тогда
				ОбщегоНазначенияУТ.УдалитьСтрокиТаблицы(Этапы, МассивДобавленныхСтрок);
			Иначе
				ПроверитьУстановитьКлюч(ТекущиеМатериалы, МассивДобавленныхСтрок, ТекущийКлюч, ОбособленныйНабор);
			КонецЕсли;
			
			УдалитьПозицию = Ложь;
			МассивДобавленныхСтрок.Очистить();
			ТекущийКлюч = ТекущийКлюч + 1;
			ТекущиеМатериалы = ТаблицаМатериаловШаблон.Скопировать();
			ТекущийЭтап = Выборка.Этап;
			ТекущееНазначение = Выборка.Назначение;
			ТекущееЗначениеОбособленно = Выборка.Обособленно;
		
		КонецЕсли;
		
		СтрокаТЧ = Этапы.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаТЧ, Выборка);
		УправлениеДаннымиОбИзделиях.ЗаполнитьДанныеУпаковокВСтрокеНабораДанных(СтрокаТЧ, ТаблицаДанныеУпаковок);
		
		СтрокаТЧ.ХарактеристикиИспользуются = ЗначениеЗаполнено(СтрокаТЧ.Характеристика);
		
		СтрокаТЧ.ПредставлениеЗаказа = СтрШаблон(НСтр("ru = '№%1 от %2 (%3)';
														|en = 'No.%1 dated %2 (%3)'"),
			СтрокаТЧ.НомерЗаказа,
			Формат(СтрокаТЧ.ДатаЗаказа, "ДЛФ=D"),
			СтрокаТЧ.ПредставлениеЭтапа);
			
		Если СтрокаТЧ.Обособленно Тогда
			ОбособленныйНабор = Истина;
		КонецЕсли;
		
		Если СтрокаТЧ.Всего = СтрокаТЧ.Отгружено Тогда
			УдалитьПозицию = Истина;
		КонецЕсли;
		
		МассивДобавленныхСтрок.Добавить(СтрокаТЧ);
		ЗаполнитьЗначенияСвойств(СтруктураПоискаМатериалов, Выборка);
		Строки = ТекущиеМатериалы.НайтиСтроки(СтруктураПоискаМатериалов);
		ОбщегоНазначенияУТ.УдалитьСтрокиТаблицы(ТекущиеМатериалы, Строки);
	
	КонецЦикла;
	
	Если ТекущиеМатериалы.Количество() > 0 Тогда
		УдалитьПозицию = Истина;
	КонецЕсли;
	
	Если УдалитьПозицию Тогда
		ОбщегоНазначенияУТ.УдалитьСтрокиТаблицы(Этапы, МассивДобавленныхСтрок);
	Иначе
		ПроверитьУстановитьКлюч(ТекущиеМатериалы, МассивДобавленныхСтрок, ТекущийКлюч, ОбособленныйНабор);	
	КонецЕсли;
	
	Возврат Новый Структура("Этапы, Нормативы", Этапы, ТаблицаНормативов);
	
КонецФункции

Функция ДанныеПомощникаПриВызовеИзДокумента(Параметры)
	
	Этап = Параметры.Этап;
	Аналоги = Параметры.Аналоги;
	
	ТаблицаИзДокумента = Параметры.ТоварыИзДокумента;
	ТаблицаЗапасов = Параметры.ТаблицаЗапасов;
	ПрименитьТаблицуЗапасов = ТаблицаЗапасов <> Неопределено;
	
	Если ТипЗнч(Этап) = Тип("ДокументСсылка.ЭтапПроизводства2_2") Тогда
		ОписаниеТипа = Новый ОписаниеТипов("ДокументСсылка.ЭтапПроизводства2_2");
	ИначеЕсли ТипЗнч(Этап) = Тип("ДокументСсылка.ЗаказМатериаловВПроизводство") Тогда
		ОписаниеТипа = Новый ОписаниеТипов("ДокументСсылка.ЗаказМатериаловВПроизводство");
	Иначе
		ОписаниеТипа = ОбщегоНазначения.ОписаниеТипаЧисло(10);
	КонецЕсли;

	ПараметрыВыбора = АналогиМатериалов.ПараметрыВыбораАналогов(ОписаниеТипа);
		
	ТаблицаПараметров = ПараметрыВыбора.ПараметрыАналогов.ТаблицаПараметров;
	
	Для каждого Строка Из ТаблицаИзДокумента Цикл
		
		СтрокаТаблицы = ТаблицаПараметров.Добавить();
		СтрокаТаблицы.ДатаДействияРазрешений = НачалоДня(ТекущаяДатаСеанса());
		СтрокаТаблицы.Ссылка = Строка.Этап;
		СтрокаТаблицы.Подразделение = Строка.Подразделение;
		СтрокаТаблицы.НаправлениеДеятельности = Строка.НаправлениеДеятельности;
		СтрокаТаблицы.ЗаказНаПроизводство = Строка.ЗаказНаПроизводство;
		СтрокаТаблицы.Спецификация = Строка.Спецификация;
		СтрокаТаблицы.Этап = Строка.ЭтапРесурснойСпецификации;
		СтрокаТаблицы.Изделие = Строка.Изделие;
		СтрокаТаблицы.ХарактеристикаИзделия = Строка.ХарактеристикаИзделия;
		
	КонецЦикла;
		
	ТекстЗапроса = ТекстЗапросаРазрешенияПоДокументу(ПрименитьТаблицуЗапасов);
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("Товары", ТаблицаИзДокумента);
	Запрос.УстановитьПараметр("ТаблицаПараметров", ТаблицаПараметров);
	Запрос.УстановитьПараметр("ТаблицаПоиска", ТаблицаИзДокумента);
	
	Если ПрименитьТаблицуЗапасов Тогда
		Запрос.УстановитьПараметр("Запасы", ТаблицаЗапасов);
	КонецЕсли;
	
	МассивРезультатов = Запрос.ВыполнитьПакет();
	ТаблицаОстаткиАналогов = МассивРезультатов[МассивРезультатов.ВГраница() - 2].Выгрузить();
	ВыборкаАналоги = МассивРезультатов[МассивРезультатов.ВГраница() - 1].Выбрать();
	ТаблицаДанныеУпаковок = МассивРезультатов[МассивРезультатов.ВГраница()].Выгрузить();
	
	ТекущееРазрешение = Неопределено;	
	ШаблонПредставление = НСтр("ru = '%1 %2 %3 %4';
								|en = '%1 %2 %3 %4'");
	
	Пока ВыборкаАналоги.Следующий() Цикл
	
		НоваяСтрока = Аналоги.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ВыборкаАналоги);
		
		НоваяСтрока.ХарактеристикиИспользуются = ЗначениеЗаполнено(НоваяСтрока.Характеристика);
		
		УправлениеДаннымиОбИзделиях.ЗаполнитьДанныеУпаковокВСтрокеНабораДанных(НоваяСтрока, ТаблицаДанныеУпаковок);
		
		Если (ТекущееРазрешение <> ВыборкаАналоги.Разрешение
		   И ВыборкаАналоги.ЭтоАналог)
		 ИЛИ ВыборкаАналоги.ВзаимозаменяемыйАналог Тогда
		
			ТекущееРазрешение = ВыборкаАналоги.Разрешение;
			НоваяСтрока.РазрешениеПредставление = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				ШаблонПредставление, "№", ВыборкаАналоги.Номер, НСтр("ru = 'от';
																	|en = 'dated'"), Формат(ВыборкаАналоги.Дата, "ДЛФ=D"));
		
		КонецЕсли;
			
	КонецЦикла;
	
	Возврат Новый Структура("Этапы, ОстаткиАналогов, Аналоги", ТаблицаИзДокумента, ТаблицаОстаткиАналогов, Аналоги);

КонецФункции

Процедура ПроверитьУстановитьКлюч(ТекущиеМатериалы, МассивДобавленныхСтрок, ТекущийКлюч, ОбособленныйНабор)

	Если ТекущиеМатериалы.Количество() = 0 Тогда
				
		Для каждого ДобавленнаяСтрока Из МассивДобавленныхСтрок Цикл
			ДобавленнаяСтрока.КлючСвязи = ТекущийКлюч;
			ДобавленнаяСтрока.ОбособленныйНабор = ОбособленныйНабор;
		КонецЦикла;
		
	КонецЕсли;
	
	ОбособленныйНабор = Ложь;

КонецПроцедуры

Функция ТекстЗапросаРазрешенияПоДокументу(ПрименитьТаблицуЗапасов = Ложь)
	
	СоответствиеПолей = Новый Соответствие;
	
	НастройкиПодбора = Новый Структура;
	НастройкиПодбора.Вставить("ТоварыВместеСПараметрами", Ложь);
	НастройкиПодбора.Вставить("УчестьМногиеКоМногим", Истина);
	НастройкиПодбора.Вставить("ПодбиратьВзаимозаменяемыеАналоги", Истина);
	НастройкиПодбора.Вставить("ОтборРазрешений", СоответствиеПолей);
	НастройкиПодбора.Вставить("ИмяВременнойТаблицы", "СвязиМатериаловИАналогов");
	
	ТекстЗапросаАналогиМатериалов = АналогиМатериалов.ТекстЗапросаДанныеМатериаловИАналогов(НастройкиПодбора);
	
	Если ПрименитьТаблицуЗапасов Тогда
		
		ТекстЗапросаТаблицаЗапасов = 
		"ВЫБРАТЬ
		|	ТаблицаЗапасов.Номенклатура КАК Номенклатура,
		|	ТаблицаЗапасов.Характеристика КАК Характеристика,
		|	ТаблицаЗапасов.Склад КАК Склад,
		|	ТаблицаЗапасов.Назначение КАК Назначение,
		|	ТаблицаЗапасов.Свободно КАК Количество
		|ПОМЕСТИТЬ ЗапасыПереданная
		|ИЗ
		|	&Запасы КАК ТаблицаЗапасов
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Номенклатура,
		|	Характеристика,
		|	Склад
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Запасы.Номенклатура КАК Номенклатура,
		|	Запасы.Характеристика КАК Характеристика,
		|	Запасы.Склад КАК Склад,
		|	Запасы.Назначение КАК Назначение,
		|	СУММА(Запасы.Количество) КАК Количество
		|ПОМЕСТИТЬ ТаблицаЗапасов
		|ИЗ
		|	ЗапасыПереданная КАК Запасы
		|
		|СГРУППИРОВАТЬ ПО
		|	Запасы.Номенклатура,
		|	Запасы.Характеристика,
		|	Запасы.Склад,
		|	Запасы.Назначение
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Номенклатура,
		|	Характеристика,
		|	Склад,
		|	Назначение";
		
	Иначе
		
		ТекстЗапросаТаблицаЗапасов =
		"ВЫБРАТЬ ПЕРВЫЕ 0
		|	ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка) КАК Номенклатура,
		|	ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка) КАК Характеристика,
		|	ЗНАЧЕНИЕ(Справочник.Склады.ПустаяСсылка) КАК Склад,
		|	ЗНАЧЕНИЕ(Справочник.Назначения.ПустаяСсылка) КАК Назначение,
		|	0 КАК Количество
		|ПОМЕСТИТЬ ЗапасыПереданная
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ ПЕРВЫЕ 0
		|	ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка) КАК Номенклатура,
		|	ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка) КАК Характеристика,
		|	ЗНАЧЕНИЕ(Справочник.Склады.ПустаяСсылка) КАК Склад,
		|	ЗНАЧЕНИЕ(Справочник.Назначения.ПустаяСсылка) КАК Назначение,
		|	0 КАК Количество
		|ПОМЕСТИТЬ ТаблицаЗапасов";
		
	КонецЕсли;
	
	ТекстЗапросаЗаполнения = "ВЫБРАТЬ
	|	ТаблицаПоиска.Назначение КАК Назначение,
	|	ТаблицаПоиска.Склад КАК Склад
	|ПОМЕСТИТЬ ТаблицаПоиска
	|ИЗ
	|	&ТаблицаПоиска КАК ТаблицаПоиска
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Назначение,
	|	Склад
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Запасы.Номенклатура КАК Номенклатура,
	|	Запасы.Характеристика КАК Характеристика,
	|	Запасы.Склад КАК Склад,
	|	Запасы.Назначение КАК Назначение,
	|	Запасы.ВНаличииОстаток КАК ВНаличииОстаток,
	|	Запасы.ЗаблокированоВНаличииОстаток КАК ЗаблокированоВНаличииОстаток,
	|	Запасы.ЗаказаноОстаток КАК ЗаказаноОстаток,
	|	Запасы.ПоступитОстаток КАК ПоступитОстаток,
	|	Запасы.ЗаблокированоПоступитОстаток КАК ЗаблокированоПоступитОстаток,
	|	Запасы.РезервироватьНаСкладеОстаток КАК РезервироватьНаСкладеОстаток,
	|	Запасы.РезервироватьПоМереПоступленияОстаток КАК РезервироватьПоМереПоступленияОстаток,
	|	Запасы.ОтложитьРезервированиеОстаток КАК ОтложитьРезервированиеОстаток,
	|	Запасы.КОбеспечениюОстаток КАК КОбеспечениюОстаток,
	|	Запасы.НеОбеспечиватьОстаток КАК НеОбеспечиватьОстаток
	|ПОМЕСТИТЬ ЗапасыИПотребностиОстатки
	|ИЗ
	|	РегистрНакопления.ЗапасыИПотребности.Остатки(
	|			,
	|			(Номенклатура, Характеристика) В
	|					(ВЫБРАТЬ
	|						СвязиМатериаловИАналогов.Номенклатура КАК Номенклатура,
	|						СвязиМатериаловИАналогов.Характеристика КАК Характеристика
	|					ИЗ
	|						СвязиМатериаловИАналогов КАК СвязиМатериаловИАналогов
	|					ГДЕ
	|						СвязиМатериаловИАналогов.ЭтоАналог)
	|				И (Склад, Назначение) В
	|					(ВЫБРАТЬ
	|						ТаблицаПоиска.Склад КАК Склад,
	|						ТаблицаПоиска.Назначение КАК Назначение
	|					ИЗ
	|						ТаблицаПоиска КАК ТаблицаПоиска
	|			
	|					ОБЪЕДИНИТЬ ВСЕ
	|			
	|					ВЫБРАТЬ
	|						ТаблицаПоиска.Склад КАК Склад,
	|						ЗНАЧЕНИЕ(Справочник.Назначения.ПустаяСсылка) КАК Назначение
	|					ИЗ
	|						ТаблицаПоиска КАК ТаблицаПоиска)) КАК Запасы
	|ИНДЕКСИРОВАТЬ ПО
	|	Номенклатура, Характеристика, Назначение, Склад
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Расчет.Номенклатура КАК Номенклатура,
	|	Расчет.Характеристика КАК Характеристика,
	|	Расчет.Склад КАК Склад,
	|	Расчет.Назначение КАК Назначение,
	|	ЕСТЬNULL(ТаблицаЗапасов.Количество, Расчет.КоличествоДляДействияОтгрузить) КАК Свободно
	|ИЗ
	|	РасчетОстатковДляУстановкиДействий КАК Расчет
	|		ЛЕВОЕ СОЕДИНЕНИЕ ТаблицаЗапасов КАК ТаблицаЗапасов
	|		ПО Расчет.Номенклатура = ТаблицаЗапасов.Номенклатура
	|		 И Расчет.Характеристика = ТаблицаЗапасов.Характеристика
	|		 И Расчет.Склад = ТаблицаЗапасов.Склад
	|		 И Расчет.Назначение = ТаблицаЗапасов.Назначение
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СвязиМатериаловИАналогов.Разрешение КАК Разрешение,
	|	СвязиМатериаловИАналогов.Период КАК Период,
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(СвязиМатериаловИАналогов.Разрешение) = ТИП(Документ.РазрешениеНаЗаменуМатериалов)
	|			ТОГДА ВЫРАЗИТЬ(СвязиМатериаловИАналогов.Разрешение КАК Документ.РазрешениеНаЗаменуМатериалов).Номер
	|		КОГДА ТИПЗНАЧЕНИЯ(СвязиМатериаловИАналогов.Разрешение) = ТИП(Документ.КорректировкаРегистров)
	|			ТОГДА ВЫРАЗИТЬ(СвязиМатериаловИАналогов.Разрешение КАК Документ.КорректировкаРегистров).Номер
	|	КОНЕЦ КАК Номер,
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(СвязиМатериаловИАналогов.Разрешение) = ТИП(Документ.РазрешениеНаЗаменуМатериалов)
	|			ТОГДА ВЫРАЗИТЬ(СвязиМатериаловИАналогов.Разрешение КАК Документ.РазрешениеНаЗаменуМатериалов).Дата
	|		КОГДА ТИПЗНАЧЕНИЯ(СвязиМатериаловИАналогов.Разрешение) = ТИП(Документ.КорректировкаРегистров)
	|			ТОГДА ВЫРАЗИТЬ(СвязиМатериаловИАналогов.Разрешение КАК Документ.КорректировкаРегистров).Дата
	|	КОНЕЦ КАК Дата,
	|	СвязиМатериаловИАналогов.НомерСтроки КАК НомерСтроки,
	|	СвязиМатериаловИАналогов.Номенклатура КАК Номенклатура,
	|	СвязиМатериаловИАналогов.Номенклатура.ЕдиницаИзмерения.ТипИзмеряемойВеличины = ЗНАЧЕНИЕ(Перечисление.ТипыИзмеряемыхВеличин.КоличествоШтук) КАК КонтролироватьКратность,
	|	СвязиМатериаловИАналогов.Номенклатура.Представление КАК НоменклатураПредставление,
	|	СвязиМатериаловИАналогов.Характеристика.Представление КАК ХарактеристикаПредставление,
	|	СвязиМатериаловИАналогов.Номенклатура.ЕдиницаИзмерения.Представление КАК ЕдиницаИзмеренияПредставление,
	|	СвязиМатериаловИАналогов.Характеристика КАК Характеристика,
	|	СвязиМатериаловИАналогов.РольНоменклатуры КАК РольНоменклатуры,
	|	СвязиМатериаловИАналогов.РольНоменклатуры = ЗНАЧЕНИЕ(Перечисление.РолиАналогов.ВзаимозаменяемыйАналог) КАК ВзаимозаменяемыйАналог,
	|	СвязиМатериаловИАналогов.ПриоритетЗамены КАК ПриоритетЗамены,
	|	СвязиМатериаловИАналогов.Упаковка КАК Упаковка,
	|	СвязиМатериаловИАналогов.КоличествоУпаковок КАК Норматив,
	|	НЕОПРЕДЕЛЕНО КАК ДанныеУпаковки,
	|	СвязиМатериаловИАналогов.МаксимальныйПриоритетОбластиДействия КАК МаксимальныйПриоритетОбластиДействия,
	|	СвязиМатериаловИАналогов.ИспользоватьПриАвтозаменеВЗаказах КАК ИспользоватьПриАвтозаменеВЗаказах,
	|	СвязиМатериаловИАналогов.Ссылка КАК Ссылка,
	|	СвязиМатериаловИАналогов.МногиеКоМногим КАК МногиеКоМногим,
	|	СвязиМатериаловИАналогов.КлючСвязи КАК КлючСвязи,
	|	СвязиМатериаловИАналогов.ЭтоАналог КАК ЭтоАналог,
	|	ВЫБОР
	|		КОГДА СвязиМатериаловИАналогов.ПриоритетЗамены = ЗНАЧЕНИЕ(Перечисление.ПравилаЗаменыНаАналоги.ПриНаличииАналога)
	|			ТОГДА 1
	|		КОГДА СвязиМатериаловИАналогов.ПриоритетЗамены = ЗНАЧЕНИЕ(Перечисление.ПравилаЗаменыНаАналоги.ПриОтсутствииМатериала)
	|			ТОГДА 2
	|		ИНАЧЕ 10
	|	КОНЕЦ КАК ПриоритетЗаменыЧислом
	|ИЗ
	|	СвязиМатериаловИАналогов КАК СвязиМатериаловИАналогов
	|
	|УПОРЯДОЧИТЬ ПО
	|	ПриоритетЗаменыЧислом,
	|	МаксимальныйПриоритетОбластиДействия УБЫВ,
	|	Период УБЫВ,
	|	Разрешение УБЫВ,
	|	НомерСтроки";
	ИменаТаблиц = ОбеспечениеВДокументахСервер.НовыеИменаТаблицДляРасчетаОстатковДляУстановкиДействий();
	ИменаТаблиц.Остатки = "ЗапасыИПотребностиОстатки"; // @query-part-1
	ИменаТаблиц.Результат = "РасчетОстатковДляУстановкиДействий"; // @query-part-1
	ОбеспечениеВДокументахСервер.РасчетОстатковДляУстановкиДействий(ТекстЗапросаЗаполнения, ИменаТаблиц, Ложь, Ложь);
	
	ТекстЗапросаЗаполнения = СтрЗаменить(ТекстЗапросаЗаполнения, "&ТекстКоэффициентУпаковки",
		Справочники.УпаковкиЕдиницыИзмерения.ТекстЗапросаКоэффициентаУпаковки(
			"СвязиМатериаловИАналогов.Упаковка",
			"СвязиМатериаловИАналогов.Номенклатура"));
	
	ИменаТаблиц = Новый Массив;
	ИменаТаблиц.Добавить("СвязиМатериаловИАналогов");
		
	ТекстЗапросаДанныеУпаковки = УправлениеДаннымиОбИзделиях.ТекстЗапросаДанныеУпаковок(ИменаТаблиц);
	
	МассивТекстов = Новый Массив; // Массив Из Строка
	МассивТекстов.Добавить(ТекстЗапросаАналогиМатериалов);
	МассивТекстов.Добавить(ТекстЗапросаТаблицаЗапасов);
	МассивТекстов.Добавить(ТекстЗапросаЗаполнения);
	МассивТекстов.Добавить(ТекстЗапросаДанныеУпаковки);
	
	Возврат СтрСоединить(МассивТекстов, ОбщегоНазначения.РазделительПакетаЗапросов());

КонецФункции

// Возвращает текст запроса для помощника выполнения замен на аналоги.
//
// Параметры:
//  РольАналогов - ПеречислениеСсылка.РолиАналогов -
//
// Возвращаемое значение:
//	Строка - текст запроса.
//
Функция ТекстЗапросаЗаполненияПомощникаВыполненияЗамен(РольАналогов) Экспорт
	
	Разделитель = ОбщегоНазначения.РазделительПакетаЗапросов();
	МассивТекстовЗапросов = Новый Массив;
	
	ТекстДанныеЭтапов = 
	"ВЫБРАТЬ
	|	АналогиМатериалов.Номенклатура КАК Номенклатура,
	|	АналогиМатериалов.Характеристика КАК Характеристика,
	|	АналогиМатериалов.Упаковка КАК Упаковка,
	|	АналогиМатериалов.Номенклатура.ЕдиницаИзмерения.ТипИзмеряемойВеличины = ЗНАЧЕНИЕ(Перечисление.ТипыИзмеряемыхВеличин.КоличествоШтук) КАК КонтролироватьКратность,
	|	АналогиМатериалов.РольНоменклатуры КАК РольНоменклатуры,
	|	АналогиМатериалов.КоличествоУпаковок КАК Норматив
	|ПОМЕСТИТЬ ТоварыРазрешения
	|ИЗ
	|	РегистрСведений.АналогиМатериалов КАК АналогиМатериалов
	|ГДЕ
	|	АналогиМатериалов.Регистратор = &Разрешение
	|	И АналогиМатериалов.Период <= &Период
	|	И (АналогиМатериалов.ПериодЗавершения = ДАТАВРЕМЯ(1, 1, 1)
	|			ИЛИ АналогиМатериалов.ПериодЗавершения >= &Период)
	|
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТоварыРазрешения.Номенклатура КАК Номенклатура,
	|	ТоварыРазрешения.Характеристика КАК Характеристика,
	|	ТоварыРазрешения.Упаковка КАК Упаковка,
	|	ТоварыРазрешения.КонтролироватьКратность КАК КонтролироватьКратность,
	|	ТоварыРазрешения.Норматив КАК Норматив
	|ПОМЕСТИТЬ МатериалыРазрешения
	|ИЗ
	|	ТоварыРазрешения КАК ТоварыРазрешения
	|ГДЕ
	|	ТоварыРазрешения.РольНоменклатуры В (ЗНАЧЕНИЕ(Перечисление.РолиАналогов.Материал), ЗНАЧЕНИЕ(Перечисление.РолиАналогов.ВзаимозаменяемыйАналог))
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Номенклатура,
	|	Характеристика
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ РАЗРЕШЕННЫЕ
	|	Таблица.ЗаказНаПроизводство КАК ЗаказНаПроизводство,
	|	Таблица.Этап КАК Этап
	|ПОМЕСТИТЬ АктивныеЭтапыИЗаказыПодготовка
	|ИЗ 
	|	(ВЫБРАТЬ
	|		СтруктураЗаказа.ЗаказНаПроизводство КАК ЗаказНаПроизводство,
	|		СтруктураЗаказа.Этап КАК Этап
	|	ИЗ
	|		РегистрСведений.СтруктураЗаказа КАК СтруктураЗаказа
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ МатериалыРазрешения КАК МатериалыРазрешения
	|			ПО СтруктураЗаказа.Номенклатура = МатериалыРазрешения.Номенклатура
	|				И СтруктураЗаказа.Характеристика = МатериалыРазрешения.Характеристика
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|	ВЫБРАТЬ
	|		ВЫРАЗИТЬ(РаспределениеЗапасов.ЗаказНаОтгрузку КАК Документ.ЭтапПроизводства2_2).Распоряжение КАК ЗаказНаПроизводство,
	|		РаспределениеЗапасов.ЗаказНаОтгрузку КАК Этап
	|ИЗ
	|		РегистрСведений.РаспределениеЗапасов КАК РаспределениеЗапасов
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ МатериалыРазрешения КАК МатериалыРазрешения
	|			ПО РаспределениеЗапасов.Номенклатура = МатериалыРазрешения.Номенклатура
	|				И РаспределениеЗапасов.Характеристика = МатериалыРазрешения.Характеристика
	|				И ТИПЗНАЧЕНИЯ(РаспределениеЗапасов.ЗаказНаОтгрузку) = ТИП(Документ.ЭтапПроизводства2_2)) КАК Таблица
	|
	|ИНДЕКСИРОВАТЬ ПО 	
	|	ЗаказНаПроизводство, Этап
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ РАЗРЕШЕННЫЕ
	|	Этапы.Ссылка КАК Этап,
	|	Этапы.Дата КАК ДатаЭтапа,
	|	Этапы.Подразделение КАК Подразделение,
	|	Этапы.НаправлениеДеятельности КАК НаправлениеДеятельности,
	|	Этапы.ПартияПроизводства.Спецификация КАК Спецификация,
	|	Этапы.Этап КАК ЭтапРесурснойСпецификации,
	|	Этапы.ПартияПроизводства.ОсновноеИзделиеНоменклатура КАК Изделие,
	|	Этапы.ПартияПроизводства.ОсновноеИзделиеХарактеристика КАК ХарактеристикаИзделия,
	|	Заказы.Ссылка КАК ЗаказНаПроизводство,
	|	Заказы.Дата КАК ДатаЗаказа,
	|	Заказы.Номер КАК НомерЗаказа
	|ПОМЕСТИТЬ АктивныеЭтапыИЗаказы
	|ИЗ
	|	Документ.ЭтапПроизводства2_2 КАК Этапы
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ АктивныеЭтапыИЗаказыПодготовка КАК АктивныеЭтапыИЗаказыПодготовка
	|		ПО Этапы.Распоряжение = АктивныеЭтапыИЗаказыПодготовка.ЗаказНаПроизводство
	|		И Этапы.Ссылка = АктивныеЭтапыИЗаказыПодготовка.Этап
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказНаПроизводство2_2 КАК Заказы
	|		ПО Этапы.Распоряжение = Заказы.Ссылка
	|ГДЕ
	|	Этапы.Проведен
	|	И НЕ Этапы.ПланированиеРабот
	|	И ИСТИНА В
	|			(ВЫБРАТЬ ПЕРВЫЕ 1
	|				ИСТИНА
	|			ИЗ
	|				РегистрСведений.ОбластиДействияАналоговМатериалов КАК ОбластиДействия
	|			ГДЕ
	|				ОбластиДействия.Разрешение = &Разрешение
	|				И ОбластиДействия.ЗаказНаПроизводство В (Заказы.Ссылка, ЗНАЧЕНИЕ(Документ.ЗаказНаПроизводство2_2.ПустаяСсылка),
	//++ Устарело_Производство21 
	|																		ЗНАЧЕНИЕ(Документ.ЗаказНаПроизводство.ПустаяСсылка),
	//-- Устарело_Производство21 
	|																		НЕОПРЕДЕЛЕНО)
	|				И ОбластиДействия.ЗаказКлиента = ЗНАЧЕНИЕ(Документ.ЗаказКлиента.ПустаяСсылка)
	|				И ОбластиДействия.Спецификация В (Этапы.ПартияПроизводства.Спецификация, ЗНАЧЕНИЕ(Справочник.РесурсныеСпецификации.ПустаяСсылка))
	|				И ОбластиДействия.Этап В (Этапы.Ссылка.Этап, ЗНАЧЕНИЕ(Справочник.ЭтапыПроизводства.ПустаяСсылка))
	|				И (ОбластиДействия.Изделие = Этапы.ПартияПроизводства.ОсновноеИзделиеНоменклатура
	|						И ОбластиДействия.ХарактеристикаИзделия В (Этапы.ПартияПроизводства.ОсновноеИзделиеХарактеристика, ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка))
	|					ИЛИ ОбластиДействия.Изделие = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|						И ОбластиДействия.ХарактеристикаИзделия = ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка))
	|				И ОбластиДействия.Подразделение В (Этапы.Подразделение, ЗНАЧЕНИЕ(Справочник.СтруктураПредприятия.ПустаяСсылка))
	|				И ОбластиДействия.НаправлениеДеятельности В (Этапы.НаправлениеДеятельности, ЗНАЧЕНИЕ(Справочник.НаправленияДеятельности.ПустаяСсылка)))
	|ИНДЕКСИРОВАТЬ ПО
	|
	|	Этап,
	|	ЗаказНаПроизводство;
	|
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЭтапПроизводства2_2ОбеспечениеМатериаламиИРаботами.Номенклатура КАК Номенклатура,
	|	ЭтапПроизводства2_2ОбеспечениеМатериаламиИРаботами.Характеристика КАК Характеристика,
	|	ВЫБОР
	|		КОГДА ЭтапПроизводства2_2ОбеспечениеМатериаламиИРаботами.ВариантОбеспечения <> ЗНАЧЕНИЕ(Перечисление.ВариантыОбеспечения.НеТребуется)
	|			ТОГДА ЭтапПроизводства2_2ОбеспечениеМатериаламиИРаботами.Количество
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК Всего,
	|	ВЫБОР
	|		КОГДА ЭтапПроизводства2_2ОбеспечениеМатериаламиИРаботами.ВариантОбеспечения = ЗНАЧЕНИЕ(Перечисление.ВариантыОбеспечения.Отгрузить)
	|			ТОГДА ЭтапПроизводства2_2ОбеспечениеМатериаламиИРаботами.Количество
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК Отгружено,
	|	ВЫБОР
	|		КОГДА ЭтапПроизводства2_2ОбеспечениеМатериаламиИРаботами.ВариантОбеспечения В (ЗНАЧЕНИЕ(Перечисление.ВариантыОбеспечения.СоСклада), ЗНАЧЕНИЕ(Перечисление.ВариантыОбеспечения.РезервироватьПоМереПоступления))
	|			ТОГДА ЭтапПроизводства2_2ОбеспечениеМатериаламиИРаботами.Количество
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК Зарезервировано,
	|	АктивныеЭтапыИЗаказы.Этап КАК Этап,
	|	АктивныеЭтапыИЗаказы.ЗаказНаПроизводство КАК ЗаказНаПроизводство,
	|	ЭтапПроизводства2_2ОбеспечениеМатериаламиИРаботами.Склад КАК Склад,
	|	ЭтапПроизводства2_2ОбеспечениеМатериаламиИРаботами.НазначениеОбеспечения КАК Назначение,
	|	ЭтапПроизводства2_2ОбеспечениеМатериаламиИРаботами.Обособленно КАК Обособленно
	|ПОМЕСТИТЬ ОбеспечениеМатериалами
	|ИЗ
	|	Документ.ЭтапПроизводства2_2.ОбеспечениеМатериаламиИРаботами КАК ЭтапПроизводства2_2ОбеспечениеМатериаламиИРаботами
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ АктивныеЭтапыИЗаказы КАК АктивныеЭтапыИЗаказы
	|		ПО ЭтапПроизводства2_2ОбеспечениеМатериаламиИРаботами.Ссылка = АктивныеЭтапыИЗаказы.Этап
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ МатериалыРазрешения КАК МатериалыРазрешения
	|		ПО ЭтапПроизводства2_2ОбеспечениеМатериаламиИРаботами.Номенклатура = МатериалыРазрешения.Номенклатура
	|			И ЭтапПроизводства2_2ОбеспечениеМатериаламиИРаботами.Характеристика = МатериалыРазрешения.Характеристика
	|ГДЕ
	|	НЕ ЭтапПроизводства2_2ОбеспечениеМатериаламиИРаботами.Отменено
	|
	|ИНДЕКСИРОВАТЬ ПО 
	|	
	|	Номенклатура,
	|	Характеристика,
	|	Этап
	|";
		
	МассивТекстовЗапросов.Добавить(ТекстДанныеЭтапов);
	МассивТекстовЗапросов.Добавить(Разделитель);
	
	Если РольАналогов = Перечисления.РолиАналогов.ВзаимозаменяемыйАналог Тогда
		
		ТекстМногиеКоМногим = "ВЫБРАТЬ ПЕРВЫЕ 0
		|	NULL КАК Номенклатура,
		|	NULL КАК Характеристика,
		|	NULL КАК Этап
		|ПОМЕСТИТЬ ВсеМатериалыСЭтапами
		|
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ ПЕРВЫЕ 0
