		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Этап";
		
	КонецЕсли;
	
	МассивТекстовЗапросов.Добавить(ТекстМногиеКоМногим);
	МассивТекстовЗапросов.Добавить(Разделитель);
	
	ИменаТаблиц = Новый Массив;
	ИменаТаблиц.Добавить("ТоварыРазрешения");
		
	ТекстЗапросаДанныеУпаковки = УправлениеДаннымиОбИзделиях.ТекстЗапросаДанныеУпаковок(ИменаТаблиц);
	
	МассивТекстовЗапросов.Добавить(ТекстЗапросаДанныеУпаковки);
	МассивТекстовЗапросов.Добавить(Разделитель);
	
	ТекстДанныеЗаполнения = 
	"ВЫБРАТЬ
