// Инициализирует структуру параметров формы ПомощникВыполненияЗамен
//
//
// Возвращаемое значение:
//  Структура - Параметры очистки реквизитов участников:
//	* ЗаменаОдинКОдному - Булево -
//	* Материал - СправочникСсылка.Номенклатура -
//	* ХарактеристикаМатериала - СправочникСсылка.ХарактеристикиНоменклатуры -
//	* Разрешение - ДокументСсылка.РазрешениеНаЗаменуМатериалов -
//	* ПриоритетЗамены - ПеречислениеСсылка.ПравилаЗаменыНаАналоги -
//	* РольАналогов - ПеречислениеСсылка.РолиАналогов -
//	* Этап - ДокументСсылка.ЭтапПроизводства2_2 -
//
Функция ПараметрыФормыПомощникаВыполненияЗамен() Экспорт

	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("ЗаменаОдинКОдному", Ложь);
	СтруктураПараметров.Вставить("Материал", Справочники.Номенклатура.ПустаяСсылка());
	СтруктураПараметров.Вставить("ХарактеристикаМатериала", Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка());
	СтруктураПараметров.Вставить("Разрешение", Документы.РазрешениеНаЗаменуМатериалов.ПустаяСсылка());
	СтруктураПараметров.Вставить("ПриоритетЗамены", Перечисления.ПравилаЗаменыНаАналоги.ПустаяСсылка());
	СтруктураПараметров.Вставить("РольАналогов", Перечисления.РолиАналогов.ПустаяСсылка());
	СтруктураПараметров.Вставить("Этап", Документы.ЭтапПроизводства2_2.ПустаяСсылка());
	
	Возврат СтруктураПараметров;

КонецФункции

Процедура ЗаменитьНаАналогиВЭтапахПроизводстваОтложенно(Параметры, АдресХранилища) Экспорт
	
	ИмяОперации = "Документ.РазрешениеНаЗаменуМатериалов.МодульМенеджера.ЗаменитьНаАналогиВЭтапахПроизводстваОтложенно";
	ОписаниеЗамера = ОценкаПроизводительности.НачатьЗамерДлительнойОперации(ИмяОперации);
	
	КоличествоДанных = ЗаменитьНаАналогиОтложенноВнутриЗамераВремени(Параметры, АдресХранилища);
	
	ОценкаПроизводительности.ЗакончитьЗамерДлительнойОперации(ОписаниеЗамера, КоличествоДанных);
	
КонецПроцедуры

Функция РезультатФормирования() Экспорт
	
	ИзмененныеОбъекты = Новый ТаблицаЗначений;
	ИзмененныеОбъекты.Колонки.Добавить("Документ", Новый ОписаниеТипов("ДокументСсылка.ЭтапПроизводства2_2"));
	ИзмененныеОбъекты.Колонки.Добавить("Распоряжение", Новый ОписаниеТипов("ДокументСсылка.ЗаказНаПроизводство2_2"));
	ИзмененныеОбъекты.Колонки.Добавить("Представление", Новый ОписаниеТипов("Строка"));
	
	Ошибки = Новый ТаблицаЗначений;
	Ошибки.Колонки.Добавить("Документ", Новый ОписаниеТипов("ДокументСсылка.ЭтапПроизводства2_2"));
	Ошибки.Колонки.Добавить("Представление", Новый ОписаниеТипов("Строка"));
	Ошибки.Колонки.Добавить("ТекстСообщения", Новый ОписаниеТипов("Строка"));
	
	Результат = Новый Структура;
	Результат.Вставить("ИзмененныеОбъекты", ИзмененныеОбъекты);
	Результат.Вставить("Ошибки", Ошибки);
	
	Возврат Результат;
	
КонецФункции

Функция ЗаменитьНаАналогиОтложенноВнутриЗамераВремени(Параметры, АдресХранилища)
	
	ЗаменитьНаАналогиВЭтапахПроизводства(Параметры, АдресХранилища);
	
	КоличествоДанных = 0;
	Результат = ПолучитьИзВременногоХранилища(АдресХранилища);
	Если ТипЗнч(Результат) = Тип("Структура")
		И ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Результат, "ИзмененныеОбъекты") Тогда
		КоличествоДанных = Результат.ИзмененныеОбъекты.Количество();
	КонецЕсли;
	
	Возврат КоличествоДанных;
	
КонецФункции

Процедура ЗаменитьНаАналогиВЭтапахПроизводства(Параметры, АдресХранилища)

	Результат = РезультатФормирования();
	
	РазмерПорции = 100;
	
	ТаблицаЭтаповДляОбработки = Параметры.ТаблицаЭтаповДляОбработки;
	ТаблицаАналогов = Параметры.ТаблицаАналогов;
	МассивСсылок = Параметры.МассивСсылок;
	
	Если МассивСсылок.Количество() <= РазмерПорции Тогда
		ЗаменитьНаАналогиВПорцииДокументов(ТаблицаЭтаповДляОбработки, ТаблицаАналогов, МассивСсылок, Результат, АдресХранилища);
	Иначе
		Счетчик = 1;
		МаксимальныйИндекс = МассивСсылок.Количество()-1;
		
		ТаблицаЭтаповКопия = ТаблицаЭтаповДляОбработки.СкопироватьКолонки();
		ТаблицаАналоговКопия = ТаблицаАналогов.СкопироватьКолонки();
		МассивСсылокКопия = Новый Массив;
		
		ТаблицаЭтаповДляОбработки.Индексы.Добавить("Ссылка");
		ТаблицаАналогов.Индексы.Добавить("Ссылка");
	
		СтруктураПоиска = Новый Структура("Ссылка");
		Индекс = 0;
		
		Для каждого ЭтапСсылка Из МассивСсылок Цикл
		
			СтруктураПоиска.Ссылка = ЭтапСсылка;
			Для каждого СтрокаЭтап Из ТаблицаЭтаповДляОбработки.НайтиСтроки(СтруктураПоиска) Цикл
				ЗаполнитьЗначенияСвойств(ТаблицаЭтаповКопия.Добавить(), СтрокаЭтап);
			КонецЦикла;
			Для каждого СтрокаАналог Из ТаблицаАналогов.НайтиСтроки(СтруктураПоиска) Цикл
				ЗаполнитьЗначенияСвойств(ТаблицаАналоговКопия.Добавить(), СтрокаАналог);
			КонецЦикла;
			
			МассивСсылокКопия.Добавить(ЭтапСсылка);
			
			Если Счетчик = РазмерПорции ИЛИ Индекс = МаксимальныйИндекс Тогда
				ЗаменитьНаАналогиВПорцииДокументов(ТаблицаЭтаповКопия, ТаблицаАналоговКопия, МассивСсылокКопия, Результат, АдресХранилища);
				
				ТаблицаЭтаповКопия.Очистить();
				ТаблицаАналоговКопия.Очистить();
				МассивСсылокКопия.Очистить();
				Счетчик = 1;
			Иначе
				Счетчик = Счетчик+1;
			КонецЕсли;
			
			Индекс = Индекс + 1;
		
		КонецЦикла;
	
	КонецЕсли;	

КонецПроцедуры

Процедура ЗаменитьНаАналогиВПорцииДокументов(ТаблицаЭтаповДляОбработки, ТаблицаАналогов, МассивСсылок, Результат, АдресХранилища)
	
	ИзмененныеОбъекты = Результат.ИзмененныеОбъекты;
	Ошибки = Результат.Ошибки;
	
	ТаблицаЭтаповДляОбработки.Индексы.Добавить("Ссылка");
	ТаблицаАналогов.Индексы.Добавить("Ссылка");
	
	СтруктураПоиска = Новый Структура("Ссылка");
	СтруктураПоискаСтроки = Новый Структура("Номенклатура, Характеристика, НазначениеОбеспечения");
	СтруктураПоискаСтроки.Вставить("Отменено", Ложь);
	ВариантОтгрузить = Перечисления.ВариантыОбеспечения.Отгрузить;
	ВариантКОбеспечению = Перечисления.ВариантыОбеспечения.КОбеспечению;
	
	ДанныеСтрокиМатериалов = Новый Структура("СтатьяКалькуляции");
	
	ИтерацииПоискаМатериалов = Новый Массив;
	ИтерацииПоискаМатериалов.Добавить(Новый Структура("ОтобратьКОбеспечению", Истина));
	ИтерацииПоискаМатериалов.Добавить(Новый Структура("ОтобратьКОбеспечению", Ложь));
	
	ШаблонОшибкиБлокировка = НСтр("ru = 'Не удалось заблокировать %1. %2';
									|en = 'Cannot block %1. %2'");
	ШаблонОшибкиЗаполнения = НСтр("ru = 'В документе %1 не удалось найти материалы для замены';
									|en = 'Cannot find materials for replacement in the %1 document'");
	ШаблонОшибкиЗаменаНаАналоги = НСтр("ru = 'В документе %1 не удалось выполнить замену на аналоги по причине: %2';
										|en = 'Cannot replace with substitutes in the %1 document due to: %2'");
	
	Если ТаблицаЭтаповДляОбработки.Количество() > 0 Тогда
	
		Для Каждого ЭтапСсылка Из МассивСсылок Цикл
			
			БлокировкаУстановлена = Ложь;
			
			НачатьТранзакцию();
			Попытка
			
				ЗаблокироватьДанныеДляРедактирования(ЭтапСсылка);
				
				БлокировкаУстановлена = Истина;
				
				СтруктураПоиска.Ссылка = ЭтапСсылка;
				СтрокиКЗамене = ТаблицаЭтаповДляОбработки.НайтиСтроки(СтруктураПоиска);
				
				СписокИндексов = Новый СписокЗначений;
				ОшибкаЗаполнения = Ложь;
				
				ЭтапОбъект = ЭтапСсылка.ПолучитьОбъект();
				
				ПараметрыЗаполненияНазначений = ОбеспечениеПроизводства.ПараметрыДействияЗаполнитьНазначениеОбеспеченияВЭтапеПроизводства(
					ЭтапОбъект, ЭтапОбъект.ВыходныеИзделия);
				
				Для каждого СтрокаТЗ Из СтрокиКЗамене Цикл
					
					ЗаполнитьЗначенияСвойств(СтруктураПоискаСтроки, СтрокаТЗ, "Номенклатура, Характеристика");
					СтруктураПоискаСтроки.НазначениеОбеспечения = СтрокаТЗ.Назначение;
					СтрокиДокумента = ЭтапОбъект.ОбеспечениеМатериаламиИРаботами.НайтиСтроки(СтруктураПоискаСтроки);
					КоличествоКЗамене = СтрокаТЗ.Количество;
					ПредставлениеЭтапа = СтрокаТЗ.Представление;
					
					Для каждого ИтерацияПоиска Из ИтерацииПоискаМатериалов Цикл
					
						Для каждого СтрокаДокумента Из СтрокиДокумента Цикл
					
							Если СтрокаДокумента.ВариантОбеспечения = ВариантОтгрузить Тогда
								Продолжить;
							КонецЕсли;
							
							Если ИтерацияПоиска.ОтобратьКОбеспечению
							   И СтрокаДокумента.ВариантОбеспечения <> ВариантКОбеспечению Тогда
							
								Продолжить;	
							
							КонецЕсли;
							
							Если КоличествоКЗамене = 0 Тогда
								Прервать;
							КонецЕсли;
							
							Если КоличествоКЗамене >= СтрокаДокумента.Количество Тогда
							
								КоличествоКЗамене = КоличествоКЗамене - СтрокаДокумента.Количество;
								СтрокаДокумента.Количество = 0;
								СписокИндексов.Добавить(СтрокаДокумента.НомерСтроки - 1);
								
							Иначе
								
								СтрокаДокумента.Количество = СтрокаДокумента.Количество - КоличествоКЗамене;
								СтрокаДокумента.КоличествоУпаковок = СтрокаДокумента.Количество;
								СтрокаДокумента.Упаковка = Справочники.УпаковкиЕдиницыИзмерения.ПустаяСсылка();
								
								КоличествоКЗамене = 0;
							
							КонецЕсли;
							
							ЗаполнитьЗначенияСвойств(ДанныеСтрокиМатериалов, СтрокаДокумента);
						
						КонецЦикла;	
					
					КонецЦикла;
					
					Если КоличествоКЗамене <> 0 Тогда
						
						ОшибкаЗаполнения = Истина;
						Прервать;
						
					КонецЕсли;
				
				КонецЦикла;
				
				Если ОшибкаЗаполнения Тогда
					
					СообщениеЗаполнение = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонОшибкиЗаполнения, ЭтапОбъект);
					
					Ошибка = Ошибки.Добавить();
					Ошибка.Документ = ЭтапСсылка;
					Ошибка.Представление = ПредставлениеЭтапа;
					Ошибка.ТекстСообщения = СообщениеЗаполнение;
					
				Иначе
					
					СтрокиДляОбработки = Новый Массив;
					СтрокиАналогов = ТаблицаАналогов.НайтиСтроки(СтруктураПоиска);
					Для каждого СтрокаАналог Из СтрокиАналогов Цикл
					
						НоваяСтрока = ЭтапОбъект.ОбеспечениеМатериаламиИРаботами.Добавить();
						
						НоваяСтрока.Подразделение = ЭтапОбъект.Подразделение;
						
						ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаАналог, "Номенклатура, Характеристика, Склад, Количество");
						ЗаполнитьЗначенияСвойств(НоваяСтрока, ДанныеСтрокиМатериалов);
						
						НоваяСтрока.НазначениеОбеспечения = СтрокаАналог.Назначение;
						НоваяСтрока.Обособленно = ЗначениеЗаполнено(СтрокаАналог.Назначение);
						НоваяСтрока.КоличествоУпаковок = НоваяСтрока.Количество;
						НоваяСтрока.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.КОбеспечению;
						НоваяСтрока.ДатаОтгрузки = ЭтапОбъект.ДатаОтгрузки;
						Если ЗначениеЗаполнено(НоваяСтрока.НазначениеОбеспечения) Тогда
							НоваяСтрока.Назначение = НоваяСтрока.НазначениеОбеспечения;
						Иначе
							
							СтруктураДействий = Новый Структура;
							СтруктураДействий.Вставить("ПроверитьЗаполнитьКлючСвязиСпецификации");
							СтруктураДействий.Вставить("ЗаполнитьНазначениеОбеспеченияВЭтапеПроизводства", ПараметрыЗаполненияНазначений);
							ПакетнаяОбработкаТабличнойЧастиСервер.ОбработатьСтрокуТЧ(НоваяСтрока, СтруктураДействий, Неопределено);
							
						КонецЕсли;
						
						СтрокиДляОбработки.Добавить(НоваяСтрока);
					
					КонецЦикла;
					
					СписокИндексов.СортироватьПоЗначению(НаправлениеСортировки.Убыв);
					
					Для каждого СтрокаСписка Из СписокИндексов Цикл
						
						ИндексСтроки = СтрокаСписка.Значение;
						СтрокаТЧ = ЭтапОбъект.ОбеспечениеМатериаламиИРаботами[ИндексСтроки];
						Если СтрокаТЧ.Количество = 0 Тогда
							Если ЗначениеЗаполнено(СтрокаТЧ.КлючСвязиНабор) Тогда
								УправлениеДаннымиОбИзделиях.СкорректироватьТаблицуНаборыМатериаловИРабот(
									ЭтапОбъект.НаборыМатериаловИРабот, СтрокаТЧ.КлючСвязиНабор, -1);
							КонецЕсли;
							ЭтапОбъект.ОбеспечениеМатериаламиИРаботами.Удалить(СтрокаТЧ);
						КонецЕсли;
					
					КонецЦикла;
					
					ПараметрыУстановкиДействий = Новый Структура;
					ПараметрыУстановкиДействий.Вставить("СнятьФлагОтгружатьОднойДатой", Ложь);
					ПараметрыУстановкиДействий.Вставить("ЗаполнитьДатуОтгрузкиОднойДатой", Истина);
					
					ПараметрыВстраивания = Документы.ЭтапПроизводства2_2.ДоступныеОстаткиПараметрыВстраивания(ЭтапОбъект);
					
					ОбеспечениеВДокументахСервер.ЗаполнитьВариантОбеспеченияПоОстаткамДляВыделенныхСтрокОбъекта(
						ЭтапОбъект,
						"ДЕЙСТВИЕ_РЕЗЕРВИРОВАТЬ",
						ПараметрыУстановкиДействий, СтрокиДляОбработки, ПараметрыВстраивания);
					
					НоменклатураСервер.ЗаполнитьСтатусыУказанияСерий(
						ЭтапОбъект,
						Документы.ЭтапПроизводства2_2.ПараметрыУказанияСерий(ЭтапОбъект).ОбеспечениеМатериаламиИРаботами);
					
					СтруктураЗаказаПроведениеДокументов.ЭтапПроизводстваПередЗаписью(
						ЭтапОбъект, ЭтапОбъект.ДополнительныеСвойства, Ложь);
			
					ЗаказыСервер.УстановитьКлючВСтрокахТабличнойЧасти(
						ЭтапОбъект, "ОбеспечениеМатериаламиИРаботами", "МаксимальныйКодСтрокиОбеспечение");
					
					ЭтапОбъект.Записать(РежимЗаписиДокумента.Проведение);
					
					СтрокаТаблицы = ИзмененныеОбъекты.Добавить();
					СтрокаТаблицы.Документ = ЭтапСсылка;
					СтрокаТаблицы.Представление = ПредставлениеЭтапа;
					СтрокаТаблицы.Распоряжение = ЭтапОбъект.Распоряжение;
					
				КонецЕсли;
				
				ЗафиксироватьТранзакцию();
			
			Исключение
				
				ОтменитьТранзакцию();
				
				Если ПустаяСтрока(ПредставлениеЭтапа) Тогда
					ПредставлениеЭтапа = Строка(ЭтапСсылка);
				КонецЕсли;
				
				Если БлокировкаУстановлена Тогда
					ТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
					ОшибкаВыполненияЗамены = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонОшибкиЗаменаНаАналоги, ЭтапСсылка, ТекстОшибки);
				Иначе
					ТекстОшибки = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
					ОшибкаВыполненияЗамены = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонОшибкиБлокировка, ЭтапСсылка, ТекстОшибки);
				КонецЕсли;
				
				Ошибка = Ошибки.Добавить();
				Ошибка.Документ = ЭтапСсылка;
				Ошибка.Представление = ПредставлениеЭтапа;
				Ошибка.ТекстСообщения = ОшибкаВыполненияЗамены;
				
				Продолжить;
				
			КонецПопытки;
		
		КонецЦикла;
	
	КонецЕсли;
	
	// Фиксация результата
	ПоместитьВоВременноеХранилище(Результат, АдресХранилища);

КонецПроцедуры

Функция РезультатАвтоматическогоЗаполненияПомощника() Экспорт

	СтруктураВозврата = Новый Структура;
	СтруктураВозврата.Вставить("ТаблицаЭтапов", Новый ТаблицаЗначений);
	СтруктураВозврата.Вставить("Дерево", Новый ДеревоЗначений);
	СтруктураВозврата.Вставить("ТаблицаОстатков", Новый ТаблицаЗначений);
	
	Возврат СтруктураВозврата;

КонецФункции

Процедура ЗаполнитьПомощникПоДоступностиОтложенно(Параметры, АдресХранилища) Экспорт

	ИмяОперации = "Документ.РазрешениеНаЗаменуМатериалов.МодульМенеджера.ЗаполнитьПомощникПоДоступностиОтложенно";
	ОписаниеЗамера = ОценкаПроизводительности.НачатьЗамерДлительнойОперации(ИмяОперации);
	
	КоличествоДанных = ЗаполнитьПомощникПоДоступности(Параметры.СтруктураДанныхФормы, АдресХранилища);
	
	ОценкаПроизводительности.ЗакончитьЗамерДлительнойОперации(ОписаниеЗамера, КоличествоДанных);

КонецПроцедуры

Функция ЗаполнитьПомощникПоДоступности(СтруктураДанныхФормы, АдресХранилища)
	
	Дерево = СтруктураДанныхФормы.Дерево;
	ТаблицаОстатков = СтруктураДанныхФормы.ОстаткиАналогов;
	ТаблицаЭтапов = СтруктураДанныхФормы.Этапы;
	Разрешение = СтруктураДанныхФормы.Разрешение;
	ПриоритетЗамены = СтруктураДанныхФормы.ПриоритетЗамены;
	СтруктураОтбора = СтруктураДанныхФормы.СтруктураОтбораЭтапов;
	
	ИменаКолонок = "
	|КлючСвязи,
	|Номенклатура,
	|Характеристика,
	|Назначение,
	|Обособленно,
	|Склад,
	|Подразделение,
	|НаправлениеДеятельности,
	|Этап,
	|ЗаказНаПроизводство,
	|Спецификация,
	|ЭтапРесурснойСпецификации,
	|Изделие,
	|ХарактеристикаИзделия,
	|Всего,
	|Отгружено,
	|Обеспечено";
	
	Если СтруктураОтбора.Количество() > 0 Тогда
		ТаблицаТоваров = СтруктураДанныхФормы.Этапы.Скопировать(СтруктураОтбора, ИменаКолонок);
	Иначе
		ТаблицаТоваров = СтруктураДанныхФормы.Этапы.Скопировать(, ИменаКолонок);
	КонецЕсли;
	
	ПараметрыВыбора = АналогиМатериалов.ПараметрыВыбораАналогов(
		ОбщегоНазначения.ОписаниеТипаЧисло(15));
		
	Отбор = Новый Соответствие();
	ОбщегоНазначенияУТ.ДобавитьЭлементОтбораВКоллекцию(Отбор, "АналогиМатериалов.Регистратор", "&Разрешение");
		
	ПараметрыВыбора.ПараметрыОбщие.ОтборРазрешений = Отбор;
	ПараметрыВыбора.ПараметрыОбщие.ПараметрыОтбораРазрешений.Вставить("Разрешение", Разрешение);
		
	ОбщегоНазначенияУТ.ПронумероватьТаблицуЗначений(ТаблицаТоваров, "НомерСтроки");
	
	ТаблицаТоваров.Колонки.Добавить("Ссылка", ОбщегоНазначения.ОписаниеТипаЧисло(15));
	ТаблицаТоваров.Колонки.Добавить("КоличествоВсего", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла));
	ТаблицаТоваров.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла));
	
	ЗаменаПриОтсутствииМатериала = (ПриоритетЗамены = Перечисления.ПравилаЗаменыНаАналоги.ПриОтсутствииМатериала);
	КоличествоДанных = ТаблицаТоваров.Количество();
	
	ТаблицаПараметров = ПараметрыВыбора.ПараметрыАналогов.ТаблицаПараметров;
	
	Для каждого Строка Из ТаблицаТоваров Цикл
		
		СтрокаТаблицы = ТаблицаПараметров.Добавить();
		СтрокаТаблицы.ДатаДействияРазрешений = НачалоДня(ТекущаяДатаСеанса());
		СтрокаТаблицы.Ссылка = Строка.КлючСвязи;
		СтрокаТаблицы.Подразделение = Строка.Подразделение;
		СтрокаТаблицы.НаправлениеДеятельности = Строка.НаправлениеДеятельности;
		СтрокаТаблицы.ЗаказНаПроизводство = Строка.ЗаказНаПроизводство;
		СтрокаТаблицы.Спецификация = Строка.Спецификация;
		СтрокаТаблицы.Этап = Строка.ЭтапРесурснойСпецификации;
		СтрокаТаблицы.Изделие = Строка.Изделие;
		СтрокаТаблицы.ХарактеристикаИзделия = Строка.ХарактеристикаИзделия;
		
		Строка.Ссылка = Строка.КлючСвязи;
		Если ЗаменаПриОтсутствииМатериала Тогда
			Строка.Количество = Строка.Всего - Строка.Обеспечено;
		Иначе
			Строка.Количество = Строка.Всего - Строка.Отгружено;
		КонецЕсли;
		Строка.КоличествоВсего = Строка.Количество;
		
	КонецЦикла;
		
	ПараметрыВыбора.ПараметрыТоваров.Товары = ПоместитьВоВременноеХранилище(ТаблицаТоваров);
	ПараметрыВыбора.ПараметрыАналогов.ТаблицаПараметров = ПоместитьВоВременноеХранилище(ТаблицаПараметров);
	
	ТаблицаЗаменНаАналоги = АналогиМатериалов.ПолучитьТаблицуЗамены(ПараметрыВыбора);
	
	ФлагМатериал = 1;
	ФлагАналог = 0;
	
	ПоискПоНомеруСтроки = Новый Структура("НомерСтроки");
	ПоискКлючСвязи = Новый Структура("КлючСвязи");
	СписокСвойств = "Номенклатура, Характеристика, ЭтоАналог";
	СтруктураКлючевыхПолей = Новый Структура("Номенклатура, Характеристика, Назначение, Ссылка");
	СтруктураПоискаТоваров = Новый Структура(СписокСвойств);
	
	ПоискИсходнойСтроки = Новый Структура("Номенклатура, Характеристика, КлючСвязи");
	ТаблицаОстатков.Индексы.Добавить("Номенклатура, Характеристика, Назначение, Склад");
	ТаблицаЭтапов.Индексы.Добавить("Номенклатура, Характеристика, КлючСвязи");
	ТаблицаЭтапов.Индексы.Добавить("КлючСвязи");
		
	Если ТаблицаЗаменНаАналоги <> Неопределено Тогда
		
		Товары = ТаблицаЗаменНаАналоги.Скопировать(, СписокСвойств);
		Товары.Свернуть(СписокСвойств);
		
		Для каждого СтрокаТЗ Из Товары Цикл
		
			НоваяСтрокаДерева = Дерево.Строки.Добавить();
			НоваяСтрокаДерева.Номенклатура = СтрокаТЗ.Номенклатура;
			НоваяСтрокаДерева.Характеристика = СтрокаТЗ.Характеристика;
			НоваяСтрокаДерева.ХарактеристикиИспользуются = ЗначениеЗаполнено(НоваяСтрокаДерева.Характеристика);
			
			ЗаполнитьЗначенияСвойств(СтруктураПоискаТоваров, СтрокаТЗ);
			МассивЗаменНаАналоги = ТаблицаЗаменНаАналоги.НайтиСтроки(СтруктураПоискаТоваров);
			
			Для каждого СтрокаТаблицыЗамены Из МассивЗаменНаАналоги Цикл
				
				Если СтруктураКлючевыхПолей.Номенклатура <> СтрокаТаблицыЗамены.Номенклатура
				 ИЛИ СтруктураКлючевыхПолей.Характеристика <> СтрокаТаблицыЗамены.Характеристика
				 ИЛИ СтруктураКлючевыхПолей.Назначение <> СтрокаТаблицыЗамены.Назначение
				 ИЛИ СтруктураКлючевыхПолей.Ссылка <> СтрокаТаблицыЗамены.Ссылка Тогда
				
					НоваяСтрока = НоваяСтрокаДерева.Строки.Добавить();
					ЗаполнитьЗначенияСвойств(СтруктураКлючевыхПолей, СтрокаТаблицыЗамены);
				
				КонецЕсли;
				
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицыЗамены, "Номенклатура, Характеристика, Назначение");
				НоваяСтрока.ХарактеристикиИспользуются = ЗначениеЗаполнено(НоваяСтрока.Характеристика);
				
				Если СтрокаТаблицыЗамены.ЭтоАналог Тогда
					
					ПоискКлючСвязи.КлючСвязи = СтрокаТаблицыЗамены.Ссылка;
					СтрокаЭтапа = ТаблицаЭтапов.НайтиСтроки(ПоискКлючСвязи)[0];
					
					НоваяСтрока.Склад = СтрокаТаблицыЗамены.Склад;
					НоваяСтрока.Флаг = ФлагАналог;
					НоваяСтрока.Количество = НоваяСтрока.Количество + СтрокаТаблицыЗамены.Количество;
					НоваяСтрокаДерева.Флаг = ФлагАналог;
					НоваяСтрокаДерева.Количество = НоваяСтрокаДерева.Количество + СтрокаТаблицыЗамены.Количество;
					
				Иначе
					
					ЗаполнитьЗначенияСвойств(ПоискИсходнойСтроки, СтрокаТаблицыЗамены, "Номенклатура, Характеристика");
					ПоискИсходнойСтроки.КлючСвязи = СтрокаТаблицыЗамены.Ссылка;
					
					СтрокаЭтапа = ТаблицаЭтапов.НайтиСтроки(ПоискИсходнойСтроки)[0];
					
					ПоискПоНомеруСтроки.НомерСтроки = СтрокаТаблицыЗамены.НомерСтроки;
					СтрокиТоваров = ТаблицаТоваров.НайтиСтроки(ПоискПоНомеруСтроки);
					КоличествоКВычитанию = СтрокиТоваров[0].Количество - СтрокаТаблицыЗамены.Количество;
					
					НоваяСтрока.Склад = СтрокаЭтапа.Склад;
					НоваяСтрока.Количество = НоваяСтрока.Количество + КоличествоКВычитанию;
					НоваяСтрока.Флаг = ФлагМатериал;
					
					НоваяСтрокаДерева.Количество = НоваяСтрокаДерева.Количество + КоличествоКВычитанию;
					НоваяСтрокаДерева.Флаг = ФлагМатериал;
					
					СтрокаЭтапа.КЗамене = КоличествоКВычитанию;
					СтрокаЭтапа.Выбран = СтрокаЭтапа.КЗамене > 0;
					СтрокаЭтапа.КЗаменеДоИзменения = КоличествоКВычитанию;
				
				КонецЕсли;
				
				НоваяСтрока.Этап = СтрокаЭтапа.Этап;
				НоваяСтрока.ПредставлениеЗаказа = СтрокаЭтапа.ПредставлениеЗаказа;
			
			КонецЦикла;
			
			Если НоваяСтрокаДерева.Флаг <> ФлагМатериал Тогда
			
				Для Каждого СтрокаРасшифровки Из НоваяСтрокаДерева.Строки Цикл
					ОтразитьИзменениеВТаблицеОстатков(ТаблицаОстатков, СтрокаРасшифровки);
				КонецЦикла;
				
			КонецЕсли;
		
		КонецЦикла;
	
	КонецЕсли;

	ОбновитьКолонкуДоступно(СтруктураДанныхФормы, ТаблицаЭтапов, ТаблицаОстатков);
	
	СтруктураВозврата = Новый Структура;
	СтруктураВозврата.Вставить("ТаблицаЭтапов", ТаблицаЭтапов);
	СтруктураВозврата.Вставить("Дерево", Дерево);
	СтруктураВозврата.Вставить("ТаблицаОстатков", ТаблицаОстатков);
	
	ПоместитьВоВременноеХранилище(СтруктураВозврата, АдресХранилища);
	
	Возврат КоличествоДанных;

КонецФункции

Процедура ЗаполнитьПомощникПоСтратегииОтложенно(Параметры, АдресХранилища) Экспорт

	ИмяОперации = "Документ.РазрешениеНаЗаменуМатериалов.МодульМенеджера.ЗаполнитьПомощникПоСтратегииОтложенно";
	ОписаниеЗамера = ОценкаПроизводительности.НачатьЗамерДлительнойОперации(ИмяОперации);
	
	КоличествоДанных = ЗаполнитьПомощникПоСтратегии(Параметры.СтруктураДанныхФормы, АдресХранилища);
	
	ОценкаПроизводительности.ЗакончитьЗамерДлительнойОперации(ОписаниеЗамера, КоличествоДанных);

КонецПроцедуры

Функция ЗаполнитьПомощникПоСтратегии(СтруктураДанныхФормы, АдресХранилища)
	
	ЗаполнениеНеОтгруженного = СтруктураДанныхФормы.ЗаполнениеНеОтгруженного;
	ОтборСтрок = СтруктураДанныхФормы.СтруктураОтбораЭтапов;
	Этапы = СтруктураДанныхФормы.Этапы;
	Дерево = СтруктураДанныхФормы.Дерево;
	ТаблицаОстатковАналогов = СтруктураДанныхФормы.ОстаткиАналогов;
	
	Если ОтборСтрок.Количество() > 0 Тогда
		ТаблицаДанных = Этапы.Скопировать(ОтборСтрок, "Этап, КлючСвязи");
	Иначе
		ТаблицаДанных = Этапы.Скопировать(, "Этап, КлючСвязи");
	КонецЕсли;
	
	ТаблицаДанных.Свернуть("Этап, КлючСвязи");
	ТаблицаДанных.Индексы.Добавить("Этап, КлючСвязи");
	ПараметрыОтбора = Новый Структура("Этап, КлючСвязи");
	
	КоличествоДанных = ТаблицаДанных.Количество();
	СтрокиПоНоменклатуре = Дерево.Строки;
	ТаблицаОстатковАналогов.Индексы.Добавить("Номенклатура, Характеристика, Склад, Назначение");
	
	Для каждого СтрокаТаблицы Из ТаблицаДанных Цикл
		
		ЗаполнитьЗначенияСвойств(ПараметрыОтбора, СтрокаТаблицы);
		СтрокиЭтапов = Этапы.НайтиСтроки(ПараметрыОтбора);
		
		КоличествоНаборовЗаменить = -1;
		
		Для каждого СтрокаТЗ Из СтрокиЭтапов Цикл
	
			Если ЗаполнениеНеОтгруженного Тогда
				КЗамене = СтрокаТЗ.Всего - СтрокаТЗ.Отгружено - СтрокаТЗ.КЗаменеДоИзменения;
			Иначе
				КЗамене = СтрокаТЗ.Всего - СтрокаТЗ.Обеспечено - СтрокаТЗ.КЗаменеДоИзменения;
			КонецЕсли;
			
			КоличествоНаборов = ПроизводствоКлиентСервер.КоэффициентПоНормативу(
				СтрокаТЗ.КонтролироватьКратность,
				КЗамене,
				СтрокаТЗ.Норматив, 
				СтрокаТЗ.ДанныеУпаковки);
			
			Если КоличествоНаборовЗаменить = -1 Тогда
				КоличествоНаборовЗаменить = КоличествоНаборов;
			Иначе
				КоличествоНаборовЗаменить = Мин(КоличествоНаборовЗаменить, КоличествоНаборов);
			КонецЕсли;
			
		КонецЦикла;
		
		Если КоличествоНаборовЗаменить <> 0 Тогда
			ОбработатьИзменение(СтруктураДанныхФормы, СтрокиПоНоменклатуре, ТаблицаОстатковАналогов, ПараметрыОтбора.Этап, ПараметрыОтбора.КлючСвязи, КоличествоНаборовЗаменить, СтрокаТЗ);
		КонецЕсли;
		
	КонецЦикла;
	
	ОбновитьКолонкуДоступно(СтруктураДанныхФормы, Этапы, ТаблицаОстатковАналогов);
	
	СтруктураВозврата = Новый Структура;
	СтруктураВозврата.Вставить("ТаблицаЭтапов", Этапы);
	СтруктураВозврата.Вставить("Дерево", Дерево);
	СтруктураВозврата.Вставить("ТаблицаОстатков", ТаблицаОстатковАналогов);
	
	ПоместитьВоВременноеХранилище(СтруктураВозврата, АдресХранилища);
	
	Возврат КоличествоДанных;

КонецФункции

Функция ОбработатьИзменение(
	СтруктураДанныхФормы, СтрокиПоНоменклатуре, ТаблицаОстатковАналогов, Этап, КлючСвязи, КоличествоНаборов, СтрокаЭтапа, ЗаполнитьКЗаменеТекущейСтроки = Истина) Экспорт
	
	Этапы = СтруктураДанныхФормы.Этапы;
	
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("Этап", Этап);
	ПараметрыОтбора.Вставить("КлючСвязи", КлючСвязи);
	ОтменитьИзменение = Ложь;
	
	ОбособленныйНабор = Ложь;
	НазначениеОбособления = Справочники.Назначения.ПустаяСсылка();
	Склад = Справочники.Склады.ПустаяСсылка();
	ПредставлениеЗаказа = "";
	
	СтрокиЭтапа = Этапы.НайтиСтроки(ПараметрыОтбора);
	
	Для каждого СтрокаТаблицы Из СтрокиЭтапа Цикл
	
		Если СтрокаТаблицы.КонтролироватьКратность
		   И Цел(КоличествоНаборов) <> КоличествоНаборов Тогда
		
			ОтменитьИзменение = Истина;
			ТекстСообщения = НСтр("ru = 'Введите количество кратное нормативу.';
									|en = 'Enter the amount multiple of the standard'");
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
			Прервать;
		
		КонецЕсли;
		
		РасчетноеКоличество = РасчетноеКоличествоНоменклатуры(СтрокаТаблицы.Норматив, КоличествоНаборов, СтрокаТаблицы.ДанныеУпаковки);
		
		Если СтрокаТаблицы.КЗаменеДоИзменения + РасчетноеКоличество > СтрокаТаблицы.Всего - СтрокаТаблицы.Отгружено Тогда
		
			ОтменитьИзменение = Истина;
			ТекстСообщения = НСтр("ru = 'Введите количество не превышающее неотгруженное количество.';
									|en = 'Enter a number no greater than the number of unshipped goods.'");
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
			Прервать;
		
		КонецЕсли;
		
		Если КлючСвязи <> 0 Тогда
			НазначениеОбособления = СтрокаТаблицы.Назначение;
		КонецЕсли;
		
		Склад = СтрокаТаблицы.Склад;
		ПредставлениеЗаказа = СтрокаТаблицы.ПредставлениеЗаказа;
		ОбособленныйНабор = СтрокаТаблицы.ОбособленныйНабор;
		
	КонецЦикла;
	
	Если ОтменитьИзменение Тогда
	
		Для каждого СтрокаТаблицы Из СтрокиЭтапа Цикл
		
			СтрокаТаблицы.КЗамене = СтрокаТаблицы.КЗаменеДоИзменения;
			СтрокаТаблицы.Выбран = СтрокаТаблицы.КЗамене > 0;
		
		КонецЦикла;
		
	Иначе
		
		ДанныеЗаполнения = Новый Структура;
		ДанныеЗаполнения.Вставить("Назначение", НазначениеОбособления);
		ДанныеЗаполнения.Вставить("ОбособленныйНабор", ОбособленныйНабор);
		ДанныеЗаполнения.Вставить("Склад", Склад);
		ДанныеЗаполнения.Вставить("СтрокиЭтапа", СтрокиЭтапа);
		ДанныеЗаполнения.Вставить("Этап", Этап);
		ДанныеЗаполнения.Вставить("ПредставлениеЗаказа", ПредставлениеЗаказа);
		ДанныеЗаполнения.Вставить("ЗаполнениеВыделеннойСтроки", Ложь);
		ДанныеЗаполнения.Вставить("ЗаполнитьКЗаменеТекущейСтроки", ЗаполнитьКЗаменеТекущейСтроки);
		ДанныеЗаполнения.Вставить("ВыделеннаяСтрока", СтрокаЭтапа);
		
		ОтразитьРучноеИзменениеКоличестваКЗамене(СтруктураДанныхФормы, СтрокиПоНоменклатуре, ТаблицаОстатковАналогов, ДанныеЗаполнения, КоличествоНаборов);
		
	КонецЕсли;
	
	Возврат Не ОтменитьИзменение;

КонецФункции

Процедура ОтразитьРучноеИзменениеКоличестваКЗамене(СтруктураДанныхФормы, СтрокиПоНоменклатуре, ТаблицаОстатковАналогов, ДанныеЗаполнения, КоличествоНаборов) Экспорт
	
	ПодборВзаимозаменяемыхАналогов = СтруктураДанныхФормы.ПодборВзаимозаменяемыхАналогов;
	Нормативы = СтруктураДанныхФормы.Нормативы;
	СтруктураПоиска = Новый Структура("Номенклатура, Характеристика, Флаг");
	ВыделеннаяСтрока = ДанныеЗаполнения.ВыделеннаяСтрока;
	
	Если ПодборВзаимозаменяемыхАналогов Тогда
				
		ЗаполнитьРасшифровкуВзаимозаменяемыхАналогов(
			СтруктураДанныхФормы, СтрокиПоНоменклатуре, ТаблицаОстатковАналогов, ДанныеЗаполнения, КоличествоНаборов);
			
	Иначе
			
		Для каждого СтрокаНорматива Из Нормативы Цикл
		
			ДанныеЗаполнения.ЗаполнениеВыделеннойСтроки = СтрокаНорматива.Номенклатура = ВыделеннаяСтрока.Номенклатура
			   И СтрокаНорматива.Характеристика = ВыделеннаяСтрока.Характеристика;
				
			ЗаполнитьЗначенияСвойств(СтруктураПоиска, СтрокаНорматива);
			СтруктураПоиска.Флаг = ?(СтрокаНорматива.ЭтоМатериал, 1, 0);
			
			СтрокиДерева = НайтиДобавитьСтрокуДерева(СтрокиПоНоменклатуре, СтруктураПоиска);
				
			Для каждого СтрокаПоНоменклатуре Из СтрокиДерева Цикл
				
				Если СтрокаНорматива.ЭтоМатериал Тогда
				
					ЗаполнитьРасшифровкуМатериаловПоСтрокеРодителю(
						СтрокаПоНоменклатуре, ДанныеЗаполнения, КоличествоНаборов, СтрокаНорматива);
						
				Иначе	
					
					РасчетноеКоличество = РасчетноеКоличествоНоменклатуры(СтрокаНорматива.Норматив, КоличествоНаборов, СтрокаНорматива.ДанныеУпаковки); 
					
					ЗаполнитьРасшифровкуАналоговПоСтрокеРодителю(
						СтруктураДанныхФормы, СтрокаПоНоменклатуре, ТаблицаОстатковАналогов, ДанныеЗаполнения, РасчетноеКоличество);
					
				КонецЕсли;
			
			КонецЦикла;
			
			Если СтрокаПоНоменклатуре.Количество = 0 Тогда
				СтрокиПоНоменклатуре.Удалить(СтрокаПоНоменклатуре);
			КонецЕсли;
		
		КонецЦикла;	
	
	КонецЕсли;

КонецПроцедуры

Процедура ЗаполнитьРасшифровкуМатериаловПоСтрокеРодителю(СтрокаПоНоменклатуре, ДанныеЗаполнения, Знач КоличествоНаборов, СтрокаНорматив) Экспорт
	
	Норматив = СтрокаНорматив.Норматив;
	ДанныеУпаковки = СтрокаНорматив.ДанныеУпаковки;
	Количество = РасчетноеКоличествоНоменклатуры(Норматив, КоличествоНаборов, ДанныеУпаковки);
	СтрокаПоНоменклатуре.Количество = СтрокаПоНоменклатуре.Количество + Количество;
	
	Если ДанныеЗаполнения.ЗаполнениеВыделеннойСтроки Тогда
		
		ВыделеннаяСтрока = ДанныеЗаполнения.ВыделеннаяСтрока;
		
		Если ДанныеЗаполнения.ЗаполнитьКЗаменеТекущейСтроки Тогда
			ВыделеннаяСтрока.КЗамене = Количество;
		КонецЕсли;
		
		ВыделеннаяСтрока.КЗаменеДоИзменения = ВыделеннаяСтрока.КЗамене;
		ВыделеннаяСтрока.Выбран = ВыделеннаяСтрока.КЗамене > 0;
		ЗаполнитьСтрокуРасшифровкиВДереве(СтрокаПоНоменклатуре, ДанныеЗаполнения, ВыделеннаяСтрока.Назначение, Количество);
		
	Иначе
		
		Для Каждого СтрокаЭтап Из ДанныеЗаполнения.СтрокиЭтапа Цикл
			
			Если КоличествоНаборов = 0 Тогда
				Прервать;
			КонецЕсли;
			
			Если СтрокаЭтап.Номенклатура = СтрокаПоНоменклатуре.Номенклатура
			   И СтрокаЭтап.Характеристика = СтрокаПоНоменклатуре.Характеристика Тогда
			
				ДоступноУстановить = ПроизводствоКлиентСервер.КоэффициентПоНормативу(
					СтрокаНорматив.КонтролироватьКратность, 
					СтрокаЭтап.Всего - СтрокаЭтап.Отгружено - СтрокаЭтап.КЗаменеДоИзменения, 
					Норматив, 
					ДанныеУпаковки);
				
				Если ДоступноУстановить >= КоличествоНаборов Тогда
					КУстановке = КоличествоНаборов;
				Иначе
					КУстановке = ДоступноУстановить;
				КонецЕсли;
				
				Если КУстановке <> 0 Тогда
					
					РасчетноеКоличество = РасчетноеКоличествоНоменклатуры(Норматив, КУстановке, ДанныеУпаковки);
					СтрокаЭтап.КЗамене = СтрокаЭтап.КЗамене + РасчетноеКоличество;
					СтрокаЭтап.Выбран = СтрокаЭтап.КЗамене > 0;
					СтрокаЭтап.КЗаменеДоИзменения = СтрокаЭтап.КЗамене;
					
					ЗаполнитьСтрокуРасшифровкиВДереве(СтрокаПоНоменклатуре, ДанныеЗаполнения, СтрокаЭтап.Назначение, Количество);
					
					КоличествоНаборов = КоличествоНаборов - КУстановке;
					
				КонецЕсли;
				
			КонецЕсли;
		
		КонецЦикла;
	
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьРасшифровкуАналоговПоСтрокеРодителю(СтруктураДанныхФормы, СтрокаПоНоменклатуре, ТаблицаОстатковАналогов, ДанныеЗаполнения, Количество) Экспорт
	
	ПараметрыОтбораАналогов = Новый Структура("Номенклатура, Характеристика, Назначение, Склад");
	ЗаполнитьЗначенияСвойств(ПараметрыОтбораАналогов, СтрокаПоНоменклатуре, "Номенклатура, Характеристика");
	ПараметрыОтбораАналогов.Склад = ДанныеЗаполнения.Склад;
	ПустоеНазначение = Справочники.Назначения.ПустаяСсылка();
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("СтрокиПоНоменклатуре", Неопределено);
	ДополнительныеПараметры.Вставить("СтруктураПоиска", Неопределено);
	ДополнительныеПараметры.Вставить("ВыделеннаяСтрока", Неопределено);
	
	УменьшениеКоличества = Количество < 0;
	ЕстьНераспределенноеКоличество = Количество <> 0;
	
	Если УменьшениеКоличества Тогда
		
		ПоискЗачтенныхСтрок = Новый Структура();
		ПоискЗачтенныхСтрок.Вставить("Номенклатура", СтрокаПоНоменклатуре.Номенклатура);
		ПоискЗачтенныхСтрок.Вставить("Характеристика", СтрокаПоНоменклатуре.Характеристика);
		ПоискЗачтенныхСтрок.Вставить("Склад", ДанныеЗаполнения.Склад);
		ПоискЗачтенныхСтрок.Вставить("Этап", ДанныеЗаполнения.Этап);
		
		ПодобранныеНазначения = Новый Соответствие;
		МассивЗачтенныхСтрок = СтрокаПоНоменклатуре.Строки.НайтиСтроки(ПоискЗачтенныхСтрок);
		
		Для Каждого СтрокаДерева Из МассивЗачтенныхСтрок Цикл
			
			Если ПодобранныеНазначения.Получить(СтрокаДерева.Назначение) = Неопределено Тогда
				ПодобранныеНазначения.Вставить(СтрокаДерева.Назначение, СтрокаДерева.Количество);
			КонецЕсли;
			
		КонецЦикла;
		
		КоличествоБезНазначения = ПодобранныеНазначения.Получить(ПустоеНазначение);
		
		Если ЕстьНераспределенноеКоличество
		   И КоличествоБезНазначения <> Неопределено Тогда
		
			ПараметрыОтбораАналогов.Назначение = ПустоеНазначение;
			КоличествоКИзменению = Макс(Количество, -КоличествоБезНазначения);
			Количество = Количество - КоличествоКИзменению;
			ОбработатьИтерациюПодбораОстатковАналогов(СтруктураДанныхФормы, ТаблицаОстатковАналогов, КоличествоКИзменению, ПараметрыОтбораАналогов, ДанныеЗаполнения, СтрокаПоНоменклатуре, ДополнительныеПараметры);
			ЕстьНераспределенноеКоличество = Количество <> 0;
		
		КонецЕсли;
		
		КоличествоПоНазначению = ПодобранныеНазначения.Получить(ДанныеЗаполнения.Назначение);
		
		Если ЕстьНераспределенноеКоличество И ЗначениеЗаполнено(ДанныеЗаполнения.Назначение)
		   И КоличествоПоНазначению <> Неопределено Тогда
	
			ПараметрыОтбораАналогов.Назначение = ДанныеЗаполнения.Назначение;
			КоличествоКИзменению = Макс(Количество, -КоличествоПоНазначению);
			Количество = Количество - КоличествоКИзменению;
			ОбработатьИтерациюПодбораОстатковАналогов(СтруктураДанныхФормы, ТаблицаОстатковАналогов, КоличествоКИзменению, ПараметрыОтбораАналогов, ДанныеЗаполнения, СтрокаПоНоменклатуре, ДополнительныеПараметры);
			ЕстьНераспределенноеКоличество = Количество <> 0;
		
		КонецЕсли;
		
	Иначе	
		
		Если ЕстьНераспределенноеКоличество И ЗначениеЗаполнено(ДанныеЗаполнения.Назначение) Тогда
	
			ПараметрыОтбораАналогов.Назначение = ДанныеЗаполнения.Назначение;
			ОбработатьИтерациюПодбораОстатковАналогов(СтруктураДанныхФормы, ТаблицаОстатковАналогов, Количество, ПараметрыОтбораАналогов, ДанныеЗаполнения, СтрокаПоНоменклатуре, ДополнительныеПараметры);
			ЕстьНераспределенноеКоличество = Количество <> 0;
		
		КонецЕсли;
		
		Если ЕстьНераспределенноеКоличество Тогда
		
			ПараметрыОтбораАналогов.Назначение = ПустоеНазначение;
			ОбработатьИтерациюПодбораОстатковАналогов(СтруктураДанныхФормы, ТаблицаОстатковАналогов, Количество, ПараметрыОтбораАналогов, ДанныеЗаполнения, СтрокаПоНоменклатуре, ДополнительныеПараметры);
			ЕстьНераспределенноеКоличество = Количество <> 0;
		
		КонецЕсли;
		
	КонецЕсли;
	
	Если ЕстьНераспределенноеКоличество Тогда
		
		НазначениеПоиска = ?(ДанныеЗаполнения.ОбособленныйНабор, ДанныеЗаполнения.Назначение, ПустоеНазначение);
		ПараметрыОтбораАналогов.Назначение = НазначениеПоиска;
		
		СтрокаУчетаОстатков = Неопределено;
		СтрокиОстатков = ТаблицаОстатковАналогов.НайтиСтроки(ПараметрыОтбораАналогов);
		Если СтрокиОстатков.Количество() > 0 Тогда
			СтрокаУчетаОстатков = СтрокиОстатков[0];
		КонецЕсли;
		
		Если СтрокаУчетаОстатков <> Неопределено Тогда
			
			Если УменьшениеКоличества Тогда
				
				КСписанию = -Количество;
				КСписаниюСверхОстатка = Мин(СтрокаУчетаОстатков.ИспользованоСверхОстатка, КСписанию);
				
				Если КСписаниюСверхОстатка <> 0 Тогда
					СтрокаУчетаОстатков.ИспользованоСверхОстатка = СтрокаУчетаОстатков.ИспользованоСверхОстатка - КСписаниюСверхОстатка;
				КонецЕсли;
				
				КСписанию = КСписанию - КСписаниюСверхОстатка;
				КСписаниюИспользовано = Мин(СтрокаУчетаОстатков.Использовано, КСписанию);
				
				Если КСписаниюИспользовано <> 0 Тогда
					СтрокаУчетаОстатков.Использовано = СтрокаУчетаОстатков.Использовано - КСписаниюИспользовано;
				КонецЕсли;
				
			Иначе
				
				СтрокаУчетаОстатков.ИспользованоСверхОстатка = СтрокаУчетаОстатков.ИспользованоСверхОстатка + Количество;
			
			КонецЕсли;
			
		КонецЕсли;
		
		СтрокаПоНоменклатуре.Количество = СтрокаПоНоменклатуре.Количество + Количество;
		ЗаполнитьСтрокуРасшифровкиВДереве(СтрокаПоНоменклатуре, ДанныеЗаполнения, НазначениеПоиска, Количество);
	
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьРасшифровкуВзаимозаменяемыхАналогов(СтруктураДанныхФормы, СтрокиПоНоменклатуре, ТаблицаОстатковАналогов, ДанныеЗаполнения, КоличествоНаборов) Экспорт
	
	Нормативы = СтруктураДанныхФормы.Нормативы;
	ДанныеЗаполнения.ЗаполнениеВыделеннойСтроки = Истина;
	ВыделеннаяСтрока = ДанныеЗаполнения.ВыделеннаяСтрока;
	ПустоеНазначение = Справочники.Назначения.ПустаяСсылка();
	
	СтруктураПоискаНорматива = Новый Структура("Номенклатура, Характеристика");
	ЗаполнитьЗначенияСвойств(СтруктураПоискаНорматива, ВыделеннаяСтрока);
	
	Для каждого СтрокаТаблицы Из Нормативы Цикл
	
		Если СтрокаТаблицы.Номенклатура = ВыделеннаяСтрока.Номенклатура
		   И СтрокаТаблицы.Характеристика = ВыделеннаяСтрока.Характеристика Тогда
		
			Продолжить;
		
		КонецЕсли;
		
		СтрокаНорматива = СтрокаТаблицы;
		Прервать;
	
	КонецЦикла;
	
	СтруктураПоиска = Новый Структура("Номенклатура, Характеристика, Флаг");
	ЗаполнитьЗначенияСвойств(СтруктураПоиска, ВыделеннаяСтрока);
	СтруктураПоиска.Флаг = 1;
	
	СтрокиДерева = НайтиДобавитьСтрокуДерева(СтрокиПоНоменклатуре, СтруктураПоиска);
	
	Для каждого СтрокаПоНоменклатуре Из СтрокиДерева Цикл
				
		ЗаполнитьРасшифровкуМатериаловПоСтрокеРодителю(
			СтрокаПоНоменклатуре, ДанныеЗаполнения, КоличествоНаборов, СтрокаНорматива);
			
		Если СтрокаПоНоменклатуре.Количество = 0 Тогда
			СтрокиПоНоменклатуре.Удалить(СтрокаПоНоменклатуре);
		КонецЕсли;
	
	КонецЦикла;
		
	ДанныеЗаполнения.ЗаполнениеВыделеннойСтроки = Ложь;
	СтруктураПоиска.Флаг = 0;
	ФлагАналог = 0;
		
	Количество = РасчетноеКоличествоНоменклатуры(СтрокаНорматива.Норматив, КоличествоНаборов, СтрокаНорматива.ДанныеУпаковки);
	ЕстьНераспределенноеКоличество = Количество <> 0;
	УменьшениеКоличества = Количество < 0;
	
	ОтборПоНазначениюСкладу = Новый Структура("Назначение, Склад");
	ЗаполнитьЗначенияСвойств(ОтборПоНазначениюСкладу, ДанныеЗаполнения);
	
	Если ЕстьНераспределенноеКоличество И УменьшениеКоличества Тогда
		
		ПоискЗачтенныхСтрок = Новый Структура();
		ПоискЗачтенныхСтрок.Вставить("Склад", ДанныеЗаполнения.Склад);
		ПоискЗачтенныхСтрок.Вставить("Этап", ДанныеЗаполнения.Этап);
		
		ТаблицаОбхода = Новый ТаблицаЗначений;
		ТаблицаОбхода.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
		ТаблицаОбхода.Колонки.Добавить("Характеристика", Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
		ТаблицаОбхода.Колонки.Добавить("Склад", Новый ОписаниеТипов("СправочникСсылка.Склады"));
		ТаблицаОбхода.Колонки.Добавить("Назначение", Новый ОписаниеТипов("СправочникСсылка.Назначения"));
		ТаблицаОбхода.Колонки.Добавить("Количество", ОбщегоНазначения.ОписаниеТипаЧисло(15,3));
		
		Для каждого СтрокаДерева Из СтрокиПоНоменклатуре Цикл
		
			Если СтрокаДерева.Флаг = ФлагАналог
			   И НЕ (СтрокаДерева.Номенклатура = ВыделеннаяСтрока.Номенклатура
			   И СтрокаДерева.Характеристика = ВыделеннаяСтрока.Характеристика) Тогда
			
				СтрокиДляПоиска = СтрокаДерева.Строки;
				
				МассивЗачтенныхСтрок = СтрокиДляПоиска.НайтиСтроки(ПоискЗачтенныхСтрок);
				
				Для Каждого СтрокаДерева Из МассивЗачтенныхСтрок Цикл
					
					НоваяСтрокаОбхода = ТаблицаОбхода.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтрокаОбхода, СтрокаДерева);
					
				КонецЦикла;
			
			КонецЕсли;	
		
		КонецЦикла;
		
		ДополнительныеПараметры = Новый Структура();
		ДополнительныеПараметры.Вставить("СтрокиПоНоменклатуре", СтрокиПоНоменклатуре);
		ДополнительныеПараметры.Вставить("СтруктураПоиска", СтруктураПоиска);
		ДополнительныеПараметры.Вставить("ВыделеннаяСтрока", ВыделеннаяСтрока);
		
		ПараметрыОтбораОстатковАналогов = Новый Структура("Номенклатура, Характеристика, Назначение, Склад");
		ТаблицаОбхода.Сортировать("Назначение", Новый СравнениеЗначений);
		Для каждого СтрокаОбхода Из ТаблицаОбхода Цикл
		
			Если НЕ ЕстьНераспределенноеКоличество Тогда
				Прервать;
			КонецЕсли;
			
			ЗаполнитьЗначенияСвойств(ПараметрыОтбораОстатковАналогов, СтрокаОбхода);
			КоличествоКИзменению = Макс(Количество, -СтрокаОбхода.Количество);
			Количество = Количество - КоличествоКИзменению;
			ОбработатьИтерациюПодбораОстатковАналогов(СтруктураДанныхФормы, ТаблицаОстатковАналогов, КоличествоКИзменению, ПараметрыОтбораОстатковАналогов, ДанныеЗаполнения, Неопределено, ДополнительныеПараметры);
			ЕстьНераспределенноеКоличество = Количество <> 0;
		
		КонецЦикла;
		
	Иначе
		
		Если ЕстьНераспределенноеКоличество И ЗначениеЗаполнено(ДанныеЗаполнения.Назначение) Тогда
		
			ОтборПоНазначениюСкладу.Назначение = ДанныеЗаполнения.Назначение;
			ДополнительныеПараметры = Новый Структура();
			ДополнительныеПараметры.Вставить("СтрокиПоНоменклатуре", СтрокиПоНоменклатуре);
			ДополнительныеПараметры.Вставить("СтруктураПоиска", СтруктураПоиска);
			ДополнительныеПараметры.Вставить("ВыделеннаяСтрока", ВыделеннаяСтрока);
			
			ОбработатьИтерациюПодбораОстатковАналогов(СтруктураДанныхФормы, ТаблицаОстатковАналогов, Количество, ОтборПоНазначениюСкладу, ДанныеЗаполнения, Неопределено, ДополнительныеПараметры);
			
			ЕстьНераспределенноеКоличество = Количество <> 0;
		
		КонецЕсли;
		
		Если ЕстьНераспределенноеКоличество Тогда
		
			ОтборПоНазначениюСкладу.Назначение = ПустоеНазначение;
			ДополнительныеПараметры = Новый Структура();
			ДополнительныеПараметры.Вставить("СтрокиПоНоменклатуре", СтрокиПоНоменклатуре);
			ДополнительныеПараметры.Вставить("СтруктураПоиска", СтруктураПоиска);
			ДополнительныеПараметры.Вставить("ВыделеннаяСтрока", ВыделеннаяСтрока);
			
			ОбработатьИтерациюПодбораОстатковАналогов(СтруктураДанныхФормы, ТаблицаОстатковАналогов, Количество, ОтборПоНазначениюСкладу, ДанныеЗаполнения, Неопределено, ДополнительныеПараметры);
			
			ЕстьНераспределенноеКоличество = Количество <> 0;
		
		КонецЕсли;
		
	КонецЕсли;
		
	Если ЕстьНераспределенноеКоличество Тогда
		
		НазначениеПоиска = ?(ДанныеЗаполнения.ОбособленныйНабор, ДанныеЗаполнения.Назначение, ПустоеНазначение);
		ПараметрыОтбораАналогов = Новый Структура("Номенклатура, Характеристика, Назначение, Склад");
		ПараметрыОтбораАналогов.Назначение = НазначениеПоиска;
		ПараметрыОтбораАналогов.Склад = ОтборПоНазначениюСкладу.Склад;
		ПараметрыОтбораАналогов.Номенклатура = СтрокаНорматива.Номенклатура;
		ПараметрыОтбораАналогов.Характеристика = СтрокаНорматива.Характеристика;
		
		СтрокаУчетаОстатков = Неопределено;
		СтрокиОстатков = ТаблицаОстатковАналогов.НайтиСтроки(ПараметрыОтбораАналогов);
		Если СтрокиОстатков.Количество() > 0 Тогда
			СтрокаУчетаОстатков = СтрокиОстатков[0];
		КонецЕсли;
		
		Если СтрокаУчетаОстатков <> Неопределено Тогда
			
			Если УменьшениеКоличества Тогда
				
				КСписанию = -Количество;
				КСписаниюСверхОстатка = Мин(СтрокаУчетаОстатков.ИспользованоСверхОстатка, КСписанию);
				
				Если КСписаниюСверхОстатка <> 0 Тогда
					СтрокаУчетаОстатков.ИспользованоСверхОстатка = СтрокаУчетаОстатков.ИспользованоСверхОстатка - КСписаниюСверхОстатка;
				КонецЕсли;
				
				КСписанию = КСписанию - КСписаниюСверхОстатка;
				КСписаниюИспользовано = Мин(СтрокаУчетаОстатков.Использовано, КСписанию);
				
				Если КСписаниюИспользовано <> 0 Тогда
					СтрокаУчетаОстатков.Использовано = СтрокаУчетаОстатков.Использовано - КСписаниюИспользовано;
				КонецЕсли;
				
			Иначе
				
				СтрокаУчетаОстатков.ИспользованоСверхОстатка = СтрокаУчетаОстатков.ИспользованоСверхОстатка + Количество;
			
			КонецЕсли;
			
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(СтруктураПоиска, СтрокаНорматива);
		СтрокиДерева = НайтиДобавитьСтрокуДерева(СтрокиПоНоменклатуре, СтруктураПоиска);
		СтрокаПоНоменклатуре = СтрокиДерева[0];
		СтрокаПоНоменклатуре.Количество = СтрокаПоНоменклатуре.Количество + Количество;
		ЗаполнитьСтрокуРасшифровкиВДереве(СтрокаПоНоменклатуре, ДанныеЗаполнения, НазначениеПоиска, Количество);
			
		Если СтрокаПоНоменклатуре.Количество = 0 Тогда
			СтрокиПоНоменклатуре.Удалить(СтрокаПоНоменклатуре);
		КонецЕсли;
	
	КонецЕсли;
	
КонецПроцедуры

Функция НайтиДобавитьСтрокуДерева(СтрокиПоНоменклатуре, СтруктураПоиска) Экспорт

	СтрокиДерева = СтрокиПоНоменклатуре.НайтиСтроки(СтруктураПоиска);
			
	Если СтрокиДерева.Количество() = 0 Тогда
	
		СтрокаПоНоменклатуре = СтрокиПоНоменклатуре.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаПоНоменклатуре, СтруктураПоиска);
		СтрокаПоНоменклатуре.ХарактеристикиИспользуются = ЗначениеЗаполнено(СтрокаПоНоменклатуре.Характеристика);
		СтрокиДерева.Добавить(СтрокаПоНоменклатуре);
		
	КонецЕсли;
	
	Возврат СтрокиДерева;

КонецФункции

Процедура ОбработатьИтерациюПодбораОстатковАналогов(
	СтруктураДанныхФормы, ТаблицаОстатковАналогов, Количество, ПараметрыОтбораАналогов, ДанныеЗаполнения, СтрокаПоНоменклатуре, ДополнительныеПараметры) Экспорт
	
	ПодборВзаимозаменяемыхАналогов = СтруктураДанныхФормы.ПодборВзаимозаменяемыхАналогов;
	МассивОстатков = ТаблицаОстатковАналогов.НайтиСтроки(ПараметрыОтбораАналогов);

	СтрокиПоНоменклатуре = ДополнительныеПараметры.СтрокиПоНоменклатуре;
	СтруктураПоиска = ДополнительныеПараметры.СтруктураПоиска;
	ВыделеннаяСтрока = ДополнительныеПараметры.ВыделеннаяСтрока;
	
	Для Каждого СтрокаОстатков Из МассивОстатков Цикл
	
		Если Количество = 0 Тогда
			Прервать;
		КонецЕсли;
		
		Если ПодборВзаимозаменяемыхАналогов Тогда
		
			Если СтрокаОстатков.Номенклатура = ВыделеннаяСтрока.Номенклатура
			   И СтрокаОстатков.Характеристика = ВыделеннаяСтрока.Характеристика Тогда
			
				Продолжить;
			
			КонецЕсли;
			
			ЗаполнитьЗначенияСвойств(СтруктураПоиска, СтрокаОстатков, "Номенклатура, Характеристика");
			
			СтрокиДерева = НайтиДобавитьСтрокуДерева(СтрокиПоНоменклатуре, СтруктураПоиска);
			СтрокаПоНоменклатуре = СтрокиДерева[0];
		
		КонецЕсли;
		
		ОбработатьСтрокуОстатков(Количество, ДанныеЗаполнения, ПараметрыОтбораАналогов.Назначение, СтрокаОстатков, СтрокаПоНоменклатуре);
		
		Если СтрокиПоНоменклатуре <> Неопределено И СтрокаПоНоменклатуре.Количество = 0 Тогда
			СтрокиПоНоменклатуре.Удалить(СтрокаПоНоменклатуре);
		КонецЕсли;
	
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьСтрокуРасшифровкиВДереве(СтрокаПоНоменклатуре, ДанныеЗаполнения, Назначение, Количество) Экспорт

	СтруктураОтбора = Новый Структура;
	СтруктураОтбора.Вставить("Номенклатура", СтрокаПоНоменклатуре.Номенклатура);
	СтруктураОтбора.Вставить("Характеристика", СтрокаПоНоменклатуре.Характеристика);
	СтруктураОтбора.Вставить("Назначение", Назначение);
	СтруктураОтбора.Вставить("Этап", ДанныеЗаполнения.Этап);
	СтруктураОтбора.Вставить("Склад", ДанныеЗаполнения.Склад);
	
	СтрокиРасшифровки = СтрокаПоНоменклатуре.Строки.НайтиСтроки(СтруктураОтбора);
	
	Если СтрокиРасшифровки.Количество() = 0 Тогда
		
		СтрокаРасшифровки = СтрокаПоНоменклатуре.Строки.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаРасшифровки, СтрокаПоНоменклатуре,, "Количество");
		ЗаполнитьЗначенияСвойств(СтрокаРасшифровки, ДанныеЗаполнения, "Этап, ПредставлениеЗаказа");
		СтрокаРасшифровки.Назначение = Назначение;
		СтрокаРасшифровки.Склад = ДанныеЗаполнения.Склад;
		СтрокаРасшифровки.Количество = Количество;
		
	Иначе
		
		СтрокиКУдалению = Новый Массив;
		
		Для каждого СтрокаРасшифровки Из СтрокиРасшифровки Цикл
		
			СтрокаРасшифровки.Количество = СтрокаРасшифровки.Количество + Количество;
			
			Если СтрокаРасшифровки.Количество = 0 Тогда
				СтрокиКУдалению.Добавить(СтрокаРасшифровки);
			КонецЕсли;
		
		КонецЦикла;
		
		Для каждого СтрокаКУдалению Из СтрокиКУдалению Цикл
			СтрокаПоНоменклатуре.Строки.Удалить(СтрокаКУдалению);
		КонецЦикла;
	
	КонецЕсли;

КонецПроцедуры

Процедура ОбработатьСтрокуОстатков(Количество, ДанныеЗаполнения, Назначение, СтрокаОстатков, СтрокаПоНоменклатуре) Экспорт
	
	УменьшениеКоличества = Количество < 0;
	ДоступноеКоличество = ?(УменьшениеКоличества, 
		- СтрокаОстатков.Использовано - СтрокаОстатков.ИспользованоСверхОстатка,
		СтрокаОстатков.Свободно - СтрокаОстатков.Использовано);
			
	Если УменьшениеКоличества Тогда
		КУстановке = ?(ДоступноеКоличество >= Количество, ДоступноеКоличество, Количество);
	Иначе
		КУстановке = ?(ДоступноеКоличество >= Количество, Количество, ДоступноеКоличество);
	КонецЕсли;
	
	Если КУстановке <> 0 Тогда
		
		ИзменениеОстатка = КУстановке;
		
		Если УменьшениеКоличества Тогда
			
			КоличествоКСписанию = -КУстановке;
			Если КоличествоКСписанию >= СтрокаОстатков.ИспользованоСверхОстатка Тогда
				ИзменениеОстатка = КоличествоКСписанию - СтрокаОстатков.ИспользованоСверхОстатка;
				СтрокаОстатков.ИспользованоСверхОстатка = 0;
			Иначе
				ИзменениеОстатка = 0;
				СтрокаОстатков.ИспользованоСверхОстатка = СтрокаОстатков.ИспользованоСверхОстатка - КоличествоКСписанию;
			КонецЕсли;
			
			ИзменениеОстатка = -ИзменениеОстатка;
			
		КонецЕсли;
		
		СтрокаОстатков.Использовано = СтрокаОстатков.Использовано + ИзменениеОстатка;
		
		СтрокаПоНоменклатуре.Количество = СтрокаПоНоменклатуре.Количество + КУстановке;
		ЗаполнитьСтрокуРасшифровкиВДереве(СтрокаПоНоменклатуре, ДанныеЗаполнения, Назначение, КУстановке);
		
	КонецЕсли;
	
	Количество = Количество - КУстановке;

КонецПроцедуры

Процедура ОтразитьИзменениеВТаблицеОстатков(ТаблицаОстатков, СтрокаРасшифровки) Экспорт

	СтруктураПоиска = Новый Структура;
	СтруктураПоиска.Вставить("Номенклатура", СтрокаРасшифровки.Номенклатура);
	СтруктураПоиска.Вставить("Характеристика", СтрокаРасшифровки.Характеристика);
	СтруктураПоиска.Вставить("Назначение", СтрокаРасшифровки.Назначение);
	СтруктураПоиска.Вставить("Склад", СтрокаРасшифровки.Склад);
	
	СтрокиОстатков = ТаблицаОстатков.НайтиСтроки(СтруктураПоиска);
	Для каждого СтрокаТЗ Из СтрокиОстатков Цикл
	
		СтрокаТЗ.Использовано = СтрокаТЗ.Использовано + СтрокаРасшифровки.Количество;
	
	КонецЦикла;

КонецПроцедуры

Процедура ОбновитьКолонкуДоступно(СтруктураДанныхФормы, Этапы, ТаблицаОстатков = Неопределено) Экспорт
	
	Разрешение = СтруктураДанныхФормы.Разрешение;
	Нормативы = СтруктураДанныхФормы.Нормативы;
	ПодборВзаимозаменяемыхАналогов = СтруктураДанныхФормы.ПодборВзаимозаменяемыхАналогов;
	ОстаткиАналогов = СтруктураДанныхФормы.ОстаткиАналогов;
	
	ДоступныеАналоги = Новый ТаблицаЗначений;
	ДоступныеАналоги.Колонки.Добавить("Назначение", Новый ОписаниеТипов("СправочникСсылка.Назначения"));
	ДоступныеАналоги.Колонки.Добавить("Склад", Новый ОписаниеТипов("СправочникСсылка.Склады"));
	ДоступныеАналоги.Колонки.Добавить("КоличествоОбособленно", ОбщегоНазначения.ОписаниеТипаЧисло(15,3));
	ДоступныеАналоги.Колонки.Добавить("КоличествоОбщее", ОбщегоНазначения.ОписаниеТипаЧисло(15,3));
	
	ИменаКолонок = "Назначение, Склад";
	ТаблицаПоиска = Этапы.Скопировать(, ИменаКолонок);
	ТаблицаПоиска.Свернуть(ИменаКолонок);
	МассивСкладов = ОбщегоНазначения.ВыгрузитьКолонку(ТаблицаПоиска, "Склад", Истина);
	
	Если ТаблицаОстатков = Неопределено Тогда
	
		Запрос = Новый Запрос;
		Запрос.Текст = ТекстЗапросаДоступностиАналогов();
		
		Запрос.УстановитьПараметр("Разрешение", Разрешение);
		Запрос.УстановитьПараметр("ТаблицаПоиска", ТаблицаПоиска);
			
		РезультатЗапроса = Запрос.Выполнить();
		
		ТаблицаОстатков = РезультатЗапроса.Выгрузить();
		ТаблицаОстатков.Индексы.Добавить("Номенклатура, Характеристика, Назначение, Склад");
	
	КонецЕсли;
	
	ДоступныеАналоги.Индексы.Добавить(ИменаКолонок);
	
	ТаблицаАналогов = Нормативы.Скопировать(Новый Структура("ЭтоМатериал", Ложь));
	
	СтруктураПоискаДоступныхАналогов = Новый Структура(ИменаКолонок);
	СтруктураПоискаДоступныхАналогов.Назначение = Справочники.Назначения.ПустаяСсылка();
	
	Для каждого Склад Из МассивСкладов Цикл
	
		СтруктураПоискаДоступныхАналогов.Склад = Склад;
		
		МассивСтрок = ДоступныеАналоги.НайтиСтроки(СтруктураПоискаДоступныхАналогов);
		
		Если МассивСтрок.Количество() = 0 Тогда
		
			КоэффициентыНаличия = КоэффициентНаличияАналогов(
				СтруктураДанныхФормы, ТаблицаАналогов, ТаблицаОстатков, СтруктураПоискаДоступныхАналогов);
			СтрокаТаблицыДоступности = ДоступныеАналоги.Добавить();
			СтрокаТаблицыДоступности.КоличествоОбособленно = КоэффициентыНаличия.КоэффициентРасчетаОбособленный;
			СтрокаТаблицыДоступности.КоличествоОбщее = КоэффициентыНаличия.КоэффициентНаличияОбщий;
			СтрокаТаблицыДоступности.Склад = СтруктураПоискаДоступныхАналогов.Склад;
			СтрокаТаблицыДоступности.Назначение = СтруктураПоискаДоступныхАналогов.Назначение;
		
		КонецЕсли;
	
	КонецЦикла;
	
	Для Каждого СтрокаТаблицыПоиска Из ТаблицаПоиска Цикл
		
		ЗаполнитьЗначенияСвойств(СтруктураПоискаДоступныхАналогов, СтрокаТаблицыПоиска);
		
		КоэффициентыНаличия = КоэффициентНаличияАналогов(
			СтруктураДанныхФормы, ТаблицаАналогов, ТаблицаОстатков, СтруктураПоискаДоступныхАналогов);
		
		СтрокаТаблицыДоступности = ДоступныеАналоги.Добавить();
		СтрокаТаблицыДоступности.КоличествоОбособленно = КоэффициентыНаличия.КоэффициентРасчетаОбособленный;
		СтрокаТаблицыДоступности.КоличествоОбщее = КоэффициентыНаличия.КоэффициентНаличияОбщий;
		СтрокаТаблицыДоступности.Склад = СтрокаТаблицыПоиска.Склад;
		СтрокаТаблицыДоступности.Назначение = СтрокаТаблицыПоиска.Назначение;
	
	КонецЦикла;
		
	ПустоеНазначение = Справочники.Назначения.ПустаяСсылка();
	СтруктураПоиска = Новый Структура("Номенклатура, Характеристика, Назначение, Склад");
		
	Для Каждого СтрокаТЧ Из Этапы Цикл
		
		СтрокаТЧ.Доступно = 0;
		
		ЗаполнитьЗначенияСвойств(СтруктураПоискаДоступныхАналогов, СтрокаТЧ, ИменаКолонок);
		Если Не ЗначениеЗаполнено(СтрокаТЧ.КлючСвязи) Тогда
			СтруктураПоискаДоступныхАналогов.Назначение = ПустоеНазначение;
		КонецЕсли;
	
		МассивСтрок = ДоступныеАналоги.НайтиСтроки(СтруктураПоискаДоступныхАналогов);
		Для каждого СтрокаДоступныхАналогов Из МассивСтрок Цикл
			
			ДоступноНаборов = ?(СтрокаТЧ.ОбособленныйНабор, 
				СтрокаДоступныхАналогов.КоличествоОбособленно, СтрокаДоступныхАналогов.КоличествоОбщее);
			ДоступноНаборов = СтрокаДоступныхАналогов.КоличествоОбщее;
			СтрокаТЧ.Доступно = СтрокаТЧ.Доступно + ДоступноНаборов;
		
		КонецЦикла;
		
		Если ПодборВзаимозаменяемыхАналогов Тогда
		
			ЗаполнитьЗначенияСвойств(СтруктураПоиска, СтрокаТЧ);
			МассивОстатковТоваров = ТаблицаОстатков.НайтиСтроки(СтруктураПоиска);
			
			Для каждого СтрокаОстатковТоваров Из МассивОстатковТоваров Цикл
				
				ВычитаемоеКоличество = ПроизводствоКлиентСервер.КоэффициентПоНормативу(
					СтрокаТЧ.КонтролироватьКратность,
					СтрокаОстатковТоваров.Свободно - СтрокаОстатковТоваров.Использовано,
					СтрокаТЧ.Норматив,
					СтрокаТЧ.ДанныеУпаковки);
				
				СтрокаТЧ.Доступно = СтрокаТЧ.Доступно - ВычитаемоеКоличество;
			
			КонецЦикла;
			
			СтруктураПоиска.Назначение = ПустоеНазначение;
			МассивОстатковТоваров = ТаблицаОстатков.НайтиСтроки(СтруктураПоиска);
			
			Для каждого СтрокаОстатковТоваров Из МассивОстатковТоваров Цикл
					
				ВычитаемоеКоличество = ПроизводствоКлиентСервер.КоэффициентПоНормативу(
					СтрокаТЧ.КонтролироватьКратность,
					СтрокаОстатковТоваров.Свободно - СтрокаОстатковТоваров.Использовано,
					СтрокаТЧ.Норматив,
					СтрокаТЧ.ДанныеУпаковки);
				
				СтрокаТЧ.Доступно = СтрокаТЧ.Доступно - ВычитаемоеКоличество;
			
			КонецЦикла;
			
		КонецЕсли;
		
		РасчетноеКоличество = РасчетноеКоличествоНоменклатуры(СтрокаТЧ.Норматив, СтрокаТЧ.Доступно, СтрокаТЧ.ДанныеУпаковки);
		
		СтрокаТЧ.Доступно = РасчетноеКоличество;
	
	КонецЦикла;
	
КонецПроцедуры

