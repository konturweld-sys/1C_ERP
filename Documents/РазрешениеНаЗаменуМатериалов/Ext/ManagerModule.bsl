	|	Расчет.Склад КАК Склад,
	|	Расчет.Назначение КАК Назначение,
	|	Расчет.КоличествоДляДействияОтгрузить КАК Свободно
	|ПОМЕСТИТЬ ОстаткиАналогов
	|ИЗ
	|	РасчетОстатковДляУстановкиДействий КАК Расчет
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаАналитик.Номенклатура КАК Номенклатура,
	|	ТаблицаАналитик.Характеристика КАК Характеристика,
	|	ТаблицаАналитик.Назначение КАК Назначение,
	|	ТаблицаАналитик.Склад КАК Склад,
	|	ЕСТЬNULL(ОстаткиАналогов.Свободно, 0) КАК Свободно,
	|	0 КАК Использовано
	|ИЗ
	|	ТаблицаАналитик КАК ТаблицаАналитик
	|		ЛЕВОЕ СОЕДИНЕНИЕ ОстаткиАналогов КАК ОстаткиАналогов
	|		ПО ТаблицаАналитик.Номенклатура = ОстаткиАналогов.Номенклатура
	|			И ТаблицаАналитик.Характеристика = ОстаткиАналогов.Характеристика
	|			И ТаблицаАналитик.Назначение = ОстаткиАналогов.Назначение
	|			И ТаблицаАналитик.Склад = ОстаткиАналогов.Склад";
	ИменаТаблиц = ОбеспечениеВДокументахСервер.НовыеИменаТаблицДляРасчетаОстатковДляУстановкиДействий();
	ИменаТаблиц.Остатки = "ЗапасыИПотребностиОстатки"; // @query-part-1
	ИменаТаблиц.Результат = "РасчетОстатковДляУстановкиДействий"; // @query-part-1
	ОбеспечениеВДокументахСервер.РасчетОстатковДляУстановкиДействий(Текст, ИменаТаблиц);
	
	Возврат Текст;
	
КонецФункции

Функция КоэффициентНаличияАналогов(СтруктураДанныхФормы, ТаблицаАналогов, ТаблицаОстатков, СтрокаТаблицыПоиска) Экспорт
	
	ПодборВзаимозаменяемыхАналогов = СтруктураДанныхФормы.ПодборВзаимозаменяемыхАналогов;
	КоэффициентНаличияОбщий = -1;
	КоэффициентНаличияОбособленный = -1;
	УчестьДополнительноСвободныйОстаток = ЗначениеЗаполнено(СтрокаТаблицыПоиска.Назначение);
	СтруктураПоиска = Новый Структура("Номенклатура, Характеристика, Назначение, Склад");
	
	Для Каждого СтрокаТаблицыАналогов Из ТаблицаАналогов Цикл
		
		ЗаполнитьЗначенияСвойств(СтруктураПоиска, СтрокаТаблицыАналогов, "Номенклатура, Характеристика");
		ЗаполнитьЗначенияСвойств(СтруктураПоиска, СтрокаТаблицыПоиска, "Склад, Назначение");
		
		МассивОстатковТоваров = ТаблицаОстатков.НайтиСтроки(СтруктураПоиска);
		МассивДополнения = Новый Массив;
		
		Если УчестьДополнительноСвободныйОстаток Тогда
		
			СтруктураПоиска.Назначение = Справочники.Назначения.ПустаяСсылка();
			МассивДополнения = ТаблицаОстатков.НайтиСтроки(СтруктураПоиска);
		
		КонецЕсли;
		
		ОстатокБезНазначения = 0;
		Свободно = 0;
		Использовано = 0;
		
		Для Каждого СтрокаТаблицыОстатков Из МассивОстатковТоваров Цикл
			
			Свободно = СтрокаТаблицыОстатков.Свободно;
			Использовано = СтрокаТаблицыОстатков.Использовано;
			
		КонецЦикла;
		
		Если УчестьДополнительноСвободныйОстаток Тогда
		
			Для каждого СтрокаДополнения Из МассивДополнения Цикл
				ОстатокБезНазначения = ОстатокБезНазначения + СтрокаДополнения.Свободно - СтрокаДополнения.Использовано;
			КонецЦикла;
		
		КонецЕсли;
		
		КоэффициентРасчетаОбщий = ПроизводствоКлиентСервер.КоэффициентПоНормативу(
			СтрокаТаблицыАналогов.КонтролироватьКратность, 
			Свободно - Использовано + ОстатокБезНазначения,
			СтрокаТаблицыАналогов.Норматив,
			СтрокаТаблицыАналогов.ДанныеУпаковки);
			
		КоэффициентРасчетаОбособленный = ПроизводствоКлиентСервер.КоэффициентПоНормативу(
			СтрокаТаблицыАналогов.КонтролироватьКратность, 
			Свободно - Использовано,
			СтрокаТаблицыАналогов.Норматив,
			СтрокаТаблицыАналогов.ДанныеУпаковки);
								
		Если КоэффициентНаличияОбщий < 0 Тогда
			КоэффициентНаличияОбщий = КоэффициентРасчетаОбщий;
		ИначеЕсли ПодборВзаимозаменяемыхАналогов Тогда
			КоэффициентНаличияОбщий = КоэффициентНаличияОбщий + КоэффициентРасчетаОбщий;
		Иначе
			КоэффициентНаличияОбщий = Мин(КоэффициентНаличияОбщий, КоэффициентРасчетаОбщий);
		КонецЕсли;
		
		Если КоэффициентНаличияОбособленный < 0 Тогда
			КоэффициентНаличияОбособленный = КоэффициентРасчетаОбособленный;
		ИначеЕсли ПодборВзаимозаменяемыхАналогов Тогда
			КоэффициентНаличияОбособленный = КоэффициентНаличияОбособленный + КоэффициентРасчетаОбособленный;
		Иначе
			КоэффициентНаличияОбособленный = Мин(КоэффициентНаличияОбособленный, КоэффициентРасчетаОбособленный);
		КонецЕсли;
	
	КонецЦикла;
	
	КоэффициентНаличияОбщий = ?(КоэффициентНаличияОбщий < 0, 0, КоэффициентНаличияОбщий);
	КоэффициентНаличияОбособленный = ?(КоэффициентНаличияОбособленный < 0, 0, КоэффициентНаличияОбособленный);
	
	Возврат Новый Структура("КоэффициентНаличияОбщий, КоэффициентРасчетаОбособленный", КоэффициентНаличияОбщий, КоэффициентНаличияОбособленный);

КонецФункции

Функция РасчетноеКоличествоНоменклатуры(Норматив, КоэффициентПересчета, ДанныеУпаковки) Экспорт

	РасчетноеКоличество = Норматив * КоэффициентПересчета
		* ДанныеУпаковки.Числитель / ДанныеУпаковки.Знаменатель;
			
	ТекущееКоличество = Цел(РасчетноеКоличество);
	Если РасчетноеКоличество > ТекущееКоличество Тогда
		ТекущееКоличество = ТекущееКоличество + Цел((РасчетноеКоличество - ТекущееКоличество) * 1000) / 1000;
	КонецЕсли;
	
	Возврат РасчетноеКоличество;

КонецФункции

#КонецОбласти

Функция ТекстЗапросаДинамическогоСпискаРазрешенийНаЗаменуМатериалов() Экспорт
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ОсновнаяТаблица.Ссылка КАК Ссылка,
	|	ОсновнаяТаблица.ВерсияДанных КАК ВерсияДанных,
	|	ОсновнаяТаблица.ПометкаУдаления КАК ПометкаУдаления,
	|	ОсновнаяТаблица.Номер КАК Номер,
	|	ОсновнаяТаблица.Дата КАК Дата,
	|	ОсновнаяТаблица.Проведен КАК Проведен,
	|	ОсновнаяТаблица.ДатаНачалаДействия КАК ДатаНачалаДействия,
	|	ОсновнаяТаблица.ДатаОкончанияДействия КАК ДатаОкончанияДействия,
	|	ОсновнаяТаблица.Статус КАК Статус,
	|	ОсновнаяТаблица.УказаниеПоПрименению КАК УказаниеПоПрименению,
	|	ОсновнаяТаблица.Ответственный КАК Ответственный
	|ИЗ
	|	Документ.РазрешениеНаЗаменуМатериалов КАК ОсновнаяТаблица";
	
	Возврат ТекстЗапроса;
	
КонецФункции

// Устанавливает отбор по номенклатуре в динамическом списке.
//
// Параметры:
//  Список       - ДинамическийСписок - оформляемый динамический список.
//  Номенклатура - СправочникСсылка.Номенклатура - номенклатура отбора.
//  Назначение   - ПеречислениеСсылка.ИспользованиеНоменклатурыВНСИПроизводства - назначение отбора.
//
Процедура УстановитьОтборПоНоменклатуреВДинамическомСпискеРазрешенийНаЗаменуМатериалов(Список, Номенклатура, Назначение = Неопределено) Экспорт
	
	ОтборПоНоменклатуре = ОбщегоНазначенияКлиентСервер.СоздатьГруппуЭлементовОтбора(
		Список.КомпоновщикНастроек.ФиксированныеНастройки.Отбор.Элементы,
		НСтр("ru = 'Отбор по номенклатуре';
			|en = 'Filter by items'"),
		ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИли);
	
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(
		ОтборПоНоменклатуре,
		"Ссылка.ОбластиДействия.Изделие",
		ВидСравненияКомпоновкиДанных.Равно,
		Номенклатура,
		,
		ЗначениеЗаполнено(Номенклатура) И (НЕ ЗначениеЗаполнено(Назначение) ИЛИ Назначение = Перечисления.ИспользованиеНоменклатурыВНСИПроизводства.Изделие));
	
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(
		ОтборПоНоменклатуре,
		"Ссылка.Материалы.Номенклатура",
		ВидСравненияКомпоновкиДанных.Равно,
		Номенклатура,
		,
		ЗначениеЗаполнено(Номенклатура) И (НЕ ЗначениеЗаполнено(Назначение) ИЛИ Назначение = Перечисления.ИспользованиеНоменклатурыВНСИПроизводства.Материал));
	
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(
		ОтборПоНоменклатуре,
		"Ссылка.Аналоги.Номенклатура",
		ВидСравненияКомпоновкиДанных.Равно,
		Номенклатура,
		,
		ЗначениеЗаполнено(Номенклатура) И (НЕ ЗначениеЗаполнено(Назначение) ИЛИ Назначение = Перечисления.ИспользованиеНоменклатурыВНСИПроизводства.Аналог));
	
КонецПроцедуры

#КонецОбласти

#Область ОбновлениеИнформационнойБазы

Функция АдаптированныйТекстЗапросаДвиженийПоРегистру(ИмяРегистра) Экспорт

	Запрос = Новый Запрос;
	ТекстыЗапроса = Новый СписокЗначений;
	
	ПолноеИмяДокумента = "Документ.РазрешениеНаЗаменуМатериалов";
	СинонимТаблицыДокумента = "РазрешениеНаЗаменуМатериаловМатериалы";
	
	Если ИмяРегистра = "АналогиМатериалов" Тогда
		
		ТекстЗапроса = ТекстЗапросаТаблицаАналогиМатериалов(Запрос, ТекстыЗапроса, ИмяРегистра);
		
	Иначе
		
		ТекстИсключения = НСтр("ru = 'В документе %ПолноеИмяДокумента% не реализована адаптация текста запроса формирования движений по регистру %ИмяРегистра%.';
								|en = 'In document %ПолноеИмяДокумента%, adaptation of request for generating records of register %ИмяРегистра% is not implemented.'");
		ТекстИсключения = СтрЗаменить(ТекстИсключения, "%ПолноеИмяДокумента%", ПолноеИмяДокумента);
		ТекстИсключения = СтрЗаменить(ТекстИсключения, "%ИмяРегистра%", ИмяРегистра);
		
		ВызватьИсключение ТекстИсключения;
		
	КонецЕсли;
	
	Результат = ОбновлениеИнформационнойБазыУТ.РезультатАдаптацииЗапроса();
	Результат.ТекстЗапроса = ОбновлениеИнформационнойБазыУТ.АдаптироватьЗапросМеханизмаПроведения(
									ТекстЗапроса, ПолноеИмяДокумента, СинонимТаблицыДокумента);
	
	Возврат Результат;
	
КонецФункции

// Добавляет в список процедуры-обработчики обновления данных ИБ
// для всех поддерживаемых версий библиотеки или конфигурации.
// Вызывается перед началом обновления данных ИБ для построения плана обновления.
//
// Параметры:
// 	Обработчики - см. ОбновлениеИнформационнойБазы.НоваяТаблицаОбработчиковОбновления
//
Процедура ПриДобавленииОбработчиковОбновления(Обработчики) Экспорт

	Обработчик = Обработчики.Добавить();
	Обработчик.Процедура = "Документы.РазрешениеНаЗаменуМатериалов.ОбработатьДанныеДляПереходаНаНовуюВерсию";
	Обработчик.Версия = "2.5.26.84";
	Обработчик.РежимВыполнения = "Отложенно";
	Обработчик.Идентификатор = Новый УникальныйИдентификатор("e1eedbda-9b2c-47ba-895e-d0006a2fc450");
	Обработчик.Многопоточный = Истина;
	Обработчик.ПроцедураЗаполненияДанныхОбновления = "Документы.РазрешениеНаЗаменуМатериалов.ЗарегистрироватьДанныеКОбработкеДляПереходаНаНовуюВерсию";
	Обработчик.ПроцедураПроверки = "ОбновлениеИнформационнойБазы.ДанныеОбновленыНаНовуюВерсиюПрограммы";
	Обработчик.Порядок = Перечисления.ПорядокОбработчиковОбновления.Обычный;
	Обработчик.Комментарий = НСтр("ru = 'Заполнение реквизита ""Приоритет замены"" значением по умолчанию.';
									|en = 'Fill in the ""Replacement priority"" attribute with the default value.'");
	
	Читаемые = Новый Массив;
	Читаемые.Добавить(Метаданные.Документы.РазрешениеНаЗаменуМатериалов.ПолноеИмя());
	Обработчик.ЧитаемыеОбъекты = СтрСоединить(Читаемые, ",");
	
	Изменяемые = Новый Массив;
	Изменяемые.Добавить(Метаданные.Документы.РазрешениеНаЗаменуМатериалов.ПолноеИмя());
	Обработчик.ИзменяемыеОбъекты = СтрСоединить(Изменяемые, ",");

КонецПроцедуры

// Параметры:
// 	Параметры - см. ОбновлениеИнформационнойБазы.ОсновныеПараметрыОтметкиКОбработке
//
Процедура ЗарегистрироватьДанныеКОбработкеДляПереходаНаНовуюВерсию(Параметры) Экспорт
	
	ПараметрыВыборки = Параметры.ПараметрыВыборки;
	ПараметрыВыборки.ПолныеИменаОбъектов = "Документ.РазрешениеНаЗаменуМатериалов";
	ПараметрыВыборки.ПоляУпорядочиванияПриРаботеПользователей.Добавить("Дата УБЫВ");
	ПараметрыВыборки.ПоляУпорядочиванияПриОбработкеДанных.Добавить("Дата УБЫВ");
	ПараметрыВыборки.СпособВыборки = ОбновлениеИнформационнойБазы.СпособВыборкиСсылки();
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	ДанныеДокумента.Ссылка КАК Ссылка,
	|	ДанныеДокумента.Ссылка.ВариантЗамены КАК ВариантЗамены,
	|	ДанныеДокумента.Ссылка.ИспользоватьПриАвтозаменеВЗаказах КАК ИспользоватьПриАвтозаменеВЗаказах,
	|	СУММА(ДанныеДокумента.КоличествоМатериалов) КАК КоличествоМатериалов,
	|	СУММА(ДанныеДокумента.КоличествоАналогов) КАК КоличествоАналогов
	|ПОМЕСТИТЬ ДанныеРазрешенийНаЗамену
	|ИЗ
	|	(ВЫБРАТЬ
	|		РазрешениеНаЗаменуМатериаловМатериалы.Ссылка КАК Ссылка,
	|		СУММА(1) КАК КоличествоМатериалов,
	|		0 КАК КоличествоАналогов
	|	ИЗ
	|		Документ.РазрешениеНаЗаменуМатериалов.Материалы КАК РазрешениеНаЗаменуМатериаловМатериалы
	|	
	|	СГРУППИРОВАТЬ ПО
	|		РазрешениеНаЗаменуМатериаловМатериалы.Ссылка
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		РазрешениеНаЗаменуМатериаловАналоги.Ссылка,
	|		0,
	|		СУММА(1)
	|	ИЗ
	|		Документ.РазрешениеНаЗаменуМатериалов.Аналоги КАК РазрешениеНаЗаменуМатериаловАналоги
	|	
	|	СГРУППИРОВАТЬ ПО
	|		РазрешениеНаЗаменуМатериаловАналоги.Ссылка) КАК ДанныеДокумента
	|
	|СГРУППИРОВАТЬ ПО
	|	ДанныеДокумента.Ссылка,
	|	ДанныеДокумента.Ссылка.ВариантЗамены,
	|	ДанныеДокумента.Ссылка.ИспользоватьПриАвтозаменеВЗаказах
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДанныеРазрешенийНаЗамену.Ссылка КАК Ссылка,
	|	ДанныеРазрешенийНаЗамену.ИспользоватьПриАвтозаменеВЗаказах КАК ИспользоватьПриАвтозаменеВЗаказахВДокументе,
	|	ВЫБОР
	|		КОГДА ДанныеРазрешенийНаЗамену.ВариантЗамены = ЗНАЧЕНИЕ(Перечисление.ВариантЗаменыАналогов.СписокАналогов)
	|			ТОГДА ИСТИНА
	|		КОГДА ДанныеРазрешенийНаЗамену.ВариантЗамены = ЗНАЧЕНИЕ(Перечисление.ВариантЗаменыАналогов.НаборНаНабор)
	|			ТОГДА ДанныеРазрешенийНаЗамену.КоличествоМатериалов = 1
	|					И ДанныеРазрешенийНаЗамену.КоличествоАналогов = 1
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ИспользоватьПриАвтозаменеВЗаказахКУстановке
	|ПОМЕСТИТЬ ТаблицаПрименениеВЗаказах
	|ИЗ
	|	ДанныеРазрешенийНаЗамену КАК ДанныеРазрешенийНаЗамену
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ДокументыКОбработке.Ссылка КАК Ссылка
	|ИЗ
	|	(ВЫБРАТЬ
	|		РазрешениеНаЗамену.Ссылка КАК Ссылка
	|	ИЗ
	|		Документ.РазрешениеНаЗаменуМатериалов КАК РазрешениеНаЗамену
	|	ГДЕ
	|		РазрешениеНаЗамену.ПриоритетЗамены = ЗНАЧЕНИЕ(Перечисление.ПравилаЗаменыНаАналоги.ПустаяСсылка)
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		Таблица.Ссылка
	|	ИЗ
	|		ТаблицаПрименениеВЗаказах КАК Таблица
	|	ГДЕ
	|		Таблица.ИспользоватьПриАвтозаменеВЗаказахВДокументе <> Таблица.ИспользоватьПриАвтозаменеВЗаказахКУстановке) КАК ДокументыКОбработке";
		
	Запрос = Новый Запрос(ТекстЗапроса);
	
	ОбновлениеИнформационнойБазы.ОтметитьКОбработке(Параметры, Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка"));
	
КонецПроцедуры

// Обработчик обновления.
// 
// Параметры:
//  Параметры - Структура - параметры обработчика:
//   * ВерсияПодсистемыНаНачалоОбновления - Строка - версия подсистемы.
//   * ИмяОбработчика - Строка - имя обработчика.
//   * ОбновляемыеДанные - Структура.
//   * ОбработкаЗавершена - Булево, Неопределено - признак завершения обработки.
//   * Очередь - Число - очередь.
//   * ПрогрессВыполнения - Структура:
//     ** ВсегоОбъектов - Число - всего обработано объектов.
//     ** ОбработаноОбъектов - Число - обработано объектов.
//
Процедура ОбработатьДанныеДляПереходаНаНовуюВерсию(Параметры) Экспорт
	
	ПолноеИмяОбъекта = "Документ.РазрешениеНаЗаменуМатериалов";
	
	ОбновляемыеДанные = ОбновлениеИнформационнойБазы.ДанныеДляОбновленияВМногопоточномОбработчике(Параметры);
	
	Если ОбновляемыеДанные.Количество() = 0 Тогда
		Параметры.ОбработкаЗавершена = ОбновлениеИнформационнойБазы.ОбработкаДанныхЗавершена(
			Параметры.Очередь, ПолноеИмяОбъекта);
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ОбновляемыеДанные.Ссылка КАК Ссылка,
	|	ОбновляемыеДанные.Дата КАК Дата
	|ПОМЕСТИТЬ ВТ_ОбновляемыеДанные
	|ИЗ
	|	&ОбновляемыеДанные КАК ОбновляемыеДанные
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ОбновляемыеДанные.Ссылка КАК Ссылка,
	|	ВТ_ОбновляемыеДанные.Ссылка.ВерсияДанных КАК ВерсияДанных
	|ИЗ
	|	ВТ_ОбновляемыеДанные КАК ВТ_ОбновляемыеДанные
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВТ_ОбновляемыеДанные.Дата УБЫВ";
	
	Запрос.УстановитьПараметр("ОбновляемыеДанные", ОбновляемыеДанные);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	ПустойПриоритетЗамены = Перечисления.ПравилаЗаменыНаАналоги.ПустаяСсылка();
	ПриоритетЗаменыПоУмолчанию = Перечисления.ПравилаЗаменыНаАналоги.ПриОтсутствииМатериала;
	ВариантНабор = Перечисления.ВариантЗаменыАналогов.НаборНаНабор;
	ВариантСписок = Перечисления.ВариантЗаменыАналогов.СписокАналогов;
		
	Пока Выборка.Следующий() Цикл
		
		НачатьТранзакцию();
		
		Попытка
			
			Блокировка = Новый БлокировкаДанных;
			Блокировка.Добавить(ПолноеИмяОбъекта).УстановитьЗначение("Ссылка", Выборка.Ссылка);
			Блокировка.Заблокировать();
			
			ДокументОбъект = ОбновлениеИнформационнойБазыУТ.ПроверитьПолучитьОбъект(Выборка.Ссылка, Выборка.ВерсияДанных, Параметры.Очередь);
			
			Если ДокументОбъект <> Неопределено Тогда
				
				Если ДокументОбъект.ПриоритетЗамены = ПустойПриоритетЗамены Тогда
					ДокументОбъект.ПриоритетЗамены = ПриоритетЗаменыПоУмолчанию;
				КонецЕсли;
				
				Если НЕ ПустаяСтрока(ДокументОбъект.УдалитьКомментарий) Тогда
					
					ШаблонКомментария = НСтр("ru = 'Комментарий: %1';
											|en = 'Comment: %1'");
					ТекстКомментария = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонКомментария, ДокументОбъект.УдалитьКомментарий);
					
					ДокументОбъект.УказаниеПоПрименению = ДокументОбъект.УказаниеПоПрименению + Символы.ПС + ТекстКомментария;
					ДокументОбъект.УдалитьКомментарий = "";
				
				КонецЕсли;
				
				КоличествоМатериалов = ДокументОбъект.Материалы.Количество();
				КоличествоАналогов = ДокументОбъект.Аналоги.Количество();
				
				Если ДокументОбъект.ВариантЗамены = ВариантНабор
				   И ДокументОбъект.ИспользоватьПриАвтозаменеВЗаказах
				   И (КоличествоМатериалов > 1
				   ИЛИ КоличествоАналогов > 1) Тогда
				
					ДокументОбъект.ИспользоватьПриАвтозаменеВЗаказах = Ложь;
				
				КонецЕсли;
				
				Если ДокументОбъект.ВариантЗамены = ВариантСписок
				 ИЛИ (ДокументОбъект.ВариантЗамены = ВариантНабор И КоличествоМатериалов = 1 И КоличествоАналогов = 1) Тогда
				
					ДокументОбъект.ИспользоватьПриАвтозаменеВЗаказах = Истина;
				
				КонецЕсли;
				
				Если ДокументОбъект.Модифицированность() Тогда
					ОбновлениеИнформационнойБазы.ЗаписатьДанные(ДокументОбъект);
				Иначе
					ОбновлениеИнформационнойБазы.ОтметитьВыполнениеОбработки(ДокументОбъект);
				КонецЕсли;
				
			КонецЕсли;
			
			ЗафиксироватьТранзакцию();
			
		Исключение
			
			ОтменитьТранзакцию();
			
			ОбновлениеИнформационнойБазыУТ.СообщитьОНеудачнойОбработке(ИнформацияОбОшибке(), Выборка.Ссылка);
			
		КонецПопытки;
		
	КонецЦикла;

	Параметры.ОбработкаЗавершена = ОбновлениеИнформационнойБазы.ОбработкаДанныхЗавершена(Параметры.Очередь, ПолноеИмяОбъекта);
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#КонецЕсли
