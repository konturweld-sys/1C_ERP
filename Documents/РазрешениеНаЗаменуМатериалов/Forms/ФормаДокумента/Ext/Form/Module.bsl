&НаКлиенте
Асинх Процедура ЗаменитьНаАналоги(Команда)
	
	ОчиститьСообщения();
	ПродолжитьВыполнение = Истина;
	
	Если Модифицированность Тогда
		
		ТекстВопроса = НСтр("ru = 'Необходимо провести документ для выполнения операции. Записать документ?';
							|en = 'To proceed, you need to post the document. Do you want to save the document?'");
		Результат = Ждать ВопросАсинх(ТекстВопроса, РежимДиалогаВопрос.ДаНет);
		ПродолжитьВыполнение = Результат = КодВозвратаДиалога.Да;
		
		Если ПродолжитьВыполнение Тогда
		
			ПараметрыЗаписи = Новый Структура("РежимЗаписи", РежимЗаписиДокумента.Проведение);
			ПродолжитьВыполнение = Записать(ПараметрыЗаписи);
		
		КонецЕсли;
	
	КонецЕсли;
	
	Если ПродолжитьВыполнение Тогда
	
		ПараметрыФормы = СтруктураПараметровФормы();
	
		ЗаменаОдинКОдному = Объект.Материалы.Количество() = 1;
		
		ПараметрыФормы.ЗаменаОдинКОдному = ЗаменаОдинКОдному;
		
		Если ЗаменаОдинКОдному Тогда
			
			СтрокаМатериалов = Объект.Материалы[0];
			ПараметрыФормы.Материал = СтрокаМатериалов.Номенклатура;
			ПараметрыФормы.ХарактеристикаМатериала = СтрокаМатериалов.Характеристика;
			
		КонецЕсли;
			
		ПараметрыФормы.Разрешение = Объект.Ссылка;
		ПараметрыФормы.ПриоритетЗамены = Объект.ПриоритетЗамены;
		ПараметрыФормы.РольАналогов = РольАналоговДокумента();
		
		ОткрытьФорму("Документ.РазрешениеНаЗаменуМатериалов.Форма.ПомощникВыполненияЗамен", ПараметрыФормы, ЭтотОбъект);
	
	КонецЕсли;

КонецПроцедуры

