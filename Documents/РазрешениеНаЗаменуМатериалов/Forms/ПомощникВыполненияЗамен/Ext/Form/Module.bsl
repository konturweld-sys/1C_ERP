КонецПроцедуры

&НаКлиенте
Процедура ПредставлениеНоменклатурыНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ОткрытьФорму("Справочник.Номенклатура.Форма.ФормаЭлемента", Новый Структура("Ключ", Материал), ЭтотОбъект);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыЭтапы

&НаКлиенте
Процедура ЭтапыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Поле.Имя = "ЭтапыПредставлениеЗаказа" Тогда
	
		ПоказатьЗначение(, Элементы.Этапы.ТекущиеДанные.Этап);
		
	ИначеЕсли Поле.Имя = "ЭтапыНоменклатура" Тогда
		
		ТекущиеДанные = Элементы.Этапы.ТекущиеДанные;
		ОткрытьФорму("Справочник.Номенклатура.Форма.ФормаЭлемента", Новый Структура("Ключ", ТекущиеДанные.Номенклатура), ЭтотОбъект);
	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЭтапыПриАктивизацииСтроки(Элемент)
	
	Если РежимИзДокумента Тогда
	
		ТекущиеДанные = Элементы.Этапы.ТекущиеДанные;
		
		Если ТекущиеДанные <> Неопределено Тогда
		
			Если НомерТекущийСтроки <> ТекущиеДанные.НомерСтрокиДокумент Тогда
		
				ПоискСтрок = Новый Структура("ОтобразитьРазрешение", Истина);
				Для Каждого СтрокаТЗ Из Аналоги.НайтиСтроки(ПоискСтрок) Цикл
					СтрокаТЗ.ОтобразитьРазрешение = Ложь;
					СтрокаТЗ.Количество = 0;
				КонецЦикла;
				
				ПоискПоМатериалу = Новый Структура("Номенклатура, Характеристика, ЭтоАналог");
				ПоискПоМатериалу.ЭтоАналог = Ложь;
				ЗаполнитьЗначенияСвойств(ПоискПоМатериалу, ТекущиеДанные);
				
				ПоискСтрок = Новый Структура("Разрешение, КлючСвязи, ЭтоАналог", Неопределено, 0, Истина);
				ОстаткиАналоговСоответствие = СоответствиеОстатков(ТекущиеДанные.Склад, ТекущиеДанные.Назначение);
				
				Для Каждого СтрокаТЗ Из Аналоги.НайтиСтроки(ПоискПоМатериалу) Цикл
					
					ПоискСтрок.Разрешение = СтрокаТЗ.Разрешение;
					ПоискСтрок.КлючСвязи = СтрокаТЗ.КлючСвязи;
					Для Каждого СтрокаТЗ Из Аналоги.НайтиСтроки(ПоискСтрок) Цикл
					
						СтрокаТЗ.ОтобразитьРазрешение = Истина;
						СтрокаТЗ.Склад = ТекущиеДанные.Склад;
						
						СтрокаТЗ.ОстатокНаСкладе = ОстатокАналогаИзСоответствия(
							ОстаткиАналоговСоответствие,
							СтрокаТЗ.Номенклатура,
							СтрокаТЗ.Характеристика);
							
						СтрокаТЗ.ЕстьОстатки = СтрокаТЗ.ОстатокНаСкладе > 0;
						
						СтрокаТЗ.Количество = ИспользованноеКоличествоАналога(
							СтрокаТЗ.Разрешение,
							СтрокаТЗ.КлючСвязи,
							СтрокаТЗ.Номенклатура,
							СтрокаТЗ.Характеристика,
							ТекущиеДанные.НомерСтрокиДокумент);
						
					КонецЦикла;
					
				КонецЦикла;
				
				УстановитьОтборСтрок();
			
			КонецЕсли;
			
			НомерТекущийСтроки = ТекущиеДанные.НомерСтрокиДокумент;	
		
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЭтапыПередУдалением(Элемент, Отказ)
	Отказ = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ЭтапыКЗаменеПриИзменении(Элемент)
	
	ОчиститьСообщения();
	
	Если Не РежимИзДокумента Тогда
	
		ТекущиеДанные = Элементы.Этапы.ТекущиеДанные;
		
		КоличествоНаборов = ПроизводствоКлиентСервер.КоэффициентПоНормативу(
			Ложь, ТекущиеДанные.КЗамене - ТекущиеДанные.КЗаменеДоИзменения, ТекущиеДанные.Норматив, ТекущиеДанные.ДанныеУпаковки);
		
		Если КоличествоНаборов <> 0 Тогда
			ОбработатьРучноеИзменение(ТекущиеДанные.Этап, ТекущиеДанные.КлючСвязи, КоличествоНаборов);
		КонецЕсли;
	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЭтапыФлагПриИзменении(Элемент)
	
	Если Не РежимИзДокумента Тогда
	
		ТекущиеДанные = Элементы.Этапы.ТекущиеДанные;
		
		Если ТекущиеДанные.Выбран Тогда
			
			ТекущиеДанные.КЗамене = ТекущиеДанные.Всего - ТекущиеДанные.Отгружено;
			
		Иначе
			
			ТекущиеДанные.КЗамене = 0;
		
		КонецЕсли;
		
		КоличествоНаборов = ПроизводствоКлиентСервер.КоэффициентПоНормативу(
			Ложь, ТекущиеДанные.КЗамене - ТекущиеДанные.КЗаменеДоИзменения, ТекущиеДанные.Норматив, ТекущиеДанные.ДанныеУпаковки);
		
		Если КоличествоНаборов <> 0 Тогда
			ОбработатьРучноеИзменение(ТекущиеДанные.Этап, ТекущиеДанные.КлючСвязи, КоличествоНаборов);
		КонецЕсли;
	
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыДеревоЗамен

&НаКлиенте
Процедура ДеревоЗаменВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Поле.Имя = "ДеревоЗаменНоменклатура" Тогда
		
		ТекущиеДанные = Элементы.ДеревоЗамен.ТекущиеДанные;
		ОткрытьФорму("Справочник.Номенклатура.Форма.ФормаЭлемента", Новый Структура("Ключ", ТекущиеДанные.Номенклатура), ЭтотОбъект);
	
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыАналоги

&НаКлиенте
Процедура АналогиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Поле = Элементы.АналогиОстатокНаСкладе  Тогда
		
		Коэффициент = КоэффициентПересчета();
		
		Если Коэффициент > 0 Тогда
		
			ОбработатьПодборАналогов(Коэффициент);
		
		КонецЕсли;
		
	ИначеЕсли Поле = Элементы.АналогиНоменклатура Тогда
		
		ТекущиеДанные = Элементы.Аналоги.ТекущиеДанные;
		ОткрытьФорму("Справочник.Номенклатура.Форма.ФормаЭлемента", Новый Структура("Ключ", ТекущиеДанные.Номенклатура), ЭтотОбъект);
		
	ИначеЕсли Поле = Элементы.АналогиРазрешение Тогда
		
		ТекущиеДанные = Элементы.Аналоги.ТекущиеДанные;
		ПоказатьЗначение(, ТекущиеДанные.Разрешение);

	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура АналогиПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	Отказ = Истина;
КонецПроцедуры

&НаКлиенте
Процедура АналогиПередУдалением(Элемент, Отказ)
	Отказ = Истина;
КонецПроцедуры

&НаКлиенте
Процедура АналогиПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	АналогиКоличествоДоИзменения = Элементы.Аналоги.ТекущиеДанные.Количество;
КонецПроцедуры

&НаКлиенте
Процедура АналогиПередОкончаниемРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования, Отказ)
	
	ТекущиеДанные = Элементы.Аналоги.ТекущиеДанные;
	
	Если Не ОтменаРедактирования И ТекущиеДанные.Количество <> АналогиКоличествоДоИзменения Тогда
		
		ОчиститьСообщения();
		
		ТекущиеДанныеАналоги = Элементы.Аналоги.ТекущиеДанные;
		КоэффициентРасчета = ПроизводствоКлиентСервер.КоэффициентПоНормативу(
			Ложь,
			ТекущиеДанныеАналоги.Количество - АналогиКоличествоДоИзменения,
			ТекущиеДанныеАналоги.Норматив,
			ТекущиеДанныеАналоги.ДанныеУпаковки);
		
		ПроверитьВозможностьПересчета(КоэффициентРасчета, Отказ);
		
		Если Не Отказ Тогда
			
			ТекущиеДанные.Количество = АналогиКоличествоДоИзменения;
			ОбработатьПодборАналогов(КоэффициентРасчета);
			АналогиКоличествоДоИзменения = ТекущиеДанные.Количество;
			
		КонецЕсли;
		
	Иначе
		
		ТекущиеДанные.Количество = АналогиКоличествоДоИзменения;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура АналогиПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	
	Элементы.Аналоги.ВыделенныеСтроки.Очистить();
	Элементы.Аналоги.ВыделенныеСтроки.Добавить(Элементы.Аналоги.ТекущаяСтрока);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Перечитать(Команда)
	
	ЗаполнитьДанныеФормыНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаменитьНаАналоги(Команда)
	
	ОчиститьСообщения();

	ЗаменитьНаАналогиНаСервере();
	
	Если НачатьОжиданиеДлительнойОперации Тогда
		
		НачатьОжиданиеДлительнойОперации(Ложь);
		ТекстОперации = НСтр("ru = 'Выполняется замена на аналоги...';
							|en = 'Replacing with substitutes...'");
		НастроитьОжиданиеВФорме(ЭтотОбъект, Истина, ТекстОперации);
		
	ИначеЕсли ПеречитатьДанныеПослеЗамены Тогда
		ОбновитьДанныеЭтаповНаФорме();
	Иначе
		НастроитьОжиданиеВФорме(ЭтотОбъект, Ложь);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Отметить(Команда)

	ОбработатьИзменениеФлага(Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура СнятьОтметку(Команда)

	ОбработатьИзменениеФлага(Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьНеОбеспеченное(Команда)
	
	ОчиститьСообщения();
	ЗаполнитьПоСтратегииНаСервере(Ложь);
	
	Если НачатьОжиданиеДлительнойОперации Тогда
		
		НачатьОжиданиеДлительнойОперации(Ложь);
		ТекстОперации = НСтр("ru = 'Выполняется заполнение необеспеченного количества...';
							|en = 'Filling in non-supplied quantity...'");
		НастроитьОжиданиеВФорме(ЭтотОбъект, Истина, ТекстОперации);
	
	Иначе
		НастроитьОжиданиеВФорме(ЭтотОбъект, Ложь);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьНеотгруженное(Команда)
	
	ОчиститьСообщения();
	ЗаполнитьПоСтратегииНаСервере(Истина);
	
	Если НачатьОжиданиеДлительнойОперации Тогда
		
		НачатьОжиданиеДлительнойОперации(Ложь);
		ТекстОперации = НСтр("ru = 'Выполняется заполнение неотгруженного количества...';
							|en = 'Filling in unshipped quantity...'");
		НастроитьОжиданиеВФорме(ЭтотОбъект, Истина, ТекстОперации);
	
	Иначе
		НастроитьОжиданиеВФорме(ЭтотОбъект, Ложь);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПоДоступности(Команда)
	
	ОчиститьСообщения();
	ЗаполнитьПоДоступностиНаСервере();
	
	Если НачатьОжиданиеДлительнойОперации Тогда
		
		НачатьОжиданиеДлительнойОперации(Ложь);
		ТекстОперации = НСтр("ru = 'Выполняется заполнение по доступности...';
							|en = 'Filling in by availability...'");
		НастроитьОжиданиеВФорме(ЭтотОбъект, Истина, ТекстОперации);
	
	Иначе
		НастроитьОжиданиеВФорме(ЭтотОбъект, Ложь);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Далее(Команда)
	
	АдресРезультатаЗамены = РезультатПодбора();
	
	Закрыть(АдресРезультатаЗамены);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	УсловноеОформление.Элементы.Очистить();
	
	НоменклатураСервер.УстановитьУсловноеОформлениеХарактеристикНоменклатуры(ЭтотОбъект, 
		"ДеревоЗаменХарактеристика",
		"ДеревоЗамен.ХарактеристикиИспользуются");
	
	НоменклатураСервер.УстановитьУсловноеОформлениеХарактеристикНоменклатуры(ЭтотОбъект, 
		"ЭтапыХарактеристика",
		"Этапы.ХарактеристикиИспользуются");
	
	НоменклатураСервер.УстановитьУсловноеОформлениеХарактеристикНоменклатуры(ЭтотОбъект, 
		"АналогиХарактеристика",
		"Аналоги.ХарактеристикиИспользуются");
	
	Элемент = УсловноеОформление.Элементы.Добавить();

	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.Этапы.Имя);
	
	ГруппаОтбораИли = Элемент.Отбор.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
	ГруппаОтбораИли.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИли;
	
	ОтборЭлемента = ГруппаОтбораИли.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Этапы.КЗамене");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Новый ПолеКомпоновкиДанных("Этапы.Всего");
	
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ЦветТекстаОтмененнойСтрокиДокумента);
	
	Если ЗначениеЗаполнено(Этап) Тогда
	
		Элемент = УсловноеОформление.Элементы.Добавить();

		ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
		ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.ЭтапыКЗамене.Имя);
		
		ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Этапы.КЗамене");
		ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Больше;
		ОтборЭлемента.ПравоеЗначение = 0;

		Элемент.Оформление.УстановитьЗначениеПараметра("Шрифт", ШрифтыСтиля.ЖирныйШрифт);
	
	КонецЕсли
	
КонецПроцедуры

&НаСервере
Процедура УстановитьГиперссылкуЗаменяемогоМатериала()
	
	Если ЗначениеЗаполнено(Материал) И НЕ ПодборВзаимозаменяемыхАналогов Тогда
		ПредставлениеНоменклатуры = НоменклатураКлиентСервер.ПредставлениеНоменклатуры(
			Материал, ХарактеристикаМатериала);
	КонецЕсли;
	
	Элементы.ПредставлениеНоменклатуры.Видимость = НЕ ПустаяСтрока(ПредставлениеНоменклатуры);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьЭлементов()
	
	Элементы.ЭтапыНоменклатура.Видимость = НЕ ЗаменаОдинКОдному ИЛИ ПодборВзаимозаменяемыхАналогов;
	Элементы.ЭтапыХарактеристика.Видимость = НЕ ЗаменаОдинКОдному ИЛИ ПодборВзаимозаменяемыхАналогов;
	
	Если ПриоритетЗамены <> Перечисления.ПравилаЗаменыНаАналоги.ПустаяСсылка() Тогда
		
		Элементы.ГруппаАналоги.Видимость = Ложь;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Этап) Тогда
	
		Элементы.ЭтапыПредставлениеЗаказа.Видимость = Ложь;
		Элементы.ЭтапыФлаг.Видимость = Ложь;
		Элементы.ЭтапыОтгружено.Видимость = Ложь;
		Элементы.ЭтапыОбеспечено.Видимость = Ложь;
		Элементы.ЭтапыКЗамене.КартинкаШапки = Новый Картинка;
		Элементы.ЭтапыКЗамене.ТолькоПросмотр = Истина;
		Элементы.ГруппаДеревоЗамен.Видимость = Ложь;
		Элементы.ГруппаОтборы.Видимость = Ложь;
		РежимОткрытияОкна = РежимОткрытияОкнаФормы.БлокироватьОкноВладельца;
		Элементы.ЭтапыДоступно.Видимость = Ложь;
		Элементы.ПодменюЗаполнить.Видимость = Ложь;
		
		Заголовок = СтрЗаменить(НСтр("ru = 'Состояние обеспечения (замена на аналоги): %Заказ%';
									|en = 'Supply forecast (replacement with substitutes): %Заказ%'"), "%Заказ%", Строка(Этап));
		Элементы.Далее.КнопкаПоУмолчанию = Истина;
		Элементы.ЗаменитьНаАналоги.Видимость = Ложь;
		ПоложениеКоманднойПанели = ПоложениеКоманднойПанелиФормы.Нет;
		Элементы.ЭтапыКоманднаяПанель.Видимость = Ложь;
		
		Элементы.АналогиРазрешениеПриоритетЗамены.Видимость = ПолучитьФункциональнуюОпцию("ДинамическаяСтруктураЗаказовНаПроизводство");
	
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура УстановитьОтборСтрок()

	ОтборСтрок = Новый Структура;
	ОтборСтрок.Вставить("ЭтоАналог", Истина);
	ОтборСтрок.Вставить("ОтобразитьРазрешение", Истина);
	
	Элементы.Аналоги.ОтборСтрок = Новый ФиксированнаяСтруктура(ОтборСтрок);

КонецПроцедуры

&НаСервере
Процедура УстановитьОтборСтрокЭтапы()

	Элементы.Этапы.ОтборСтрок = Новый ФиксированнаяСтруктура(СтруктураОтбораЭтапов());

КонецПроцедуры

&НаСервере
Функция СтруктураОтбораЭтапов()

	ОтборСтрок = Новый Структура;
	
	Если ЗначениеЗаполнено(ЗаказНаПроизводствоОтбор) Тогда
	
		ОтборСтрок.Вставить("ЗаказНаПроизводство", ЗаказНаПроизводствоОтбор);
	
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПодразделениеОтбор) Тогда
	
		ОтборСтрок.Вставить("Подразделение", ПодразделениеОтбор);
	
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СпецификацияОтбор) Тогда
	
		ОтборСтрок.Вставить("Спецификация", СпецификацияОтбор);
	
	КонецЕсли;
	
	Если ЗначениеЗаполнено(НазначениеОтбор) Тогда
	
		ОтборСтрок.Вставить("Назначение", НазначениеОтбор);
	
	КонецЕсли;
	
	Возврат ОтборСтрок;

КонецФункции

&НаСервере
Процедура ОбработатьДанныеПриУстановкеОтбора()

	ОтборСтрок = СтруктураОтбораЭтапов();
	ОтборСтрокСравнение = Новый Структура;
	
	Для каждого ЭлементСтруктуры Из ОтборСтрок Цикл
	
		ОтборСтрокСравнение.Вставить(ЭлементСтруктуры.Ключ, Неопределено);
	
	КонецЦикла;
	
	ОбновитьДоступность = Ложь;
	
	Дерево = РеквизитФормыВЗначение("ДеревоЗамен");
	СтрокиПоНоменклатуре = Дерево.Строки;
	ТаблицаОстатковАналогов = ОстаткиАналогов.Выгрузить();
	ТаблицаОстатковАналогов.Индексы.Добавить("Номенклатура, Характеристика, Склад, Назначение");
	
	Для каждого СтрокаТаблицы Из Этапы Цикл
	
		Если СтрокаТаблицы.Выбран Тогда
		
			ЗаполнитьЗначенияСвойств(ОтборСтрокСравнение, СтрокаТаблицы);
			
			ДанныеСовпадают = ОбщегоНазначения.ДанныеСовпадают(ОтборСтрокСравнение, ОтборСтрок);
			
			Если Не ДанныеСовпадают Тогда
			
				СтрокаТаблицы.Выбран = Ложь;
				СтрокаТаблицы.КЗамене = 0;
				
				КоличествоНаборов = ПроизводствоКлиентСервер.КоэффициентПоНормативу(
					Ложь, СтрокаТаблицы.КЗамене - СтрокаТаблицы.КЗаменеДоИзменения, СтрокаТаблицы.Норматив, СтрокаТаблицы.ДанныеУпаковки);
					
				Если КоличествоНаборов <> 0 Тогда
					ОбработатьИзменение(СтрокиПоНоменклатуре, ТаблицаОстатковАналогов, СтрокаТаблицы.Этап, СтрокаТаблицы.КлючСвязи, КоличествоНаборов, СтрокаТаблицы);
					ОбновитьДоступность = Истина;
				КонецЕсли;
				
			КонецЕсли;
		
		КонецЕсли;
	
	КонецЦикла;
	
	ЗначениеВРеквизитФормы(Дерево, "ДеревоЗамен");
	
	Если ОбновитьДоступность Тогда
		ОбновитьКолонкуДоступно(ТаблицаОстатковАналогов);
	КонецЕсли;
	
	ОстаткиАналогов.Загрузить(ТаблицаОстатковАналогов);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьДанныеЭтаповНаФорме()

	ЗаполнитьДанныеФормыНаСервере();
	
	Если НачатьОжиданиеДлительнойОперации Тогда
		
		НачатьОжиданиеДлительнойОперации(Ложь);
		ТекстОперации = НСтр("ru = 'Выполняется получение данных...';
							|en = 'Receiving data…'");
		НастроитьОжиданиеВФорме(ЭтотОбъект, Истина, ТекстОперации);
		
	Иначе
		
		НастроитьОжиданиеВФорме(ЭтотОбъект, Ложь);
		
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДанныеФормыНаСервере()
		
	ОтменитьДлительнуюОперацию();
	
	Этапы.Очистить();
	Аналоги.Очистить();
	ДанныеДерева = ДеревоЗамен.ПолучитьЭлементы();
	ДанныеДерева.Очистить();
	
	ПеречитатьДанныеПослеЗамены = Ложь;
	
	Если ЗначениеЗаполнено(Этап) Тогда
		ТаблицаЗапасов = ОстаткиАналогов.Выгрузить();
	Иначе
		ТаблицаЗапасов = Неопределено;
	КонецЕсли;
	
	ПараметрыПроцедуры = Новый Структура;
	ПараметрыПроцедуры.Вставить("РольАналогов", РольАналогов);
	ПараметрыПроцедуры.Вставить("Разрешение", Разрешение);
	ПараметрыПроцедуры.Вставить("Этапы", Этапы.Выгрузить());
	ПараметрыПроцедуры.Вставить("Аналоги", Аналоги.Выгрузить());
	ПараметрыПроцедуры.Вставить("ПриоритетЗамены", ПриоритетЗамены);
	ПараметрыПроцедуры.Вставить("Этап", Этап);
	ПараметрыПроцедуры.Вставить("ТоварыИзДокумента", ТоварыИзДокумента.Выгрузить());
	ПараметрыПроцедуры.Вставить("ТаблицаЗапасов", ТаблицаЗапасов);
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	ПараметрыВыполнения.ЗапуститьВФоне = Истина;
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = НСтр("ru = 'Помощник выполнения замен на аналоги: заполнение данных этапов';
															|en = 'Wizard of replacing with substitutes: fill stage data'");
	
	ДлительнаяОперация = ДлительныеОперации.ВыполнитьВФоне(
		"Документы.РазрешениеНаЗаменуМатериалов.ДанныеЭтаповДляЗамены",
		ПараметрыПроцедуры,
		ПараметрыВыполнения);
	
	Если ДлительнаяОперация.Статус = "Выполняется" Тогда
		
		ОбработчикОжиданияДлительнойОперации = "ЗаполнитьДанныеЭтаповОтложенноЗавершение";
		НачатьОжиданиеДлительнойОперации = Истина;
		
	Иначе
		
		ЗаполнитьДанныеЭтаповОтложенно(ДлительнаяОперация);
		
		НачатьОжиданиеДлительнойОперации = Ложь;
		ДлительнаяОперация = Неопределено;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьДанныеЭтаповОтложенноЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ДлительнаяОперация = Неопределено;
	
	Если Результат <> Неопределено Тогда
		
		ЗаполнитьДанныеЭтаповОтложенно(Результат);
		НастроитьОжиданиеВФорме(ЭтотОбъект, Ложь);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДанныеЭтаповОтложенно(Результат)
	
	Если Результат.Статус = "Выполнено" Тогда
		
		ДанныеЗаполнения = ПолучитьИзВременногоХранилища(Результат.АдресРезультата);
		
		Если РежимИзДокумента Тогда
			
			Этапы.Загрузить(ДанныеЗаполнения.Этапы);
			ОстаткиАналогов.Загрузить(ДанныеЗаполнения.ОстаткиАналогов);
			Аналоги.Загрузить(ДанныеЗаполнения.Аналоги);
			УстановитьОтборСтрок();
			
		Иначе
			
			Этапы.Загрузить(ДанныеЗаполнения.Этапы);
			Нормативы.Загрузить(ДанныеЗаполнения.Нормативы);
			
			ОбновитьКолонкуДоступно();
		
		КонецЕсли;
		
		УстановитьГиперссылкуЗаменяемогоМатериала();
		УстановитьВидимостьЭлементов();
		
	Иначе
		
		Если Результат.Статус = "Ошибка" Тогда
			
			ВызватьИсключение Результат.КраткоеПредставлениеОшибки;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция СоответствиеОстатков(Склад, Назначение)

	ПоискОстатков = Новый Структура("Склад, Назначение");
	ПоискОстатков.Склад = Склад;
	ПоискОстатков.Назначение = ПредопределенноеЗначение("Справочник.Назначения.ПустаяСсылка");
	
	СвободныеОстатки = ОстаткиАналогов.НайтиСтроки(ПоискОстатков);
	
	Соответствие = Новый Соответствие;
	Для каждого СтрокаТаблицы Из СвободныеОстатки Цикл
		
		ТекущийОстаток = СтрокаТаблицы.Свободно - СтрокаТаблицы.Использовано;
		
		ЗначениеСоответствия = Соответствие.Получить(СтрокаТаблицы.Номенклатура);
		
		Если ЗначениеСоответствия = Неопределено Тогда
			
			СоответствиеОстатка = Новый Соответствие;
			СоответствиеОстатка.Вставить(СтрокаТаблицы.Характеристика, ТекущийОстаток); 
			Соответствие.Вставить(СтрокаТаблицы.Номенклатура, СоответствиеОстатка);
			
		Иначе
			
			ЗначениеСоответствия.Вставить(СтрокаТаблицы.Характеристика, ТекущийОстаток); 
		
		КонецЕсли;
	
	КонецЦикла;
	
	Если ЗначениеЗаполнено(Назначение) Тогда
	
		ПоискОстатков.Назначение = Назначение;
		ОстаткиПоНазначению = ОстаткиАналогов.НайтиСтроки(ПоискОстатков);
		
		Для каждого СтрокаТаблицы Из ОстаткиПоНазначению Цикл
			
			ТекущийОстаток = СтрокаТаблицы.Свободно - СтрокаТаблицы.Использовано;
			
			ЗначениеСоответствия = Соответствие.Получить(СтрокаТаблицы.Номенклатура);
			
			Если ЗначениеСоответствия = Неопределено Тогда
				
				СоответствиеОстатка = Новый Соответствие;
				СоответствиеОстатка.Вставить(СтрокаТаблицы.Характеристика, ТекущийОстаток); 
				Соответствие.Вставить(СтрокаТаблицы.Номенклатура, СоответствиеОстатка);
				
			Иначе
				
				СвободныйОстаток = ЗначениеСоответствия.Получить(СтрокаТаблицы.Характеристика);
				ТекущийОстаток = ТекущийОстаток + ?(СвободныйОстаток = Неопределено, 0, СвободныйОстаток);
				ЗначениеСоответствия.Вставить(СтрокаТаблицы.Характеристика, ТекущийОстаток);
			
			КонецЕсли;
		
		КонецЦикла;
	
	КонецЕсли;
	
	Возврат Соответствие;

КонецФункции

&НаКлиенте
Функция ОстатокАналогаИзСоответствия(ОстаткиАналоговСоответствие, Номенклатура, Характеристика)

	Остаток = 0;
	
	ЗначениеСоответствия = ОстаткиАналоговСоответствие.Получить(Номенклатура);
	
	Если ЗначениеСоответствия <> Неопределено Тогда
			
		ОстаткиПоХарактеристике = ЗначениеСоответствия.Получить(Характеристика);
		Если ОстаткиПоХарактеристике <> Неопределено Тогда
			Остаток = ОстаткиПоХарактеристике;
		КонецЕсли;
	
	КонецЕсли;
	
	Возврат Остаток;

КонецФункции

&НаКлиенте
Функция КоэффициентПересчета()
	
	ТекущиеДанныеАналог = Элементы.Аналоги.ТекущиеДанные;
	ТекущиеДанныеМатериал = Элементы.Этапы.ТекущиеДанные;
	
	ТекущееРазрешение = ТекущиеДанныеАналог.Разрешение;
	КлючСвязи = ТекущиеДанныеАналог.КлючСвязи;
	
	СтруктураПоиска = Новый Структура();
	СтруктураПоиска.Вставить("Разрешение", ТекущееРазрешение);
	СтруктураПоиска.Вставить("КлючСвязи", КлючСвязи);
	
	МассивСтрок = Аналоги.НайтиСтроки(СтруктураПоиска);
	Коэффициент = -1;
	
	Для каждого СтрокаТЗ Из МассивСтрок Цикл
	
		Если СтрокаТЗ.ЭтоАналог Тогда
			Количество = СтрокаТЗ.ОстатокНаСкладе;
		Иначе
			
			Если СтрокаТЗ.Номенклатура = ТекущиеДанныеМатериал.Номенклатура
			   И СтрокаТЗ.Характеристика = ТекущиеДанныеМатериал.Характеристика Тогда
			
				Количество = ТекущиеДанныеМатериал.Всего - ТекущиеДанныеМатериал.КЗамене;
			
			Иначе	
				Количество = КоличествоМатериала(СтрокаТЗ.Номенклатура, СтрокаТЗ.Характеристика);
			КонецЕсли;
			
		КонецЕсли;
			
		КоэффициентПоНормативу = ПроизводствоКлиентСервер.КоэффициентПоНормативу(
			СтрокаТЗ.КонтролироватьКратность, Количество, СтрокаТЗ.Норматив, СтрокаТЗ.ДанныеУпаковки);
				
		Если Коэффициент = -1 Тогда
			Коэффициент = КоэффициентПоНормативу;
		Иначе
			Коэффициент = Мин(Коэффициент, КоэффициентПоНормативу);
		КонецЕсли;
	
	КонецЦикла;
	
	Возврат Коэффициент;

КонецФункции

&НаКлиенте
Процедура ПроверитьВозможностьПересчета(КоэффициентРасчета, Отказ)

	ТекущиеДанныеАналоги = Элементы.Аналоги.ТекущиеДанные;
	
	КоэффициентНорматива = ПроизводствоКлиентСервер.КоэффициентПоНормативу(
		Ложь, ТекущиеДанныеАналоги.Количество, ТекущиеДанныеАналоги.Норматив, ТекущиеДанныеАналоги.ДанныеУпаковки);
	
	Если ТекущиеДанныеАналоги.КонтролироватьКратность И КоэффициентНорматива <> Цел(КоэффициентНорматива) Тогда
		
		ТекстСообщения = НСтр("ru = 'Введите количество кратное нормативу.';
								|en = 'Enter the amount multiple of the standard'");
		
	ИначеЕсли ТекущиеДанныеАналоги.Количество > АналогиКоличествоДоИзменения Тогда
		
		ПоискМатериалов = Новый Структура;
		ПоискМатериалов.Вставить("Разрешение", ТекущиеДанныеАналоги.Разрешение);
		ПоискМатериалов.Вставить("КлючСвязи", ТекущиеДанныеАналоги.КлючСвязи);
		ПоискМатериалов.Вставить("ЭтоАналог", Ложь);
		
		ОтборМатериал = Новый Структура("Номенклатура, Характеристика");
		
		МассивМатериалов = Аналоги.НайтиСтроки(ПоискМатериалов);
		
		Для каждого СтрокаМатериал Из МассивМатериалов Цикл
		
			ЗаполнитьЗначенияСвойств(ОтборМатериал, СтрокаМатериал);
			СтрокиМатериалов = Этапы.НайтиСтроки(ОтборМатериал);
			МатериалыНорматив = СтрокаМатериал.Норматив;
			ОставшеесяКоличество = 0;
			
			Для каждого СтрокаТЗ Из СтрокиМатериалов Цикл
				ОставшеесяКоличество = ОставшеесяКоличество + СтрокаТЗ.Всего - СтрокаТЗ.КЗамене;
			КонецЦикла;
			
			ТребуетсяЗаменить = РасчетноеКоличествоНоменклатуры(МатериалыНорматив, КоэффициентРасчета, СтрокаМатериал.ДанныеУпаковки); 
			
			Если ТребуетсяЗаменить > ОставшеесяКоличество Тогда
				
				Шаблон = НСтр("ru = 'Для выполнения замены не хватает %1 %2 выбранного материала %3';
								|en = '%1 %2 of the selected material %3 is missing to complete the replacement'");
				
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					Шаблон, 
					Окр(ТребуетсяЗаменить - ОставшеесяКоличество, 3),
					СтрокаМатериал.ЕдиницаИзмеренияПредставление,
					НоменклатураКлиентСервер.ПредставлениеНоменклатуры(СтрокаМатериал.НоменклатураПредставление, СтрокаМатериал.ХарактеристикаПредставление));
					
				Прервать;
			
			КонецЕсли;
		
		КонецЦикла;
		
	КонецЕсли;
	
	Если НЕ ПустаяСтрока(ТекстСообщения) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения,,,, Отказ);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОбработатьПодборАналогов(Коэффициент)
	
	ТекущиеДанныеМатериал = Элементы.Этапы.ТекущиеДанные;
	ТекущиеДанные = Элементы.Аналоги.ТекущиеДанные;
	
	ТекущееРазрешение = ТекущиеДанные.Разрешение;
	КлючСвязи = ТекущиеДанные.КлючСвязи;
	
	НомераСтрокМатериалов = Новый Соответствие;
	ДанныеСтрокиМатериалов = Новый Соответствие;
	СтрокиАналогов = Новый Массив;
	КоличествоРазличныхМатериалов = 0;
	
	СтруктураПоиска = Новый Структура;
	СтруктураПоиска.Вставить("Разрешение", ТекущееРазрешение);
	СтруктураПоиска.Вставить("КлючСвязи", КлючСвязи);
		
	ОтборМатериал = Новый Структура("Номенклатура, Характеристика");
	
	МассивСтрок = Аналоги.НайтиСтроки(СтруктураПоиска);
	
	Для каждого СтрокаТЗ Из МассивСтрок Цикл
		
		Если СтрокаТЗ.ЭтоАналог Тогда
		
			КоличествоКСписанию = РасчетноеКоличествоНоменклатуры(СтрокаТЗ.Норматив, Коэффициент, СтрокаТЗ.ДанныеУпаковки);
			СтрокиАналогов.Добавить(СтрокаТЗ);
		
			СтрокаТЗ.Количество = СтрокаТЗ.Количество + КоличествоКСписанию;
			
			ПоискОстатков = Новый Структура();
			ПоискОстатков.Вставить("Номенклатура", СтрокаТЗ.Номенклатура);
			ПоискОстатков.Вставить("Характеристика", СтрокаТЗ.Характеристика);
			ПоискОстатков.Вставить("Назначение", ТекущиеДанныеМатериал.Назначение);
			ПоискОстатков.Вставить("Склад", СтрокаТЗ.Склад);
			
			ОстаткиПоНазначению = ОстаткиАналогов.НайтиСтроки(ПоискОстатков);
			Для каждого СтрокаОстаток Из ОстаткиПоНазначению Цикл
				
				Если Коэффициент > 0 Тогда
				
					ОстатокДоИзменения = СтрокаОстаток.Свободно - СтрокаОстаток.Использовано;
					Если ОстатокДоИзменения > 0 Тогда
						ОстатокКСписанию = Мин(ОстатокДоИзменения, КоличествоКСписанию);
						КоличествоКСписанию = КоличествоКСписанию - ОстатокКСписанию;
						СтрокаОстаток.Использовано = СтрокаОстаток.Использовано + ОстатокКСписанию;
					КонецЕсли;
					
				Иначе
					
					ОстатокКСписанию = Мин(СтрокаОстаток.Использовано, -КоличествоКСписанию);
					СтрокаОстаток.Использовано = СтрокаОстаток.Использовано - ОстатокКСписанию;
					КоличествоКСписанию = КоличествоКСписанию + ОстатокКСписанию;
					
				КонецЕсли;
				
			КонецЦикла;
			
			Если КоличествоКСписанию <> 0 Тогда
			
				ПоискОстатков.Назначение = ПредопределенноеЗначение("Справочник.Назначения.ПустаяСсылка");
				СвободныеОстатки = ОстаткиАналогов.НайтиСтроки(ПоискОстатков);
				Для каждого СтрокаОстаток Из СвободныеОстатки Цикл
					
					Если Коэффициент > 0 Тогда
					
						СтрокаОстаток.Использовано = СтрокаОстаток.Использовано + КоличествоКСписанию;
					
					Иначе
					
						ОстатокКСписанию = Мин(СтрокаОстаток.Использовано, -КоличествоКСписанию);
						СтрокаОстаток.Использовано = СтрокаОстаток.Использовано - ОстатокКСписанию;
					
					КонецЕсли;
					
				КонецЦикла;
				
			КонецЕсли;
			
		Иначе
			
			КоличествоРазличныхМатериалов = КоличествоРазличныхМатериалов + 1;
			КоличествоКРаспределению = РасчетноеКоличествоНоменклатуры(СтрокаТЗ.Норматив, Коэффициент, СтрокаТЗ.ДанныеУпаковки);
			
			Если СтрокаТЗ.Номенклатура = ТекущиеДанныеМатериал.Номенклатура
			   И СтрокаТЗ.Характеристика = ТекущиеДанныеМатериал.Характеристика Тогда
			
				Если Коэффициент > 0 Тогда
					КоличествоКСписанию = Мин(ТекущиеДанныеМатериал.Всего - ТекущиеДанныеМатериал.КЗамене, КоличествоКРаспределению);
				Иначе
					КоличествоКСписанию = Макс(КоличествоКРаспределению, -ТекущиеДанныеМатериал.КЗамене);;
				КонецЕсли;
				
				КоличествоКРаспределению = КоличествоКРаспределению - КоличествоКСписанию;
				
				ТекущиеДанныеМатериал.КЗамене = ТекущиеДанныеМатериал.КЗамене + КоличествоКСписанию;
				ТекущиеДанныеМатериал.Выбран = ТекущиеДанныеМатериал.КЗамене > 0;
				НомераСтрокМатериалов.Вставить(ТекущиеДанныеМатериал.НомерСтрокиДокумент, КоличествоКСписанию);
				ДанныеСтрокиМатериалов.Вставить(ТекущиеДанныеМатериал.НомерСтрокиДокумент, 
					Новый Структура("Материал, ХарактеристикаМатериала", ТекущиеДанныеМатериал.Номенклатура, ТекущиеДанныеМатериал.Характеристика));
				
			КонецЕсли;
			
			Если КоличествоКРаспределению <> 0 Тогда
			
				ЗаполнитьЗначенияСвойств(ОтборМатериал, СтрокаТЗ);
				МассивМатериалов = Этапы.НайтиСтроки(ОтборМатериал);
				
				Для каждого СтрокаМатериал Из МассивМатериалов Цикл
					
					Если КоличествоКРаспределению = 0 Тогда
						Прервать;
					КонецЕсли;
					
					Если СтрокаМатериал.НомерСтрокиДокумент = ТекущиеДанныеМатериал.НомерСтрокиДокумент Тогда
						Продолжить;
					КонецЕсли;
					
					Если Коэффициент > 0 Тогда
						КоличествоКСписанию = Мин(СтрокаМатериал.Всего - СтрокаМатериал.КЗамене, КоличествоКРаспределению);
					Иначе
						КоличествоКСписанию = Макс(КоличествоКРаспределению, -СтрокаМатериал.КЗамене);
					КонецЕсли;
					
					Если КоличествоКСписанию <> 0 Тогда
						
						КоличествоКРаспределению = КоличествоКРаспределению - КоличествоКСписанию;
						
						СтрокаМатериал.КЗамене = СтрокаМатериал.КЗамене + КоличествоКСписанию;
						СтрокаМатериал.Выбран = СтрокаМатериал.КЗамене > 0;
						НомераСтрокМатериалов.Вставить(СтрокаМатериал.НомерСтрокиДокумент, КоличествоКСписанию);
						ДанныеСтрокиМатериалов.Вставить(СтрокаМатериал.НомерСтрокиДокумент, 
							Новый Структура("Материал, ХарактеристикаМатериала", СтрокаМатериал.Номенклатура, СтрокаМатериал.Характеристика));
						
					КонецЕсли;
					
				КонецЦикла;
			
			КонецЕсли;
				
		КонецЕсли;
		
	КонецЦикла;
	
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("Разрешение");
	ПараметрыОтбора.Вставить("КлючСвязи");
	ПараметрыОтбора.Вставить("Номенклатура");
	ПараметрыОтбора.Вставить("Характеристика");
	ПараметрыОтбора.Вставить("НомерСтрокиДокумент");
	
	ОтборПоНоменклатуре = Новый Структура("Номенклатура, Характеристика, ЭтоАналог");
	ОтборПоНоменклатуре.ЭтоАналог = Истина;
	
	ОтборАналогов = Новый Структура("Номенклатура, Характеристика, Склад");
	
	ОстаткиАналоговСоответствие = СоответствиеОстатков(ТекущиеДанныеМатериал.Склад, ТекущиеДанныеМатериал.Назначение);
	
	Для Каждого СтрокаКОбработке Из СтрокиАналогов Цикл
		
		ДобавленноеКоличество = РасчетноеКоличествоНоменклатуры(СтрокаКОбработке.Норматив, Коэффициент, СтрокаКОбработке.ДанныеУпаковки); 
		ЗаполнитьЗначенияСвойств(ОтборПоНоменклатуре, СтрокаКОбработке,, "ЭтоАналог");
		МассивАналогов = Аналоги.НайтиСтроки(ОтборПоНоменклатуре);
		
		Для Каждого СтрокаАналог Из МассивАналогов Цикл
			
			СтрокаАналог.ОстатокНаСкладе = ОстатокАналогаИзСоответствия(
				ОстаткиАналоговСоответствие,
				СтрокаАналог.Номенклатура,
				СтрокаАналог.Характеристика);
				
			СтрокаАналог.ЕстьОстатки = СтрокаАналог.ОстатокНаСкладе > 0;
			
		КонецЦикла;
		
		ЗаполнитьЗначенияСвойств(ПараметрыОтбора, СтрокаКОбработке, "Разрешение, КлючСвязи, Номенклатура, Характеристика");
		
		Для каждого КлючЗначение Из НомераСтрокМатериалов Цикл
		
			ПараметрыОтбора.НомерСтрокиДокумент = КлючЗначение.Ключ;
			НайденныеСтроки = ИспользованныеАналогиПострочно.НайтиСтроки(ПараметрыОтбора);
			
			КоличествоКУчету = РасчетноеКоличествоНоменклатуры(СтрокаКОбработке.Норматив, КлючЗначение.Значение, СтрокаКОбработке.ДанныеУпаковки);
			
			Если НайденныеСтроки.Количество() = 0 Тогда
				
				СтрокаИспользования = ИспользованныеАналогиПострочно.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаИспользования, ПараметрыОтбора);
				
				ДанныеСтроки = ДанныеСтрокиМатериалов.Получить(КлючЗначение.Ключ);
				ЗаполнитьЗначенияСвойств(СтрокаИспользования, ДанныеСтроки, "Материал, ХарактеристикаМатериала");
				
				СтрокаИспользования.НесколькоМатериалов = КоличествоРазличныхМатериалов > 1;
				СтрокаИспользования.Количество = КоличествоКУчету;
				
			Иначе
				
				СтрокаИспользования = НайденныеСтроки[0];
				СтрокаИспользования.Количество = СтрокаИспользования.Количество + КоличествоКУчету;
				
			КонецЕсли;
		
		КонецЦикла;
		
		ЗаполнитьЗначенияСвойств(ОтборАналогов, СтрокаКОбработке);
		НайденныеСтрокиАналогов = ИспользованныеАналоги.НайтиСтроки(ОтборАналогов);
		Если НайденныеСтрокиАналогов.Количество() = 0 Тогда
			
			СтрокаНайденныхАналогов = ИспользованныеАналоги.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаНайденныхАналогов, ОтборАналогов);
			СтрокаНайденныхАналогов.Количество = ДобавленноеКоличество;
			
		Иначе	
			
			СтрокаИспользования = НайденныеСтрокиАналогов[0];
			СтрокаИспользования.Количество = СтрокаИспользования.Количество + ДобавленноеКоличество;
			
		КонецЕсли;
		
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Функция КоличествоМатериала(Номенклатура, Характеристика)

	ПоискМатериала = Новый Структура("Номенклатура, Характеристика", Номенклатура, Характеристика);
	МассивМатериалов = Этапы.НайтиСтроки(ПоискМатериала);
	
	ОставшеесяКоличество = 0;
	
	Для Каждого СтрокаТЗ Из МассивМатериалов Цикл
	
		ОставшеесяКоличество = ОставшеесяКоличество + СтрокаТЗ.Всего - СтрокаТЗ.КЗамене;
	
	КонецЦикла;
	
	Возврат ОставшеесяКоличество;

КонецФункции

&НаКлиенте
Функция ИспользованноеКоличествоАналога(Разрешение, КлючСвязи, Номенклатура, Характеристика, НомерСтрокиДокумент)

	СтруктураПоиска = Новый Структура;
	СтруктураПоиска.Вставить("Разрешение", Разрешение);
	СтруктураПоиска.Вставить("КлючСвязи", КлючСвязи);
	СтруктураПоиска.Вставить("Номенклатура", Номенклатура);
	СтруктураПоиска.Вставить("Характеристика", Характеристика);
	СтруктураПоиска.Вставить("НомерСтрокиДокумент", НомерСтрокиДокумент);
	
	Количество = 0;
	
	Для Каждого СтрокаТЗ Из ИспользованныеАналогиПострочно.НайтиСтроки(СтруктураПоиска) Цикл
	
		Количество = Количество + СтрокаТЗ.Количество;
	
	КонецЦикла;
	
	Возврат Количество;

КонецФункции

&НаСервере
Процедура ОбработатьИзменениеФлага(ЗначениеФлага)
	
	ПоискСвязанныхСтрок = Новый Структура("Этап, КлючСвязи");
	
	Дерево = РеквизитФормыВЗначение("ДеревоЗамен");
	СтрокиПоНоменклатуре = Дерево.Строки;
	ТаблицаОстатковАналогов = ОстаткиАналогов.Выгрузить();
	ТаблицаОстатковАналогов.Индексы.Добавить("Номенклатура, Характеристика, Склад, Назначение");
	
	Для каждого Идентификатор Из Элементы.Этапы.ВыделенныеСтроки Цикл
		
		СтрокаТаблицы = Этапы.НайтиПоИдентификатору(Идентификатор);
		СтрокаТаблицы.Выбран = ЗначениеФлага;
		
		Если СтрокаТаблицы.Этап = ПоискСвязанныхСтрок.Этап
		   И СтрокаТаблицы.КлючСвязи = ПоискСвязанныхСтрок.КлючСвязи Тогда
			Продолжить;
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(ПоискСвязанныхСтрок, СтрокаТаблицы);
		
		СтрокиПоКлючу = Этапы.НайтиСтроки(ПоискСвязанныхСтрок);
		
		КоличествоНаборовОбработать = Неопределено;
		
		Для Каждого СтрокаЭтапов Из СтрокиПоКлючу Цикл
			
			СтрокаЭтапов.Выбран = ЗначениеФлага;
			
			Если СтрокаЭтапов.Выбран Тогда
				КЗамене = СтрокаЭтапов.Всего - СтрокаЭтапов.Отгружено;
			Иначе
				КЗамене = 0;
			КонецЕсли;
			
			КоличествоНаборов = ПроизводствоКлиентСервер.КоэффициентПоНормативу(
				Ложь, КЗамене - СтрокаЭтапов.КЗаменеДоИзменения, СтрокаЭтапов.Норматив, СтрокаЭтапов.ДанныеУпаковки);
			
			Если КоличествоНаборовОбработать = Неопределено Тогда
				КоличествоНаборовОбработать = КоличествоНаборов;
			ИначеЕсли ЗначениеФлага Тогда
				КоличествоНаборовОбработать = Мин(КоличествоНаборовОбработать, КоличествоНаборов);
			Иначе
				КоличествоНаборовОбработать = Макс(КоличествоНаборовОбработать, КоличествоНаборов);
			КонецЕсли;
			
		КонецЦикла;
		
		Если СтрокаТаблицы.Выбран Тогда
			РасчетноеКоличество = РасчетноеКоличествоНоменклатуры(
				СтрокаТаблицы.Норматив, КоличествоНаборовОбработать, СтрокаТаблицы.ДанныеУпаковки);
			КЗаменеУстановить = СтрокаТаблицы.КЗамене + РасчетноеКоличество;
		Иначе
			КЗаменеУстановить = 0;
		КонецЕсли;
		
		Если КоличествоНаборовОбработать <> 0 Тогда
			ОбработатьИзменение(СтрокиПоНоменклатуре, ТаблицаОстатковАналогов, СтрокаТаблицы.Этап, СтрокаТаблицы.КлючСвязи, КоличествоНаборовОбработать, СтрокаТаблицы);
		КонецЕсли;
		
		СтрокаТаблицы.КЗамене = КЗаменеУстановить;
		СтрокаТаблицы.КЗаменеДоИзменения = СтрокаТаблицы.КЗамене;
		СтрокаТаблицы.Выбран = СтрокаТаблицы.КЗамене > 0;
	
	КонецЦикла;
	
	ЗначениеВРеквизитФормы(Дерево, "ДеревоЗамен");
	
	ОбновитьКолонкуДоступно(ТаблицаОстатковАналогов);

КонецПроцедуры

&НаСервере
Процедура ОбновитьКолонкуДоступно(ТаблицаОстатков = Неопределено)
	
	ТаблицаЭтапов = Этапы.Выгрузить();
	
	СтруктураДанныхФормы = Новый Структура;
	ЗаполнитьСтруктуруРеквизитамиФормы(СтруктураДанныхФормы);
	СтруктураДанныхФормы.Вставить("ОстаткиАналогов", ОстаткиАналогов.Выгрузить());
	СтруктураДанныхФормы.Вставить("Нормативы", Нормативы.Выгрузить());
	
	Документы.РазрешениеНаЗаменуМатериалов.ОбновитьКолонкуДоступно(СтруктураДанныхФормы, ТаблицаЭтапов, ТаблицаОстатков);
	
	Этапы.Загрузить(ТаблицаЭтапов);
	ОстаткиАналогов.Загрузить(ТаблицаОстатков);
		
КонецПроцедуры

&НаСервере
Процедура ИнициализироватьДанные()

	ДанныеДерева = ДеревоЗамен.ПолучитьЭлементы();
	ДанныеДерева.Очистить();
	
	Для каждого СтрокаТЗ Из ОстаткиАналогов Цикл
		СтрокаТЗ.Использовано = 0;
		СтрокаТЗ.ИспользованоСверхОстатка = 0;
	КонецЦикла;
	
	Для каждого СтрокаТаблицы Из Этапы Цикл
		СтрокаТаблицы.КЗамене = 0;
		СтрокаТаблицы.КЗаменеДоИзменения = 0;
		СтрокаТаблицы.Выбран = Ложь;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ЗаменитьНаАналогиНаСервере()
		
	Дерево = РеквизитФормыВЗначение("ДеревоЗамен");
	
	Если Дерево.Строки.Количество() = 0 Тогда
		
		НачатьОжиданиеДлительнойОперации = Ложь;
		ТекстСообщения = НСтр("ru = 'Не выбраны строки к замене на аналоги';
								|en = 'Lines for replacing with substitutes are not selected'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,, "Этапы");
		Возврат;
	
	КонецЕсли;
	
	ТаблицаМатериалов = Новый ТаблицаЗначений;
	ТаблицаМатериалов.Колонки.Добавить("Ссылка", Новый ОписаниеТипов("ДокументСсылка.ЭтапПроизводства2_2"));
	ТаблицаМатериалов.Колонки.Добавить("Представление", Новый ОписаниеТипов("Строка"));
	ТаблицаМатериалов.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТаблицаМатериалов.Колонки.Добавить("Характеристика", Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
	ТаблицаМатериалов.Колонки.Добавить("Назначение", Новый ОписаниеТипов("СправочникСсылка.Назначения"));
	ТаблицаМатериалов.Колонки.Добавить("Количество", ОбщегоНазначения.ОписаниеТипаЧисло(15,3));
	
	ТаблицаАналогов = Новый ТаблицаЗначений;
	ТаблицаАналогов.Колонки.Добавить("Ссылка", Новый ОписаниеТипов("ДокументСсылка.ЭтапПроизводства2_2"));
	ТаблицаАналогов.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТаблицаАналогов.Колонки.Добавить("Характеристика", Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
	ТаблицаАналогов.Колонки.Добавить("Назначение", Новый ОписаниеТипов("СправочникСсылка.Назначения"));
	ТаблицаАналогов.Колонки.Добавить("Склад", Новый ОписаниеТипов("СправочникСсылка.Склады"));
	ТаблицаАналогов.Колонки.Добавить("Количество", ОбщегоНазначения.ОписаниеТипаЧисло(15,3));
	
	Для каждого СтрокаДерева Из Дерево.Строки Цикл
	
		Если СтрокаДерева.Флаг = 0 Тогда
			
			Для каждого СтрокаРасшифровки Из СтрокаДерева.Строки Цикл
			
				НоваяСтрока = ТаблицаАналогов.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаРасшифровки);
				НоваяСтрока.Ссылка = СтрокаРасшифровки.Этап;
			
			КонецЦикла;	
		
		ИначеЕсли СтрокаДерева.Флаг = 1 Тогда
		
			Для каждого СтрокаРасшифровки Из СтрокаДерева.Строки Цикл
			
				НоваяСтрока = ТаблицаМатериалов.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаРасшифровки);
				НоваяСтрока.Ссылка = СтрокаРасшифровки.Этап;
				НоваяСтрока.Представление = СтрокаРасшифровки.ПредставлениеЗаказа;
			
			КонецЦикла;
		
		КонецЕсли;
	
	КонецЦикла;
	
	// Запуск формирования
	ОтменитьДлительнуюОперацию();
	
	ТаблицаМатериалов.Сортировать("Ссылка", Новый СравнениеЗначений);
	ТаблицаАналогов.Сортировать("Ссылка", Новый СравнениеЗначений);
	
	МассивСсылок = ОбщегоНазначения.ВыгрузитьКолонку(ТаблицаМатериалов, "Ссылка", Истина);
		
	ПараметрыДляОбработки = Новый Структура;
	ПараметрыДляОбработки.Вставить("ТаблицаЭтаповДляОбработки", ТаблицаМатериалов);
	ПараметрыДляОбработки.Вставить("ТаблицаАналогов", ТаблицаАналогов);
	ПараметрыДляОбработки.Вставить("МассивСсылок", МассивСсылок);
	
	АдресРезультатФормирования = ПоместитьВоВременноеХранилище(
		Документы.РазрешениеНаЗаменуМатериалов.РезультатФормирования(), УникальныйИдентификатор);
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = НСтр("ru = 'Помощник выполнения замен: замена на аналоги';
															|en = 'Replacement wizard: replace with substitutes'");
	ПараметрыВыполнения.АдресРезультата = АдресРезультатФормирования;
	
	ДлительнаяОперация = ДлительныеОперации.ВыполнитьВФоне(
		"Документы.РазрешениеНаЗаменуМатериалов.ЗаменитьНаАналогиВЭтапахПроизводстваОтложенно",
		ПараметрыДляОбработки,
		ПараметрыВыполнения);
	
	Если ДлительнаяОперация.Статус = "Выполняется" Тогда
		
		ОбработчикОжиданияДлительнойОперации = "ЗаменитьНаАналогиВЭтапахПроизводстваОтложенноЗавершение";
		НачатьОжиданиеДлительнойОперации = Истина;
		
	Иначе
		
		ЗаменитьНаАналогиОтложенно(ДлительнаяОперация);
		
		НачатьОжиданиеДлительнойОперации = Ложь;
		ДлительнаяОперация = Неопределено;
		
		Если ПеречитатьДанныеПослеЗамены Тогда
			
			ТекстОперации = НСтр("ru = 'Выполняется получение данных...';
								|en = 'Receiving data…'");
			НастроитьОжиданиеВФорме(ЭтотОбъект, Истина, ТекстОперации);
			ЗаполнитьДанныеФормыНаСервере();
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаменитьНаАналогиВЭтапахПроизводстваОтложенноЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ДлительнаяОперация = Неопределено;
	НастроитьОжиданиеВФорме(ЭтотОбъект, Ложь);
	
	ЗаменитьНаАналогиОтложенно(Результат);
	
	Если Результат <> Неопределено И Результат.Статус = "Ошибка" Тогда
		ПоказатьПредупреждение(, Результат.КраткоеПредставлениеОшибки);
	КонецЕсли;
	
	Если ПеречитатьДанныеПослеЗамены Тогда
		
		ОбновитьДанныеЭтаповНаФорме();
		
	КонецЕсли
	
КонецПроцедуры

&НаСервере
Процедура ЗаменитьНаАналогиОтложенно(Результат)
	
	ЗаданиеЗавершено = Ложь;
	
	Если ЭтоАдресВременногоХранилища(АдресРезультатФормирования) Тогда
		
		СтруктураРезультата = ПолучитьИзВременногоХранилища(АдресРезультатФормирования);
		АдресРезультатФормирования = Неопределено;
		
		ТекстСообщения = НСтр("ru = 'Завершен процесс замены материалов на аналоги';
								|en = 'Material replacement with substitutes completed'");
		
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		ЗаданиеЗавершено = Истина;
		
		Для каждого СтрокаТЧ Из СтруктураРезультата.Ошибки Цикл
		
			ОбщегоНазначения.СообщитьПользователю(СтрокаТЧ.ТекстСообщения);
		
		КонецЦикла;
				
	КонецЕсли;
	
	Если ТипЗнч(Результат) = Тип("Структура")
		И ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Результат, "Сообщения") Тогда
		Для Каждого Сообщение Из Результат.Сообщения Цикл
			Сообщение.Сообщить();
		КонецЦикла;
	КонецЕсли;
	
	Если Результат = Неопределено
		Или Результат.Статус <> "Выполнено" Тогда
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Документы обработаны не полностью';
													|en = 'Documents are not fully processed'"));
	КонецЕсли;
	
	Если ЗаданиеЗавершено Тогда
	
		Элементы.СтраницыФормы.ТекущаяСтраница = Элементы.СтраницаМатериаловИАналогов;
		Элементы.ЗаменитьНаАналоги.Видимость = Истина;
		Элементы.ФормаПеречитать.Видимость = Истина;
		ПоложениеКоманднойПанели = ПоложениеКоманднойПанелиФормы.Авто;
		ПеречитатьДанныеПослеЗамены = Истина;
	
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОтменитьДлительнуюОперацию()
	
	Если НЕ ДлительнаяОперация = Неопределено Тогда
		ДлительныеОперации.ОтменитьВыполнениеЗадания(ДлительнаяОперация.ИдентификаторЗадания);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбработатьРучноеИзменение(Этап, КлючСвязи, КоличествоНаборов)
	
	Дерево = РеквизитФормыВЗначение("ДеревоЗамен");
	СтрокиПоНоменклатуре = Дерево.Строки;
	
	ТаблицаОстатковАналогов = ОстаткиАналогов.Выгрузить();
	ТаблицаОстатковАналогов.Индексы.Добавить("Номенклатура, Характеристика, Склад, Назначение");
	
	ОбновитьДоступность = ОбработатьИзменение(СтрокиПоНоменклатуре, ТаблицаОстатковАналогов, Этап, КлючСвязи, КоличествоНаборов);
	
	ОстаткиАналогов.Загрузить(ТаблицаОстатковАналогов);
	
	ЗначениеВРеквизитФормы(Дерево, "ДеревоЗамен");
	
	Если ОбновитьДоступность Тогда
		
		ТаблицаОстатков = ОстаткиАналогов.Выгрузить();
		ТаблицаОстатков.Индексы.Добавить("Номенклатура, Характеристика, Назначение, Склад");
		ОбновитьКолонкуДоступно(ТаблицаОстатков);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ОбработатьИзменение(СтрокиПоНоменклатуре, ТаблицаОстатковАналогов, Этап, КлючСвязи, КоличествоНаборов, СтрокаЭтапа = Неопределено)
	
	СтруктураДанныхФормы = Новый Структура;
	ЗаполнитьСтруктуруРеквизитамиФормы(СтруктураДанныхФормы);
	СтруктураДанныхФормы.Вставить("Этапы", Этапы);
	СтруктураДанныхФормы.Вставить("Нормативы", Нормативы.Выгрузить());
	
	Если СтрокаЭтапа = Неопределено Тогда
		ВыделеннаяСтрока = Этапы.НайтиПоИдентификатору(Элементы.Этапы.ТекущаяСтрока);
	Иначе
		ВыделеннаяСтрока = СтрокаЭтапа;
	КонецЕсли;
	
	Возврат Документы.РазрешениеНаЗаменуМатериалов.ОбработатьИзменение(
		СтруктураДанныхФормы, СтрокиПоНоменклатуре, ТаблицаОстатковАналогов, Этап, КлючСвязи, КоличествоНаборов, ВыделеннаяСтрока, Ложь);

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция РасчетноеКоличествоНоменклатуры(Норматив, КоэффициентПересчета, ДанныеУпаковки)
	
	РасчетноеКоличество = Норматив * КоэффициентПересчета
		* ДанныеУпаковки.Числитель / ДанныеУпаковки.Знаменатель;
			
	ТекущееКоличество = Цел(РасчетноеКоличество);
	Если РасчетноеКоличество > ТекущееКоличество Тогда
		ТекущееКоличество = ТекущееКоличество + Цел((РасчетноеКоличество - ТекущееКоличество) * 1000) / 1000;
	КонецЕсли;
	
	Возврат РасчетноеКоличество;

КонецФункции

&НаСервере
Функция РезультатПодбора()

	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	ТаблицаМатериалов.НомерСтрокиДокумент КАК НомерСтрокиДокумент,
	|	ТаблицаМатериалов.Номенклатура КАК Номенклатура,
	|	ТаблицаМатериалов.Характеристика КАК Характеристика,
	|	ТаблицаМатериалов.Склад КАК Склад,
	|	ТаблицаМатериалов.Всего КАК Всего,
	|	ТаблицаМатериалов.КЗамене КАК КЗамене
	|ПОМЕСТИТЬ ТаблицаМатериалов
	|ИЗ
	|	&Материалы КАК ТаблицаМатериалов
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаАналогов.Номенклатура КАК Номенклатура,
	|	ТаблицаАналогов.Характеристика КАК Характеристика,
	|	ТаблицаАналогов.Склад КАК Склад,
	|	ТаблицаАналогов.Количество КАК Количество
	|ПОМЕСТИТЬ ТаблицаАналогов
	|ИЗ
	|	&Аналоги КАК ТаблицаАналогов
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Номенклатура,
	|	Характеристика,
	|	Склад
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	МатериалыРазрешений.Номенклатура КАК Номенклатура,
	|	МатериалыРазрешений.Характеристика КАК Характеристика,
	|	МатериалыРазрешений.Разрешение КАК Разрешение,
	|	МатериалыРазрешений.НомерСтроки КАК НомерСтроки
	|ПОМЕСТИТЬ МатериалыРазрешений
	|ИЗ
	|	&МатериалыРазрешений КАК МатериалыРазрешений
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Номенклатура,
	|	Характеристика,
	|	Разрешение,
	|	НомерСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
