	|	ТаблицаАналогиПострочно.НомерСтрокиДокумент КАК НомерСтрокиДокумент,
	|	ТаблицаАналогиПострочно.Материал КАК Материал,
	|	ТаблицаАналогиПострочно.ХарактеристикаМатериала КАК ХарактеристикаМатериала,
	|	ТаблицаАналогиПострочно.НесколькоМатериалов КАК НесколькоМатериалов,
	|	ТаблицаАналогиПострочно.Количество КАК Количество,
	|	ВЫБОР
	|		КОГДА ТаблицаАналогиПострочно.НесколькоМатериалов
	|			ТОГДА НЕ МатериалыРазрешений.Разрешение ЕСТЬ NULL
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК УчитываемаяСтрока
	|ИЗ
	|	ТаблицаАналогиПострочно КАК ТаблицаАналогиПострочно
	|		ЛЕВОЕ СОЕДИНЕНИЕ МатериалыРазрешений КАК МатериалыРазрешений
	|		ПО ТаблицаАналогиПострочно.Материал = МатериалыРазрешений.Номенклатура
	|			И ТаблицаАналогиПострочно.ХарактеристикаМатериала = МатериалыРазрешений.Характеристика
	|			И ТаблицаАналогиПострочно.Разрешение = МатериалыРазрешений.Разрешение
	|			И (МатериалыРазрешений.НомерСтроки = 1)
	|			И (ТаблицаАналогиПострочно.НесколькоМатериалов)
	|ГДЕ
	|	ВЫБОР
	|			КОГДА ТаблицаАналогиПострочно.НесколькоМатериалов
	|				ТОГДА НЕ МатериалыРазрешений.Разрешение ЕСТЬ NULL
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаМатериалов.НомерСтрокиДокумент КАК НомерСтрокиДокумент,
	|	ТаблицаМатериалов.Номенклатура КАК Номенклатура,
	|	ТаблицаМатериалов.Характеристика КАК Характеристика,
	|	ЗНАЧЕНИЕ(Справочник.Назначения.ПустаяСсылка) КАК Назначение,
	|	ТаблицаМатериалов.Склад КАК Склад,
	|	ТаблицаМатериалов.Всего - ТаблицаМатериалов.КЗамене КАК Количество,
	|	ЛОЖЬ КАК ЭтоАналог,
	|	ТаблицаМатериалов.КЗамене > 0 КАК ИзменилосьКоличество
	|ИЗ
	|	ТаблицаМатериалов КАК ТаблицаМатериалов
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	0,
	|	ТаблицаОбособленныхАналогов.Номенклатура,
	|	ТаблицаОбособленныхАналогов.Характеристика,
	|	ТаблицаОбособленныхАналогов.Назначение,
	|	ТаблицаОбособленныхАналогов.Склад,
	|	ТаблицаОбособленныхАналогов.Количество,
	|	ИСТИНА,
	|	ИСТИНА
	|ИЗ
	|	ТаблицаОбособленныхАналогов КАК ТаблицаОбособленныхАналогов
	|ГДЕ
	|	ТаблицаОбособленныхАналогов.Количество > 0
	|	И ТаблицаОбособленныхАналогов.Назначение <> ЗНАЧЕНИЕ(Справочник.Назначения.ПустаяСсылка)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	0,
	|	ТаблицаАналогов.Номенклатура,
	|	ТаблицаАналогов.Характеристика,
	|	ЗНАЧЕНИЕ(Справочник.Назначения.ПустаяСсылка),
	|	ТаблицаАналогов.Склад,
	|	ТаблицаАналогов.Количество - ЕСТЬNULL(ТаблицаИспользованоОбособленно.Количество, 0),
	|	ИСТИНА,
	|	ИСТИНА
	|ИЗ
	|	ТаблицаАналогов КАК ТаблицаАналогов
	|		ЛЕВОЕ СОЕДИНЕНИЕ ТаблицаИспользованоОбособленно КАК ТаблицаИспользованоОбособленно
	|		ПО ТаблицаАналогов.Номенклатура = ТаблицаИспользованоОбособленно.Номенклатура
	|			И ТаблицаАналогов.Характеристика = ТаблицаИспользованоОбособленно.Характеристика
	|			И ТаблицаАналогов.Склад = ТаблицаИспользованоОбособленно.Склад
	|ГДЕ
	|	ТаблицаАналогов.Количество - ЕСТЬNULL(ТаблицаИспользованоОбособленно.Количество, 0) > 0
	|
	|УПОРЯДОЧИТЬ ПО
	|	ЭтоАналог УБЫВ,
	|	НомерСтрокиДокумент,
	|	Назначение УБЫВ";
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("Материалы", Этапы.Выгрузить());
	Запрос.УстановитьПараметр("Аналоги", ИспользованныеАналоги.Выгрузить());
	Запрос.УстановитьПараметр("ОбособленныеАналоги", ОстаткиАналогов.Выгрузить());
	Запрос.УстановитьПараметр("АналогиПострочно", ИспользованныеАналогиПострочно.Выгрузить());
	
	МатериалыРазрешений = Аналоги.Выгрузить(Новый Структура("ЭтоАналог", Ложь), "Номенклатура, Характеристика, Разрешение, НомерСтроки");
	МатериалыРазрешений.Свернуть("Номенклатура, Характеристика, Разрешение, НомерСтроки");
	
	Запрос.УстановитьПараметр("МатериалыРазрешений", МатериалыРазрешений);
	
	Результаты = Запрос.ВыполнитьПакет();
	КоличествоПакетов = Результаты.ВГраница();
	
	ТаблицаДанных = Результаты[КоличествоПакетов].Выгрузить();
	АналогиПострочно = Результаты[КоличествоПакетов - 1].Выгрузить();
	
	ИтоговыеДанные = ТаблицаДанных.СкопироватьКолонки();
	ПоискАналога = Новый Структура("Номенклатура, Характеристика");
	
	Для каждого СтрокаТаблицы Из ТаблицаДанных Цикл
	
		Если СтрокаТаблицы.ЭтоАналог Тогда
			
			КоличествоРаспределить = СтрокаТаблицы.Количество;
			ЗаполнитьЗначенияСвойств(ПоискАналога, СтрокаТаблицы);
			МассивАналоговПострочно = АналогиПострочно.НайтиСтроки(ПоискАналога);
			
			Для каждого СтрокаТЗ Из МассивАналоговПострочно Цикл
			
				КоличествоАналога = Мин(КоличествоРаспределить, СтрокаТЗ.Количество);
				Если КоличествоАналога <> 0 Тогда
				
					СтрокаТЗ.Количество = СтрокаТЗ.Количество - КоличествоАналога;
					КоличествоРаспределить = КоличествоРаспределить - КоличествоАналога;
					
					НоваяСтрока = ИтоговыеДанные.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы,, "Количество, НомерСтрокиДокумент");
					НоваяСтрока.Количество = КоличествоАналога;
					НоваяСтрока.НомерСтрокиДокумент = СтрокаТЗ.НомерСтрокиДокумент;	
				
				КонецЕсли;
				
				Если КоличествоРаспределить = 0 Тогда
					Прервать;
				КонецЕсли;
			
			КонецЦикла;
			
			Если КоличествоРаспределить > 0 Тогда
				НоваяСтрока = ИтоговыеДанные.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
				НоваяСтрока.Количество = КоличествоРаспределить;
				НоваяСтрока.НомерСтрокиДокумент = -1;
			КонецЕсли;
			
		Иначе
			
			НоваяСтрока = ИтоговыеДанные.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
		
		КонецЕсли;
	
	КонецЦикла;
	
	Возврат ПоместитьВоВременноеХранилище(ИтоговыеДанные);

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура НастроитьОжиданиеВФорме(Форма, ПоказатьДлительнуюОперацию, ПредставлениеОперации = "")
	
	Элементы = Форма.Элементы;
	
	Элементы.СтраницыФормы.ТекущаяСтраница = ?(ПоказатьДлительнуюОперацию,
		Элементы.СтраницаДлительнаяОперация, Элементы.СтраницаМатериаловИАналогов);
	Элементы.ЗаменитьНаАналоги.Видимость = Не ПоказатьДлительнуюОперацию И НЕ Форма.РежимИзДокумента;
	Элементы.ФормаПеречитать.Видимость = Не ПоказатьДлительнуюОперацию И НЕ Форма.РежимИзДокумента;
	Форма.ПоложениеКоманднойПанели = ?(ПоказатьДлительнуюОперацию ИЛИ Форма.РежимИзДокумента,
		ПоложениеКоманднойПанелиФормы.Нет, ПоложениеКоманднойПанелиФормы.Авто);
	
	Элементы.ДлительнаяОперацияПредставление.Заголовок = ПредставлениеОперации;
	
КонецПроцедуры

&НаКлиенте
Процедура НачатьОжиданиеДлительнойОперации(ВыводитьОкноОжидания = Истина)
	
	ОповещениеОЗавершении = Новый ОписаниеОповещения(ОбработчикОжиданияДлительнойОперации, ЭтотОбъект);
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	
	ПараметрыОжидания.ВыводитьОкноОжидания = ВыводитьОкноОжидания;
	
	ДлительныеОперацииКлиент.ОжидатьЗавершение(
			ДлительнаяОперация,
			ОповещениеОЗавершении,
			ПараметрыОжидания);
	
	НачатьОжиданиеДлительнойОперации = Ложь;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСтруктуруРеквизитамиФормы(СтруктураДанныхФормы)

	СтруктураДанныхФормы.Вставить("Разрешение", Разрешение);
	СтруктураДанныхФормы.Вставить("ПриоритетЗамены", ПриоритетЗамены);
	СтруктураДанныхФормы.Вставить("ПодборВзаимозаменяемыхАналогов", ПодборВзаимозаменяемыхАналогов);

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоСтратегииНаСервере(ЗаполнениеНеОтгруженного)
	
	Если Этапы.Количество() = 0 Тогда
		
		НачатьОжиданиеДлительнойОперации = Ложь;
		ТекстСообщения = НСтр("ru = 'Нет данных для заполнения';
								|en = 'No data to fill'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,, "Этапы");
		Возврат;
	
	КонецЕсли;
	
	ИнициализироватьДанные();
		
	Дерево = РеквизитФормыВЗначение("ДеревоЗамен");
	
	СтруктураДанныхФормы = Новый Структура;
	ЗаполнитьСтруктуруРеквизитамиФормы(СтруктураДанныхФормы);
	СтруктураДанныхФормы.Вставить("ОстаткиАналогов", ОстаткиАналогов.Выгрузить());
	СтруктураДанныхФормы.Вставить("Этапы", Этапы.Выгрузить());
	СтруктураДанныхФормы.Вставить("Нормативы", Нормативы.Выгрузить());
	СтруктураДанныхФормы.Вставить("СтруктураОтбораЭтапов", СтруктураОтбораЭтапов());
	СтруктураДанныхФормы.Вставить("Дерево", Дерево);
	СтруктураДанныхФормы.Вставить("ЗаполнениеНеОтгруженного", ЗаполнениеНеОтгруженного);	
	
	// Запуск формирования
	ОтменитьДлительнуюОперацию();
		
	ПараметрыДляОбработки = Новый Структура;
	ПараметрыДляОбработки.Вставить("СтруктураДанныхФормы", СтруктураДанныхФормы);
	
	АдресРезультатФормирования = ПоместитьВоВременноеХранилище(
		Документы.РазрешениеНаЗаменуМатериалов.РезультатАвтоматическогоЗаполненияПомощника(), УникальныйИдентификатор);
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = НСтр("ru = 'Помощник выполнения замен: заполнение по стратегии';
															|en = 'Replacement wizard: fill in by strategy'");
	ПараметрыВыполнения.АдресРезультата = АдресРезультатФормирования;
	
	ДлительнаяОперация = ДлительныеОперации.ВыполнитьВФоне(
		"Документы.РазрешениеНаЗаменуМатериалов.ЗаполнитьПомощникПоСтратегииОтложенно",
		ПараметрыДляОбработки,
		ПараметрыВыполнения);
	
	Если ДлительнаяОперация.Статус = "Выполняется" Тогда
		
		ОбработчикОжиданияДлительнойОперации = "ЗаполнитьПоСтратегииОтложенноЗавершение";
		НачатьОжиданиеДлительнойОперации = Истина;
		
	Иначе
		
		ЗаполнитьПоСтратегииОтложенно(ДлительнаяОперация);
		
		НачатьОжиданиеДлительнойОперации = Ложь;
		ДлительнаяОперация = Неопределено;
		
	КонецЕсли;	

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПоСтратегииОтложенноЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ДлительнаяОперация = Неопределено;
	НастроитьОжиданиеВФорме(ЭтотОбъект, Ложь);
	
	ЗаполнитьПоСтратегииОтложенно(Результат);
	
	Если Результат <> Неопределено И Результат.Статус = "Ошибка" Тогда
		ПоказатьПредупреждение(, Результат.КраткоеПредставлениеОшибки);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоСтратегииОтложенно(Результат)
	
	ЗаданиеЗавершено = Ложь;
	
	Если ЭтоАдресВременногоХранилища(АдресРезультатФормирования) Тогда
		
		СтруктураРезультата = ПолучитьИзВременногоХранилища(АдресРезультатФормирования);
		АдресРезультатФормирования = Неопределено;
		
		ЗначениеВРеквизитФормы(СтруктураРезультата.Дерево, "ДеревоЗамен");
		ОстаткиАналогов.Загрузить(СтруктураРезультата.ТаблицаОстатков);
		Этапы.Загрузить(СтруктураРезультата.ТаблицаЭтапов);
		
		ТекстСообщения = НСтр("ru = 'Завершен процесс заполнения';
								|en = 'Filling process is completed'");
		
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		ЗаданиеЗавершено = Истина;
				
	КонецЕсли;
	
	Если Результат = Неопределено
		Или Результат.Статус <> "Выполнено" Тогда
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Не удалось заполнить форму';
													|en = 'Cannot fill in the form'"));
	КонецЕсли;
	
	Если ЗаданиеЗавершено Тогда
	
		Элементы.СтраницыФормы.ТекущаяСтраница = Элементы.СтраницаМатериаловИАналогов;
		Элементы.ЗаменитьНаАналоги.Видимость = Истина;
		Элементы.ФормаПеречитать.Видимость = Истина;
		ПоложениеКоманднойПанели = ПоложениеКоманднойПанелиФормы.Авто;
	
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоДоступностиНаСервере()
	
	Если Этапы.Количество() = 0 Тогда
		
		НачатьОжиданиеДлительнойОперации = Ложь;
		ТекстСообщения = НСтр("ru = 'Нет данных для заполнения по доступности';
								|en = 'There is no data to fill in by availability'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,, "Этапы");
		Возврат;
	
	КонецЕсли;
	
	ИнициализироватьДанные();
		
	Дерево = РеквизитФормыВЗначение("ДеревоЗамен");
	
	СтруктураДанныхФормы = Новый Структура;
	ЗаполнитьСтруктуруРеквизитамиФормы(СтруктураДанныхФормы);
	СтруктураДанныхФормы.Вставить("ОстаткиАналогов", ОстаткиАналогов.Выгрузить());
	СтруктураДанныхФормы.Вставить("Этапы", Этапы.Выгрузить());
	СтруктураДанныхФормы.Вставить("Нормативы", Нормативы.Выгрузить());
	СтруктураДанныхФормы.Вставить("СтруктураОтбораЭтапов", СтруктураОтбораЭтапов());
	СтруктураДанныхФормы.Вставить("Дерево", Дерево);
	
	// Запуск формирования
	ОтменитьДлительнуюОперацию();
		
	ПараметрыДляОбработки = Новый Структура;
	ПараметрыДляОбработки.Вставить("СтруктураДанныхФормы", СтруктураДанныхФормы);
	
	АдресРезультатФормирования = ПоместитьВоВременноеХранилище(
		Документы.РазрешениеНаЗаменуМатериалов.РезультатАвтоматическогоЗаполненияПомощника(), УникальныйИдентификатор);
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = НСтр("ru = 'Помощник выполнения замен: заполнение по доступности';
															|en = 'Replacement wizard: fill in by availability'");
	ПараметрыВыполнения.АдресРезультата = АдресРезультатФормирования;
	
	ДлительнаяОперация = ДлительныеОперации.ВыполнитьВФоне(
		"Документы.РазрешениеНаЗаменуМатериалов.ЗаполнитьПомощникПоДоступностиОтложенно",
		ПараметрыДляОбработки,
		ПараметрыВыполнения);
	
	Если ДлительнаяОперация.Статус = "Выполняется" Тогда
		
		ОбработчикОжиданияДлительнойОперации = "ЗаполнитьПоДоступностиОтложенноЗавершение";
		НачатьОжиданиеДлительнойОперации = Истина;
		
	Иначе
		
		ЗаполнитьПоДоступностиОтложенно(ДлительнаяОперация);
		
		НачатьОжиданиеДлительнойОперации = Ложь;
		ДлительнаяОперация = Неопределено;
		
	КонецЕсли;	

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПоДоступностиОтложенноЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ДлительнаяОперация = Неопределено;
	НастроитьОжиданиеВФорме(ЭтотОбъект, Ложь);
	
	ЗаполнитьПоДоступностиОтложенно(Результат);
	
	Если Результат <> Неопределено И Результат.Статус = "Ошибка" Тогда
		ПоказатьПредупреждение(, Результат.КраткоеПредставлениеОшибки);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоДоступностиОтложенно(Результат)
	
	ЗаданиеЗавершено = Ложь;
	
	Если ЭтоАдресВременногоХранилища(АдресРезультатФормирования) Тогда
		
		СтруктураРезультата = ПолучитьИзВременногоХранилища(АдресРезультатФормирования);
		АдресРезультатФормирования = Неопределено;
		
		ЗначениеВРеквизитФормы(СтруктураРезультата.Дерево, "ДеревоЗамен");
		ОстаткиАналогов.Загрузить(СтруктураРезультата.ТаблицаОстатков);
		Этапы.Загрузить(СтруктураРезультата.ТаблицаЭтапов);
		
		ТекстСообщения = НСтр("ru = 'Завершен процесс заполнения по доступности';
								|en = 'Filling by availability is completed'");
		
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		ЗаданиеЗавершено = Истина;
				
	КонецЕсли;
	
	Если Результат = Неопределено
		Или Результат.Статус <> "Выполнено" Тогда
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Не удалось заполнить форму по доступности';
													|en = 'Cannot fill in the form by availability'"));
	КонецЕсли;
	
	Если ЗаданиеЗавершено Тогда
	
		Элементы.СтраницыФормы.ТекущаяСтраница = Элементы.СтраницаМатериаловИАналогов;
		Элементы.ЗаменитьНаАналоги.Видимость = Истина;
		Элементы.ФормаПеречитать.Видимость = Истина;
		ПоложениеКоманднойПанели = ПоложениеКоманднойПанелиФормы.Авто;
	
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти
