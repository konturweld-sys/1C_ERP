
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	СписокСвойств = "ЗаменаОдинКОдному, Материал, ХарактеристикаМатериала, Разрешение, ПриоритетЗамены, РольАналогов, Этап";
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, Параметры, СписокСвойств);
	
	ПодборВзаимозаменяемыхАналогов = (РольАналогов = Перечисления.РолиАналогов.ВзаимозаменяемыйАналог);
	
	Если ЗначениеЗаполнено(ПриоритетЗамены)
	   И Не ПолучитьФункциональнуюОпцию("ДинамическаяСтруктураЗаказовНаПроизводство") Тогда
		ПриоритетЗамены = Перечисления.ПравилаЗаменыНаАналоги.ПриОтсутствииМатериала;
	КонецЕсли;
	
	УстановитьУсловноеОформление();
	
	Элементы.СтраницыФормы.ТекущаяСтраница = Элементы.СтраницаМатериаловИАналогов;
	
	Если ЗначениеЗаполнено(Этап) Тогда
		
		РежимИзДокумента = Истина;
		ТаблицаИзДокумента = ПолучитьИзВременногоХранилища(Параметры.АдресТаблицыТоваров);
		ТоварыИзДокумента.Загрузить(ТаблицаИзДокумента);
		
		ТаблицаЗапасов = ?(ЭтоАдресВременногоХранилища(Параметры.РаспределениеЗапасов), 
							ПолучитьИзВременногоХранилища(Параметры.РаспределениеЗапасов), 
							Неопределено);
							
		Если ТаблицаЗапасов <> Неопределено Тогда
		
			ОтборСтрокТаблицы = Новый Структура("ЭтоОстаток, ЭтоСкладДокумента", Истина, Истина);
			СтрокиТаблцыЗапасов = ТаблицаЗапасов.НайтиСтроки(ОтборСтрокТаблицы);
			
			Для каждого СтрокаТаблицыЗапасов Из СтрокиТаблцыЗапасов Цикл
			
				СтрокаОстатков = ОстаткиАналогов.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаОстатков, СтрокаТаблицыЗапасов, "Номенклатура, Характеристика, Склад, Назначение");
				СтрокаОстатков.Свободно = СтрокаТаблицыЗапасов.Количество;
			
			КонецЦикла;
		
		КонецЕсли;
	
	КонецЕсли;
	
	УстановитьГиперссылкуЗаменяемогоМатериала();
	УстановитьВидимостьЭлементов();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ОбновитьДанныеЭтаповНаФорме();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

