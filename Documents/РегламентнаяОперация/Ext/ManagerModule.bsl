Функция ТекстЗапроса_ИнвестицииВАренду()
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	//РежимОтладки""ИнвестицииВАренду"" КАК ИсточникДанных,
	|	ИзмененныеНастройки.ВидСчета КАК ВидСчета,
	|	ТаблицаОстатков.Организация КАК Организация,
	|	ТаблицаОстатков.ГруппаФинансовогоУчета КАК АналитикаУчета,
	|	НЕОПРЕДЕЛЕНО КАК МестоУчета,
	|	ЛОЖЬ КАК Долгосрочный,
	|	ТаблицаОстатков.Договор.Подразделение КАК Подразделение,
	|	ТаблицаОстатков.Договор.НаправлениеДеятельности КАК НаправлениеДеятельности,
	|	ТаблицаОстатков.ОсновноеСредство КАК Субконто1,
	|	ТаблицаОстатков.Договор.Контрагент КАК Субконто2,
	|	ТаблицаОстатков.Договор КАК Субконто3,
	|	НЕОПРЕДЕЛЕНО КАК Субконто4,
	|	НЕОПРЕДЕЛЕНО КАК Субконто5,
	|	НЕОПРЕДЕЛЕНО КАК Субконто6,
	|	ВЫБОР
	|		КОГДА ИзмененныеНастройки.ВидСчета В (ЗНАЧЕНИЕ(Перечисление.ВидыСчетовРеглУчета.АрендныеПлатежи),
	|			ЗНАЧЕНИЕ(Перечисление.ВидыСчетовРеглУчета.ПроцентныйДисконт))
	|		ТОГДА ТаблицаОстатков.Валюта
	|		ИНАЧЕ НЕОПРЕДЕЛЕНО
	|	КОНЕЦ КАК Валюта,
	|	ВЫБОР
	|		КОГДА ИзмененныеНастройки.ВидСчета = ЗНАЧЕНИЕ(Перечисление.ВидыСчетовРеглУчета.АрендныеПлатежи)
	|		ТОГДА ТаблицаОстатков.АрендныеПлатежиРеглОстаток
	|		КОГДА ИзмененныеНастройки.ВидСчета = ЗНАЧЕНИЕ(Перечисление.ВидыСчетовРеглУчета.ПроцентныйДисконт)
	|		ТОГДА -ТаблицаОстатков.ПроцентныйДисконтРеглОстаток
	|		ИНАЧЕ ТаблицаОстатков.НГЛСРеглОстаток
	|	КОНЕЦ КАК Сумма,
	|	ВЫБОР
	|		КОГДА ИзмененныеНастройки.ВидСчета = ЗНАЧЕНИЕ(Перечисление.ВидыСчетовРеглУчета.АрендныеПлатежи)
	|		ТОГДА ТаблицаОстатков.АрендныеПлатежиУпрОстаток
	|		КОГДА ИзмененныеНастройки.ВидСчета = ЗНАЧЕНИЕ(Перечисление.ВидыСчетовРеглУчета.ПроцентныйДисконт)
	|		ТОГДА -ТаблицаОстатков.ПроцентныйДисконтУпрОстаток
	|		ИНАЧЕ ТаблицаОстатков.НГЛСУпрОстаток
	|	КОНЕЦ КАК СуммаУУ,
	|	ВЫБОР
	|		КОГДА ИзмененныеНастройки.ВидСчета = ЗНАЧЕНИЕ(Перечисление.ВидыСчетовРеглУчета.АрендныеПлатежи)
	|		ТОГДА ТаблицаОстатков.АрендныеПлатежиОстаток
	|		КОГДА ИзмененныеНастройки.ВидСчета = ЗНАЧЕНИЕ(Перечисление.ВидыСчетовРеглУчета.ПроцентныйДисконт)
	|		ТОГДА -ТаблицаОстатков.ПроцентныйДисконтОстаток
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК ВалютнаяСумма,
	|	0 КАК Количество,
	|	0 КАК СуммаНУ,
	|	0 КАК СуммаПР,
	|	ВЫБОР
	|		КОГДА ИзмененныеНастройки.ВидСчета = ЗНАЧЕНИЕ(Перечисление.ВидыСчетовРеглУчета.АрендныеПлатежи)
	|		ТОГДА ТаблицаОстатков.АрендныеПлатежиРеглОстаток
	|		КОГДА ИзмененныеНастройки.ВидСчета = ЗНАЧЕНИЕ(Перечисление.ВидыСчетовРеглУчета.ПроцентныйДисконт)
	|		ТОГДА -ТаблицаОстатков.ПроцентныйДисконтРеглОстаток
	|		ИНАЧЕ ТаблицаОстатков.НГЛСРеглОстаток
	|	КОНЕЦ КАК СуммаВР
	|ИЗ
	|	РегистрНакопления.ИнвестицииВАренду.Остатки(&Период, Организация = &Организация) КАК ТаблицаОстатков
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ ИзмененныеНастройки КАК ИзмененныеНастройки
	|	ПО ИзмененныеНастройки.ИмяРегистра = ""ИнвестицииВАренду""
	|		И ИзмененныеНастройки.АналитикаУчета = ТаблицаОстатков.ГруппаФинансовогоУчета";
	Если Не НастройкаСчетовУчетаСервер.НастройкиАналитикиУчетаПоРазделуУчета("ВнеоборотныеАктивы").Используется Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ТаблицаОстатков.ГруппаФинансовогоУчета", "ЗНАЧЕНИЕ(Справочник.ГруппыФинансовогоУчетаВнеоборотныхАктивов.ПустаяСсылка)");
	КонецЕсли;
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ТекстЗапросаВТ_Данные(РежимОтладкиПоИсточникам)
	
	ТекстыВложенногоЗапроса = Новый Массив;
	
	#Область ИнициализацияВременнойТаблицыДанныеПредварительная
	ТекстЗапроса =
	"ВЫБРАТЬ ПЕРВЫЕ 0
	|	//РежимОтладки""Инициализация"" КАК ИсточникДанных,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыСчетовРеглУчета.ПустаяСсылка) КАК ВидСчета,
	|	ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка) КАК Организация,
	|	НЕОПРЕДЕЛЕНО КАК АналитикаУчета,
	|	НЕОПРЕДЕЛЕНО КАК МестоУчета,
	|	ЛОЖЬ КАК Долгосрочный,
	|	ЗНАЧЕНИЕ(Справочник.СтруктураПредприятия.ПустаяСсылка) КАК Подразделение,
	|	ЗНАЧЕНИЕ(Справочник.НаправленияДеятельности.ПустаяСсылка) КАК НаправлениеДеятельности,
	|	НЕОПРЕДЕЛЕНО КАК Субконто1,
	|	НЕОПРЕДЕЛЕНО КАК Субконто2,
	|	НЕОПРЕДЕЛЕНО КАК Субконто3,
	|	НЕОПРЕДЕЛЕНО КАК Субконто4,
	|	НЕОПРЕДЕЛЕНО КАК Субконто5,
	|	НЕОПРЕДЕЛЕНО КАК Субконто6,
	|	НЕОПРЕДЕЛЕНО КАК Валюта,
	|	0 КАК Сумма,
	|	0 КАК СуммаУУ,
	|	0 КАК ВалютнаяСумма,
	|	0 КАК Количество,
	|	0 КАК СуммаНУ,
	|	0 КАК СуммаПР,
	|	0 КАК СуммаВР
	|ПОМЕСТИТЬ ДанныеПредварительная";
	Если РежимОтладкиПоИсточникам Тогда
		ТекстыВложенногоЗапроса.Добавить(ТекстЗапроса);
	КонецЕсли;
	#КонецОбласти
	
	#Область Раздел_Номенклатура
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	//РежимОтладки""ТаблицаНоменклатура"" КАК ИсточникДанных,
	|	ВТОстатки.ВидСчета,
	|	ВТОстатки.Организация,
	|	ВТОстатки.АналитикаУчета,
	|	ВТОстатки.МестоУчета,
	|	ЛОЖЬ КАК Долгосрочный,
	|	ВТОстатки.Подразделение,
	|	ВТОстатки.НаправлениеДеятельности,
	|	ВТОстатки.Субконто1,
	|	ВТОстатки.Субконто2,
	|	ВТОстатки.Субконто3,
	|	ВТОстатки.Субконто4,
	|	ВТОстатки.Субконто5,
	|	ВТОстатки.Субконто6,
	|	ВТОстатки.Валюта,
	|	ВТОстатки.Сумма,
	|	ВТОстатки.СуммаУУ,
	|	ВТОстатки.ВалютнаяСумма,
	|	ВТОстатки.Количество,
	|	ВТОстатки.СуммаНУ,
	|	ВТОстатки.СуммаПР,
	|	ВТОстатки.СуммаВР
	|ИЗ
	|	Номенклатура КАК ВТОстатки";
	ТекстыВложенногоЗапроса.Добавить(ТекстЗапроса);
	
	Если Не РежимОтладкиПоИсточникам Тогда
		ТекстыВложенногоЗапроса.Добавить(ТекстЗапроса_ОтклоненияВСтоимости());
	КонецЕсли;
	
	#КонецОбласти
	
	#Область Раздел_РасчетыСПартнерами
	
	Если РежимОтладкиПоИсточникам Тогда
		ТекстЗапроса =
		"ВЫБРАТЬ
		|	//РежимОтладки""Раздел_РасчетыСПартнерами"" КАК ИсточникДанных,
		|	Данные.ВидСчета,
		|	Данные.Организация,
		|	Данные.АналитикаУчета,
		|	Данные.МестоУчета,
		|	Данные.Долгосрочный КАК Долгосрочный,
		|	Данные.Подразделение,
		|	Данные.НаправлениеДеятельности,
		|	Данные.Субконто1,
		|	Данные.Субконто2,
		|	Данные.Субконто3,
		|	Данные.Субконто4,
		|	Данные.Субконто5,
		|	Данные.Субконто6,
		|	Данные.Валюта,
		|	Данные.Сумма,
		|	Данные.СуммаУУ,
		|	Данные.ВалютнаяСумма,
		|	Данные.Количество,
		|	Данные.СуммаНУ,
		|	Данные.СуммаПР,
		|	Данные.СуммаВР
		|ИЗ
		|	РасчетыСПартнерами КАК Данные";
		ТекстыВложенногоЗапроса.Добавить(ТекстЗапроса);
	Иначе
		ТекстыВложенногоЗапроса.Добавить(ТекстЗапроса_РасчетыСКлиентамиПоСрокам());
		ТекстыВложенногоЗапроса.Добавить(ТекстЗапроса_РасчетыСПоставщикамиПоСрокам());
		ТекстыВложенногоЗапроса.Добавить(ТекстЗапроса_НДСАвансыПолученные());
