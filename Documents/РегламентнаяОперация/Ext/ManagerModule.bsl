	|	0 КАК Количество,
	|	0 КАК СуммаНУ,
	|	0 КАК СуммаПР,
	|	0 КАК СуммаВР
	|ПОМЕСТИТЬ РасчетыСПартнерамиПредварительная";
	Если РежимОтладкиПоИсточникам Тогда
		ТекстыВложенногоЗапроса.Добавить(ТекстЗапроса);
	КонецЕсли;
	#КонецОбласти
	
	ТекстыВложенногоЗапроса.Добавить(ТекстЗапроса_РасчетыСКлиентамиПоСрокам());
	ТекстыВложенногоЗапроса.Добавить(ТекстЗапроса_РасчетыСПоставщикамиПоСрокам());
	ТекстыВложенногоЗапроса.Добавить(ТекстЗапроса_НДСАвансыПолученные());
	ТекстыВложенногоЗапроса.Добавить(ТекстЗапроса_НДСАвансыВыданные());
