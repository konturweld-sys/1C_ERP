	|	ТаблицаОстатков.ПодразделениеАналитики КАК МестоУчета,
	|	ТаблицаОстатков.ПодразделениеАналитики КАК Подразделение,
	|	ТаблицаОстатков.НаправлениеДеятельности КАК НаправлениеДеятельности,
	|	ТаблицаОстатков.Номенклатура КАК Субконто1,
	|	ТаблицаОстатков.ГруппаПродукции КАК Субконто2,
	|	ВЫБОР
	|		КОГДА ТаблицаОстатков.РазделУчета = ЗНАЧЕНИЕ(Перечисление.РазделыУчетаСебестоимостиТоваров.НезавершенноеПроизводство)
	|		ТОГДА ТаблицаОстатков.Партия//РезервыПодОбесценениеНезавершенногоПроизводства
	|		ИНАЧЕ НЕОПРЕДЕЛЕНО
	|	КОНЕЦ КАК Субконто3,
	|	НЕОПРЕДЕЛЕНО КАК Субконто4,
	|	ТаблицаОстатков.РезервПодОбесценениеРегл КАК Сумма,
	|	ТаблицаОстатков.РезервПодОбесценениеУпр КАК СуммаУУ,
	|	ТаблицаОстатков.РезервПодОбесценениеРегл КАК СуммаНУ,
	|	0 КАК СуммаПР,
	|	0 КАК СуммаВР
	|ИЗ
	|	ТаблицаСебестоимостьТоваров КАК ТаблицаОстатков
	|
	|ГДЕ
	|	ТаблицаОстатков.ПроизводственныеЗатраты
	|	И ТаблицаОстатков.РезервПодОбесценениеРегл + ТаблицаОстатков.РезервПодОбесценениеУпр <> 0";
	ТекстыВложенногоЗапроса.Добавить(ТекстЗапроса);
	#КонецОбласти
	
	#Область ПрочиеРасходыНезавершенногоПроизводства
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	//РежимОтладки""ПрочиеРасходыНезавершенногоПроизводства"" КАК ИсточникДанных,
	|	ИзмененныеНастройки.ВидСчета,
	|	Данные.Организация,
	|	ВЫБОР
	|		КОГДА НЕ &АналитическийУчетПоГруппамПродукции
	|		ТОГДА ЗНАЧЕНИЕ(Справочник.ГруппыАналитическогоУчетаНоменклатуры.ПустаяСсылка)
	|		ИНАЧЕ Данные.ГруппаПродукции
	|	КОНЕЦ КАК АналитикаУчета,
	|	Данные.Подразделение КАК МестоУчета,
	|	Данные.Подразделение,
	|	Данные.НаправлениеДеятельности,
	|	Данные.ГруппаПродукции КАК Субконто1,
	|	Данные.СтатьяРасходов КАК Субконто2,
	|	Данные.ПартияПроизводства КАК Субконто3,
	|	Данные.СтатьяКалькуляции КАК Субконто4,
	|	Данные.Сумма КАК Сумма,
	|	Данные.СуммаУУ КАК СуммаУУ,
	|	Данные.Сумма - Данные.СуммаПР - Данные.СуммаВР КАК СуммаНУ,
	|	Данные.СуммаПР КАК СуммаПР,
	|	Данные.СуммаВР КАК СуммаВР
	|ИЗ
	|	ИзмененныеНастройки КАК ИзмененныеНастройки
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПрочиеРасходыНезавершенногоПроизводства КАК Данные
	|	ПО ИзмененныеНастройки.ИмяРегистра = ""НезавершенноеПроизводство""
	|		И ИзмененныеНастройки.АналитикаУчета = Данные.ГруппаПродукции
	|		И (ИзмененныеНастройки.МестоУчета = Данные.Подразделение ИЛИ ИзмененныеНастройки.МестоУчета = НЕОПРЕДЕЛЕНО)
	|ГДЕ
	|	ИзмененныеНастройки.ИмяРегистра = ""НезавершенноеПроизводство""";
	Если Не ИспользуетсяАналитика ИЛИ НЕ ПолучитьФункциональнуюОпцию("АналитическийУчетПоГруппамПродукции") Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ИзмененныеНастройки.АналитикаУчета = Данные.ГруппаПродукции", "ИСТИНА");
	КонецЕсли;
	ТекстыВложенногоЗапроса.Добавить(ТекстЗапроса);
	#КонецОбласти
	
	#Область ТрудозатратыНезавершенногоПроизводства
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	//РежимОтладки""ТрудозатратыНезавершенногоПроизводства"" КАК ИсточникДанных,
	|	ИзмененныеНастройки.ВидСчета,
	|	Данные.Организация,
	|	ВЫБОР
	|		КОГДА НЕ &АналитическийУчетПоГруппамПродукции
	|		ТОГДА ЗНАЧЕНИЕ(Справочник.ГруппыАналитическогоУчетаНоменклатуры.ПустаяСсылка)
	|		ИНАЧЕ Данные.ГруппаПродукции
	|	КОНЕЦ КАК АналитикаУчета,
	|	Данные.Подразделение КАК МестоУчета,
	|	Данные.Подразделение,
	|	Данные.НаправлениеДеятельности,
	|	Данные.ГруппаПродукции КАК Субконто1,
	|	Данные.ВидРабот КАК Субконто2,
	|	Данные.ПартияПроизводства КАК Субконто3,
	|	Данные.СтатьяКалькуляции КАК Субконто4,
	|	Данные.Сумма КАК Сумма,
	|	Данные.СуммаУУ КАК СуммаУУ,
	|	Данные.Сумма - Данные.СуммаПР - Данные.СуммаВР КАК СуммаНУ,
	|	Данные.СуммаПР КАК СуммаПР,
	|	Данные.СуммаВР КАК СуммаВР
	|ИЗ
	|	
	|	ИзмененныеНастройки КАК ИзмененныеНастройки
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТрудозатратыНезавершенногоПроизводства КАК Данные
	|	ПО ИзмененныеНастройки.ИмяРегистра = ""НезавершенноеПроизводство""
	|		И ИзмененныеНастройки.АналитикаУчета = Данные.ГруппаПродукции
	|		И (ИзмененныеНастройки.МестоУчета = Данные.Подразделение ИЛИ ИзмененныеНастройки.МестоУчета = НЕОПРЕДЕЛЕНО)
	|ГДЕ
	|	ИзмененныеНастройки.ИмяРегистра = ""НезавершенноеПроизводство""";
	Если Не ИспользуетсяАналитика ИЛИ НЕ ПолучитьФункциональнуюОпцию("АналитическийУчетПоГруппамПродукции") Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ИзмененныеНастройки.АналитикаУчета = Данные.ГруппаПродукции", "ИСТИНА");
	КонецЕсли;
	ТекстыВложенногоЗапроса.Добавить(ТекстЗапроса);
	#КонецОбласти
	
	СтрокаВложенногоЗапроса = СтрСоединить(ТекстыВложенногоЗапроса, ОбщегоНазначенияУТ.РазделительЗапросовВОбъединении());
	
	#Область Производство
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	Данные.ВидСчета КАК ВидСчета,
	|	Данные.Организация КАК Организация,
	|	Данные.АналитикаУчета КАК АналитикаУчета,
	|	Данные.МестоУчета КАК МестоУчета,
	|	Данные.Подразделение КАК Подразделение,
	|	Данные.НаправлениеДеятельности КАК НаправлениеДеятельности,
	|	Данные.Субконто1 КАК Субконто1,
	|	Данные.Субконто2 КАК Субконто2,
	|	Данные.Субконто3 КАК Субконто3,
	|	Данные.Субконто3 КАК Субконто4,
	|	Данные.Сумма КАК Сумма,
	|	Данные.СуммаУУ КАК СуммаУУ,
	|	Данные.СуммаНУ КАК СуммаНУ,
	|	Данные.СуммаПР КАК СуммаПР,
	|	Данные.СуммаВР КАК СуммаВР
	|ПОМЕСТИТЬ Производство
	|ИЗ
	|	ПроизводствоПредварительная КАК Данные
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ ИзмененныеНастройки КАК ИзмененныеНастройки
	|	ПО ИзмененныеНастройки.ВидСчета = Данные.ВидСчета
	|		И ИзмененныеНастройки.АналитикаУчета = Данные.АналитикаУчета
	|		И ИзмененныеНастройки.Организация = Данные.Организация
	|		И (ИзмененныеНастройки.МестоУчета = Данные.МестоУчета ИЛИ ИзмененныеНастройки.МестоУчета = НЕОПРЕДЕЛЕНО)";
	Если Не ИспользуетсяАналитика Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Данные.АналитикаУчета", "ЗНАЧЕНИЕ(Справочник.ГруппыАналитическогоУчетаНоменклатуры.ПустаяСсылка)");
	КонецЕсли;
	#КонецОбласти
	
	Если РежимОтладкиПоИсточникам Тогда
		
		ТекстыЗапроса = Новый Массив;
		ТекстыЗапроса.Добавить(СтрокаВложенногоЗапроса);
		ТекстыЗапроса.Добавить(ТекстЗапроса);
		ТекстЗапроса = СтрСоединить(ТекстыЗапроса, ОбщегоНазначения.РазделительПакетаЗапросов());
		
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ПроизводствоПредварительная", "(" + СтрокаВложенногоЗапроса + ")");
	КонецЕсли;
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ТекстЗапросаВТ_ТаблицаРасчетыПоФинансовымИнструментам(РежимОтладкиПоИсточникам)
	
	ТекстыВложенногоЗапроса = Новый Массив;
	
	#Область ИнициализацияТаблицаРасчетыПоФинансовымИнструментамПредварительная
	ТекстЗапроса =
	"ВЫБРАТЬ ПЕРВЫЕ 0
	|	//РежимОтладки""Инициализация"" КАК ИсточникДанных,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыСчетовРеглУчета.ПустаяСсылка) КАК ВидСчета,
	|	ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка) КАК Организация,
	|	ЗНАЧЕНИЕ(Справочник.ГруппыФинансовогоУчетаРасчетов.ПустаяСсылка) КАК АналитикаУчета,
	|	ЗНАЧЕНИЕ(Справочник.СтруктураПредприятия.ПустаяСсылка) КАК Подразделение,
	|	ЗНАЧЕНИЕ(Справочник.НаправленияДеятельности.ПустаяСсылка) КАК НаправлениеДеятельности,
	|	ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка) КАК Субконто1,
	|	НЕОПРЕДЕЛЕНО КАК Субконто2,
	|	ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка) КАК Валюта,
	|	НЕОПРЕДЕЛЕНО КАК Договор,
	|	0 КАК Знак,
	|	0 КАК Сумма,
	|	0 КАК СуммаУУ,
	|	0 КАК ВалютнаяСумма,
	|	0 КАК СуммаНУ
	|ПОМЕСТИТЬ ТаблицаРасчетыПоФинансовымИнструментамПредварительная";
	Если РежимОтладкиПоИсточникам Тогда
		ТекстыВложенногоЗапроса.Добавить(ТекстЗапроса);
	КонецЕсли;
	#КонецОбласти
	
	#Область РасчетыПоФинансовымИнструментам
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	//РежимОтладки""РасчетыПоФинансовымИнструментам"" КАК ИсточникДанных,
	|	ВЫБОР
	|		КОГДА ТаблицаОстатков.Договор.ХарактерДоговора = ЗНАЧЕНИЕ(Перечисление.ХарактерыДоговоровФинансовыхИнструментов.Аренда)
	|			И ТаблицаОстатков.ТипСуммы = ЗНАЧЕНИЕ(Перечисление.ТипыПлатежейПоАренде.АрендныеОбязательства)
	|		ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыСчетовРеглУчета.АрендныеОбязательства)
	|		КОГДА ТаблицаОстатков.Договор.ХарактерДоговора = ЗНАЧЕНИЕ(Перечисление.ХарактерыДоговоровФинансовыхИнструментов.Аренда)
	|			И ТаблицаОстатков.ТипСуммы В (ЗНАЧЕНИЕ(Перечисление.ТипыПлатежейПоАренде.УслугаПоАренде), ЗНАЧЕНИЕ(Перечисление.ТипыПлатежейПоАренде.УслугаПоАрендеАванс))
	|		ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыСчетовРеглУчета.УслугаПоАренде)
	|		КОГДА ТаблицаОстатков.Договор.ХарактерДоговора = ЗНАЧЕНИЕ(Перечисление.ХарактерыДоговоровФинансовыхИнструментов.Аренда)
	|			И ТаблицаОстатков.ТипСуммы = ЗНАЧЕНИЕ(Перечисление.ТипыПлатежейПоАренде.ОбеспечительныйПлатеж)
	|		ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыСчетовРеглУчета.ОбеспечительныйПлатеж)
	|		КОГДА ТаблицаОстатков.Договор.ХарактерДоговора = ЗНАЧЕНИЕ(Перечисление.ХарактерыДоговоровФинансовыхИнструментов.Аренда)
	|			И ТаблицаОстатков.ТипСуммы В (ЗНАЧЕНИЕ(Перечисление.ТипыПлатежейПоАренде.ВыкупнаяСтоимость), ЗНАЧЕНИЕ(Перечисление.ТипыПлатежейПоАренде.ВыкупнаяСтоимостьАванс))
	|		ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыСчетовРеглУчета.ВыкупнаяСтоимость)
	|		КОГДА ТаблицаОстатков.Договор.ХарактерДоговора = ЗНАЧЕНИЕ(Перечисление.ХарактерыДоговоровФинансовыхИнструментов.Аренда)
	|			И ТаблицаОстатков.ТипСуммы = ЗНАЧЕНИЕ(Перечисление.ТипыПлатежейПоАренде.Проценты)
	|		ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыСчетовРеглУчета.НачислениеПроцентовПоАренде)
	|		КОГДА ТаблицаОстатков.Договор.ХарактерДоговора = ЗНАЧЕНИЕ(Перечисление.ХарактерыДоговоровФинансовыхИнструментов.Аренда)
	|			И ТаблицаОстатков.ТипСуммы = ЗНАЧЕНИЕ(Перечисление.ТипыПлатежейПоАренде.НДС)
	|		ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыСчетовРеглУчета.НДСПриАренде)
	|		КОГДА ТаблицаОстатков.Договор.ХарактерДоговора = ЗНАЧЕНИЕ(Перечисление.ХарактерыДоговоровФинансовыхИнструментов.КредитИлиЗайм)
	|			И ТаблицаОстатков.ТипСуммы = ЗНАЧЕНИЕ(Перечисление.ТипыСуммГрафикаКредитовИДепозитов.ОсновнойДолг)
	|		ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыСчетовРеглУчета.РасчетыСКредиторамиОсновнойДолг)
	|		КОГДА ТаблицаОстатков.Договор.ХарактерДоговора = ЗНАЧЕНИЕ(Перечисление.ХарактерыДоговоровФинансовыхИнструментов.КредитИлиЗайм)
	|			И ТаблицаОстатков.ТипСуммы = ЗНАЧЕНИЕ(Перечисление.ТипыСуммГрафикаКредитовИДепозитов.Проценты)
	|		ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыСчетовРеглУчета.РасчетыСКредиторамиПроценты)
	|		КОГДА ТаблицаОстатков.Договор.ХарактерДоговора = ЗНАЧЕНИЕ(Перечисление.ХарактерыДоговоровФинансовыхИнструментов.КредитИлиЗайм)
	|			И ТаблицаОстатков.ТипСуммы = ЗНАЧЕНИЕ(Перечисление.ТипыСуммГрафикаКредитовИДепозитов.Комиссия)
	|		ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыСчетовРеглУчета.РасчетыСКредиторамиКомиссия)
	|		КОГДА ТаблицаОстатков.ТипСуммы = ЗНАЧЕНИЕ(Перечисление.ТипыСуммГрафикаКредитовИДепозитов.ОсновнойДолг)
	|		ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыСчетовРеглУчета.РасчетыСДебиторамиОсновнойДолг)
	|		КОГДА ТаблицаОстатков.ТипСуммы = ЗНАЧЕНИЕ(Перечисление.ТипыСуммГрафикаКредитовИДепозитов.Проценты)
	|		ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыСчетовРеглУчета.РасчетыСДебиторамиПроценты)
	|		КОГДА ТаблицаОстатков.ТипСуммы = ЗНАЧЕНИЕ(Перечисление.ТипыСуммГрафикаКредитовИДепозитов.Комиссия)
	|		ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыСчетовРеглУчета.РасчетыСДебиторамиКомиссия)
	|		ИНАЧЕ НЕОПРЕДЕЛЕНО
	|	КОНЕЦ КАК ВидСчета,
	|	Аналитика.Организация КАК Организация,
	|	ТаблицаОстатков.Договор.ГруппаФинансовогоУчета КАК АналитикаУчета,
	|	ТаблицаОстатков.Договор.Подразделение КАК Подразделение,
	|	ТаблицаОстатков.Договор.НаправлениеДеятельности КАК НаправлениеДеятельности,
	|	ТаблицаОстатков.Договор.Контрагент КАК Субконто1,
	|	ТаблицаОстатков.Договор КАК Субконто2,
	|	ТаблицаОстатков.Валюта КАК Валюта,
	|	ТаблицаОстатков.Договор КАК Договор,
	|	ВЫБОР
	|		КОГДА ТаблицаОстатков.ТипСуммы В (ЗНАЧЕНИЕ(Перечисление.ТипыПлатежейПоАренде.АрендныеОбязательства), ЗНАЧЕНИЕ(Перечисление.ТипыПлатежейПоАренде.УслугаПоАренде), ЗНАЧЕНИЕ(Перечисление.ТипыПлатежейПоАренде.УслугаПоАрендеАванс))
	|		ТОГДА -1
	|		КОГДА ТаблицаОстатков.Договор.ХарактерДоговора = ЗНАЧЕНИЕ(Перечисление.ХарактерыДоговоровФинансовыхИнструментов.КредитИлиЗайм)
	|			И ТаблицаОстатков.ТипСуммы = ЗНАЧЕНИЕ(Перечисление.ТипыСуммГрафикаКредитовИДепозитов.ОсновнойДолг)
	|		ТОГДА -1
	|		КОГДА ТаблицаОстатков.Договор.ХарактерДоговора = ЗНАЧЕНИЕ(Перечисление.ХарактерыДоговоровФинансовыхИнструментов.КредитИлиЗайм)
	|			И ТаблицаОстатков.ТипСуммы = ЗНАЧЕНИЕ(Перечисление.ТипыСуммГрафикаКредитовИДепозитов.Проценты)
	|		ТОГДА -1
	|		КОГДА ТаблицаОстатков.Договор.ХарактерДоговора = ЗНАЧЕНИЕ(Перечисление.ХарактерыДоговоровФинансовыхИнструментов.КредитИлиЗайм)
	|			И ТаблицаОстатков.ТипСуммы = ЗНАЧЕНИЕ(Перечисление.ТипыСуммГрафикаКредитовИДепозитов.Комиссия)
	|		ТОГДА -1
	|		КОГДА НЕ ТаблицаОстатков.Договор.ХарактерДоговора = ЗНАЧЕНИЕ(Перечисление.ХарактерыДоговоровФинансовыхИнструментов.КредитИлиЗайм)
	|			И ТаблицаОстатков.ТипСуммы = ЗНАЧЕНИЕ(Перечисление.ТипыСуммГрафикаКредитовИДепозитов.Проценты)
	|		ТОГДА -1
	|		ИНАЧЕ 1
	|	КОНЕЦ КАК Знак,
	|	ТаблицаОстатков.СуммаРеглОстаток КАК Сумма,
	|	ТаблицаОстатков.СуммаУпрОстаток КАК СуммаУУ,
	|	ТаблицаОстатков.СуммаОстаток КАК ВалютнаяСумма,
	|	ТаблицаОстатков.СуммаРеглОстаток КАК СуммаНУ
	|ИЗ
	|	РегистрНакопления.РасчетыПоФинансовымИнструментам.Остатки(&Период,) КАК ТаблицаОстатков
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КлючиАналитикиУчетаПоПартнерам КАК Аналитика
	|		ПО ТаблицаОстатков.АналитикаУчетаПоПартнерам = Аналитика.Ссылка
	|			И Аналитика.Организация = &Организация
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ИзмененныеНастройкиСводно КАК ИзмененныеНастройки
	|		ПО ИзмененныеНастройки.АналитикаУчета = ТаблицаОстатков.Договор.ГруппаФинансовогоУчета
	|			И ИзмененныеНастройки.ИмяРегистра = ""РасчетыПоФинансовымИнструментам""";
	ТекстыВложенногоЗапроса.Добавить(ТекстЗапроса);
	#КонецОбласти
	
	СтрокаВложенногоЗапроса = СтрСоединить(ТекстыВложенногоЗапроса, ОбщегоНазначенияУТ.РазделительЗапросовВОбъединении());
	
	#Область ТаблицаРасчетыПоФинансовымИнструментам
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	Данные.ВидСчета КАК ВидСчета,
	|	Данные.Организация КАК Организация,
	|	Данные.АналитикаУчета КАК АналитикаУчета,
	|	Данные.Подразделение КАК Подразделение,
	|	Данные.НаправлениеДеятельности КАК НаправлениеДеятельности,
	|	Данные.Субконто1 КАК Субконто1,
	|	Данные.Субконто2 КАК Субконто2,
	|	Данные.Валюта КАК Валюта,
	|	Данные.Договор КАК Договор,
	|	Данные.Знак * Данные.Сумма КАК Сумма,
	|	Данные.Знак * Данные.СуммаУУ КАК СуммаУУ,
	|	Данные.Знак * Данные.ВалютнаяСумма КАК ВалютнаяСумма,
	|	Данные.Знак * Данные.СуммаНУ КАК СуммаНУ
	|ПОМЕСТИТЬ ТаблицаРасчетыПоФинансовымИнструментам
	|ИЗ
	|	ТаблицаРасчетыПоФинансовымИнструментамПредварительная КАК Данные
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ ИзмененныеНастройки КАК ИзмененныеНастройки
	|	ПО ИзмененныеНастройки.ВидСчета = Данные.ВидСчета
	|		И ИзмененныеНастройки.АналитикаУчета = Данные.АналитикаУчета
	|		И ИзмененныеНастройки.Организация = Данные.Организация";
	Если Не НастройкаСчетовУчетаСервер.НастройкиАналитикиУчетаПоРазделуУчета("РасчетыСПартнерами").Используется Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Данные.АналитикаУчета", "ЗНАЧЕНИЕ(Справочник.ГруппыФинансовогоУчетаРасчетов.ПустаяСсылка)");
	КонецЕсли;
	#КонецОбласти
	
	Если РежимОтладкиПоИсточникам Тогда
		
		ТекстыЗапроса = Новый Массив;
		ТекстыЗапроса.Добавить(СтрокаВложенногоЗапроса);
		ТекстыЗапроса.Добавить(ТекстЗапроса);
		ТекстЗапроса = СтрСоединить(ТекстыЗапроса, ОбщегоНазначения.РазделительПакетаЗапросов());
		
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ТаблицаРасчетыПоФинансовымИнструментамПредварительная", "(" + СтрокаВложенногоЗапроса + ")");
	КонецЕсли;
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ТекстЗапросаВТ_ТаблицаДолгосрочныеСуммыГрафиков(РежимОтладкиПоИсточникам)
	
	ТекстыВложенногоЗапроса = Новый Массив;
	
	#Область ИнициализацияТаблицаДолгосрочныеСуммыГрафиковПредварительная
	ТекстЗапроса =
	"ВЫБРАТЬ ПЕРВЫЕ 0
	|	//РежимОтладки""Инициализация"" КАК ИсточникДанных,
	|	НЕОПРЕДЕЛЕНО КАК Договор,
	|	0 КАК Сумма,
	|	0 КАК СуммаДолгосрочная
	|ПОМЕСТИТЬ ТаблицаДолгосрочныеСуммыГрафиковПредварительная";
	Если РежимОтладкиПоИсточникам Тогда
		ТекстыВложенногоЗапроса.Добавить(ТекстЗапроса);
	КонецЕсли;
	#КонецОбласти
	
	#Область ГрафикОплатКредитовИДепозитов
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	//РежимОтладки""ГрафикОплатКредитовИДепозитов"" КАК ИсточникДанных,
	|	Данные.Договор КАК Договор,
	|	СУММА(График.Сумма) КАК Сумма,
	|	СУММА(ВЫБОР
	|		КОГДА ДОБАВИТЬКДАТЕ(&Период, МЕСЯЦ, ЕСТЬNULL(УчетнаяПолитикаОрганизаций.МесяцыДолгосрочнойЗадолженности, 999)) <= График.Период
	|		ТОГДА График.Сумма
	|		ИНАЧЕ 0
	|	КОНЕЦ) КАК СуммаДолгосрочная
	|ИЗ
	|	ТаблицаРасчетыПоФинансовымИнструментам КАК Данные
	|	ЛЕВОЕ СОЕДИНЕНИЕ УчетнаяПолитикаОрганизаций КАК УчетнаяПолитикаОрганизаций
	|	ПО Данные.Организация = УчетнаяПолитикаОрганизаций.Организация
	|		И УчетнаяПолитикаОрганизаций.ДолгосрочныеАктивыОбязательства
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ГрафикОплатКредитовИДепозитов КАК График
	|	ПО Данные.Договор = График.ВариантГрафика.Владелец
	|		И График.ВариантГрафика.Используется = ИСТИНА
	|		И НЕ График.ВариантГрафика.ПометкаУдаления
	|ГДЕ
	|	Данные.ВидСчета В (ЗНАЧЕНИЕ(Перечисление.ВидыСчетовРеглУчета.РасчетыСКредиторамиОсновнойДолг),
	|						ЗНАЧЕНИЕ(Перечисление.ВидыСчетовРеглУчета.РасчетыСДебиторамиОсновнойДолг))
	|
	|СГРУППИРОВАТЬ ПО
	|	Данные.Договор
	|
	|ИМЕЮЩИЕ
	|	СУММА(График.Сумма) > 0";
	ТекстыВложенногоЗапроса.Добавить(ТекстЗапроса);
	#КонецОбласти
	
	#Область ГрафикОплатУслугПоАренде
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	//РежимОтладки""ГрафикОплатУслугПоАренде"" КАК ИсточникДанных,
	|	Данные.Договор КАК Договор,
	|	СУММА(График.УслугаПоАренде + График.ВыкупнаяСтоимость) КАК Сумма,
	|	СУММА(ВЫБОР
	|		КОГДА ДОБАВИТЬКДАТЕ(&Период, МЕСЯЦ, ЕСТЬNULL(УчетнаяПолитикаОрганизаций.МесяцыДолгосрочнойЗадолженности, 999)) <= График.Дата
	|		ТОГДА График.УслугаПоАренде - График.УслугаПоАрендеНДС
	|		ИНАЧЕ 0
	|	КОНЕЦ) КАК СуммаДолгосрочная
	|ИЗ
	|	ТаблицаРасчетыПоФинансовымИнструментам КАК Данные
	|	ЛЕВОЕ СОЕДИНЕНИЕ УчетнаяПолитикаОрганизаций КАК УчетнаяПолитикаОрганизаций
	|	ПО Данные.Организация = УчетнаяПолитикаОрганизаций.Организация
	|		И УчетнаяПолитикаОрганизаций.ДолгосрочныеАктивыОбязательства
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.УсловияДоговоровАренды.СрезПоследних(&Период, ) КАК УсловияДоговоровАренды
	|	ПО Данные.Договор = УсловияДоговоровАренды.Договор
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ГрафикОплатУслугПоАренде КАК График
	|	ПО Данные.Договор = График.Договор
	|		И График.АктуальныеУсловияДоговора = УсловияДоговоровАренды.АктуальныеУсловияДоговора
	|ГДЕ
	|	Данные.ВидСчета В (ЗНАЧЕНИЕ(Перечисление.ВидыСчетовРеглУчета.АрендныеОбязательства))
	|
	|СГРУППИРОВАТЬ ПО
	|	Данные.Договор
	|
	|ИМЕЮЩИЕ
	|	СУММА(График.УслугаПоАренде - График.УслугаПоАрендеНДС) > 0";
	ТекстыВложенногоЗапроса.Добавить(ТекстЗапроса);
	#КонецОбласти
	
	#Область ГрафикНачисленияПроцентовПоАренде
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	//РежимОтладки""ГрафикНачисленияПроцентовПоАренде"" КАК ИсточникДанных,
	|	Данные.Договор КАК Договор,
	|	0 КАК Сумма,
	|	-СУММА(ВЫБОР
	|		КОГДА ДОБАВИТЬКДАТЕ(&Период, МЕСЯЦ, ЕСТЬNULL(УчетнаяПолитикаОрганизаций.МесяцыДолгосрочнойЗадолженности, 999)) <= График.Дата
	|		ТОГДА График.Проценты
	|		ИНАЧЕ 0
	|	КОНЕЦ) КАК СуммаДолгосрочная
	|ИЗ
	|	ТаблицаРасчетыПоФинансовымИнструментам КАК Данные
	|	ЛЕВОЕ СОЕДИНЕНИЕ УчетнаяПолитикаОрганизаций КАК УчетнаяПолитикаОрганизаций
	|	ПО Данные.Организация = УчетнаяПолитикаОрганизаций.Организация
	|		И УчетнаяПолитикаОрганизаций.ДолгосрочныеАктивыОбязательства
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.УсловияДоговоровАренды.СрезПоследних(&Период, ) КАК УсловияДоговоровАренды
	|	ПО Данные.Договор = УсловияДоговоровАренды.Договор
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ГрафикНачисленияПроцентовПоАренде КАК График
	|	ПО Данные.Договор = График.Договор
	|		И График.АктуальныеУсловияДоговора = УсловияДоговоровАренды.АктуальныеУсловияДоговора
	|ГДЕ
	|	Данные.ВидСчета В (ЗНАЧЕНИЕ(Перечисление.ВидыСчетовРеглУчета.АрендныеОбязательства))
	|
	|СГРУППИРОВАТЬ ПО
	|	Данные.Договор
	|
	|ИМЕЮЩИЕ
	|	СУММА(График.Проценты) > 0";
	ТекстыВложенногоЗапроса.Добавить(ТекстЗапроса);
	#КонецОбласти
	
	СтрокаВложенногоЗапроса = СтрСоединить(ТекстыВложенногоЗапроса, ОбщегоНазначенияУТ.РазделительЗапросовВОбъединении());
	
	#Область ТаблицаДолгосрочныеСуммыГрафиков
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	Данные.Договор КАК Договор,
	|	СУММА(Данные.СуммаДолгосрочная) КАК СуммаДолгосрочная,
	|	СУММА(Данные.Сумма) КАК Сумма,
	|	ВЫРАЗИТЬ(СУММА(Данные.СуммаДолгосрочная) / СУММА(Данные.Сумма) КАК ЧИСЛО(31,10)) КАК Коэффициент
	|ПОМЕСТИТЬ ТаблицаДолгосрочныеСуммыГрафиков
	|ИЗ
	|	ТаблицаДолгосрочныеСуммыГрафиковПредварительная КАК Данные
	|
	|СГРУППИРОВАТЬ ПО
	|	Данные.Договор
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Договор";
	#КонецОбласти
	
	Если РежимОтладкиПоИсточникам Тогда
		
		ТекстыЗапроса = Новый Массив;
		ТекстыЗапроса.Добавить(СтрокаВложенногоЗапроса);
		ТекстыЗапроса.Добавить(ТекстЗапроса);
		ТекстЗапроса = СтрСоединить(ТекстыЗапроса, ОбщегоНазначения.РазделительПакетаЗапросов());
		
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ТаблицаДолгосрочныеСуммыГрафиковПредварительная", "(" + СтрокаВложенногоЗапроса + ")");
	КонецЕсли;
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ТекстЗапросаВТ_ТаблицаРасчетыПоФинансовымИнструментамДолгосрок(РежимОтладкиПоИсточникам)
	
	ТекстыВложенногоЗапроса = Новый Массив;
	
	#Область ИнициализацияТаблицаРасчетыПоФинансовымИнструментамДолгосрокПредварительная
	ТекстЗапроса =
	"ВЫБРАТЬ ПЕРВЫЕ 0
	|	//РежимОтладки""Инициализация"" КАК ИсточникДанных,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыСчетовРеглУчета.ПустаяСсылка) КАК ВидСчета,
	|	ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка) КАК Организация,
	|	ЗНАЧЕНИЕ(Справочник.ГруппыФинансовогоУчетаРасчетов.ПустаяСсылка) КАК АналитикаУчета,
