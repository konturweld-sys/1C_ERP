	|		ТОГДА ВидыЗапасов.Контрагент
	|		КОГДА Аналитика.ТипМестаХранения = ЗНАЧЕНИЕ(Перечисление.ТипыМестХранения.Партнер)
	|		ТОГДА ВЫРАЗИТЬ(ТаблицаОстатков.Партия КАК Документ.РеализацияТоваровУслуг).Контрагент
	|		КОГДА Аналитика.ТипМестаХранения = ЗНАЧЕНИЕ(Перечисление.ТипыМестХранения.Организация)
	|		ТОГДА Аналитика.МестоХранения
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|	КОНЕЦ КАК Субконто2,
	|	Аналитика.МестоХранения КАК Субконто3,
	|	НЕОПРЕДЕЛЕНО КАК Субконто4,
	|	НЕОПРЕДЕЛЕНО КАК Субконто5,
	|	НЕОПРЕДЕЛЕНО КАК Субконто6,
	|	НЕОПРЕДЕЛЕНО КАК Валюта,
	|	ДетализацияСебестоимостиПартииТоваров.НДСРегл КАК Сумма,
	|	ДетализацияСебестоимостиПартииТоваров.НДСУпр КАК СуммаУУ,
	|	0 КАК ВалютнаяСумма,
	|	0 КАК Количество,
	|	0 КАК СуммаНУ,
	|	0 КАК СуммаПР,
	|	0 КАК СуммаВР
	|ИЗ
	|	РегистрНакопления.СебестоимостьТоваров.Остатки(&Период, Организация = &Организация И ВидДеятельностиНДС В (&ТипыОблагаемыеНДС)
	|		И РазделУчета = ЗНАЧЕНИЕ(Перечисление.РазделыУчетаСебестоимостиТоваров.ТоварыВПути)) КАК ТаблицаОстатков
	|
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ ИзмененныеНастройкиСводно КАК ИзмененныеНастройки
	|	ПО ИзмененныеНастройки.ВидСчета = ЗНАЧЕНИЕ(Перечисление.ВидыСчетовРеглУчета.НДСПриОтгрузкеБезПереходаПраваСобственности)
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ УчетнаяПолитикаОрганизаций КАК УчетнаяПолитикаОрганизаций
	|	ПО ТаблицаОстатков.Организация = УчетнаяПолитикаОрганизаций.Организация
	|		И УчетнаяПолитикаОрганизаций.МетодОценкиСтоимостиТоваров = ЗНАЧЕНИЕ(Перечисление.МетодыОценкиСтоимостиТоваров.ФИФОСкользящаяОценка)
	|	ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВидыЗапасов КАК ВидыЗапасов
	|	ПО ТаблицаОстатков.ВидЗапасов = ВидыЗапасов.Ссылка
	|	ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КлючиАналитикиУчетаНоменклатуры КАК Аналитика
	|	ПО ТаблицаОстатков.АналитикаУчетаНоменклатуры = Аналитика.Ссылка
	|	ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Назначения КАК Назначения
	|	ПО Аналитика.Назначение = Назначения.Ссылка
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ДетализацияСебестоимостиПартииТоваров КАК ДетализацияСебестоимостиПартииТоваров
	|	ПО ТаблицаОстатков.Организация = ДетализацияСебестоимостиПартииТоваров.Организация
	|		И ТаблицаОстатков.Партия = ДетализацияСебестоимостиПартииТоваров.Партия
	|		И ТаблицаОстатков.ВидЗапасов = ДетализацияСебестоимостиПартииТоваров.ВидЗапасов
	|		И Аналитика.Номенклатура = ДетализацияСебестоимостиПартииТоваров.Номенклатура
	|		И Аналитика.Характеристика = ДетализацияСебестоимостиПартииТоваров.Характеристика
	|
	|ГДЕ
	|	ТаблицаОстатков.СтоимостьОстаток - ТаблицаОстатков.СтоимостьБезНДСОстаток <> 0";
	ТекстыВложенногоЗапроса.Добавить(ТекстЗапроса);
	#КонецОбласти
	
	#Область ДетализацияПартийТоваровДляНДСиУСН
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	//РежимОтладки""ДетализацияПартийТоваровДляНДСиУСН"" КАК ИсточникДанных,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыСчетовРеглУчета.НДСПриОтгрузкеБезПереходаПраваСобственности) КАК ВидСчета,
	|	ТаблицаОстатков.Организация КАК Организация,
	|	ВЫБОР
	|		КОГДА &ФормироватьВидыЗапасовПоГруппамФинансовогоУчета И Аналитика.Номенклатура.ТипНоменклатуры <> ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Работа)
	|		ТОГДА ЕСТЬNULL(ВидыЗапасов.ГруппаФинансовогоУчета, ЗНАЧЕНИЕ(Справочник.ГруппыФинансовогоУчетаНоменклатуры.ПустаяСсылка))
	|		ИНАЧЕ Аналитика.Номенклатура.ГруппаФинансовогоУчета
	|	КОНЕЦ КАК АналитикаУчета,
	|	Аналитика.МестоХранения КАК МестоУчета,
	|	ЛОЖЬ КАК Долгосрочный,
	|	ВЫБОР
	|		КОГДА Аналитика.ТипМестаХранения = ЗНАЧЕНИЕ(Перечисление.ТипыМестХранения.ДоговорКонтрагента)
	|		ТОГДА Аналитика.Договор.Подразделение
	|		КОГДА Аналитика.ТипМестаХранения = ЗНАЧЕНИЕ(Перечисление.ТипыМестХранения.Склад)
	|		ТОГДА Аналитика.СкладскаяТерритория.Подразделение
	|		ИНАЧЕ НЕОПРЕДЕЛЕНО
	|	КОНЕЦ КАК Подразделение,
	|	ЕСТЬNULL(Назначения.НаправлениеДеятельности, ЗНАЧЕНИЕ(Справочник.НаправленияДеятельности.ПустаяСсылка)) КАК НаправлениеДеятельности,
	|	Аналитика.Номенклатура КАК Субконто1,
	|	ВЫБОР
	|		КОГДА Аналитика.ТипМестаХранения = ЗНАЧЕНИЕ(Перечисление.ТипыМестХранения.ДоговорКонтрагента)
	|		ТОГДА Аналитика.Договор.Контрагент
	|		КОГДА ВидыЗапасов.ТипЗапасов В (&ТипыЗапасовВнешнийВладелец)
	|		ТОГДА ВидыЗапасов.Контрагент
	|		КОГДА Аналитика.ТипМестаХранения = ЗНАЧЕНИЕ(Перечисление.ТипыМестХранения.Партнер)
	|		ТОГДА ВЫРАЗИТЬ(ТаблицаОстатков.Партия КАК Документ.РеализацияТоваровУслуг).Контрагент
	|		КОГДА Аналитика.ТипМестаХранения = ЗНАЧЕНИЕ(Перечисление.ТипыМестХранения.Организация)
	|		ТОГДА Аналитика.МестоХранения
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|	КОНЕЦ КАК Субконто2,
	|	Аналитика.МестоХранения КАК Субконто3,
	|	НЕОПРЕДЕЛЕНО КАК Субконто4,
	|	НЕОПРЕДЕЛЕНО КАК Субконто5,
	|	НЕОПРЕДЕЛЕНО КАК Субконто6,
	|	НЕОПРЕДЕЛЕНО КАК Валюта,
	|	ТаблицаОстатков.НДСОстаток КАК Сумма,
	|	ТаблицаОстатков.НДСУпрОстаток КАК СуммаУУ,
	|	0 КАК ВалютнаяСумма,
	|	0 КАК Количество,
	|	0 КАК СуммаНУ,
	|	0 КАК СуммаПР,
	|	0 КАК СуммаВР
	|ИЗ
	|	РегистрНакопления.ДетализацияПартийТоваровДляНДСиУСН.Остатки(&Период, Организация = &Организация И ВидДеятельностиНДС В (&ТипыОблагаемыеНДС)
	|		И РазделУчета = ЗНАЧЕНИЕ(Перечисление.РазделыУчетаСебестоимостиТоваров.ТоварыВПути)) КАК ТаблицаОстатков
	|
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ ИзмененныеНастройкиСводно КАК ИзмененныеНастройки
	|	ПО ИзмененныеНастройки.ВидСчета = ЗНАЧЕНИЕ(Перечисление.ВидыСчетовРеглУчета.НДСПриОтгрузкеБезПереходаПраваСобственности)
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ УчетнаяПолитикаОрганизаций КАК УчетнаяПолитикаОрганизаций
	|	ПО ТаблицаОстатков.Организация = УчетнаяПолитикаОрганизаций.Организация
	|		И УчетнаяПолитикаОрганизаций.МетодОценкиСтоимостиТоваров = ЗНАЧЕНИЕ(Перечисление.МетодыОценкиСтоимостиТоваров.СредняяЗаМесяц)
	|	ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВидыЗапасов КАК ВидыЗапасов
	|	ПО ТаблицаОстатков.ВидЗапасов = ВидыЗапасов.Ссылка
	|	ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КлючиАналитикиУчетаНоменклатуры КАК Аналитика
	|	ПО ТаблицаОстатков.АналитикаУчетаНоменклатуры = Аналитика.Ссылка
	|	ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Назначения КАК Назначения
	|	ПО Аналитика.Назначение = Назначения.Ссылка
	|
	|ГДЕ
	|	ТаблицаОстатков.НДСОстаток <> 0";
	ТекстыВложенногоЗапроса.Добавить(ТекстЗапроса);
	#КонецОбласти
	
	Если РежимОтладкиПоИсточникам Тогда
		ТекстыВложенногоЗапроса.Добавить(ТекстЗапроса_ОтклоненияВСтоимости());
	КонецЕсли;
	
	СтрокаВложенногоЗапроса = СтрСоединить(ТекстыВложенногоЗапроса, ОбщегоНазначенияУТ.РазделительЗапросовВОбъединении());
	
	#Область ТаблицаНоменклатура
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	Данные.ВидСчета КАК ВидСчета,
	|	Данные.Организация КАК Организация,
	|	Данные.АналитикаУчета КАК АналитикаУчета,
	|	Данные.МестоУчета КАК МестоУчета,
	|	Данные.Подразделение КАК Подразделение,
	|	Данные.НаправлениеДеятельности КАК НаправлениеДеятельности,
	|	Данные.Субконто1 КАК Субконто1,
	|	Данные.Субконто2 КАК Субконто2,
	|	Данные.Субконто3 КАК Субконто3,
	|	Данные.Субконто4 КАК Субконто4,
	|	Данные.Субконто5 КАК Субконто5,
	|	Данные.Субконто6 КАК Субконто6,
	|	Данные.Валюта КАК Валюта,
	|	Данные.Сумма КАК Сумма,
	|	Данные.СуммаУУ КАК СуммаУУ,
	|	Данные.ВалютнаяСумма КАК ВалютнаяСумма,
	|	Данные.Количество КАК Количество,
	|	Данные.СуммаНУ КАК СуммаНУ,
	|	Данные.СуммаПР КАК СуммаПР,
	|	Данные.СуммаВР КАК СуммаВР
	|ПОМЕСТИТЬ Номенклатура
	|ИЗ
	|	НоменклатураПредварительная КАК Данные
	|
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ ИзмененныеНастройки КАК ИзмененныеНастройки
	|	ПО  ИзмененныеНастройки.ИмяРегистра = ""СебестоимостьТоваров""
	|		И Данные.ВидСчета = ИзмененныеНастройки.ВидСчета
	|		И Данные.АналитикаУчета = ИзмененныеНастройки.АналитикаУчета
	|		И ИзмененныеНастройки.Организация = Данные.Организация
	|		И (ИзмененныеНастройки.МестоУчета = Данные.МестоУчета ИЛИ ИзмененныеНастройки.МестоУчета = Неопределено)";
	Если Не НастройкаСчетовУчетаСервер.НастройкиАналитикиУчетаПоРазделуУчета("Номенклатура").Используется Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Данные.АналитикаУчета", "ЗНАЧЕНИЕ(Справочник.ГруппыФинансовогоУчетаНоменклатуры.ПустаяСсылка)");
	КонецЕсли;
	#КонецОбласти
	
	Если РежимОтладкиПоИсточникам Тогда
		
		ТекстыЗапроса = Новый Массив;
		ТекстыЗапроса.Добавить(СтрокаВложенногоЗапроса);
		ТекстыЗапроса.Добавить(ТекстЗапроса);
		ТекстЗапроса = СтрСоединить(ТекстыЗапроса, ОбщегоНазначения.РазделительПакетаЗапросов());
		
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "НоменклатураПредварительная", "(" + СтрокаВложенногоЗапроса + ")");
	КонецЕсли;
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ТекстЗапроса_ОтклоненияВСтоимости()
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	//РежимОтладки""ОтклоненияВСтоимости"" КАК ИсточникДанных,
	|	ИзмененныеНастройки.ВидСчета КАК ВидСчета,
	|	ТаблицаОстатков.Организация КАК Организация,
	|	ТаблицаОстатков.Номенклатура.ГруппаФинансовогоУчета КАК АналитикаУчета,
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(ТаблицаОстатков.МестоХранения) = ТИП(Справочник.ДоговорыКонтрагентов)
	|		ТОГДА ВЫРАЗИТЬ(ТаблицаОстатков.МестоХранения КАК Справочник.ДоговорыКонтрагентов).Партнер
	|		ИНАЧЕ ТаблицаОстатков.МестоХранения
	|	КОНЕЦ КАК МестоУчета,
	|	ЛОЖЬ КАК Долгосрочный,
	|	ТаблицаОстатков.Подразделение КАК Подразделение,
	|	ТаблицаОстатков.НаправлениеДеятельности КАК НаправлениеДеятельности,
	|	ТаблицаОстатков.Номенклатура КАК Субконто1,
	|	ВЫРАЗИТЬ(ТаблицаОстатков.МестоХранения КАК Справочник.Склады) КАК Субконто2,
	|	НЕОПРЕДЕЛЕНО КАК Субконто3,
	|	НЕОПРЕДЕЛЕНО КАК Субконто4,
	|	НЕОПРЕДЕЛЕНО КАК Субконто5,
	|	НЕОПРЕДЕЛЕНО КАК Субконто6,
	|	НЕОПРЕДЕЛЕНО КАК Валюта,
	|	ТаблицаОстатков.ОтклоненияВСтоимостиРеглОстаток + ТаблицаОстатков.ДопРасходыРеглОстаток КАК Сумма,
	|	ТаблицаОстатков.ОтклоненияВСтоимостиУпрОстаток + ТаблицаОстатков.ДопРасходыУпрОстаток КАК СуммаУУ,
	|	0 КАК ВалютнаяСумма,
	|	0 КАК Количество,
	|	ТаблицаОстатков.ОтклоненияВСтоимостиРеглОстаток + ТаблицаОстатков.ДопРасходыРеглОстаток - ТаблицаОстатков.ПостояннаяРазницаОстаток - ТаблицаОстатков.ВременнаяРазницаОстаток КАК СуммаНУ,
	|	ТаблицаОстатков.ПостояннаяРазницаОстаток КАК СуммаПР,
	|	ТаблицаОстатков.ВременнаяРазницаОстаток КАК СуммаВР
	|ИЗ
	|	РегистрНакопления.ОтклоненияВСтоимостиТоваров.Остатки(&Период, Организация = &Организация) КАК ТаблицаОстатков
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ ИзмененныеНастройки КАК ИзмененныеНастройки
	|	ПО ИзмененныеНастройки.ВидСчета = ЗНАЧЕНИЕ(Перечисление.ВидыСчетовРеглУчета.ОтклоненияВСтоимости)
	|		И ИзмененныеНастройки.АналитикаУчета = ТаблицаОстатков.Номенклатура.ГруппаФинансовогоУчета";
	
	Если Не НастройкаСчетовУчетаСервер.НастройкиАналитикиУчетаПоРазделуУчета("Номенклатура").Используется Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ТаблицаОстатков.Номенклатура.ГруппаФинансовогоУчета", "ЗНАЧЕНИЕ(Справочник.ГруппыФинансовогоУчетаНоменклатуры.ПустаяСсылка)");
	КонецЕсли;
	Если ПолучитьФункциональнуюОпцию("ФормироватьВидыЗапасовПоГруппамФинансовогоУчета") Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ТаблицаОстатков.Номенклатура.ГруппаФинансовогоУчета",
			"ЕСТЬNULL(ТаблицаОстатков.ВидЗапасов.ГруппаФинансовогоУчета, ЗНАЧЕНИЕ(Справочник.ГруппыФинансовогоУчетаНоменклатуры.ПустаяСсылка))");
	КонецЕсли;
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ТекстЗапросаВТ_РасчетыСКомитентамиПоПродаже(РежимОтладкиПоИсточникам)
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ТаблицаОстатков.Организация КАК Организация,
	|	ВЫБОР
	|		КОГДА ВидыЗапасов.ТипЗапасов В (&ТипыЗапасовВнешнийВладелец)
	|			И ВидыЗапасов.Договор ССЫЛКА Справочник.ДоговорыМеждуОрганизациями
	|			И ТаблицаОстатков.Организация = ВидыЗапасов.Договор.ОрганизацияПолучатель
	|		ТОГДА ЕСТЬNULL(ВидыЗапасов.Договор.ГруппаФинансовогоУчетаПолучателя, ЗНАЧЕНИЕ(Справочник.ГруппыФинансовогоУчетаРасчетов.ПустаяСсылка))
	|		КОГДА ВидыЗапасов.ТипЗапасов В (&ТипыЗапасовВнешнийВладелец)
	|		ТОГДА ЕСТЬNULL(ВидыЗапасов.Договор.ГруппаФинансовогоУчета, ЗНАЧЕНИЕ(Справочник.ГруппыФинансовогоУчетаРасчетов.ПустаяСсылка))
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ГруппыФинансовогоУчетаРасчетов.ПустаяСсылка)
	|	КОНЕЦ КАК АналитикаУчета,
	|	ВидыЗапасов.Договор.Подразделение КАК Подразделение,
	|	Аналитика.Назначение.НаправлениеДеятельности КАК НаправлениеДеятельности,
	|	Аналитика.Номенклатура КАК Субконто1,
	|	ВЫБОР
	|		КОГДА Аналитика.ТипМестаХранения = ЗНАЧЕНИЕ(Перечисление.ТипыМестХранения.ДоговорКонтрагента)
	|		ТОГДА Аналитика.Договор.Контрагент
	|		КОГДА ВидыЗапасов.ТипЗапасов В (&ТипыЗапасовВнешнийВладелец)
	|		ТОГДА ВидыЗапасов.Контрагент
	|		КОГДА Аналитика.ТипМестаХранения = ЗНАЧЕНИЕ(Перечисление.ТипыМестХранения.Партнер)
	|		ТОГДА Аналитика.Контрагент
	|		КОГДА Аналитика.ТипМестаХранения = ЗНАЧЕНИЕ(Перечисление.ТипыМестХранения.Организация)
	|		ТОГДА Аналитика.МестоХранения
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|	КОНЕЦ КАК Субконто2,
	|	ТаблицаОстатков.Валюта КАК Валюта,
	|	ТаблицаОстатков.СуммаВыручкиРеглОстаток КАК Сумма,
	|	ТаблицаОстатков.СуммаВыручкиУпрОстаток КАК СуммаУУ,
	|	ТаблицаОстатков.СуммаВыручкиОстаток КАК ВалютнаяСумма,
	|	ТаблицаОстатков.КоличествоОстаток КАК Количество
	|ПОМЕСТИТЬ РасчетыСКомитентамиПоПродаже
	|ИЗ
	|	РегистрНакопления.ТоварыКОформлениюОтчетовКомитенту.Остатки(&Период, Организация = &Организация) КАК ТаблицаОстатков
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ ИзмененныеНастройкиСводно КАК ИзмененныеНастройки
	|	ПО ИзмененныеНастройки.ВидСчета = ЗНАЧЕНИЕ(Перечисление.ВидыСчетовРеглУчета.ТоварыКомитентовКОформлениюПоПродаже)
	|	ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВидыЗапасов КАК ВидыЗапасов
	|	ПО ТаблицаОстатков.ВидЗапасов = ВидыЗапасов.Ссылка
	|	ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КлючиАналитикиУчетаНоменклатуры КАК Аналитика
	|	ПО ТаблицаОстатков.АналитикаУчетаНоменклатуры = Аналитика.Ссылка";
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ТекстЗапросаВТ_ПрочиеРасходыОстатки(РежимОтладкиПоИсточникам)
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ИзмененныеНастройки.ВидСчета КАК ВидСчета,
	|	ТаблицаОстатков.Организация КАК Организация,
	|	ТаблицаОстатков.СтатьяРасходов КАК СтатьяРасходов,
	|	ТаблицаОстатков.Подразделение КАК Подразделение,
	|	ТаблицаОстатков.НаправлениеДеятельности КАК НаправлениеДеятельности,
	|	ТаблицаОстатков.АналитикаРасходов КАК АналитикаРасходов,
	|	ТаблицаОстатков.СуммаРеглОстаток КАК Сумма,
	|	ТаблицаОстатков.СуммаУпрОстаток КАК СуммаУУ,
	|	ТаблицаОстатков.ПостояннаяРазницаОстаток КАК СуммаПР,
	|	ТаблицаОстатков.ВременнаяРазницаОстаток КАК СуммаВР,
	|	ЕСТЬNULL(ТаблицаОстатков.СтатьяРасходов.ГруппаФинансовогоУчетаРегл, ЗНАЧЕНИЕ(Справочник.ГруппыФинансовогоУчетаДоходовРасходов.ПустаяСсылка)) КАК АналитикаУчета,
	|	ЕСТЬNULL(ТаблицаОстатков.СтатьяРасходов.ГруппаФинансовогоУчетаНУ, ЗНАЧЕНИЕ(Справочник.ГруппыФинансовогоУчетаДоходовРасходов.ПустаяСсылка)) КАК АналитикаУчетаНУ,
	|	ЕСТЬNULL(ТаблицаОстатков.СтатьяРасходов.ГруппаФинансовогоУчета, ЗНАЧЕНИЕ(Справочник.ГруппыФинансовогоУчетаДоходовРасходов.ПустаяСсылка)) КАК АналитикаУчетаУУ,
	|	ВЫБОР
	|		КОГДА ТаблицаОстатков.СтатьяРасходов.ВариантРаспределенияРасходовРегл = ЗНАЧЕНИЕ(Перечисление.ВариантыРаспределенияРасходов.НаВнеоборотныеАктивы)
	|		ТОГДА ЕСТЬNULL(ОбъектыСтроительства.СпособСтроительства, ЗНАЧЕНИЕ(Перечисление.СпособыСтроительства.Подрядный))
	|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ТипыЗатратРегл.Прочее)
	|	КОНЕЦ КАК Субконто
	|ПОМЕСТИТЬ ПрочиеРасходыОстатки
	|ИЗ
	|	РегистрНакопления.ПрочиеРасходы.Остатки(&Период, Организация = &Организация И СтатьяРасходов.ВидДеятельностиРасходов <> ЗНАЧЕНИЕ(Перечисление.ВидыДеятельностиРасходов.ПрочаяДеятельность)) КАК ТаблицаОстатков
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ ИзмененныеНастройкиСводно КАК ИзмененныеНастройки
	|	ПО ИзмененныеНастройки.ВидСчета = ЗНАЧЕНИЕ(Перечисление.ВидыСчетовРеглУчета.Расходы)
	|	ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ОбъектыСтроительства КАК ОбъектыСтроительства
	|	ПО ОбъектыСтроительства.Ссылка = ТаблицаОстатков.АналитикаРасходов
	|		И ТаблицаОстатков.СтатьяРасходов.ВариантРаспределенияРасходовРегл = ЗНАЧЕНИЕ(Перечисление.ВариантыРаспределенияРасходов.НаВнеоборотныеАктивы)
	|		И ОбъектыСтроительства.СпособСтроительства <> ЗНАЧЕНИЕ(Перечисление.СпособыСтроительства.ПустаяСсылка)";
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ТекстЗапросаВТ_Расходы(РежимОтладкиПоИсточникам)
	
	ТекстыВложенногоЗапроса = Новый Массив;
	
	#Область ИнициализацияРасходыПредварительная
	ТекстЗапроса =
	"ВЫБРАТЬ ПЕРВЫЕ 0
	|	//РежимОтладки""Инициализация"" КАК ИсточникДанных,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыСчетовРеглУчета.ПустаяСсылка) КАК ВидСчета,
	|	ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка) КАК Организация,
	|	ЗНАЧЕНИЕ(Справочник.ГруппыФинансовогоУчетаДоходовРасходов.ПустаяСсылка) КАК АналитикаУчета,
	|	НЕОПРЕДЕЛЕНО КАК МестоУчета,
	|	ЗНАЧЕНИЕ(Справочник.СтруктураПредприятия.ПустаяСсылка) КАК Подразделение,
	|	ЗНАЧЕНИЕ(Справочник.НаправленияДеятельности.ПустаяСсылка) КАК НаправлениеДеятельности,
	|	ЗНАЧЕНИЕ(ПланВидовХарактеристик.СтатьиРасходов.ПустаяСсылка) КАК Субконто1,
	|	НЕОПРЕДЕЛЕНО КАК Субконто2,
	|	НЕОПРЕДЕЛЕНО КАК Субконто3,
	|	0 КАК Сумма,
	|	0 КАК СуммаУУ,
	|	0 КАК СуммаНУ,
	|	0 КАК СуммаПР,
	|	0 КАК СуммаВР
	|ПОМЕСТИТЬ РасходыПредварительная";
	Если РежимОтладкиПоИсточникам Тогда
		ТекстыВложенногоЗапроса.Добавить(ТекстЗапроса);
	КонецЕсли;
	#КонецОбласти
	
	#Область РеглУчет
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	//РежимОтладки""РеглУчет"" КАК ИсточникДанных,
	|	Данные.ВидСчета КАК ВидСчета,
	|	Данные.Организация КАК Организация,
	|	Данные.АналитикаУчета КАК АналитикаУчета,
	|	Данные.Подразделение КАК МестоУчета,
	|	Данные.Подразделение КАК Подразделение,
	|	Данные.НаправлениеДеятельности КАК НаправлениеДеятельности,
	|	Данные.СтатьяРасходов КАК Субконто1,
	|	Данные.АналитикаРасходов КАК Субконто2,
	|	Данные.Субконто КАК Субконто3,
	|	Данные.Сумма КАК Сумма,
	|	ВЫБОР
	|		КОГДА Данные.АналитикаУчета = Данные.АналитикаУчетаУУ
	|		ТОГДА Данные.СуммаУУ
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК СуммаУУ,
	|	ВЫБОР
	|		КОГДА Данные.АналитикаУчета = Данные.АналитикаУчетаНУ
	|		ТОГДА Данные.Сумма - Данные.СуммаПР - Данные.СуммаВР
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК СуммаНУ,
	|	ВЫБОР
	|		КОГДА Данные.АналитикаУчета = Данные.АналитикаУчетаНУ
	|		ТОГДА Данные.СуммаПР
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК СуммаПР,
	|	ВЫБОР
	|		КОГДА Данные.АналитикаУчета = Данные.АналитикаУчетаНУ
	|		ТОГДА Данные.СуммаВР
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК СуммаВР
	|ИЗ
	|	ПрочиеРасходыОстатки КАК Данные";
	ТекстыВложенногоЗапроса.Добавить(ТекстЗапроса);
	#КонецОбласти
	
	#Область УпрУчет
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	//РежимОтладки""УпрУчет"" КАК ИсточникДанных,
	|	Данные.ВидСчета,
	|	Данные.Организация,
	|	Данные.АналитикаУчетаУУ КАК АналитикаУчета,
	|	Данные.Подразделение КАК МестоУчета,
	|	Данные.Подразделение,
	|	Данные.НаправлениеДеятельности,
	|	Данные.СтатьяРасходов КАК Субконто1,
	|	Данные.АналитикаРасходов КАК Субконто2,
	|	Данные.Субконто КАК Субконто3,
	|	0 КАК Сумма,
	|	Данные.СуммаУУ КАК СуммаУУ,
	|	0 КАК СуммаНУ,
	|	0 КАК СуммаПР,
	|	0 КАК СуммаВР
	|ИЗ
	|	ПрочиеРасходыОстатки КАК Данные
	|ГДЕ
	|	Данные.АналитикаУчета <> Данные.АналитикаУчетаУУ";
	ТекстыВложенногоЗапроса.Добавить(ТекстЗапроса);
	#КонецОбласти
	
	#Область НалоговыйУчет
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	//РежимОтладки""НалоговыйУчет"" КАК ИсточникДанных,
	|	Данные.ВидСчета,
	|	Данные.Организация,
	|	Данные.АналитикаУчетаНУ КАК АналитикаУчета,
	|	Данные.Подразделение КАК МестоУчета,
	|	Данные.Подразделение,
	|	Данные.НаправлениеДеятельности,
	|	Данные.СтатьяРасходов КАК Субконто1,
	|	Данные.АналитикаРасходов КАК Субконто2,
	|	Данные.Субконто КАК Субконто3,
	|	0 КАК Сумма,
	|	0 КАК СуммаУУ,
	|	Данные.Сумма - Данные.СуммаПР - Данные.СуммаВР КАК СуммаНУ,
	|	Данные.СуммаПР КАК СуммаПР,
	|	Данные.СуммаВР КАК СуммаВР
	|ИЗ
	|	ПрочиеРасходыОстатки КАК Данные
	|ГДЕ
	|	Данные.АналитикаУчета <> Данные.АналитикаУчетаНУ";
	ТекстыВложенногоЗапроса.Добавить(ТекстЗапроса);
	#КонецОбласти
	
	СтрокаВложенногоЗапроса = СтрСоединить(ТекстыВложенногоЗапроса, ОбщегоНазначенияУТ.РазделительЗапросовВОбъединении());
	
	#Область Расходы
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	Данные.ВидСчета КАК ВидСчета,
	|	Данные.Организация КАК Организация,
	|	Данные.АналитикаУчета КАК АналитикаУчета,
	|	Данные.МестоУчета КАК МестоУчета,
	|	Данные.Подразделение КАК Подразделение,
	|	Данные.НаправлениеДеятельности КАК НаправлениеДеятельности,
	|	Данные.Субконто1 КАК Субконто1,
	|	Данные.Субконто2 КАК Субконто2,
	|	Данные.Субконто3 КАК Субконто3,
	|	Данные.Сумма КАК Сумма,
	|	Данные.СуммаУУ КАК СуммаУУ,
	|	Данные.СуммаНУ КАК СуммаНУ,
	|	Данные.СуммаПР КАК СуммаПР,
	|	Данные.СуммаВР КАК СуммаВР
	|ПОМЕСТИТЬ Расходы
	|ИЗ
	|	РасходыПредварительная КАК Данные
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ ИзмененныеНастройки КАК ИзмененныеНастройки
	|	ПО ИзмененныеНастройки.ВидСчета = Данные.ВидСчета
	|		И ИзмененныеНастройки.АналитикаУчета = Данные.АналитикаУчета
	|		И ИзмененныеНастройки.Организация = Данные.Организация
	|		И (ИзмененныеНастройки.МестоУчета = Данные.МестоУчета ИЛИ ИзмененныеНастройки.МестоУчета = НЕОПРЕДЕЛЕНО)";
	Если Не НастройкаСчетовУчетаСервер.НастройкиАналитикиУчетаПоРазделуУчета("Расходы").Используется Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Данные.АналитикаУчета", "ЗНАЧЕНИЕ(Справочник.ГруппыФинансовогоУчетаДоходовРасходов.ПустаяСсылка)");
	КонецЕсли;
	#КонецОбласти
	
	Если РежимОтладкиПоИсточникам Тогда
		
		ТекстыЗапроса = Новый Массив;
		ТекстыЗапроса.Добавить(СтрокаВложенногоЗапроса);
		ТекстыЗапроса.Добавить(ТекстЗапроса);
		ТекстЗапроса = СтрСоединить(ТекстыЗапроса, ОбщегоНазначения.РазделительПакетаЗапросов());
		
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "РасходыПредварительная", "(" + СтрокаВложенногоЗапроса + ")");
	КонецЕсли;
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ТекстЗапросаВТ_ПрочиеРасходыНезавершенногоПроизводства(РежимОтладкиПоИсточникам)
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	Данные.Организация,
	|	Данные.Подразделение,
	|	Данные.НаправлениеДеятельности,
	|	Данные.ГруппаПродукции КАК ГруппаПродукции,
	|	Данные.СтатьяРасходов КАК СтатьяРасходов,
	|	Данные.ПартияПроизводства КАК ПартияПроизводства,
	|	Данные.СтатьяКалькуляции КАК СтатьяКалькуляции,
	|	Данные.СтоимостьРеглОстаток КАК Сумма,
	|	Данные.СтоимостьУпрОстаток КАК СуммаУУ,
	|	Данные.ПостояннаяРазницаОстаток КАК СуммаПР,
	|	Данные.ВременнаяРазницаОстаток КАК СуммаВР
	|ПОМЕСТИТЬ ПрочиеРасходыНезавершенногоПроизводства
	|ИЗ
	|	ИзмененныеНастройкиСводно КАК ИзмененныеНастройки
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.ПрочиеРасходыНезавершенногоПроизводства.Остатки(&Период, Организация = &Организация) КАК Данные
	|	ПО ИзмененныеНастройки.ИмяРегистра = ""НезавершенноеПроизводство""
	|ГДЕ
	|	ИзмененныеНастройки.ИмяРегистра = ""НезавершенноеПроизводство""
	|ИНДЕКСИРОВАТЬ ПО
	|	ГруппаПродукции,
	|	Подразделение";
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ТекстЗапросаВТ_ТрудозатратыНезавершенногоПроизводства(РежимОтладкиПоИсточникам)
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	Данные.Организация,
	|	Данные.Подразделение,
	|	Данные.ПартияПроизводства.НаправлениеДеятельности КАК НаправлениеДеятельности,
	|	Данные.ГруппаПродукции КАК ГруппаПродукции,
	|	Данные.ВидРабот КАК ВидРабот,
	|	Данные.ПартияПроизводства КАК ПартияПроизводства,
	|	Данные.СтатьяКалькуляции КАК СтатьяКалькуляции,
	|	Данные.СтоимостьРеглОстаток КАК Сумма,
	|	Данные.СтоимостьОстаток КАК СуммаУУ,
	|	Данные.ПостояннаяРазницаОстаток КАК СуммаПР,
	|	Данные.ВременнаяРазницаОстаток КАК СуммаВР
	|ПОМЕСТИТЬ ТрудозатратыНезавершенногоПроизводства
	|ИЗ
	|	ИзмененныеНастройкиСводно КАК ИзмененныеНастройки
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.ТрудозатратыНезавершенногоПроизводства.Остатки(&Период, Организация = &Организация) КАК Данные
	|	ПО ИзмененныеНастройки.ИмяРегистра = ""НезавершенноеПроизводство""
	|ГДЕ
	|	ИзмененныеНастройки.ИмяРегистра = ""НезавершенноеПроизводство""
	|ИНДЕКСИРОВАТЬ ПО
	|	ГруппаПродукции,
	|	Подразделение";
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ТекстЗапросаВТ_Производство(РежимОтладкиПоИсточникам)
	
	ИспользуетсяАналитика = НастройкаСчетовУчетаСервер.НастройкиАналитикиУчетаПоРазделуУчета("Производство").Используется;
	
	ТекстыВложенногоЗапроса = Новый Массив;
	
	#Область ИнициализацияПроизводствоПредварительная
	ТекстЗапроса =
	"ВЫБРАТЬ ПЕРВЫЕ 0
	|	//РежимОтладки""Инициализация"" КАК ИсточникДанных,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыСчетовРеглУчета.ПустаяСсылка) КАК ВидСчета,
	|	ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка) КАК Организация,
	|	ЗНАЧЕНИЕ(Справочник.ГруппыФинансовогоУчетаДоходовРасходов.ПустаяСсылка) КАК АналитикаУчета,
	|	НЕОПРЕДЕЛЕНО КАК МестоУчета,
	|	ЗНАЧЕНИЕ(Справочник.СтруктураПредприятия.ПустаяСсылка) КАК Подразделение,
	|	ЗНАЧЕНИЕ(Справочник.НаправленияДеятельности.ПустаяСсылка) КАК НаправлениеДеятельности,
	|	ЗНАЧЕНИЕ(ПланВидовХарактеристик.СтатьиРасходов.ПустаяСсылка) КАК Субконто1,
	|	НЕОПРЕДЕЛЕНО КАК Субконто2,
	|	НЕОПРЕДЕЛЕНО КАК Субконто3,
	|	НЕОПРЕДЕЛЕНО КАК Субконто4,
	|	0 КАК Сумма,
	|	0 КАК СуммаУУ,
	|	0 КАК СуммаНУ,
	|	0 КАК СуммаПР,
	|	0 КАК СуммаВР
	|ПОМЕСТИТЬ ПроизводствоПредварительная";
	Если РежимОтладкиПоИсточникам Тогда
		ТекстыВложенногоЗапроса.Добавить(ТекстЗапроса);
	КонецЕсли;
	#КонецОбласти
	
	#Область ТаблицаСебестоимостьТоваров
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	//РежимОтладки""ТаблицаСебестоимостьТоваров"" КАК ИсточникДанных,
	|	ВЫБОР
	|		КОГДА ТаблицаОстатков.РазделУчета В (&ЗабалансовыеРазделыУчета,
	|											ЗНАЧЕНИЕ(Перечисление.РазделыУчетаСебестоимостиТоваров.ПроизводственныеЗатраты))
	|			И (ТаблицаОстатков.ЦеховаяКладовая ИЛИ ТаблицаОстатков.ТипМестаХранения = ЗНАЧЕНИЕ(Перечисление.ТипыМестХранения.Подразделение))
	|		ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыСчетовРеглУчета.МатериалыИРаботыВПодразделении)
	|		КОГДА ТаблицаОстатков.РазделУчета = ЗНАЧЕНИЕ(Перечисление.РазделыУчетаСебестоимостиТоваров.НезавершенноеПроизводство)
	|		ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыСчетовРеглУчета.НезавершенноеПроизводство)
	|		КОГДА ТаблицаОстатков.РазделУчета = ЗНАЧЕНИЕ(Перечисление.РазделыУчетаСебестоимостиТоваров.ВыпускПродукции)
	|		ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыСчетовРеглУчета.СебестоимостьВыпуска)
	|		КОГДА ТаблицаОстатков.УчетПродукцииПереработчикаНа20Счете
	|			И ТаблицаОстатков.РазделУчета = ЗНАЧЕНИЕ(Перечисление.РазделыУчетаСебестоимостиТоваров.ТоварыПереданныеПереработчику)
	|			И ТаблицаОстатков.ТипЗапасов = ЗНАЧЕНИЕ(Перечисление.ТипыЗапасов.ПродукцияПереработчика)
	|		ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыСчетовРеглУчета.МатериалыИРаботыВПодразделении)
	|		ИНАЧЕ НЕОПРЕДЕЛЕНО
	|	КОНЕЦ КАК ВидСчета,
	|	ТаблицаОстатков.Организация КАК Организация,
	|	ТаблицаОстатков.ГруппаПродукции КАК АналитикаУчета,
	|	ТаблицаОстатков.ПодразделениеАналитики КАК МестоУчета,
	|	ТаблицаОстатков.ПодразделениеАналитики КАК Подразделение,
	|	ТаблицаОстатков.НаправлениеДеятельности КАК НаправлениеДеятельности,
	|	ТаблицаОстатков.Номенклатура КАК Субконто1,
	|	ТаблицаОстатков.ГруппаПродукции КАК Субконто2,
	|	ТаблицаОстатков.Партия КАК Субконто3,
	|	ВЫБОР
	|		КОГДА ТаблицаОстатков.РазделУчета В (&ЗабалансовыеРазделыУчета,
	|											ЗНАЧЕНИЕ(Перечисление.РазделыУчетаСебестоимостиТоваров.ПроизводственныеЗатраты))
	|			И ТаблицаОстатков.ЦеховаяКладовая
	|			И ТаблицаОстатков.ТипМестаХранения = ЗНАЧЕНИЕ(Перечисление.ТипыМестХранения.Склад)
	|		ТОГДА ТаблицаОстатков.Склад//МатериалыИРаботыВПодразделении
	|		КОГДА ТаблицаОстатков.РазделУчета = ЗНАЧЕНИЕ(Перечисление.РазделыУчетаСебестоимостиТоваров.НезавершенноеПроизводство)
	|		ТОГДА ТаблицаОстатков.СтатьяКалькуляции//НезавершенноеПроизводство
	|		ИНАЧЕ НЕОПРЕДЕЛЕНО
	|	КОНЕЦ КАК Субконто4,
	|	ТаблицаОстатков.СуммаБалансоваяРегл КАК Сумма,
	|	ТаблицаОстатков.СуммаБалансоваяУпр КАК СуммаУУ,
	|	ТаблицаОстатков.СуммаБалансоваяРегл - ТаблицаОстатков.СуммаПР - ТаблицаОстатков.СуммаВР КАК СуммаНУ,
	|	ТаблицаОстатков.СуммаПР КАК СуммаПР,
	|	ТаблицаОстатков.СуммаВР КАК СуммаВР
	|ИЗ
	|	ТаблицаСебестоимостьТоваров КАК ТаблицаОстатков
	|
	|ГДЕ
	|	ТаблицаОстатков.ПроизводственныеЗатраты
	|	И ТаблицаОстатков.СуммаБалансоваяРегл + ТаблицаОстатков.СуммаБалансоваяУпр + ТаблицаОстатков.Количество
	|	+ ТаблицаОстатков.СуммаПР + ТаблицаОстатков.СуммаВР <> 0";
	ТекстыВложенногоЗапроса.Добавить(ТекстЗапроса);
	#КонецОбласти
	
	#Область ТаблицаСебестоимостьТоваровРезервы
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	//РежимОтладки""ТаблицаСебестоимостьТоваровРезервы"" КАК ИсточникДанных,
	|	ВЫБОР
	|		КОГДА ТаблицаОстатков.РазделУчета = ЗНАЧЕНИЕ(Перечисление.РазделыУчетаСебестоимостиТоваров.НезавершенноеПроизводство)
	|		ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыСчетовРеглУчета.РезервыПодОбесценениеНезавершенногоПроизводства)
	|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ВидыСчетовРеглУчета.РезервыПодОбесценениеМатериаловВПодразделении)
	|	КОНЕЦ КАК ВидСчета,
	|	ТаблицаОстатков.Организация КАК Организация,
