Функция ТекстЗапроса_РезервыПоСомнительнымДолгам()
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	//РежимОтладки""РезервыПоСомнительнымДолгам"" КАК ИсточникДанных,
	|	ИзмененныеНастройки.ВидСчета КАК ВидСчета,
