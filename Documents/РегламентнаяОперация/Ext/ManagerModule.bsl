// Список операций, которые отражаются в регламентированном учете через стандартный механизм отражения.
// 
// Возвращаемое значение:
//  Массив - Операции к отражению в регл. учете
Функция ОперацииКОтражениюВРеглУчете() Экспорт
	
	ОперацииКОтражениюВРеглУчете = Новый Массив;
	ОперацииКОтражениюВРеглУчете.Добавить(Перечисления.ТипыРегламентныхОпераций.РасчетНалогаНаИмущество);
	ОперацииКОтражениюВРеглУчете.Добавить(Перечисления.ТипыРегламентныхОпераций.РасчетЗемельногоНалога);
	ОперацииКОтражениюВРеглУчете.Добавить(Перечисления.ТипыРегламентныхОпераций.РасчетТранспортногоНалога);
	ОперацииКОтражениюВРеглУчете.Добавить(Перечисления.ТипыРегламентныхОпераций.РасчетТорговогоСбора);
	ОперацииКОтражениюВРеглУчете.Добавить(Перечисления.ТипыРегламентныхОпераций.ПризнаниеВНУАрендныхПлатежей);
	ОперацииКОтражениюВРеглУчете.Добавить(Перечисления.ТипыРегламентныхОпераций.РасчетЕНС);
	ОперацииКОтражениюВРеглУчете.Добавить(Перечисления.ТипыРегламентныхОпераций.РеклассификацияДолгосрочныхАктивовОбязательств);
	ОперацииКОтражениюВРеглУчете.Добавить(Перечисления.ТипыРегламентныхОпераций.КорректировкаНалоговойБазыПоКурсовымРазницам);
	
	Возврат ОперацииКОтражениюВРеглУчете;
	
КонецФункции

// Список операций этапа формирования финансового результата.
// 
// Возвращаемое значение:
//  Массив - ПеречислениеСсылка.ТипыРегламентныхОпераций - типы операций
Функция ТипыОперацийФинРеза() Экспорт
	
	ТипыОперацийФинРеза = Новый Массив;
	ТипыОперацийФинРеза.Добавить(Перечисления.ТипыРегламентныхОпераций.КорректировкаНалоговойБазыПоКурсовымРазницам);
	ТипыОперацийФинРеза.Добавить(Перечисления.ТипыРегламентныхОпераций.РасчетДолейСписанияКосвенныхРасходов);
	ТипыОперацийФинРеза.Добавить(Перечисления.ТипыРегламентныхОпераций.СписаниеКосвенныхРасходов);
	ТипыОперацийФинРеза.Добавить(Перечисления.ТипыРегламентныхОпераций.ФормированиеФинансовогоРезультата);
	ТипыОперацийФинРеза.Добавить(Перечисления.ТипыРегламентныхОпераций.СписаниеУбытковПрошлыхЛет);
	ТипыОперацийФинРеза.Добавить(Перечисления.ТипыРегламентныхОпераций.РасчетНалогаНаПрибыль);
	ТипыОперацийФинРеза.Добавить(Перечисления.ТипыРегламентныхОпераций.РасчетОтложенногоНалога);
	ТипыОперацийФинРеза.Добавить(Перечисления.ТипыРегламентныхОпераций.ПереоценкаСуммыВВалютеФинОтчетности);
	ТипыОперацийФинРеза.Добавить(Перечисления.ТипыРегламентныхОпераций.ЗакрытиеГода);
	
	Возврат ТипыОперацийФинРеза;
	
КонецФункции

#Область ПереносСальдо

// Процедура выполняет перенос сальдо на счетах учета, после изменения их настроек.
//	Параметры:
//		Параметры - Структура - содержит следующие свойства:
//			МассивОрганизаций - Массив - из СправочникСсылка.Организации - организации для переноса
//			Период - Дата - период в котором изменились настройки счетов учета.
//		АдресХранилища - Строка - адрес результата процедуры
//
Процедура ПереносСальдоПриИзмененииНастроекСчетовРеглУчета(Параметры, АдресХранилища = "") Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	КлючеваяОперация = "РегламентнаяОперация.ПереносСальдоПриИзмененииНастроекСчетовРеглУчета";
	ОписаниеЗамера = ОценкаПроизводительности.НачатьЗамерДлительнойОперации(КлючеваяОперация);
	КоличествоОбработанныхДанных = 0;
	
	ПараметрыРасчета = ЗакрытиеМесяцаСервер.ИнициализироватьСвойстваРаботыСЗаданиями(Истина);
	ПараметрыРасчета.Операция = Справочники.ОперацииЗакрытияМесяца.ПереносСальдоПриИзмененииНастроекСчетовРеглУчета;
	ПараметрыРасчета.Организации = Параметры.МассивОрганизаций;
	ПараметрыРасчета.НачалоПериода = Параметры.Период;
	ПараметрыРасчета.КонецПериода = КонецМесяца(Параметры.Период);
	ТипыВыполняемыхОпераций = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Перечисления.ТипыРегламентныхОпераций.ПереносСальдоПриИзмененииНастроекСчетовРеглУчета);
	
	ВходящиеДанные = Новый Соответствие;
	
	ВходящиеДанные.Вставить(Метаданные.РегистрыБухгалтерии.Хозрасчетный);
	ВходящиеДанные.Вставить(Метаданные.РегистрыСведений.ПорядокОтраженияНаСчетахУчета);
	
	ЗакрытиеМесяцаСервер.ПроверитьБлокировкуВходящихДанныхПриОбновленииИБ(ВходящиеДанные, НСтр("ru = 'Перенос сальдо при изменении настроек счетов учета.';
																								|en = 'Transfer balance when changing ledger account settings'"));
	
	ДанныеКРасчету = ЗакрытиеМесяцаСервер.ДанныеКРасчету(ПараметрыРасчета);
	
	Если ПараметрыРасчета.Отказ Тогда
		ОценкаПроизводительности.ЗакончитьЗамерДлительнойОперации(ОписаниеЗамера, 0);
		Возврат;
	КонецЕсли;
	
	РассчитатьРегламентныеОперации(Параметры.Период, ТипыВыполняемыхОпераций, Параметры.МассивОрганизаций, ПараметрыРасчета.Отказ);
	
	ЗакрытиеМесяцаСервер.ЗафиксироватьРасчетТранзакция(ПараметрыРасчета, ДанныеКРасчету);
	
	ОценкаПроизводительности.ЗакончитьЗамерДлительнойОперации(ОписаниеЗамера, КоличествоОбработанныхДанных);
	
КонецПроцедуры

Процедура ПереносСальдо_ДополнитьПараметрамиПоУмолчанию(Параметры) Экспорт
	
	СтруктураПараметровЗапроса = РеглУчетВыборкиСерверПовтИсп.ПараметрыОтраженияРеглУчетаПоУмолчанию();
	СтруктураПараметровЗапроса.Вставить("ФормироватьВидыЗапасовПоГруппамФинансовогоУчета", ПолучитьФункциональнуюОпцию("ФормироватьВидыЗапасовПоГруппамФинансовогоУчета"));
	СтруктураПараметровЗапроса.Вставить("ПартионныйУчетВерсии22", ПолучитьФункциональнуюОпцию("ПартионныйУчетВерсии22"));
	СтруктураПараметровЗапроса.Вставить("АналитическийУчетПоГруппамПродукции", ПолучитьФункциональнуюОпцию("АналитическийУчетПоГруппамПродукции"));
	СтруктураПараметровЗапроса.Вставить("УточнениеПериода", РеглУчетКлиентСервер.ОсновноеЗначениеУточненияМежотчетногоПериода());
	
	СчетаТоваровИМатериаловПоПартиямПриобретения = Новый Массив;
	СчетаТоваровИМатериаловПоПартиямПриобретения.Добавить(ПланыСчетов.Хозрасчетный.Материалы);
	СчетаТоваровИМатериаловПоПартиямПриобретения.Добавить(ПланыСчетов.Хозрасчетный.СырьеИМатериалы);
	СчетаТоваровИМатериаловПоПартиямПриобретения.Добавить(ПланыСчетов.Хозрасчетный.ПокупныеПолуфабрикатыИКомплектующие);
	СчетаТоваровИМатериаловПоПартиямПриобретения.Добавить(ПланыСчетов.Хозрасчетный.Топливо);
	СчетаТоваровИМатериаловПоПартиямПриобретения.Добавить(ПланыСчетов.Хозрасчетный.Тара);
	СчетаТоваровИМатериаловПоПартиямПриобретения.Добавить(ПланыСчетов.Хозрасчетный.ЗапасныеЧасти);
	СчетаТоваровИМатериаловПоПартиямПриобретения.Добавить(ПланыСчетов.Хозрасчетный.ПрочиеМатериалы);
	СчетаТоваровИМатериаловПоПартиямПриобретения.Добавить(ПланыСчетов.Хозрасчетный.МатериалыПереданныеВПереработку);
	СчетаТоваровИМатериаловПоПартиямПриобретения.Добавить(ПланыСчетов.Хозрасчетный.СтроительныеМатериалы);
	СчетаТоваровИМатериаловПоПартиямПриобретения.Добавить(ПланыСчетов.Хозрасчетный.ИнвентарьИХозяйственныеПринадлежности);
	СчетаТоваровИМатериаловПоПартиямПриобретения.Добавить(ПланыСчетов.Хозрасчетный.СпецоснасткаИСпецодеждаНаСкладе);
	СчетаТоваровИМатериаловПоПартиямПриобретения.Добавить(ПланыСчетов.Хозрасчетный.ТоварыНаСкладах);
	СчетаТоваровИМатериаловПоПартиямПриобретения.Добавить(ПланыСчетов.Хозрасчетный.ТараПодТоваромИПорожняя);
	СчетаТоваровИМатериаловПоПартиямПриобретения.Добавить(ПланыСчетов.Хозрасчетный.ПокупныеИзделия);
	СчетаТоваровИМатериаловПоПартиямПриобретения.Добавить(ПланыСчетов.Хозрасчетный.ПокупныеТоварыОтгруженные);
	СчетаТоваровИМатериаловПоПартиямПриобретения.Добавить(ПланыСчетов.Хозрасчетный.ПрочиеТоварыОтгруженные);
	СтруктураПараметровЗапроса.Вставить("СчетаСПартиямиПриобретения", СчетаТоваровИМатериаловПоПартиямПриобретения);
	
	СчетаПродукцииИПолуфабрикатовПоПартиямВыпуска = Новый Массив;
	СчетаПродукцииИПолуфабрикатовПоПартиямВыпуска.Добавить(ПланыСчетов.Хозрасчетный.Полуфабрикаты);
	СчетаПродукцииИПолуфабрикатовПоПартиямВыпуска.Добавить(ПланыСчетов.Хозрасчетный.ГотоваяПродукция);
	СчетаПродукцииИПолуфабрикатовПоПартиямВыпуска.Добавить(ПланыСчетов.Хозрасчетный.ГотоваяПродукцияОтгруженная);
	СтруктураПараметровЗапроса.Вставить("СчетаСПартиямиВыпуска", СчетаПродукцииИПолуфабрикатовПоПартиямВыпуска);
	
	ВидыСчетовСОбогащениемПартиями = Новый Массив;
	ВидыСчетовСОбогащениемПартиями.Добавить(Перечисления.ВидыСчетовРеглУчета.НаСкладе);
	ВидыСчетовСОбогащениемПартиями.Добавить(Перечисления.ВидыСчетовРеглУчета.РеализацияБезПереходаПраваСобственности);
	ВидыСчетовСОбогащениемПартиями.Добавить(Перечисления.ВидыСчетовРеглУчета.ПередачаВПереработку);
	ВидыСчетовСОбогащениемПартиями.Добавить(Перечисления.ВидыСчетовРеглУчета.НоменклатураПереданная);
	СтруктураПараметровЗапроса.Вставить("ВидыСчетовСОбогащениемПартиями", ВидыСчетовСОбогащениемПартиями);
	
	ОбщегоНазначенияКлиентСервер.ДополнитьСтруктуру(Параметры, СтруктураПараметровЗапроса);
	
КонецПроцедуры

Функция ТекстЗапросаВременныхТаблицПереносаСальдо(РежимОтладкиПоИсточникам = Ложь) Экспорт
	
	ЗапросыВременныхТаблиц = Новый Массив;
	
	ЗапросыВременныхТаблиц.Добавить(РеглУчетВыборкиСерверПовтИсп.ТекстЗапросаПланаСчетов());
	ЗапросыВременныхТаблиц.Добавить(ТекстЗапросаВТ_ИзмененныеНастройки(РежимОтладкиПоИсточникам));
	ЗапросыВременныхТаблиц.Добавить(ТекстЗапросаВТ_ИзмененныеНастройкиСводно());
	ЗапросыВременныхТаблиц.Добавить(ТекстЗапросаВТ_ПорядокОтраженияНовый(РежимОтладкиПоИсточникам));
	ЗапросыВременныхТаблиц.Добавить(ТекстЗапросаВТ_ПорядокОтраженияСтарый(РежимОтладкиПоИсточникам));
	
	ЗапросыВременныхТаблиц.Добавить(ТекстЗапросаВТ_УчетнаяПолитикаОрганизаций());
	ЗапросыВременныхТаблиц.Добавить(ТекстЗапросаВТ_КурсыВалют());
	
	ЗапросыВременныхТаблиц.Добавить(ТекстЗапросаВТ_ТаблицаСебестоимостьТоваров(РежимОтладкиПоИсточникам));
	ЗапросыВременныхТаблиц.Добавить(ТекстЗапросаВТ_Номенклатура(РежимОтладкиПоИсточникам));
	Если РежимОтладкиПоИсточникам Тогда
		ЗапросыВременныхТаблиц.Добавить(ТекстЗапросаВТ_РасчетыСПартнерами(РежимОтладкиПоИсточникам));
		ЗапросыВременныхТаблиц.Добавить(ТекстЗапросаВТ_ДенежныеСредства(РежимОтладкиПоИсточникам));
		ЗапросыВременныхТаблиц.Добавить(ТекстЗапросаВТ_ВнеоборотныеАктивы(РежимОтладкиПоИсточникам));
	КонецЕсли;
	ЗапросыВременныхТаблиц.Добавить(ТекстЗапросаВТ_РасчетыСКомитентамиПоПродаже(РежимОтладкиПоИсточникам));
	ЗапросыВременныхТаблиц.Добавить(ТекстЗапросаВТ_ТаблицаРасчетыПоФинансовымИнструментам(РежимОтладкиПоИсточникам));
	ЗапросыВременныхТаблиц.Добавить(ТекстЗапросаВТ_ТаблицаДолгосрочныеСуммыГрафиков(РежимОтладкиПоИсточникам));
	ЗапросыВременныхТаблиц.Добавить(ТекстЗапросаВТ_ТаблицаРасчетыПоФинансовымИнструментамДолгосрок(РежимОтладкиПоИсточникам));
	ЗапросыВременныхТаблиц.Добавить(ТекстЗапросаВТ_ПрочиеРасходыНезавершенногоПроизводства(РежимОтладкиПоИсточникам));
	ЗапросыВременныхТаблиц.Добавить(ТекстЗапросаВТ_ТрудозатратыНезавершенногоПроизводства(РежимОтладкиПоИсточникам));
	ЗапросыВременныхТаблиц.Добавить(ТекстЗапросаВТ_Производство(РежимОтладкиПоИсточникам));
	ЗапросыВременныхТаблиц.Добавить(ТекстЗапросаВТ_ПрочиеРасходыОстатки(РежимОтладкиПоИсточникам));
	ЗапросыВременныхТаблиц.Добавить(ТекстЗапросаВТ_Расходы(РежимОтладкиПоИсточникам));
	ЗапросыВременныхТаблиц.Добавить(ТекстЗапросаВТ_ПроцентныеРасходыДисконтированияДолгосрок());
	ЗапросыВременныхТаблиц.Добавить(ТекстЗапросаВТ_ПроцентныеРасходыДисконтирования(РежимОтладкиПоИсточникам));
	
	ЗапросыВременныхТаблиц.Добавить(ТекстЗапросаВТ_Данные(РежимОтладкиПоИсточникам));//Все таблицы, ПланХозрасчетный
	ЗапросыВременныхТаблиц.Добавить(ТекстЗапросаВТ_ДанныеОпределениеДтКт(РежимОтладкиПоИсточникам));//Данные,ПланХозрасчетный
	ЗапросыВременныхТаблиц.Добавить(ТекстЗапросаВТ_ДанныеОпределениеСубконтоДтКт(РежимОтладкиПоИсточникам));//ДанныеСчетаДтКт,ПланХозрасчетный,ВидыСубконто
	
	ТекстЗапроса = СтрСоединить(ЗапросыВременныхТаблиц, ОбщегоНазначения.РазделительПакетаЗапросов());
	
	Если РежимОтладкиПоИсточникам Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "//РежимОтладки", "");
	КонецЕсли;
	
	Возврат ТекстЗапроса;
	
КонецФункции

