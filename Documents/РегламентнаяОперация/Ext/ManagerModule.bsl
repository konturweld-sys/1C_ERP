	#Область ТаблицаРасчетыПоФинансовымИнструментамДолгосрок
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	Данные.ВидСчета КАК ВидСчета,
	|	Данные.Организация КАК Организация,
	|	Данные.АналитикаУчета КАК АналитикаУчета,
	|	Данные.Долгосрочный КАК Долгосрочный,
