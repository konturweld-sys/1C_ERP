// Таблица проводок новый.
// 
// Возвращаемое значение:
//  ТаблицаЗначений - Таблица проводок новый:
// * СчетДт - ПланСчетовСсылка.Хозрасчетный
// * СчетКт - ПланСчетовСсылка.Хозрасчетный
// * УровеньБюджета - ПеречислениеСсылка.УровниБюджетов 
// * РегистрацияВНалоговомОргане - СправочникСсылка.РегистрацииВНалоговомОргане 
// * НаборКорректировок - СправочникСсылка.КорректировкиПрошлыхПериодовНУ 
// * ПериодРасчета - Дата
// * Сумма - Число - Сумма проводки (сумма налога за минусом суммы предыдущих авансовых платежей)
// * СуммаВР - Число
// * Организация - СправочникСсылка.Организации
// * ПрименяетсяПБУ18 - Булево
// * ВариантНалогообложенияПрибыли - СправочникСсылка.ВариантыНалогообложенияПрибыли
// * ВидПлатежейВГосБюджет - ПеречислениеСсылка.ВидыПлатежейВГосБюджет 
// * УбыткиПрошлыхЛет - СправочникСсылка.УбыткиПрошлыхЛет
// * СтавкаНалога - Число - Ставка налога на прибыль в разрезе Уровня бюджета 
// * СуммаНалогаПрошлыхМесяцев - Число
// * СуммаНалога - Число - Сумма налога на прибыль нарастающим итогом за год
// * НалоговаяБаза - Число - Налоговая база по налогу на прибыль нарастающим итогом за год
Функция ТаблицаПроводокНовый() Экспорт
	
	ТаблицаПроводок = Новый ТаблицаЗначений();
	ТаблицаПроводок.Колонки.Добавить("НаборКорректировок", Новый ОписаниеТипов("СправочникСсылка.КорректировкиПрошлыхПериодовНУ"));
	ТаблицаПроводок.Колонки.Добавить("ПериодРасчета", Новый ОписаниеТипов("Дата"));
	ТаблицаПроводок.Колонки.Добавить("Организация", Новый ОписаниеТипов("СправочникСсылка.Организации"));
	ТаблицаПроводок.Колонки.Добавить("Подразделение", Новый ОписаниеТипов("СправочникСсылка.СтруктураПредприятия"));
	ТаблицаПроводок.Колонки.Добавить("НаправлениеДеятельности", Новый ОписаниеТипов("СправочникСсылка.НаправленияДеятельности"));
	ТаблицаПроводок.Колонки.Добавить("СчетДт", Новый ОписаниеТипов("ПланСчетовСсылка.Хозрасчетный"));
	ТаблицаПроводок.Колонки.Добавить("СчетКт", Новый ОписаниеТипов("ПланСчетовСсылка.Хозрасчетный"));
	ТаблицаПроводок.Колонки.Добавить("СтатьяРасходов", Новый ОписаниеТипов("ПланВидовХарактеристикСсылка.СтатьиРасходов"));
	ТаблицаПроводок.Колонки.Добавить("УровеньБюджета", Новый ОписаниеТипов("ПеречислениеСсылка.УровниБюджетов"));
	ТаблицаПроводок.Колонки.Добавить("РегистрацияВНалоговомОргане", Новый ОписаниеТипов("СправочникСсылка.РегистрацииВНалоговомОргане"));
	ТаблицаПроводок.Колонки.Добавить("ВариантНалогообложенияПрибыли", Новый ОписаниеТипов("СправочникСсылка.ВариантыНалогообложенияПрибыли"));
	ТаблицаПроводок.Колонки.Добавить("ВидПлатежейВГосБюджет", Новый ОписаниеТипов("ПеречислениеСсылка.ВидыПлатежейВГосБюджет"));
	ТаблицаПроводок.Колонки.Добавить("УбыткиПрошлыхЛет", Новый ОписаниеТипов("СправочникСсылка.УбыткиПрошлыхЛет"));
	ТаблицаПроводок.Колонки.Добавить("ПрименяетсяПБУ18", Новый ОписаниеТипов("Булево"));
	ТаблицаПроводок.Колонки.Добавить("Сумма", Новый ОписаниеТипов("Число"));
	ТаблицаПроводок.Колонки.Добавить("СуммаВР", Новый ОписаниеТипов("Число"));
	ТаблицаПроводок.Колонки.Добавить("СуммаНалогаПрошлыхМесяцев", Новый ОписаниеТипов("Число"));
	ТаблицаПроводок.Колонки.Добавить("СуммаНалога", Новый ОписаниеТипов("Число"));
	ТаблицаПроводок.Колонки.Добавить("НалоговаяБаза", Новый ОписаниеТипов("Число"));
	ТаблицаПроводок.Колонки.Добавить("СтавкаНалога", Новый ОписаниеТипов("Число"));
	
	Возврат ТаблицаПроводок;

КонецФункции

