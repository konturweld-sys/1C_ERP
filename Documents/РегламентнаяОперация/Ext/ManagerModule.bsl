#КонецОбласти

#Область БлокировкаПриОбновленииИБ

Процедура ПроверитьБлокировкуВходящихДанныхПриОбновленииИБ(ПредставлениеОперации, ТипОперации) Экспорт
	
	ВходящиеДанные = Новый Соответствие;
	
	ВходящиеДанные.Вставить(Метаданные.Документы.РегламентнаяОперация);
	ВходящиеДанные.Вставить(Метаданные.РегистрыБухгалтерии.Хозрасчетный);
	
	Если ТипОперации = Перечисления.ТипыРегламентныхОпераций.РасчетДолейСписанияКосвенныхРасходов Тогда
		
		ВходящиеДанные.Вставить(Метаданные.РегистрыНакопления.ВыручкаИСебестоимостьПродаж);
		ВходящиеДанные.Вставить(Метаданные.РегистрыНакопления.ДвиженияКонтрагентДоходыРасходы);
		ВходящиеДанные.Вставить(Метаданные.РегистрыНакопления.ПрочиеРасходы);
		ВходящиеДанные.Вставить(Метаданные.РегистрыНакопления.СебестоимостьТоваров);
		ВходящиеДанные.Вставить(Метаданные.РегистрыНакопления.ТрудозатратыНезавершенногоПроизводства);
		ВходящиеДанные.Вставить(Метаданные.РегистрыСведений.АналитикаУчетаНоменклатуры);
		ВходящиеДанные.Вставить(Метаданные.РегистрыСведений.АналитикаУчетаПоПартнерам);
		ВходящиеДанные.Вставить(Метаданные.РегистрыСведений.ДолиСписанияКосвенныхРасходов);
		ВходящиеДанные.Вставить(Метаданные.РегистрыСведений.ПорядокОтраженияНаСчетахУчета);
		
	ИначеЕсли ТипОперации = Перечисления.ТипыРегламентныхОпераций.РасчетНалогаНаИмущество
	 ИЛИ ТипОперации = Перечисления.ТипыРегламентныхОпераций.РасчетТранспортногоНалога
	 ИЛИ ТипОперации = Перечисления.ТипыРегламентныхОпераций.РасчетЗемельногоНалога Тогда
		
		ВходящиеДанные.Вставить(Метаданные.Документы.ИзменениеПараметровОС);
		ВходящиеДанные.Вставить(Метаданные.РегистрыСведений.МестонахождениеОС);
		ВходящиеДанные.Вставить(Метаданные.РегистрыСведений.ПервоначальныеСведенияОС);
		ВходящиеДанные.Вставить(Метаданные.РегистрыСведений.ПорядокУплатыНалоговНаМестах);
		ВходящиеДанные.Вставить(Метаданные.РегистрыСведений.ПорядокУчетаОС);
		ВходящиеДанные.Вставить(Метаданные.РегистрыСведений.ПорядокУчетаОСБУ);
		ВходящиеДанные.Вставить(Метаданные.РегистрыСведений.ПараметрыНачисленияЗемельногоНалога);
		ВходящиеДанные.Вставить(Метаданные.РегистрыСведений.ПараметрыНачисленияТранспортногоНалога);
		ВходящиеДанные.Вставить(Метаданные.РегистрыСведений.СпособыОтраженияРасходовПоИмущественнымНалогам);
		ВходящиеДанные.Вставить(Метаданные.РегистрыСведений.СтавкиНалогаНаИмущество);
		ВходящиеДанные.Вставить(Метаданные.РегистрыСведений.ПараметрыНачисленияНалогаНаИмущество);
		
	ИначеЕсли ТипОперации = Перечисления.ТипыРегламентныхОпераций.РасчетКурсовыхРазниц Тогда
		
		ВходящиеДанные.Вставить(Метаданные.РегистрыСведений.ОтносительныеКурсыВалют);
		
	ИначеЕсли ТипОперации = Перечисления.ТипыРегламентныхОпераций.ФормированиеФинансовогоРезультата Тогда
		
		ВходящиеДанные.Вставить(Метаданные.Документы.СчетФактураНалоговыйАгент);
		
	ИначеЕсли ТипОперации = Перечисления.ТипыРегламентныхОпераций.РасчетНалогаНаПрибыль
		ИЛИ ТипОперации = Перечисления.ТипыРегламентныхОпераций.РасчетОтложенногоНалога Тогда
		
		ВходящиеДанные.Вставить(Метаданные.РегистрыСведений.ПервоначальныеСведенияОС);
		ВходящиеДанные.Вставить(Метаданные.РегистрыСведений.РасчетДолейБазыНалогаНаПрибыль);
		ВходящиеДанные.Вставить(Метаданные.РегистрыСведений.РасчетСтавкиНалогаНаПрибыльЗаМесяц);
		ВходящиеДанные.Вставить(Метаданные.РегистрыСведений.РегистрацииВНалоговомОргане);
		ВходящиеДанные.Вставить(Метаданные.РегистрыСведений.СтавкиНалогаНаПрибыльВБюджетСубъектовРФ);
		
	ИначеЕсли ТипОперации = Перечисления.ТипыРегламентныхОпераций.ЗакрытиеГода Тогда
		
		ВходящиеДанные.Вставить(Метаданные.РегистрыНакопления.ПрочиеРасходы);
		ВходящиеДанные.Вставить(Метаданные.РегистрыСведений.ДолиСписанияКосвенныхРасходов);
		
	КонецЕсли;
	
	ЗакрытиеМесяцаСервер.ПроверитьБлокировкуВходящихДанныхПриОбновленииИБ(ВходящиеДанные, ПредставлениеОперации);
	
КонецПроцедуры

#КонецОбласти

// Заполнение таблицы проводок по убыткам.
// 
// Параметры:
//  КонтекстРасчета - см. РасчетНалогаНаПрибыль.НовыйКонтекстРасчета
//  ТаблицаУбытков  - см. ЗакрытиеМесяца.ПодготовитьТаблицуУбытков
//  ТаблицаПроводок - см. ТаблицаПроводокНовый
Процедура ЗаполнениеТаблицыПроводокПоУбыткам(КонтекстРасчета, ТаблицаУбытков, ТаблицаПроводок) Экспорт
	
	Для каждого УбытокПрошлогоПериода Из ТаблицаУбытков Цикл
		
		Проводка = ТаблицаПроводок.Добавить();
		Проводка.ПериодРасчета                        = КонтекстРасчета.КонецПериода;
		Проводка.Организация                   = КонтекстРасчета.Организация;
		Проводка.СчетДт                        = ПланыСчетов.Хозрасчетный.ПрибылиИУбыткиНеЕНВД;
		Проводка.СчетКт                        = УбытокПрошлогоПериода.Счет;
		Проводка.УбыткиПрошлыхЛет              = УбытокПрошлогоПериода.РБП;
		Проводка.ВариантНалогообложенияПрибыли = УбытокПрошлогоПериода.ВариантНалогообложенияПрибыли;
		Проводка.Сумма                         = УбытокПрошлогоПериода.СуммаНУ;
		Проводка.ПрименяетсяПБУ18              = КонтекстРасчета.ПрименяетсяПБУ18;
		
	КонецЦикла;

КонецПроцедуры

// Заполнение таблицы проводок по списанию нормируемых расходов.
// 
// Параметры:
//  КонтекстРасчета - см. РасчетНалогаНаПрибыль.НовыйКонтекстРасчета
//  НормируемыеРасходы  - см. НалоговыйУчет.ПолучитьРасчетСписанияКосвенныхРасходов
//  ТаблицаПроводок - см. ТаблицаПроводокНовый
Процедура ЗаполнениеТаблицыПроводокПоНормируемымРасходам(КонтекстРасчета, НормируемыеРасходы, ТаблицаПроводок) Экспорт
	
	Для каждого НормируемыйРасход Из НормируемыеРасходы Цикл
		
		Проводка = ТаблицаПроводок.Добавить();
		Проводка.ПериодРасчета = КонтекстРасчета.КонецПериода;
		ЗаполнитьЗначенияСвойств(Проводка, НормируемыйРасход);
		Проводка.Сумма = НормируемыйРасход.СуммаНУ;
		Проводка.НаборКорректировок = КонтекстРасчета.НаборКорректировок;
		
	КонецЦикла;

КонецПроцедуры

// Сформировать движения перерасчет налога.
// 
// Параметры:
//  СтруктураШапкиДокумента - см. РасчетНалогаНаПрибыль.НовыйКонтекстРасчета
//  ТаблицаПроводок - см. ТаблицаПроводокНовый
//  ПараметрыПроведения см. ПодготовитьДанныеРасчетаНалогаНаПрибыль
//  Движения - Движения документа
//  НачалоПересчета - Дата -Начало пересчета налога по данной Карточке
//  Отказ - Булево
Процедура СформироватьДвиженияПерерасчетНалога(СтруктураШапкиДокумента, ТаблицаПроводок, ПараметрыПроведения, Движения, НачалоПересчета, Отказ) Экспорт
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("ТаблицаПроводок",        ТаблицаПроводок);
	Запрос.УстановитьПараметр("ДатаЗакрытияНабора",     СтруктураШапкиДокумента.ДатаЗакрытияНабора);
	Запрос.УстановитьПараметр("НачалоГода",             НачалоГода(СтруктураШапкиДокумента.ДатаЗакрытияНабора));
	Запрос.УстановитьПараметр("НаборКорректировок",     СтруктураШапкиДокумента.НаборКорректировок);
	Запрос.УстановитьПараметр("Организация",            СтруктураШапкиДокумента.Организация);
	Запрос.УстановитьПараметр("НачалоПересчета",        НачалоПересчета);
		
	//@skip-check bsl-ql-hub
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТаблицаПроводок.СчетДт КАК СчетДт,
	|	ТаблицаПроводок.СчетКт КАК СчетКт,
	|	ТаблицаПроводок.ПериодРасчета КАК Период,
	|	ТаблицаПроводок.Организация КАК Организация,
	|	ТаблицаПроводок.Подразделение КАК Подразделение,
	|	ТаблицаПроводок.НаправлениеДеятельности КАК НаправлениеДеятельности,
	|	ТаблицаПроводок.СтатьяРасходов КАК СтатьяРасходов,
	|	ТаблицаПроводок.УбыткиПрошлыхЛет КАК УбыткиПрошлыхЛет,
	|	ТаблицаПроводок.УровеньБюджета КАК УровеньБюджета,
	|	ТаблицаПроводок.РегистрацияВНалоговомОргане КАК РегистрацияВНалоговомОргане,
	|	ТаблицаПроводок.ВидПлатежейВГосБюджет КАК ВидПлатежейВГосБюджет,
	|	ТаблицаПроводок.ВариантНалогообложенияПрибыли КАК ВариантНалогообложенияПрибыли,
	|	ТаблицаПроводок.ПрименяетсяПБУ18 КАК ПрименяетсяПБУ18,
	|	ТаблицаПроводок.НалоговаяБаза КАК НалоговаяБаза,
	|	ТаблицаПроводок.СуммаНалогаПрошлыхМесяцев КАК СуммаНалогаПрошлыхМесяцев,
	|	ТаблицаПроводок.СтавкаНалога КАК СтавкаНалога,
	|	ТаблицаПроводок.СуммаНалога КАК СуммаНалога,
	|	ТаблицаПроводок.Сумма КАК Сумма
	|ПОМЕСТИТЬ ДанныеПроводок
	|ИЗ
	|	&ТаблицаПроводок КАК ТаблицаПроводок
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Период,
	|	СчетДт,
	|	СчетКт
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|
	|ВЫБРАТЬ
	|	ГОД(ТаблицаПроводок.Период) КАК ПериодГод,
	|	ТаблицаПроводок.РегистрацияВНалоговомОргане КАК РегистрацияВНалоговомОргане,
	|	ТаблицаПроводок.ВариантНалогообложенияПрибыли КАК ВариантНалогообложенияПрибыли,
	|	МАКСИМУМ(ТаблицаПроводок.Период) КАК Период
	|ПОМЕСТИТЬ ТаблицаПериодов
	|ИЗ
	|	ДанныеПроводок КАК ТаблицаПроводок
	|ГДЕ
	|	ТаблицаПроводок.СчетКт В ИЕРАРХИИ (Значение(ПланСчетов.Хозрасчетный.РасчетыСБюджетом))
	|
	|СГРУППИРОВАТЬ ПО
	|	ГОД(ТаблицаПроводок.Период),
	|	ТаблицаПроводок.РегистрацияВНалоговомОргане,
	|	ТаблицаПроводок.ВариантНалогообложенияПрибыли
	|	
	|ИНДЕКСИРОВАТЬ ПО
	|	Период,
	|	РегистрацияВНалоговомОргане,
	|	ВариантНалогообложенияПрибыли
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|
	|ВЫБРАТЬ
	|	РасчетНалогаНаПрибыль.ПериодРасчета КАК ПериодРасчета,
	|	РасчетНалогаНаПрибыль.ВариантНалогообложенияПрибыли КАК ВариантНалогообложенияПрибыли,
	|	РасчетНалогаНаПрибыль.РегистрацияВНалоговомОргане КАК РегистрацияВНалоговомОргане,
	|	МАКСИМУМ(ЕСТЬNULL(НаборыКорректировок.ДатаНачалаПодготовкиДекларации, ДАТАВРЕМЯ(1, 1, 1))) КАК ДатаНачалаПодготовкиДекларации
	|ПОМЕСТИТЬ ПромежуточнаяТаблица
	|	ИЗ
	|		РегистрСведений.РасчетНалогаНаПрибыль КАК РасчетНалогаНаПрибыль
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КорректировкиПрошлыхПериодовНУ КАК НаборыКорректировок
	|		ПО РасчетНалогаНаПрибыль.НаборКорректировок = НаборыКорректировок.Ссылка
	|			И (НаборыКорректировок.СборКорректировокЗакрыт)
	|			И (НаборыКорректировок.ДатаНачалаПодготовкиДекларации < &ДатаЗакрытияНабора)
	|	ГДЕ
	|		РасчетНалогаНаПрибыль.ПериодРасчета МЕЖДУ &НачалоПересчета И &ДатаЗакрытияНабора
	|		И РасчетНалогаНаПрибыль.Организация = &Организация
	|		И (НЕ НаборыКорректировок.Ссылка ЕСТЬ NULL
	|			ИЛИ РасчетНалогаНаПрибыль.НаборКорректировок = ЗНАЧЕНИЕ(Справочник.КорректировкиПрошлыхПериодовНУ.ПустаяССылка))
	|	
	|СГРУППИРОВАТЬ ПО
	|	РасчетНалогаНаПрибыль.ПериодРасчета,
	|	РасчетНалогаНаПрибыль.ВариантНалогообложенияПрибыли,
	|	РасчетНалогаНаПрибыль.РегистрацияВНалоговомОргане
	|	
	|ИНДЕКСИРОВАТЬ ПО
	|	ПериодРасчета,
	|	РегистрацияВНалоговомОргане,
	|	ВариантНалогообложенияПрибыли
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|
	|ВЫБРАТЬ
	|	РасчетНалогаНаПрибыль.ПериодРасчета КАК ПериодРасчета,
	|	РасчетНалогаНаПрибыль.ВариантНалогообложенияПрибыли КАК ВариантНалогообложенияПрибыли,
	|	РасчетНалогаНаПрибыль.РегистрацияВНалоговомОргане КАК РегистрацияВНалоговомОргане,
	|	РасчетНалогаНаПрибыль.УровеньБюджета КАК УровеньБюджета,
	|	РасчетНалогаНаПрибыль.НалоговаяБаза КАК НалоговаяБаза,
	|	РасчетНалогаНаПрибыль.СуммаНалога КАК СуммаНалога
	|ПОМЕСТИТЬ ДанныеПредыдущихРасчетов
	|ИЗ
	|	РегистрСведений.РасчетНалогаНаПрибыль КАК РасчетНалогаНаПрибыль
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПромежуточнаяТаблица КАК ПромежуточнаяТаблица
	|		ПО РасчетНалогаНаПрибыль.ПериодРасчета = ПромежуточнаяТаблица.ПериодРасчета
	|			И РасчетНалогаНаПрибыль.ВариантНалогообложенияПрибыли = ПромежуточнаяТаблица.ВариантНалогообложенияПрибыли
	|			И РасчетНалогаНаПрибыль.РегистрацияВНалоговомОргане = ПромежуточнаяТаблица.РегистрацияВНалоговомОргане
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КорректировкиПрошлыхПериодовНУ КАК КорректировкиПрошлыхПериодовНУ
	|		ПО РасчетНалогаНаПрибыль.НаборКорректировок = КорректировкиПрошлыхПериодовНУ.Ссылка
	|ГДЕ
	|	РасчетНалогаНаПрибыль.Организация= &Организация
	|	И ЕСТЬNULL(КорректировкиПрошлыхПериодовНУ.ДатаНачалаПодготовкиДекларации, ДАТАВРЕМЯ(1, 1, 1))
	|		= ПромежуточнаяТаблица.ДатаНачалаПодготовкиДекларации
	|	
	|ИНДЕКСИРОВАТЬ ПО
	|	ПериодРасчета,
	|	РегистрацияВНалоговомОргане,
	|	ВариантНалогообложенияПрибыли,
	|	УровеньБюджета
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|
	|ВЫБРАТЬ //РС Уточненные декларации
	|	ДанныеПроводок.Период КАК ПериодРасчета,
	|	ДанныеПроводок.Организация КАК Организация,
	|	ДанныеПроводок.ВариантНалогообложенияПрибыли КАК ВариантНалогообложенияПрибыли,
	|	ДанныеПроводок.РегистрацияВНалоговомОргане КАК РегистрацияВНалоговомОргане,
	|	СУММА(ДанныеПроводок.СуммаНалога - ЕСТЬNULL(ДанныеПредыдущихРасчетов.СуммаНалога, 0)) КАК Сумма
	|ИЗ
	|	ДанныеПроводок КАК ДанныеПроводок
	|		ЛЕВОЕ СОЕДИНЕНИЕ ДанныеПредыдущихРасчетов КАК ДанныеПредыдущихРасчетов
	|		ПО ДанныеПроводок.Период = ДанныеПредыдущихРасчетов.ПериодРасчета
	|			И ДанныеПроводок.РегистрацияВНалоговомОргане = ДанныеПредыдущихРасчетов.РегистрацияВНалоговомОргане
	|			И ДанныеПроводок.ВариантНалогообложенияПрибыли = ДанныеПредыдущихРасчетов.ВариантНалогообложенияПрибыли
	|			И ДанныеПроводок.УровеньБюджета = ДанныеПредыдущихРасчетов.УровеньБюджета
	|	
	|ГДЕ
	|	ДанныеПроводок.СчетКт В ИЕРАРХИИ (Значение(ПланСчетов.Хозрасчетный.РасчетыСБюджетом)) 
	|	И ДанныеПроводок.СтавкаНалога <> 0
	|	
	|СГРУППИРОВАТЬ ПО
	|	ДанныеПроводок.Период,
	|	ДанныеПроводок.Организация,
	|	ДанныеПроводок.ВариантНалогообложенияПрибыли,
	|	ДанныеПроводок.РегистрацияВНалоговомОргане
	|
	|ИМЕЮЩИЕ СУММА(ДанныеПроводок.НалоговаяБаза - ЕСТЬNULL(ДанныеПредыдущихРасчетов.НалоговаяБаза, 0)) <> 0
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|
	|ВЫБРАТЬ  // Движения по сч. 68.04
	|	ДанныеПроводок.СчетКт КАК СчетКт,
	|	ДанныеПроводок.СчетДт КАК СчетДт,
	|	ДанныеПроводок.ВариантНалогообложенияПрибыли КАК ВариантНалогообложенияПрибыли,
	|	ДанныеПроводок.РегистрацияВНалоговомОргане КАК РегистрацияВНалоговомОргане,
	|	ДанныеПроводок.УровеньБюджета КАК УровеньБюджета,
	|	СУММА(ДанныеПроводок.СуммаНалога - ЕСТЬNULL(ДанныеПредыдущихРасчетов.СуммаНалога, 0)) КАК Сумма
	|ИЗ
	|	ТаблицаПериодов КАК ТаблицаПериодов
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ ДанныеПроводок КАК ДанныеПроводок
	|	ПО ТаблицаПериодов.Период = ДанныеПроводок.Период
	|		И ТаблицаПериодов.РегистрацияВНалоговомОргане = ДанныеПроводок.РегистрацияВНалоговомОргане
	|		И ТаблицаПериодов.ВариантНалогообложенияПрибыли = ДанныеПроводок.ВариантНалогообложенияПрибыли
	|	ЛЕВОЕ СОЕДИНЕНИЕ ДанныеПредыдущихРасчетов КАК ДанныеПредыдущихРасчетов
	|	ПО ДанныеПроводок.Период = ДанныеПредыдущихРасчетов.ПериодРасчета
	|		И ДанныеПроводок.РегистрацияВНалоговомОргане = ДанныеПредыдущихРасчетов.РегистрацияВНалоговомОргане
	|		И ДанныеПроводок.ВариантНалогообложенияПрибыли = ДанныеПредыдущихРасчетов.ВариантНалогообложенияПрибыли
	|		И ДанныеПроводок.УровеньБюджета = ДанныеПредыдущихРасчетов.УровеньБюджета
	|ГДЕ
	|	ДанныеПроводок.СчетКт В ИЕРАРХИИ (Значение(ПланСчетов.Хозрасчетный.РасчетыСБюджетом))
	|	И ДанныеПроводок.СтавкаНалога <> 0
	|
	|СГРУППИРОВАТЬ ПО
	|	ДанныеПроводок.СчетДт,
	|	ДанныеПроводок.СчетКт,
	|	ДанныеПроводок.ВариантНалогообложенияПрибыли,
	|	ДанныеПроводок.УровеньБюджета,
	|	ДанныеПроводок.РегистрацияВНалоговомОргане
	|;
	|//////////////////////////////////////////////////////////////////////////////// 
	|	
	|ВЫБРАТЬ // Движения по сч. 97.11
	|	ТаблицаПроводок.СчетКт КАК СчетКт,
	|	ТаблицаПроводок.СчетДт КАК СчетДт,
	|	ВЫБОР
	|		КОГДА ТаблицаПроводок.Период >= &НачалоГода
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ТекущийПериод,
	|	&ДатаЗакрытияНабора КАК Период,
	|	ТаблицаПроводок.ВариантНалогообложенияПрибыли КАК ВариантНалогообложенияПрибыли,
	|	ТаблицаПроводок.ПрименяетсяПБУ18 КАК ПрименяетсяПБУ18,
	|	ТаблицаПроводок.УбыткиПрошлыхЛет КАК УбыткиПрошлыхЛет,
	|	СУММА(ТаблицаПроводок.Сумма) КАК Сумма,
	|	ИСТИНА КАК Хозрасчетный,
	|	ЛОЖЬ   КАК АннулирующаяЗапись
	|ИЗ
	|	ДанныеПроводок КАК ТаблицаПроводок
	|ГДЕ
	|	(ТаблицаПроводок.СчетКт В ИЕРАРХИИ (Значение(ПланСчетов.Хозрасчетный.РасходыБудущихПериодов))
	|			ИЛИ ТаблицаПроводок.СчетДт В ИЕРАРХИИ (Значение(ПланСчетов.Хозрасчетный.РасходыБудущихПериодов)))
	|
	|СГРУППИРОВАТЬ ПО
	|	ТаблицаПроводок.ВариантНалогообложенияПрибыли,
	|	ВЫБОР
	|		КОГДА ТаблицаПроводок.Период >= &НачалоГода
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ,
	|	ТаблицаПроводок.ПрименяетсяПБУ18,
	|	ТаблицаПроводок.СчетКт,
	|	ТаблицаПроводок.УбыткиПрошлыхЛет,
	|	ТаблицаПроводок.СчетДт
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ТаблицаПроводок.СчетКт,
	|	ТаблицаПроводок.СчетДт,
	|	ЛОЖЬ,
	|	ТаблицаПроводок.Период,
	|	ТаблицаПроводок.ВариантНалогообложенияПрибыли,
	|	ТаблицаПроводок.ПрименяетсяПБУ18,
	|	ТаблицаПроводок.УбыткиПрошлыхЛет,
	|	ТаблицаПроводок.Сумма,
	|	ЛОЖЬ КАК Хозрасчетный,
	|	ЛОЖЬ КАК АннулирующаяЗапись
	|ИЗ
	|	ДанныеПроводок КАК ТаблицаПроводок
	|ГДЕ
	|	(ТаблицаПроводок.СчетКт В ИЕРАРХИИ (Значение(ПланСчетов.Хозрасчетный.РасходыБудущихПериодов))
	|			ИЛИ ТаблицаПроводок.СчетДт В ИЕРАРХИИ (Значение(ПланСчетов.Хозрасчетный.РасходыБудущихПериодов)))
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ТаблицаПроводок.СчетКт,
	|	ТаблицаПроводок.СчетДт,
	|	ЛОЖЬ,
	|	&ДатаЗакрытияНабора,
	|	ТаблицаПроводок.ВариантНалогообложенияПрибыли,
	|	ТаблицаПроводок.ПрименяетсяПБУ18,
	|	ТаблицаПроводок.УбыткиПрошлыхЛет,
	|	СУММА(-ТаблицаПроводок.Сумма),
	|	ЛОЖЬ   КАК Хозрасчетный,
	|	ИСТИНА КАК АннулирующаяЗапись
	|ИЗ
	|	ДанныеПроводок КАК ТаблицаПроводок
	|ГДЕ
	|	(ТаблицаПроводок.СчетКт В ИЕРАРХИИ (Значение(ПланСчетов.Хозрасчетный.РасходыБудущихПериодов))
	|			ИЛИ ТаблицаПроводок.СчетДт В ИЕРАРХИИ (Значение(ПланСчетов.Хозрасчетный.РасходыБудущихПериодов)))
	|
	|СГРУППИРОВАТЬ ПО
	|	ТаблицаПроводок.ВариантНалогообложенияПрибыли,
	|	ТаблицаПроводок.ПрименяетсяПБУ18,
	|	ТаблицаПроводок.СчетКт,
	|	ТаблицаПроводок.УбыткиПрошлыхЛет,
	|	ТаблицаПроводок.СчетДт
	|;
	|
	|//////////////////////////////////////////////////////////////////////////////// 
	|	
	|ВЫБРАТЬ  // Движения по сч. НРМ
	|	ТаблицаПроводок.СчетКт КАК СчетКт,
	|	ТаблицаПроводок.СчетДт КАК СчетДт,
	|	&ДатаЗакрытияНабора КАК Период,
	|	ТаблицаПроводок.Организация КАК Организация,
	|	ТаблицаПроводок.Подразделение КАК Подразделение,
	|	ТаблицаПроводок.НаправлениеДеятельности КАК НаправлениеДеятельности,
	|	ТаблицаПроводок.СтатьяРасходов КАК СтатьяРасходов, 
	|	ТаблицаПроводок.ВариантНалогообложенияПрибыли КАК ВариантНалогообложенияПрибыли,
	|	ТаблицаПроводок.ПрименяетсяПБУ18 КАК ПрименяетсяПБУ18,
	|	СУММА(ТаблицаПроводок.Сумма) КАК Сумма,
	|	ИСТИНА КАК Хозрасчетный,
	|	ЛОЖЬ   КАК АннулирующаяЗапись
	|ИЗ
	|	ДанныеПроводок КАК ТаблицаПроводок
	|ГДЕ
	|	ТаблицаПроводок.СчетКт = Значение(ПланСчетов.Хозрасчетный.НормируемыеРасходы)
	|	
	|СГРУППИРОВАТЬ ПО
	|	ТаблицаПроводок.СчетКт,
	|	ТаблицаПроводок.СчетДт,
	|	ТаблицаПроводок.Организация,
	|	ТаблицаПроводок.Подразделение,
	|	ТаблицаПроводок.НаправлениеДеятельности,
	|	ТаблицаПроводок.СтатьяРасходов,
	|	ТаблицаПроводок.ПрименяетсяПБУ18,
	|	ТаблицаПроводок.ВариантНалогообложенияПрибыли
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ТаблицаПроводок.СчетКт,
	|	ТаблицаПроводок.СчетДт,
	|	ТаблицаПроводок.Период,
	|	ТаблицаПроводок.Организация КАК Организация,
	|	ТаблицаПроводок.Подразделение КАК Подразделение,
	|	ТаблицаПроводок.НаправлениеДеятельности КАК НаправлениеДеятельности,
	|	ТаблицаПроводок.СтатьяРасходов КАК СтатьяРасходов,
	|	ТаблицаПроводок.ВариантНалогообложенияПрибыли КАК ВариантНалогообложенияПрибыли,
	|	ТаблицаПроводок.ПрименяетсяПБУ18 КАК ПрименяетсяПБУ18,
	|	ТаблицаПроводок.Сумма КАК Сумма,
	|	ЛОЖЬ КАК Хозрасчетный,
	|	ЛОЖЬ КАК АннулирующаяЗапись
	|ИЗ
	|	ДанныеПроводок КАК ТаблицаПроводок
	|ГДЕ
	|	ТаблицаПроводок.СчетКт = Значение(ПланСчетов.Хозрасчетный.НормируемыеРасходы)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ТаблицаПроводок.СчетКт,
	|	ТаблицаПроводок.СчетДт,
	|	&ДатаЗакрытияНабора,
	|	ТаблицаПроводок.Организация КАК Организация,
	|	ТаблицаПроводок.Подразделение КАК Подразделение,
	|	ТаблицаПроводок.НаправлениеДеятельности КАК НаправлениеДеятельности,
	|	ТаблицаПроводок.СтатьяРасходов КАК СтатьяРасходов,
	|	ТаблицаПроводок.ВариантНалогообложенияПрибыли КАК ВариантНалогообложенияПрибыли,
	|	ТаблицаПроводок.ПрименяетсяПБУ18 КАК ПрименяетсяПБУ18,
	|	СУММА( - ТаблицаПроводок.Сумма) КАК Сумма,
	|	ЛОЖЬ КАК Хозрасчетный,
	|	ИСТИНА КАК АннулирующаяЗапись
	|ИЗ
	|	ДанныеПроводок КАК ТаблицаПроводок
	|ГДЕ
	|	ТаблицаПроводок.СчетКт = Значение(ПланСчетов.Хозрасчетный.НормируемыеРасходы)
	|
	|СГРУППИРОВАТЬ ПО
	|	ТаблицаПроводок.СчетКт,
	|	ТаблицаПроводок.СчетДт,
	|	ТаблицаПроводок.Организация,
	|	ТаблицаПроводок.Подразделение,
	|	ТаблицаПроводок.НаправлениеДеятельности,
	|	ТаблицаПроводок.СтатьяРасходов,
	|	ТаблицаПроводок.ПрименяетсяПБУ18,
	|	ТаблицаПроводок.ВариантНалогообложенияПрибыли
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДанныеПроводок.Период КАК ПериодРасчета,
	|	&НаборКорректировок КАК НаборКорректировок,
	|	ДанныеПроводок.УровеньБюджета КАК УровеньБюджета,
	|	ДанныеПроводок.РегистрацияВНалоговомОргане КАК РегистрацияВНалоговомОргане,
	|	ДанныеПроводок.ВариантНалогообложенияПрибыли КАК ВариантНалогообложенияПрибыли,
	|	ДанныеПроводок.НалоговаяБаза КАК НалоговаяБаза,
	|	ДанныеПроводок.СуммаНалогаПрошлыхМесяцев КАК СуммаНалогаПрошлыхМесяцев,
	|	ДанныеПроводок.СтавкаНалога КАК СтавкаНалога,
	|	ДанныеПроводок.СуммаНалога КАК СуммаНалога
	|ИЗ
	|	ДанныеПроводок КАК ДанныеПроводок
	|ГДЕ
	|	(ДанныеПроводок.НалоговаяБаза <> 0
	|			ИЛИ ДанныеПроводок.СуммаНалогаПрошлыхМесяцев <> 0)
	|
	|СГРУППИРОВАТЬ ПО
	|	ДанныеПроводок.НалоговаяБаза,
	|	ДанныеПроводок.Период,
	|	ДанныеПроводок.УровеньБюджета,
	|	ДанныеПроводок.РегистрацияВНалоговомОргане,
	|	ДанныеПроводок.ВариантНалогообложенияПрибыли,
	|	ДанныеПроводок.СтавкаНалога,
	|	ДанныеПроводок.СуммаНалогаПрошлыхМесяцев,
	|	ДанныеПроводок.СуммаНалога";

	РезультатыЗапросов = Запрос.ВыполнитьПакет();
	КоличествоРезультатов = РезультатыЗапросов.Количество();
	
	// Проводки по 68 для РБ Хозрасчетный в текущем периоде
	РезультатЗапроса = РезультатыЗапросов[КоличествоРезультатов - 4].Выбрать();
	Содержание = НСтр("ru = 'Пересчет налога на прибыль';
						|en = 'Income tax recalculation'");
	СубконтоРегистрацияВНалоговомОргане = Неопределено;
	ВидыСубконто = Новый Массив;
	НалоговыйУчетОбособленныхПодразделений.ДобавитьВидСубконтоРегистрацияВНалоговомОргане(ВидыСубконто);
	Если ЗначениеЗаполнено(ВидыСубконто) Тогда
		СубконтоРегистрацияВНалоговомОргане = ВидыСубконто[0];
	КонецЕсли;
	
	Пока РезультатЗапроса.Следующий() Цикл
		
		Проводка = Движения.Хозрасчетный.Добавить();
		Проводка.Период      = СтруктураШапкиДокумента.ДатаЗакрытияНабора;
		Проводка.Организация = СтруктураШапкиДокумента.Организация;
		Проводка.СчетДт      = РезультатЗапроса.СчетДт;
		Проводка.СчетКт      = РезультатЗапроса.СчетКт;
		Проводка.Содержание  = Содержание;
		Проводка.Сумма       = РезультатЗапроса.Сумма;
		
		БухгалтерскийУчет.УстановитьСубконто(
				Проводка.СчетДт,
				Проводка.СубконтоДт,
				ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.ВариантыНалогообложенияПрибыли,
				РезультатЗапроса.ВариантНалогообложенияПрибыли);
		
		БухгалтерскийУчет.УстановитьСубконто(
			Проводка.СчетКт,
			Проводка.СубконтоКт,
			ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.ВидыПлатежейВГосБюджет,
			Перечисления.ВидыПлатежейВГосБюджет.НалогСам);
			
		БухгалтерскийУчет.УстановитьСубконто(
			Проводка.СчетКт,
			Проводка.СубконтоКт,
			ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.УровниБюджетов,
			РезультатЗапроса.УровеньБюджета);
			
		Если СубконтоРегистрацияВНалоговомОргане <> Неопределено Тогда
			БухгалтерскийУчет.УстановитьСубконто(
				Проводка.СчетКт,
				Проводка.СубконтоКт,
				СубконтоРегистрацияВНалоговомОргане,
				РезультатЗапроса.РегистрацияВНалоговомОргане);
		КонецЕсли;
		
	КонецЦикла;
		
	// Проводки по 97 счету
	РезультатЗапроса = РезультатыЗапросов[КоличествоРезультатов - 3].Выбрать();
	Содержание = НСтр("ru = 'Пересчет убытков прошлых лет';
						|en = 'Previous years loss recalculation'");
	Пока РезультатЗапроса.Следующий() Цикл
		
		Если РезультатЗапроса.Сумма = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Если РезультатЗапроса.Хозрасчетный Тогда
			Проводка = Движения.Хозрасчетный.Добавить();
		Иначе
			Проводка = Движения.КорректировкиНалоговойБазы.Добавить();
			Проводка.НаборКорректировок = СтруктураШапкиДокумента.НаборКорректировок;
			Проводка.СуммаНУДт          = РезультатЗапроса.Сумма;
			Проводка.СуммаНУКт          = РезультатЗапроса.Сумма;
			Проводка.АннулирующаяЗапись = РезультатЗапроса.АннулирующаяЗапись;
		КонецЕсли;
		
		Проводка.Период                            = РезультатЗапроса.Период;
		Проводка.Организация                       = СтруктураШапкиДокумента.Организация;
		Проводка.СчетДт                            = РезультатЗапроса.СчетДт;
		Проводка.СубконтоДт.ПрибылиИУбытки         = Перечисления.ПрибылиИУбытки.ПрибыльУбытокОтПродаж;
		Проводка.СчетКт                            = РезультатЗапроса.СчетКт;
		Проводка.СубконтоКт.РасходыБудущихПериодов = РезультатЗапроса.УбыткиПрошлыхЛет;
		Проводка.Содержание                        = Содержание;
		
		БухгалтерскийУчет.УстановитьСубконто(
			Проводка.СчетДт,
			Проводка.СубконтоДт,
			ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.ВариантыНалогообложенияПрибыли,
			РезультатЗапроса.ВариантНалогообложенияПрибыли);
		
		БухгалтерскийУчет.УстановитьСубконто(
			Проводка.СчетКт,
			Проводка.СубконтоКт,
			ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.ВариантыНалогообложенияПрибыли,
			РезультатЗапроса.ВариантНалогообложенияПрибыли);
			
		Если РезультатЗапроса.Хозрасчетный Тогда
			Если РезультатЗапроса.ТекущийПериод Тогда
				НалоговыйУчет.ЗаполнитьНалоговыеСуммыПроводки(
				РезультатЗапроса.Сумма, РезультатЗапроса.Сумма, 0, 0,
				-РезультатЗапроса.Сумма, -РезультатЗапроса.Сумма,
				Проводка, РезультатЗапроса.ПрименяетсяПБУ18);
			ИначеЕсли РезультатЗапроса.СчетДт = ПланыСчетов.Хозрасчетный.УбыткиПрошлыхЛет Тогда
				НалоговыйУчет.ЗаполнитьНалоговыеСуммыПроводки(
				РезультатЗапроса.Сумма, 0, 0, РезультатЗапроса.Сумма,
				-РезультатЗапроса.Сумма, -РезультатЗапроса.Сумма,
				Проводка, РезультатЗапроса.ПрименяетсяПБУ18);
			Иначе
				НалоговыйУчет.ЗаполнитьНалоговыеСуммыПроводки(
				0, РезультатЗапроса.Сумма, РезультатЗапроса.Сумма, 0,
				-РезультатЗапроса.Сумма, -РезультатЗапроса.Сумма,
				Проводка, РезультатЗапроса.ПрименяетсяПБУ18);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	// Проводки по НРМ счету
	РезультатЗапроса = РезультатыЗапросов[КоличествоРезультатов - 2].Выбрать();
	Содержание = НСтр("ru = 'Списание нормируемых расходов по НУ';
						|en = 'Write-off of normalized expenses as per TA'");
	СодержаниеКонецГода = НСтр("ru = 'Закрытие счета нормируемых расходов прошлого периода';
								|en = 'Closing normalized previous period expenses account'");
	
	Пока РезультатЗапроса.Следующий() Цикл
		
		Если РезультатЗапроса.Хозрасчетный Тогда
			Проводка = Движения.Хозрасчетный.Добавить();
		Иначе
			Проводка = Движения.КорректировкиНалоговойБазы.Добавить();
			Проводка.НаборКорректировок = СтруктураШапкиДокумента.НаборКорректировок;
			Если НЕ РезультатЗапроса.СчетДт = ПланыСчетов.Хозрасчетный.УбытокПодлежащийПокрытию Тогда
				Проводка.СуммаНУДт          = РезультатЗапроса.Сумма;
			КонецЕсли;
			Проводка.СуммаНУКт          = РезультатЗапроса.Сумма;
			Проводка.АннулирующаяЗапись = РезультатЗапроса.АннулирующаяЗапись;
		КонецЕсли;
		
		Проводка.Период                  = РезультатЗапроса.Период;
		Проводка.Организация             = РезультатЗапроса.Организация;
		Проводка.СчетДт                  = РезультатЗапроса.СчетДт;
		Проводка.СчетКт                  = РезультатЗапроса.СчетКт;
		Проводка.СубконтоКт.СтатьиЗатрат = РезультатЗапроса.СтатьяРасходов;
		
		Если Проводка.СчетДт = ПланыСчетов.Хозрасчетный.УбытокПодлежащийПокрытию Тогда
			Проводка.Содержание = СодержаниеКонецГода;
		Иначе
			Проводка.Содержание = Содержание;
		КонецЕсли;
		
		БухгалтерскийУчет.УстановитьСубконто(
			Проводка.СчетДт,
			Проводка.СубконтоДт,
			ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.ВариантыНалогообложенияПрибыли,
			РезультатЗапроса.ВариантНалогообложенияПрибыли);
			
		Если РезультатЗапроса.Хозрасчетный Тогда
			
			НалоговыйУчет.ЗаполнитьНалоговыеСуммыПроводки(
					РезультатЗапроса.Сумма, РезультатЗапроса.Сумма, -РезультатЗапроса.Сумма, -РезультатЗапроса.Сумма,
					0, 0,
					Проводка, РезультатЗапроса.ПрименяетсяПБУ18);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Движения.Хозрасчетный.Записывать = Истина;
	Движения.КорректировкиНалоговойБазы.Записывать = Истина;
	
	РезультатЗапроса = РезультатыЗапросов[КоличествоРезультатов - 1].Выгрузить();

	ЗакрытиеМесяца.ЗаписьВоВспомогательныеРегистрыСведений(
	Движения,
	РезультатЗапроса,
	ПараметрыПроведения.ТаблицаРеквизитыРасчетНалога,
	"РасчетНалогаНаПрибыль");

	// Уточненные декларации по налогу на прибыль
	
	РегистрыСведений.УточненныеДекларацииПоНалогуНаПрибыль.ЗаписьДанныхПерерасчета(РезультатыЗапросов[КоличествоРезультатов - 5].Выгрузить(), СтруктураШапкиДокумента, Отказ);
	
КонецПроцедуры
#КонецОбласти

#КонецЕсли
