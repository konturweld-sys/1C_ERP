Функция ТекстЗапросаВТ_ПроцентныеРасходыДисконтированияДолгосрок()
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ИзмененныеНастройки.ВидСчета КАК ВидСчета,
	|	ОбъектыРасчетов.Организация КАК Организация,
	|	ОбъектыРасчетов.ГруппаФинансовогоУчета КАК АналитикаУчета,
	|	ЛОЖЬ КАК Долгосрочный,
	|	ОбъектыРасчетов.Подразделение КАК Подразделение,
	|	ОбъектыРасчетов.НаправлениеДеятельности КАК НаправлениеДеятельности,
	|	ОбъектыРасчетов.Контрагент КАК Субконто1,
	|	ОбъектыРасчетов.Договор КАК Субконто2,
	|	Данные.Валюта КАК Валюта,
	|	СУММА(Данные.ПредоплатаРеглОстаток + Данные.ДолгРеглОстаток) КАК Сумма,
	|	СУММА(Данные.ПредоплатаУпрОстаток + Данные.ДолгУпрОстаток) КАК СуммаУУ,
	|	СУММА(Данные.ПредоплатаОстаток + Данные.ДолгОстаток) КАК ВалютнаяСумма
	|ПОМЕСТИТЬ ПроцентныеРасходыДисконтированияДолгосрок
	|ИЗ
	|	РегистрНакопления.РасчетыСПоставщикамиПоСрокам.Остатки(&Период,) КАК Данные
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ОбъектыРасчетов КАК ОбъектыРасчетов
	|	ПО Данные.ОбъектРасчетов = ОбъектыРасчетов.Ссылка
	|		И ОбъектыРасчетов.Организация = &Организация
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
	|	ПО ОбъектыРасчетов.Договор = ДоговорыКонтрагентов.Ссылка
	|		И (ДоговорыКонтрагентов.СтавкаДисконтирования > 0)
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ УчетнаяПолитикаОрганизаций КАК УчетнаяПолитикаОрганизаций
	|	ПО ОбъектыРасчетов.Организация = УчетнаяПолитикаОрганизаций.Организация
	|		И УчетнаяПолитикаОрганизаций.ДолгосрочныеАктивыОбязательства
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ ИзмененныеНастройки КАК ИзмененныеНастройки
	|	ПО ИзмененныеНастройки.ВидСчета = ЗНАЧЕНИЕ(Перечисление.ВидыСчетовРеглУчета.ПроцентыПоДисконтированию)
	|		И ИзмененныеНастройки.Организация = ОбъектыРасчетов.Организация
	|		И ИзмененныеНастройки.АналитикаУчета = ОбъектыРасчетов.ГруппаФинансовогоУчета
	|ГДЕ
	|	ДОБАВИТЬКДАТЕ(НАЧАЛОПЕРИОДА(Данные.ДатаВозникновения, ДЕНЬ), МЕСЯЦ, ЕСТЬNULL(УчетнаяПолитикаОрганизаций.МесяцыДолгосрочнойЗадолженности, 999))
	|		<= Данные.ДатаПлановогоПогашения
	|СГРУППИРОВАТЬ ПО
	|	ИзмененныеНастройки.ВидСчета,
	|	ОбъектыРасчетов.Организация,
	|	ОбъектыРасчетов.ГруппаФинансовогоУчета,
	|	ОбъектыРасчетов.Подразделение,
	|	ОбъектыРасчетов.НаправлениеДеятельности,
	|	ОбъектыРасчетов.Контрагент,
	|	ОбъектыРасчетов.Договор,
	|	Данные.Валюта";
	Если Не НастройкаСчетовУчетаСервер.НастройкиАналитикиУчетаПоРазделуУчета("РасчетыСПартнерами").Используется Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ОбъектыРасчетов.ГруппаФинансовогоУчета", "ЗНАЧЕНИЕ(Справочник.ГруппыФинансовогоУчетаРасчетов.ПустаяСсылка)");
	КонецЕсли;
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ТекстЗапросаВТ_ПроцентныеРасходыДисконтирования(РежимОтладкиПоИсточникам)
	
	ИспользуетсяАналитика = НастройкаСчетовУчетаСервер.НастройкиАналитикиУчетаПоРазделуУчета("РасчетыСПартнерами").Используется;
	
	ТекстыВложенногоЗапроса = Новый Массив;
	
	#Область ИнициализацияПроцентныеРасходыДисконтированияПредварительная
	ТекстЗапроса =
	"ВЫБРАТЬ ПЕРВЫЕ 0
	|	//РежимОтладки""Инициализация"" КАК ИсточникДанных,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыСчетовРеглУчета.ПустаяСсылка) КАК ВидСчета,
	|	ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка) КАК Организация,
	|	ЗНАЧЕНИЕ(Справочник.ГруппыФинансовогоУчетаРасчетов.ПустаяСсылка) КАК АналитикаУчета,
	|	ЛОЖЬ КАК Долгосрочный,
	|	ЗНАЧЕНИЕ(Справочник.СтруктураПредприятия.ПустаяСсылка) КАК Подразделение,
	|	ЗНАЧЕНИЕ(Справочник.НаправленияДеятельности.ПустаяСсылка) КАК НаправлениеДеятельности,
	|	ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка) КАК Субконто1,
	|	НЕОПРЕДЕЛЕНО КАК Субконто2,
	|	ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка) КАК Валюта,
	|	0 КАК Сумма,
	|	0 КАК СуммаУУ,
	|	0 КАК ВалютнаяСумма
	|ПОМЕСТИТЬ ПроцентныеРасходыДисконтированияПредварительная";
	Если РежимОтладкиПоИсточникам Тогда
		ТекстыВложенногоЗапроса.Добавить(ТекстЗапроса);
	КонецЕсли;
	#КонецОбласти
	
	#Область ИсходныеДанные
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	//РежимОтладки""ИсходныеДанные"" КАК ИсточникДанных,
	|	ИзмененныеНастройки.ВидСчета КАК ВидСчета,
	|	ОбъектыРасчетов.Организация КАК Организация,
	|	ОбъектыРасчетов.ГруппаФинансовогоУчета КАК АналитикаУчета,
	|	ЛОЖЬ КАК Долгосрочный,
	|	ОбъектыРасчетов.Подразделение КАК Подразделение,
	|	ОбъектыРасчетов.НаправлениеДеятельности КАК НаправлениеДеятельности,
	|	ОбъектыРасчетов.Контрагент КАК Субконто1,
	|	ОбъектыРасчетов.Договор КАК Субконто2,
	|	Данные.Валюта КАК Валюта,
	|	Данные.СуммаДисконтированияРеглОстаток КАК Сумма,
	|	Данные.СуммаДисконтированияУпрОстаток КАК СуммаУУ,
	|	Данные.СуммаДисконтированияОстаток КАК ВалютнаяСумма
	|ИЗ
	|	РегистрНакопления.ПроцентныеРасходыДисконтирования.Остатки(&Период,) КАК Данные
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ОбъектыРасчетов КАК ОбъектыРасчетов
	|	ПО Данные.ОбъектРасчетов = ОбъектыРасчетов.Ссылка
	|		И ОбъектыРасчетов.Организация = &Организация
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ ИзмененныеНастройки КАК ИзмененныеНастройки
	|	ПО ИзмененныеНастройки.ВидСчета = ЗНАЧЕНИЕ(Перечисление.ВидыСчетовРеглУчета.ПроцентыПоДисконтированию)
	|		И ИзмененныеНастройки.Организация = ОбъектыРасчетов.Организация
	|		И ИзмененныеНастройки.АналитикаУчета = ОбъектыРасчетов.ГруппаФинансовогоУчета";
	Если Не ИспользуетсяАналитика Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ОбъектыРасчетов.ГруппаФинансовогоУчета", "ЗНАЧЕНИЕ(Справочник.ГруппыФинансовогоУчетаРасчетов.ПустаяСсылка)");
	КонецЕсли;
	ТекстыВложенногоЗапроса.Добавить(ТекстЗапроса);
	#КонецОбласти
	
	#Область ВычетДолгосрока
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	//РежимОтладки""ВычетДолгосрока"" КАК ИсточникДанных,
	|	Данные.ВидСчета КАК ВидСчета,
	|	Данные.Организация КАК Организация,
	|	Данные.АналитикаУчета КАК АналитикаУчета,
	|	ЛОЖЬ КАК Долгосрочный,
	|	Данные.Подразделение КАК Подразделение,
	|	Данные.НаправлениеДеятельности КАК НаправлениеДеятельности,
	|	Данные.Субконто1 КАК Субконто1,
	|	Данные.Субконто2 КАК Субконто2,
	|	Данные.Валюта КАК Валюта,
	|	-Данные.Сумма КАК Сумма,
	|	-Данные.СуммаУУ КАК СуммаУУ,
	|	-Данные.ВалютнаяСумма КАК ВалютнаяСумма
	|ИЗ
	|	ПроцентныеРасходыДисконтированияДолгосрок КАК Данные";
	ТекстыВложенногоЗапроса.Добавить(ТекстЗапроса);
	#КонецОбласти
	
	#Область Долгосрок
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	//РежимОтладки""Долгосрок"" КАК ИсточникДанных,
	|	Данные.ВидСчета КАК ВидСчета,
	|	Данные.Организация КАК Организация,
	|	Данные.АналитикаУчета КАК АналитикаУчета,
	|	ИСТИНА КАК Долгосрочный,
	|	Данные.Подразделение КАК Подразделение,
	|	Данные.НаправлениеДеятельности КАК НаправлениеДеятельности,
	|	Данные.Субконто1 КАК Субконто1,
	|	Данные.Субконто2 КАК Субконто2,
	|	Данные.Валюта КАК Валюта,
	|	Данные.Сумма КАК Сумма,
	|	Данные.СуммаУУ КАК СуммаУУ,
	|	Данные.ВалютнаяСумма КАК ВалютнаяСумма
	|ИЗ
	|	ПроцентныеРасходыДисконтированияДолгосрок КАК Данные";
	ТекстыВложенногоЗапроса.Добавить(ТекстЗапроса);
	#КонецОбласти
	
	СтрокаВложенногоЗапроса = СтрСоединить(ТекстыВложенногоЗапроса, ОбщегоНазначенияУТ.РазделительЗапросовВОбъединении());
	
	#Область ПроцентныеРасходыДисконтирования
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	Данные.ВидСчета КАК ВидСчета,
	|	Данные.Организация КАК Организация,
	|	Данные.АналитикаУчета КАК АналитикаУчета,
	|	Данные.Долгосрочный КАК Долгосрочный,
	|	Данные.Подразделение КАК Подразделение,
	|	Данные.НаправлениеДеятельности КАК НаправлениеДеятельности,
	|	Данные.Субконто1 КАК Субконто1,
	|	Данные.Субконто2 КАК Субконто2,
	|	Данные.Валюта КАК Валюта,
	|	СУММА(Данные.Сумма) КАК Сумма,
	|	СУММА(Данные.СуммаУУ) КАК СуммаУУ,
	|	СУММА(Данные.ВалютнаяСумма) КАК ВалютнаяСумма,
	|	СУММА(Данные.Сумма) КАК СуммаВР
	|ПОМЕСТИТЬ ПроцентныеРасходыДисконтирования
	|ИЗ
	|	ПроцентныеРасходыДисконтированияПредварительная КАК Данные
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ ИзмененныеНастройки КАК ИзмененныеНастройки
	|	ПО ИзмененныеНастройки.ВидСчета = Данные.ВидСчета
	|		И ИзмененныеНастройки.Организация = Данные.Организация
	|		И ИзмененныеНастройки.АналитикаУчета = Данные.АналитикаУчета
	|		И ИзмененныеНастройки.Долгосрочный = Данные.Долгосрочный
	|
	|СГРУППИРОВАТЬ ПО
	|	Данные.ВидСчета,
	|	Данные.Организация,
	|	Данные.АналитикаУчета,
	|	Данные.Долгосрочный,
	|	Данные.Подразделение,
	|	Данные.НаправлениеДеятельности,
	|	Данные.Субконто1,
	|	Данные.Субконто2,
	|	Данные.Валюта";
	Если Не ИспользуетсяАналитика Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Данные.АналитикаУчета", "ЗНАЧЕНИЕ(Справочник.ГруппыФинансовогоУчетаРасчетов.ПустаяСсылка)");
	КонецЕсли;
	#КонецОбласти
	
	Если РежимОтладкиПоИсточникам Тогда
		
		ТекстыЗапроса = Новый Массив;
		ТекстыЗапроса.Добавить(СтрокаВложенногоЗапроса);
		ТекстыЗапроса.Добавить(ТекстЗапроса);
		ТекстЗапроса = СтрСоединить(ТекстыЗапроса, ОбщегоНазначения.РазделительПакетаЗапросов());
		
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ПроцентныеРасходыДисконтированияПредварительная", "(" + СтрокаВложенногоЗапроса + ")");
	КонецЕсли;
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ТекстЗапроса_НеотфактурованныеПоставки()
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	//РежимОтладки""НеотфактурованныеПоставки"" КАК ИсточникДанных,
	|	ИзмененныеНастройки.ВидСчета КАК ВидСчета,
	|	ТаблицаОстатков.Организация КАК Организация,
	|	ТаблицаОстатков.ГруппаФинансовогоУчетаРасчетов КАК АналитикаУчета,
	|	НЕОПРЕДЕЛЕНО КАК МестоУчета,
	|	ЛОЖЬ КАК Долгосрочный,
	|	ТаблицаОстатков.ПодразделениеАналитики КАК Подразделение,
	|	ТаблицаОстатков.НаправлениеДеятельности КАК НаправлениеДеятельности,
	|	ТаблицаОстатков.Номенклатура КАК Субконто1,
	|	ТаблицаОстатков.Контрагент КАК Субконто2,
	|	ТаблицаОстатков.Договор КАК Субконто3,
	|	НЕОПРЕДЕЛЕНО КАК Субконто4,
	|	НЕОПРЕДЕЛЕНО КАК Субконто5,
	|	НЕОПРЕДЕЛЕНО КАК Субконто6,
	|	НЕОПРЕДЕЛЕНО КАК Валюта,
	|	-ТаблицаОстатков.СуммаБалансоваяРегл КАК Сумма,
	|	-ТаблицаОстатков.СуммаБалансоваяУпр КАК СуммаУУ,
	|	0 КАК ВалютнаяСумма,
	|	-ТаблицаОстатков.Количество КАК Количество,
	|	-(ТаблицаОстатков.СуммаБалансоваяРегл - ТаблицаОстатков.СуммаПР - ТаблицаОстатков.СуммаВР) КАК СуммаНУ,
	|	-ТаблицаОстатков.СуммаПР КАК СуммаПР,
	|	-ТаблицаОстатков.СуммаВР КАК СуммаВР
	|ИЗ
	|	ТаблицаСебестоимостьТоваров КАК ТаблицаОстатков
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ ИзмененныеНастройки КАК ИзмененныеНастройки
	|	ПО ИзмененныеНастройки.ВидСчета = ЗНАЧЕНИЕ(Перечисление.ВидыСчетовРеглУчета.НеотфактурованныеПоставки)
	|		И ИзмененныеНастройки.АналитикаУчета = ТаблицаОстатков.ГруппаФинансовогоУчетаРасчетов
	|		И ИзмененныеНастройки.Организация = ТаблицаОстатков.Организация
	|
	|ГДЕ
	|	ТаблицаОстатков.РазделУчета = ЗНАЧЕНИЕ(Перечисление.РазделыУчетаСебестоимостиТоваров.НеотфактурованныеПоставки)
	|	И ТаблицаОстатков.СуммаБалансоваяРегл + ТаблицаОстатков.СуммаБалансоваяУпр + ТаблицаОстатков.Количество
	|	+ ТаблицаОстатков.СуммаПР + ТаблицаОстатков.СуммаВР <> 0";
	Если Не НастройкаСчетовУчетаСервер.НастройкиАналитикиУчетаПоРазделуУчета("РасчетыСПартнерами").Используется Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ТаблицаОстатков.ГруппаФинансовогоУчетаРасчетов", "ЗНАЧЕНИЕ(Справочник.ГруппыФинансовогоУчетаРасчетов.ПустаяСсылка)");
	КонецЕсли;
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ТекстЗапросаВТ_ВнеоборотныеАктивы(РежимОтладкиПоИсточникам)
	
	ТекстыВложенногоЗапроса = Новый Массив;
	
	#Область ИнициализацияВременнойВнеоборотныеАктивыПредварительная
	ТекстЗапроса =
	"ВЫБРАТЬ ПЕРВЫЕ 0
	|	//РежимОтладки""Инициализация"" КАК ИсточникДанных,
	|	НЕОПРЕДЕЛЕНО КАК ВидСчета,
	|	НЕОПРЕДЕЛЕНО КАК Организация,
	|	НЕОПРЕДЕЛЕНО КАК АналитикаУчета,
	|	НЕОПРЕДЕЛЕНО КАК МестоУчета,
	|	ЛОЖЬ КАК Долгосрочный,
	|	НЕОПРЕДЕЛЕНО КАК Подразделение,
	|	НЕОПРЕДЕЛЕНО КАК НаправлениеДеятельности,
	|	НЕОПРЕДЕЛЕНО КАК Субконто1,
	|	НЕОПРЕДЕЛЕНО КАК Субконто2,
	|	НЕОПРЕДЕЛЕНО КАК Субконто3,
	|	НЕОПРЕДЕЛЕНО КАК Субконто4,
	|	НЕОПРЕДЕЛЕНО КАК Субконто5,
	|	НЕОПРЕДЕЛЕНО КАК Субконто6,
	|	НЕОПРЕДЕЛЕНО КАК Валюта,
	|	0 КАК Сумма,
	|	0 КАК СуммаУУ,
	|	0 КАК ВалютнаяСумма,
	|	0 КАК Количество,
	|	0 КАК СуммаНУ,
	|	0 КАК СуммаПР,
	|	0 КАК СуммаВР
	|ПОМЕСТИТЬ ВнеоборотныеАктивыПредварительная";
	Если РежимОтладкиПоИсточникам Тогда
		ТекстыВложенногоЗапроса.Добавить(ТекстЗапроса);
	КонецЕсли;
	#КонецОбласти
	
	ТекстыВложенногоЗапроса.Добавить(ТекстЗапроса_СтоимостьОС());
	ТекстыВложенногоЗапроса.Добавить(ТекстЗапроса_СтоимостьНМА());
	ТекстыВложенногоЗапроса.Добавить(ТекстЗапроса_АмортизацияОС());
	ТекстыВложенногоЗапроса.Добавить(ТекстЗапроса_АмортизацияНМА());
	ТекстыВложенногоЗапроса.Добавить(ТекстЗапроса_ОбесценениеВНА());
	ТекстыВложенногоЗапроса.Добавить(ТекстЗапроса_ИнвестицииВАренду());
	
	СтрокаВложенногоЗапроса = СтрСоединить(ТекстыВложенногоЗапроса, ОбщегоНазначенияУТ.РазделительЗапросовВОбъединении());
	
	#Область ВнеоборотныеАктивы
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	Данные.ВидСчета КАК ВидСчета,
	|	Данные.Организация КАК Организация,
	|	Данные.АналитикаУчета КАК АналитикаУчета,
	|	НЕОПРЕДЕЛЕНО КАК МестоУчета,
	|	ЛОЖЬ КАК Долгосрочный,
	|	Данные.Подразделение КАК Подразделение,
	|	Данные.НаправлениеДеятельности КАК НаправлениеДеятельности,
	|	Данные.Субконто1 КАК Субконто1,
	|	НЕОПРЕДЕЛЕНО КАК Субконто2,
	|	НЕОПРЕДЕЛЕНО КАК Субконто3,
	|	НЕОПРЕДЕЛЕНО КАК Субконто4,
	|	НЕОПРЕДЕЛЕНО КАК Субконто5,
