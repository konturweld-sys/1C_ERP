	|	ЛЕВОЕ СОЕДИНЕНИЕ ПорядокОтраженияСтарый КАК НастройкиПоМестуУчетаСтарый
	|	ПО НастройкиПоМестуУчетаСтарый.ВидСчета = Данные.ВидСчета
	|		И НастройкиПоМестуУчетаСтарый.АналитикаУчета = Данные.АналитикаУчета
	|		И НастройкиПоМестуУчетаСтарый.Организация = Данные.Организация
	|		И НастройкиПоМестуУчетаСтарый.МестоУчета = Данные.МестоУчета
	|		И НастройкиПоМестуУчетаСтарый.Долгосрочный = Данные.Долгосрочный
	|		И НастройкиПоМестуУчетаСтарый.НастройкаПоМестуУчета
	|	ЛЕВОЕ СОЕДИНЕНИЕ ПорядокОтраженияСтарый КАК НастройкиПоОрганизацииСтарый
	|	ПО НастройкиПоОрганизацииСтарый.ВидСчета = Данные.ВидСчета
	|		И НастройкиПоОрганизацииСтарый.АналитикаУчета = Данные.АналитикаУчета
	|		И НастройкиПоОрганизацииСтарый.Организация = Данные.Организация
	|		И НастройкиПоОрганизацииСтарый.МестоУчета = НЕОПРЕДЕЛЕНО
	|		И НастройкиПоОрганизацииСтарый.Долгосрочный = Данные.Долгосрочный
	|	ЛЕВОЕ СОЕДИНЕНИЕ ПорядокОтраженияСтарый КАК НастройкиПоАналитикеУчетаСтарый
	|	ПО НастройкиПоАналитикеУчетаСтарый.ВидСчета = Данные.ВидСчета
	|		И НастройкиПоАналитикеУчетаСтарый.АналитикаУчета = Данные.АналитикаУчета
	|		И НастройкиПоАналитикеУчетаСтарый.НастройкаПоАналитике
	|		И НастройкиПоАналитикеУчетаСтарый.Долгосрочный = Данные.Долгосрочный
	|
	|	ЛЕВОЕ СОЕДИНЕНИЕ ПорядокОтраженияНовый КАК НастройкиПоМестуУчетаНовый
	|	ПО НастройкиПоМестуУчетаНовый.ВидСчета = Данные.ВидСчета
	|		И НастройкиПоМестуУчетаНовый.АналитикаУчета = Данные.АналитикаУчета
	|		И НастройкиПоМестуУчетаНовый.Организация = Данные.Организация
	|		И НастройкиПоМестуУчетаНовый.МестоУчета = Данные.МестоУчета
	|		И НастройкиПоМестуУчетаНовый.Долгосрочный = Данные.Долгосрочный
	|		И НастройкиПоМестуУчетаНовый.НастройкаПоМестуУчета
	|	ЛЕВОЕ СОЕДИНЕНИЕ ПорядокОтраженияНовый КАК НастройкиПоОрганизацииНовый
	|	ПО НастройкиПоОрганизацииНовый.ВидСчета = Данные.ВидСчета
	|		И НастройкиПоОрганизацииНовый.АналитикаУчета = Данные.АналитикаУчета
	|		И НастройкиПоОрганизацииНовый.Организация = Данные.Организация
	|		И НастройкиПоОрганизацииНовый.МестоУчета = НЕОПРЕДЕЛЕНО
	|		И НастройкиПоОрганизацииНовый.Долгосрочный = Данные.Долгосрочный
	|	ЛЕВОЕ СОЕДИНЕНИЕ ПорядокОтраженияНовый КАК НастройкиПоАналитикеУчетаНовый
	|	ПО НастройкиПоАналитикеУчетаНовый.ВидСчета = Данные.ВидСчета
	|		И НастройкиПоАналитикеУчетаНовый.АналитикаУчета = Данные.АналитикаУчета
	|		И НастройкиПоАналитикеУчетаНовый.НастройкаПоАналитике
	|		И НастройкиПоАналитикеУчетаНовый.Долгосрочный = Данные.Долгосрочный
	|
	|ГДЕ
	|	НЕ (Данные.Сумма = 0
	|		И Данные.СуммаУУ = 0
	|		И Данные.ВалютнаяСумма = 0
	|		И Данные.Количество = 0
	|		И Данные.СуммаНУ = 0
	|		И Данные.СуммаПР = 0
	|		И Данные.СуммаВР = 0)";
	#КонецОбласти
	
	Если РежимОтладкиПоИсточникам Тогда
		
		ТекстыЗапроса = Новый Массив;
		ТекстыЗапроса.Добавить(СтрокаВложенногоЗапроса);
		ТекстыЗапроса.Добавить(ТекстЗапроса);
		ТекстЗапроса = СтрСоединить(ТекстыЗапроса, ОбщегоНазначения.РазделительПакетаЗапросов());
		
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ДанныеПредварительная", "(" + СтрокаВложенногоЗапроса + ")");
	КонецЕсли;
	
	Возврат ТекстЗапроса;

КонецФункции

Функция ТекстЗапросаВТ_ДанныеОпределениеДтКт(РежимОтладкиПоИсточникам)
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	Данные.Период КАК Период,
	|	Данные.ВидСчета КАК ВидСчета,
	|	Данные.СчетИсточник КАК СчетИсточник,
	|	Данные.СчетПриемник КАК СчетПриемник,
	|	Данные.Организация КАК Организация,
	|	Данные.Подразделение КАК Подразделение,
	|	ВЫБОР
	|		КОГДА Данные.ВидСчета В (&ЗаполнятьВсегда)
	|		ТОГДА Данные.НаправлениеДеятельности
	|		КОГДА Данные.ВидСчета В (&УчетЗатрат) И НЕ ЕСТЬNULL(НаправленияДеятельности.УчетЗатрат, ЛОЖЬ)
	|			ИЛИ Данные.ВидСчета В (&УчетДоходов) И НЕ ЕСТЬNULL(НаправленияДеятельности.УчетДоходов, ЛОЖЬ)
	|			ИЛИ Данные.ВидСчета В (&УчетДенежныхСредств) И НЕ ЕСТЬNULL(НаправленияДеятельности.УчетДенежныхСредствРаздельно, ЛОЖЬ)
	|			ИЛИ Данные.ВидСчета В (&УчетВнеоборотныхАктивов)И НЕ ЕСТЬNULL(НаправленияДеятельности.УчетВнеоборотныхАктивов, ЛОЖЬ)
	|			ИЛИ Данные.ВидСчета В (&УчетРасчетовСПоставщиками)И НЕ ЕСТЬNULL(НаправленияДеятельности.УчетРасчетовСПоставщиками, ЛОЖЬ)
	|			ИЛИ Данные.ВидСчета В (&УчетРезервов) И ЕСТЬNULL(НаправленияДеятельности.ГосударственныйКонтракт,
	|				ЗНАЧЕНИЕ(Справочник.ГосударственныеКонтракты.ПустаяСсылка)) <> ЗНАЧЕНИЕ(Справочник.ГосударственныеКонтракты.ПустаяСсылка)
	|			ИЛИ Данные.ВидСчета В (&УчетРезервов) И НЕ ЕСТЬNULL(НаправленияДеятельности.УчетЗатрат, ЛОЖЬ)
	|			ИЛИ Данные.ВидСчета В (&НикогдаНеЗаполнять)
	|			ТОГДА ЗНАЧЕНИЕ(Справочник.НаправленияДеятельности.ПустаяСсылка)
	|		ИНАЧЕ Данные.НаправлениеДеятельности
	|	КОНЕЦ КАК НаправлениеДеятельности,
	|	ВЫБОР
	|		КОГДА СчетаИсточник.Вид = ЗНАЧЕНИЕ(ВидСчета.Активный)
	|		ТОГДА Данные.СчетПриемник
	|		КОГДА СчетаИсточник.Вид = ЗНАЧЕНИЕ(ВидСчета.Пассивный)
	|		ТОГДА Данные.СчетИсточник
	|		КОГДА Данные.ВидСчета В (ЗНАЧЕНИЕ(Перечисление.ВидыСчетовРеглУчета.АрендныеОбязательства), ЗНАЧЕНИЕ(Перечисление.ВидыСчетовРеглУчета.УслугаПоАренде), ЗНАЧЕНИЕ(Перечисление.ВидыСчетовРеглУчета.ОбесценениеВНА), ЗНАЧЕНИЕ(Перечисление.ВидыСчетовРеглУчета.АвансыПолученные), ЗНАЧЕНИЕ(Перечисление.ВидыСчетовРеглУчета.РасчетыСКредиторамиКомиссия), ЗНАЧЕНИЕ(Перечисление.ВидыСчетовРеглУчета.РасчетыСПоставщиками))
	|		ТОГДА Данные.СчетИсточник
	|		ИНАЧЕ Данные.СчетПриемник
	|	КОНЕЦ КАК СчетДт,
	|	ВЫБОР
	|		КОГДА СчетаИсточник.Вид = ЗНАЧЕНИЕ(ВидСчета.Активный)
	|		ТОГДА Данные.СчетИсточник
	|		КОГДА СчетаИсточник.Вид = ЗНАЧЕНИЕ(ВидСчета.Пассивный)
	|		ТОГДА Данные.СчетПриемник
	|		КОГДА Данные.ВидСчета В (ЗНАЧЕНИЕ(Перечисление.ВидыСчетовРеглУчета.АрендныеОбязательства), ЗНАЧЕНИЕ(Перечисление.ВидыСчетовРеглУчета.УслугаПоАренде), ЗНАЧЕНИЕ(Перечисление.ВидыСчетовРеглУчета.ОбесценениеВНА), ЗНАЧЕНИЕ(Перечисление.ВидыСчетовРеглУчета.АвансыПолученные), ЗНАЧЕНИЕ(Перечисление.ВидыСчетовРеглУчета.РасчетыСКредиторамиКомиссия), ЗНАЧЕНИЕ(Перечисление.ВидыСчетовРеглУчета.РасчетыСПоставщиками))
	|		ТОГДА Данные.СчетПриемник
	|		ИНАЧЕ Данные.СчетИсточник
	|	КОНЕЦ КАК СчетКт,
	|	Данные.Субконто1 КАК Субконто1,
	|	Данные.Субконто2 КАК Субконто2,
	|	Данные.Субконто3 КАК Субконто3,
	|	Данные.Субконто4 КАК Субконто4,
	|	Данные.Субконто5 КАК Субконто5,
	|	Данные.Субконто6 КАК Субконто6,
	|	Данные.Валюта КАК Валюта,
	|	Данные.Сумма КАК Сумма,
	|	Данные.СуммаУУ КАК СуммаУУ,
	|	Данные.ВалютнаяСумма КАК ВалютнаяСумма,
	|	Данные.Количество КАК Количество,
	|	Данные.СуммаНУ КАК СуммаНУ,
	|	Данные.СуммаПР КАК СуммаПР,
	|	Данные.СуммаВР КАК СуммаВР
	|ПОМЕСТИТЬ ДанныеСчетаДтКт
	|ИЗ
	|	Данные КАК Данные
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Константы КАК Константы
	|		ПО ИСТИНА
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.НаправленияДеятельности КАК НаправленияДеятельности
	|		ПО НаправленияДеятельности.Ссылка = Данные.НаправлениеДеятельности
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПланХозрасчетный КАК СчетаИсточник
	|		ПО Данные.СчетИсточник = СчетаИсточник.Ссылка
	|ГДЕ
	|	Данные.СчетИсточник <> ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ПустаяСсылка)
	|	И Данные.СчетПриемник <> ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ПустаяСсылка)
	|	И (Данные.СчетИсточник <> Данные.СчетПриемник
	|		ИЛИ (Данные.СчетИсточник В (&СчетаСПартиямиВыпуска) И Константы.ДатаНачалаРеглУчетаПродукцииИПолуфабрикатовПоПартиямВыпуска = &Период
	|			ИЛИ Данные.СчетИсточник В (&СчетаСПартиямиПриобретения) И Константы.ДатаНачалаРеглУчетаТоваровИМатериаловПоПартиямПриобретения = &Период)
	|		И Данные.ВидСчета В (&ВидыСчетовСОбогащениемПартиями))";
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ТекстЗапросаВТ_ДанныеОпределениеСубконтоДтКт(РежимОтладкиПоИсточникам)

	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	Данные.Период КАК Период,
	|	Данные.ВидСчета КАК ВидСчета,
	|	Данные.СчетИсточник КАК СчетИсточник,
	|	Данные.СчетПриемник КАК СчетПриемник,
	|	Данные.Организация КАК Организация,
	|	Данные.Подразделение КАК Подразделение,
	|	Данные.НаправлениеДеятельности КАК НаправлениеДеятельности,
	|	Данные.СчетДт КАК СчетДт,
	|	Данные.СчетКт КАК СчетКт,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(СчетаДт.ВидСубконто1, НЕОПРЕДЕЛЕНО) = ВидыДт1.Ссылка
	|			ТОГДА ВидыДт1.Ссылка
	|		КОГДА ЕСТЬNULL(СчетаДт.ВидСубконто1, НЕОПРЕДЕЛЕНО) = ВидыДт2.Ссылка
	|			ТОГДА ВидыДт2.Ссылка
	|		КОГДА ЕСТЬNULL(СчетаДт.ВидСубконто1, НЕОПРЕДЕЛЕНО) = ВидыДт3.Ссылка
	|			ТОГДА ВидыДт3.Ссылка
	|		КОГДА ЕСТЬNULL(СчетаДт.ВидСубконто1, НЕОПРЕДЕЛЕНО) = ВидыДт4.Ссылка
	|			ТОГДА ВидыДт4.Ссылка
	|		КОГДА ЕСТЬNULL(СчетаДт.ВидСубконто1, НЕОПРЕДЕЛЕНО) = ВидыДт5.Ссылка
	|			ТОГДА ВидыДт5.Ссылка
	|		КОГДА ЕСТЬNULL(СчетаДт.ВидСубконто1, НЕОПРЕДЕЛЕНО) = ВидыДт6.Ссылка
	|			ТОГДА ВидыДт6.Ссылка
	|		КОГДА ЕСТЬNULL(СчетаДт.ВидСубконто1, НЕОПРЕДЕЛЕНО) = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконтоХозрасчетные.НоменклатурныеГруппы)
	|			ТОГДА СчетаДт.ВидСубконто1
	|		ИНАЧЕ НЕОПРЕДЕЛЕНО
	|	КОНЕЦ КАК ВидСубконтоДт1,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(СчетаДт.ВидСубконто1, НЕОПРЕДЕЛЕНО) = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконтоХозрасчетные.ПартииНоменклатуры)
	|			И (Данные.СчетДт В (&СчетаСПартиямиПриобретения) И Константы.ДатаНачалаРеглУчетаТоваровИМатериаловПоПартиямПриобретения > &Период
	|			ИЛИ Данные.СчетДт В (&СчетаСПартиямиВыпуска) И Константы.ДатаНачалаРеглУчетаПродукцииИПолуфабрикатовПоПартиямВыпуска > &Период)
	|		ТОГДА НЕОПРЕДЕЛЕНО
	|		КОГДА ЕСТЬNULL(СчетаДт.ВидСубконто1, НЕОПРЕДЕЛЕНО) = ВидыДт1.Ссылка
	|					И Данные.Субконто1 = ВидыДт1.ПустоеЗначениеСубконто
	|				ИЛИ ЕСТЬNULL(СчетаДт.ВидСубконто1, НЕОПРЕДЕЛЕНО) = ВидыДт2.Ссылка
	|					И Данные.Субконто2 = ВидыДт2.ПустоеЗначениеСубконто
	|				ИЛИ ЕСТЬNULL(СчетаДт.ВидСубконто1, НЕОПРЕДЕЛЕНО) = ВидыДт3.Ссылка
	|					И Данные.Субконто3 = ВидыДт3.ПустоеЗначениеСубконто
	|				ИЛИ ЕСТЬNULL(СчетаДт.ВидСубконто1, НЕОПРЕДЕЛЕНО) = ВидыДт4.Ссылка
	|					И Данные.Субконто4 = ВидыДт4.ПустоеЗначениеСубконто
	|				ИЛИ ЕСТЬNULL(СчетаДт.ВидСубконто1, НЕОПРЕДЕЛЕНО) = ВидыДт5.Ссылка
	|					И Данные.Субконто5 = ВидыДт5.ПустоеЗначениеСубконто
	|				ИЛИ ЕСТЬNULL(СчетаДт.ВидСубконто1, НЕОПРЕДЕЛЕНО) = ВидыДт6.Ссылка
	|					И Данные.Субконто6 = ВидыДт6.ПустоеЗначениеСубконто
	|			ТОГДА НЕОПРЕДЕЛЕНО
	|		КОГДА ЕСТЬNULL(СчетаДт.ВидСубконто1, НЕОПРЕДЕЛЕНО) = ВидыДт1.Ссылка
	|			ТОГДА Данные.Субконто1
	|		КОГДА ЕСТЬNULL(СчетаДт.ВидСубконто1, НЕОПРЕДЕЛЕНО) = ВидыДт2.Ссылка
	|			ТОГДА Данные.Субконто2
	|		КОГДА ЕСТЬNULL(СчетаДт.ВидСубконто1, НЕОПРЕДЕЛЕНО) = ВидыДт3.Ссылка
	|			ТОГДА Данные.Субконто3
	|		КОГДА ЕСТЬNULL(СчетаДт.ВидСубконто1, НЕОПРЕДЕЛЕНО) = ВидыДт4.Ссылка
	|			ТОГДА Данные.Субконто4
	|		КОГДА ЕСТЬNULL(СчетаДт.ВидСубконто1, НЕОПРЕДЕЛЕНО) = ВидыДт5.Ссылка
	|			ТОГДА Данные.Субконто5
	|		КОГДА ЕСТЬNULL(СчетаДт.ВидСубконто1, НЕОПРЕДЕЛЕНО) = ВидыДт6.Ссылка
	|			ТОГДА Данные.Субконто6
	|		ИНАЧЕ Данные.Субконто1
	|	КОНЕЦ КАК СубконтоДт1,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(СчетаДт.ВидСубконто2, НЕОПРЕДЕЛЕНО) = ВидыДт1.Ссылка
	|			ТОГДА ВидыДт1.Ссылка
	|		КОГДА ЕСТЬNULL(СчетаДт.ВидСубконто2, НЕОПРЕДЕЛЕНО) = ВидыДт2.Ссылка
	|			ТОГДА ВидыДт2.Ссылка
	|		КОГДА ЕСТЬNULL(СчетаДт.ВидСубконто2, НЕОПРЕДЕЛЕНО) = ВидыДт3.Ссылка
	|			ТОГДА ВидыДт3.Ссылка
