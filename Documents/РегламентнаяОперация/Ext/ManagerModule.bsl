Функция ТекстЗапроса_РасчетыСКлиентамиПоСрокам()
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	//РежимОтладки""РасчетыСКлиентамиПоСрокам"" КАК ИсточникДанных,
	|	ИзмененныеНастройки.ВидСчета КАК ВидСчета,
	|	ОбъектыРасчетов.Организация КАК Организация,
	|	ОбъектыРасчетов.ГруппаФинансовогоУчета КАК АналитикаУчета,
	|	НЕОПРЕДЕЛЕНО КАК МестоУчета,
	|	РАЗНОСТЬДАТ(ТаблицаОстатков.ДатаВозникновения, ТаблицаОстатков.ДатаПлановогоПогашения, МЕСЯЦ) >=
	|		ЕСТЬNULL(УчетнаяПолитикаОрганизаций.МесяцыДолгосрочнойЗадолженности, 999) КАК Долгосрочный,
	|	ОбъектыРасчетов.Подразделение КАК Подразделение,
	|	ОбъектыРасчетов.НаправлениеДеятельности КАК НаправлениеДеятельности,
	|	ОбъектыРасчетов.Контрагент КАК Субконто1,
	|	ОбъектыРасчетов.Договор КАК Субконто2,
	|	НЕОПРЕДЕЛЕНО КАК Субконто3,
	|	НЕОПРЕДЕЛЕНО КАК Субконто4,
	|	НЕОПРЕДЕЛЕНО КАК Субконто5,
	|	НЕОПРЕДЕЛЕНО КАК Субконто6,
	|	ТаблицаОстатков.Валюта КАК Валюта,
	|	ВЫБОР
	|		КОГДА ИзмененныеНастройки.ВидСчета = ЗНАЧЕНИЕ(Перечисление.ВидыСчетовРеглУчета.АвансыПолученные)
	|		ТОГДА ТаблицаОстатков.ПредоплатаРеглОстаток
	|		ИНАЧЕ ТаблицаОстатков.ДолгРеглОстаток
	|	КОНЕЦ КАК Сумма,
	|	ВЫБОР
	|		КОГДА ИзмененныеНастройки.ВидСчета = ЗНАЧЕНИЕ(Перечисление.ВидыСчетовРеглУчета.АвансыПолученные)
	|		ТОГДА ТаблицаОстатков.ПредоплатаУпрОстаток
	|		ИНАЧЕ ТаблицаОстатков.ДолгУпрОстаток
	|	КОНЕЦ КАК СуммаУУ,
	|	ВЫБОР
	|		КОГДА ИзмененныеНастройки.ВидСчета = ЗНАЧЕНИЕ(Перечисление.ВидыСчетовРеглУчета.АвансыПолученные)
	|		ТОГДА ТаблицаОстатков.ПредоплатаОстаток
	|		ИНАЧЕ ТаблицаОстатков.ДолгОстаток
	|	КОНЕЦ КАК ВалютнаяСумма,
	|	0 КАК Количество,
	|	ВЫБОР
	|		КОГДА ИзмененныеНастройки.ВидСчета = ЗНАЧЕНИЕ(Перечисление.ВидыСчетовРеглУчета.АвансыПолученные)
	|		ТОГДА ТаблицаОстатков.ПредоплатаРеглОстаток
	|		ИНАЧЕ ТаблицаОстатков.ДолгРеглОстаток
	|	КОНЕЦ КАК СуммаНУ,
	|	0 КАК СуммаПР,
	|	0 КАК СуммаВР
	|ИЗ
	|	РегистрНакопления.РасчетыСКлиентамиПоСрокам.Остатки(&Период, ) КАК ТаблицаОстатков
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ОбъектыРасчетов КАК ОбъектыРасчетов
	|	ПО ТаблицаОстатков.ОбъектРасчетов = ОбъектыРасчетов.Ссылка
	|		И ОбъектыРасчетов.Организация = &Организация
	|	ЛЕВОЕ СОЕДИНЕНИЕ УчетнаяПолитикаОрганизаций КАК УчетнаяПолитикаОрганизаций
	|	ПО ОбъектыРасчетов.Организация = УчетнаяПолитикаОрганизаций.Организация
	|		И УчетнаяПолитикаОрганизаций.ДолгосрочныеАктивыОбязательства
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ ИзмененныеНастройки КАК ИзмененныеНастройки
	|	ПО ИзмененныеНастройки.АналитикаУчета = ОбъектыРасчетов.ГруппаФинансовогоУчета
	|		И ИзмененныеНастройки.Организация = ОбъектыРасчетов.Организация
	|		И ИзмененныеНастройки.ИмяРегистра = ""РасчетыСКлиентамиПоСрокам""
	|		И ИзмененныеНастройки.Долгосрочный = 
	|			(РАЗНОСТЬДАТ(ТаблицаОстатков.ДатаВозникновения, ТаблицаОстатков.ДатаПлановогоПогашения, МЕСЯЦ) >=
	|			ЕСТЬNULL(УчетнаяПолитикаОрганизаций.МесяцыДолгосрочнойЗадолженности, 999))";
	Если Не НастройкаСчетовУчетаСервер.НастройкиАналитикиУчетаПоРазделуУчета("РасчетыСПартнерами").Используется Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ОбъектыРасчетов.ГруппаФинансовогоУчета", "ЗНАЧЕНИЕ(Справочник.ГруппыФинансовогоУчетаРасчетов.ПустаяСсылка)");
	КонецЕсли;
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ТекстЗапроса_РасчетыСПоставщикамиПоСрокам()
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	//РежимОтладки""РасчетыСПоставщикамиПоСрокам"" КАК ИсточникДанных,
	|	ИзмененныеНастройки.ВидСчета КАК ВидСчета,
	|	ОбъектыРасчетов.Организация КАК Организация,
	|	ОбъектыРасчетов.ГруппаФинансовогоУчета КАК АналитикаУчета,
	|	НЕОПРЕДЕЛЕНО КАК МестоУчета,
	|	ВЫБОР
	|		КОГДА ИзмененныеНастройки.ВидСчета = ЗНАЧЕНИЕ(Перечисление.ВидыСчетовРеглУчета.РасчетыПоБронированию)
	|		ТОГДА ЛОЖЬ
	|		ИНАЧЕ РАЗНОСТЬДАТ(ТаблицаОстатков.ДатаВозникновения, ТаблицаОстатков.ДатаПлановогоПогашения, МЕСЯЦ) >=
	|			ЕСТЬNULL(УчетнаяПолитикаОрганизаций.МесяцыДолгосрочнойЗадолженности, 999)
	|	КОНЕЦ КАК Долгосрочный,
	|	ОбъектыРасчетов.Подразделение КАК Подразделение,
	|	ОбъектыРасчетов.НаправлениеДеятельности КАК НаправлениеДеятельности,
	|	ОбъектыРасчетов.Контрагент КАК Субконто1,
	|	ВЫБОР
	|		КОГДА ИзмененныеНастройки.ВидСчета = ЗНАЧЕНИЕ(Перечисление.ВидыСчетовРеглУчета.РасчетыПоБронированию)
	|		ТОГДА ВЫРАЗИТЬ(ТаблицаОстатков.РасчетныйДокумент КАК Документ.ОперацияСЭлектроннымБилетом).Сотрудник
	|		ИНАЧЕ ОбъектыРасчетов.Договор
	|	КОНЕЦ КАК Субконто2,
	|	ВЫБОР
	|		КОГДА ИзмененныеНастройки.ВидСчета = ЗНАЧЕНИЕ(Перечисление.ВидыСчетовРеглУчета.РасчетыПоБронированию)
	|		ТОГДА ОбъектыРасчетов.Объект
	|		ИНАЧЕ НЕОПРЕДЕЛЕНО
	|	КОНЕЦ КАК Субконто3,
	|	НЕОПРЕДЕЛЕНО КАК Субконто4,
	|	НЕОПРЕДЕЛЕНО КАК Субконто5,
	|	НЕОПРЕДЕЛЕНО КАК Субконто6,
	|	ТаблицаОстатков.Валюта КАК Валюта,
	|	ВЫБОР
	|		КОГДА ИзмененныеНастройки.ВидСчета = ЗНАЧЕНИЕ(Перечисление.ВидыСчетовРеглУчета.РасчетыПоБронированию)
	|		ТОГДА ТаблицаОстатков.ДолгРеглОстаток + ТаблицаОстатков.ПредоплатаРеглОстаток
	|		КОГДА ИзмененныеНастройки.ВидСчета = ЗНАЧЕНИЕ(Перечисление.ВидыСчетовРеглУчета.АвансыВыданные)
	|		ТОГДА ТаблицаОстатков.ПредоплатаРеглОстаток
	|		ИНАЧЕ ТаблицаОстатков.ДолгРеглОстаток
	|	КОНЕЦ КАК Сумма,
	|	ВЫБОР
	|		КОГДА ИзмененныеНастройки.ВидСчета = ЗНАЧЕНИЕ(Перечисление.ВидыСчетовРеглУчета.РасчетыПоБронированию)
	|		ТОГДА ТаблицаОстатков.ДолгУпрОстаток + ТаблицаОстатков.ПредоплатаУпрОстаток
	|		КОГДА ИзмененныеНастройки.ВидСчета = ЗНАЧЕНИЕ(Перечисление.ВидыСчетовРеглУчета.АвансыВыданные)
	|		ТОГДА ТаблицаОстатков.ПредоплатаУпрОстаток
	|		ИНАЧЕ ТаблицаОстатков.ДолгУпрОстаток
	|	КОНЕЦ КАК СуммаУУ,
	|	ВЫБОР
	|		КОГДА ИзмененныеНастройки.ВидСчета = ЗНАЧЕНИЕ(Перечисление.ВидыСчетовРеглУчета.РасчетыПоБронированию)
	|		ТОГДА ТаблицаОстатков.ДолгОстаток + ТаблицаОстатков.ПредоплатаОстаток
	|		КОГДА ИзмененныеНастройки.ВидСчета = ЗНАЧЕНИЕ(Перечисление.ВидыСчетовРеглУчета.АвансыВыданные)
	|		ТОГДА ТаблицаОстатков.ПредоплатаОстаток
	|		ИНАЧЕ ТаблицаОстатков.ДолгОстаток
	|	КОНЕЦ КАК ВалютнаяСумма,
	|	0 КАК Количество,
	|	ВЫБОР
	|		КОГДА ИзмененныеНастройки.ВидСчета = ЗНАЧЕНИЕ(Перечисление.ВидыСчетовРеглУчета.РасчетыПоБронированию)
	|		ТОГДА 0
	|		КОГДА ИзмененныеНастройки.ВидСчета = ЗНАЧЕНИЕ(Перечисление.ВидыСчетовРеглУчета.АвансыВыданные)
	|		ТОГДА ТаблицаОстатков.ПредоплатаРеглОстаток
	|		ИНАЧЕ ТаблицаОстатков.ДолгРеглОстаток
	|	КОНЕЦ КАК СуммаНУ,
	|	0 КАК СуммаПР,
	|	0 КАК СуммаВР
	|ИЗ
	|	РегистрНакопления.РасчетыСПоставщикамиПоСрокам.Остатки(&Период, ) КАК ТаблицаОстатков
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ОбъектыРасчетов КАК ОбъектыРасчетов
	|	ПО ТаблицаОстатков.ОбъектРасчетов = ОбъектыРасчетов.Ссылка
	|		И ОбъектыРасчетов.Организация = &Организация
	|	ЛЕВОЕ СОЕДИНЕНИЕ УчетнаяПолитикаОрганизаций КАК УчетнаяПолитикаОрганизаций
	|	ПО ОбъектыРасчетов.Организация = УчетнаяПолитикаОрганизаций.Организация
	|		И УчетнаяПолитикаОрганизаций.ДолгосрочныеАктивыОбязательства
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ ИзмененныеНастройки КАК ИзмененныеНастройки
	|	ПО ИзмененныеНастройки.Организация = ОбъектыРасчетов.Организация
	|		И ИзмененныеНастройки.АналитикаУчета = ОбъектыРасчетов.ГруппаФинансовогоУчета
	|		И ИзмененныеНастройки.ИмяРегистра = ""РасчетыСПоставщикамиПоСрокам""
	|		И (ИзмененныеНастройки.ВидСчета = ЗНАЧЕНИЕ(Перечисление.ВидыСчетовРеглУчета.РасчетыПоБронированию) ИЛИ ИзмененныеНастройки.Долгосрочный = 
	|			(РАЗНОСТЬДАТ(ТаблицаОстатков.ДатаВозникновения, ТаблицаОстатков.ДатаПлановогоПогашения, МЕСЯЦ) >=
	|				ЕСТЬNULL(УчетнаяПолитикаОрганизаций.МесяцыДолгосрочнойЗадолженности, 999)))
	|ГДЕ
	|	ТаблицаОстатков.ОбъектРасчетов.ГруппаФинансовогоУчета.РасчетыПоБронированию ИЛИ ИзмененныеНастройки.ВидСчета <> ЗНАЧЕНИЕ(Перечисление.ВидыСчетовРеглУчета.РасчетыПоБронированию)";
	Если Не НастройкаСчетовУчетаСервер.НастройкиАналитикиУчетаПоРазделуУчета("РасчетыСПартнерами").Используется Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ОбъектыРасчетов.ГруппаФинансовогоУчета", "ЗНАЧЕНИЕ(Справочник.ГруппыФинансовогоУчетаРасчетов.ПустаяСсылка)");
	КонецЕсли;
	
	Возврат ТекстЗапроса;
	
КонецФункции

