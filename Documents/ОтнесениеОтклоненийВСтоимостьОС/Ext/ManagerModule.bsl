	|	ДанныеДокумента.СтатьяРасходовСписанияЗатрат КАК КорСтатья,
	|	НЕОПРЕДЕЛЕНО                                 КАК КорАналитикаДоходов,
	|	ДанныеДокумента.АналитикаРасходовСписанияЗатрат КАК КорАналитикаРасходов,
	|	НЕОПРЕДЕЛЕНО                                 КАК КорАналитикаАктивовПассивов,
	|	НЕОПРЕДЕЛЕНО                                 КАК КорГруппаФинансовогоУчета,
	|
	|	ДанныеДокумента.Организация                  КАК КорОрганизация,
	|
	|	ВЫБОР
	|		КОГДА НЕ ДанныеДокумента.ОтражатьВУпрУчете
	|			ТОГДА 0
	|		ИНАЧЕ ВтРасчетСтоимости.Сумма
	|	КОНЕЦ КАК Сумма,
	|
	|	ВЫБОР
	|		КОГДА НЕ ДанныеДокумента.ОтражатьВБУ
	|			ТОГДА 0
	|		ИНАЧЕ ВтРасчетСтоимости.СуммаБУ + ВтРасчетСтоимости.СуммаЦФ
	|	КОНЕЦ КАК СуммаРегл,
	|
	|	ВЫБОР
	|		КОГДА НЕ ДанныеДокумента.ОтражатьВУпрУчете
	|			ТОГДА 0
	|		ИНАЧЕ ВтРасчетСтоимости.СуммаУУ
	|	КОНЕЦ КАК СуммаУпр
	|
	|ИЗ
	|	ДанныеДокументаРеквизиты КАК ДанныеДокумента
	|
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВтРасчетСтоимости КАК ВтРасчетСтоимости
	|		ПО ВтРасчетСтоимости.Ссылка = ДанныеДокумента.Ссылка
	|
	|ГДЕ
	|	ДанныеДокумента.СписатьОтклоненияНаРасходы
	|
	|	И (ДанныеДокумента.ОтражатьВУпрУчете
	|			И ВтРасчетСтоимости.СуммаУУ <> 0
	|		ИЛИ ДанныеДокумента.ОтражатьВБУ
	|			И (ВтРасчетСтоимости.СуммаБУ + ВтРасчетСтоимости.СуммаЦФ) <> 0)
	|";
	
	СписокЗапросовОбъединение.Добавить(ТекстЗапроса);
	
	#КонецОбласти

	ТекстЗапроса = СтрСоединить(СписокЗапросовОбъединение, ОбщегоНазначенияУТ.РазделительЗапросовВОбъединении());
	
	ТекстыЗапроса.Добавить(ТекстЗапроса, ИмяРегистра, Истина);
	
