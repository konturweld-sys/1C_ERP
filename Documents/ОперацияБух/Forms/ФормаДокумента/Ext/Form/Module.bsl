// Определяет принадлежность к регистрам "Хозрасчетный" и "Корректировки налоговой базы"
// 
// Возвращаемое значение: 
//  - Строка - имя изменяемого регистра бухгалтерии или пустая строка.
//
&НаКлиенте
Функция ПолучитьИзменяемыйРегистр(Элемент)
		
	// Определяет принадлежность к регистру "Хозрасчетный"
	Если СтрНайти(Элемент.Имя, "Хозрасчетный") Тогда
		Возврат "Хозрасчетный";
	
	// Определяет принадлежность к регистру корректировок налоговой базы    
	ИначеЕсли СтрНайти(Элемент.Имя, "КорректировкиНалоговойБазы") Тогда
		Возврат "КорректировкиНалоговойБазы";
	
	// Регистр не определен
	Иначе
		Возврат "";
	КонецЕсли;
	
КонецФункции

// Пересчитывает валютную сумму дебита при изменении валюты дебита
//
&НаКлиенте
Процедура ВалютаДтПриИзменении(Элемент)
	
	// Получаем регистр учета для текущего элемента
	ИзменяемыйРегистр = ПолучитьИзменяемыйРегистр(Элемент); 
	Если Элементы.Найти(ИзменяемыйРегистр) = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ТекущиеДанные = Элементы[ИзменяемыйРегистр].ТекущиеДанные;
	
	// Проверяем и приводим валютную сумму к нужному типу
	Если ТекущиеДанные.ВалютнаяСуммаДт = Null Тогда
		ТекущиеДанные.ВалютнаяСуммаДт = ОписаниеТиповСумма.ПривестиЗначение(ТекущиеДанные.ВалютнаяСуммаДт);
	КонецЕсли;

	РасчетСуммы("ВалютнаяСуммаДт", ИзменяемыйРегистр);
	ОбновитьИтогиПоДокументу(ЭтотОбъект);
	
КонецПроцедуры

