// Пересчитывает валютную сумму кредита при изменении валюты кредита
//
&НаКлиенте
Процедура ВалютаКтПриИзменении(Элемент)

	// Получаем регистр учета для текущего элемента
	ИзменяемыйРегистр = ПолучитьИзменяемыйРегистр(Элемент);
	ТекущиеДанные = Элементы[ИзменяемыйРегистр].ТекущиеДанные;

	Если ЗначениеЗаполнено(ТекущиеДанные.СчетДт) Тогда
		СвойстваСчета = БухгалтерскийУчетВызовСервераПовтИсп.ПолучитьСвойстваСчета(ТекущиеДанные.СчетДт);
		Если СвойстваСчета.Валютный И ИзменяемыйРегистр = "Хозрасчетный" Тогда
			Возврат; // Если оба счета валютные, сумма пересчитывается при изменении счета Дт
		КонецЕсли;
	КонецЕсли;

	// Проверяем и приводим валютную сумму к нужному типу
	Если ТекущиеДанные.ВалютнаяСуммаКт = Null Тогда
		ТекущиеДанные.ВалютнаяСуммаКт = ОписаниеТиповСумма.ПривестиЗначение(ТекущиеДанные.ВалютнаяСуммаКт);
	КонецЕсли;

	РасчетСуммы("ВалютнаяСуммаКт", ИзменяемыйРегистр);
	ОбновитьИтогиПоДокументу(ЭтотОбъект);

КонецПроцедуры

