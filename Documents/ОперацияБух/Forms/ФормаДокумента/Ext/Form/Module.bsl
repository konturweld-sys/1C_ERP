// Изменяет параметры выбора полей субконто в зависимости от счета и организации
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - Форма, на которой расположены поля субконто.
//  ИзменяемыйРегистр - Строка - имя регистра бухгалтерии. Например, "Хозрасчетный".
//  ДтКт - Строка - тип операции балансового учета. Если "Дт", шаблоны имени полей формы устанавливается для дебета, иначе для кредита.
//
&НаКлиентеНаСервереБезКонтекста
Процедура ИзменитьПараметрыВыбораПолейСубконто(Форма, ИзменяемыйРегистр, ДтКт = "")
	// Проверка существования элемента формы для указанного регистра
	Если Форма.Элементы.Найти(ИзменяемыйРегистр) = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// Получаем идентификатор текущей строки
	ИдСтроки = Форма.Элементы[ИзменяемыйРегистр].ТекущаяСтрока;
	Если ИдСтроки <> Неопределено Тогда
		// Находим строку в коллекции движений документа
		СтрокаТаблицы = Форма.Объект.Движения[ИзменяемыйРегистр].НайтиПоИдентификатору(ИдСтроки);

		Если ДтКт <> "Кт" Тогда
			// Получаем параметры выбора для субконто по дебету
			ПараметрыДокумента = НастройкаСчетовУчетаКлиентСервер.ПараметрыВыбораСубконто(
				Форма.Объект.Организация, 
				СтрокаТаблицы, 
				"СубконтоДт%Индекс%", 
				"СчетДт"); 

			// Настраиваем параметры выбора для полей субконто по дебету
			НастройкаСчетовУчетаКлиентСервер.ИзменитьПараметрыВыбораПолейСубконто(
				Форма, 
				СтрокаТаблицы, 
				"СубконтоДт%Индекс%", 
				ИзменяемыйРегистр + "СубконтоДт%Индекс%", 
				ПараметрыДокумента);				

			Если ИзменяемыйРегистр = "Хозрасчетный" Тогда
				СтрокаТаблицы["СчетДтИспользоватьНеРекомендуется"] = (Форма.НерекомендуемыеСчетаУчета.НайтиПоЗначению(СтрокаТаблицы.СчетДт) <> Неопределено);
			КонецЕсли;
		КонецЕсли;
		
		Если ДтКт <> "Дт" Тогда
			
			// Получаем параметры выбора для субконто по кредиту
			ПараметрыДокумента = НастройкаСчетовУчетаКлиентСервер.ПараметрыВыбораСубконто(
				Форма.Объект.Организация, 
				СтрокаТаблицы, 
				"СубконтоКт%Индекс%", 
				"СчетКт");
				
			// Настраиваем параметры выбора для полей субконто по кредиту
			НастройкаСчетовУчетаКлиентСервер.ИзменитьПараметрыВыбораПолейСубконто(
				Форма, 
				СтрокаТаблицы, 
				"СубконтоКт%Индекс%", 
				ИзменяемыйРегистр + "СубконтоКт%Индекс%", 
				ПараметрыДокумента); 

			Если ИзменяемыйРегистр = "Хозрасчетный" Тогда
				СтрокаТаблицы["СчетКтИспользоватьНеРекомендуется"] = (Форма.НерекомендуемыеСчетаУчета.НайтиПоЗначению(СтрокаТаблицы.СчетКт) <> Неопределено); 
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

// Заполняет параметры выбора субконто
//
&НаКлиенте
Процедура ОбработатьНачалоВыбораСубконто(ДтКт, Элемент, СтандартнаяОбработка)    
		
	ИзменяемыйРегистр = ПолучитьИзменяемыйРегистр(Элемент);
		
	// Проверка существования элемента формы для указанного регистра
	Если Элементы.Найти(ИзменяемыйРегистр) = Неопределено Тогда
		Возврат;
	КонецЕсли;
		
	ТекущиеДанные = Элементы[ИзменяемыйРегистр].ТекущиеДанные;
	ПараметрыДокумента = НастройкаСчетовУчетаКлиентСервер.ПараметрыВыбораСубконто(ЭтотОбъект.Объект.Организация, ТекущиеДанные, "Субконто" + ДтКт + "%Индекс%", "Счет" + ДтКт);
	ОбщегоНазначенияБПКлиент.НачалоВыбораЗначенияСубконто(ЭтотОбъект, Элемент, СтандартнаяОбработка, ПараметрыДокумента);

КонецПроцедуры

// При изменении счета обновляет типы субконто и прочие признаки счета для текущей строки. 
// Определяет доступность полей формы в зависимости от свойств выбранного счета
//
// Параметры:
//  ДтКт - Строка - тип операции балансового учета. Если "Дт", шаблоны имени полей формы устанавливается для дебета, иначе для кредита.
//  ИзменяемыйРегистр - Строка - имя регистра бухгалтерии. Например, "Хозрасчетный".
//
&НаКлиенте
Процедура ОбработатьИзменениеСчета(ДтКт, ИзменяемыйРегистр)

	// Проверяем существование элемента формы для указанного регистра
	Если Элементы.Найти(ИзменяемыйРегистр) = Неопределено Тогда
		Возврат;
	КонецЕсли;

	// Получаем текущие данные изменяемой строки
	ТекущиеДанные = Элементы[ИзменяемыйРегистр].ТекущиеДанные;
	
	// Формируем структуру полей формы для обновления субконто
	ПоляФормы = Новый Структура("Субконто1, Субконто2, Субконто3",
		ИзменяемыйРегистр + "Субконто"+ДтКт+"1", ИзменяемыйРегистр + "Субконто"+ДтКт+"2", ИзменяемыйРегистр + "Субконто"+ДтКт+"3");
	// Вызываем обработчик выбора счета для обновления субконто
	БухгалтерскийУчетКлиентСервер.ПриВыбореСчета(ТекущиеДанные["Счет"+ДтКт], ЭтотОбъект, ПоляФормы, Неопределено, Истина);
	
	// Формируем структуру полей объекта для обработки изменения счета
	ПоляОбъекта = Новый Структура("Субконто1, Субконто2, Субконто3",
		"Субконто"+ДтКт+"1", "Субконто"+ДтКт+"2", "Субконто"+ДтКт+"3");
	ПоляОбъекта.Вставить("Подразделение", "Подразделение"+ДтКт);
	ПоляОбъекта.Вставить("Организация"  , Объект.Организация);
	// Вызываем обработчик изменения счета
	БухгалтерскийУчетКлиентСервер.ПриИзмененииСчета(ТекущиеДанные["Счет"+ДтКт], ТекущиеДанные, ПоляОбъекта, Истина);
	
	// Получаем свойства измененного счета
	СвойстваСчета = БухгалтерскийУчетВызовСервераПовтИсп.ПолучитьСвойстваСчета(ТекущиеДанные["Счет"+ДтКт]);
	
	// Обрабатываем валютные счета
	Если СвойстваСчета.Валютный Тогда
		ТекущиеДанные["Валюта" + ДтКт]        = ОписаниеТиповВалюта.ПривестиЗначение(ТекущиеДанные["Валюта" + ДтКт]);
		ТекущиеДанные["ВалютнаяСумма" + ДтКт] = ОписаниеТиповСумма.ПривестиЗначение(ТекущиеДанные["ВалютнаяСумма" + ДтКт]);
	Иначе
		ТекущиеДанные["Валюта"+ДтКт]        = NULL;
		ТекущиеДанные["ВалютнаяСумма"+ДтКт] = NULL;
	КонецЕсли;
	
	// Обрабатываем учет по подразделениям
	Если СвойстваСчета.УчетПоПодразделениям Тогда
		ТекущиеДанные["Подразделение" + ДтКт] = ОписаниеТиповПодразделение.ПривестиЗначение(ТекущиеДанные["Подразделение" + ДтКт]);
	Иначе
		ТекущиеДанные["Подразделение" + ДтКт] = NULL;
	КонецЕсли;
	
	// Обрабатываем учет по направлениям деятельности
	Если НЕ СвойстваСчета.УчетПоНаправлениямДеятельности Тогда
		ТекущиеДанные["НаправлениеДеятельности" + ДтКт] = NULL;
	КонецЕсли;
	
	// Обрабатываем налоговый учет
	Если СвойстваСчета.НалоговыйУчет Тогда 
		Если ИзменяемыйРегистр = "Хозрасчетный" Тогда
			ТекущиеДанные["СуммаНУ" + ДтКт] = ОписаниеТиповСумма.ПривестиЗначение(ТекущиеДанные["СуммаНУ" + ДтКт]);
			ТекущиеДанные["СуммаПР" + ДтКт] = ОписаниеТиповСумма.ПривестиЗначение(ТекущиеДанные["СуммаПР" + ДтКт]);
			ТекущиеДанные["СуммаВР" + ДтКт] = ОписаниеТиповСумма.ПривестиЗначение(ТекущиеДанные["СуммаВР" + ДтКт]);
		Иначе
			ТекущиеДанные["СуммаНУ" + ДтКт] = ОписаниеТиповСумма.ПривестиЗначение(ТекущиеДанные["СуммаНУ" + ДтКт]);  
		КонецЕсли;
	Иначе
		Если ИзменяемыйРегистр = "Хозрасчетный" Тогда
			ТекущиеДанные["СуммаНУ" + ДтКт] = NULL;
			ТекущиеДанные["СуммаПР" + ДтКт] = NULL;
			ТекущиеДанные["СуммаВР" + ДтКт] = NULL;
		Иначе
			ТекущиеДанные["СуммаНУ" + ДтКт] = NULL;
		КонецЕсли;
	КонецЕсли; 
	
	Если ИзменяемыйРегистр = "КорректировкиНалоговойБазы" Тогда
		ТекущиеДанные["ПризнакНалоговыйУчет" + ДтКт] = СвойстваСчета.НалоговыйУчет;
	КонецЕсли;
	
	// Обрабатываем количественный учет
	Если СвойстваСчета.Количественный Тогда
		ТекущиеДанные["Количество" + ДтКт] = ОписаниеТиповКоличество.ПривестиЗначение(ТекущиеДанные["Количество" + ДтКт]);
	Иначе
		ТекущиеДанные["Количество" + ДтКт] = NULL;
	КонецЕсли;
	
	// Настраиваем параметры выбора для полей субконто
	ИзменитьПараметрыВыбораПолейСубконто(ЭтотОбъект, ИзменяемыйРегистр, ДтКт);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьДоступностьСубконто()
	
	УстановитьДоступностьСубконтоПоРегистру(Объект.Движения.Хозрасчетный);
	УстановитьДоступностьСубконтоПоРегистру(Объект.Движения.КорректировкиНалоговойБазы);

КонецПроцедуры

// Устанавливает доступность субконто по дебету и кредиту для каждой записи из набора движений переданного регистра. 
// Для хозрасчетного регистра проверяет счета на вхождение в нерекомендуемые к изменению счета и обновляет флаг использования нерекомендуемых счетов.
//
&НаСервере
Процедура УстановитьДоступностьСубконтоПоРегистру(ИзменяемыйРегистр)
	
	ИспользуютсяНерекомендуемыеСчетаУчета = Ложь;

	// Обрабатываем каждую проводку в регистре
	Для каждого Проводка Из ИзменяемыйРегистр Цикл
		
		// Настраиваем доступность субконто по дебету
		ПоляОбъекта = Новый Структура("Субконто1, Субконто2, Субконто3", 
			"СубконтоДт1", "СубконтоДт2", "СубконтоДт3");
		БухгалтерскийУчетКлиентСервер.УстановитьДоступностьСубконто(
			Проводка.СчетДт, 
			Проводка, 
			ПоляОбъекта);
		
		// Настраиваем доступность субконто по кредиту
		ПоляОбъекта = Новый Структура("Субконто1, Субконто2, Субконто3", 
			"СубконтоКт1", "СубконтоКт2", "СубконтоКт3");
		БухгалтерскийУчетКлиентСервер.УстановитьДоступностьСубконто(
			Проводка.СчетКт, 
			Проводка, 
			ПоляОбъекта);
		
		Если ИзменяемыйРегистр = Объект.Движения.Хозрасчетный Тогда
			Проводка.СчетДтИспользоватьНеРекомендуется = (НерекомендуемыеСчетаУчета.НайтиПоЗначению(Проводка.СчетДт) <> Неопределено);
			Проводка.СчетКтИспользоватьНеРекомендуется = (НерекомендуемыеСчетаУчета.НайтиПоЗначению(Проводка.СчетКт) <> Неопределено);
			
			ИспользуютсяНерекомендуемыеСчетаУчета = 
				ИспользуютсяНерекомендуемыеСчетаУчета
				ИЛИ Проводка.СчетДтИспользоватьНеРекомендуется
				ИЛИ Проводка.СчетКтИспользоватьНеРекомендуется;    
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если ИзменяемыйРегистр = Объект.Движения.Хозрасчетный Тогда
		Элементы.ГруппаИспользуютсяНерекомендуемыеСчета.Видимость = ИспользуютсяНерекомендуемыеСчетаУчета;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ДатаПриИзмененииНаСервере()
	
	НастроитьОтображениеТаблицыПроводок();
	
